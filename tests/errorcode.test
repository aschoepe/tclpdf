# errorcode.test --
#
# One property, held for the whole tree: EVERY refusal this package makes
# carries an -errorcode.
#
# Why it is a test and not a review note: on 2026-08-25 five hundred and
# eleven refusals in forty-eight modules carried none, and they had
# accumulated one module at a time. Nothing in the suite noticed, because
# every one of them was individually harmless - a script that catches the
# error still catches it, it just cannot tell WHICH error it caught without
# reading the message. And the message is explicitly not a contract: the
# manual says its wording "may be sharpened in any release", so a script
# written against it breaks on a rewording nobody thought was a change.
#
# The guard is written over the SOURCE rather than by calling every refusal:
# most of the five hundred need a fixture of their own - a damaged font, a
# progressive JPEG, an encrypted document being signed - and the question
# here is about the module as a whole, not about any one path through it.
#
# What it cannot see, and what therefore still needs a test of its own per
# case: whether the code is the RIGHT one. This says only that there is one.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

source [file join [file dirname [info script]] helper.tcl]

test errorcode-1.1 {every refusal in every module carries a code} -body {
    set bare {}
    ::tclpdfTest::eachModule module -> {
        set count [::tclpdfTest::refusalsWithoutCode $module]
        if {$count} {
            lappend bare "$module: $count"
        }
    }
    set bare
} -result {}

test errorcode-1.2 {the guard can find one - a counter-check} -body {
    # A guard that reports nothing is worth nothing until it has been shown
    # to find something. The fixture is written and read rather than mocked,
    # because what the guard reads is a file.
    set path [file join [temporaryDirectory] guard-fixture.tcl]
    set channel [open $path w]
    puts $channel {
        proc withCode {} {
            return -code error -errorcode {TCLPDF TEST ONE} "tclpdf: one"
        }
        proc withCodeWrapped {} {
            return -code error \
                -errorcode {TCLPDF TEST TWO} "tclpdf: two, on two lines"
        }
        proc withoutCode {} {
            return -code error "tclpdf: three, and no code at all"
        }
    }
    close $channel
    # The helper takes a name relative to the source tree, so the fixture is
    # read through a path of its own here.
    set text [read [set f [open $path]]][close $f]
    set lines [split $text \n]
    set bare 0
    for {set index 0} {$index < [llength $lines]} {incr index} {
        set line [lindex $lines $index]
        if {![string match {*return -code error*} $line]} {
            continue
        }
        if {![string match {*-errorcode*} \
                $line[lindex $lines [expr {$index + 1}]]]} {
            incr bare
        }
    }
    file delete $path
    # Exactly one of the three is bare, and the wrapped one is NOT counted -
    # which is the defect this guard had on 2026-08-25, when it read one line
    # at a time and called every wrapped refusal bare.
    set bare
} -result 1

# The first word of every -errorcode LITERAL in a module, wherever it is not
# one of the two that may stand there. Its own procedure because errorcode-1.3
# asks it of the whole tree and errorcode-1.4 asks it of a fixture, and the
# fixture is worth nothing if the two ask different questions.
#
# THREE SPELLINGS, and all three are right - none of them is to be unified:
#
#     -errorcode [list TCLPDF FIELD ALIGN $value]     834 places
#     -errorcode {TCLPDF COLORFONT ALIAS}             148 places
#     -errorcode \                                      34 places
#         [list TCLPDF STRUCTURE NAME duplicate name]
#
# Braces where no fact is substituted, [list] where one is, and the
# continuation wherever the message is too long for one line - a thousand and
# sixteen codes in all, counted 2026-08-25, beside the one deliberate TCL
# LOOKUP COMMAND in tclpdf.tcl. Until that day this guard read the first shape
# and nothing else, so a hundred and eighty-two of them were never looked at -
# and it reported nothing, which reads exactly like a clean tree.
#
# The continuations are closed up before the scan, or the code that sits on the
# line BELOW "-errorcode \" is not beside the switch to be found.
#
# Comments are read along with the code on purpose. A comment that quotes a
# code - afm.tcl has one - either quotes it right or is wrong about the
# package, and both are worth hearing about.
proc errorcodeFirstWords {module text} {
    regsub -all {\\\n[ \t]*} $text { } folded
    set wrong {}
    # "--" before the pattern: it begins with a dash and regexp would otherwise
    # read it as an option of its own.
    foreach {-> code} [regexp -all -inline -- \
            {-errorcode\s+(?:\[list\s+|\{)\s*([A-Za-z_]+)} $folded] {
        if {$code ni {TCLPDF TCL}} {
            lappend wrong "$module: $code"
        }
    }
    return $wrong
}

test errorcode-1.3 {every code begins with TCLPDF, or is one of Tcl's own} -body {
    # A code of another shape cannot be trapped by a script written against
    # this package. The one exception is deliberate and named here: the
    # unknown-command handler in tclpdf.tcl reproduces Tcl's own wording, so
    # it carries Tcl's own code and behaves exactly like a mistyped command.
    set wrong {}
    ::tclpdfTest::eachModule module text {
        lappend wrong {*}[errorcodeFirstWords $module $text]
    }
    set wrong
} -result {}

test errorcode-1.4 {the guard reads all three spellings - a counter-check} -body {
    # errorcode-1.3 read ONE of them until 2026-08-25 - "-errorcode \[list" on
    # a single line - and a hundred and eighty-two refusals therefore went past
    # it unlooked at. It reported nothing, which read like a clean tree.
    #
    # So the shapes are put to it here, one bad code in each, and the guard has
    # to name all three. Written as text rather than as three real refusals
    # because what the guard reads is source, not a raised error.
    errorcodeFirstWords module.tcl {
        return -code error -errorcode [list WRONGONE TOPIC CLASS $fact] \
            "tclpdf: the [list] spelling, where a fact is substituted"
        return -code error -errorcode {WRONGTWO TOPIC CLASS} \
            "tclpdf: the brace spelling, where none is"
        return -code error \
            -errorcode [list WRONGTHREE TOPIC CLASS] \
            "tclpdf: the continuation, where the message is too long for one\
            line and the code sits under the switch rather than beside it"
        return -code error -errorcode [list TCLPDF TOPIC CLASS] \
            "tclpdf: and this one is right, so it is not to be named"
    }
} -result {{module.tcl: WRONGONE} {module.tcl: WRONGTWO} {module.tcl: WRONGTHREE}}

cleanupTests

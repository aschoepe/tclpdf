# textFlow.test --
#
# The paragraph as a flowing thing: a height limit that hands back the rest,
# indents, paragraph spacing, and text running around shapes.
#
# All four rest on the same mechanism - the line breaker asks, per line, how
# wide the line may be and where it starts. These tests aim at that band as
# much as at the options on top of it.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::text
package require tclpdf::textBlock
source [file join [file dirname [info script]] helper.tcl]

# A body long enough to break into many lines, without depending on the exact
# wording anywhere.
set flowBody "Der Fliesstext laeuft in eine Spalte begrenzter Hoehe. Was nicht\
    mehr hineinpasst, kommt als Rest zurueck und wandert in die naechste\
    Spalte. Das ist der ganze Mechanismus, und er macht Spaltensatz zu einer\
    Sache von wenigen Zeilen Code."

# Where the lines start, rounded. The parsing itself lives in helper.tcl -
# text.test wants the same thing, and two copies of it drifted apart once.
proc flowStarts {stream} {
  return [lmap x [::tclpdfTest::starts $stream] {format %.2f $x}]
}

# How many lines were drawn.
proc flowLines {stream} {
  return [llength [regexp -all -inline {Td} $stream]]
}

test textFlow-1.1 {a height limit draws what fits and returns the rest} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  # 12 pt leading is 4.23 mm, so 20 mm hold four lines.
  set result [$doc text $::flowBody -at {20 30} -width 60 -height 20]
  set drawn [flowLines [::tclpdfTest::content $doc]]
  $doc destroy
  list [dict keys $result] $drawn [expr {[dict get $result rest] ne {}}]
} -result {{y rest} 4 1}

test textFlow-1.2 {the rest is text, and picks up where the drawing stopped} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set result [$doc text $::flowBody -at {20 30} -width 60 -height 20]
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # The rest is the TAIL of the body: whatever was held back, in order and
  # complete. Both sides are normalised first - the source string is wrapped
  # across several lines of Tcl, and the rest is rebuilt with single spaces.
  set rest [dict get $result rest]
  regsub -all {\s+} $::flowBody { } whole
  regsub -all {\s+} $rest { } tail
  list [expr {[string first $tail $whole] > 0}] \
      [expr {[string range $whole end-[expr {[string length $tail] - 1}] end]
          eq $tail}]
} -result {1 1}

test textFlow-1.3 {a rest that fits comes back empty} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set result [$doc text "Kurz." -at {20 30} -width 60 -height 40]
  $doc destroy
  dict get $result rest
} -result {}

test textFlow-1.4 {without a height limit the return value is unchanged} -body {
  # The regression guard for every existing caller: no -height, no dictionary.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set y [$doc text $::flowBody -at {20 30} -width 60]
  set height [$doc textHeight $::flowBody 60]
  $doc destroy
  expr {abs($y - (30 + $height)) < 0.001}
} -result 1

test textFlow-1.5 {the rest keeps paragraph boundaries} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set result [$doc text "Erster Absatz.\nZweiter Absatz.\nDritter Absatz." \
      -at {20 30} -width 60 -height 8]
  $doc destroy
  # One line fits; the two paragraphs held back stay two paragraphs.
  list [llength [split [dict get $result rest] \n]] \
      [string match {*Zweiter*} [dict get $result rest]]
} -result {2 1}

test textFlow-1.6 {the rest is the tail of the string, character for character} -body {
  # Not lines joined back together: everything from the first character that
  # was not set, as the caller wrote it - the same paragraph breaks, the same
  # spacing, and no space put in where a line ended.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set body "Erster Absatz mit  zwei Leerzeichen und einigen Woertern mehr,\
      damit er umbricht.\nZweiter Absatz.\n\nVierter Absatz nach einem leeren."
  set result [$doc text $body -at {20 30} -width 40 -height 12]
  $doc destroy
  set rest [dict get $result rest]
  # A suffix: at exactly the distance from the end its length says - and the
  # blank paragraph is still in it.
  list [expr {[string first $rest $body]
      == [string length $body] - [string length $rest]}] \
      [llength [split $rest \n]]
} -result {1 4}

test textFlow-1.7 {a soft hyphen in the rest is still soft} -body {
  # The line drawn ends in a real hyphen; the word it broke goes on in the
  # rest with its remaining marks and WITHOUT the hyphen. Rebuilt from lines
  # it came back as "Donau- dampfschiff": a hard hyphen, a space, two words.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body "aa bb Donau\u00ADdampf\u00ADschiff cc dd"
  set result [$doc text $body -at {20 30} -width 18 -height 5]
  $doc destroy
  set rest [dict get $result rest]
  list [expr {[string first $rest $body]
      == [string length $body] - [string length $rest]}] \
      [string first "\u00AD" $rest] [string first "- " $rest]
} -result {1 5 -1}

test textFlow-1.8 {a word the fallback broke by character is one word in the rest} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body "aa Donaudampfschifffahrt cc"
  set result [$doc text $body -at {20 30} -width 15 -height 5]
  $doc destroy
  # One line drawn - "aa" and the first piece do not share it, the piece is
  # too wide - and the whole word comes back, not "Donauda mpfschiff fahrt".
  dict get $result rest
} -result {Donaudampfschifffahrt cc}

test textFlow-1.9 {the spacing of a paragraph held back is not counted} -body {
  # y is the baseline under the last line DRAWN. It used to move down by one
  # spacing for every paragraph in the rest, so with three paragraphs and
  # room for one it answered two spacings below where it should.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 12
  set limited [$doc text "p1 a\np2 b\np3 c" -at {20 100} -width 50 -height 9 \
      -paragraphSpacing 2]
  set plain [$doc text "p1 a" -at {20 100} -width 50 -paragraphSpacing 2]
  $doc destroy
  list [expr {abs([dict get $limited y] - $plain) < 0.001}] \
      [format %.2f [dict get $limited y]]
} -result {1 105.08}

test textFlow-2.1 {an indent narrows the column and moves the lines} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9
  $doc text $::flowBody -at {20 30} -width 60 -indent 10
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # 30 mm from the left edge of the page, in points, on every line.
  list [llength [lsort -unique $starts]] [lindex $starts 0]
} -result {1 85.04}

test textFlow-2.2 {-firstIndent only moves the first line of a paragraph} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9
  $doc text $::flowBody -at {20 30} -width 60 -firstIndent 8
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # The first line starts 8 mm further in, the others at the column edge.
  list [lindex $starts 0] [lindex $starts 1] \
      [llength [lsort -unique [lrange $starts 1 end]]]
} -result {79.37 56.69 1}

test textFlow-2.3 {a negative -firstIndent hangs the first line out} -body {
  # The hanging indent of a numbered list: the first line starts left of the
  # column, the rest of the paragraph is indented under it.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9
  $doc text $::flowBody -at {20 30} -width 60 -indent 10 -firstIndent -10
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  list [lindex $starts 0] [lindex $starts 1]
} -result {56.69 85.04}

test textFlow-2.4 {-paragraphSpacing shows up between paragraphs only} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  $doc text "Eins.\nZwei.\nDrei." -at {20 30} -width 60 -paragraphSpacing 5
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set ys [::tclpdfTest::starts $stream y]
  # 12 pt leading plus 5 mm spacing, the same between each pair.
  list [lsort -unique [::tclpdfTest::steps $ys]] [llength $ys]
} -result {26.17 3}

test textFlow-2.5 {textLines and textHeight read the indents like text does} -body {
  # They used to hand everything but the width on to the font state, which
  # ignores what it does not know - so a caller measuring an indented block
  # got the height of an unindented one.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set plain [$doc textLines $::flowBody -width 60]
  set indented [$doc textLines $::flowBody -width 60 -indent 10 -indentRight 10]
  set height [$doc textHeight $::flowBody -width 60]
  set taller [$doc textHeight $::flowBody -width 60 -indent 10 -indentRight 10]
  $doc destroy
  list [expr {[llength $indented] > [llength $plain]}] [expr {$taller > $height}]
} -result {1 1}

test textFlow-2.6 {an option they do not know is refused, not swallowed} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set codes [list [catch {$doc textHeight "x" -width 60 -foo 1} height] \
      [catch {$doc textLines "x" -width 60 -foo 1} lines]]
  $doc destroy
  list $codes [string match {*unknown option "-foo" for textHeight*} $height] \
      [string match {*unknown option "-foo" for textLines*} $lines]
} -result {{1 1} 1 1}

test textFlow-2.7 {textHeight is exactly what text advances by} -body {
  # The same option list to both, and the height is the difference between
  # the y [text] returns and the y it was given - indents, paragraph spacing
  # and the ascender of -anchor top included.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body "$::flowBody\n$::flowBody"
  set results {}
  foreach options {
    {-width 60 -indent 10 -paragraphSpacing 5}
    {-width 60 -indent 10 -paragraphSpacing 5 -anchor top}
    {-width 60 -firstIndent 8 -align justify}
  } {
    set height [$doc textHeight $body {*}$options]
    set below [$doc text $body -at {20 30} {*}$options]
    lappend results [expr {abs($below - 30 - $height) < 0.001}]
  }
  $doc destroy
  set results
} -result {1 1 1}

test textFlow-2.8 {the width is still taken positionally, and checked either way} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set same [expr {[$doc textLines $::flowBody 60] eq [$doc textLines $::flowBody -width 60]}]
  set codes [list [catch {$doc textLines "ab cd" -width 0} zero] \
      [catch {$doc textLines "ab cd" -width -5} negative] \
      [catch {$doc text "ab cd" -at {10 10} -width 0} drawn]]
  $doc destroy
  list $same $codes [string match {*-width must be a positive number*} $zero] \
      [string match {*not "-5"*} $negative] \
      [string match {*-width must be a positive number*} $drawn]
} -result {1 {1 1 1} 1 1 1}

test textFlow-3.1 {a rectangle pushes the lines beside it} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  # The shape sits on the left of the first two lines, so those start to its
  # right; the text is long enough to run past it and come back.
  set body $::flowBody
  append body " " $::flowBody
  $doc text $body -at {20 30} -width 120 -avoid {{rect {20 30} {40 12}}}
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # The lines beside the rectangle start after it, the one below it at the
  # column edge again. The FIRST line is not pushed: its baseline sits exactly
  # on the top edge of the shape, so its letters stand above the shape and its
  # band only touches it - which is right, and worth pinning down.
  list [lindex $starts 0] [expr {[lindex $starts 1] > 160}] [lindex $starts end]
} -result {56.69 1 56.69}

test textFlow-3.2 {a circle narrows the lines by its chord} -body {
  # The point of treating a circle as a circle: the line through the middle is
  # pushed furthest, the ones at top and bottom hardly at all. A bounding box
  # would push them all equally.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 8 -leading 10
  # Long enough to reach past the circle: it sits between 40 and 80 mm, and a
  # short paragraph would simply end above it.
  set body {}
  for {set n 0} {$n < 8} {incr n} {
    append body $::flowBody " "
  }
  $doc text $body -at {20 30} -width 150 -avoid {{circle {40 60} 20}}
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # Several different starts, and the widest push is larger than the first
  # one that meets the circle at all.
  set pushed [lsearch -all -inline -not $starts 56.69]
  list [expr {[llength [lsort -unique $pushed]] > 2}] \
      [expr {[lindex [lsort -real $pushed] end] > [lindex [lsort -real $pushed] 0]}]
} -result {1 1}

test textFlow-3.3a {-avoidMargin keeps the text off the shape} -body {
  # Without it the words touch the picture, which reads as a mistake even
  # though the geometry is exact. The distance is a property of the layout,
  # not of the shape, so it is stated per block.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set body $::flowBody
  append body " " $::flowBody
  $doc text $body -at {20 30} -width 120 -avoid {{rect {20 30} {40 12}}}
  set tight [flowStarts [::tclpdfTest::content $doc]]
  $doc page add
  $doc text $body -at {20 30} -width 120 -avoid {{rect {20 30} {40 12}}} \
      -avoidMargin 5
  set roomy [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # 5 mm further to the right, in points, on the lines beside the rectangle.
  expr {abs(([lindex $roomy 1] - [lindex $tight 1]) - 14.17) < 0.01}
} -result 1

test textFlow-3.3b {a shape may carry a margin of its own} -body {
  # A picture with a caption under it needs more room than a rule beside the
  # column, so the per-shape value wins over the one for the block.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  set body $::flowBody
  append body " " $::flowBody
  $doc text $body -at {20 30} -width 120 \
      -avoid {{rect {20 30} {40 12} 10}} -avoidMargin 2
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc page add
  $doc text $body -at {20 30} -width 120 -avoid {{rect {20 30} {40 12}}} \
      -avoidMargin 2
  set plain [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # 8 mm more than the block margin of 2, in points.
  expr {abs(([lindex $starts 1] - [lindex $plain 1]) - 22.68) < 0.01}
} -result 1

test textFlow-3.3c {the margin grows a circle in every direction} -body {
  # Not only sideways: a margin that only widened the chord would let the
  # lines above and below the circle run into it.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 8 -leading 10
  set body {}
  for {set n 0} {$n < 8} {incr n} {
    append body $::flowBody " "
  }
  $doc text $body -at {20 30} -width 150 -avoid {{circle {40 60} 20}}
  set tight [llength [lsearch -all -inline -not [flowStarts \
      [::tclpdfTest::content $doc]] 56.69]]
  $doc page add
  $doc text $body -at {20 30} -width 150 -avoid {{circle {40 60} 20}} \
      -avoidMargin 6
  set roomy [llength [lsearch -all -inline -not [flowStarts \
      [::tclpdfTest::content $doc]] 56.69]]
  $doc destroy
  # A larger circle reaches into more line bands, so more lines are pushed.
  expr {$roomy > $tight}
} -result 1

test textFlow-3.3 {a shape below the text changes nothing} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  $doc text $::flowBody -at {20 30} -width 60
  set plain [::tclpdfTest::content $doc]
  $doc page add
  $doc text $::flowBody -at {20 30} -width 60 -avoid {{rect {20 200} {40 20}}}
  set avoided [::tclpdfTest::content $doc]
  $doc destroy
  expr {$plain eq $avoided}
} -result 1

test textFlow-3.4 {an unknown shape is refused at the call} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set codes [list [catch {$doc text "x" -at {20 30} -width 60 \
          -avoid {{triangle {1 2} 3}}} triangle] \
      [catch {$doc text "x" -at {20 30} -width 60 -avoid {{rect {1 2}}}} short]]
  $doc destroy
  list $codes [string match {*not \"triangle\"*} $triangle] \
      [string match {*{rect {x y} {width height} ?margin?}*} $short]
} -result {{1 1} 1 1}

test textFlow-3.5 {-anchor top measures the shapes from the first baseline} -body {
  # The band was measured from -at, and with -anchor top that is one ascender
  # above the first baseline: the block sat lower than the band thought, and
  # the first line ran through the shape at full width.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body [string repeat "The quick brown fox jumps over the lazy dog. " 4]
  # The top edge of the rectangle lies 1.5 mm under the top of the letters,
  # so the very first line has to be narrowed.
  $doc text $body -at {20 25} -width 80 -anchor top \
      -avoid {{rect {20 26.5} {40 30}}}
  set starts [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  # 60 mm from the left edge, in points, for EVERY line - the block ends
  # beside the rectangle.
  lsort -unique $starts
} -result {170.08}

test textFlow-3.6 {the indents survive a shape that is nowhere near} -body {
  # -avoid replaced the indent band instead of narrowing it, so every line
  # of an indented paragraph started at the column edge as soon as a shape
  # was named, wherever that shape was.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body [string repeat "The quick brown fox jumps over the lazy dog. " 3]
  $doc text $body -at {20 20} -width 80 -indent 10 -indentRight 10 -firstIndent 5
  set plain [flowStarts [::tclpdfTest::content $doc]]
  $doc page add
  $doc text $body -at {20 20} -width 80 -indent 10 -indentRight 10 -firstIndent 5 \
      -avoid {{rect {150 150} {10 10}}}
  set avoided [flowStarts [::tclpdfTest::content $doc]]
  $doc destroy
  list [expr {$plain eq $avoided}] [lrange $plain 0 1]
} -result {1 {99.21 85.04}}

test textFlow-3.7 {a shape wider than the column leaves the lines empty} -body {
  # No free segment wide enough for a character: the line is skipped, not set
  # one letter at a time down through the shape. The text goes on below it.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  $doc text "hello world foo" -at {20 25} -width 40 -avoid {{rect {10 20} {100 30}}}
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set ys [::tclpdfTest::starts $stream y]
  # One line, in one piece, and its baseline below the rectangle: 50 mm from
  # the top of an A4 page is 700.16 pt from the bottom.
  list [llength $ys] [regexp {\(hello world foo\) Tj} $stream] \
      [expr {[lindex $ys 0] < 700.16}]
} -result {1 1 1}

test textFlow-3.8 {a sliver beside a shape is skipped as well} -body {
  # A segment narrower than the widest character would take one character
  # anyway and let it run into the shape. Nothing starts left of the shape.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set body [string repeat "Wide words. " 6]
  # 1 mm free at the left of the column, the rest of the line under the shape.
  $doc text $body -at {20 25} -width 60 -avoid {{rect {21 20} {80 20}}}
  set starts [flowStarts [::tclpdfTest::content $doc]]
  set ys [::tclpdfTest::starts [::tclpdfTest::content $doc] y]
  $doc destroy
  # Every line at the column edge, all of them under the shape (40 mm from
  # the top is 728.50 pt from the bottom).
  list [lsort -unique $starts] [expr {[lindex $ys 0] < 728.5}]
} -result {56.69 1}

test textFlow-3.9 {a measuring call with -avoid needs -at, and says so} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set code [catch {$doc textHeight "x" -width 60 -avoid {{rect {1 2} {3 4}}}} message]
  $doc destroy
  list $code [string match {*-avoid needs -at*} $message]
} -result {1 1}

# --- soft hyphens ---------------------------------------------------------
#
# U+00AD is an offer to break, not a character. Before this it was both wrong
# things at once: the standard fourteen refused the whole string, and an
# embedded face set a visible hyphen in the middle of an unbroken word.

set flowSoft "Die Sil\u00ADben\u00ADtren\u00ADnung ist eine Ver\u00ADbes\u00ADse\u00ADrung."
set flowHard "Die Silbentrennung ist eine Verbesserung."
set flowFont [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts DejaVuSans.ttf]
testConstraint haveFlowFont [file exists $flowFont]

test textFlow-4.1 {a soft hyphen has no width in a standard face} -body {
  # It used to throw here: WinAnsi has a slot at 0xAD and the metrics have no
  # glyph in it, so a paragraph carrying the marks could not be set at all.
  set doc [tclpdf new -unit pt]
  $doc page add
  set with [$doc textWidth $::flowSoft -family helvetica -size 11]
  set without [$doc textWidth $::flowHard -family helvetica -size 11]
  $doc destroy
  expr {abs($with - $without) < 0.0001}
} -result 1

test textFlow-4.2 {nor in an embedded one} -constraints haveFlowFont -body {
  # DejaVu HAS a glyph at U+00AD, which is why this measured 4.33 pt wider and
  # drew "Silben-trennung" in the middle of a line.
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  set with [$doc textWidth $::flowSoft -family body -size 11]
  set without [$doc textWidth $::flowHard -family body -size 11]
  $doc destroy
  expr {abs($with - $without) < 0.0001}
} -result 1

test textFlow-4.3 {the breaker takes the offer and sets a real hyphen} -constraints haveFlowFont -body {
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  set lines [$doc textLines $::flowSoft -family body -size 11 -width 90]
  $doc destroy
  # Every line but the last ends on the hyphen the breaker put there.
  list [lindex $lines 0] [lindex $lines end]
} -result {{Die Silbentren-} rung.}

test textFlow-4.4 {the same text without the marks is broken by character} -constraints haveFlowFont -body {
  # The control for 4.3: whatever ends those lines has to come from the marks
  # and from nothing else. A character fallback ends without a hyphen.
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  set lines [$doc textLines $::flowHard -family body -size 11 -width 90]
  $doc destroy
  expr {[string match {*-} [lindex $lines 0]]}
} -result 0

test textFlow-4.5 {a line that does not break carries no hyphen} -constraints haveFlowFont -body {
  # The offer is only taken where it is needed. On one wide line the marks
  # have to disappear without a trace.
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  set lines [$doc textLines $::flowSoft -family body -size 11 -width 400]
  $doc destroy
  list [llength $lines] [string match {*-*} [lindex $lines 0]]
} -result {1 0}

test textFlow-4.6 {the remainder keeps the offers it still has} -constraints haveFlowFont -body {
  # A word may be broken more than once. At this width every syllable is a
  # line of its own, which only works if the leftover carries its marks on.
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  set lines [$doc textLines "Sil\u00ADben\u00ADtren\u00ADnung" -family body \
      -size 11 -width 30]
  $doc destroy
  set lines
} -result {Sil- ben- tren- nung}

# The content stream of one paragraph in the embedded face - for comparing two
# spellings of the same text against each other.
proc flowStream {text width} {
  set doc [tclpdf new -unit pt]
  $doc font embed body $::flowFont
  $doc page add
  $doc text $text -at {20 40} -width $width -family body -size 11
  set content [::tclpdfTest::content $doc]
  $doc destroy
  return $content
}

test textFlow-4.7 {an unbroken line reaches the page as if the marks were absent} -constraints haveFlowFont -body {
  # The strongest statement available without a reader: at a width wide enough
  # to need no break, the two spellings have to produce the SAME content
  # stream - same glyphs, same kerning, same position. Anything left of the
  # marks would show up here.
  expr {[flowStream $::flowSoft 400] eq [flowStream $::flowHard 400]}
} -result 1

test textFlow-4.8 {and at a width that forces the break they differ} -constraints haveFlowFont -body {
  # The other direction, so that 4.7 cannot pass by drawing nothing at all.
  expr {[flowStream $::flowSoft 90] ne [flowStream $::flowHard 90]}
} -result 1

test textFlow-shy-1.1 {a break hyphen is bracketed so it extracts away} -body {
  # 14.8.2.6: a soft and a hard hyphen have to be distinguishable. The break
  # hyphen is drawn as a real U+002D so the line looks right, and it sits in a
  # Span with an EMPTY ActualText so a reader skips it - the word comes back
  # whole. ToUnicode cannot do this: one glyph would have to mean two things.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  $doc text "Sil\u00ADben\u00ADtren\u00ADnung hier." -at {20 20} -width 22
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # The hyphen is shown on its own between the bracket and its end, and the
  # brackets balance.
  list [regexp {/Span <</ActualText <FEFF>>> BDC} $stream] \
      [expr {[regexp -all {BDC} $stream] == [regexp -all {EMC} $stream]}]
} -result {1 1}

test textFlow-shy-1.2 {an ordinary hyphen is left alone} -body {
  # The bracket may only go around a hyphen the BREAKER put there. A word
  # that carries its own would otherwise lose it when the text is extracted -
  # "E-Mail" would come back as "EMail".
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  $doc text "Eine E-Mail-Adresse bleibt ganz." -at {20 20} -width 60
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  regexp {ActualText} $stream
} -result 0

test textFlow-shy-1.3 {an untagged document is unchanged by any of it} -body {
  # Nothing that exists today may come out with different bytes.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "Sil\u00ADben\u00ADtren\u00ADnung hier." -at {20 20} -width 22
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  list [regexp {ActualText} $stream] [regexp {BDC} $stream] \
      [regexp {\(Silbentren-\)} $stream]
} -result {0 0 1}

cleanupTests

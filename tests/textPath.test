# textPath.test --
#
# A line of text set along a path.
#
# PDF has no operator for this, so the whole feature is arithmetic: the curve
# is flattened, the arc length walked, and every glyph gets its own matrix.
# These tests aim at the arithmetic - the straight cases where the answer is
# known exactly, and the properties that must hold on a curve.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::textPath
source [file join [file dirname [info script]] helper.tcl]

set pathFace [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts DejaVuSans.ttf]
testConstraint havePathFace [file exists $pathFace]

test textPath-1.1 {every glyph gets its own text block} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "ABCDE" -segments {{move 20 100} {line 120 100}} -size 12
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # Five glyphs, five BT/ET blocks - and each one a Tj of its own.
  list [regexp -all {BT} $stream] [regexp -all {Tj} $stream]
} -result {5 5}

test textPath-1.2 {on a straight horizontal path the glyphs sit on one line} -body {
  # The case where the answer is known: no rotation, so Td rather than Tm, the
  # same y for every glyph, and x increasing by the glyph widths.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "ABCDE" -segments {{move 20 100} {line 120 100}} \
      -family helvetica -size 12
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set xs [::tclpdfTest::starts $stream]
  set ys [::tclpdfTest::starts $stream y]
  set rising 1
  foreach a [lrange $xs 0 end-1] b [lrange $xs 1 end] {
    if {$b <= $a} {
      set rising 0
    }
  }
  list [llength [lsort -unique $ys]] $rising [regexp {Tm} $stream]
} -result {1 1 0}

test textPath-1.3 {the glyphs stand where plain text would put them} -body {
  # A straight path is the same job [text] does, so the two have to agree -
  # otherwise text on a path drifts against everything else on the page.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "ABCDE" -segments {{move 20 100} {line 120 100}} \
      -family helvetica -size 12
  set onPath [::tclpdfTest::starts [::tclpdfTest::content $doc]]
  $doc page add
  $doc text "A" -at {20 100} -family helvetica -size 12
  set plain [::tclpdfTest::starts [::tclpdfTest::content $doc]]
  $doc destroy
  # The first glyph starts at the start of the path.
  expr {abs([lindex $onPath 0] - [lindex $plain 0]) < 0.01}
} -result 1

test textPath-2.1 {a vertical path turns every glyph by ninety degrees} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "AB" -segments {{move 50 200} {line 50 100}} \
      -family helvetica -size 12
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # Upwards on the page: the exact matrix of a quarter turn.
  list [regexp -all {0 1 -1 0} $stream] [regexp {Td} $stream]
} -result {2 0}

test textPath-2.2 {-align moves the string along the path} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  # A dict, not an array: every test file shares one interpreter, and a
  # global named "start" already exists in another one - which fails only in
  # the full run and looks like a defect in this feature.
  set starts {}
  foreach align {left center right} {
    $doc page add
    $doc textPath "ABC" -segments {{move 20 100} {line 120 100}} \
        -family helvetica -size 12 -align $align
    dict set starts $align [lindex [::tclpdfTest::starts \
        [::tclpdfTest::content $doc]] 0]
  }
  $doc destroy
  list [expr {[dict get $starts left] < [dict get $starts center]}] \
      [expr {[dict get $starts center] < [dict get $starts right]}]
} -result {1 1}

test textPath-2.3 {-offset lifts the baseline off the path} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "AB" -segments {{move 20 100} {line 120 100}} -size 12
  set on [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc] y] 0]
  $doc page add
  $doc textPath "AB" -segments {{move 20 100} {line 120 100}} -size 12 -offset 5
  set off [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc] y] 0]
  $doc destroy
  # 5 mm further from the path - upwards on the page, so upwards in PDF too.
  expr {abs(($off - $on) - 14.17) < 0.01}
} -result 1

test textPath-2.4 {on a vertical path the offset acts on x} -body {
  # The other half of the perpendicular: with a horizontal path the offset is
  # entirely in y, and a version that dropped its x term passed every test
  # until this one. Upwards on the page, "above the path" is to its left.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "AB" -segments {{move 50 200} {line 50 100}} -size 12
  set plain [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc]] 0]
  $doc page add
  $doc textPath "AB" -segments {{move 50 200} {line 50 100}} -size 12 -offset 5
  set lifted [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc]] 0]
  $doc destroy
  # 5 mm to the left, in points.
  expr {abs(($plain - $lifted) - 14.17) < 0.01}
} -result 1

test textPath-3.1 {the call returns the length of the path} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set length [$doc textPath "A" -segments {{move 20 100} {line 120 100}} -size 12]
  $doc destroy
  format %.2f $length
} -result 100.00

test textPath-3.2 {a curve is longer than the straight line under it} -body {
  # The flattening at work: a Bezier arching well above its ends cannot be as
  # short as the distance between them.
  set doc [tclpdf new -unit mm]
  $doc page add
  set straight [$doc textPath "A" -segments {{move 20 100} {line 120 100}} -size 8]
  $doc page add
  set curved [$doc textPath "A" \
      -segments {{move 20 100} {curve 45 40 95 40 120 100}} -size 8]
  $doc destroy
  list [expr {$curved > $straight}] [expr {$curved < 2 * $straight}]
} -result {1 1}

test textPath-3.3 {glyphs beyond the end of the path are dropped} -body {
  # A string longer than its path loses what does not fit rather than piling
  # the remaining glyphs on top of each other at the end - which is what a
  # naive clamp to the last point would do.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "EIN VIEL ZU LANGER SATZ FUER DIESEN KURZEN WEG" \
      -segments {{move 20 100} {line 40 100}} -family helvetica -size 12
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set drawn [regexp -all {Tj} $stream]
  list [expr {$drawn > 0}] [expr {$drawn < 46}]
} -result {1 1}

test textPath-3.4 {-spacing reaches the cursor, not just the measurement} -body {
  # The alignment takes the width of the whole string, which counts the gap
  # between every pair of glyphs; the drawing places one glyph at a time and
  # added up bare advances. Measured before the fix at -spacing 3: the string
  # measured 44.3715 mm and drew 32.7298 mm, so -align center placed it by a
  # length that never appeared on the page.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font -family helvetica -size 20 -spacing 3
  $doc textPath "Rundtext" -segments {{move 20 60} {line 190 60}} -align left
  set stream [::tclpdfTest::content $doc]
  set xs {}
  foreach {. x} [regexp -all -inline {([0-9.]+) [0-9.]+ Td} $stream] {
    lappend xs $x
  }
  # The span from the first glyph to the last is the measured width minus the
  # last glyph's own advance - in points, which is what the stream carries.
  set drawn [expr {[lindex $xs end] - [lindex $xs 0]}]
  set expected [expr {([$doc textWidth "Rundtext"] - [$doc textWidth "t"])
      * 72.0 / 25.4}]
  $doc destroy
  expr {abs($drawn - $expected) < 0.001}
} -result 1

test textPath-4.1 {a path is required, and so are its segments} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set codes [list [catch {$doc textPath "x"} missing] \
      [catch {$doc textPath "x" -segments {{move 10 10}}} single] \
      [catch {$doc textPath "x" -segments {{wobble 1 2}}} unknown] \
      [catch {$doc textPath "x" -segments {{move 1 1} {line 9 9}} \
          -align justify} align]]
  $doc destroy
  list $codes [string match {*needs -segments*} $missing] \
      [string match {*at least two points*} $single] \
      [string match {*unknown path segment*} $unknown] \
      [string match {*left, right or center*} $align]
} -result {{1 1 1 1} 1 1 1 1}

test textPath-5.1 {a right-to-left path runs the other way, numbers do not} \
    -constraints havePathFace -body {
  # Along a path the glyphs are placed one at a time, so the reordering cannot
  # be the reversal of a finished run - the loop has to walk the same pieces
  # [text] turns round. If it did not, a straight path and a straight baseline
  # would set the same string two different ways.
  #
  # The path is a straight line, so the order the glyphs are DRAWN in is the
  # order they appear in the stream, and each one is its own show operator.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed face $::pathFace
  $doc textPath "שלום 4711" -segments {{move 20 60} {line 190 60}} \
      -family face -size 12 -direction rtl
  set drawn [::tclpdfTest::drawnText $doc face [$doc page content]]
  $doc destroy
  set drawn
} -result {4711 םולש}

test textPath-5.2 {-align is mirrored on a path as it is on a baseline} \
    -constraints havePathFace -body {
  # -align names the end the text starts at IN READING ORDER, so on a
  # right-to-left path the default "left" is the far end. Measured on the x of
  # the first glyph drawn: it has to sit where an ltr line with -align right
  # begins its LAST glyph - which is the same place, the string being the same
  # width either way.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed face $::pathFace
  $doc font -family face -size 12
  $doc textPath "שלום" -segments {{move 20 60} {line 190 60}} -direction rtl
  set defaultEnd [lindex [::tclpdfTest::starts [$doc page content]] end]
  $doc destroy
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed face $::pathFace
  $doc font -family face -size 12
  $doc textPath "שלום" -segments {{move 20 60} {line 190 60}} -direction rtl \
      -align right
  set rightStart [lindex [::tclpdfTest::starts [$doc page content]] 0]
  $doc destroy
  # The default ends at the right hand end of the path; -align right starts at
  # the left hand one.
  set left [expr {20 * 72.0 / 25.4}]
  list [expr {$defaultEnd > $left + 100}] \
      [expr {abs($rightStart - $left) < 0.01}]
} -result {1 1}

test textPath-4.2 {a refused run leaves no bracket open in a tagged document} -body {
  # The mark was taken and its BDC written BEFORE the path was flattened and
  # measured, so a path too short for text left the bracket standing and
  # everything after it on the page was read as part of an element that had
  # refused to exist.
  set wrong {}
  foreach call {
    {textPath "x" -segments {{move 10 10}}}
    {textPath "x" -segments {{wobble 1 2}}}
    {textPath "x" -segments {{move 1 1} {line 9 9}} -align justify}
  } {
    set doc [tclpdf new -unit mm]
    $doc tagged 1
    $doc page add
    set code [catch {$doc {*}$call}]
    set stream [::tclpdfTest::content $doc]
    $doc destroy
    set counts [list [regexp -all {BDC} $stream] [regexp -all {EMC} $stream] \
        [regexp -all {(?:^|\s)BT(?=\s)} $stream] [regexp -all {(?:^|\s)ET(?=\s)} $stream]]
    if {$code != 1 || $counts ne {0 0 0 0}} {
      lappend wrong [list $call code $code counts $counts]
    }
  }
  # And the good case still gets exactly one bracket around the whole run.
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  $doc textPath "xy" -segments {{move 10 10} {line 90 10}}
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  list $wrong [regexp -all {BDC} $stream] [regexp -all {EMC} $stream]
} -result {{} 1 1}

# --- the spellings and the font options ---------------------------------------

test textPath-6.1 {-align centre is -align center} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc textPath "ABC" -segments {{move 20 100} {line 120 100}} \
      -family helvetica -size 12 -align center
  set center [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc]] 0]
  $doc page add
  $doc textPath "ABC" -segments {{move 20 100} {line 120 100}} \
      -family helvetica -size 12 -align centre
  set centre [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc]] 0]
  $doc destroy
  # The same start, and neither of them the start of the path.
  list [expr {abs($center - $centre) < 0.001}] \
      [expr {$center > 20 * 72 / 25.4 + 10}]
} -result {1 1}

test textPath-6.2 {-tag names the element the run becomes} -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  $doc textPath "xy" -segments {{move 10 10} {line 90 10}} -tag H2
  set heading [::tclpdfTest::content $doc]
  $doc page add
  $doc textPath "xy" -segments {{move 10 10} {line 90 10}} -tag Artifact
  set artifact [::tclpdfTest::content $doc]
  $doc destroy
  # One bracket around the whole run either way: a heading with a marked
  # content id, an artifact without one.
  list [regexp -all {/H2 <</MCID} $heading] [regexp -all {MCID} $artifact] \
      [regexp -all {/Artifact <<[^>]*>> BDC} $artifact]
} -result {1 0 1}

test textPath-6.3 {-style and -color reach every glyph of the run} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family times -size 12
  $doc textPath "ABC" -segments {{move 20 100} {line 120 100}} \
      -style italic -color {0.2 0.4 0.6}
  set stream [::tclpdfTest::content $doc]
  set state [$doc font]
  $doc destroy
  # Three glyphs, each in its own text block with the face and the colour
  # stated - and the state as it was before.
  list [regexp -all {/FTimesItalic 12 Tf} $stream] [regexp -all {0.2 0.4 0.6 rg} $stream] \
      [dict get $state resolved] [dict get $state color]
} -result {3 3 Times-Roman black}

# -- -offset -------------------------------------------------------------------

test textPath-7.1 {-offset takes a distance of either sign and refuses the rest in tclpdf's words} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  set code [catch {$doc textPath "xy" -segments {{move 10 10} {line 90 10}} -offset abc} message]
  set empty [string length [::tclpdfTest::content $doc]]
  set above [catch {$doc textPath "xy" -segments {{move 10 10} {line 90 10}} -offset 3}]
  set below [catch {$doc textPath "xy" -segments {{move 10 10} {line 90 10}} -offset -3}]
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # Refused before the mark: an empty stream after the refusal, and the two
  # accepted runs bracket themselves as before.
  list $code [regexp -- {-offset takes a distance in the document unit, not "abc"} $message] \
      $empty $above $below [regexp -all {BDC} $stream] [regexp -all {EMC} $stream]
} -result {1 1 0 0 0 2 2}

cleanupTests

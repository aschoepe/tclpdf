# xmp.test --
#
# The metadata packet, and the fact that more than one topic writes into it.
#
# Two things are worth testing here and neither is the XML: that a second
# contributor does not overwrite the first, and that what comes IN from a
# caller is parsed rather than pasted. The XML itself is tdom's business now,
# which is the point of building it with a parser.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
source [file join [file dirname [info script]] helper.tcl]

# This file needs the XMP modules and therefore tdom, which is optional for
# the package itself - so the file steps aside where it is missing rather
# than taking the run down with it. helper.tcl sets the constraint.
if {![testConstraint haveTdom]} {
    puts "  skipped: [file tail [info script]] needs tdom"
    cleanupTests
    return
}
package require tclpdf::xmp
package require tclpdf::pdfa

set here [file dirname [file dirname [file normalize [info script]]]]
set face [file join $here examples assets fonts DejaVuSans.ttf]
testConstraint haveFace [file exists $face]

# A minimal document with an EMBEDDED face. PDF/A refuses a standard font at
# write time, so every document that declares it needs one - which is the
# rule working, not an inconvenience.
proc probe {face} {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed face $face
  $doc font -family face
  $doc text "x" -at {20 20}
  return $doc
}

# --- the timestamp --------------------------------------------------------

test xmp-1.1 {the zone offset carries its colon} -body {
  # XMP wants +HH:MM and [clock format %z] gives +HHMM. Every document this
  # package wrote before 2026-08-15 had the colon missing, because the line
  # meant to insert it used [string replace] with last before first - which
  # returns the string unchanged instead of inserting. No validator objected,
  # so only a test can hold this.
  set stamp [::tclpdf::xmp stamp 1755000000]
  list [regexp {^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d[-+]\d\d:\d\d$} $stamp] \
      [string length $stamp]
} -result {1 25}

test xmp-1.2 {the moment is the one it was given} -body {
  # Two calls a second apart must not answer the same, or a document's dates
  # would be whatever the first write happened to see.
  set early [::tclpdf::xmp stamp 1755000000]
  set later [::tclpdf::xmp stamp 1755003600]
  expr {$early ne $later}
} -result 1

# --- who writes into the packet -------------------------------------------

test xmp-2.1 {two topics share the packet, in registration order} -constraints haveTdom -body {
  # PDF/A first, PDF/UA second - the order they were declared in, and the
  # order they appear in. A packet whose order depended on a dict iteration
  # would differ between runs.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc info Title "Zwei Anspruecke"
  $doc language de-DE
  $doc page add
  $doc font embed face [file join [file dirname [file dirname \
      [file normalize [info script]]]] examples assets fonts DejaVuSans.ttf]
  $doc font -family face
  $doc structure H1 -script {$doc text "x" -at {20 20}}
  $doc pdfa -part 3 -conformance A
  $doc ua 1
  set path [::tclpdfTest::scratch xmp-both.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set a [string first "pdfaid:part" $bytes]
  set u [string first "pdfuaid:part" $bytes]
  list [expr {$a > 0}] [expr {$u > 0}] [expr {$a < $u}]
} -result {1 1 1}

test xmp-2.2 {declaring a topic twice does not describe it twice} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc pdfa -part 2 -conformance U
  set path [::tclpdfTest::scratch xmp-twice.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # One description, and it carries the LAST declaration - the callback reads
  # the state at write time rather than at registration.
  list [regexp -all {<pdfaid:part>} $bytes] \
      [regexp {<pdfaid:part>2</pdfaid:part>} $bytes] \
      [regexp {<pdfaid:conformance>U</pdfaid:conformance>} $bytes]
} -result {1 1 1}

# The caller's packet has to carry every claim itself - see xmp-2.4 - so this
# one says pdfaid:part 9, which no builder would ever write: what reaches the
# file is theirs and nothing else.
set callerPacket {<?xpacket begin="" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF\
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description\
 rdf:about="" xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"><pdfaid:part>9</pdfaid:part></rdf:Description></rdf:RDF></x:xmpmeta>
<?xpacket end="w"?>}

test xmp-2.3 {an explicit packet wins over the built one} -constraints {haveFace haveTdom} -body {
  # A caller who supplies their own has said something more specific than
  # anything this module would assemble.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc metadata $callerPacket
  set path [::tclpdfTest::scratch xmp-explicit.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {<pdfaid:part>9</pdfaid:part>} $bytes] [regexp {dc:title} $bytes]
} -result {1 0}

test xmp-2.4 {a claim that is not in the caller's packet is refused, in both orders} -constraints {haveFace haveTdom} -body {
  # A packet set by the caller REPLACES the built one, and with it every
  # description a topic registered. Measured 2026-08-26: "metadata <own
  # packet>" with "pdfa -part 3" wrote the output intent and the Info
  # dictionary and no pdfaid at all, and veraPDF answered 6.6.4-1 - the
  # claim never reached the file and nothing said so.
  set empty "<?xpacket begin=\"\"?>\n<x:xmpmeta xmlns:x=\"adobe:ns:meta/\"/>\n<?xpacket end=\"w\"?>"
  set result {}
  foreach order {claimFirst packetFirst} {
    set doc [probe $face]
    if {$order eq "claimFirst"} {
      $doc pdfa -part 3 -conformance B
      $doc metadata $empty
    } else {
      $doc metadata $empty
      $doc pdfa -part 3 -conformance B
    }
    set path [::tclpdfTest::scratch xmp-caller-$order.pdf]
    lappend result [catch {$doc write $path} err] \
        [string match {*pdfaid*does not carry it*} $err] \
        [lrange $::errorCode 0 2] [file exists $path]
    $doc destroy
    file delete $path
  }
  set result
} -result {1 1 {TCLPDF XMP CALLER} 0 1 1 {TCLPDF XMP CALLER} 0}

# --- what comes in from outside -------------------------------------------

test xmp-3.1 {a contribution may use the prefixes of the place it lands in} -constraints {haveFace haveTdom} -body {
  # The Factur-X extension schema says rdf:Bag without declaring rdf, because
  # the rdf:RDF around it always has. Parsed on its own it is not well formed;
  # this has to accept it anyway.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc pdfa extension {<rdf:Description rdf:about="" xmlns:probe="urn:probe">
      <probe:list><rdf:Bag><rdf:li>eins</rdf:li></rdf:Bag></probe:list>
    </rdf:Description>}
  set path [::tclpdfTest::scratch xmp-raw.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {probe:list} $bytes] [regexp {<rdf:li>eins</rdf:li>} $bytes]
} -result {1 1}

test xmp-3.2 {a malformed contribution fails at the call, not in a validator} -constraints {haveFace haveTdom} -body {
  # The whole reason for parsing it: an unclosed element used to travel into
  # the file, where qpdf and veraPDF both let it pass and only a human
  # reading the XMP would ever have found it.
  #
  # At the CALL, which is what this test has always been named after and
  # what it did not measure until 2026-08-25: the parse happened at write
  # time, so the refusal came from [write] - the call that made the mistake
  # had long returned, and the contribution could not be taken back out.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set code [catch {$doc pdfa extension \
      {<rdf:Description rdf:about=""><probe:open></rdf:Description>}} err]
  $doc destroy
  list $code [string match "*not well formed XML*" $err]
} -result {1 1}

test xmp-3.3 {the text of a title is escaped by the parser} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc info Title "Fuenf & Sechs <sieben>"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-escape.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Only the packet: the Info dictionary carries the same title as a PDF
  # string, where the angle brackets are ordinary characters and SHOULD
  # stand there unescaped.
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {Fuenf &amp; Sechs &lt;sieben&gt;} $packet] \
      [regexp {<sieben>} $packet]
} -result {1 0}

# --- the shape of the packet ----------------------------------------------

test xmp-4.1 {a prefix is declared once, on its own description} -constraints {haveFace haveTdom} -body {
  # Declared at the ROOT instead, tdom repeats it on the first element using
  # it - valid XML that breaks any reader matching "pdfaid:part>". Which is
  # not hypothetical: a test here and an example both did.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-shape.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {xmlns:pdfaid} $bytes] \
      [regexp {<pdfaid:part>3</pdfaid:part>} $bytes]
} -result {1 1}

test xmp-4.2 {the packet begins with its processing instruction} -constraints haveTdom -body {
  # It did not, once: a loop variable inside a contribution script shared a
  # name with the variable the packet was being appended to, and a URI ended
  # up in front of the opening instruction. qpdf accepted the file; veraPDF
  # reported an XMP with nothing in it at all.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc info Title "T"
  $doc language de-DE
  $doc page add
  $doc font embed face [file join [file dirname [file dirname \
      [file normalize [info script]]]] examples assets fonts DejaVuSans.ttf]
  $doc font -family face
  $doc structure H1 -script {$doc text "x" -at {20 20}}
  $doc ua -part 2 -wtpdf accessibility
  set path [::tclpdfTest::scratch xmp-begin.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Whatever precedes the packet is PDF syntax; the packet itself starts at
  # its instruction, with nothing between that and the stream keyword.
  regexp {stream\r?\n<\?xpacket begin=} $bytes
} -result 1

# --- the bytes of the packet ----------------------------------------------
#
# The stream's BOM declares UTF-8 (XMP part 1; ISO 19005 6.6.2.1), so the
# packet has to be encoded on its way in. It was not: a title with an umlaut
# went out as Latin-1 bytes under the UTF-8 claim, and one with a character
# above U+00FF made the writer refuse the document altogether.

test xmp-5.1 {an umlaut in the title reaches the stream as UTF-8 bytes} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc info Title "M\u00fcller"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-umlaut.pdf]
  set code [catch {$doc write $path}]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Only the packet: the font stream may contain any byte, including 0xFC.
  regexp {<\?xpacket begin=.*?<\?xpacket end="w"\?>} $bytes packet
  list $code [string match "*M\xc3\xbcller*" $packet] \
      [string match "*\xfc*" $packet]
} -result {0 1 0}

test xmp-5.2 {a euro sign in the title does not make the document unwritable} -constraints {haveFace haveTdom} -body {
  # U+20AC is above U+00FF, and an unencoded packet then failed the writer's
  # byte check - "stream data must be bytes, not text" for a legal title.
  set doc [probe $face]
  $doc info Title "5\u20ac"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-euro.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<\?xpacket begin=.*?<\?xpacket end="w"\?>} $bytes packet
  list $code [string match "*5\xe2\x82\xac*" $packet]
} -result {0 1}

test xmp-5.3 {a title outside the BMP writes under both interpreters} -constraints {haveFace haveTdom} -body {
  # Built from UTF-8 bytes, the way a title read from a file arrives: Tcl 8.6
  # holds U+1D11E as a surrogate pair and serialises it back to the real
  # four-byte sequence; Tcl 9 holds it whole and tdom writes a character
  # reference. Different spellings, both valid - what this test holds is that
  # NEITHER interpreter refuses the document.
  set doc [probe $face]
  $doc info Title "Clef [encoding convertfrom utf-8 [binary format H* f09d849e]]"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-clef.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  expr {$code ? $err : 0}
} -result 0

# --- the two dates ---------------------------------------------------------

test xmp-5.4 {xmp:CreateDate and CreationDate name the same second} -constraints {haveFace haveTdom} -body {
  # Both are taken at the first write, and they used to be two separate clock
  # calls - straddle a second boundary and the file disagrees with itself for
  # good, since both values are stored back for the second write. One value
  # feeds both now. The spellings differ by design: XMP says +02:00 where a
  # 1.7 date says +02'00'.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-dates.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set x [regexp {<xmp:CreateDate>(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)([-+]\d\d):(\d\d)<} \
      $bytes -> Y M D h m s zoneHour zoneMinute]
  set p [regexp {/CreationDate \(D:(\d{14})([-+]\d\d)'(\d\d)'?\)} \
      $bytes -> stamp pdfZoneHour pdfZoneMinute]
  list $x $p [expr {"$Y$M$D$h$m$s" eq $stamp}] \
      [expr {"$zoneHour$zoneMinute" eq "$pdfZoneHour$pdfZoneMinute"}]
} -result {1 1 1 1}

test xmp-5.5 {a second write is byte-identical} -body {
  # The reason the dates and the packet are stored back at all. The packet
  # and the title carry an umlaut, so what is stored is the ENCODED packet -
  # one encoded again on the second write would differ.
  #
  # No embedded face and no [pdfa] here, and that is measured, not chosen:
  # the font path hands out fresh object numbers on every write - a
  # limitation of its own that predates the packet work and holds without it
  # - so an embedded face never writes twice identically. What this test
  # holds is the identity the metadata stream and the dates answer for.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "x" -at {20 20}
  $doc info Title "M\u00fcller"
  $doc metadata "<?xpacket begin=\"\"?>\n<x:xmpmeta>M\u00fcller</x:xmpmeta>\n<?xpacket end=\"w\"?>"
  set first [::tclpdfTest::scratch xmp-first.pdf]
  set second [::tclpdfTest::scratch xmp-second.pdf]
  $doc write $first
  $doc write $second
  $doc destroy
  set same [string equal [::tclpdfTest::readBytes $first] \
      [::tclpdfTest::readBytes $second]]
  file delete $first $second
  set same
} -result 1

# --- the packet follows the document -----------------------------------------
#
# The packet is rebuilt on every write. It used to be built once and left
# standing - [metadata] answered non-empty from the second write on, and
# XmpCatalog took that for a caller's packet - so a title changed between two
# writes reached the Info dictionary, which is rebuilt per write, and never
# the packet. Only a PDF/A-1 validator says so (ISO 19005-1, 6.7.3; measured:
# veraPDF's 1b profile flags a diverging dc:title, 2b and 3b do not), but a
# packet that describes the document as it was is wrong all the same.

# The x-default title of the packet and the Title of the Info dictionary,
# read off the bytes: {xmpTitle infoTitle}.
proc titles {bytes} {
  regexp {<dc:title>\s*<rdf:Alt>\s*<rdf:li xml:lang="x-default">([^<]*)<} $bytes -> x
  regexp {/Title \(([^)]*)\)} $bytes -> i
  return [list $x $i]
}

test xmp-6.1 {a title changed between two writes reaches the packet} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc info Title "First"
  set first [::tclpdfTest::scratch xmp-title-a.pdf]
  set second [::tclpdfTest::scratch xmp-title-b.pdf]
  $doc write $first
  $doc info Title "Second"
  $doc write $second
  $doc destroy
  set a [titles [::tclpdfTest::readBytes $first]]
  set b [titles [::tclpdfTest::readBytes $second]]
  file delete $first $second
  list $a $b
} -result {{First First} {Second Second}}

test xmp-6.2 {a language changed between two writes reaches the packet} -constraints {haveFace haveTdom} -body {
  # dc:language carries what the catalog's /Lang carries, and it follows a
  # change the same way the title does.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc language de-DE
  set first [::tclpdfTest::scratch xmp-lang-a.pdf]
  set second [::tclpdfTest::scratch xmp-lang-b.pdf]
  $doc write $first
  $doc language en-GB
  $doc write $second
  $doc destroy
  set result {}
  foreach path [list $first $second] {
    set bytes [::tclpdfTest::readBytes $path]
    regexp {<dc:language>\s*<rdf:Bag>\s*<rdf:li>([^<]*)<} $bytes -> tag
    regexp {/Lang \(([^)]*)\)} $bytes -> lang
    lappend result [list $tag $lang]
  }
  file delete $first $second
  set result
} -result {{de-DE de-DE} {en-GB en-GB}}

test xmp-6.3 {a caller's packet stands through both writes} -constraints {haveFace haveTdom} -body {
  # What was set from outside is not this module's to rebuild - even when the
  # Info dictionary moves on. The two are told apart by content: what
  # [metadata] holds is ours only if it is what XmpCatalog last put there.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc info Title "First"
  $doc metadata $callerPacket
  set first [::tclpdfTest::scratch xmp-mine-a.pdf]
  set second [::tclpdfTest::scratch xmp-mine-b.pdf]
  $doc write $first
  $doc info Title "Second"
  $doc write $second
  $doc destroy
  set a [::tclpdfTest::readBytes $first]
  set b [::tclpdfTest::readBytes $second]
  file delete $first $second
  list [regexp {<pdfaid:part>9</pdfaid:part>} $a] [regexp {dc:title} $a] \
      [regexp {<pdfaid:part>9</pdfaid:part>} $b] [regexp {dc:title} $b] \
      [regexp {/Title \(Second\)} $b]
} -result {1 0 1 0 1}

test xmp-6.4 {a rebuilt packet is byte-identical when nothing changed} -constraints haveTdom -body {
  # xmp-5.5 holds this for a caller's packet; this one holds it for the BUILT
  # packet, which is now built twice. No embedded face - see xmp-5.5 for why
  # - so the topic that triggers the build is registered here by hand.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "x" -at {20 20}
  $doc info Title "M\u00fcller"
  $doc language de-DE
  oo::objdefine $doc method ProbeXmp {} {return {{text part 3}}}
  $doc xmpSchema probe http://example.org/probe/ {part} ProbeXmp
  lassign [::tclpdfTest::writeTwice $doc xmp-rebuilt] first second
  $doc destroy
  list [string equal $first $second] [regexp {<probe:part>3<} $second] \
      [regexp {<dc:language>} $second]
} -result {1 1 1}

# --- the information dictionary keys ------------------------------------------
#
# [info] takes six keys. Title is measured throughout this file; the other
# five are held here: each has to reach the Info dictionary as a PDF string,
# and the ones the packet carries have to reach the packet under the tag
# ISO 32000-1 Table 317 pairs them with.

test xmp-7.1 {Author, Subject, Keywords and Creator reach the Info dictionary} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc info Author "A. Author"
  $doc info Subject "The subject"
  $doc info Keywords "one, two"
  $doc info Creator "The creating application"
  set answered [list [$doc info Author] [$doc info Subject] \
      [$doc info Keywords] [$doc info Creator]]
  set path [::tclpdfTest::scratch xmp-info-keys.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<<[^>]*/Author[^>]*>>} $bytes dictionary
  list $answered [regexp {/Author \(A\. Author\)} $dictionary] \
      [regexp {/Subject \(The subject\)} $dictionary] \
      [regexp {/Keywords \(one, two\)} $dictionary] \
      [regexp {/Creator \(The creating application\)} $dictionary]
} -result {{{A. Author} {The subject} {one, two} {The creating application}} 1 1 1 1}

test xmp-7.2 {Producer is the package by default and can be replaced} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  set default [$doc info Producer]
  $doc info Producer "My generator 2.0"
  set path [::tclpdfTest::scratch xmp-info-producer.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [string match "tclpdf *" $default] \
      [regexp {/Producer \(My generator 2\.0\)} $bytes] [regexp {/Producer \(tclpdf} $bytes]
} -result {1 1 0}

test xmp-7.3 {Author, Subject and Producer reach the packet as dc:creator, dc:description and pdf:Producer} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc info Author "A. Author"
  $doc info Subject "The subject"
  $doc info Producer "My generator 2.0"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-info-packet.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {<dc:creator>\s*<rdf:Seq>\s*<rdf:li>A\. Author</rdf:li>} $packet] \
      [regexp {<dc:description>\s*<rdf:Alt>\s*<rdf:li xml:lang="x-default">The subject</rdf:li>} $packet] \
      [regexp {<pdf:Producer>My generator 2\.0</pdf:Producer>} $packet]
} -result {1 1 1}

test xmp-7.4 {an empty value removes a key from the dictionary} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc info Keywords "one, two"
  $doc info Keywords {}
  set path [::tclpdfTest::scratch xmp-info-removed.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/Keywords} $bytes
} -result 0

test xmp-7.5 {Creator is xmp:CreatorTool and Keywords is pdf:Keywords, as Table 317 pairs them} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc info Creator "My application 3.1"
  $doc info Keywords "alpha, beta"
  $doc info Producer "My generator 2.0"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-info-pairing.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {<xmp:CreatorTool>My application 3\.1</xmp:CreatorTool>} $packet] \
      [regexp {<pdf:Keywords>alpha, beta</pdf:Keywords>} $packet] \
      [regexp {<pdf:Producer>My generator 2\.0</pdf:Producer>} $packet] \
      [regexp {<xmp:CreatorTool>My generator} $packet]
} -result {1 1 1 0}

test xmp-7.6 {without a Creator the creating tool is the producer, and no empty Keywords is written} -constraints {haveFace haveTdom} -body {
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-info-default.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {<xmp:CreatorTool>tclpdf [0-9.]+</xmp:CreatorTool>} $packet] \
      [regexp {pdf:Keywords} $packet]
} -result {1 0}

# --- what the packet's bytes and the caller's text are ----------------------

test xmp-8.1 {the xpacket begin attribute is the three-byte UTF-8 BOM} -constraints {haveFace haveTdom} -body {
  # XMP part 1, 7.3.2: begin carries U+FEFF, which is EF BB BF once the
  # packet is UTF-8. It used to be the three Latin-1 CHARACTERS EF BB BF,
  # and the encoding then made six bytes of them - C3 AF C2 BB C2 BF -
  # under both interpreters, and no validator said a word.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-bom.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<\?xpacket begin="([^"]*)"} $bytes -> begin
  binary scan $begin H* hex
  set hex
} -result efbbbf

test xmp-8.2 {metadata answers text and encodes once: setting back what it answered is a no-op} -constraints {haveFace haveTdom} -body {
  # The manual says a caller's packet is kept as given. [metadata] used to
  # answer UTF-8 BYTES and to encode what it was given, so "$doc metadata
  # [$doc metadata]" encoded twice and "Müller" went out as "MÃ¼ller".
  set doc [probe $face]
  $doc info Title "M\u00fcller"
  $doc pdfa -part 3 -conformance B
  set first [::tclpdfTest::scratch xmp-round-a.pdf]
  set second [::tclpdfTest::scratch xmp-round-b.pdf]
  $doc write $first
  set answered [$doc metadata]
  $doc metadata $answered
  $doc write $second
  $doc destroy
  set a [::tclpdfTest::readBytes $first]
  set b [::tclpdfTest::readBytes $second]
  file delete $first $second
  regexp {<\?xpacket begin=.*?<\?xpacket end="w"\?>} $a packetA
  regexp {<\?xpacket begin=.*?<\?xpacket end="w"\?>} $b packetB
  # Answered as text: the umlaut is there as the character, not as C3 BC.
  list [expr {[string first "M\u00fcller" $answered] >= 0}] \
      [string first "\xc3\xbc" $answered] \
      [string equal $packetA $packetB] [string match "*M\xc3\xbcller*" $packetB] \
      [string match "*M\xc3\x83\xc2\xbcller*" $packetB]
} -result {1 -1 1 1 0}

test xmp-8.3 {without a Producer no pdf:Producer and no CreatorTool are written, empty or otherwise} -constraints {haveFace haveTdom} -body {
  # "info Producer {}" removes the key; the packet used to write
  # <pdf:Producer/> for it - an empty element naming an empty tool.
  set doc [probe $face]
  $doc info Producer {}
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-no-producer.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {pdf:Producer} $packet] [regexp {xmp:CreatorTool} $packet] \
      [regexp {/Producer} $bytes] [regexp {<xmp:CreateDate>} $packet]
} -result {0 0 0 1}

test xmp-8.4 {a CreationDate or ModDate set through info is mirrored into the packet, as Table 317 pairs them} -constraints {haveFace haveTdom} -body {
  # The packet used to say [Created] for both dates whatever the dictionary
  # said - two claims, one file, and ISO 19005-1 6.7.3 forbids exactly that.
  set doc [probe $face]
  $doc info CreationDate "D:20190101120000+01'00'"
  $doc info ModDate "D:20200202130000Z"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-dates.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list [regexp {<xmp:CreateDate>2019-01-01T12:00:00\+01:00</xmp:CreateDate>} $packet] \
      [regexp {<xmp:ModifyDate>2020-02-02T13:00:00Z</xmp:ModifyDate>} $packet] \
      [regexp {/CreationDate \(D:20190101120000\+01'00'\)} $bytes] \
      [regexp {/ModDate \(D:20200202130000Z\)} $bytes]
} -result {1 1 1 1}

test xmp-8.5 {only a PDF date is taken for CreationDate and ModDate, and a partial one stays partial} -body {
  set doc [tclpdf new -unit mm]
  set out {}
  foreach value {yesterday D:20261318 20260818 D:2026081812000 D:20260818120000+02'00'x} {
    lappend out [catch {$doc info CreationDate $value} err] \
        [string match {*info CreationDate takes a PDF date*7.9.4*} $err]
  }
  lappend out [catch {$doc info ModDate "yesterday"} err] [string match {*info ModDate takes*} $err]
  # The zone offset is spelled with the closing apostrophe in ISO 32000-1
  # and without it in ISO 32000-2, so which of the two is a date depends on
  # the DOCUMENT: this one is 1.7. The 2.0 spelling used to be taken here
  # and to reach a %PDF-1.7 file verbatim (measured 2026-08-26); it now
  # belongs to xmp-8.5b, which asks the same question of a 2.0 document.
  set accepted [lmap value {D:2026 D:202608 D:20260818 D:2026081812 D:20260818120000
      D:20260818120000Z D:20260818120000+02'00' D:20260818120000-05'30'} {
    $doc info CreationDate $value
  }]
  lappend out [catch {$doc info CreationDate D:20260818120000+02'00} err] \
      [string match {*ISO 32000-2 spelling*1.7 file*} $err]
  $doc destroy
  # "D:2019030405" gives an hour and no zone, and comes back as the DATE:
  # XMP part 1, 8.2.1.4 has no form for a time nobody can place. See
  # xmp-14.1, which is about that alone.
  list [lsort -unique $out] [llength $accepted] \
      [::tclpdf::xmp stampFromPdf D:2019] [::tclpdf::xmp stampFromPdf D:201903] \
      [::tclpdf::xmp stampFromPdf D:2019030405] [::tclpdf::xmp stampFromPdf D:20190304050607-05'30'] \
      [::tclpdf::xmp stampFromPdf D:20190304050607+02] [::tclpdf::xmp stampFromPdf junk]
} -result {1 8 2019 2019-03 2019-03-04 2019-03-04T05:06:07-05:30 2019-03-04T05:06:07+02:00 {}}

test xmp-8.5b {the zone offset is spelled the way the document's version spells it} -body {
  # ISO 32000-1, 7.9.4 writes D:YYYYMMDDHHmmSSOHH'mm' and ISO 32000-2 struck
  # the closing apostrophe. The package has always known that where it
  # writes its OWN dates - [pdfObj date] takes the version - and took either
  # spelling from the caller: a 2.0-spelled date reached a %PDF-1.7 PDF/A-3B
  # file and veraPDF called it conformant (measured 2026-08-26).
  set out {}
  foreach {version right wrong} {1.7 D:20260818120000+02'00' D:20260818120000+02'00
      2.0 D:20260818120000+02'00 D:20260818120000+02'00'} {
    set doc [tclpdf new -unit mm -version $version]
    lappend out [$doc info CreationDate $right] \
        [catch {$doc info ModDate $wrong} err] [lrange $::errorCode 0 2]
    $doc destroy
  }
  # And the other order: the date is right when it is set and the version
  # moves under it afterwards. That is nobody's mistake - [ua -part 2]
  # raises a 1.7 document to 2.0 - so it is not refused; the value reaches
  # the FILE in the spelling the file uses, and [info] still answers what
  # the caller wrote. Refusing here was tried on 2026-08-26 and turned
  # ua-5.4 and ua-5.5 red.
  set doc [tclpdf new -unit mm]
  $doc info CreationDate D:20260818120000+02'00'
  $doc configure -version 2.0
  $doc page add
  set path [::tclpdfTest::scratch xmp-respell.pdf]
  $doc write $path
  set bytes [::tclpdfTest::readBytes $path]
  lappend out [$doc info CreationDate] \
      [regexp {/CreationDate \(D:20260818120000\+02'00\)} $bytes]
  $doc destroy
  file delete $path
  set out
} -result {D:20260818120000+02'00' 1 {TCLPDF DOCUMENT DATE} D:20260818120000+02'00 1 {TCLPDF DOCUMENT DATE} D:20260818120000+02'00' 1}

test xmp-8.6 {Trapped is a name in the dictionary, takes only its three values, and stays out of the packet} -constraints {haveFace haveTdom} -body {
  # Table 317: Trapped is a NAME - True, False, Unknown. It used to be
  # written as the string (True). The packet does not carry pdf:Trapped:
  # measured with veraPDF 1.30, a 3u document that was clean without it
  # fails 6.6.2.3.1 twice with it, because the predefined PDF schema of ISO
  # 19005 knows Keywords, PDFVersion and Producer only.
  set doc [probe $face]
  set refused [list [catch {$doc info Trapped maybe} err] \
      [string match {*info Trapped takes True, False or Unknown*} $err] \
      [catch {$doc info Trapped true}]]
  $doc info Trapped True
  $doc pdfa -part 3 -conformance U
  set path [::tclpdfTest::scratch xmp-trapped.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<x:xmpmeta.*?</x:xmpmeta>} $bytes packet
  list $refused [regexp {/Trapped /True} $bytes] [regexp {/Trapped \(} $bytes] \
      [regexp {Trapped} $packet]
} -result {{1 1 1} 1 0 0}

# --- a raw contribution alone -----------------------------------------------

test xmp-9.1 {a raw contribution alone builds the packet} -constraints haveTdom -body {
  # It did not, once: the build hook was subscribed by [xmpSchema] only, and
  # a document whose only contribution was a raw one wrote no /Metadata at
  # all - silently, with [metadata] answering an empty string.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "x" -at {20 20}
  $doc xmpRaw {<rdf:Description rdf:about="" xmlns:my="urn:x-my:1#"><my:tag>hello</my:tag></rdf:Description>}
  set path [::tclpdfTest::scratch xmp-raw-alone.pdf]
  $doc write $path
  set built [$doc metadata]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Well formed by measurement, not by trust: parse what was built. A parse
  # failure errors the test.
  regexp {<x:xmpmeta.*</x:xmpmeta>} $built packet
  set document [dom parse $packet]
  $document delete
  list [regexp {/Type /Metadata} $bytes] [regexp {<my:tag>hello</my:tag>} $bytes] \
      [expr {[string length $built] > 0}]
} -result {1 1 1}

test xmp-9.2 {raw and schema subscribe the build once, in either order} -constraints haveTdom -body {
  # Both ways into the packet share one catalog hook: whichever is called
  # first subscribes it and the second must not add another - subscribed
  # twice, the packet would be rebuilt twice on every write.
  set fragment {<rdf:Description rdf:about="" xmlns:my="urn:x-my:1#"><my:tag>hello</my:tag></rdf:Description>}
  set result {}
  foreach order {rawFirst schemaFirst} {
    set doc [tclpdf new -unit mm -compress 0]
    $doc page add
    oo::objdefine $doc method ProbeXmp {} {return {{text part 3}}}
    if {$order eq "rawFirst"} {
      $doc xmpRaw $fragment
      $doc xmpSchema probe http://example.org/probe/ {part} ProbeXmp
    } else {
      $doc xmpSchema probe http://example.org/probe/ {part} ProbeXmp
      $doc xmpRaw $fragment
    }
    lappend result [llength [$doc subscribers catalog]]
    $doc destroy
  }
  set result
} -result {1 1}

test xmp-9.3 {a claim, a schema and a raw contribution keep their packet order} -constraints {haveFace haveTdom} -body {
  # The order of the packet before the raw way triggered the build too, held
  # so it stays: the claim's description first (registration order), the
  # probe schema second, the dc/xmp/pdf trio after them, the raw contribution
  # last - and one packet, not two.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  oo::objdefine $doc method ProbeXmp {} {return {{text part 3}}}
  $doc xmpSchema probe http://example.org/probe/ {part} ProbeXmp
  $doc xmpRaw {<rdf:Description rdf:about="" xmlns:my="urn:x-my:1#"><my:tag>hello</my:tag></rdf:Description>}
  set path [::tclpdfTest::scratch xmp-order.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set claim [string first "pdfaid:part" $bytes]
  set schema [string first "probe:part" $bytes]
  set shared [string first "xmp:CreateDate" $bytes]
  set raw [string first "my:tag" $bytes]
  list [regexp -all {<\?xpacket begin} $bytes] \
      [expr {$claim > 0 && $claim < $schema && $schema < $shared && $shared < $raw}]
} -result {1 1}

# --- an undeclared tag ------------------------------------------------------

test xmp-10.1 {a tag not declared in xmpSchema fails the write naming schema and tags} -constraints haveTdom -body {
  # It used to fail as tdom's raw {invalid command name "Tag_myorg:undeclared"},
  # with no word about which schema went wrong or what it had declared.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  oo::objdefine $doc method ProbeXmp {} {return {{text undeclared 1}}}
  $doc xmpSchema myorg http://example.org/my/ {alpha beta} ProbeXmp
  set code [catch {$doc write [::tclpdfTest::scratch xmp-undeclared.pdf]} err]
  $doc destroy
  list $code [string equal {tclpdf: unknown tag "undeclared" for XMP schema "myorg" - declared are: alpha, beta} $err]
} -result {1 1}

test xmp-10.2 {an undeclared tag inside a bag fails the same way} -constraints haveTdom -body {
  # A bag's resources carry tags of the same schema, and they are held to
  # the same declaration.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  oo::objdefine $doc method ProbeXmp {} {return {{bag alpha {{beta b gamma c}}}}}
  $doc xmpSchema myorg http://example.org/my/ {alpha beta} ProbeXmp
  set code [catch {$doc write [::tclpdfTest::scratch xmp-undeclared-bag.pdf]} err]
  $doc destroy
  list $code [string match {tclpdf: unknown tag "gamma" for XMP schema "myorg" - declared are: *} $err]
} -result {1 1}


test xmp-11.1 {xmpSchema and xmpRaw load their module on a fresh document} -constraints haveTdom -body {
  # The lazy-load table is consulted only while the method is undefined, and
  # this file requires tclpdf::xmp at the top - so the measurement needs an
  # interpreter that has not loaded it. Both methods used to be missing from
  # the table and answered "unknown method" on a fresh document.
  set child [interp create]
  $child eval [list set auto_path $auto_path]
  set out [$child eval {
    package require tclpdf
    set doc [tclpdf new]
    list [catch {$doc xmpSchema pdfaid http://www.aiim.org/pdfa/ns/id/ {part} XmpMissing}] \
        [catch {$doc xmpRaw {<rdf:Description/>}}]
  }]
  interp delete $child
  set out
} -result {0 0}

test xmp-11.2 {a tag that is no XML name is refused at the call, naming tag and schema} -constraints haveTdom -body {
  # tdom's raw refusal named an internal command ("Invalid tag name
  # 'Tag_myns:a b'"), not the schema the caller wrote.
  set doc [tclpdf new]
  set out {}
  foreach tag [list "a b" 1tag] {
    set code [catch {$doc xmpSchema myns http://example.org/ns/ [list $tag] XmpMissing} message]
    lappend out $code [string equal "tclpdf: xmpSchema tag \"$tag\" is not a valid XML name (schema myns)" $message]
  }
  $doc destroy
  set out
} -result {1 1 1 1}



# --- the characters XML allows --------------------------------------------
#
# tdom's own text check is OFF around the text node command and has to be:
# under Tcl 8.6 an astral character is a surrogate PAIR, which the check
# refuses, and a legal emoji in a title would make the document unwritable.
# What went off with it was the check on C0 control characters - and no
# validator here objects to one: measured 2026-08-25, a packet carrying the
# bytes 07, 0B and 00 got isCompliant="true" out of veraPDF -f 3b while
# xmllint said "PCDATA invalid Char value 7". So the raw BYTES are what these
# tests look at, and the characters are made with [format %c] rather than
# written out - a pattern over a decoded string is what missed this twice
# before.

# The XMP packet of a written file, as BYTES: from the opening processing
# instruction to the closing one. Needs a document written with -compress 0.
proc packetBytes {path} {
  set bytes [::tclpdfTest::readBytes $path]
  set start [string first "<?xpacket begin=" $bytes]
  set end [string first "<?xpacket end=" $bytes]
  if {$start < 0 || $end < 0} {
    return {}
  }
  return [string range $bytes $start [expr {$end + 18}]]
}

# Every byte in the packet that XML 1.0, 2.2 does not allow there: anything
# below 0x20 but tab, newline and carriage return.
proc strayBytes {bytes} {
  set found {}
  binary scan $bytes cu* values
  foreach value $values {
    if {$value < 0x20 && $value ni {9 10 13}} {
      lappend found [format %02X $value]
    }
  }
  return [lsort -unique $found]
}

test xmp-12.1 {a control character out of the Info dictionary is refused, and no file appears} -constraints {haveTdom haveFace} -body {
  # U+0000 is the one that cannot even be escaped - XML has no way to write
  # it at all - but none of the four may go out, and the message has to name
  # which property carries it, because the caller's data is where it has to
  # be fixed.
  set out {}
  foreach code {0 7 11 31} {
    set doc [probe $face]
    $doc info Title "a[format %c $code]b"
    $doc pdfa -part 3 -conformance B
    set path [::tclpdfTest::scratch xmp-control.pdf]
    lappend out [catch {$doc write $path} message] \
        [string match "tclpdf: dc:title*U+[format %04X $code]*XML 1.0, 2.2*" \
            $message] \
        [file exists $path]
    $doc destroy
    file delete $path
  }
  set out
} -result {1 1 0 1 1 0 1 1 0 1 1 0}

test xmp-12.2 {what the packet does carry are bytes XML allows, the astral character among them} -constraints {haveTdom haveFace} -body {
  # The counter-direction, and the half the fix must not break: tab, newline,
  # an ampersand and a character outside the BMP are all legal and all have
  # to reach the file. As BYTES - under Tcl 8.6 the emoji is a surrogate pair
  # in memory, and the question is whether it leaves as the four UTF-8 bytes
  # F0 9F 98 80 or as the six of the two halves taken separately.
  #
  # The two interpreters spell it differently and both are right: 8.6 hands
  # tdom a pair, which is serialised as the character and encoded to those
  # four bytes; Tcl 9 holds the character whole and tdom writes the
  # character reference "&#128512;". What must NOT appear either way is ED
  # A0 BD, the first half of the pair encoded on its own - that is CESU-8,
  # not UTF-8, and no reader takes it back.
  set doc [probe $face]
  $doc info Title "Preis[format %c 9]& Menge[format %c 10][encoding \
      convertfrom utf-8 [binary decode hex f09f9880]]"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-legal.pdf]
  $doc write $path
  $doc destroy
  set bytes [packetBytes $path]
  set result [list [strayBytes $bytes] \
      [expr {[string first [binary decode hex f09f9880] $bytes] >= 0
          || [string first "&#128512;" $bytes] >= 0}] \
      [expr {[string first [binary decode hex eda0bd] $bytes] >= 0}] \
      [::tclpdfTest::verapdf $path 3b]]
  file delete $path
  set result
} -result {{} 1 0 ok}

test xmp-12.3 {an unpaired surrogate is refused rather than encoded as bytes that are not UTF-8} -constraints {haveTdom haveFace} -body {
  # The two interpreters break differently and both badly. Tcl 8.6 encodes a
  # lone U+D83D to the three bytes ED A0 BD, which is not UTF-8 and which no
  # reader can take back; Tcl 9 throws out of [encoding convertto utf-8], so
  # the caller sees a raw Tcl error from inside the writer. Refused at the
  # packet instead, with the same words under both.
  set doc [probe $face]
  $doc info Title "lone [format %c 0xD83D] end"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-surrogate.pdf]
  set code [catch {$doc write $path} message]
  $doc destroy
  set out [list $code \
      [string match {tclpdf: dc:title*unpaired surrogate U+D83D*} $message] \
      [file exists $path]]
  file delete $path
  set out
} -result {1 1 0}

test xmp-12.4 {a schema's own value is held to the same characters, naming its tag} -constraints haveTdom -body {
  # Not only the Info dictionary: an [xmpSchema] callback answers with text
  # that goes into the packet the same way, and a topic reading a control
  # character out of somewhere else would put it there just as quietly.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  oo::objdefine $doc method ProbeControl {} {
    return [list [list text alpha "x[format %c 7]y"]]
  }
  $doc xmpSchema myctl http://example.org/ctl/ {alpha} ProbeControl
  set code [catch {$doc write [::tclpdfTest::scratch xmp-schema-ctl.pdf]} message]
  $doc destroy
  list $code [string match {tclpdf: myctl:alpha carries U+0007*} $message]
} -result {1 1}

# --- a prefix belongs to the document, not to the process -----------------

test xmp-13.1 {two documents in one interpreter may label two URIs with one prefix} -constraints haveTdom -body {
  # TWO documents in ONE interpreter, and that is the whole test. The element
  # command is created with -namespace and was keyed by the tag name alone,
  # so the second document skipped the declaration and kept the FIRST
  # document's command: measured 2026-08-25, the second file carried
  # <twice:beta xmlns:twice=".../ns-one/"> under an rdf:Description declaring
  # ".../ns-TWO/" - the property stood in the namespace of a document that
  # had already been closed. A single document is always right, which is why
  # neither the suite nor a validator ever saw this; a server or a batch run
  # is not a single document.
  set out {}
  foreach uri {http://example.org/ns-one/ http://example.org/ns-TWO/} {
    set doc [tclpdf new -unit mm -compress 0]
    $doc page add
    oo::objdefine $doc method ProbeNs {} {return {{text beta gamma}}}
    $doc xmpSchema twice $uri {beta} ProbeNs
    set path [::tclpdfTest::scratch xmp-twice.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path
    # What the description declares, and whether the property carries a
    # declaration of its OWN - which is what tdom writes when the element
    # belongs to a namespace the surrounding scope does not have.
    regexp {<rdf:Description xmlns:twice="([^"]*)"[^>]*>\s*<twice:beta([^>]*)>} \
        $bytes -> declared attributes
    lappend out $declared [string trim $attributes]
  }
  set out
} -result {http://example.org/ns-one/ {} http://example.org/ns-TWO/ {}}

# --- a time nobody can place ----------------------------------------------

test xmp-14.1 {a PDF date without a zone loses its time rather than inventing one} -constraints haveTdom -body {
  # XMP part 1, 8.2.1.4: the zone designator is optional only while there is
  # no time at all. ISO 32000-1, 7.9.4 makes the relationship of a zoneless
  # PDF time to UT unknown, so there is no offset to write - Z would claim
  # UTC and the local offset would claim the machine that ran the job. The
  # packet says the date and stops. veraPDF passes both spellings (measured
  # 2026-08-25), so only a test holds this.
  list [::tclpdf::xmp::stampFromPdf "D:20190301120000"] \
      [::tclpdf::xmp::stampFromPdf "D:20190301120000Z"] \
      [::tclpdf::xmp::stampFromPdf "D:20190301120000+02'00'"] \
      [::tclpdf::xmp::stampFromPdf "D:2019030112"] \
      [::tclpdf::xmp::stampFromPdf "D:20190301"]
} -result {2019-03-01 2019-03-01T12:00:00Z 2019-03-01T12:00:00+02:00 2019-03-01\
    2019-03-01}

test xmp-14.2 {and the packet in the file says the same} -constraints {haveTdom haveFace} -body {
  # "D:20190301120000" is the spelling many other generators use, so this is
  # not a corner: it reached the packet as "2019-03-01T12:00:00", which is
  # not an XMP date.
  set doc [probe $face]
  $doc info CreationDate "D:20190301120000"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-nozone.pdf]
  $doc write $path
  $doc destroy
  set bytes [packetBytes $path]
  set result [list [regexp {<xmp:CreateDate>([^<]*)<} $bytes -> stamp] $stamp \
      [::tclpdfTest::verapdf $path 3b]]
  file delete $path
  set result
} -result {1 2019-03-01 ok}

test xmp-14.3 {ModDate is treated exactly as CreationDate is} -constraints {haveTdom haveFace} -body {
  # The rule was built for one field and asserted for one field. It is one
  # conversion for both - Table 317 pairs CreationDate with xmp:CreateDate
  # and ModDate with xmp:ModifyDate, and [packet] puts both through
  # [stampFromPdf] in the same loop - so the same document is asked about
  # both at once: a zoneless time loses its time and keeps its date on either
  # side, and a partial date stays as partial as it was given.
  set doc [probe $face]
  $doc info CreationDate "D:20190301120000"
  $doc info ModDate "D:20200401133000"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-nozone-both.pdf]
  $doc write $path
  $doc destroy
  set bytes [packetBytes $path]
  regexp {<xmp:CreateDate>([^<]*)<} $bytes -> created
  regexp {<xmp:ModifyDate>([^<]*)<} $bytes -> modified
  set result [list $created $modified [::tclpdfTest::verapdf $path 3b]]
  file delete $path
  set result
} -result {2019-03-01 2020-04-01 ok}

test xmp-14.4 {and the partial dates, on both sides} -constraints haveTdom -body {
  # Read through the same procedure both fields go through, so that a change
  # that split them would have to be made twice to pass.
  set out {}
  foreach date {D:2019 D:201903 D:20190304 D:2019030405 D:20190304050607Z} {
    lappend out [::tclpdf::xmp::stampFromPdf $date]
  }
  set out
} -result {2019 2019-03 2019-03-04 2019-03-04 2019-03-04T05:06:07Z}

test xmp-14.5 {the packet carries no third date} -constraints {haveTdom haveFace} -body {
  # What the rule has to hold for: xmp:CreateDate and xmp:ModifyDate are the
  # only date-bearing properties this package writes, so there is no field it
  # could have missed. pdf:Trapped is deliberately absent (see the module),
  # and xmp:MetadataDate is not written at all - measured 2026-08-25 by
  # counting what a full PDF/A-3 packet holds.
  set doc [probe $face]
  $doc info CreationDate "D:20190301120000+02'00'"
  $doc info ModDate "D:20200401133000+02'00'"
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch xmp-dates.pdf]
  $doc write $path
  $doc destroy
  set bytes [packetBytes $path]
  file delete $path
  # Every element whose name ends in "Date", named rather than counted, so a
  # new one added later shows up here as a difference and not as a number.
  lsort -unique [regexp -all -inline {<([A-Za-z]+:[A-Za-z]*Date)>} $bytes]
} -result {<xmp:CreateDate> <xmp:ModifyDate> xmp:CreateDate xmp:ModifyDate}

# --- a contribution the caller cannot take back ---------------------------

test xmp-15.1 {a contribution that is not well formed fails at the call, and the document stays writable} -constraints {haveTdom haveFace} -body {
  # The head of this module has promised since it was written that a raw
  # contribution is parsed on the way IN and a malformed one fails at the
  # call. It was not: the parse happened while the packet was built, so a
  # broken one was accepted without a word, made every write from then on
  # fail - and could not be taken back out, because nothing removes one.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  set result [list [catch {$doc pdfa extension {<rdf:Description>}} message] \
      [string match {tclpdf: XMP contribution is not well formed XML*} $message] \
      [llength [dict get [$doc pdfa state] extensions]]]
  # A refused call leaves the document as it was - so this still writes.
  lappend result {*}[::tclpdfTest::writes $doc xmp-extension.pdf]
  $doc destroy
  set result
} -result {1 1 0 0 1}

test xmp-15.2 {a well formed contribution is still taken, and reaches the packet} -constraints {haveTdom haveFace} -body {
  # The counter-direction: the check refuses what is broken and nothing else.
  # Not held against veraPDF - a property in a namespace of its own is what
  # a PDF/A extension SCHEMA has to describe, and describing one is not what
  # this test is about; zugferd.test writes the real thing.
  set doc [probe $face]
  $doc pdfa -part 3 -conformance B
  $doc pdfa extension {<rdf:Description xmlns:probe="http://example.org/probe/"
      rdf:about=""><probe:note>kept</probe:note></rdf:Description>}
  set path [::tclpdfTest::scratch xmp-extension-ok.pdf]
  $doc write $path
  set bytes [packetBytes $path]
  set result [list [llength [regexp -all -inline {<probe:note>kept<} $bytes]] \
      [llength [dict get [$doc pdfa state] extensions]]]
  $doc destroy
  file delete $path
  set result
} -result {1 1}

# --- the prefix and the URI of a schema -----------------------------------

test xmp-15.1 {xmpSchema holds the prefix, not only the tags} -constraints haveTdom -body {
  # Namespaces in XML 1.0: a prefix is an NCName (3), "xml" is bound to the
  # XML namespace and to nothing else (2.1), and "xmlns" may not be declared
  # at all (3). None of that was asked. Measured 2026-08-26: "my" with an
  # empty URI wrote xmlns:my="" (6.2 makes it an error), "xml" and "xmlns"
  # went into the packet as declarations no parser takes, and "1my" and
  # "a:b" reached [dom createNodeCmd] as attribute names it refuses - so the
  # WRITE died with a raw tdom sentence and -errorcode NONE, and the "a b"
  # case was refused blaming the TAG, which was in order.
  set result {}
  foreach {prefix uri} {xml http://x/ xmlns http://x/ 1my http://x/ a:b http://x/
      {a b} http://x/ {} http://x/ my {}} {
    set doc [tclpdf new -unit mm]
    lappend result [catch {$doc xmpSchema $prefix $uri {good} XmpProbeBody} err] \
        [lrange $::errorCode 0 2]
    # And nothing is left behind: the document still writes.
    $doc page add
    set path [::tclpdfTest::scratch xmp-prefix.pdf]
    lappend result [catch {$doc write $path}]
    $doc destroy
    file delete $path
  }
  set result
} -result {1 {TCLPDF XMP PREFIX} 0 1 {TCLPDF XMP PREFIX} 0 1 {TCLPDF XMP PREFIX} 0\
    1 {TCLPDF XMP PREFIX} 0 1 {TCLPDF XMP PREFIX} 0 1 {TCLPDF XMP PREFIX} 0\
    1 {TCLPDF XMP URI} 0}

test xmp-15.2 {a prefix that IS an NCName still gets through, and the tag keeps its own message} -constraints haveTdom -body {
  set doc [tclpdf new -unit mm]
  set good [catch {$doc xmpSchema probe urn:probe {good} XmpProbeBody}]
  set bad [catch {$doc xmpSchema probe urn:probe {1bad} XmpProbeBody} err]
  set code [lrange $::errorCode 0 2]
  $doc destroy
  list $good $bad $code [string match {*tag "1bad"*} $err]
} -result {0 1 {TCLPDF XMP TAG} 1}

test xmp-15.3 {a raw contribution is rdf:Description elements, not text and not anything else} -constraints haveTdom -body {
  # The wrapper's children are appended to the packet's own rdf:RDF, where
  # RDF/XML admits nothing else (XMP part 1, 7.9.2.2). Measured 2026-08-26:
  # "xmpRaw {just text}" and "xmpRaw {<foo>bar</foo>}" were taken, and under
  # a PDF/A claim veraPDF then answered 6.6.2.1-4/-5 and 6.6.4-1 - without a
  # claim no tool looked at all.
  set result {}
  foreach xml {{just text} {<foo>bar</foo>}} {
    set doc [tclpdf new -unit mm]
    lappend result [catch {$doc xmpRaw $xml}] [lrange $::errorCode 0 2]
    $doc destroy
  }
  # A comment and whitespace around a real description are what a
  # hand-written schema carries, and both pass.
  set doc [tclpdf new -unit mm]
  lappend result [catch {$doc xmpRaw {<!-- c -->
      <rdf:Description rdf:about="" xmlns:probe="urn:probe"><probe:a>1</probe:a></rdf:Description>
  }} err] $err
  $doc destroy
  set result
} -result {1 {TCLPDF XMP RDF} 1 {TCLPDF XMP RDF} 0 {}}

cleanupTests

# forms.test --
#
# The contextual forms of a cursive script, and the ORACLE that says whether
# they are the right ones.
#
# THE POINT OF THIS FILE is the comparison with HarfBuzz. A shaper can be
# wrong in a way no assertion written here would catch, because the person
# writing the assertion and the person writing the shaper are the same one -
# so the expected glyph sequence is not written down at all. It is asked of
# hb-shape, glyph number by glyph number, and the tests that do so are skipped
# rather than guessed at where hb-shape is not installed.
#
# hb-shape prints the run in VISUAL order and tclpdf builds it in LOGICAL
# order, so one of the two has to be turned round. That is the whole
# difference between the two outputs and it is done here rather than argued
# about.
#
# THE DIFFERENCES ARE TESTS TOO, at the end. They used to hold what this
# package left out of rlig, so that the day somebody read the chaining lookups
# they would go red and say where. That day came on 2026-08-26 and they hold
# the opposite since: the chaining lookups ARE read, the lam-alef pair and the
# wide medial variants come out as the face draws them, and the last one of
# them - a face whose Arabic ligatures hang off the "arab" script - fell the
# same day, when forms.tcl took liga and clig into a closing stage of their
# own under the script of the text. So
# 3.3 now holds an EQUALITY and the switch that still turns it off; there is
# no difference left in this file to keep.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::sfnt
package require tclpdf::io
package require tclpdf::forms
package require tclpdf::gdef
source [file join [file dirname [info script]] helper.tcl]

set assets [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts]
# The two faces are two DESIGNS, not two files of the same kind, and both are
# needed. DejaVu Sans carries whole Arabic letters and reaches their forms
# with Single substitutions; Noto Naskh Arabic writes a letter as a skeleton
# plus separate dots and reaches the forms with Multiple substitutions. The
# second used to be the case this package refused, because the dots it
# detaches are placed by GPOS mark attachment; both are set now, and neither
# design's behaviour is visible in the other face.
set wholeFace [file join $assets DejaVuSans.ttf]
set splitFace [file join $assets google NotoNaskhArabic-Variable.ttf]
set plainFace [file join $assets google Roboto-Regular.ttf]

testConstraint haveWhole [file exists $wholeFace]
testConstraint haveSplit [file exists $splitFace]
testConstraint havePlain [file exists $plainFace]
testConstraint haveHbShape [expr {[auto_execok hb-shape] ne {}}]
testConstraint havePdfToText [expr {[auto_execok pdftotext] ne {}}]

proc formsParsed {path} {
  return [::tclpdf::sfnt read $path]
}

# A run as font.tcl builds it, before anything has been substituted. Shared
# with liga.test, which needs the same starting point for the opposite
# substitution.
interp alias {} formsRun {} ::tclpdfTest::glyphRun

# The glyph numbers tclpdf produces for a word, in logical order.
#
# LIGATURES is the -ligatures of the caller and defaults to on, exactly as the
# option does: the typographic ligatures of the face take part unless somebody
# said not to. The required ones run either way.
proc formsGlyphs {path text {ligatures 1}} {
  set parsed [formsParsed $path]
  set glyphs {}
  foreach entry [::tclpdf::forms apply [::tclpdf::forms build $parsed] \
      [formsRun $parsed $text] $ligatures] {
    lappend glyphs [lindex $entry 0]
  }
  return $glyphs
}

# The glyph numbers HarfBuzz produces for the same word, turned from visual
# into logical order. FEATURES is passed on as it stands - "" for the full
# shaping the face asks for, "-rlig,-liga,-locl" to leave out what this
# package does not read.
proc formsHarfBuzz {path text {features {}}} {
  set command [list hb-shape --no-clusters --no-positions --no-glyph-names]
  if {$features ne {}} {
    lappend command --features=$features
  }
  set output [exec {*}$command $path $text]
  set glyphs {}
  foreach glyph [split [string trim $output {[]}] |] {
    set glyphs [linsert $glyphs 0 $glyph]
  }
  return $glyphs
}

# The six words of the oracle. Ordinary Arabic, chosen so that between them
# they cover every one of the four forms and both ways a word can start.
set formsWords {مرحبا العربية بالعالم كتاب سلام شمس}

# --- what a face offers -----------------------------------------------------

test forms-1.1 {a face with the positional features is prepared} \
    -constraints haveWhole -body {
  # ccmp is in this list since the chaining lookups are read, and it is worth
  # a line: every one of the eleven ccmp lookups this face names for Arabic is
  # contextual, so before there was nothing in the stage at all and the stage
  # was left out. Its output is unchanged for every word of the oracle below -
  # what it does here is decompose a few letters that the positional features
  # then find in the shape they expect.
  #
  # rlig LEFT THIS LIST on 2026-08-26 and did not leave the shaping: the
  # ligatures are TWO stages of their own now - the required ones, then the
  # typographic ones a caller may switch off - because -ligatures may not
  # switch off a required ligature and because HarfBuzz pauses between the
  # two. So the closing stages are asked for separately below.
  set state [::tclpdf::forms build [formsParsed $::wholeFace]]
  set tags {}
  foreach {tag mark lookups} [dict get $state stages] {
    lappend tags $tag
  }
  list $tags [expr {[llength [dict get $state closingRequired]] > 0}] \
      [expr {[llength [dict get $state closingOptional]] > 0}]
} -result {{ccmp fina medi init} 1 1}

test forms-1.2 {a face without them is not prepared at all} \
    -constraints havePlain -body {
  # Roboto has a GSUB and even a ccmp feature, and none of the three forms.
  # The empty answer is what makes font.tcl refuse rather than decompose
  # letters it then cannot shape.
  ::tclpdf::forms build [formsParsed $::plainFace]
} -result {}

test forms-1.3 {the splitting face is prepared too, ccmp and all} \
    -constraints haveSplit -body {
  # Its dots are placed afterwards, by markPos.tcl - not here. Reading it has
  # to work either way, or what happens to the dots would never be reached.
  set state [::tclpdf::forms build [formsParsed $::splitFace]]
  set tags {}
  foreach {tag mark lookups} [dict get $state stages] {
    lappend tags $tag
  }
  list $tags [expr {[llength [dict get $state closingRequired]] > 0}] \
      [expr {[llength [dict get $state closingOptional]] > 0}]
} -result {{ccmp fina medi init} 1 1}

# --- which of the two closing stages runs first -----------------------------

# A face built here rather than found in the tree, because no face in the tree
# can show this: in every one of them the rlig lookups have LOWER indices than
# the liga ones, so a sort by index and a stage order agree and the difference
# is invisible. The fixture numbers them the other way round on purpose.
#
#   lookup 0, 1, 2   the three positional forms, on a glyph nothing uses -
#                    [forms build] refuses a face without them
#   lookup 3         liga: glyph 10 becomes 30      <- the LOWER index
#   lookup 4         rlig: glyph 10 becomes 40      <- the HIGHER index
#   lookup 5         liga: glyph 11 becomes 31       (nothing in rlig)
#
# Whichever stage runs first wins on glyph 10, because after it the other no
# longer matches. Measured against hb-shape with the same construction patched
# into Noto Naskh Arabic - two new lookups at the end of its lookup list, the
# lower one added to liga and the higher one to rlig: hb-shape --script=arab
# answers the rlig substitute, and answers the liga one only with
# --features=-rlig.
proc formsStageFace {} {
  set gsub [::tclpdfTest::gsubTable [list \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 99 98]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 99 97]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 99 96]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 30]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 40]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 11 31]]]] \
      [dict create init {0} medi {1} fina {2} liga {3 5} rlig {4}] arab]
  return [dict create bytes $gsub \
      tables [dict create GSUB [list 0 [string length $gsub]]]]
}

# One hamza, which joins on neither side, so no positional feature touches it
# and the closing stages are all that can act.
proc formsStageGlyphs {glyph {ligatures 1}} {
  set run [list [list $glyph [list 0x0621]]]
  set out {}
  foreach entry [::tclpdf::forms apply \
      [::tclpdf::forms build [formsStageFace] arab] $run $ligatures] {
    lappend out [lindex $entry 0]
  }
  return $out
}

test forms-1.4 {the required ligatures run before the typographic ones} -body {
  # 40 is the rlig substitute and 30 the liga one. Sorting the two features
  # into ONE stage by lookup index - which is what this package did until
  # 2026-08-26 - answers 30, because lookup 3 stands before lookup 4.
  formsStageGlyphs 10
} -result 40

test forms-1.5 {and -ligatures 0 leaves the required stage alone} -body {
  # The other half of the promise: switching the typographic ligatures off
  # must not touch rlig, so the answer is the same one.
  formsStageGlyphs 10 0
} -result 40

test forms-1.6 {the typographic stage still runs where rlig has no rule} -body {
  # The control: 1.4 must not pass because the liga stage is broken. Glyph 11
  # is in liga alone, so it has to change with -ligatures on and stand with it
  # off - or "rlig first" would be indistinguishable from "liga never".
  list [formsStageGlyphs 11] [formsStageGlyphs 11 0]
} -result {31 11}

# --- the oracle -------------------------------------------------------------

test forms-2.1 {every word comes out as HarfBuzz shapes it} \
    -constraints {haveWhole haveHbShape} -body {
  # The full comparison, with nothing switched off: this face reaches its
  # forms with Single substitutions and its required ligatures with a
  # Ligature lookup, and all three are types this package reads. So the two
  # shapers have to agree glyph for glyph, and any difference is a defect.
  set faults {}
  foreach word $::formsWords {
    set ours [formsGlyphs $::wholeFace $word]
    set theirs [formsHarfBuzz $::wholeFace $word]
    if {$ours ne $theirs} {
      lappend faults "$word: $ours vs $theirs"
    }
  }
  set faults
} -result {}

test forms-2.2 {lam-alef as well, which is a required ligature} \
    -constraints {haveWhole haveHbShape} -body {
  # In this face the rlig lookup is type 4 - several glyphs to one - and that
  # is read, so the lam-alef comes out as the single glyph the face draws for
  # it. Written out rather than only compared, because it is the one word the
  # other face gets wrong.
  set ours [formsGlyphs $::wholeFace "لا"]
  list [llength $ours] [expr {$ours eq [formsHarfBuzz $::wholeFace "لا"]}]
} -result {1 1}

test forms-2.3 {the splitting face agrees with NOTHING switched off} \
    -constraints {haveSplit haveHbShape} -body {
  # This used to compare with rlig, liga and locl switched off, because those
  # were where the face keeps its contextual lookups and gsubApply could not
  # follow them. It reads them now, so the comparison is the full one - every
  # feature HarfBuzz applies by default, and this face carries none that this
  # package leaves out.
  #
  # Measured the same day over 6630 words rather than six: 0 differ.
  set faults {}
  foreach word $::formsWords {
    set ours [formsGlyphs $::splitFace $word]
    set theirs [formsHarfBuzz $::splitFace $word]
    if {$ours ne $theirs} {
      lappend faults "$word: $ours vs $theirs"
    }
  }
  set faults
} -result {}

test forms-2.4 {and the chaining is what makes the difference} \
    -constraints {haveSplit haveHbShape} -body {
  # The control for 2.3: it must not pass by comparing two shapings that agree
  # anyway. Switching the chaining features off in HarfBuzz has to change its
  # answer, or 2.3 would prove nothing.
  set ours [formsGlyphs $::splitFace "العربية"]
  list [expr {$ours eq [formsHarfBuzz $::splitFace \
          "العربية"]}] \
      [expr {$ours eq [formsHarfBuzz $::splitFace \
          "العربية" -rlig,-liga,-locl]}]
} -result {1 0}

test forms-2.5 {rlig is applied where its lookup type allows} \
    -constraints {haveSplit haveHbShape} -body {
  # An isolated kaf: this face rewrites it through a Multiple substitution in
  # rlig, which IS read. So the answer here follows the full shaping and not
  # the reduced one - evidence that rlig is applied rather than skipped
  # wholesale.
  set ours [formsGlyphs $::splitFace "ك"]
  list [expr {$ours eq [formsHarfBuzz $::splitFace "ك"]}] \
      [expr {$ours eq [formsHarfBuzz $::splitFace "ك" -rlig,-liga,-locl]}]
} -result {1 0}

# --- what the chaining lookups reach ----------------------------------------

test forms-3.1 {lam-alef in the splitting face is the pair the face draws} \
    -constraints {haveSplit haveHbShape} -body {
  # THIS TEST HELD A LIMIT and now holds the gain. The face reaches its
  # lam-alef through a chaining lookup (type 6) over a contextual one (type
  # 5), which is read since 2026-08-26: the two letters come out as the two
  # SPECIAL shapes the face draws for the pair, not as an ordinary initial
  # and final. Written out rather than only compared, because the two answers
  # differ by two glyph numbers and nothing else - which is exactly the kind
  # of difference that hides in a comparison.
  set ours [formsGlyphs $::splitFace "لا"]
  list $ours [expr {$ours eq [formsHarfBuzz $::splitFace "لا"]}] \
      [expr {$ours eq [formsHarfBuzz $::splitFace "لا" \
          -rlig,-liga,-locl]}]
} -result {{71 10} 1 0}

test forms-3.2 {and the wide medial variants are selected} \
    -constraints {haveSplit haveHbShape} -body {
  # The same limit lifted in its quieter form: a chaining rlig lookup widens
  # the medial skeleton before certain finals. Exactly one glyph of this word
  # used to differ because of it and none does now.
  set ours [formsGlyphs $::splitFace "العربية"]
  set full [formsHarfBuzz $::splitFace "العربية"]
  set differing 0
  foreach a $ours b $full {
    if {$a ne $b} {
      incr differing
    }
  }
  list [llength $ours] [llength $full] $differing
} -result {10 10 0}

test forms-3.3 {the ligatures of the resolved script, and the switch on them} \
    -constraints {haveWhole haveHbShape} -body {
  # THIS TEST HELD A DIFFERENCE UNTIL 2026-08-26 and now holds the equality.
  # DejaVu Sans draws lam followed by alef-with-madda as ONE glyph and keeps
  # that ligature in the "liga" feature of the "arab" script - lookups 17 and
  # 19, measured. liga.tcl resolves the LATIN language system and reaches
  # lookup 18 alone, so the pair used to come out as two joined letters:
  # legible, and not what the face draws. forms.tcl reads liga and clig under
  # the script it was asked for since, in the two closing stages HarfBuzz
  # applies them in, and the difference is gone - 66 words of the 7961
  # measured over the three faces in this tree, 0 now.
  #
  # AND -ligatures STILL SWITCHES IT, which is the second half of the promise
  # and the reason both answers are written out. Off, the pair is the two
  # joined letters again - what hb-shape gives for "-liga" - and the plain
  # lam-alef of 2.2 is unaffected either way, because that one is a REQUIRED
  # ligature and sits in rlig, which -ligatures may not switch off.
  set with [formsGlyphs $::wholeFace "\u0644\u0622"]
  set without [formsGlyphs $::wholeFace "\u0644\u0622" 0]
  list [llength $with] [expr {$with eq [formsHarfBuzz $::wholeFace "\u0644\u0622"]}] \
      [llength $without] \
      [expr {$without eq [formsHarfBuzz $::wholeFace "\u0644\u0622" -liga]}]
} -result {1 1 2 1}

# --- what the substitutions do to the run -----------------------------------

test forms-4.1 {a Multiple substitution makes the run longer} \
    -constraints haveSplit -body {
  # Five characters, six glyphs: ccmp writes the beh as a skeleton and a dot.
  # The run growing is the case the ligature code never had to handle.
  set glyphs [formsGlyphs $::splitFace "مرحبا"]
  list [string length "مرحبا"] [llength $glyphs]
} -result {5 6}

test forms-4.2 {the characters stay on the first glyph of the sequence} \
    -constraints haveSplit -body {
  # And the others carry none. Both halves matter: the first is what makes
  # the word extract, the second is what keeps it from extracting twice.
  set parsed [formsParsed $::splitFace]
  set run [::tclpdf::forms apply [::tclpdf::forms build $parsed] \
      [formsRun $parsed "مرحبا"]]
  set codes {}
  foreach entry $run {
    lappend codes [lindex $entry 1]
  }
  set flat {}
  foreach list $codes {
    lappend flat {*}$list
  }
  list $codes [llength $flat]
} -result {{1605 1585 1581 1576 {} 1575} 5}

test forms-4.3 {the run comes back with two elements per entry} \
    -constraints haveWhole -body {
  # The form each position stands in travels with the glyphs while the
  # substitutions run and is dropped at the end: everything downstream takes
  # {glyph codes}, and a third element would ride along waiting to be
  # mistaken for something.
  set lengths {}
  set parsed [formsParsed $::wholeFace]
  foreach entry [::tclpdf::forms apply [::tclpdf::forms build $parsed] \
      [formsRun $parsed "مرحبا"]] {
    lappend lengths [llength $entry]
  }
  lsort -unique $lengths
} -result 2

# --- the mark glyphs a splitting face produces ------------------------------

test forms-5.1 {the splitting face still produces mark glyphs, and they are placed} \
    -constraints haveSplit -body {
  # [forms marks] used to live here: it answered whether the shaping had
  # produced glyphs the face means to PLACE rather than to advance - the dots
  # ccmp detaches, GDEF class 3 - and font.tcl refused such a face because it
  # could not place them. markPos.tcl places them, the refusal went, and the
  # command went with it: nothing in the package asked the question any more.
  #
  # What the command used to prove is proved here directly instead, because
  # the FACT was never the dead part: this face does detach its dots, and the
  # anchors do move them. hb-shape NotoNaskhArabic-Variable.ttf -u 0628,064E
  #   -> [uni064E=0@266,-280+0|dotbelowar=0@308,-31+0|uni066E=0+772]
  # so, measured from the base origin and in the logical frame markPos
  # answers in: the dot 308-772 = -464, the fatha 266-772 = -506.
  package require tclpdf::markPos
  set parsed [formsParsed $::splitFace]
  set state [::tclpdf::forms build $parsed]
  set run [::tclpdf::forms apply $state [formsRun $parsed "بَ"]]
  set glyphs [lmap entry $run {lindex $entry 0}]
  set marks [::tclpdf::gdef filter [::tclpdf::gdef build $parsed] 0x0008]
  set classed {}
  foreach glyph $glyphs {
    lappend classed [::tclpdf::gdef ignored $marks $glyph]
  }
  list $classed [::tclpdf::markPos offsets \
      [::tclpdf::markPos build $parsed] $glyphs]
} -result {{0 1 1} {{0 0} {-464 -31} {-506 -280}}}

test forms-5.2 {a face with whole letters produces no mark and needs none} \
    -constraints haveWhole -body {
  # The other design, and the counter-test: DejaVu Sans writes whole Arabic
  # letters, so nothing in the shaped run is a mark and nothing is moved.
  package require tclpdf::markPos
  set parsed [formsParsed $::wholeFace]
  set state [::tclpdf::forms build $parsed]
  set run [::tclpdf::forms apply $state [formsRun $parsed "مرحبا"]]
  set glyphs [lmap entry $run {lindex $entry 0}]
  set marks [::tclpdf::gdef filter [::tclpdf::gdef build $parsed] 0x0008]
  set anyMark 0
  foreach glyph $glyphs {
    if {[::tclpdf::gdef ignored $marks $glyph]} {
      set anyMark 1
    }
  }
  list $anyMark [lsort -unique [::tclpdf::markPos offsets \
      [::tclpdf::markPos build $parsed] $glyphs]]
} -result {0 {{0 0}}}

# --- through the document ---------------------------------------------------

test forms-6.1 {the width measured is the width of the shaped glyphs} \
    -constraints haveWhole -body {
  # Measurement and drawing out of one source: the forms are narrower than
  # the isolated letters, so a width taken before the shaping would lay out a
  # line that is never drawn. Compared against the sum of the advances of the
  # glyphs that actually go into the stream.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed ar $::wholeFace
  set measured [$doc textWidth "مرحبا" -family ar -size 100 -direction rtl]
  $doc destroy
  set parsed [formsParsed $::wholeFace]
  set units [dict get $parsed unitsPerEm]
  set total 0
  foreach glyph [formsGlyphs $::wholeFace "مرحبا"] {
    incr total [::tclpdf::sfnt advance $parsed $glyph]
  }
  set shaped [expr {$total * 100.0 / $units}]
  # And it must not be the width of the unshaped line, or the test would pass
  # on a package that shapes nothing.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed ar $::wholeFace
  set isolated [$doc textWidth "مرحبا" -family ar -size 100 -direction rtl \
      -unshaped 1]
  $doc destroy
  list [expr {abs($measured - $shaped) < 0.001}] \
      [expr {abs($measured - $isolated) > 1.0}]
} -result {1 1}

test forms-6.2 {the text comes back out of the file as it went in} \
    -constraints {haveWhole havePdfToText} -body {
  # THE test for the ToUnicode side, and the only one that can be: the glyphs
  # in the file are numbers, the forms are not the characters, and nothing but
  # a reader can say whether the word is still there. pdftotext wraps a
  # right-to-left line in the two bidi marks U+202B and U+202C, which are the
  # reader's and not ours.
  set path [::tclpdfTest::scratch forms-extract.pdf]
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::wholeFace
  $doc font -family ar -size 18
  $doc text "مرحبا" -at {180 30} -direction rtl
  $doc text "العربية مرحبا بالعالم" -at {180 50} -direction rtl
  $doc write $path
  $doc destroy
  set text [::tclpdfTest::scratch forms-extract.txt]
  exec pdftotext -enc UTF-8 $path $text
  set channel [open $text r]
  fconfigure $channel -encoding utf-8
  set lines [split [read $channel] \n]
  close $channel
  file delete $path $text
  set found {}
  foreach line [lrange $lines 0 1] {
    lappend found [string map [list ‫ {} ‬ {} ‏ {}] $line]
  }
  set found
} -result {مرحبا {العربية مرحبا بالعالم}}

test forms-6.3 {a ligature keeps the characters of both its letters} \
    -constraints haveWhole -body {
  # The lam-alef is one glyph and stands for two characters, and the CMap has
  # to say so in LOGICAL order - lam first, as the line was written.
  #
  # Checked in the CMap rather than through pdftotext, and that is not an
  # evasion: poppler reverses the characters of a run it takes for
  # right-to-left, ligature or not, so it hands back alef-lam for this word.
  # Measured. The file is right and the reader does what it does; asserting
  # the reader here would freeze somebody else's behaviour into this suite.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::wholeFace
  $doc text "لا" -at {180 30} -family ar -size 18 -direction rtl
  set path [::tclpdfTest::scratch forms-ligature.pdf]
  $doc write $path
  set writer [$doc writer]
  set number {}
  for {set at 1} {$at <= [$writer count]} {incr at} {
    if {[regexp {/ToUnicode (\d+) 0 R} [$writer body $at] -> found]} {
      set number $found
    }
  }
  set map [::tclpdfTest::streamOf $writer $number]
  $doc destroy
  file delete $path
  # One entry, and it holds both characters: the lam-alef glyph. The other
  # two entries of this document are the space and nothing else.
  regexp {<[0-9A-F]{4}> <06440627>} $map
} -result 1

cleanupTests

# viewerPreferences.test --
#
# How a reader should present the document (12.2).
#
# A viewer preference is a wish, and a wish that is spelled wrong is not an
# error anywhere - the reader falls back to its default and the document
# prints single sided for the rest of its life. Which is why almost all of
# this file is about refusing values rather than writing them.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::viewerPreferences
source [file join [file dirname [info script]] helper.tcl]

set here [file dirname [file dirname [file normalize [info script]]]]
set face [file join $here examples assets fonts DejaVuSans.ttf]
set srgbIcc [file join $here icc sRGB.icc]
testConstraint haveFace [expr {[file exists $face] && [file exists $srgbIcc]}]

proc drawn {} {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "x" -at {20 20}
  return $doc
}

test viewerPreferences-1.1 {a boolean and a name reach the catalogue} -body {
  set doc [drawn]
  $doc viewerPreferences -displayDocTitle 1 -duplex DuplexFlipLongEdge
  set path [::tclpdfTest::scratch vp-basic.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/DisplayDocTitle true} $bytes] \
      [regexp {/Duplex /DuplexFlipLongEdge} $bytes]
} -result {1 1}

test viewerPreferences-1.2 {calls accumulate instead of resetting} -body {
  # A document may state its window wishes in one place and its printing
  # wishes in another. Parsed with [option parse] over the full key list,
  # each call would silently clear everything it did not name.
  set doc [drawn]
  $doc viewerPreferences -fitWindow 1
  $doc viewerPreferences -numCopies 3
  set path [::tclpdfTest::scratch vp-accumulate.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/FitWindow true} $bytes] [regexp {/NumCopies 3} $bytes]
} -result {1 1}

test viewerPreferences-1.3 {the keys keep the order of the standard's table} -body {
  # So that a diff between two documents shows what differs rather than the
  # order the calls happened to come in.
  set doc [drawn]
  $doc viewerPreferences -numCopies 2
  $doc viewerPreferences -hideToolbar 1
  $doc viewerPreferences -displayDocTitle 1
  set path [::tclpdfTest::scratch vp-order.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set toolbar [string first "HideToolbar" $bytes]
  set title [string first "DisplayDocTitle" $bytes]
  set copies [string first "NumCopies" $bytes]
  list [expr {$toolbar < $title}] [expr {$title < $copies}]
} -result {1 1}

test viewerPreferences-1.4 {no wish means no dictionary} -body {
  # An empty /ViewerPreferences is legal and says nothing, and a reader has
  # to parse it to find that out.
  set doc [drawn]
  set path [::tclpdfTest::scratch vp-none.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/ViewerPreferences} $bytes
} -result 0

test viewerPreferences-1.5 {the settings can be read back} -body {
  set doc [drawn]
  $doc viewerPreferences -displayDocTitle 1 -direction R2L
  set state [$doc viewerPreferences]
  $doc destroy
  list [dict get $state displayDocTitle] [dict get $state direction]
} -result {1 R2L}

# --- what is refused ------------------------------------------------------

test viewerPreferences-2.1 {a misspelled name is refused at the call} -body {
  # The failure this prevents: /Duplex /DuplexFlipLong reaches the file, the
  # reader ignores it, and nothing anywhere reports a problem.
  set doc [drawn]
  set code [catch {$doc viewerPreferences -duplex DuplexFlipLong} err]
  $doc destroy
  list $code [string match "*must be one of*" $err] \
      [string match "*DuplexFlipLongEdge*" $err]
} -result {1 1 1}

test viewerPreferences-2.2 {a boolean key takes a boolean} -body {
  set doc [drawn]
  set code [catch {$doc viewerPreferences -displayDocTitle vielleicht} err]
  $doc destroy
  list $code [string match "*takes a boolean*" $err]
} -result {1 1}

test viewerPreferences-2.3 {numCopies takes an integer from 2 to 5, as Table 150 supports} -body {
  # Table 150: "supported values shall be the integers 2 through 5; values
  # outside this range shall be ignored". This test used to pin "positive
  # integer", under which a 1 or a 100 was written and ignored at the reader.
  # 0x3 and 2.0 pass [string is integer] and are not what a reader parses.
  set doc [drawn]
  set out {}
  foreach value {0 1 6 100 zwei 0x3 2.0 -3} {
    lappend out [catch {$doc viewerPreferences -numCopies $value} err] \
        [string match "*integer from 2 to 5*" $err]
  }
  set accepted [lmap value {2 3 4 5} {
    dict get [$doc viewerPreferences -numCopies $value] numCopies
  }]
  $doc destroy
  list [lsort -unique $out] $accepted
} -result {1 {2 3 4 5}}

test viewerPreferences-2.4 {an unknown option is refused} -body {
  set doc [drawn]
  set code [catch {$doc viewerPreferences -printArea CropBox} err]
  $doc destroy
  # ViewArea, ViewClip, PrintArea and PrintClip are deliberately absent: they
  # are deprecated in 2.0 and no reader acts on them.
  list $code [string match "*unknown*" $err]
} -result {1 1}

# --- every key and every name reaches the file ------------------------------

test viewerPreferences-3.1 {the remaining booleans reach the file, false as well as true} -body {
  # A 0 is written as the keyword false, not left out: "do not hide the
  # menu bar" is a wish too, and a reader with another default needs it.
  set doc [drawn]
  $doc viewerPreferences -hideMenubar 1 -hideWindowUI 1 -centerWindow 1 \
      -pickTrayByPDFSize 0
  set path [::tclpdfTest::scratch vp-booleans.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/ViewerPreferences\s*<<([^>]*)>>} $bytes -> dictionary
  list [regexp {/HideMenubar true} $dictionary] \
      [regexp {/HideWindowUI true} $dictionary] \
      [regexp {/CenterWindow true} $dictionary] \
      [regexp {/PickTrayByPDFSize false} $dictionary]
} -result {1 1 1 1}

test viewerPreferences-3.2 {every page mode for leaving full screen is written as a name} -body {
  set result {}
  foreach mode {UseNone UseOutlines UseThumbs UseOC} {
    set doc [drawn]
    $doc viewerPreferences -nonFullScreenPageMode $mode
    set path [::tclpdfTest::scratch vp-mode-$mode.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path
    lappend result [regexp "/NonFullScreenPageMode /$mode\\M" $bytes]
  }
  return $result
} -result {1 1 1 1}

test viewerPreferences-3.3 {L2R, both print scalings and the short-edge duplex} -body {
  set doc [drawn]
  $doc viewerPreferences -direction L2R -printScaling None \
      -duplex DuplexFlipShortEdge
  set path [::tclpdfTest::scratch vp-names.pdf]
  $doc write $path
  # A later call replaces the value rather than adding a second key.
  $doc viewerPreferences -printScaling AppDefault
  set second [::tclpdfTest::scratch vp-names-2.pdf]
  $doc write $second
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  set again [::tclpdfTest::readBytes $second]
  file delete $path $second
  list [regexp {/Direction /L2R} $bytes] \
      [regexp {/PrintScaling /None} $bytes] \
      [regexp {/Duplex /DuplexFlipShortEdge} $bytes] \
      [regexp {/PrintScaling /AppDefault} $again] \
      [regexp -all {/PrintScaling} $again]
} -result {1 1 1 1 1}

test viewerPreferences-3.4 {a key younger than the file's version is refused, naming it} -body {
  # The dictionary and its window keys are 1.2, -direction 1.3, -printScaling
  # 1.6, -duplex and -pickTrayByPDFSize 1.7 (Reference 1.7, Table 8.1). A
  # 1.6 file may ask for print scaling and not for a tray or a duplex mode.
  set doc [tclpdf new -version 1.6]
  $doc page add
  set scaling [catch {$doc viewerPreferences -printScaling AppDefault}]
  set tray [catch {$doc viewerPreferences -pickTrayByPDFSize 1} first]
  set duplex [catch {$doc viewerPreferences -duplex DuplexFlipShortEdge} second]
  $doc destroy
  set doc [tclpdf new -version 1.2]
  $doc page add
  set window [catch {$doc viewerPreferences -hideMenubar 1 -centerWindow 1}]
  set direction [catch {$doc viewerPreferences -direction L2R} third]
  $doc destroy
  list $scaling $tray [string match "*-pickTrayByPDFSize needs PDF 1.7*" $first] \
      $duplex [string match "*-duplex needs PDF 1.7*" $second] \
      $window $direction [string match "*-direction needs PDF 1.3*" $third]
} -result {0 1 1 1 1 0 1 1}

test viewerPreferences-3.5 {UseOC is a 1.5 value inside a 1.2 key} -body {
  set doc [tclpdf new -version 1.4]
  $doc page add
  set thumbs [catch {$doc viewerPreferences -nonFullScreenPageMode UseThumbs}]
  set oc [catch {$doc viewerPreferences -nonFullScreenPageMode UseOC} msg]
  $doc destroy
  set doc [tclpdf new -version 1.5]
  $doc page add
  set ok [catch {$doc viewerPreferences -nonFullScreenPageMode UseOC}]
  $doc destroy
  list $thumbs $oc [string match "*UseOC needs PDF 1.5*" $msg] $ok
} -result {0 1 1 0}

test viewerPreferences-4.1 {the catalog subscription is made once, and survives an emptied dictionary} -constraints haveTdom -body {
  # ua 1 sets DisplayDocTitle, ua 0 takes it out again and the dictionary is
  # empty as at the start. "First call" used to be read off that emptiness,
  # so the next preference subscribed ViewerPreferencesCatalog a second time
  # - measured, one catalog subscriber more. Now the module remembers that
  # it has subscribed, once per document.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc info Title "Titel"
  $doc language de-DE
  $doc page add
  $doc font -family helvetica -size 12
  $doc structure H1 -script {$doc text "Ueberschrift" -at {20 20}}
  $doc ua 1
  set once [llength [$doc subscribers catalog]]
  $doc ua 0
  set emptied [$doc viewerPreferences]
  $doc viewerPreferences -hideToolbar 1
  set again [llength [$doc subscribers catalog]]
  set path [::tclpdfTest::scratch viewerPreferences-once.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $emptied [expr {$again - $once}] [regexp -all {/ViewerPreferences} $bytes] \
      [regexp -all {/HideToolbar true} $bytes] [regexp -all {/DisplayDocTitle} $bytes]
} -result {{} 0 1 1 0}

# -- the initial view (Table 28) ---------------------------------------------
#
# /PageMode, /PageLayout and /OpenAction: which panel a reader shows, how it
# arranges the pages, and where it puts the reader first. Catalogue entries,
# not viewer preferences - which is why they are a command of their own and
# not three more options of the one above. See the head of viewerPreferences.tcl.

test viewerPreferences-initialView-5.1 {the three entries reach the catalogue} -body {
  set doc [drawn]
  $doc page add
  $doc initialView -pageMode UseThumbs -pageLayout TwoColumnLeft -page 1
  set path [::tclpdfTest::scratch iv-basic.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/PageMode /UseThumbs} $bytes] \
      [regexp {/PageLayout /TwoColumnLeft} $bytes] \
      [regexp {/OpenAction \[\d+ 0 R /Fit\]} $bytes]
} -result {1 1 1}

test viewerPreferences-initialView-5.2 {-to and -zoom make it an XYZ destination} -body {
  # The same three words [destination] and [link] use, read by the same
  # method - so a bookmark and an open action pointing at one place are
  # written from one piece of code. 20 mm from the left is 56.69 pt; 40 mm
  # from the top of A4 is 841.89 - 113.39.
  set doc [drawn]
  $doc page add
  $doc initialView -page 1 -to {20 40} -zoom 1.5
  set path [::tclpdfTest::scratch iv-xyz.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/OpenAction \[\d+ 0 R /XYZ 56\.6\d+ 728\.5\d+ 1\.5\]} $bytes
} -result 1

test viewerPreferences-initialView-5.3 {calls accumulate and the command answers what is set} -body {
  set doc [drawn]
  $doc initialView -pageMode UseOutlines
  set first [$doc initialView]
  $doc initialView -pageLayout OneColumn
  set second [$doc initialView]
  $doc initialView -pageMode UseNone
  set third [$doc initialView]
  $doc destroy
  list $first $second $third
} -result {{pageMode UseOutlines} {pageMode UseOutlines pageLayout OneColumn}\
    {pageMode UseNone pageLayout OneColumn}}

test viewerPreferences-initialView-5.4 {a page not added yet is resolved at the write} -body {
  # A forward /OpenAction takes the road a forward link takes: an object
  # reserved now and filled when every page is there.
  set doc [drawn]
  $doc initialView -page 2
  $doc page add
  $doc page add
  set path [::tclpdfTest::scratch iv-forward.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/OpenAction \d+ 0 R} $bytes
} -result 1

test viewerPreferences-initialView-5.5 {a page that never comes is named at the write} -body {
  set doc [drawn]
  $doc initialView -page 7
  set out [::tclpdfTest::refuse {$doc write [::tclpdfTest::scratch iv-never.pdf]}]
  catch {file delete [::tclpdfTest::scratch iv-never.pdf]}
  $doc destroy
  lrange $out 0 1
} -result {1 1}

test viewerPreferences-initialView-5.6 {the caller's page mode wins over the outline's} -body {
  # [bookmark] sets /PageMode /UseOutlines only where nothing else has
  # (outline.tcl), and a caller who asked for thumbnails beside their
  # bookmarks gets thumbnails. This is why the entry is written at the CALL
  # and not at the write.
  set doc [drawn]
  $doc initialView -pageMode UseThumbs
  $doc bookmark "Anfang" -page 0
  set path [::tclpdfTest::scratch iv-outline.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/PageMode /UseThumbs} $bytes] [regexp {/PageMode /UseOutlines} $bytes] \
      [regexp {/Type /Outlines} $bytes]
} -result {1 0 1}

test viewerPreferences-initialView-5.7 {and without one the outline still opens its pane} -body {
  # The guard the other way round: nothing about the old behaviour changes
  # for a document that says nothing.
  set doc [drawn]
  $doc bookmark "Anfang" -page 0
  set path [::tclpdfTest::scratch iv-outline-default.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/PageMode /UseOutlines} $bytes
} -result 1

test viewerPreferences-initialView-5.8 {every value is checked, and each refusal carries its code} -body {
  set doc [drawn]
  set out {}
  foreach call {
    {initialView -pageMode Nonsense}
    {initialView -pageLayout Nonsense}
    {initialView -pageMode UseNone -pageLayout Nonsense}
    {initialView -page -1}
    {initialView -page x}
    {initialView -page 1.0}
    {initialView -to {20 40}}
    {initialView -zoom 2}
    {initialView -page 0 -zoom -1}
    {initialView -page 0 -to 20}
    {initialView -nonFullScreenPageMode UseNone}
  } {
    lappend out [lindex [::tclpdfTest::refuse [list $doc {*}$call]] 2]
  }
  $doc destroy
  set out
} -result {{TCLPDF INITIALVIEW PAGEMODE Nonsense} {TCLPDF INITIALVIEW PAGELAYOUT Nonsense}\
    {TCLPDF INITIALVIEW PAGELAYOUT Nonsense} {TCLPDF INITIALVIEW PAGE -1}\
    {TCLPDF INITIALVIEW PAGE x} {TCLPDF INITIALVIEW PAGE 1.0}\
    {TCLPDF INITIALVIEW PAGE {}} {TCLPDF INITIALVIEW PAGE {}}\
    {TCLPDF INITIALVIEW ZOOM -1} {TCLPDF OPTION POINT -to initialView}\
    {TCLPDF OPTION UNKNOWN -nonFullScreenPageMode initialView}}

test viewerPreferences-initialView-5.9 {a refused call leaves the catalogue untouched} -body {
  # A good -pageMode beside a misspelt -pageLayout must write neither, or the
  # document carries half of what was asked for and the caller saw an error.
  set doc [drawn]
  catch {$doc initialView -pageMode UseThumbs -pageLayout Nonsense}
  set state [$doc initialView]
  set path [::tclpdfTest::scratch iv-partial.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $state [regexp {/PageMode} $bytes] [regexp {/PageLayout} $bytes]
} -result {{} 0 0}

test viewerPreferences-initialView-5.10 {the four young values raise the version floor} -body {
  # Table 28: UseOC is PDF 1.5, UseAttachments 1.6, and the two TwoPage
  # layouts 1.5. The KEYS that hold them are as old as the catalogue.
  #
  # The MESSAGE is read, not only the error code: a test that asks for a
  # refusal and takes any refusal cannot tell a version floor from a typo in
  # the test itself. Measured 2026-08-24 - with the floor silently dropped
  # the call still failed, on the line after it, and the test stayed green.
  set out {}
  foreach {version call value} {
    1.4 {initialView -pageMode UseOC} 1.5
    1.4 {initialView -pageMode UseAttachments} 1.6
    1.5 {initialView -pageMode UseAttachments} 1.6
    1.4 {initialView -pageLayout TwoPageLeft} 1.5
    1.4 {initialView -pageLayout TwoPageRight} 1.5
    1.4 {initialView -pageMode FullScreen} {}
    1.4 {initialView -pageLayout TwoColumnRight} {}
  } {
    set doc [tclpdf new -version $version]
    $doc page add
    set code [catch {$doc {*}$call} message]
    if {$value eq {}} {
      lappend out $code
    } else {
      lappend out [expr {$code && [string match \
          "*[lrange $call 0 2] needs PDF $value*" $message]}]
    }
    $doc destroy
  }
  # And the other half of a floor: where the value IS admitted, the document
  # cannot be written as anything older afterwards.
  set doc [tclpdf new -version 1.6]
  $doc page add
  $doc initialView -pageMode UseAttachments -pageLayout TwoPageLeft
  lappend out [catch {$doc configure -version 1.5}] \
      [catch {$doc configure -version 1.6}]
  $doc destroy
  set out
} -result {1 1 1 1 1 0 0 1 0}

test viewerPreferences-initialView-5.11 {viewerPreferences and initialView keep their own dictionaries} -body {
  # -nonFullScreenPageMode is a VIEWER PREFERENCE and -pageMode a catalogue
  # entry; the two overlap in four of six words and mean different things.
  # Neither command may answer for the other, and the UA check reads the
  # first of the two.
  set doc [drawn]
  $doc viewerPreferences -nonFullScreenPageMode UseThumbs
  $doc initialView -pageMode FullScreen
  set preferences [$doc viewerPreferences]
  set view [$doc initialView]
  set path [::tclpdfTest::scratch iv-apart.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $preferences $view [regexp {/NonFullScreenPageMode /UseThumbs} $bytes] \
      [regexp {/PageMode /FullScreen} $bytes]
} -result {{nonFullScreenPageMode UseThumbs} {pageMode FullScreen} 1 1}

test viewerPreferences-initialView-5.12 {qpdf reads the catalogue back} -body {
  set doc [drawn]
  $doc page add
  $doc initialView -pageMode UseThumbs -pageLayout TwoColumnLeft -page 1 \
      -to {20 40}
  set path [::tclpdfTest::scratch iv-qpdf.pdf]
  $doc write $path
  $doc destroy
  set code 0
  if {[auto_execok qpdf] ne {}} {
    set code [catch {exec qpdf --check $path}]
  }
  file delete $path
  set code
} -result 0

test viewerPreferences-initialView-5.13 {a destination in /OpenAction keeps PDF/A} \
    -constraints haveFace -body {
  # MEASURED with veraPDF 1.30, 2026-08-24: an /OpenAction holding a
  # DESTINATION passes PDF/A-3B, and so does /PageMode /FullScreen. What does
  # not is an ACTION of the wrong type - a /Launch and a /JavaScript open
  # action each failed clause 6.5.1, test 1 ("The Launch, Sound, Movie,
  # ResetForm, ImportData, Hide, SetOCGState, Rendition, Trans, GoTo3DView
  # and JavaScript actions shall not be permitted"). That is why this command
  # writes a destination and leaves an action to [catalogEntry OpenAction]:
  # an -action option would be a promise half of whose values break the
  # moment [pdfa] is declared.
  set doc [tclpdf new -unit mm]
  $doc pdfa -part 3 -conformance B -profile $srgbIcc
  $doc page add
  $doc font embed body $face
  $doc font -family body -size 12
  $doc text "Seite eins" -at {20 20}
  $doc page add
  $doc text "Seite zwei" -at {20 20}
  $doc initialView -pageMode FullScreen -pageLayout TwoColumnLeft -page 1 \
      -to {20 40}
  set path [::tclpdfTest::scratch iv-pdfa.pdf]
  $doc write $path
  $doc destroy
  set report [::tclpdfTest::verapdf $path 3b]
  file delete $path
  set report
} -result ok

cleanupTests

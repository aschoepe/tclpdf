# document.test --
#
# The document object, its pages and the drawing methods the topical modules
# attach to it. Also the lazy loading: a method that is not there yet must
# arrive on first use rather than fail.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::document
source [file join [file dirname [info script]] helper.tcl]

test document-1.1 {tclpdf new hands out a document} -body {
  set doc [tclpdf new]
  set result [list [$doc cget -format] [$doc cget -unit] [$doc page count]]
  $doc destroy
  set result
} -result {a4 mm 0}

test document-1.2 {options are checked, and the error lists the known ones} -body {
  tclpdf new -formt a4
} -returnCodes error -match glob -result {*unknown option "-formt"*-format*}

test document-1.3 {writing without a page is refused} -body {
  set doc [tclpdf new]
  try {
    $doc write [file join [temporaryDirectory] document-empty.pdf]
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*has no pages*}

test document-1.4 {drawing without a page names the remedy} -body {
  set doc [tclpdf new]
  try {
    $doc rect -at {10 10} -size {10 10} -fill red
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no such page*page add*}

test document-2.1 {page size comes back in the document unit} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set result [lmap value [$doc page size] {format %.0f $value}]
  $doc destroy
  set result
} -result {210 297}

test document-2.2 {a landscape page swaps the sides} -body {
  set doc [tclpdf new]
  $doc page add -orientation landscape
  set result [lmap value [$doc page size] {format %.0f $value}]
  $doc destroy
  set result
} -result {297 210}

test document-2.3 {the five page boxes} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {5 5 205 292}
  set crop [lmap value [$doc page box crop] {format %.0f $value}]
  set trim [$doc page box trim]
  $doc destroy
  list $crop $trim
} -result {{5 5 205 292} {}}

test document-2.4 {an unknown box names the known ones} -body {
  set doc [tclpdf new]
  $doc page add
  try {
    $doc page box slug {0 0 10 10}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown page box*media, crop, bleed, trim, art*}

test document-2.5 {page rotation must be a multiple of 90} -body {
  set doc [tclpdf new]
  try {
    $doc page add -rotate 45
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*multiple of 90*}

test document-3.1 {y is measured from the TOP, and converted} -body {
  # 20 mm from the top of an A4 page is 297-20 = 277 mm from the bottom,
  # which is 785.2 pt. Getting this wrong puts the whole page upside down.
  set doc [tclpdf new -unit mm]
  $doc page add
  set result [lmap value [$doc coords 10 20] {format %.2f $value}]
  $doc destroy
  set result
} -result {28.35 785.20}

test document-4.1 {a drawing method arrives on first use} -body {
  # rect lives in shape.tcl, which is not loaded until now - the topic table
  # in document.tcl is what fetches it.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {50 20} -fill steelblue
  # Trailing zeros are trimmed by the number formatter, so it is 0.5098 and
  # not 0.50980 - the shorter form is the one that ends up in the file.
  set result [string match "*0.27451 0.5098 0.70588 rg*re*f*" [::tclpdfTest::content $doc]]
  $doc destroy
  set result
} -result 1

test document-4.2 {an unknown method still fails as a method} -body {
  set doc [tclpdf new]
  try {
    $doc thisDoesNotExist
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown method "thisDoesNotExist"*}

test document-4.3 {the painting operator follows fill and stroke} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {5 5} -fill red
  $doc rect -at {20 10} -size {5 5} -stroke red
  $doc rect -at {30 10} -size {5 5} -fill red -stroke blue
  $doc rect -at {40 10} -size {5 5} -fill red -rule evenodd
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # f, S, B and f* - one of the six spellings each, and the wrong one draws
  # nothing at all without an error.
  list [regexp {re\s+f\n} $content] [regexp {re\s+S\n} $content] \
      [regexp {re\s+B\n} $content] [regexp {re\s+f\*\n} $content]
} -result {1 1 1 1}

test document-4.4 {rotating about a point leaves that point where it was} -body {
  # Regression: both shifts negative puts the shape off the page, both
  # positive rotates about the origin. Neither produces an error - only a
  # shape somewhere else, which no validator reports.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc save
  $doc transform -at {100 100} -rotate 30
  $doc restore
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) cm} \
      $content -> a b c d e f
  # The fixed point of the matrix must be 100/100 mm = 283.46/558.43 pt.
  set x [expr {$a * 283.46 + $c * 558.43 + $e}]
  set y [expr {$b * 283.46 + $d * 558.43 + $f}]
  list [format %.1f $x] [format %.1f $y]
} -result {283.5 558.4}

test document-5.1 {a written file carries the metadata and the pages} -body {
  set path [file join [temporaryDirectory] document-write.pdf]
  set doc [tclpdf new]
  $doc info Title "Rechnung 2026-0815"
  $doc page add
  $doc page add
  $doc line -from {20 20} -to {190 20} -stroke black
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [string range $bytes 0 7] [regexp {/Count 2} $bytes] \
      [regexp {Rechnung 2026-0815} $bytes] [regexp {%%EOF} $bytes]
} -result {%PDF-1.7 1 1 1}

test document-5.2 {the version reaches the header} -body {
  set path [file join [temporaryDirectory] document-version.pdf]
  set doc [tclpdf new -version 2.0]
  $doc page add
  $doc write $path
  $doc destroy
  set head [string range [::tclpdfTest::readBytes $path] 0 7]
  file delete $path
  set head
} -result %PDF-2.0

test document-6.1 {a subscriber can add a catalog entry without a core change} -body {
  # The mechanism attachments and ZUGFeRD rely on.
  set path [file join [temporaryDirectory] document-hook.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc on catalog {apply {{document} {
    $document catalogEntry Lang (de-DE)
  }}}
  $doc write $path
  $doc destroy
  set found [regexp {/Lang \(de-DE\)} [::tclpdfTest::readBytes $path]]
  file delete $path
  set found
} -result 1

test document-6.2 {XMP metadata is stored uncompressed} -body {
  # PDF/A requires the packet to be readable without decoding; a validator
  # that cannot read it fails the file.
  set path [file join [temporaryDirectory] document-xmp.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc metadata {<?xpacket begin="" id="W5M0MpCehiHzreSzNTczkc9d"?></x:xmpmeta>}
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Type /Metadata} $bytes] [regexp {xpacket begin} $bytes]
} -result {1 1}

test document-9.1 {state tells reading and writing apart by argument count} -body {
  # Regression. With a default parameter the two were indistinguishable:
  # "my state key {}" looked like clearing and returned the value instead.
  # The SVG module used it to reset a counter, so the counter never reset and
  # reported gradients in drawings that have none - a diagnostic that lied.
  set doc [tclpdf new]
  $doc state counter 7
  set stored [$doc state counter]
  $doc state counter {}
  set cleared [$doc state counter]
  $doc destroy
  list $stored $cleared
} -result {7 {}}

test document-9.2 {state refuses more than one value} -body {
  set doc [tclpdf new]
  try {
    $doc state key a b
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*at most one value*}

test document-version-10.1 {configure -version reaches the file} -body {
  # [cget -version] answered 1.4 while the file still said %PDF-1.7: the
  # writer is built once in the constructor and carried the version with it,
  # so a later [configure] changed the option and nothing else. Two sources of
  # truth, no error, and the file claims a version it was not written for.
  set doc [tclpdf new]
  $doc page add
  $doc configure -version 1.4
  set path [::tclpdfTest::scratch version.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  string range $bytes 0 7
} -result {%PDF-1.4}

test document-clear-11.1 {an empty value removes, it does not read} -body {
  # The same trap [state] documents: with a default parameter "clear this" and
  # "read this" are the same call, and the caller silently gets the wrong one.
  # [info Title {}] used to RETURN the title and leave it standing.
  set doc [tclpdf new]
  $doc info Title "Titel"
  set before [$doc info Title]
  $doc info Title {}
  set after [$doc info Title]
  $doc destroy
  list $before $after
} -result {Titel {}}

test document-clear-11.2 {catalogEntry and resource clear the same way} -body {
  set doc [tclpdf new]
  $doc catalogEntry PageMode /UseOutlines
  $doc resource ExtGState GStest "1 0 R"
  $doc catalogEntry PageMode {}
  $doc resource ExtGState GStest {}
  set result [list [$doc catalogEntry PageMode] [$doc resource ExtGState GStest]]
  $doc destroy
  set result
} -result {{} {}}

test document-clear-11.3 {too many arguments are refused, not guessed} -body {
  set doc [tclpdf new]
  set codes [list [catch {$doc info Title a b}] [catch {$doc catalogEntry K a b}] \
      [catch {$doc metadata a b}] [catch {$doc resource Font a b c}]]
  $doc destroy
  set codes
} -result {1 1 1 1}

test document-box-12.1 {a page box that does not start at zero} -body {
  # A box is {x0 y0 x1 y1}, so the size is the DIFFERENCE. Taking x1 and y1
  # answered 220 by 307 for a page that is in fact 210 by 297 (7.7.6.3).
  set doc [tclpdf new]
  $doc page add
  $doc page box media {10 10 220 307}
  set size [$doc page size]
  $doc destroy
  lmap value $size {format %.0f $value}
} -result {210 297}

test document-box-12.2 {the origin follows the box, not the axis} -body {
  # Ignoring x0 put everything ten millimetres left of the box: still in the
  # file, outside the page, and no validator says a word.
  set doc [tclpdf new]
  $doc page add
  $doc page box media {10 10 220 307}
  $doc rect -at {0 0} -size {10 10} -fill red
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # 10 mm is 28.34646 pt - the x of the rectangle must start there, not at 0.
  regexp {28\.34646 [0-9.]+ [0-9.]+ [0-9.]+ re} $content
} -result 1

test document-channel-13.1 {writeChannel produces the same document as write} -body {
  # The manual described [writeChannel] and the method did not exist: it lived
  # on the WRITER, took two arguments, and "$doc writeChannel $fh" answered
  # "unknown method". Nothing called it, so nothing noticed.
  set first [::tclpdfTest::scratch channel-a.pdf]
  set second [::tclpdfTest::scratch channel-b.pdf]

  set doc [tclpdf new]
  $doc page add
  $doc text "Kanal" -at {20 20}
  [$doc writer] id "0123456789abcdef"
  $doc write $first
  $doc destroy

  set doc [tclpdf new]
  $doc page add
  $doc text "Kanal" -at {20 20}
  [$doc writer] id "0123456789abcdef"
  set channel [open $second w]
  $doc writeChannel $channel
  close $channel
  $doc destroy

  # Byte for byte the same - the /ID is pinned, so nothing is left to differ.
  set same [expr {[::tclpdfTest::readBytes $first] eq [::tclpdfTest::readBytes $second]}]
  file delete $first $second
  set same
} -result 1

test document-channel-13.2 {a document without pages is refused either way} -body {
  set doc [tclpdf new]
  set path [::tclpdfTest::scratch channel-empty.pdf]
  set channel [open $path w]
  set codes [list [catch {$doc write $path}] [catch {$doc writeChannel $channel}]]
  close $channel
  file delete $path
  $doc destroy
  set codes
} -result {1 1}

test document-rewrite-14.1 {a second write is byte-identical, not larger} -body {
  # Builders used to reserve fresh object numbers on every write: each run
  # added five core objects and the file grew, with the earlier objects left
  # unreachable. Now every write-time builder holds its numbers through
  # [reservation] and writes over them - and /ID and CreationDate are kept,
  # so nothing is left to differ.
  set first [::tclpdfTest::scratch rewrite-a.pdf]
  set second [::tclpdfTest::scratch rewrite-b.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc text "unveraendert" -at {20 20}
  $doc write $first
  $doc write $second
  set count [[$doc writer] count]
  $doc destroy
  set same [expr {[::tclpdfTest::readBytes $first] eq [::tclpdfTest::readBytes $second]}]
  file delete $first $second
  list $same $count
} -result {1 7}

test document-rewrite-14.2 {write, draw on, write again - the additions arrive} -body {
  # The measured case that ruled out caching the build: this works and has to
  # keep working. A cached trailer would silently drop everything after the
  # first write - a stale file with no error is worse than a large one.
  set first [::tclpdfTest::scratch rewrite-c.pdf]
  set second [::tclpdfTest::scratch rewrite-d.pdf]
  # Uncompressed, so the added text is findable in the raw bytes.
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc text "Erste Fassung" -at {20 20}
  $doc write $first
  $doc text "Nachtrag" -at {20 40}
  $doc page add
  $doc text "Seite zwei" -at {20 20}
  $doc write $second
  $doc destroy
  set bytes [::tclpdfTest::readBytes $second]
  file delete $first $second
  list [regexp {/Count 2} $bytes] [regexp {Nachtrag} $bytes] \
      [regexp {Seite zwei} $bytes]
} -result {1 1 1}

test document-9.1 {the document language goes into the catalog} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc language de-DE
  set back [$doc language]
  $doc text "x" -at {10 10}
  set file [file join [::tcltest::temporaryDirectory] lang.pdf]
  $doc write $file
  set fh [open $file rb]
  set bytes [read $fh]
  close $fh
  file delete $file
  $doc destroy
  # Read back what was set, and find it in the catalog rather than trusting
  # the setter.
  list $back [regexp {/Lang \(de-DE\)} $bytes]
} -result {de-DE 1}

test document-9.2 {a malformed language tag is refused} -body {
  set doc [tclpdf new -unit mm]
  set caught [catch {$doc language "de_DE"} message]
  $doc destroy
  list $caught [string match {*not a language tag*} $message]
} -result {1 1}

test document-9.3 {without a language nothing is written} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set empty [$doc language]
  $doc text "x" -at {10 10}
  set file [file join [::tcltest::temporaryDirectory] nolang.pdf]
  $doc write $file
  set fh [open $file rb]
  set bytes [read $fh]
  close $fh
  file delete $file
  $doc destroy
  list $empty [regexp {/Lang} $bytes]
} -result {{} 0}

# -- -typeArea ----------------------------------------------------------------

test document-10.1 {-typeArea takes two or four distances and answers them back} -body {
  set doc [tclpdf new -unit mm -typeArea {20 25}]
  set two [$doc cget -typeArea]
  $doc configure -typeArea {20 25 15 18}
  set four [$doc cget -typeArea]
  $doc destroy
  list $two $four
} -result {{20 25} {20 25 15 18}}

test document-10.2 {three distances are refused, and so is a negative one} -body {
  set doc [tclpdf new -unit mm]
  set codes {}
  foreach value {{1 2 3} {-1 2} {a b} {20 25 15 -1}} {
    lappend codes [catch {$doc configure -typeArea $value} message] $message
  }
  $doc destroy
  list [lindex $codes 0] [regexp {takes \{top bottom\} or} [lindex $codes 1]] \
      [lindex $codes 2] [regexp {distances of 0 or more, not "-1"} [lindex $codes 3]] \
      [lindex $codes 4] [regexp {not "a"} [lindex $codes 5]] \
      [lindex $codes 6] [regexp {not "-1"} [lindex $codes 7]]
} -result {1 1 1 1 1 1 1 1}

test document-10.3 {an empty -typeArea returns to the default} -body {
  set doc [tclpdf new -unit mm -typeArea {20 25}]
  $doc configure -typeArea {}
  $doc page add
  set area [$doc page typeArea]
  $doc destroy
  lmap v $area {format %.2f $v}
} -result {10.50 14.85 199.50 282.15}

# -- the options of tclpdf new, on the command itself --------------------------
#
# Every value the manual lists for [tclpdf new], exercised where it is given
# rather than on [page add] or [configure]: the option decides what the FIRST
# page measures, and cget has to answer what was said.

test document-options-15.1 {-unit in and -unit px measure the page in that unit} -body {
  # A4 is 8.27 by 11.69 inches; px is the same as pt, so it answers points.
  set doc [tclpdf new -unit in]
  $doc page add
  set inches [lmap v [$doc page size] {format %.2f $v}]
  set unit [$doc cget -unit]
  $doc destroy
  set doc [tclpdf new -unit px]
  $doc page add
  set pixels [lmap v [$doc page size] {format %.2f $v}]
  set stroke [$doc coords 72 72]
  $doc destroy
  list $inches $unit $pixels [lmap v $stroke {format %.2f $v}]
} -result {{8.27 11.69} in {595.28 841.89} {72.00 769.89}}

test document-options-15.2 {-format a4 by name and -format {w h} as a pair} -body {
  set doc [tclpdf new -unit mm -format a4]
  $doc page add
  set named [lmap v [$doc page size] {format %.0f $v}]
  $doc destroy
  # A pair is taken as it stands: {88 55} is 88 wide, not turned upright.
  set doc [tclpdf new -unit mm -format {88 55}]
  $doc page add
  set pair [lmap v [$doc page size] {format %.0f $v}]
  set kept [$doc cget -format]
  $doc destroy
  list $named $pair $kept
} -result {{210 297} {88 55} {88 55}}

test document-options-15.3 {-orientation portrait, landscape, hoch and quer on a named format} -body {
  set result {}
  foreach orientation {portrait landscape hoch quer} {
    set doc [tclpdf new -unit mm -format a4 -orientation $orientation]
    $doc page add
    lappend result [lmap v [$doc page size] {format %.0f $v}] [$doc cget -orientation]
    $doc destroy
  }
  set result
} -result {{210 297} portrait {297 210} landscape {210 297} hoch {297 210} quer}

test document-options-15.4 {tclpdf formats lists the names page add accepts, sorted} -body {
  set formats [tclpdf formats]
  set doc [tclpdf new -unit mm]
  foreach name $formats {
    $doc page add -format $name
  }
  set pages [$doc page count]
  $doc destroy
  list [expr {"a4" in $formats}] [expr {"letter" in $formats}] \
      [expr {$formats eq [lsort $formats]}] [expr {$pages == [llength $formats]}]
} -result {1 1 1 1}

test document-options-15.5 {configure -format and -orientation change the pages added from then on} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc configure -format a5
  $doc page add
  $doc configure -orientation landscape
  $doc page add
  set sizes [lmap i {0 1 2} {lmap v [$doc page size $i] {format %.0f $v}}]
  set answers [list [$doc cget -format] [$doc cget -orientation]]
  $doc destroy
  list $sizes $answers
} -result {{{210 297} {148 210} {210 148}} {a5 landscape}}

test document-options-15.6 {cget -compress answers the option, and the file follows it} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc text "x" -at {10 10}
  set plain [$doc cget -compress]
  set path [::tclpdfTest::scratch document-compress.pdf]
  $doc write $path
  set unfiltered [regexp {FlateDecode} [::tclpdfTest::readBytes $path]]
  $doc configure -compress 1
  set deflated [$doc cget -compress]
  $doc write $path
  set filtered [regexp {FlateDecode} [::tclpdfTest::readBytes $path]]
  file delete $path
  $doc destroy
  list $plain $unfiltered $deflated $filtered
} -result {0 0 1 1}

test document-options-15.7 {a two-number format is turned when the document asked for an orientation} -body {
  set out {}
  foreach args {{-format {55 88}} {-format {55 88} -orientation quer} {-format {88 55} -orientation portrait} {-orientation landscape}} {
    set doc [tclpdf new {*}$args]
    $doc page add
    lappend out [lmap v [$doc page size] {format %.0f $v}]
    # a pair on page add follows the document's stated orientation as well,
    # and the page add's own orientation wins over both
    $doc page add -format {55 88}
    lappend out [lmap v [$doc page size] {format %.0f $v}]
    $doc page add -format {55 88} -orientation portrait
    lappend out [lmap v [$doc page size] {format %.0f $v}]
    $doc destroy
  }
  # configure counts as asking, too
  set doc [tclpdf new]
  $doc configure -orientation landscape
  $doc page add -format {55 88}
  lappend out [lmap v [$doc page size] {format %.0f $v}]
  $doc destroy
  set out
} -result {{55 88} {55 88} {55 88} {88 55} {88 55} {55 88} {55 88} {55 88} {55 88} {297 210} {88 55} {55 88} {88 55}}

# -- -typeArea follows the unit ------------------------------------------------

test document-typeArea-21.1 {the margins follow a change of -unit} -body {
  # 25 mm top and bottom, then the document goes to points: the page boxes
  # are stored in points and read back in the new unit; the margins used to
  # stay 25 and be read as 25 pt.
  set doc [tclpdf new -unit mm -typeArea {25 25}]
  $doc page add
  set mm [lmap v [$doc page typeArea] {format %.2f $v}]
  $doc configure -unit pt
  set pt [lmap v [$doc page typeArea] {format %.2f $v}]
  set cget [lmap v [$doc cget -typeArea] {format %.2f $v}]
  $doc configure -unit cm
  set cm [lmap v [$doc cget -typeArea] {format %.2f $v}]
  $doc destroy
  list $mm $pt $cget $cm
} -result {{10.50 25.00 199.50 272.00} {29.76 70.87 565.51 771.02} {70.87 70.87} {2.50 2.50}}

test document-typeArea-21.2 {a -typeArea given with -unit in the same call is in that unit} -body {
  set doc [tclpdf new -unit pt -typeArea {72 72 36 36}]
  $doc page add
  set area [lmap v [$doc page typeArea] {format %.1f $v}]
  set kept [$doc cget -typeArea]
  # configure both at once: the new area is read in the new unit, not
  # converted from the old one.
  $doc configure -unit in -typeArea {1 1}
  set inch [$doc cget -typeArea]
  set page [lmap v [$doc page typeArea] {format %.3f $v}]
  $doc destroy
  list $area $kept $inch $page
} -result {{36.0 72.0 559.3 769.9} {72 72 36 36} {1 1} {0.413 1.000 7.854 10.693}}

test document-typeArea-21.3 {cget answers what was written, exactly, while the unit stands} -body {
  set doc [tclpdf new -unit mm -typeArea {20 25 15 18}]
  $doc configure -compress 0
  set same [$doc cget -typeArea]
  $doc destroy
  set same
} -result {20 25 15 18}

# -- -compress is a boolean, /Tabs is a 1.5 key ------------------------------

test document-compress-20.1 {-compress takes a boolean and refuses anything else at the call} -body {
  # "-compress foo" used to fail at the first write with "expected boolean
  # value but got foo" - a raw Tcl message naming no option - and
  # "-compress 2" was silently taken as true.
  set out {}
  foreach value {foo 2 {} 1.5} {
    lappend out [catch {tclpdf new -compress $value} err] \
        [string match "*-compress takes a boolean, not \"$value\"*" $err]
  }
  set doc [tclpdf new -compress yes]
  lappend out [$doc cget -compress]
  lappend out [catch {$doc configure -compress maybe} err] \
      [string match {*-compress takes a boolean, not "maybe"*} $err] [$doc cget -compress]
  $doc configure -compress off
  lappend out [$doc cget -compress]
  $doc destroy
  set out
} -result {1 1 1 1 1 1 1 1 yes 1 1 yes off}

test document-compress-20.2 {/Tabs /S is written on a page with annotations from PDF 1.5 on, not below} -body {
  # Tabs is a PDF 1.5 entry of the page dictionary (ISO 32000-1, Table
  # 30); a 1.4 file with a link used to carry it all the same. Left out
  # below 1.5 rather than refused - nothing was asked for.
  set out {}
  foreach version {1.4 1.5 1.7} {
    set doc [tclpdf new -unit mm -compress 0 -version $version]
    $doc page add
    $doc link -at {10 10} -size {20 10} -url http://example.org/
    set path [::tclpdfTest::scratch document-tabs-$version.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path
    lappend out [regexp -all {/Tabs /S} $bytes] [regexp -all {/Annots \[} $bytes]
  }
  set out
} -result {0 1 1 1 1 1}

# --- destinations ---------------------------------------------------------

test document-destination-21.1 {destination builds the array: /Fit bare, /XYZ with -to and -zoom} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc page add
  set out [list [$doc destination 1]]
  # -to lands on the point, -zoom is the magnification there; without -zoom
  # the reader keeps its own, written as null.
  lappend out [regexp {^\[\d+ 0 R /XYZ [-\d.]+ [-\d.]+ 1.5\]$} \
      [$doc destination 1 -to {20 30} -zoom 1.5]]
  lappend out [regexp {^\[\d+ 0 R /XYZ [-\d.]+ [-\d.]+ null\]$} \
      [$doc destination 1 -to {20 30}]]
  $doc destroy
  set out
} -match glob -result {{\[* 0 R /Fit\]} 1 1}

test document-destination-21.2 {destination takes options, not positional arguments} -body {
  # The point and the zoom used to be positional; the option form is the
  # only one, so the old call is refused with the list of known options.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc page add
  set out [list [catch {$doc destination 1 {20 30} 1.5} err] \
      [string match {*unknown option*known are: -to -zoom*} $err]]
  lappend out [catch {$doc destination 1 -bogus x} err] \
      [string match {*unknown option "-bogus"*} $err]
  lappend out [catch {$doc destination -1} err] \
      [string match {*no such page: -1*} $err]
  $doc destroy
  set out
} -result {1 1 1 1 1 1}

test document-destination-21.3 {a destination at a page that never comes fails at the write} -body {
  # A forward destination is allowed and becomes an indirect object; a page
  # still missing at write time is reported. A direct call has no name of
  # its own, so the report says "a destination" - link and bookmark pass
  # theirs through the internal form, see zugferd-5.2a and zugferd-6.5.
  set doc [tclpdf new -unit mm]
  $doc page add
  set out [list [regexp {^\d+ 0 R$} [$doc destination 9]]]
  lappend out [catch {$doc write [::tclpdfTest::scratch document-dest-lost.pdf]} err] \
      [string match {*a destination points at page 9 and the document has 1 page(s)*} $err]
  $doc destroy
  set out
} -result {1 1 1}

test document-destination-21.4 {catalogEntry OpenAction takes a destination} -body {
  # The standing direct use: the reader opens the document on page two.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc page add
  $doc catalogEntry OpenAction [$doc destination 1]
  set path [::tclpdfTest::scratch document-dest-open.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/OpenAction \[(\d+) 0 R /Fit\]} $bytes -> number
  # The action's target has to be the SECOND page object, as zugferd-5.2
  # reads its target off the page list.
  set pages [regexp -all -inline {\n(\d+) 0 obj\n<< /Type /Page } $bytes]
  expr {$number eq [lindex $pages 3]}
} -result 1


test document-resource-22.1 {resource refuses a category outside Table 34 by name, on read and write} -body {
  # ISO 32000-2, Table 34 names the eight entries of a resource dictionary.
  # A misspelt category used to land in the file without a word, as a
  # dictionary no reader ever looks up.
  set doc [tclpdf new]
  set write [catch {$doc resource Bogus X "1 0 R"} m1]
  set read [catch {$doc resource Bogus} m2]
  set good [catch {$doc resource ProcSet PDF "/PDF"}]
  set back [$doc resource ProcSet PDF]
  $doc destroy
  list $write [string match {tclpdf: resource category is ExtGState, ColorSpace, Pattern, Shading, XObject, Font, ProcSet or Properties, not "Bogus"} $m1] \
      $read [string match {tclpdf:*not "Bogus"} $m2] $good $back
} -result {1 1 1 1 0 /PDF}

# --- the trailer entry point (7.5.5) ----------------------------------------
#
# The twin of catalogEntry. It exists so that /Encrypt has a way into the
# file that does not mean touching output.tcl - the trailer was the one
# dictionary in the document a subscriber could not reach.

test document-trailer-23.1 {a trailer entry reaches the written trailer} -body {
  set doc [tclpdf new -unit pt -format a4]
  $doc page add
  set back [$doc trailerEntry Foo 42]
  set path [::tclpdfTest::scratch document-trailer.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set trailer [string range $bytes [string last "trailer" $bytes] end]
  list $back [regexp {/Foo 42} $trailer] [regexp {/Root} $trailer] \
      [regexp {/Foo} [string range $bytes 0 [string last "trailer" $bytes]]]
} -result {42 1 1 0}

test document-trailer-23.2 {reading answers what was put in, and an unset key answers nothing} -body {
  set doc [tclpdf new]
  $doc trailerEntry Foo "42"
  set there [$doc trailerEntry Foo]
  set absent [$doc trailerEntry Bar]
  $doc destroy
  list $there $absent
} -result {42 {}}

test document-trailer-23.3 {an empty value removes the entry, as with catalogEntry} -body {
  set doc [tclpdf new -unit pt -format a4]
  $doc page add
  $doc trailerEntry Foo 42
  $doc trailerEntry Foo {}
  set back [$doc trailerEntry Foo]
  set path [::tclpdfTest::scratch document-trailer-gone.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $back [regexp {/Foo} $bytes]
} -result {{} 0}

test document-trailer-23.4 {a second value is refused in the same words as the twin} -body {
  set doc [tclpdf new]
  set trailer [catch {$doc trailerEntry K a b} m1]
  set catalog [catch {$doc catalogEntry K a b} m2]
  $doc destroy
  list $trailer $catalog \
      [string map {trailerEntry catalogEntry} $m1] $m2
} -result {1 1 {tclpdf: catalogEntry takes a key and at most one value} {tclpdf: catalogEntry takes a key and at most one value}}

# --- strings on their way into the file (ISO 32000-2, 7.6.2) ----------------
#
# A PDF is encrypted string by string, not as a file, so every string a
# module writes into an object goes out through the document's own
# constructors. A module reaching past them writes the one string in the
# document a reader cannot decrypt - and nothing in the file says so.

# Stands in for a cipher: it answers finished PDF syntax, which is what the
# seam asks for, and marks what it saw.
proc documentMarker {kind value} {
  switch -- $kind {
    str {return "(MARK:$value)"}
    hexStr {return "<[binary encode hex $value]>"}
    bytesStr {return "(BYTES:[string length $value])"}
  }
  return -code error "unknown kind $kind"
}

test document-strings-24.1 {every string a document writes goes through the seam} -body {
  set doc [tclpdf new -unit pt -format a4 -compress 0]
  # Set FIRST - see document-strings-24.4 for why that is not a detail of
  # the test but the contract.
  $doc state stringEncryptor documentMarker
  $doc page add
  $doc info Title "Bericht"
  $doc language de-DE
  $doc text "x" -at {20 700}
  $doc link -at {20 690} -size {40 10} -page 0 -to {20 690} \
      -tooltip "Hinweis"
  $doc bookmark "Kapitel" -at {20 690}
  $doc pageLabels -from 0 -style D -prefix "Blatt"
  set path [::tclpdfTest::scratch document-strings.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Title, /Lang, the tooltip, the bookmark title and the label prefix -
  # each of them went past pdfObj and through the document.
  lmap want {Bericht de-DE Hinweis Kapitel Blatt} {
    regexp "\\(MARK:$want\\)" $bytes
  }
} -result {1 1 1 1 1}

test document-strings-24.2 {an indexed palette is a string too, and it takes the same way} -body {
  # imagePng builds it in a namespace proc, which has no [my] - the way to
  # build a string travels there as a command prefix.
  set png [::tclpdfTest::png 2 2 8 3 \
      [binary format cu* {0 0 1 0 1 0}] {} [binary format cu* {255 0 0 0 255 0}]]
  set path [::tclpdfTest::scratch document-strings-palette.png]
  set channel [open $path wb]
  puts -nonewline $channel $png
  close $channel
  set doc [tclpdf new -unit pt -format a4 -compress 0]
  $doc page add
  $doc state stringEncryptor documentMarker
  $doc image embed pic $path
  $doc image place pic -at {20 700} -size {20 20}
  set out [::tclpdfTest::scratch document-strings-palette.pdf]
  $doc write $out
  $doc destroy
  set bytes [::tclpdfTest::readBytes $out]
  file delete $path $out
  # Six bytes of palette, and /Indexed still names it.
  list [regexp {/Indexed /DeviceRGB 1 \(BYTES:6\)} $bytes] \
      [regexp {/Indexed /DeviceRGB 1 \(} $bytes]
} -result {1 1}

test document-strings-24.3 {without an encryptor the seam is not there at all} -body {
  # A prefix that reproduces pdfObj exactly has to give the same file as no
  # prefix at all, byte for byte: that is what "pass-through" means, and it
  # is what the byte-identity tests elsewhere in the suite rely on.
  proc documentPlain {kind value} {
    return [::tclpdf::pdfObj $kind $value]
  }
  set files {}
  foreach prefix {{} documentPlain} {
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    [$doc writer] id [binary format H* 00112233445566778899aabbccddeeff]
    $doc page add
    $doc info Title "Bericht"
    $doc state created 1234567890
    $doc language de-DE
    $doc text "x" -at {20 700}
    $doc bookmark "Kapitel" -at {20 690}
    if {$prefix ne {}} {
      $doc state stringEncryptor $prefix
    }
    set path [::tclpdfTest::scratch document-strings-plain.pdf]
    $doc write $path
    $doc destroy
    lappend files [::tclpdfTest::readBytes $path]
    file delete $path
  }
  rename documentPlain {}
  expr {[lindex $files 0] eq [lindex $files 1]}
} -result 1

test document-strings-24.4 {a string built at CALL time is built then, not at the write} -body {
  # Measured, and the reason 24.1 sets the encryptor before anything else:
  # [language] and [link] put FINISHED PDF syntax into the catalog and into
  # the annotation the moment they are called, while [info], [bookmark] and
  # [pageLabels] keep the value and build the string during the write. An
  # encryptor installed in between therefore catches the second group and
  # not the first.
  #
  # This is the contract as it stands, not an opinion about it: whoever
  # switches encryption on has to do it before the document is filled, or
  # move those two to build at write time.
  set doc [tclpdf new -unit pt -format a4 -compress 0]
  $doc page add
  $doc info Title "Bericht"
  $doc language de-DE
  $doc link -at {20 690} -size {40 10} -page 0 -to {20 690} -tooltip "Hinweis"
  $doc bookmark "Kapitel" -at {20 690}
  $doc state stringEncryptor documentMarker
  set path [::tclpdfTest::scratch document-strings-late.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # written at the write / written at the call
  lmap want {Bericht Kapitel de-DE Hinweis} {
    regexp "\\(MARK:$want\\)" $bytes
  }
} -result {1 1 0 0}

test document-strings-24.5 {no module builds a string past the document unrecorded} -body {
  # The measuring guard. Every direct call of pdfObj's three string
  # constructors in the package is listed here with a reason; a new one that
  # is not turns this test red, so that "should this string be encrypted?"
  # is answered when it is written rather than by a reader who cannot open
  # the file.
  #
  # The count is the check, not a pattern: a site removed is as much a
  # decision as a site added, and both belong in this table.
  set allowed {
    document.tcl {3 {the seam itself - Str, HexStr and BytesStr are what everything else uses}}
    writer.tcl {1 {/ID stays in the clear: the key is derived from it, so a reader needs it BEFORE it can decrypt (7.6.2)}}
    text.tcl {5 {strings INSIDE a content stream - the stream is encrypted as a whole, a second pass would destroy it (7.6.2)}}
    attach.tcl {1 {keyBytes only ASKS what the bytes would be, for the name tree order (7.9.6) - the answer never reaches the file}}
    imagePng.tcl {3 {the default of the command prefix a namespace proc takes instead of [my]}}
  }
  # crypto.tcl and encrypt.tcl are not swept: the strings of the encryption
  # dictionary itself are the ones 7.6.2 exempts, and that module is the one
  # place that knows which those are.
  set skip {crypto.tcl encrypt.tcl}

  set root [file dirname [file dirname [file normalize [info script]]]]
  set found {}
  foreach file [lsort [glob -directory $root *.tcl]] {
    set name [file tail $file]
    if {$name in $skip} {
      continue
    }
    set channel [open $file r]
    set source [read $channel]
    close $channel
    set number 0
    foreach line [split $source \n] {
      incr number
      if {[regexp {::tclpdf::pdfObj +(str|hexStr|bytesStr)\M} $line]} {
        dict lappend found $name "$name:$number [string trim $line]"
      }
    }
  }
  set wrong {}
  dict for {name lines} $found {
    if {![dict exists $allowed $name]} {
      lappend wrong "$name calls pdfObj's string constructors directly and is\
          not in the list - use [my Str], [my HexStr] or [my BytesStr], or\
          add the file with the reason: [join $lines {; }]"
      continue
    }
    lassign [dict get $allowed $name] want -
    if {[llength $lines] != $want} {
      lappend wrong "$name: [llength $lines] direct calls, [list $want]\
          recorded: [join $lines {; }]"
    }
  }
  dict for {name entry} $allowed {
    if {![dict exists $found $name]} {
      lappend wrong "$name is listed with [lindex $entry 0] direct calls and\
          has none - take it out of the list"
    }
  }
  set wrong
} -result {}

cleanupTests

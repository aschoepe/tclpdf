# link.test --
#
# Links - the clickable rectangle, and the two facts PDF/UA asks about it.
#
# The interesting half of this module is not the annotation dictionary, which
# is four keys and a rectangle, but the two questions ua.tcl puts to it: does
# every link carry a description, and is every one of them inside a Link
# structure element. Both used to be answered by a regular expression over the
# serialised annotation body, and both answers were wrong in both directions -
# which is what most of this file is about.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
source [file join [file dirname [info script]] helper.tcl]
package require tclpdf::link
package require tclpdf::annot

# A tagged document with one page and a font, which is all any of these needs.
# No conformance claim: what is checked here are the facts, and ua.test checks
# what is made of them.
proc linked {} {
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  $doc font -family helvetica -size 12
  return $doc
}

# --- what counts as a description -----------------------------------------

test link-1.1 {a URL that contains the word Contents is not a description} -body {
  # The seven characters "/Contents" inside the URI used to satisfy the
  # check, because it read the serialised dictionary as text - and the text
  # of a link contains its own address. The document was written with a
  # PDF/UA claim and veraPDF rejected it under 7.18.1 and 7.18.5.
  set doc [linked]
  $doc structure Link -script {
    $doc text "Inhalt" -at {20 40}
    $doc link -at {20 36} -size {40 6} -url https://example.org/Contents
  }
  set missing [$doc linksWithoutContents]
  $doc destroy
  set missing
} -result 1

test link-1.2 {a tooltip is} -body {
  set doc [linked]
  $doc structure Link -script {
    $doc text "Inhalt" -at {20 40}
    $doc link -at {20 36} -size {40 6} -url https://example.org/Contents \
        -tooltip "example.org"
  }
  set missing [$doc linksWithoutContents]
  $doc destroy
  set missing
} -result {}

test link-1.3 {every undescribed link is listed, by the page it is on} -body {
  set doc [linked]
  $doc link -at {20 36} -size {40 6} -url https://example.org/ -tooltip t
  $doc link -at {20 46} -size {40 6} -url https://example.org/
  $doc page add
  $doc link -at {20 36} -size {40 6} -url https://example.org/
  set missing [$doc linksWithoutContents]
  $doc destroy
  set missing
} -result {1 2}

# --- what counts as a link ------------------------------------------------

test link-2.1 {a note quoting the words /Subtype /Link is not a link} -body {
  # The other direction of the same mistake: the note's own /Contents was
  # searched for the annotation's subtype, so a note that happens to talk
  # about links counted as one. The write then died with "1 link annotation
  # is not inside a Link structure element" for a link the document has not
  # got - and there was no way to word the note that did not trip it.
  set doc [linked]
  $doc annot note -at {20 40} -contents "siehe /Subtype /Link im Text"
  set answers [list [$doc linksWithoutContents] [$doc linksWithoutElement]]
  $doc destroy
  set answers
} -result {{} {}}

test link-2.2 {a real link outside a Link element is found, one inside is not} -body {
  set doc [linked]
  $doc link -at {20 26} -size {40 6} -url https://example.org/ -tooltip t
  $doc structure P -script {
    $doc text "Inhalt" -at {20 40}
    $doc link -at {20 36} -size {40 6} -url https://example.org/ -tooltip t
  }
  $doc structure Link -script {
    $doc text "Inhalt" -at {20 50}
    $doc link -at {20 46} -size {40 6} -url https://example.org/ -tooltip t
  }
  set outside [$doc linksWithoutElement]
  $doc destroy
  set outside
} -result {1 1}

test link-2.3 {the types the caller accepts are the caller's} -body {
  # UA-2 lets a Reference hold a link annotation as well, which is why
  # [linksWithoutElement] takes the list rather than knowing it.
  set doc [linked]
  $doc structure P -script {
    $doc structure Reference -script {
      $doc text "see" -at {20 40}
      $doc link -at {20 36} -size {40 6} -url https://example.org/ -tooltip t
    }
  }
  set answers [list [$doc linksWithoutElement] \
      [$doc linksWithoutElement {Link Reference}]]
  $doc destroy
  set answers
} -result {1 {}}

test link-2.4 {an untagged document is not asked which element a link joined} -body {
  # There is no tree, so there is no element to have joined; the structure
  # module may not even be loaded. Every link is outside one, and ua.tcl
  # refuses the claim over the missing tree instead.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc link -at {20 36} -size {40 6} -url https://example.org/ -tooltip t
  set outside [$doc linksWithoutElement]
  $doc destroy
  set outside
} -result 1

# --- the record itself ----------------------------------------------------

test link-3.1 {a link is recorded once, however often the document is written} -body {
  # The record is filled at the CALL, not on the write event - so a second
  # [write] must not list the same link twice. The same contract
  # [AnnotationOnPage] keeps, checked here because this record is the one
  # ua.tcl counts its message from.
  set doc [linked]
  $doc link -at {20 36} -size {40 6} -url https://example.org/
  set path [::tclpdfTest::scratch link-twice.pdf]
  $doc write $path
  set first [$doc linksWithoutContents]
  $doc write $path
  set second [$doc linksWithoutContents]
  $doc destroy
  file delete $path
  list $first $second
} -result {1 1}

test link-3.2 {a document without links answers nothing, whatever else is on it} -body {
  set doc [linked]
  $doc annot note -at {20 40} -contents "eine Notiz"
  set answers [list [$doc linksWithoutContents] [$doc linksWithoutElement]]
  $doc destroy
  set answers
} -result {{} {}}

# --- one target, and a rectangle somebody can hit --------------------------

test link-4.1 {two targets in one call are named, not silently ranked} -body {
  # [link] decided -url over -structure over -page and dropped the loser
  # without a word, so "-url ... -page 2" wrote a URL link and the caller
  # believed in a page jump. The manual says "to a URL, to a page, OR to a
  # named structure element" (:886), and now so does the call. Precedent:
  # [pattern -matrix] with -origin.
  set doc [linked]
  $doc page add
  set codes [list \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 20} -size {40 5} -url http://example.org/ -page 1}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 30} -size {40 5} -url http://example.org/ -to {10 10}}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 40} -size {40 5} -url http://example.org/ -zoom 2}]]
  set plain [catch {$doc link -at {20 50} -size {40 5} -page 1}]
  $doc destroy
  list $codes $plain
} -result {{{TCLPDF LINK ARGUMENT url} {TCLPDF LINK ARGUMENT url}\
    {TCLPDF LINK ARGUMENT url}} 0}

test link-4.2 {-structure names an element, and -to or -zoom name a page} -body {
  set doc [tclpdf new -unit mm -version 2.0 -compress 0]
  $doc tagged 1
  $doc page add
  $doc font -family helvetica -size 12
  $doc structure Sect -name intro -script {}
  set codes [list \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 20} -size {40 5} -structure intro -to {10 10}}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 30} -size {40 5} -structure intro -zoom 2}]]
  set plain [catch {$doc link -at {20 40} -size {40 5} -structure intro}]
  $doc destroy
  list $codes $plain
} -result {{{TCLPDF LINK ARGUMENT structure} {TCLPDF LINK ARGUMENT structure}} 0}

test link-4.3 {-zoom is a magnification of 0 or more, and needs a place} -body {
  # ISO 32000-1 12.3.2.2, Table 151: in an /XYZ destination a zoom of 0
  # "has the same meaning as a null value" - the magnification the reader
  # is already at - so 0 is a number to act on and below it there is none
  # to mean. [initialView] has refused it since it was written (:1188);
  # [link] wrote "/XYZ x y -1" instead. And without -to the destination is
  # /Fit, the whole page, where a magnification has no place at all.
  set doc [linked]
  set negative [::tclpdfTest::refusalCode {
    $doc link -at {20 20} -size {40 5} -page 0 -to {10 10} -zoom -1}]
  set word [::tclpdfTest::refusalCode {
    $doc link -at {20 30} -size {40 5} -page 0 -to {10 10} -zoom abc}]
  set noPlace [::tclpdfTest::refusalCode {
    $doc link -at {20 40} -size {40 5} -page 0 -zoom 2}]
  set zero [catch {$doc link -at {20 50} -size {40 5} -page 0 -to {10 10} -zoom 0}]
  $doc destroy
  list $negative $word $noPlace $zero
} -result {{TCLPDF LINK ARGUMENT zoom} {TCLPDF LINK ARGUMENT zoom}\
    {TCLPDF LINK ARGUMENT zoom} 0}

test link-4.4 {a link is nothing but its rectangle, so it needs an area} -body {
  # /Rect [x y x y] is an annotation no pointer ever reaches - and under
  # PDF/UA a "link" a screen reader announces and cannot follow. A negative
  # size writes the corners the other way round: 7.9.5 says a reader
  # normalises them, and it is a mistake at the call all the same. [image
  # place] and [form place] refuse both.
  set doc [linked]
  set codes [lmap size {{0 0} {40 0} {-5 -5} {40 -5}} {
    ::tclpdfTest::refusalCode [list $doc link -at {20 20} -size $size \
        -url http://example.org/]
  }]
  set fine [catch {$doc link -at {20 20} -size {40 5} -url http://example.org/}]
  $doc destroy
  list [lsort -unique $codes] $fine
} -result {{{TCLPDF LINK ARGUMENT size}} 0}

test link-4.5 {-at, -size and -to answer as points do everywhere} -body {
  # Until 2026-08-26 the sum below reached [expr] first: "link -at {a b}"
  # came back as "can't use non-numeric string as operand of \"+\"" with
  # errorCode ARITH DOMAIN, in Tcl's words rather than this package's.
  set doc [linked]
  set codes [list \
      [::tclpdfTest::refusalCode {
        $doc link -at {a b} -size {40 5} -url http://example.org/}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 20} -size {a b} -url http://example.org/}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {20 20} -size {40 5} -page 0 -to {1 1 1}}] \
      [::tclpdfTest::refusalCode {
        $doc link -at {NaN 20} -size {40 5} -url http://example.org/}]]
  $doc destroy
  set codes
} -result {{TCLPDF OPTION POINT -at link} {TCLPDF OPTION POINT -size link}\
    {TCLPDF OPTION POINT -to link} {TCLPDF OPTION POINT -at link}}

test link-4.6 {a refused link leaves no annotation behind} -body {
  # Every check stands before the object is reserved: a call that is turned
  # away must leave the document as it was, or the page carries half of what
  # was asked for and the caller saw an error.
  set doc [linked]
  $doc link -at {20 20} -size {40 5} -url http://example.org/ -tooltip "eins"
  set before [$doc state links]
  catch {$doc link -at {20 30} -size {0 5} -url http://example.org/}
  catch {$doc link -at {20 40} -size {40 5} -url http://example.org/ -page 0}
  catch {$doc link -at {a b} -size {40 5} -url http://example.org/}
  set after [$doc state links]
  $doc destroy
  expr {$before eq $after}
} -result 1

cleanupTests

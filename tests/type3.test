# type3.test --
#
# Type 3 fonts: glyphs that are content streams (ISO 32000-2, 9.6.4).
#
# The two things that decide whether such a font is right are invisible to
# every validator: whether the FontMatrix maps the glyph to the size that was
# asked for, and whether the width that was measured is the width that was
# drawn. Both are checked here against the file, not against the API.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::type3
# For [font info] of a Type 3 alias, which goes through the font module's
# dispatcher, and for [fontsWithoutProgram], which a PDF/A document asks.
package require tclpdf::font
source [file join [file dirname [info script]] helper.tcl]

testConstraint pdftotext [expr {[auto_execok pdftotext] ne {}}]
testConstraint pdftoppm [expr {[auto_execok pdftoppm] ne {}}]
testConstraint qpdf [expr {[auto_execok qpdf] ne {}}]

set srgbIcc [file join [file dirname [file dirname [info script]]] icc sRGB.icc]
testConstraint haveSrgbIcc [file exists $srgbIcc]

set type1Face [file join [file dirname [file dirname [info script]]] examples \
    assets fonts urw-core35-fonts NimbusSans-Regular.t1]
testConstraint haveType1 [file exists $type1Face]

# A TrueType face, for the documents that carry a drawn font AND an embedded
# one - which is the ordinary case rather than an exotic one: a Type 3 font
# exists for the characters a real face has no glyph for, so it always stands
# beside one.
set trueTypeFace [file join [file dirname [file dirname [info script]]] examples \
    assets fonts DejaVuSans.ttf]
testConstraint haveTrueType [file exists $trueTypeFace]

# The COLR face the mask count below is measured on - 25 MB and unversioned,
# so a machine without it skips rather than fails.
set colourFace [file join [file dirname [file dirname [info script]]] examples \
    assets fonts google NotoColorEmoji-Regular.ttf]
testConstraint haveColour [file exists $colourFace]

# The written objects a test looks at - the font object is the one carrying
# /Subtype /Type3. The walk itself is in helper.tcl, because a third copy of
# it is a copy too many.
proc type3Objects {doc {pattern {/Subtype /Type3}}} {
  return [::tclpdfTest::objects $doc $pattern]
}

proc type3Object {doc {pattern {/Subtype /Type3}}} {
  return [lindex [type3Objects $doc $pattern] 0]
}

# The decoded stream of the glyph for one character - what a reader executes.
proc type3Stream {doc alias char} {
  set entry [dict get [$doc state fonts] $alias]
  set code [dict get $entry codes $char]
  set writer [$doc writer]
  set name [dict get $entry glyphs $code name]
  set font [type3Object $doc]
  if {![regexp "/$name (\\d+) 0 R" $font -> number]} {
    return {}
  }
  return [::tclpdfTest::streamOf $writer $number]
}

# A document with one square glyph, which is what most of these tests need:
# the square fills the frame exactly, so its size on the page is the size the
# font matrix promises.
proc type3Square {doc alias {scale 0.001} {units 1000}} {
  $doc font define $alias -matrix [list $scale 0 0 $scale 0 0] \
      -ascent $units
  $doc font glyph $alias s -width $units -script \
      "\$doc rect -at {0 0} -size {$units $units} -fill black"
  return
}

# -- what the file holds -----------------------------------------------------

test type3-1.1 {the font dictionary carries the glyphs} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks -ascent 750
  $doc font glyph marks + -width 800 -script {
    $doc rect -at {100 335} -size {600 80} -fill black
  }
  $doc font -family marks -size 24
  $doc text "+" -at {20 40}
  set path [::tclpdfTest::scratch type3-1.1.pdf]
  $doc write $path
  set body [type3Object $doc]
  $doc destroy
  file delete $path
  list [string match {*/Type /Font*} $body] \
      [string match {*/Subtype /Type3*} $body] \
      [string match {*/CharProcs << /uni002B *} $body] \
      [string match {*/Differences \[43 /uni002B\]*} $body] \
      [string match {*/FirstChar 43*} $body] \
      [string match {*/LastChar 43*} $body] \
      [regexp {/FontMatrix \[0\.001} $body]
} -result {1 1 1 1 1 1 1}

test type3-1.2 {a glyph description starts with d0 and then draws} -body {
  # "The stream shall include as its first operator either d0 or d1"
  # (Table 110). wx is the advance in glyph space, wy shall be 0.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks x -width 640 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family marks -size 10
  $doc text "x" -at {20 40}
  set path [::tclpdfTest::scratch type3-1.2.pdf]
  $doc write $path
  set stream [type3Stream $doc marks x]
  $doc destroy
  file delete $path
  list [lindex [split $stream \n] 0] [regexp {re} $stream]
} -result {{640 0 d0} 1}

test type3-1.3 {-color text writes d1 with the box in glyph space} -body {
  # The script counts y downwards from the top of the frame, glyph space
  # counts it upwards from the baseline: with -ascent 800 a box {50 100 700
  # 500} is llx 50, lly 800-100-500 = 200, urx 750, ury 700. The four numbers
  # are deliberately all different, so a box handed through unmirrored comes
  # out as different numbers rather than by accident as the same ones.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks x -width 640 -color text -bbox {50 100 700 500} \
      -script {$doc rect -at {50 100} -size {700 500} -fill black}
  $doc font -family marks -size 10
  $doc text "x" -at {20 40}
  set path [::tclpdfTest::scratch type3-1.3.pdf]
  $doc write $path
  set stream [type3Stream $doc marks x]
  $doc destroy
  file delete $path
  lindex [split $stream \n] 0
} -result {640 0 50 200 750 700 d1}

test type3-1.4 {-color text without a box is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set code [catch {$doc font glyph marks x -width 600 -color text -script {}} err]
  $doc destroy
  list $code [string match {*-bbox*} $err] [string match {*d1*} $err]
} -result {1 1 1}

test type3-1.5 {an unknown -color word is refused, not taken as a colour} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set code [catch {$doc font glyph marks x -width 600 -color red -script {}} err]
  $doc destroy
  list $code [string match {*own*} $err] [string match {*text*} $err]
} -result {1 1 1}

test type3-1.6 {a d1 glyph may not place an image} -body {
  # Table 111 on d1: the glyph description "shall not include an image,
  # however, an image mask is acceptable". A d1 glyph declares that it
  # specifies only shape and not colour, and a reader may ignore every colour
  # operator in it - an image brings colours no operator sets, so what comes
  # out is at the reader's discretion. Measured on 2026-08-22 before this
  # refusal existed: poppler painted the picture in full colour.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc image embed photo -data [::tclpdfTest::png 2 2 8 2 \
      [binary format cH*cH* 0 ff000000ff00 0 0000ffffff00]]
  $doc font define marks -ascent 750
  set code [catch {$doc font glyph marks a -width 800 -color text \
      -bbox {0 0 800 750} -script {
        $doc image place photo -at {0 0} -width 800
      }} err]
  # And the glyph did not survive the refusal either: what was refused is not
  # in the font.
  set glyphs [dict size [dict get [$doc state fonts] marks glyphs]]
  $doc destroy
  list $code $glyphs [string match {*image mask*} $err] \
      [string match {*Table 111*} $err]
} -result {1 0 1 1}

test type3-1.7 {a stencil mask in a d1 glyph, and a picture in a d0 one} -body {
  # Both halves of the same sentence. A stencil mask has no colour of its own
  # - Table 87 forbids it a ColorSpace - and paints the colour in force, which
  # is precisely what a shape-only glyph is for, so d1 takes it. And d0 says
  # the glyph brings its own colour, so the rule does not apply there at all.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  # 0110 in one bit, four pixels wide: the two middle ones are the ink.
  $doc image embed stamp -data [::tclpdfTest::png 4 1 1 0 \
      [binary format cc 0 0x60]] -stencil 1
  $doc image embed photo -data [::tclpdfTest::png 2 2 8 2 \
      [binary format cH*cH* 0 ff000000ff00 0 0000ffffff00]]
  $doc font define marks -ascent 750
  set stencil [catch {$doc font glyph marks a -width 800 -color text \
      -bbox {0 0 800 750} -script {
        $doc image place stamp -at {0 0} -width 800
      }} first]
  set own [catch {$doc font glyph marks b -width 800 -script {
        $doc image place photo -at {0 0} -width 800
      }} second]
  $doc destroy
  list $stencil $own
} -result {0 0}

# -- the font matrix ---------------------------------------------------------

test type3-2.1 {the same glyph at three matrices measures the same} -body {
  # 1000 units at 0.001, 2000 at 0.0005, 500 at 0.002 - all one em, so all
  # the same advance at the same size. A font that is out by a factor of 1000
  # is a mistake no validator reports.
  set doc [tclpdf new -unit pt]
  $doc page add
  type3Square $doc thousand 0.001 1000
  type3Square $doc twoThousand 0.0005 2000
  type3Square $doc fiveHundred 0.002 500
  set widths {}
  foreach alias {thousand twoThousand fiveHundred} {
    lappend widths [format %.4f [$doc textWidth s -family $alias -size 72]]
  }
  lappend widths [format %.4f [$doc textWidth s -family thousand -size 36]]
  $doc destroy
  set widths
} -result {72.0000 72.0000 72.0000 36.0000}

test type3-2.2 {and comes out the same size on the page} \
    -constraints pdftoppm -body {
  # Measured in PIXELS, because the arithmetic above and the arithmetic in
  # the file are the same arithmetic: only a renderer says whether the glyph
  # really covers one inch at 72 pt.
  # In MILLIMETRES, and that is the second half of the measurement: the
  # drawing methods write the document unit converted to points, so without
  # the "cm" in front of the glyph every square would come out 2.83 times too
  # large - and the arithmetic above would still say 72.
  set doc [tclpdf new -unit mm]
  $doc page add -format {100 100}
  type3Square $doc thousand 0.001 1000
  type3Square $doc twoThousand 0.0005 2000
  type3Square $doc fiveHundred 0.002 500
  set x 5
  foreach alias {thousand twoThousand fiveHundred} {
    $doc font -family $alias -size 72
    $doc text s -at [list $x 50]
    incr x 30
  }
  set path [::tclpdfTest::scratch type3-2.2.pdf]
  $doc write $path
  $doc destroy
  set stem [::tclpdfTest::scratch type3-2.2]
  exec pdftoppm -r 72 -gray -singlefile $path $stem
  set channel [open $stem.pgm]
  fconfigure $channel -translation binary
  set bytes [read $channel]
  close $channel
  file delete $path $stem.pgm
  # P5, three header numbers, then one byte per pixel.
  regexp {^P5\s+(\d+)\s+(\d+)\s+(\d+)\s} $bytes -> width height max
  set start [string length [lindex [regexp -inline \
      {^P5\s+\d+\s+\d+\s+\d+\s} $bytes] 0]]
  # The columns that carry any dark pixel, grouped into runs - one run per
  # square - and the height of each run.
  set dark {}
  for {set column 0} {$column < $width} {incr column} {
    set rows {}
    for {set row 0} {$row < $height} {incr row} {
      binary scan $bytes @[expr {$start + $row * $width + $column}]cu value
      if {$value < 128} {
        lappend rows $row
      }
    }
    if {[llength $rows]} {
      lappend dark [list $column [llength $rows]]
    }
  }
  set boxes {}
  set run {}
  set previous {}
  foreach entry $dark {
    lassign $entry column rows
    if {$previous ne {} && $column != $previous + 1} {
      lappend boxes [list [llength $run] [lindex $run 0]]
      set run {}
    }
    lappend run $rows
    set previous $column
  }
  lappend boxes [list [llength $run] [lindex $run 0]]
  set boxes
} -result {{72 72} {72 72} {72 72}}

test type3-2.3 {a matrix that scales nowhere is refused} -body {
  set doc [tclpdf new -unit mm]
  set results {}
  foreach matrix {{0 0 0 0.001 0 0} {-0.001 0 0 0.001 0 0}} {
    lappend results [catch {$doc font define bad -matrix $matrix}]
  }
  lappend results [catch {$doc font define bad -matrix {0.001 0 0}}]
  lappend results [catch {$doc font define bad -matrix {a 0 0 0.001 0 0}}]
  $doc destroy
  set results
} -result {1 1 1 1}

test type3-2.4 {a matrix that is not invertible is refused} -body {
  # A font matrix maps glyph space to text space, and a mapping has to be
  # invertible or every glyph collapses onto a line or a point. a > 0 rules
  # out the common degenerate case and nothing else: a vertical scale of zero
  # and a shear that folds the vertical axis away both passed it, and both
  # write a FontMatrix no reader can lay text out with.
  #
  # THE LAST ONE is the reason the determinant is taken on the ROUNDED
  # numbers: the FontMatrix goes into the file with six decimal places, so a
  # positive scale below 5e-7 is written as a zero, and the file then carries
  # a singular matrix that no validator objects to while the API never saw
  # one.
  set doc [tclpdf new -unit mm]
  set results {}
  foreach matrix {{0.001 0 0 0 0 0} {0.001 0.001 0.001 0.001 0 0}
      {0.0000001 0 0 0.0000001 0 0}} {
    lappend results [catch {$doc font define bad -matrix $matrix} err]
  }
  # And what IS invertible goes through, a mirrored vertical axis included:
  # d below zero turns the glyph over, which is a mapping like any other.
  lappend results [catch {$doc font define fine -matrix {0.001 0 0 -0.001 0 0}}]
  $doc destroy
  lappend results [string match {*singular*} $err]
} -result {1 1 1 0 1}

test type3-2.5 {the ascent is measured against the VERTICAL scale} -body {
  # The ascent is a height, so it maps to text space through matrix[3] and
  # not through matrix[0], which is what turns a WIDTH into an advance. The
  # two are equal in every diagonal matrix, so only a font whose scales
  # differ can tell them apart - and the default ascent hid the mistake
  # completely, because 0.8/matrix[0] scaled by matrix[0] gives 0.8 whichever
  # factor is used. So the ascent is stated here.
  #
  # 500 glyph units at a vertical scale of 0.002 and 20 pt is 20 pt; through
  # the horizontal 0.001 it would be 10.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -matrix {0.001 0 0 0.002 0 0} -ascent 500
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 20
  $doc text "a" -at {20 100} -anchor baseline
  $doc text "a" -at {20 100} -anchor top
  set ys [::tclpdfTest::starts [::tclpdfTest::content $doc 0] y]
  # The default ascent takes the same factor: 0.8 of the VERTICAL em, which
  # at 0.002 is 400 glyph units rather than the 800 the horizontal would give.
  $doc font define other -matrix {0.001 0 0 0.002 0 0}
  set default [dict get [$doc state fonts] other ascent]
  $doc destroy
  list [format %.2f [expr {[lindex $ys 0] - [lindex $ys 1]}]] \
      [format %.1f $default]
} -result {20.00 400.0}

# -- measuring and drawing agree ---------------------------------------------

test type3-3.1 {textWidth is the sum of the Widths array} -body {
  # The defect this guards against has happened once already, in textPath: it
  # measured with kerning and drew without. Here the two roads have to answer
  # the same because they are the same road.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  foreach {char width} {a 300 b 700 c 1000} {
    $doc font glyph marks $char -width $width -script \
        "\$doc rect -at {0 0} -size {$width 400} -fill black"
  }
  $doc font -family marks -size 10
  $doc text "abc" -at {20 40}
  set measured [$doc textWidth "abc"]
  set path [::tclpdfTest::scratch type3-3.1.pdf]
  $doc write $path
  set body [type3Object $doc]
  regexp {/FirstChar (\d+)} $body -> first
  set widths {}
  if {[regexp {(\d+) 0 R} [lindex [regexp -inline {/Widths (\d+ 0 R)} $body] 1] \
      -> number]} {
    regexp {\[(.*)\]} [[$doc writer] body $number] -> widths
  }
  $doc destroy
  file delete $path
  # a is 97, b 98, c 99, and FirstChar is 97: the array is the three widths
  # in order, and 10 pt through a 0.001 matrix makes 20 points of text.
  list [format %.4f $measured] $first [regexp -all -inline -- {[0-9]+} $widths]
} -result {20.0000 97 {300 700 1000}}

test type3-3.2 {the drawn string is the codes the encoding names} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks
  $doc font glyph marks A -width 600 -script {}
  $doc font glyph marks B -width 600 -script {}
  $doc font -family marks -size 12
  $doc text "AB" -at {20 30}
  set stream [::tclpdfTest::content $doc 0]
  $doc destroy
  ::tclpdfTest::shows $stream
} -result {(AB)}

test type3-3.3 {word spacing goes out as Tw, not as a TJ array} -body {
  # A Type 3 font is addressed by single bytes, so byte 32 stands alone and
  # Tw reaches it. Taken for a glyph-addressed face it would write neither -
  # the Tw is suppressed for those and the adjustment goes into a TJ array
  # that [TextShow] never builds here.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font glyph marks " " -width 400 -script {}
  $doc font -family marks -size 12 -wordSpacing 5
  $doc text "a a" -at {20 30}
  set stream [::tclpdfTest::content $doc 0]
  $doc destroy
  list [regexp {5 Tw} $stream] [regexp {TJ} $stream]
} -result {1 0}

test type3-3.4 {and an embedded Type 1 face gets its Tw back too} \
    -constraints haveType1 -body {
  # The same defect, one kind over: an embedded Type 1 face is single-byte as
  # well and used to take the TJ road, where [TextShow] writes a plain Tj -
  # so the word spacing was measured and never drawn. Measured on the stream
  # before 2026-08-21: no Tw at all.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed t1 $::type1Face
  $doc font -family t1 -size 12 -wordSpacing 5
  $doc text "a b" -at {20 30}
  set stream [::tclpdfTest::content $doc 0]
  $doc destroy
  list [regexp {5 Tw} $stream] [regexp {TJ} $stream]
} -result {1 0}

test type3-3.5 {-anchor top hangs the line from the type 3 ascent} -body {
  # The ascent of a drawn font is the frame its glyphs were drawn in, through
  # the same scale as a width: 800 units at 0.001 and 20 pt is 16 pt.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 20
  $doc text "a" -at {20 100} -anchor baseline
  $doc text "a" -at {20 100} -anchor top
  set ys [::tclpdfTest::starts [::tclpdfTest::content $doc 0] y]
  $doc destroy
  format %.2f [expr {[lindex $ys 0] - [lindex $ys 1]}]
} -result {16.00}

# -- the encoding ------------------------------------------------------------

test type3-4.1 {a character in the encoding's range keeps its own code} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks A -width 600 -script {}
  $doc font glyph marks ÿ -width 600 -script {}
  set codes [dict get [$doc state fonts] marks codes]
  $doc destroy
  list [dict get $codes A] [dict get $codes ÿ]
} -result {65 255}

test type3-4.2 {a character outside it takes the highest free code} -body {
  # 256 slots, and U+2713 does not fit in any of them by its own number.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks ✓ -width 600 -script {}
  $doc font glyph marks ✗ -width 600 -script {}
  set codes [dict get [$doc state fonts] marks codes]
  $doc destroy
  list [dict get $codes ✓] [dict get $codes ✗]
} -result {255 254}

test type3-4.3 {and does not take one that is already spoken for} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks ÿ -width 600 -script {}
  $doc font glyph marks ✓ -width 600 -script {}
  set codes [dict get [$doc state fonts] marks codes]
  $doc destroy
  list [dict get $codes ÿ] [dict get $codes ✓]
} -result {255 254}

test type3-4.4 {the glyph name says what the glyph is for} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set names [list [$doc font glyph marks A -width 600 -script {}] \
      [$doc font glyph marks ✓ -width 600 -script {}] \
      [$doc font glyph marks ✗ -width 600 -name cross -script {}]]
  $doc destroy
  set names
} -result {uni0041 uni2713 cross}

test type3-4.5 {a character or a name given twice is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks A -width 600 -name one -script {}
  set again [catch {$doc font glyph marks A -width 600 -script {}} first]
  set name [catch {$doc font glyph marks B -width 600 -name one -script {}} second]
  $doc destroy
  list $again [string match {*U+0041*} $first] $name \
      [string match {*"one"*} $second]
} -result {1 1 1 1}

test type3-4.6 {a name that is not a name is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set results {}
  foreach name {{a b} a/b a(b {<x>}} {
    lappend results [catch {$doc font glyph marks A -width 600 -name $name \
        -script {}}]
  }
  $doc destroy
  set results
} -result {1 1 1 1}

test type3-4.7 {a character the font has no glyph for carries the error code} -body {
  # The same -errorcode every other missing glyph carries, so one handler
  # covers a standard face, an embedded face and a drawn one.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 12
  set code [catch {$doc text "aXa" -at {20 30}} message options]
  $doc destroy
  list $code [dict get $options -errorcode]
} -result {1 {TCLPDF FONT GLYPH U+0058 1 marks}}

test type3-4.8 {the three characters that never reach a font} -body {
  # A soft hyphen, a zero width space and a byte order mark: offers and
  # marks, not characters to set - the same rule afm.tcl and font.tcl follow.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 12
  $doc text "a­a​a﻿" -at {20 30}
  set width [$doc textWidth "a­a​a﻿"]
  set stream [::tclpdfTest::content $doc 0]
  $doc destroy
  # Three glyphs of 600 units at 0.001 and 12 pt: 21.6 pt, which is
  # 7.62 mm - the three marks contribute nothing to either number.
  list [::tclpdfTest::shows $stream] [format %.4f $width]
} -result {(aaa) 7.6200}

test type3-4.9 {right to left is refused with the encoding named} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  set code [catch {$doc text "a" -at {20 30} -family marks -direction rtl} err]
  $doc destroy
  list $code [string match {*Differences*} $err]
} -result {1 1}

# A character beyond the BMP, built from its UTF-8 bytes and NOT written as
# \U0001F600: that escape yields U+FFFD under Tcl 8.6 - measured on
# 2026-08-21 with 8.6.18 - and every test using it would silently be about
# the replacement character instead.
set type3Astral [encoding convertfrom utf-8 \xF0\x9F\x98\x80]

test type3-4.11 {a character beyond the BMP is ONE character under both interpreters} -body {
  # Tcl 8.6 stores such a character as a surrogate pair, where [string
  # length] answers 2 - which used to refuse under 8.6 every character
  # [font glyph] took under 9. Measured against a colour emoji face:
  # 1314 of its 1499 characters lie beyond the BMP.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set name [$doc font glyph marks $type3Astral -width 600 -script {}]
  set codes [dict get [$doc state fonts] marks codes]
  $doc destroy
  list $name [dict get $codes $type3Astral]
} -result {u1F600 255}

test type3-4.12 {and the same character reaches that glyph when it is set} -body {
  # The other half: the code that draws has to find the glyph the code that
  # defined it stored, under both interpreters. The ToUnicode entry is the
  # assertion that says which glyph was reached - U+1F600 goes into a
  # UTF-16 map as the surrogate pair D83D DE00.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks $type3Astral -width 600 -script {}
  $doc font -family marks -size 12
  $doc text $type3Astral -at {20 30}
  set width [$doc textWidth $type3Astral]
  set path [::tclpdfTest::scratch type3-4.12.pdf]
  $doc write $path
  set body [type3Object $doc]
  regexp {/ToUnicode (\d+) 0 R} $body -> number
  set map [::tclpdfTest::streamOf [$doc writer] $number]
  $doc destroy
  file delete $path
  # 600 units at 0.001 and 12 pt: 7.2 pt, which is 2.54 mm.
  list [regexp {/Differences \[255 /u1F600\]} $body] \
      [regexp {<FF> <D83DDE00>} $map] [format %.4f $width]
} -result {1 1 2.5400}

# -- the script --------------------------------------------------------------

test type3-5.1 {the script runs in the caller's frame} -body {
  # [form create] uses "uplevel #0" and cannot see a document in a local
  # variable; [layer draw] and this take the caller's frame. Measured under
  # both interpreters on 2026-08-21.
  proc type3Local {} {
    set doc [tclpdf new -unit mm -compress 0]
    $doc page add
    $doc font define marks -ascent 800
    $doc font glyph marks a -width 600 -script {
      $doc rect -at {0 0} -size {600 800} -fill black
    }
    $doc font -family marks -size 12
    $doc text "a" -at {20 30}
    set path [::tclpdfTest::scratch type3-5.1.pdf]
    $doc write $path
    set stream [type3Stream $doc marks a]
    $doc destroy
    file delete $path
    return $stream
  }
  set stream [type3Local]
  rename type3Local {}
  regexp {re} $stream
} -result 1

test type3-5.2 {the glyph is drawn in glyph units whatever the document unit} -body {
  # The drawing methods write the document unit converted to points, so a
  # document in mm gets a "cm" in front of the glyph that scales those points
  # back - without it the same script would draw the glyph 2.83 times too
  # large. A document in pt needs none and gets none.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  type3Square $doc points
  $doc font -family points -size 10
  $doc text "s" -at {20 40}
  set path [::tclpdfTest::scratch type3-5.2a.pdf]
  $doc write $path
  set inPoints [type3Stream $doc points s]
  $doc destroy
  file delete $path

  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  type3Square $doc millimetres
  $doc font -family millimetres -size 10
  $doc text "s" -at {20 40}
  set path [::tclpdfTest::scratch type3-5.2b.pdf]
  $doc write $path
  set inMillimetres [type3Stream $doc millimetres s]
  $doc destroy
  file delete $path

  # Both must paint the same square in glyph space: 0 0 1000 1000.
  list [regexp {cm} $inPoints] \
      [regexp {^0\.352778 0 0 0\.352778 0 0 cm$} \
          [lindex [split $inMillimetres \n] 1]] \
      [regexp {0 0 1000 1000 re} $inPoints] \
      [regexp {2834\.6.* 2834\.6.* re} $inMillimetres]
} -result {0 1 1 1}

test type3-5.3 {a script that fails leaves no half glyph behind} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set code [catch {$doc font glyph marks a -width 600 -script {
    error "no"
  }}]
  # The canvas has to be back where it was, or everything drawn afterwards
  # would go into the glyph instead of onto the page.
  set depth [$doc canvas depth]
  set glyphs [dict size [dict get [$doc state fonts] marks glyphs]]
  $doc destroy
  list $code $depth $glyphs
} -result {1 0 0}

test type3-5.4 {a glyph may be drawn while a form is being built} -body {
  # The canvas stack nests: [FormBegin] pushes on top of whatever is there and
  # [FormEnd] pops its own. Without that the glyph would collect the form's
  # content, or the form the glyph's.
  set ::type3Doc [tclpdf new -unit mm -compress 0]
  $::type3Doc page add
  $::type3Doc font define marks -ascent 800
  # [form create] runs its script at the global level, hence the global
  # variable - which is the difference this file's own -script does not have.
  $::type3Doc form create block -size {40 20} -script {
    set ::type3Inside [$::type3Doc font glyph marks a -width 600 -script {
      $::type3Doc rect -at {0 0} -size {600 800} -fill black
    }]
    $::type3Doc rect -at {0 0} -size {40 20} -fill blue
  }
  $::type3Doc form place block -at {10 10}
  set glyphs [dict size [dict get [$::type3Doc state fonts] marks glyphs]]
  # The stack is back where it was: the glyph took its own canvas and the
  # form kept its own, or everything after this would go into the wrong one.
  set depth [$::type3Doc canvas depth]
  # And the two streams did not run into each other: the form has the blue
  # rectangle, the glyph the black square.
  set form [::tclpdfTest::content $::type3Doc 0]
  $::type3Doc destroy
  list $::type3Inside $glyphs $depth [regexp {XO1 Do} $form]
} -result {uni0061 1 0 1}

# -- resources ---------------------------------------------------------------

test type3-6.1 {what a glyph uses lands in the font's own Resources} -body {
  # 7.8.3: "Content streams that define the glyph descriptions of a Type 3
  # font shall include a Resources entry in the Type 3 font dictionary
  # specifying all the resources used by all the content streams in the
  # CharProcs dictionary of a Type 3 font."
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 800 -script {
    $doc rect -at {0 0} -size {800 800} -fill blue -opacity 0.5
  }
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  set path [::tclpdfTest::scratch type3-6.1.pdf]
  $doc write $path
  set body [type3Object $doc]
  $doc destroy
  file delete $path
  regexp {/Resources << /ExtGState << /GS\S+ \d+ 0 R >> >>} $body
} -result 1

test type3-6.2 {and nothing else does} -body {
  # The shortcut - pointing at the one shared resource dictionary, as a form
  # XObject may - puts the font inside itself. Measured with veraPDF 1.30.2
  # on 2026-08-21: StackOverflowError, no report at all, while qpdf and
  # poppler said nothing.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 800 -script {
    $doc rect -at {0 0} -size {800 800} -fill black
  }
  $doc font -family helvetica -size 12
  $doc text "the page uses a standard face too" -at {20 20}
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  set path [::tclpdfTest::scratch type3-6.2.pdf]
  $doc write $path
  set body [type3Object $doc]
  $doc destroy
  file delete $path
  # No font in it, and above all not this one.
  list [regexp {/Resources << >>} $body] \
      [regexp {/Resources << /Font} $body]
} -result {1 0}

test type3-6.3 {a glyph set in its own font is refused} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 800 -script {
    $doc rect -at {0 0} -size {800 800} -fill black
  }
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  # Now a glyph that sets text in the font it belongs to - a description that
  # invokes itself, which no reader can end.
  $doc font glyph marks b -width 800 -script {
    $doc text "a" -at {0 800} -family marks -size 400
  }
  set result [::tclpdfTest::writes $doc type3-6.3.pdf]
  $doc destroy
  set result
} -result {1 0}

test type3-6.4 {a resource name that has to be escaped still reaches Resources} -body {
  # The names are read back out of the WRITTEN glyph stream, where [pdfObj
  # name] has already escaped them: a separation the caller named "Pantone
  # 877 C" stands there as /Pantone#20877#20C. The resource dictionary is
  # keyed by the raw name, so the raw key was matched against the escaped
  # stream name, found nothing, and every resource whose name carried a space
  # or a delimiter fell out of the font's /Resources - against 7.8.3, which
  # asks for ALL the resources the glyph streams use, and 9.6.4 step d, which
  # is where a reader looks them up.
  #
  # Not a curiosity: the name comes from the CALLER - a separation, an ICC
  # space, a font alias - and a space in it is ordinary. Measured 2026-08-22
  # as a PDF/A-3B document: veraPDF isCompliant false before, true after.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 750
  $doc font glyph marks + -width 800 -script {
    $doc rect -at {100 100} -size {600 600} \
        -fill {separation "Pantone 877 C" {cmyk 0 0 0 0.2} 0.8}
  }
  $doc font -family marks -size 200
  $doc text "+" -at {60 400}
  set path [::tclpdfTest::scratch type3-6.4.pdf]
  $doc write $path
  set body [type3Object $doc]
  set stream [type3Stream $doc marks +]
  $doc destroy
  file delete $path
  # The stream names it escaped, and the font's own Resources carry it under
  # the same spelling.
  list [regexp {/Pantone#20877#20C cs} $stream] \
      [regexp {/ColorSpace << /Pantone#20877#20C \d+ 0 R >>} $body]
} -result {1 1}

test type3-6.5 {and the self-reference is still caught through an escaped alias} -body {
  # The same escaping used to walk past the check above this one: a font
  # aliased "a b" is registered as the resource "T3a b" and written /T3a#20b,
  # so the stream name never matched the raw key, the entry was skipped, and
  # with it the refusal - what came out was a dangling /T3a#20b reference to
  # an object the font's Resources did not carry. The alias without the space
  # was refused all along, which is what makes this a one-character
  # difference between a refusal and a broken file.
  set results {}
  foreach alias {ab {a b}} {
    set doc [tclpdf new -unit pt -compress 0]
    $doc page add
    $doc font define $alias -ascent 800
    $doc font glyph $alias X -width 800 -script {
      $doc rect -at {0 0} -size {500 500} -fill black
    }
    $doc font -family $alias -size 40
    $doc text "X" -at {20 40}
    # A glyph that sets text in the font it belongs to.
    $doc font glyph $alias Y -width 800 -script "
      \$doc font -family [list $alias] -size 100
      \$doc text \"X\" -at {0 700}
    "
    lappend results [lindex [::tclpdfTest::writes $doc type3-6.5.pdf] 0]
    $doc destroy
  }
  set results
} -result {1 1}

# -- writing -----------------------------------------------------------------

test type3-7.1 {a font defined and never used writes no object} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font -family helvetica -size 12
  $doc text "no type 3 here" -at {20 30}
  set path [::tclpdfTest::scratch type3-7.1.pdf]
  $doc write $path
  set body [type3Object $doc]
  $doc destroy
  file delete $path
  set body
} -result {}

test type3-7.2 {a font used with no glyphs at all is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  # An empty string still writes its show operator, so the font becomes a
  # resource and reserves its object - and then has nothing to write.
  $doc text "" -at {20 30} -family marks -size 12
  set result [::tclpdfTest::writes $doc type3-7.2.pdf]
  $doc destroy
  set result
} -result {1 0}

test type3-7.3 {the same document written twice is the same bytes} -body {
  # The write events fire on every write: a builder that adds objects instead
  # of filling reserved ones grows the file each time, and the earlier glyphs
  # are then referenced by nothing.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 600 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  lassign [::tclpdfTest::writeTwice $doc type3-7.3] first second
  $doc destroy
  list [string equal $first $second] \
      [regexp -all {/Subtype /Type3} $second]
} -result {1 1}

test type3-7.4 {the ToUnicode map is one byte wide} -body {
  # A Type 3 font is addressed by single bytes. A two-byte codespace, which
  # is what the Identity-H road needs, maps nothing at all here - and no
  # validator says a word about it.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks ✓ -width 600 -name qqzz -script {}
  $doc font -family marks -size 12
  $doc text "✓" -at {20 30}
  set path [::tclpdfTest::scratch type3-7.4.pdf]
  $doc write $path
  set body [type3Object $doc]
  regexp {/ToUnicode (\d+) 0 R} $body -> number
  set map [::tclpdfTest::streamOf [$doc writer] $number]
  $doc destroy
  file delete $path
  list [regexp {<00> <FF>} $map] [regexp {<FF> <2713>} $map]
} -result {1 1}

test type3-7.5 {the descriptor says what a Type 3 descriptor has to say} -body {
  # Table 120: FontBBox, Ascent, Descent, CapHeight and StemV are "required
  # EXCEPT for Type 3 fonts". What is left is Type, FontName, Flags and
  # ItalicAngle, and the flags say symbolic - the encoding is this font's own.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  set path [::tclpdfTest::scratch type3-7.5.pdf]
  $doc write $path
  set body [type3Object $doc /FontDescriptor]
  regexp {/FontDescriptor (\d+) 0 R} [type3Object $doc] -> number
  set descriptor [[$doc writer] body $number]
  $doc destroy
  file delete $path
  list [regexp {/Type /FontDescriptor} $descriptor] \
      [regexp {/FontName /marks} $descriptor] \
      [regexp {/Flags 4} $descriptor] \
      [regexp {/FontBBox} $descriptor]
} -result {1 1 1 0}

test type3-7.6 {no font bounding box is claimed unless one is stated} -body {
  # Table 110: "If all four elements of the rectangle are zero, a PDF
  # processor shall make no assumptions about glyph sizes based on the font
  # bounding box. If any element is non-zero, the font bounding box shall be
  # accurate."
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define plain
  $doc font glyph plain a -width 600 -script {}
  $doc font define stated -ascent 800 -bbox {0 0 700 900}
  $doc font glyph stated a -width 600 -script {}
  $doc font -family plain -size 12
  $doc text "a" -at {20 30}
  $doc font -family stated -size 12
  $doc text "a" -at {20 40}
  set path [::tclpdfTest::scratch type3-7.6.pdf]
  $doc write $path
  set boxes {}
  foreach body [type3Objects $doc] {
    regexp {/FontBBox \[([^\]]*)\]} $body -> box
    lappend boxes [regexp -all -inline -- {-?[0-9.]+} $box]
  }
  $doc destroy
  file delete $path
  # -bbox {0 0 700 900} in a frame of 800 above the baseline: llx 0,
  # lly 800-0-900 = -100, urx 700, ury 800.
  lsort $boxes
} -result {{0 -100 700 800} {0 0 0 0}}

# -- beside an embedded face -------------------------------------------------
#
# A drawn font and an embedded one share ONE state dictionary, and each module
# writes its own entries out of it on the same event. Every test above writes
# documents whose only font is drawn, so nothing ever asked what the font
# module does when it walks past an entry that is not its own: it took it for
# an sfnt face and died on [dict get $entry parsed] with a bare Tcl "key
# \"parsed\" not known in dictionary". These write the file - the fault is at
# write time and is invisible to a test that only reads the content stream.

test type3-7.7 {a drawn font and an embedded face in one document} \
    -constraints haveTrueType -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed body $::trueTypeFace
  $doc font define marks -ascent 800
  $doc font glyph marks ✓ -width 600 -script {
    $doc path -segments {{move 60 300} {line 240 480} {line 540 120}} \
        -stroke black -width 90
  }
  $doc font -family body -size 12
  $doc text "an embedded face" -at {20 30}
  $doc font -family marks -size 12
  $doc text "✓" -at {20 40}
  set path [::tclpdfTest::scratch type3-7.7.pdf]
  $doc write $path
  # Both fonts as OBJECTS in the file, not just a write that did not throw:
  # the drawn one with its glyph streams, the embedded one with its program.
  set drawn [type3Object $doc]
  set embedded [lindex [::tclpdfTest::objects $doc {/Subtype /Type0}] 0]
  set program [::tclpdfTest::objects $doc /FontFile2]
  set size [file size $path]
  $doc destroy
  file delete $path
  list [string match {*/CharProcs*} $drawn] \
      [string match {*/Encoding /Identity-H*} $embedded] \
      [llength $program] [expr {$size > 0}]
} -result {1 1 1 1}

test type3-7.8 {and the other way round - the drawn font defined first} \
    -constraints haveTrueType -body {
  # The two modules hook the same event, and which one runs first follows the
  # order the fonts were created in. Both orders have to write both fonts.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks ✓ -width 600 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font embed body $::trueTypeFace
  $doc font -family marks -size 12
  $doc text "✓" -at {20 30}
  $doc font -family body -size 12
  $doc text "an embedded face" -at {20 40}
  set path [::tclpdfTest::scratch type3-7.8.pdf]
  $doc write $path
  set result [list [llength [type3Objects $doc]] \
      [llength [::tclpdfTest::objects $doc {/Subtype /Type0}]] \
      [llength [::tclpdfTest::objects $doc /FontFile2]]]
  $doc destroy
  file delete $path
  set result
} -result {1 1 1}

test type3-7.9 {a drawn font beside an embedded Type 1 face} \
    -constraints haveType1 -body {
  # The third kind of entry in the same dictionary, and the one whose road the
  # font module tested for by name.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed body $::type1Face
  $doc font define marks -ascent 800
  $doc font glyph marks ✓ -width 600 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family body -size 12
  $doc text "an embedded face" -at {20 30}
  $doc font -family marks -size 12
  $doc text "✓" -at {20 40}
  set path [::tclpdfTest::scratch type3-7.9.pdf]
  $doc write $path
  set result [list [llength [type3Objects $doc]] \
      [llength [::tclpdfTest::objects $doc /FontFile]]]
  $doc destroy
  file delete $path
  set result
} -result {1 1}

test type3-7.10 {such a document is written twice the same} \
    -constraints haveTrueType -body {
  # The idempotence of 7.3, with the second module writing as well: a slot
  # taken twice would show up as a second set of objects here first.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed body $::trueTypeFace
  $doc font define marks -ascent 800
  $doc font glyph marks ✓ -width 600 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family body -size 12
  $doc text "an embedded face" -at {20 30}
  $doc font -family marks -size 12
  $doc text "✓" -at {20 40}
  lassign [::tclpdfTest::writeTwice $doc type3-7.10] first second
  $doc destroy
  list [string equal $first $second] \
      [regexp -all {/Subtype /Type3} $second] \
      [regexp -all {/FontFile2} $second]
} -result {1 1 1}

test type3-7.11 {qpdf finds nothing wrong with the mixed document} \
    -constraints {qpdf haveTrueType} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed body $::trueTypeFace
  $doc font define marks -ascent 800
  $doc font glyph marks ✓ -width 600 -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family body -size 12
  $doc text "an embedded face" -at {20 30}
  $doc font -family marks -size 12
  $doc text "✓" -at {20 40}
  set path [::tclpdfTest::scratch type3-7.11.pdf]
  $doc write $path
  $doc destroy
  set code [catch {exec qpdf --check $path 2>@1} report]
  file delete $path
  list $code [string match {*No syntax or stream encoding errors*} $report]
} -result {0 1}

# -- what the outside world makes of it --------------------------------------

test type3-8.1 {the text comes back out} -constraints pdftotext -body {
  # Without /ToUnicode it does not: measured on 2026-08-21 with poppler
  # 26.08.0, the same file with the key removed and a glyph name no list
  # knows extracted the two check marks as U+00FF, the raw character code.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks ✓ -width 700 -name qqzz -script {
    $doc line -from {100 500} -to {300 700} -stroke black -width 90
    $doc line -from {300 700} -to {600 200} -stroke black -width 90
  }
  $doc font -family marks -size 20
  $doc text "✓✓" -at {20 40}
  set path [::tclpdfTest::scratch type3-8.1.pdf]
  $doc write $path
  $doc destroy
  set text [exec pdftotext $path -]
  file delete $path
  string trim $text
} -result "✓✓"

test type3-8.2 {qpdf finds nothing wrong with the file} -constraints qpdf -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks a -width 600 -color text -bbox {0 0 600 800} -script {
    $doc rect -at {0 0} -size {600 800} -fill black
  }
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  set path [::tclpdfTest::scratch type3-8.2.pdf]
  $doc write $path
  $doc destroy
  set code [catch {exec qpdf --check $path 2>@1} report]
  file delete $path
  list $code [string match {*No syntax or stream encoding errors*} $report]
} -result {0 1}

test type3-8.3 {a drawn font keeps a PDF/A declaration} \
    -constraints {haveTdom haveSrgbIcc} -body {
  # Type 3 is allowed in PDF/A and the question of embedding does not arise:
  # the glyphs ARE the file. What did arise is the package's own check, which
  # walks every font resource for a /FontFile - a Type 3 font has none and
  # can have none.
  set doc [tclpdf new -unit mm]
  $doc info Title "Type 3 under PDF/A"
  $doc page add
  $doc font define marks -ascent 750
  $doc font glyph marks + -width 800 -script {
    $doc rect -at {100 335} -size {600 80} -fill black
  }
  $doc font -family marks -size 24 -color {0 0 0}
  $doc text "+" -at {20 40}
  $doc pdfa -part 3 -conformance B -profile $::srgbIcc
  set path [::tclpdfTest::scratch type3-8.3.pdf]
  set code [catch {$doc write $path}]
  set missing [$doc fontsWithoutProgram]
  set report [::tclpdfTest::verapdf $path 3b]
  $doc destroy
  file delete $path
  list $code $missing $report
} -result {0 {} ok}

# -- what the state and the reports say ---------------------------------------

test type3-9.1 {font names and font info answer for a drawn font} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks -matrix {0.0005 0 0 0.0005 0 0}
  $doc font glyph marks a -width 600 -script {}
  $doc font glyph marks b -width 600 -script {}
  set info [$doc font info marks]
  set names [$doc font names]
  $doc destroy
  list $names [dict get $info family] [dict get $info glyphs] \
      [dict get $info unitsPerEm] [dict get $info fsType]
} -result {marks marks 2 2000.0 {}}

test type3-9.2 {an alias that is already taken is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  set code [catch {$doc font define marks} err]
  $doc destroy
  list $code [string match {*already exists*} $err]
} -result {1 1}

test type3-9.3 {a glyph for a font that is not a drawn one is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set unknown [catch {$doc font glyph nowhere a -width 600 -script {}} first]
  $doc destroy
  list $unknown [string match {*font define*} $first]
} -result {1 1}

test type3-4.10 {an encoding holds 255 glyphs and no more} -body {
  # Single bytes, and code 0 is not handed out: 255 slots. The 256th glyph is
  # refused rather than silently overwriting one.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  for {set code 1} {$code <= 255} {incr code} {
    $doc font glyph marks [format %c $code] -width 600 -script {}
  }
  set full [catch {$doc font glyph marks ✓ -width 600 -script {}} err]
  set count [dict size [dict get [$doc state fonts] marks glyphs]]
  $doc destroy
  list $count $full [string match {*255 glyphs*} $err]
} -result {255 1 1}

test type3-9.5 {the package's own font check knows a Type 3 font} -body {
  # It walks the font resources for a /FontFile - and a Type 3 font has none
  # and can have none, because its glyphs ARE the file (9.6.4). Without the
  # exemption a drawn font ruled out every PDF/A and PDF/UA document.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  $doc font glyph marks a -width 600 -script {}
  $doc font -family marks -size 12
  $doc text "a" -at {20 30}
  set path [::tclpdfTest::scratch type3-9.5.pdf]
  $doc write $path
  set missing [$doc fontsWithoutProgram]
  $doc destroy
  file delete $path
  set missing
} -result {}

test type3-9.4 {a glyph is drawn for a character or a sequence, never for nothing} -body {
  # "ab" IS TAKEN since 2026-08-26 and that is the point of this test rather
  # than a hole in it: a glyph may stand for a character SEQUENCE, which is
  # what a colour font needs for the family emoji and the flags. What is
  # refused is the empty string - it names no character at all and would take
  # a character code nothing could ever address.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font define marks
  # The CODE of the empty refusal and not only that there was one: the derived
  # glyph name of an empty text is empty too, so the name check would turn it
  # away as well - with a message about -name, which the caller never wrote.
  set results [list [::tclpdfTest::refusal {
    $doc font glyph marks {} -width 600 -script {}
  }]]
  foreach text {ab} {
    lappend results [catch {$doc font glyph marks $text -width 600 -script {}}]
  }
  lappend results [catch {$doc font glyph marks a -width x -script {}}]
  lappend results [catch {$doc font glyph marks a -width -3 -script {}}]
  # And the sequence is addressable: the two letters together are ONE glyph
  # with ONE width, while "a" alone is still a character the font has not got.
  # The document is in mm, so 600 glyph units at size 10 are 6 pt.
  lappend results [format %.4f [$doc textWidth "ab" -family marks -size 10]] \
      [catch {$doc textWidth "a" -family marks -size 10}]
  $doc destroy
  set results
} -result {{TCLPDF TYPE3 GLYPH char} 0 1 1 2.1167 1}

test type3-9.6 {font glyph needs -script, and an empty one is a space} -body {
  # The asymmetry this closes: -bbox is refused when -color text needs it and
  # -width is refused when it is not a number, but an omitted -script was not
  # refused at all. What came out was a glyph holding its width operator and
  # nothing else - a blank mark that sets, measures and extracts, with
  # neither pdftotext nor qpdf nor veraPDF reporting it. That is the shape
  # this package refuses by name elsewhere (TCLPDF FONT OUTLINES, TCLPDF
  # COLORFONT EMPTY), and the manual's own synopsis writes -script without
  # the brackets an optional argument gets.
  #
  # An EMPTY body stays legal, and has to: a glyph that advances and draws
  # nothing is a space, and a drawn font that carries one is doing what
  # /Widths is for.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  set missing [catch {$doc font glyph marks a -width 600} err]
  set empty [catch {$doc font glyph marks " " -width 400 -script {}}]
  set glyphs [dict size [dict get [$doc state fonts] marks glyphs]]
  # And the space is a glyph like any other: a width operator, d0, no marks.
  set stream [string trim [dict get [$doc state fonts] marks glyphs \
      [dict get [$doc state fonts] marks codes " "] stream]]
  $doc destroy
  list $missing $empty $glyphs $stream [string match {*-script*} $err]
} -result {1 0 1 {400 0 d0} 1}


# --- a glyph for a SEQUENCE --------------------------------------------------
#
# [font glyph] takes one or more code points since 2026-08-26, because a colour
# font needs it: the family emoji, the skin tones and the flags of an emoji
# face are single glyphs a GSUB ligature makes out of several characters, and
# no one of those characters has a glyph of its own to fall back on. What the
# tests below hold is the three consequences - the character CODE, the glyph
# NAME and the TEXT - and the rule that decides which sequence a string holds.

# A document with a font of one square glyph per piece, the pieces given as
# {text width} pairs.
#
# THE WIDTHS ARE DISTINCT ON PURPOSE, and they are how the tests below see
# which glyph was chosen: [Type3Encode] is not a public method and asking it
# directly would test a road no caller can take, while [textWidth] is exactly
# the road every caller does take and goes through it.
proc type3Sequences {args} {
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define marks -ascent 800
  foreach {piece width} $args {
    $doc font glyph marks $piece -width $width -script {
      $doc rect -at {100 100} -size {500 500} -fill {0.2 0.4 0.8}
    }
  }
  return $doc
}

test type3-10.1 {a sequence is one glyph with one code, one name, one width} -body {
  # "ab" is two characters and ONE glyph: one character code, one entry in
  # /Widths, one advance. The name is the component names joined by an
  # underscore, which is what a real face calls its ligature glyphs.
  set doc [type3Sequences a 700 ab 700]
  set entry [dict get [$doc state fonts] marks]
  set codes [dict get $entry codes]
  set names [lmap code [lsort -integer [dict keys [dict get $entry glyphs]]] {
    dict get $entry glyphs $code name
  }]
  set widths [list [$doc textWidth a -family marks -size 100] \
      [$doc textWidth ab -family marks -size 100]]
  $doc destroy
  list [dict size $codes] [lsort $names] $widths
} -result {2 {uni0061 uni0061_uni0062} {70.0 70.0}}

test type3-10.2 {a sequence takes a free code, a character its own} -body {
  # "a" is 97 and the encoding has room for it, so the string in the content
  # stream stays readable - "(a) Tj", exactly as 9.6.4 has it. A sequence has
  # no code point at all and takes the highest free code instead.
  # THE ORDER MATTERS FOR THE MEASUREMENT and not for the answer: in the first
  # font "a" takes 97 before "ab" is asked for, so a reader that took the code
  # point of the FIRST character would land on a code already in use and fall
  # through to the same 255 by accident. The second font asks for the sequence
  # alone, where the two roads part.
  set doc [type3Sequences a 700 ab 700]
  set both [dict get [$doc state fonts] marks codes]
  $doc destroy
  set doc [type3Sequences ab 700]
  set alone [dict get [$doc state fonts] marks codes]
  $doc destroy
  list [dict get $both a] [dict get $both ab] [dict get $alone ab]
} -result {97 255 255}

test type3-10.3 {the LONGEST sequence at a position wins} -body {
  # The only rule that can be right: a font holding both "a" and "ab" would
  # otherwise draw the "a" and then look for a glyph for the "b" it has not
  # got. Measured through the codes, which is what is written into the stream.
  # 100, 700 and 1300 glyph units, so that every answer is a different width
  # and the numbers say which glyph was taken rather than only that one was.
  set doc [type3Sequences a 100 ab 700 abc 1300]
  set answers [lmap text {a ab abc aab} {
    $doc textWidth $text -family marks -size 100
  }]
  $doc destroy
  set answers
} -result {10.0 70.0 130.0 80.0}

test type3-10.4 {the whole sequence extracts, through one bfchar} -body {
  # A bfchar may map one code to SEVERAL UTF-16 units (9.10.3). Without that
  # a sequence would extract as one unknown character and the text would stop
  # being copyable - which no validator anywhere reports.
  set doc [type3Sequences ab 700]
  $doc font -family marks -size 20
  $doc text ab -at {20 30}
  set path [::tclpdfTest::scratch type3-10.4.pdf]
  $doc write $path
  set map [join [::tclpdfTest::objects $doc beginbfchar] \n]
  $doc destroy
  file delete $path
  lindex [regexp -inline {beginbfchar\s+<[0-9A-F]+> <([0-9A-F]+)>} $map] 1
} -result 00610062

test type3-10.5 {pdftotext gives the sequence back} -constraints pdftotext -body {
  set doc [type3Sequences ab 700]
  $doc font -family marks -size 20
  $doc text ab -at {20 30}
  set path [::tclpdfTest::scratch type3-10.5.pdf]
  $doc write $path
  $doc destroy
  set text [string trim [exec pdftotext -enc UTF-8 $path -]]
  file delete $path
  set text
} -result ab

test type3-10.6 {a name longer than a PDF name holds is refused} -body {
  # 127 bytes (ISO 32000-1, Annex C.2), and a sequence of two dozen
  # components is the one thing here that can reach it. Refused rather than
  # shortened: a truncated name may collide with the next one, and a CharProcs
  # key names ONE glyph. -name is the way past it.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font define marks -ascent 800
  set long [string repeat abcdefghij 3]
  set code [::tclpdfTest::refusal {
    $doc font glyph marks $long -width 700 -script {}
  }]
  set short [$doc font glyph marks $long -width 700 -name manyLetters -script {}]
  $doc destroy
  list $code $short
} -result {{TCLPDF TYPE3 GLYPH name} manyLetters}

test type3-10.7 {the fallback chain offers the sequence as one unit} \
    -constraints haveTrueType -body {
  # THE HALF THAT WOULD HAVE BEEN MISSED. The chain decides per character
  # which face sets what; a sequence has to be offered as ONE piece or a font
  # that draws "ab" as one glyph never gets asked for it, because the face in
  # front of it has an "a". Read off the Tf operators of the stream.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font embed body $::trueTypeFace
  $doc font define marks -ascent 800
  $doc font glyph marks ab -width 700 -script {
    $doc rect -at {100 100} -size {500 500} -fill {0.2 0.4 0.8}
  }
  $doc font -family body -size 12 -fallback marks
  $doc text "x ab x" -at {20 30}
  set faces {}
  foreach line [split [::tclpdfTest::content $doc] \n] {
    if {[regexp {^(/\S+) [0-9.]+ Tf$} $line -> name]} {
      lappend faces $name
    }
  }
  $doc destroy
  set faces
} -result {/FEbody /T3marks /FEbody}

test type3-10.8 {the name limit counts BYTES, not characters} -body {
  # ISO 32000-1, Annex C.2 puts the limit at 127 BYTES, and a name object is
  # "a sequence of any characters (8-bit values) except null" (7.3.5) - a byte
  # string, with the #xx form the way ONE such byte is written where it is not
  # printable ASCII. So the count is over the UTF-8 of the name.
  #
  # Counted with [string length] until 2026-08-26, a -name of a hundred
  # umlauts passed as "a hundred characters" and went into the file as two
  # hundred bytes. The four cases below straddle the limit from both sides in
  # both alphabets: 127 ASCII passes and 128 does not, 63 umlauts (126 bytes)
  # passes and 64 (128 bytes) does not.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font define marks -ascent 800
  set answers {}
  foreach {char count} [list a 127 a 128 ä 63 ä 64] {
    set name [string repeat $char $count]
    lappend answers [catch {
      $doc font glyph marks [format %c [expr {0x2600 + [llength $answers]}]] \
          -width 700 -name $name -script {}
    }]
  }
  $doc destroy
  set answers
} -result {0 1 0 1}

test type3-10.9 {and the refusal says how many bytes it counted} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font define marks -ascent 800
  set message {}
  catch {
    $doc font glyph marks A -width 700 -name [string repeat ä 100] \
        -script {}
  } message
  $doc destroy
  list [string match {*200 bytes long*} $message] \
      [string match {*Annex C.2*} $message]
} -result {1 1}

test type3-10.10 {a character that is never drawn is dropped BEFORE the match} \
    -body {
  # The manual promises a soft hyphen "stays invisible ... in the drawing and
  # in the measurement alike". Trying the sequences first broke that for a
  # font that happens to hold a glyph for U+00AD: the longest match found it
  # and the mark was drawn AND measured - "A-B" came out 74.08 points wide
  # against 42.33 for "AB". The three characters are dropped first now, as
  # they were before sequences existed, so a glyph registered for one of them
  # is unreachable - which is the promise rather than an oversight.
  set doc [type3Sequences A 600 B 600 ­ 900]
  set widths [list [$doc textWidth A­B -family marks -size 100] \
      [$doc textWidth AB -family marks -size 100]]
  $doc destroy
  list [expr {[lindex $widths 0] == [lindex $widths 1]}] $widths
} -result {1 {120.0 120.0}}

test type3-10.11 {but one INSIDE a registered sequence is part of it} -body {
  # The other side of 10.10, and the reason the drop cannot simply strip the
  # three out of the string first: what is dropped is a character standing at
  # the START of a unit, and a unit is looked for from the first character
  # that is not one of the three. So a soft hyphen in the MIDDLE of a
  # registered sequence is matched whole with it and never reaches the test at
  # all - here "A<shy>B" is one glyph of 900 units, not two of 600.
  set doc [type3Sequences A 600 B 600 A­B 900]
  set widths [list [$doc textWidth A­B -family marks -size 100] \
      [$doc textWidth AB -family marks -size 100]]
  $doc destroy
  set widths
} -result {90.0 120.0}

test type3-10.12 {a glyph script that defines a glyph does not lose it} -body {
  # THE CODE IS HANDED OUT AFTER THE SCRIPT HAS RUN, against the register the
  # script may have added to. It was handed out before until 2026-08-26, and a
  # script that calls [font glyph] itself - which is how one glyph is built
  # out of another - then got the same free code as its caller: measured with
  # two symbols above U+00FF, both took 255, the outer glyph overwrote the
  # inner one in /CharProcs, and the register said "cloud 255 sun 255" for a
  # font that held one glyph.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font define marks -ascent 800
  $doc font glyph marks ☀ -width 500 -script {
    $doc font glyph marks ☁ -width 500 -script {
      $doc rect -at {0 0} -size {500 500} -fill black
    }
    $doc rect -at {0 0} -size {500 500} -fill black
  }
  set entry [dict get [$doc state fonts] marks]
  set codes [dict get $entry codes]
  set names [lsort [lmap {code record} [dict get $entry glyphs] {
    dict get $record name
  }]]
  $doc destroy
  list [dict size $codes] [llength [lsort -unique [dict values $codes]]] \
      [dict size [dict get $entry glyphs]] $names
} -result {2 2 2 {uni2600 uni2601}}

test type3-10.13 {and a name the script took is refused for the caller} -body {
  # The name check has the same freshness for the same reason: a nested glyph
  # may have taken the name, and a CharProcs key names ONE glyph.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font define marks -ascent 800
  set code [::tclpdfTest::refusal {
    $doc font glyph marks ☀ -width 500 -name taken -script {
      $doc font glyph marks ☁ -width 500 -name taken -script {}
    }
  }]
  $doc destroy
  lrange $code 0 2
} -result {TCLPDF TYPE3 GLYPH}

test type3-10.14 {a refusal at a variation selector says what a selector is} \
    -body {
  # The one character a caller can be refused for without knowing they wrote
  # it: "✅" and "✅️" look identical in every editor there is,
  # editors and databases put the selector in, and a font built for the one
  # refuses the other with "no glyph for U+FE0F" - a character the caller
  # cannot see. So the message says what a selector IS and how to register the
  # spelling it belongs to.
  set doc [type3Sequences ✅ 700]
  set message {}
  catch {$doc textWidth ✅️ -family marks -size 10} message
  set plain {}
  catch {$doc textWidth ⾀ -family marks -size 10} plain
  $doc destroy
  list [string match {*U+FE0F*} $message] \
      [string match {*variation selector*} $message] \
      [string match {*colorFont -chars*} $message] \
      [string match {*variation selector*} $plain] \
      [string match {*draw one with*} $plain]
} -result {1 1 1 0 1}

# -- round 7: d1 specifies shape, not colour --------------------------------

test type3-11.1 {a colour operator is struck out of a d1 glyph} -body {
  # ISO 32000-2, 9.6.4, Table 111: a glyph description that begins with d1
  # "should not execute any operators that set the colour ... any use of such
  # operators shall be ignored". The readers disagree about the second half -
  # measured 2026-08-26, poppler ignores a "0 g" inside a d1 glyph and paints
  # in the text colour, Quartz executes it and paints black - and the drawing
  # methods of this package write a colour with every figure, so every
  # -color text glyph carried one.
  # -compress 0 so that the stream can be read as it is written.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define box -ascent 750
  $doc font glyph box "☐" -width 900 -color text -bbox {60 50 640 640} \
      -script {$doc rect -at {60 50} -size {640 640} -fill black}
  $doc font -family box -size 36 -color {0.15 0.35 0.75}
  $doc text "☐" -at {20 40}
  set path [::tclpdfTest::scratch d1-colour.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {\md1\M} $bytes] [regexp {\m0 g\M} $bytes] \
      [regexp {\mre\M} $bytes] [regexp {\mf\M} $bytes]
} -result {1 0 1 1}

test type3-11.2 {a d0 glyph keeps its colours} -body {
  # The control, and the reason -color own is the default: a d0 glyph
  # "specifies both its shape and its colour", so nothing is taken out of it.
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font define box -ascent 750
  $doc font glyph box "☐" -width 900 \
      -script {$doc rect -at {60 50} -size {640 640} -fill {0 0 1}}
  $doc font -family box -size 36
  $doc text "☐" -at {20 40}
  set path [::tclpdfTest::scratch d0-colour.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {\md0\M} $bytes] [regexp {\m0 0 1 rg\M} $bytes]
} -result {1 1}

test type3-11.3 {the scanner never looks inside a string} -body {
  # A literal string may hold the text "0 g" - "(0 g) Tj" is an ordinary line
  # of a glyph that draws letters - and an inline image holds arbitrary
  # bytes. So the stream is lexed rather than searched: strings with their
  # nesting and escapes, hex strings, comments and BI ... ID ... EI pass
  # through as single tokens.
  set strip ::tclpdf::type3::stripColour
  list [$strip "q\n0 g\n1 2 3 4 re\nf\nQ\n"] \
      [$strip "BT (0 g) Tj ET\n"] \
      [$strip "BT (a\\) 0 g) Tj ET\n"] \
      [$strip "/Pattern cs /P1 scn 0 0 10 10 re f\n"] \
      [$strip "% 0 g\n0 g\n1 w\n"] \
      [$strip "\[(0 g) -10 (x)\] TJ\n"] \
      [$strip "q 0 g /Sh1 sh Q\n"]
} -result {{q
1 2 3 4 re
f
Q
} {BT (0 g) Tj ET
} {BT (a\) 0 g) Tj ET
} { 0 0 10 10 re f
} {% 0 g
1 w
} {[(0 g) -10 (x)] TJ
} {q /Sh1 sh Q
}}

test type3-11.4 {an inline image is one token, whatever its bytes spell} -body {
  # The data between ID and EI is not operators.
  ::tclpdf::type3::stripColour \
      "BI /W 1 /H 1 /CS /G ID \x00 0 g EI\n0 g\n1 w\n"
} -result "BI /W 1 /H 1 /CS /G ID \x00 0 g EI\n1 w\n"

test type3-11.5 {a number option of a Type 3 font has to be finite} -body {
  # NaN is a double to Tcl and every comparison with it is false, so it
  # passed the range tests and went on into the FontMatrix arithmetic, the
  # /FontBBox and the d0/d1 operand of the glyph stream.
  set doc [tclpdf new -unit pt]
  $doc page add
  set ascent [::tclpdfTest::refusalCode {$doc font define a -ascent NaN}]
  set infinite [::tclpdfTest::refusalCode {$doc font define b -ascent Inf}]
  $doc font define c -ascent 750
  set width [::tclpdfTest::refusalCode {$doc font glyph c x -width NaN -script {}}]
  set box [::tclpdfTest::refusalCode {$doc font glyph c y -width 500 \
      -color text -bbox {0 0 NaN 5} -script {}}]
  set names [$doc font names]
  $doc destroy
  list $ascent $infinite $width $box $names
} -result {{TCLPDF TYPE3 ARGUMENT ascent} {TCLPDF TYPE3 ARGUMENT ascent} {TCLPDF TYPE3 ARGUMENT width} {TCLPDF TYPE3 BBOX number} c}

test type3-11.6 {font info reports how many glyphs of a colour face need a mask} \
    -constraints {haveColour haveTrueType} -body {
  # The one thing about a drawn colour font a caller cannot see from the
  # outside, and the one that decides how it renders in a reader that reads
  # the mask rules differently (docs/technote-type3-softmask.md).
  # colorFontPaint.tcl counts them as it builds the glyphs; every other kind
  # of font answers 0, because the set of keys [font info] answers is the
  # same whatever was embedded.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc colorFont emoji $colourFace -chars "😀🌍🇺🇳"
  $doc text "😀🌍🇺🇳" -at {20 20} -family emoji -size 20
  set masks [dict get [$doc font info emoji] masks]
  $doc write [::tclpdfTest::scratch colour-masks.pdf]
  set written [dict get [$doc font info emoji] masks]
  # A drawn font that is not a colour face, and an embedded one: the key is
  # there for both, at 0.
  $doc font define drawn -ascent 750
  set plain [dict get [$doc font info drawn] masks]
  $doc font embed body $trueTypeFace
  set embedded [dict get [$doc font info body] masks]
  $doc destroy
  file delete [::tclpdfTest::scratch colour-masks.pdf]
  list $masks $written $plain $embedded
} -result {1 1 0 0}

cleanupTests

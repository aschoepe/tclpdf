# text.test --
#
# Text output, line breaking and justification.
#
# The first test is a regression against a defect that produced a file poppler
# still rendered and qpdf refused: the font state was stored through
# [resource] and therefore written into the PDF resource dictionary.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::text
source [file join [file dirname [info script]] helper.tcl]

set textFace [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts DejaVuSans.ttf]
testConstraint haveFace [file exists $textFace]

test text-1.1 {module state never reaches the PDF} -body {
  # /Resources << /tclpdfTextState << /current family helvetica style {} ... >>
  # is what this used to produce - Tcl values inside the page tree, which
  # breaks the structure while a tolerant reader still shows the text.
  set path [::tclpdfTest::scratch text-state.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc font -family times -size 14
  $doc text "Rechnung" -at {20 30}
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {tclpdfTextState} $bytes] [regexp -- {style \{\}} $bytes]
} -result {0 0}

test text-1.2 {the font becomes a resource exactly once} -body {
  set doc [tclpdf new]
  $doc page add
  foreach line {eins zwei drei} {
    $doc text $line -at {20 30} -family helvetica
  }
  set content [::tclpdfTest::content $doc]
  set writer [$doc writer]
  set fonts 0
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[string match {*/Type /Font*} [$writer body $number]]} {
      incr fonts
    }
  }
  $doc destroy
  list $fonts [regexp -all {/FHelvetica} $content]
} -result {1 3}

test text-2.1 {alignment shifts the starting point} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 12
  set width [$doc textWidth "Rechnung"]
  $doc text "Rechnung" -at {100 50} -align left
  $doc text "Rechnung" -at {100 60} -align right
  $doc text "Rechnung" -at {100 70} -align center
  set content [::tclpdfTest::content $doc]
  $doc destroy
  set x {}
  foreach line [split $content \n] {
    if {[regexp {^([0-9.]+) [0-9.]+ Td$} $line -> value]} {
      lappend x $value
    }
  }
  lassign $x left right center
  # left starts at 100 mm, right ends there, center straddles it
  list [expr {abs($left - 283.46) < 0.1}] [expr {$right < $left}] \
      [expr {$center > $right && $center < $left}]
} -result {1 1 1}

test text-2.2 {justify without a width is refused} -body {
  set doc [tclpdf new]
  $doc page add
  try {
    $doc text "x" -at {20 20} -align justify
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*justify needs -width*}

test text-2.3 {a computed position in braces is caught with a usable message} -body {
  # -at {20 [expr {$y+5}]} does not substitute, and Tcl's own error says
  # nothing about the cause.
  set doc [tclpdf new]
  $doc page add
  try {
    $doc text "x" -at {20 {[expr {1+1}]}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*-at takes two numbers*braces do not substitute*}

test text-3.1 {lines are broken to fit the width} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set lines [$doc textLines "ein zwei drei vier fuenf sechs sieben acht neun" 30]
  set widest 0
  foreach line $lines {
    set width [$doc textWidth $line]
    if {$width > $widest} {
      set widest $width
    }
  }
  $doc destroy
  list [expr {[llength $lines] > 1}] [expr {$widest <= 30}]
} -result {1 1}

test text-3.2 {an over-long word is broken rather than left hanging out} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  set lines [$doc textLines "Donaudampfschifffahrtsgesellschaftskapitaenspatent" 20]
  set widest 0
  foreach line $lines {
    set width [$doc textWidth $line]
    if {$width > $widest} {
      set widest $width
    }
  }
  $doc destroy
  list [expr {[llength $lines] > 1}] [expr {$widest <= 20}]
} -result {1 1}

test text-3.3 {explicit newlines start a new line} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set lines [$doc textLines "eins\nzwei\ndrei" 100]
  $doc destroy
  set lines
} -result {eins zwei drei}

test text-4.1 {justification stretches spaces, and not on the last line} -body {
  # Tw is the operator that widens spaces. Every line but the last gets one;
  # the last must not, or a single trailing word is pulled across the column.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10
  $doc text "Dieser Absatz ist lang genug fuer mehrere Zeilen und wird im\
      Blocksatz gesetzt damit die Wortabstaende gedehnt werden." \
      -at {20 30} -width 60 -align justify
  set content [::tclpdfTest::content $doc]
  $doc destroy
  set lines [regexp -all {Td} $content]
  set stretched [regexp -all {[0-9.]+ Tw} $content]
  # one Tw fewer than there are lines - the last one is flush left
  list [expr {$lines > 2}] [expr {$stretched == $lines - 1}]
} -result {1 1}

test text-4.2 {a paragraph returns the y below it} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10 -leading 12
  set y [$doc text "eins zwei drei vier fuenf sechs sieben acht" -at {20 30} -width 30]
  set height [$doc textHeight "eins zwei drei vier fuenf sechs sieben acht" 30]
  $doc destroy
  # y advanced by exactly the block height
  expr {abs($y - (30 + $height)) < 0.001}
} -result 1

test text-5.1 {rotation uses Tm, not Td} -body {
  set doc [tclpdf new]
  $doc page add
  $doc text "quer" -at {50 50} -rotate 90
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [regexp {Tm} $content] [regexp {Td} $content]
} -result {1 0}

test text-5.3 {a rotated centred line stays centred on -at} -body {
  # The alignment shift has to run ALONG THE BASELINE. Shifting x first and
  # rotating afterwards turned the text about the wrong point: a centred
  # stamp drifted towards the page corner. No test combined -align with
  # -rotate before this one - which is how it stayed unseen.
  #
  # At 90 degrees the maths is exact: Tm must be {0 1 -1 0 px py-s} - the
  # anchor px unchanged, the shift s moved into the SECOND coordinate,
  # because the baseline now runs upwards.
  set doc [tclpdf new -unit pt]
  $doc page add
  lassign [$doc page size] -> pageHeight
  set s [expr {[$doc textWidth "MITTIG"] / 2.0}]
  $doc text "MITTIG" -at {100 700} -align center -rotate 90
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) Tm} \
      $content -> a b c d e f
  set py [expr {$pageHeight - 700}]
  list $a $b $c $d [expr {abs($e - 100) < 0.01}] [expr {abs($f - ($py - $s)) < 0.01}]
} -result {0 1 -1 0 1 1}

test text-5.4 {an unrotated centred line still shifts the start point} -body {
  # The regression guard for the ordinary case: without -rotate the shift is
  # plain subtraction from x, exactly as before.
  set doc [tclpdf new -unit pt]
  $doc page add
  lassign [$doc page size] -> pageHeight
  set s [expr {[$doc textWidth "MITTIG"] / 2.0}]
  $doc text "MITTIG" -at {100 700} -align center
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {([-0-9.]+) ([-0-9.]+) Td} $content -> e f
  list [expr {abs($e - (100 - $s)) < 0.01}] \
      [expr {abs($f - ($pageHeight - 700)) < 0.01}]
} -result {1 1}

test text-5.2 {spacing, word spacing, stretch and rise reach the stream} -body {
  set doc [tclpdf new]
  $doc page add
  $doc text "x" -at {20 20} -spacing 2 -wordSpacing 3 -stretch 80 -rise 4
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [regexp {2 Tc} $content] [regexp {3 Tw} $content] \
      [regexp {80 Tz} $content] [regexp {4 Ts} $content]
} -result {1 1 1 1}

test text-6.1 {Symbol gets no WinAnsiEncoding} -body {
  # Declaring WinAnsi for a font with its own built-in encoding scrambles
  # every glyph, and nothing reports it.
  set doc [tclpdf new]
  $doc page add
  $doc text "abg" -at {20 20} -family symbol
  $doc text "abc" -at {20 30} -family helvetica
  set writer [$doc writer]
  set symbol {}
  set helvetica {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/BaseFont /Symbol*} $body]} {
      set symbol $body
    }
    if {[string match {*/BaseFont /Helvetica*} $body]} {
      set helvetica $body
    }
  }
  $doc destroy
  list [regexp {WinAnsiEncoding} $symbol] [regexp {WinAnsiEncoding} $helvetica]
} -result {0 1}

test text-6.2 {the Euro sign survives into the content stream} -body {
  set doc [tclpdf new]
  $doc page add
  $doc text "1,50 [encoding convertfrom utf-8 [binary format H* e282ac]]" -at {20 20}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # byte 128 is written as the octal escape \200, which keeps the stream
  # text-safe
  regexp {\(1,50 \\200\)} $content
} -result 1

test text-colour-7.1 {-color sets the fill colour of the text} -body {
  # Documented on [font] and used by every example, tested by nothing: the
  # colour a text is written in is the one option a reader notices first.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc text "rot" -at {20 20} -color {1 0 0}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # The fill colour, not the stroke colour - text is filled (9.3.6).
  list [regexp {1 0 0 rg} $content] [regexp {1 0 0 RG} $content]
} -result {1 0}

test text-colour-7.2 {a colour on the state stays, a colour per call does not} -body {
  # The two ways of setting it, and the difference between them: [font -color]
  # is state and holds until changed, the per-call option is for one string.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -color {0 0 1}
  $doc text "blau" -at {20 20}
  $doc text "auch blau" -at {20 30}
  $doc text "gruen" -at {20 40} -color {0 0.5 0}
  $doc text "wieder blau" -at {20 50}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  set colours {}
  foreach match [regexp -all -inline {[0-9.]+ [0-9.]+ [0-9.]+ rg} $content] {
    lappend colours [lrange $match 0 2]
  }
  set colours
} -result {{0 0 1} {0 0 1} {0 0.5 0} {0 0 1}}

test text-anchor-7.3 {-anchor top shifts along the turned baseline, not down the page} -body {
  # The alignment shift's twin, one axis over: the ascender was added to y in
  # DOCUMENT space and the rotation happened afterwards, so at 90 degrees the
  # anchor came out exactly as if nothing had been turned - and the text stood
  # a whole ascender away from -at.
  #
  # At 90 degrees the maths is exact. The baseline runs upwards, so "below the
  # baseline" points to the RIGHT: the ascender has to appear in x, and py must
  # be untouched.
  set doc [tclpdf new -unit pt]
  $doc page add
  lassign [$doc page size] -> pageHeight
  $doc text "X" -at {100 700} -anchor top -rotate 90 -family helvetica -size 100
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+) Tm} \
      $content -> a b c d e f
  # Helvetica's ascender is 718/1000 of the size.
  set ascent 71.8
  list $a $b $c $d [expr {abs($e - (100 + $ascent)) < 0.01}] \
      [expr {abs($f - ($pageHeight - 700)) < 0.01}]
} -result {0 1 -1 0 1 1}

test text-anchor-7.4 {without rotation -anchor top is what it always was} -body {
  # The regression guard for every existing document: unrotated, the lift is
  # plain subtraction in y and the stream may not move by so much as a
  # hundredth of a point.
  set doc [tclpdf new -unit pt]
  $doc page add
  lassign [$doc page size] -> pageHeight
  $doc text "X" -at {100 700} -anchor top -family helvetica -size 100
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {([-0-9.]+) ([-0-9.]+) Td} $content -> x y
  list [expr {abs($x - 100) < 0.01}] \
      [expr {abs($y - ($pageHeight - 700 - 71.8)) < 0.01}]
} -result {1 1}

test text-anchor-7.5 {a paragraph still returns the baseline below itself} -body {
  # Measured the hard way while fixing the rotation: the lift is part of the
  # distance, because -anchor top names the TOP edge and the answer is a
  # BASELINE. Dropping it moved every element after a paragraph up by one
  # ascender - which the rendered examples showed and no test did.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10 -leading 12
  set text "eins zwei drei vier fuenf sechs sieben acht"
  set plain [$doc text $text -at {20 30} -width 30]
  $doc page add
  set fromTop [$doc text $text -at {20 30} -width 30 -anchor top]
  set height [$doc textHeight $text 30]
  $doc destroy
  # Without an anchor: y plus the block height. With -anchor top: one ascender
  # further down, and nothing else.
  set ascent [expr {718 * 10 / 1000.0 * 25.4 / 72}]
  list [expr {abs($plain - (30 + $height)) < 0.001}] \
      [expr {abs($fromTop - (30 + $ascent + $height)) < 0.001}]
} -result {1 1}

test text-paragraph-7.6 {a rotated paragraph lays its lines side by side} -body {
  # They used to pile up on each other: the line advance ran down the page in
  # document space while every line was rotated about its own advanced point,
  # so all of them landed in the same place. Unreadable, and valid.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  $doc text "Ein Absatz der gedreht gesetzt wird und dabei mehrere Zeilen\
      braucht damit man sieht wohin die Zeilen laufen." \
      -at {100 100} -width 60 -rotate 90
  set content [::tclpdfTest::content $doc]
  $doc destroy
  set anchors {}
  foreach line [split $content \n] {
    if {[regexp {([-0-9.]+) ([-0-9.]+) Tm$} $line -> x y]} {
      lappend anchors [list [format %.2f $x] [format %.2f $y]]
    }
  }
  # Three lines, three DIFFERENT anchors - and at 90 degrees the advance has
  # to show up in x, with y the same for all of them.
  set xs {}
  set ys {}
  foreach anchor $anchors {
    lappend xs [lindex $anchor 0]
    lappend ys [lindex $anchor 1]
  }
  list [expr {[llength $anchors] > 2}] \
      [expr {[llength [lsort -unique $xs]] == [llength $xs]}] \
      [llength [lsort -unique $ys]]
} -result {1 1 1}

test text-paragraph-7.7 {an unrotated paragraph advances down the page as before} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 9 -leading 12
  $doc text "Ein Absatz der ganz gewoehnlich gesetzt wird und dabei mehrere\
      Zeilen braucht damit man sieht wohin die Zeilen laufen." \
      -at {20 100} -width 60
  set content [::tclpdfTest::content $doc]
  $doc destroy
  set ys {}
  foreach line [split $content \n] {
    if {[regexp {([-0-9.]+) ([-0-9.]+) Td$} $line -> x y]} {
      lappend ys $y
    }
  }
  # Every line one leading further down the page - 12 pt, in PDF coordinates
  # therefore DECREASING y.
  set steps {}
  foreach a [lrange $ys 0 end-1] b [lrange $ys 1 end] {
    lappend steps [format %.2f [expr {$a - $b}]]
  }
  list [expr {[llength $ys] > 2}] [lsort -unique $steps]
} -result {1 12.00}

test text-justify-8.1 {an embedded face is justified through TJ, not through Tw} -constraints haveFace -body {
  # Tw applies to the single-byte code 32 and to nothing else (9.3.3), and an
  # embedded face is addressed through Identity-H, where every code is two
  # bytes. The word spacing was written, was valid, and did nothing - so a
  # justified paragraph in any PDF/A document, where embedding is compulsory,
  # was not justified at all.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face $::textFace
  $doc text "Dieser Absatz soll im Blocksatz bis an die rechte Kante reichen\
      und dafuer die Wortabstaende dehnen ohne dass jemand nachmisst." \
      -at {20 30} -width 80 -align justify -family face -size 10
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # A TJ array on the stretched lines, and no Tw left anywhere to mislead.
  list [expr {[regexp -all {\] TJ} $stream] >= 2}] [regexp {Tw} $stream]
} -result {1 0}

test text-justify-8.2 {a standard face keeps Tw, where it does work} -body {
  # The counterpart: with WinAnsi the code 32 IS a single byte, Tw is the
  # cheaper operator and the streams stay as they were. Dropping it everywhere
  # would be a needless change to every existing document.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc text "Dieser Absatz soll im Blocksatz bis an die rechte Kante reichen\
      und dafuer die Wortabstaende dehnen ohne dass jemand nachmisst." \
      -at {20 30} -width 80 -align justify -size 10
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  list [regexp {Tw} $stream] [expr {[regexp -all {\] TJ} $stream] == 0}]
} -result {1 1}

test text-justify-8.3 {the adjustment is worth exactly the word spacing} -constraints haveFace -body {
  # TJ numbers are thousandths of the text space, subtracted from the advance -
  # so the gap a number opens is -n/1000 * size. Asked the other way round:
  # the line has to come out as wide as the paragraph was told to be.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face $::textFace
  $doc text "Dieser Absatz soll im Blocksatz bis an die rechte Kante reichen\
      und dafuer die Wortabstaende dehnen ohne dass jemand nachmisst." \
      -at {20 30} -width 80 -align justify -family face -size 10
  set stream [::tclpdfTest::content $doc]
  # The first TJ array: its pieces spell the line, its numbers stretch it.
  regexp {\[(.*?)\] TJ} $stream -> array
  set kicks [regexp -all -inline -- {-[0-9.]+} $array]
  $doc destroy
  # Every gap on the line is the same size, and it is a real widening.
  list [llength [lsort -unique $kicks]] [expr {[llength $kicks] > 3}] \
      [expr {abs([lindex $kicks 0]) > 0}]
} -result {1 1 1}

test text-justify-8.4 {the stretched line really reaches the right margin} -constraints haveFace -body {
  # The measurement that matters, and the one that was silently wrong: the
  # width of the line as the reader will lay it out - the glyph advances plus
  # every adjustment - against the width the paragraph was given. Before the
  # fix this came out about 5 mm short, and differently short on every line.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face $::textFace
  set words "Dieser Absatz soll im Blocksatz bis an die rechte Kante reichen\
      und dafuer die Wortabstaende dehnen ohne dass jemand nachmisst."
  $doc text $words -at {20 30} -width 80 -align justify -family face -size 10
  set stream [::tclpdfTest::content $doc]
  # The words of the first line, in the order the lines were broken.
  set lines [$doc textLines $words -width 80 -family face -size 10]
  set first [lindex $lines 0]
  regexp {\[(.*?)\] TJ} $stream -> array
  set kicks 0.0
  foreach number [regexp -all -inline -- {-[0-9.]+} $array] {
    set kicks [expr {$kicks - $number}]
  }
  # Advances of the text itself, without any spacing, plus what TJ adds.
  set plain [$doc textWidth $first -family face -size 10 -wordSpacing 0]
  $doc destroy
  # The adjustments are thousandths of the text space and come out in POINTS;
  # the width is in millimetres, and adding the two unconverted is how this
  # test first "proved" a line 12 mm too wide.
  set width [expr {$plain + $kicks / 1000.0 * 10 * 25.4 / 72}]
  # 80 mm, to a hundredth of a millimetre.
  format %.2f $width
} -result 80.00

test text-justify-8.5 {two spaces get two adjustments, as Tw would have} -constraints haveFace -body {
  # [textWidth] counts one word spacing per space character, so the stream has
  # to produce one per space as well - otherwise measurement and drawing would
  # disagree by exactly the runs of repeated spaces.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face $::textFace
  $doc text "a  b c" -at {20 30} -family face -size 10 -wordSpacing 2
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  regexp {\[(.*?)\] TJ} $stream -> array
  llength [regexp -all -inline -- {-[0-9.]+} $array]
} -result 3

test text-state-9.1 {character spacing does not outlive its block} -body {
  # Tc, Tw, Ts and Tz are TEXT state, and the text state is part of the
  # GRAPHICS state (9.3) - they survive ET. Written only when they differ from
  # the default, "3 Tc" stayed in force and the next plain [text] came out
  # letter-spaced with nothing in its own call to explain it.
  set doc [tclpdf new]
  $doc page add
  $doc text "gesperrt" -at {20 20} -spacing 3
  $doc text "normal" -at {20 40}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # Everything after the LAST Q is the second block; it must carry no Tc.
  set tail [string range $content [string last "Q\n" $content] end]
  list [regexp {3 Tc} $content] [regexp {Tc} $tail]
} -result {1 0}

test text-state-9.2 {a plain line is not wrapped at all} -body {
  set doc [tclpdf new]
  $doc page add
  $doc text "normal" -at {20 20}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  regexp {^q} $content
} -result 0

cleanupTests

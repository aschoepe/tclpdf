# sfnt.test --
#
# The sfnt reader: what it refuses, and under which error code.
#
# This file exists for the codes rather than for the parsing - what a correct
# face parses to is measured in font.test, which drives this module 134 times.
# A refusal is the other half of the contract: it reaches a caller as an
# -errorcode, and until 2026-08-24 every one of the thirty refusals in this
# module arrived as NONE, so no "trap {TCLPDF FONT}" could see them.
#
# The damaged faces are BUILT rather than found. A collection, a CFF2 and a
# truncated table are all cases a real file is not going to supply on demand,
# and a fixture checked in for each would be a font this package may not
# redistribute. Each one starts from the sfnt header, which is twelve bytes
# and a table directory, and breaks exactly one thing.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::sfnt
source [file join [file dirname [info script]] helper.tcl]

set fontRegular [file join [file dirname [file dirname [file normalize \
    [info script]]]] examples assets fonts DejaVuSans.ttf]
testConstraint haveFont [file exists $fontRegular]

# The CFF face the charstring tests below measure - the same one font.test
# uses, and the one whose FontBBox reaches 1075 for capitals of 729.
set otf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.otf]
testConstraint haveOtf [file exists $otf]

# An sfnt out of whole cloth: a header, a table directory and the tables. The
# checksums are zero, which no reader here verifies - what is under test is
# what the parser demands before it reads anything.
proc sfntFile {tables {signature 0x00010000}} {
  set count [expr {[llength $tables] / 2}]
  set header [binary format IuSuSuSuSu $signature $count 0 0 0]
  set offset [expr {12 + $count * 8 * 2}]
  set directory {}
  set body {}
  foreach {tag data} $tables {
    append directory [binary format a4IuIuIu $tag 0 $offset \
        [string length $data]]
    append body $data
    # Every table starts on a four-byte boundary (OpenType, "Organization of
    # an OpenType Font").
    set padding [expr {(4 - [string length $data] % 4) % 4}]
    append body [string repeat \x00 $padding]
    incr offset [expr {[string length $data] + $padding}]
  }
  return $header$directory$body
}

# A head table that says what the parser reads out of it: the units per em at
# offset 18, the bounding box at 36 and the loca format at 50.
proc headTable {{unitsPerEm 1000}} {
  set head [string repeat \x00 54]
  return [string replace $head 18 19 [binary format Su $unitsPerEm]]
}

proc hheaTable {} {
  return [string repeat \x00 36]
}

proc maxpTable {{numGlyphs 1}} {
  set maxp [string repeat \x00 32]
  return [string replace $maxp 4 5 [binary format Su $numGlyphs]]
}

# A whole face the builder above produces and the parser accepts. Every
# refusal below is this face with one thing broken, which is what makes each
# test a statement about the one thing rather than about the fixture.
proc wholeFace {} {
  return [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable]]]
}


test sfnt-1.1 {a whole built face parses, so the fixtures below say something} -body {
  dict get [::tclpdf::sfnt parse [wholeFace]] unitsPerEm
} -result 1000

test sfnt-1.2 {a file shorter than an sfnt header names its source} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse "not a font"}
} -result {TCLPDF FONT SOURCE sfnt}

test sfnt-1.3 {a file that is long enough but is not a font} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse [sfntFile {} 0x25504446]}
} -result {TCLPDF FONT SOURCE sfnt}

test sfnt-1.4 {a TrueType collection is refused as unsupported, not as damage} -body {
  # "ttcf" - the tag alone decides, which is why a header is the whole
  # fixture. The three collections on this machine are macOS system fonts and
  # may not be checked in.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [binary format a4SuSuIu ttcf 1 0 2][string repeat \x00 8]}
} -result {TCLPDF FONT UNSUPPORTED collection}

test sfnt-1.5 {a table directory that ends inside an entry is damage} -body {
  set face [wholeFace]
  # Four tables announced, sixteen - the directory now reaches past the file.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse [string replace $face 4 5 \
      [binary format Su 16]]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.6 {a face without a required table names the table} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse [sfntFile [list hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable]]]}
} -result {TCLPDF FONT TABLE head}

test sfnt-1.7 {an OTTO file without a CFF table is missing that one} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse [sfntFile [list head [headTable] \
      hhea [hheaTable] hmtx [string repeat \x00 4] maxp [maxpTable]] \
      0x4F54544F]}
} -result {TCLPDF FONT TABLE {CFF }}

# One field of one directory entry, rewritten: the offset at 8 and the length
# at 12 of the sixteen-byte record. What every fixture below wants is a sound
# face with exactly one number in its directory wrong, and reaching for that
# number by hand in each of them is how the fixtures start disagreeing.
proc entryField {face tag field value} {
  binary scan $face @4Su count
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {12 + $index * 16}]
    if {[string range $face $at [expr {$at + 3}]] ne $tag} {
      continue
    }
    set start [expr {$at + ($field eq "offset" ? 8 : 12)}]
    return [string replace $face $start [expr {$start + 3}] \
        [binary format Iu $value]]
  }
  error "no \"$tag\" table in this face"
}

test sfnt-1.8 {a face declaring no em is damaged, not short of metrics} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse [sfntFile [list head [headTable 0] \
      hhea [hheaTable] hmtx [string repeat \x00 4] maxp [maxpTable]]]}
} -result {TCLPDF FONT DAMAGED head}


# A DIRECTORY THAT POINTS OUT OF THE FILE, which is the whole of the damage
# behind the six raw Tcl errors measured on 2026-08-25: a table read through
# an offset the file does not reach leaves [binary scan] with nothing to fill,
# and what arrived was "can't read \"fixed\": no such variable" under
# errorCode TCL READ VARNAME - a Tcl error where doc/tclpdf.md promises a
# message beginning with "tclpdf:". They are all one defect and all one guard:
# the directory is the single place a table's extent is stated.

test sfnt-1.9 {a table entry pointing past the end of the file is damage} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [entryField [wholeFace] head offset 900000]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.10 {and so is an entry whose LENGTH reaches past it} -body {
  # The shape a cut-off file has: every offset is still right and the last
  # tables are no longer there. Measured on a DejaVuSans truncated to 680 000
  # bytes, which is where the raw error came from.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [entryField [wholeFace] maxp length 900000]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.11 {a real face cut in half refuses by name} -constraints haveFont -body {
  set bytes [::tclpdfTest::readBytes $::fontRegular]
  set half [string range $bytes 0 [expr {[string length $bytes] / 2}]]
  set code [::tclpdfTest::refusalCode {::tclpdf::sfnt parse $half}]
  # The code AND that it is not a Tcl error: TCL READ VARNAME is what this
  # test exists to keep out, and it would not show in a "TCLPDF FONT *" match.
  list $code [expr {[lindex $code 0] eq "TCLPDF"}]
} -result {{TCLPDF FONT DAMAGED directory} 1}

test sfnt-1.12 {a table too short for its own format is damage as well} -body {
  # Inside the file, and still unreadable: a head holds 54 bytes and
  # indexToLocFormat sits in the last two of them.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [string range [headTable] 0 19] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable]]]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.13 {a tag named twice is refused rather than silently overwritten} -body {
  # A table directory is a set (OpenType, "Organization of an OpenType
  # Font"). The second entry used to overwrite the first without a word, so a
  # file could carry two head tables and the reader picked whichever came
  # last.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable] head [headTable 500]]]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.14 {an hmtx that ends inside its metrics} -body {
  # hhea says how many advance widths hmtx holds, and every one of them is a
  # glyph's width - unlike the bearings behind them, which a font may end
  # early. numberOfHMetrics sits at offset 34.
  set hhea [string replace [hheaTable] 34 35 [binary format Su 1000]]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea $hhea \
          hmtx [string repeat \x00 4] maxp [maxpTable]]]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.15 {a loca that cannot locate the glyphs maxp announces} -body {
  # One offset per glyph plus a closing one. Read past the end it gave an
  # unset variable; read short it would have cut every glyph past that point
  # out of the subset, which nothing downstream could notice.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable 10] \
          loca [string repeat \x00 4] glyf [string repeat \x00 4]]]}
} -result {TCLPDF FONT DAMAGED directory}

test sfnt-1.16 {an OS/2 too short to read counts as absent, not as damage} -body {
  # Nothing in OS/2 is needed to embed a face - a face without one parses -
  # so a stub table is passed over rather than turned into a refusal. What
  # must NOT happen is the read running off the end.
  set font [::tclpdf::sfnt parse [sfntFile [list head [headTable] \
      hhea [hheaTable] hmtx [string repeat \x00 4] maxp [maxpTable] \
      OS/2 [string repeat \x00 4]]]]
  list [dict get $font fsType] [dict get $font os2 weightClass]
} -result {{} 400}

test sfnt-1.17 {a vhea too short to hold numOfLongVerMetrics is damage} -body {
  # The count sits in the last two bytes of the 36, so a shorter vhea cannot
  # be read at all - and subset.tcl, which rewrites that very field, is
  # entitled to find it there.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable] \
          vhea [string repeat \x00 8] vmtx [string repeat \x00 4]]]}
} -result {TCLPDF FONT DAMAGED vhea}


# The cmap road. A face with no usable Unicode subtable and one whose subtable
# is in a format this package does not read are DIFFERENT answers - the first
# says the face cannot be addressed at all, the second that this reader is the
# limit. A caller that falls back to another face wants to tell them apart.

# A cmap with one subtable: version, count, then platform, encoding and offset.
# The cmap is read by [parse] rather than by a call of its own, so that is what
# these three drive - a first draft asked a subcommand that does not exist and
# was green anyway, because [parse] inside the argument had already raised the
# refusal under test.
proc cmapTable {format {platform 3} {encoding 1}} {
  set subtable [binary format SuSuSu $format 0 0]
  return [binary format SuSuSuSuIu 0 1 $platform $encoding 12]$subtable
}

test sfnt-2.1 {a face whose cmap holds nothing Unicode} -constraints haveFont -body {
  set face [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable] \
      cmap [cmapTable 4 1 0]]]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse $face}
} -result {TCLPDF FONT ENCODING cmap}

test sfnt-2.2 {a cmap format this reader does not know is unsupported} -body {
  set face [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable] cmap [cmapTable 6]]]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse $face}
} -result {TCLPDF FONT UNSUPPORTED cmap 6}

test sfnt-2.3 {a format 12 cmap promising more groups than the file holds} -body {
  # Format 12: format, reserved, length, language, then the group count. The
  # count steers a loop, so it is checked before it is believed - a corrupt
  # one read as unsigned would send the reader billions of groups past the
  # end.
  set sub [binary format SuSuIuIuIu 12 0 16 0 1000000]
  set cmap [binary format SuSuSuSuIu 0 1 3 10 12]$sub
  set face [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable] cmap $cmap]]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse $face}
} -result {TCLPDF FONT DAMAGED cmap}

test sfnt-2.4 {a cmap announcing more subtables than it holds} -body {
  # The count steers a loop and is believed only as far as the file reaches.
  set cmap [binary format SuSuSuSuIu 0 5 3 1 12][binary format SuSuSu 4 0 0]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable] cmap $cmap]]}
} -result {TCLPDF FONT DAMAGED cmap}

test sfnt-2.5 {a cmap subtable offset that leaves the file} -body {
  # The record's offset is counted from the start of the cmap table and is a
  # second thing the file states and may get wrong.
  set cmap [binary format SuSuSuSuIu 0 1 3 1 60000]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt parse \
      [sfntFile [list head [headTable] hhea [hheaTable] \
          hmtx [string repeat \x00 4] maxp [maxpTable] cmap $cmap]]}
} -result {TCLPDF FONT DAMAGED cmap}


# The bare CFF road, which is the one the codes were missing on when the
# format was built on 2026-08-24: every refusal in it reached font.tcl, which
# passed it on with no code at all.

test sfnt-3.1 {a bare CFF too short to hold a header} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt cffFont "abc"}
} -result {TCLPDF FONT SOURCE cff}

test sfnt-3.2 {a CFF2 is a format of its own and is named as one} -body {
  # Header version 2.0 - the variable-font CFF, a different table with a
  # different charstring interpreter, not a damaged CFF.
  # Eight bytes is the least this reader looks at, so the fixture is that
  # long - a shorter one is refused as a source before the version is read.
  ::tclpdfTest::refusalCode {::tclpdf::sfnt cffFont [binary format cccc 2 0 5 2][string repeat \x00 4]}
} -result {TCLPDF FONT UNSUPPORTED cff2}

test sfnt-3.3 {a header version that is neither 1 nor 2} -body {
  ::tclpdfTest::refusalCode {::tclpdf::sfnt cffFont [binary format cccc 9 0 4 2][string repeat \x00 4]}
} -result {TCLPDF FONT SOURCE cff}

test sfnt-3.4 {a CFF whose Top DICT INDEX is empty} -body {
  # A correct header, a Name INDEX with one entry, and then a Top DICT INDEX
  # declaring no entries - the face has no dictionary and no charstrings.
  set header [binary format ccccc 1 0 4 2 0]
  set nameIndex [binary format SucIucc 1 1 1 2 65]
  set topIndex [binary format Su 0]
  ::tclpdfTest::refusalCode {::tclpdf::sfnt cffFont $header$nameIndex$topIndex}
} -result {TCLPDF FONT DAMAGED cff}


test sfnt-3.5 {a CFF2 reaches the CFF reader rather than the sfnt reader} -body {
  # A regression against a defect measured on 2026-08-24: [isBareCff] asked
  # for major version 1, so a CFF2 fell through to the sfnt reader and came
  # back as "not a TrueType or OpenType font". The accurate refusal existed
  # and could not be reached from [font embed] - which is where a caller
  # stands. Asked here through the recogniser, and through the document in
  # font.test, because the two are what the road is made of.
  ::tclpdf::sfnt isBareCff [binary format cccc 2 0 5 0][string repeat \x00 4]
} -result 1

test sfnt-3.6 {and an sfnt is still not mistaken for one} -body {
  # The four sfnt signatures all begin with a byte a CFF header cannot have.
  list [::tclpdf::sfnt isBareCff [wholeFace]] \
      [::tclpdf::sfnt isBareCff "OTTO[string repeat \x00 8]"] \
      [::tclpdf::sfnt isBareCff "ttcf[string repeat \x00 8]"]
} -result {0 0 0}


test sfnt-3.7 {a CFF of an unknown header version reaches the CFF reader too} -body {
  # The CFF2 fix of 2026-08-24 stopped at version 2, so a bare CFF of version
  # 3 still fell through to the sfnt reader and came back as "not a TrueType
  # or OpenType font" - the wrong reader named, and doc/tclpdf.md makes that
  # third word the reader a script retries on. The recogniser stops one
  # version past the two the format has, because the sfnt signatures read as
  # majors 0, 79 and 116 and admitting any non-zero major would claim every
  # OTTO file for the CFF reader.
  set three [binary format cccc 3 0 4 2][string repeat \x00 4]
  list [::tclpdf::sfnt isBareCff $three] \
      [::tclpdfTest::refusalCode {::tclpdf::sfnt cffFont $three}] \
      [::tclpdf::sfnt isBareCff "OTTO[string repeat \x00 8]"]
} -result {1 {TCLPDF FONT SOURCE cff} 0}


test sfnt-4.1 {the classes are disjoint, so a trap on one catches only it} -body {
  # The point of four classes rather than one: a caller that wants to fall
  # back on another face traps UNSUPPORTED, one that wants to report a broken
  # file traps DAMAGED, and neither sees the other.
  set codes {}
  foreach script {
    {::tclpdf::sfnt parse "not a font"}
    {::tclpdf::sfnt cffFont [binary format cccc 2 0 5 2][string repeat \x00 4]}
  } {
    lappend codes [lindex [::tclpdfTest::refusalCode $script] 2]
  }
  set codes
} -result {SOURCE UNSUPPORTED}

test sfnt-4.2 {every refusal in the module carries a code} -body {
  # The measurement that made this file necessary, kept as a test: a refusal
  # with no -errorcode is invisible to trap.
  ::tclpdfTest::refusalsWithoutCode sfnt.tcl
} -result 0


# -- round 7: which cmap, and the top of a charstring ------------------------

# A cmap subtable format 4 that covers one character, and a format 12 that
# covers two - built so that a test can say which of two records the reader
# took by asking how many characters it found.
proc cmapFormat4 {code glyph} {
  # One segment plus the mandatory 0xFFFF terminator, addressed through
  # idDelta: endCode, the reserved pad, startCode, idDelta, idRangeOffset.
  set body [binary format SuSu $code 0xFFFF]
  append body [binary format Su 0]
  append body [binary format SuSu $code 0xFFFF]
  append body [binary format SS [expr {$glyph - $code}] 1]
  append body [binary format SuSu 0 0]
  # format, length, language, segCountX2 and the three search hints nobody
  # here reads.
  return [binary format SuSuSuSuSuSuSu 4 [expr {14 + [string length $body]}] \
      0 4 0 0 0]$body
}

proc cmapFormat12 {groups} {
  set body {}
  foreach {first last glyph} $groups {
    append body [binary format IuIuIu $first $last $glyph]
  }
  return [binary format SuSuIuIuIu 12 0 [expr {16 + [string length $body]}] \
      0 [expr {[llength $groups] / 3}]]$body
}

# A cmap table out of records: {platform encoding subtable ...}.
proc cmapTable {records} {
  set count [expr {[llength $records] / 3}]
  set header [binary format SuSu 0 $count]
  set offset [expr {4 + $count * 8}]
  set directory {}
  set body {}
  foreach {platform encoding subtable} $records {
    append directory [binary format SuSuIu $platform $encoding $offset]
    append body $subtable
    incr offset [string length $subtable]
  }
  return $header$directory$body
}

test sfnt-5.1 {a (0,4) table in format 12 beats a BMP-only (3,1)} -body {
  # OpenType: (0,4) is "Unicode 2.0+, full repertoire", and HarfBuzz reads it
  # before (3,1). The Windows records used to be ranked above EVERY
  # platform-0 record, so a face carrying both answered 5370 characters
  # instead of 5918 and refused U+1F600, which it has.
  set face [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable 4] \
      cmap [cmapTable [list 3 1 [cmapFormat4 65 1] \
          0 4 [cmapFormat12 {65 65 1 128512 128512 2}]]]]]
  set cmap [dict get [::tclpdf::sfnt parse $face] cmap]
  list [dict size $cmap] [dict exists $cmap 128512]
} -result {2 1}

test sfnt-5.2 {a (3,10) table still wins, and a lone (3,1) is taken} -body {
  # The order is HarfBuzz's whole order, not a swap of two entries.
  set full [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable 4] \
      cmap [cmapTable [list 0 4 [cmapFormat12 {65 65 1}] \
          3 10 [cmapFormat12 {65 65 1 128512 128512 2}]]]]]
  set bmp [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable 4] \
      cmap [cmapTable [list 3 1 [cmapFormat4 65 1]]]]]
  list [dict size [dict get [::tclpdf::sfnt parse $full] cmap]] \
      [dict size [dict get [::tclpdf::sfnt parse $bmp] cmap]]
} -result {2 1}

test sfnt-5.3 {a preferred record in a format nobody reads falls through} -body {
  # A face whose best record is format 6 or 13 is not refused for a table it
  # carries an alternative to - the refusal comes only when none of them can
  # be read, and it names the format of the best candidate.
  set unreadable [binary format SuSuSu 6 10 0][string repeat \x00 4]
  set mixed [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable 4] \
      cmap [cmapTable [list 3 10 $unreadable 3 1 [cmapFormat4 65 1]]]]]
  set hopeless [sfntFile [list head [headTable] hhea [hheaTable] \
      hmtx [string repeat \x00 4] maxp [maxpTable 4] \
      cmap [cmapTable [list 3 10 $unreadable]]]]
  list [dict size [dict get [::tclpdf::sfnt parse $mixed] cmap]] \
      [::tclpdfTest::refusalCode {::tclpdf::sfnt parse $hopeless}]
} -result {1 {TCLPDF FONT UNSUPPORTED cmap 6}}

test sfnt-5.4 {the top of a charstring is the letter, not the whole face} \
    -constraints haveOtf -body {
  # A CFF states no cap height - no head, no OS/2, nothing but the FontBBox
  # of the whole face, whose upper edge is the top of the Aring. Measured
  # against fontTools' ControlBoundsPen over the 30 CFF faces in this tree:
  # the same number for every H.
  set parsed [::tclpdf::sfnt read $::otf]
  set program [::tclpdf::sfnt cffFont [::tclpdf::sfnt table $parsed "CFF "]]
  list [dict get $program tops H] [dict get $program tops d] \
      [lindex [dict get $program bbox] 3]
} -result {729 729 1075}

test sfnt-5.5 {a face with no H states no top for it} -constraints haveOtf -body {
  # ZapfDingbats has no letters at all, so the dictionary is empty rather
  # than filled with a guess - the descriptor then falls back as it always
  # did.
  set dingbats [file join [file dirname [file dirname [file normalize \
      [info script]]]] examples assets fonts urw-core35-fonts D050000L.otf]
  if {![file exists $dingbats]} {
    return {}
  }
  set parsed [::tclpdf::sfnt read $dingbats]
  dict get [::tclpdf::sfnt cffFont \
      [::tclpdf::sfnt table $parsed "CFF "]] tops
} -result {}

# --- collections and the channel-backed reader ------------------------------
#
# A collection is a directory of faces that SHARE their tables, so a face of
# one is not a slice of the file and cannot be handed on as one. [parse] and
# [openFace] rebuild it as a standalone sfnt; what these check is that the
# right face comes out, that a number the file has not got is refused with the
# count in the message, and that a face read by range answers exactly what the
# same face read whole answers.

test sfnt-6.1 {a collection named by face number is read} -constraints haveFont \
    -body {
  # Two faces of the same file, told apart by a table that is in one of them
  # and not in the other. What is measured is which directory came out, which
  # is the whole of what a face IS.
  set first [::tclpdfTest::sfntWith $fontRegular {}]
  set second [::tclpdfTest::sfntWith $fontRegular \
      [dict create Zzzz "a table of the second face alone"]]
  set bytes [::tclpdfTest::collection [list $first $second]]
  set a [::tclpdf::sfnt parse $bytes 0]
  set b [::tclpdf::sfnt parse $bytes 1]
  list [dict exists [dict get $a tables] Zzzz] \
      [dict exists [dict get $b tables] Zzzz] \
      [dict get $a unitsPerEm] [dict get $b unitsPerEm] \
      [::tclpdf::sfnt table $b Zzzz]
} -result {0 1 2048 2048 {a table of the second face alone}}

test sfnt-6.2 {the rebuilt face is a font in its own right} -constraints haveFont \
    -body {
  # Everything the parser needs comes out of the rebuilt directory, and the
  # tables are the file's own bytes: a /FontFile2 written from this is a face
  # and not a collection.
  set bytes [::tclpdfTest::collection \
      [list [::tclpdfTest::sfntWith $fontRegular {}]]]
  set face [::tclpdf::sfnt parse $bytes 0]
  set whole [::tclpdf::sfnt read $fontRegular]
  list [string range [dict get $face bytes] 0 3] \
      [expr {[dict get $face numGlyphs] == [dict get $whole numGlyphs]}] \
      [expr {[::tclpdf::sfnt table $face head]
          eq [::tclpdf::sfnt table $whole head]}] \
      [expr {[::tclpdf::sfnt table $face glyf]
          eq [::tclpdf::sfnt table $whole glyf]}]
} -result "\x00\x01\x00\x00 1 1 1"

test sfnt-6.3 {a collection with no face named is refused, and says how to
    get on} -constraints haveFont -body {
  set bytes [::tclpdfTest::collection \
      [list [::tclpdfTest::sfntWith $fontRegular {}]]]
  set code [catch {::tclpdf::sfnt parse $bytes} message options]
  list $code [dict get $options -errorcode] [string match {*-face*} $message]
} -result {1 {TCLPDF FONT UNSUPPORTED collection} 1}

test sfnt-6.4 {a face number the collection has not got is refused, with the
    count in the message} -constraints haveFont -body {
  set bytes [::tclpdfTest::collection [list \
      [::tclpdfTest::sfntWith $fontRegular {}] \
      [::tclpdfTest::sfntWith $fontRegular {}]]]
  set code [catch {::tclpdf::sfnt parse $bytes 2} message options]
  list $code [dict get $options -errorcode] [string match {*0 to 1*} $message]
} -result {1 {TCLPDF FONT FACE 2} 1}

test sfnt-6.5 {and so is a number that is not one} -constraints haveFont -body {
  set bytes [::tclpdfTest::collection \
      [list [::tclpdfTest::sfntWith $fontRegular {}]]]
  set code [catch {::tclpdf::sfnt parse $bytes second} - options]
  list $code [dict get $options -errorcode]
} -result {1 {TCLPDF FONT FACE second}}

test sfnt-6.6 {a single face is face 0, and any other number is refused} \
    -constraints haveFont -body {
  set bytes [::tclpdfTest::readBytes $fontRegular]
  set zero [::tclpdf::sfnt parse $bytes 0]
  set code [catch {::tclpdf::sfnt parse $bytes 1} message options]
  list [expr {[dict get $zero numGlyphs] > 0}] $code \
      [dict get $options -errorcode] [string match {*single face*} $message]
} -result {1 1 {TCLPDF FONT FACE 1} 1}

test sfnt-7.1 {an ordinary face opened by range is the file itself} \
    -constraints haveFont -body {
  # NOTHING IS REBUILT where there is nothing to gain: a file that is not a
  # collection and carries no bitmap table is read whole, exactly as [read]
  # reads it, so that a face embedded without a subset is the file's own bytes
  # down to the byte.
  set opened [::tclpdf::sfnt openFace $fontRegular]
  set whole [::tclpdf::sfnt read $fontRegular]
  set same [expr {[dict get $opened bytes] eq [dict get $whole bytes]}]
  set held [dict exists $opened channel]
  ::tclpdf::sfnt closeFace $opened
  list $same $held
} -result {1 0}

test sfnt-7.2 {a face with a bitmap table keeps it in the file and reads it by
    range} -constraints haveFont -body {
  set table [::tclpdfTest::sbix 40 [list 32 [dict create \
      4 [list 0 0 "png " [::tclpdfTest::sbixPng 6 6]]]]]
  set path [::tclpdfTest::scratch sfnt-sbix.ttf]
  set channel [open $path wb]
  puts -nonewline $channel [::tclpdfTest::sfntWith $fontRegular \
      [dict create sbix $table]]
  close $channel
  set face [::tclpdf::sfnt openFace $path]
  set streamed [dict get $face streamed]
  # It is NOT in memory - and [table] says so rather than answering the empty
  # string, which would tell a caller the face has no sbix.
  set code [catch {::tclpdf::sfnt table $face sbix} - options]
  set extent [::tclpdf::sfnt extent $face sbix]
  set slice [::tclpdf::sfnt slice $face sbix 0 8]
  set hasTable [::tclpdf::sfnt hasTable $face sbix]
  set held [dict exists $face channel]
  ::tclpdf::sfnt closeFace $face
  file delete $path
  list $streamed $code [dict get $options -errorcode] \
      [expr {$extent == [string length $table]}] \
      [expr {$slice eq [string range $table 0 7]}] $hasTable $held
} -result {sbix 1 {TCLPDF FONT STREAMED sbix} 1 1 1 1}

test sfnt-7.3 {a range past the end of a table comes back short} \
    -constraints haveFont -body {
  # The same rule [binary scan] follows: the caller reading a record is the
  # one that knows what a short one means.
  set face [::tclpdf::sfnt openFace $fontRegular]
  set head [::tclpdf::sfnt extent $face head]
  set slice [::tclpdf::sfnt slice $face head [expr {$head - 4}] 100]
  set past [::tclpdf::sfnt slice $face head 1000 4]
  ::tclpdf::sfnt closeFace $face
  list $head [string length $slice] [string length $past]
} -result {54 4 0}

test sfnt-7.4 {closing a face twice is closing it once} -constraints haveFont \
    -body {
  # A caller unwinding through several [finally] clauses must not have to know
  # whether the face it holds carries a handle.
  set face [::tclpdf::sfnt openFace $fontRegular]
  ::tclpdf::sfnt closeFace $face
  ::tclpdf::sfnt closeFace $face
  ::tclpdf::sfnt closeFace [::tclpdf::sfnt read $fontRegular]
} -result {}

cleanupTests

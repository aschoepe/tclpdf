# varFont.test --
#
# Reading the variation tables of a variable font.
#
# NO VARIABLE FONT IS CHECKED IN, and that is the awkward part of this module:
# measured on this machine, 0 of 205 fonts under the user's own directories
# carry an fvar table, and the 29 that do are Apple's system faces, which may
# not be redistributed. So the tests split in two:
#
#   the arithmetic  - normalising an axis value, the piecewise avar mapping -
#                     needs no font at all and is tested against constructed
#                     axes. That is where the errors would be.
#   the parsing     - fvar and its named instances - is tested against a system
#                     font where one is present, and skips where it is not.
#
# What that leaves uncovered on another machine is the byte layout of fvar.
# Named rather than glossed over: it wants a font in the tree, and which one
# that is is the author's call.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::sfnt
package require tclpdf::varFont
source [file join [file dirname [info script]] helper.tcl]

# A system font that varies, if this machine has one.
set variableFont {}
foreach candidate {/System/Library/Fonts/NewYork.ttf
                   /System/Library/Fonts/SFNSMono.ttf} {
  if {[file readable $candidate]} {
    set variableFont $candidate
    break
  }
}
testConstraint haveVariable [expr {$variableFont ne {}}]

test varFont-1.1 {the default value is the middle of the scale} -body {
  # The one value every axis has, and the only one where both sides agree.
  set axis {wght 100 400 900 0 256}
  ::tclpdf::varFont normalise $axis 400
} -result 0.0

test varFont-1.2 {the two sides of the default are scaled separately} -body {
  # THE point of the arithmetic, and the easy thing to get wrong. An axis
  # running 100 .. 400 .. 900 has 300 user units below the default and 500
  # above. Halfway down is 250, halfway up is 650 - not 400 plus or minus the
  # same amount. Scaling both sides by the full range would put 250 at -0.1875
  # instead of -0.5, and every weight below the default would come out too
  # light.
  set axis {wght 100 400 900 0 256}
  list [::tclpdf::varFont normalise $axis 250] \
      [::tclpdf::varFont normalise $axis 650] \
      [::tclpdf::varFont normalise $axis 100] \
      [::tclpdf::varFont normalise $axis 900]
} -result {-0.5 0.5 -1.0 1.0}

test varFont-1.3 {a value outside the axis is clamped, not extrapolated} -body {
  # Extrapolating past the ends is what produces outlines the designer never
  # drew - the format says the range is the range.
  set axis {wght 100 400 900 0 256}
  list [::tclpdf::varFont normalise $axis 50] [::tclpdf::varFont normalise $axis 2000]
} -result {-1.0 1.0}

test varFont-1.4 {an axis whose default sits on an end does not divide by zero} -body {
  # New York has one: opsz runs 12 .. 256 .. 256, so there is no room above
  # the default at all. Dividing by that range is a division by zero, and the
  # answer for anything at or above the default is simply 0.
  set axis {opsz 12 256 256 0 256}
  list [::tclpdf::varFont normalise $axis 256] \
      [::tclpdf::varFont normalise $axis 300] \
      [::tclpdf::varFont normalise $axis 12] \
      [::tclpdf::varFont normalise $axis 134]
} -result {0.0 0.0 -1.0 -0.5}

test varFont-2.1 {the avar mapping bends a value and keeps its ends} -body {
  # A designer may say the middle of the slider is not the middle of the
  # design. The mapping is piecewise linear and the ends are fixed points; a
  # value between two knots is interpolated between them.
  set from {-1.0 0.0 0.5 1.0}
  set to {-1.0 0.0 0.8 1.0}
  list [::tclpdf::varFont::Piecewise -1.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.5 $from $to] \
      [::tclpdf::varFont::Piecewise 1.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.25 $from $to]
} -result {-1.0 0.0 0.8 1.0 0.4}

test varFont-2.2 {a mapping with fewer than two knots is left alone} -body {
  list [::tclpdf::varFont::Piecewise 0.3 {} {}] \
      [::tclpdf::varFont::Piecewise 0.3 {0.0} {0.5}]
} -result {0.3 0.3}

test varFont-3.1 {a variable font is recognised and its axes read} -constraints haveVariable -body {
  set parsed [::tclpdf::sfnt read $::variableFont]
  set axes [::tclpdf::varFont axes $parsed]
  set faults {}
  foreach axis $axes {
    lassign $axis tag minimum default maximum
    if {[string length $tag] != 4} {
      lappend faults "tag \"$tag\" is not four characters"
    }
    if {$minimum > $default || $default > $maximum} {
      lappend faults "$tag: $minimum .. $default .. $maximum is not ordered"
    }
  }
  list [::tclpdf::varFont isVariable $parsed] [expr {[llength $axes] > 0}] $faults
} -result {1 1 {}}

test varFont-3.2 {a static font is not mistaken for a variable one} -body {
  set path [file join [file dirname [file dirname [file normalize [info script]]]] \
      examples assets fonts DejaVuSans.ttf]
  ::tclpdf::varFont isVariable [::tclpdf::sfnt read $path]
} -result 0

test varFont-3.3 {the named instances sit inside their axes} -constraints haveVariable -body {
  # An instance names a point per axis, and every coordinate has to lie within
  # that axis - an instance outside its own range would be a parsing error
  # rather than a font error. The record length is the trap: the PostScript
  # name id is optional, and reading it unconditionally takes two bytes off
  # the next instance, which then reads as garbage.
  set parsed [::tclpdf::sfnt read $::variableFont]
  set ranges {}
  foreach axis [::tclpdf::varFont axes $parsed] {
    dict set ranges [lindex $axis 0] [lrange $axis 1 3]
  }
  set faults {}
  foreach instance [::tclpdf::varFont instances $parsed] {
    foreach {tag value} [lindex $instance 1] {
      lassign [dict get $ranges $tag] minimum - maximum
      if {$value < $minimum || $value > $maximum} {
        lappend faults "$tag $value outside $minimum .. $maximum"
      }
    }
  }
  list [expr {[llength [::tclpdf::varFont instances $parsed]] > 0}] \
      [lrange $faults 0 2]
} -result {1 {}}

test varFont-3.4 {coordinates covers every axis, named or not} -constraints haveVariable -body {
  # The result is a list in fvar order rather than a dictionary, because gvar
  # and avar refer to axes by position. An axis the caller does not mention
  # stays at its default, which is 0 after normalising - so naming one axis is
  # enough.
  set parsed [::tclpdf::sfnt read $::variableFont]
  set axes [::tclpdf::varFont axes $parsed]
  set values [::tclpdf::varFont coordinates $parsed {wght 100000}]
  set faults {}
  foreach value $values {
    if {$value < -1.0 || $value > 1.0} {
      lappend faults "normalised value $value is outside -1 .. 1"
    }
  }
  list [expr {[llength $values] == [llength $axes]}] $faults
} -result {1 {}}

cleanupTests

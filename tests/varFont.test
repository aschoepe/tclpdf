# varFont.test --
#
# Reading the variation tables of a variable font.
#
# The tests come in three kinds, because the three parts fail differently:
#
#   the arithmetic  - normalising an axis value, the piecewise avar mapping,
#                     the interpolation of unreferenced points - needs no font
#                     at all and is checked against constructed cases. That is
#                     where the errors would be, and a constructed case can
#                     hold a shape no shipped font offers in isolation.
#   the instancing  - checked against Roboto-Variable in the tree, at its
#                     default (where nothing may move) and away from it (where
#                     something must).
#   the parsing     - fvar and its named instances against a system font where
#                     one is present, and skipped where it is not.
#
# The strongest check is NOT here and cannot be: the outlines were compared
# point by point against an independent implementation over five faces and six
# instances - 11 235 glyphs, no difference. That needs fontTools, which is not
# a dependency of this package. What it measured is recorded in TODO.md.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::sfnt
package require tclpdf::varFont
source [file join [file dirname [info script]] helper.tcl]

# A system font that varies, if this machine has one.
set variableFont {}
foreach candidate {/System/Library/Fonts/NewYork.ttf
                   /System/Library/Fonts/SFNSMono.ttf} {
  if {[file readable $candidate]} {
    set variableFont $candidate
    break
  }
}
testConstraint haveVariable [expr {$variableFont ne {}}]

test varFont-1.1 {the default value is the middle of the scale} -body {
  # The one value every axis has, and the only one where both sides agree.
  set axis {wght 100 400 900 0 256}
  ::tclpdf::varFont normalise $axis 400
} -result 0.0

test varFont-1.2 {the two sides of the default are scaled separately} -body {
  # THE point of the arithmetic, and the easy thing to get wrong. An axis
  # running 100 .. 400 .. 900 has 300 user units below the default and 500
  # above. Halfway down is 250, halfway up is 650 - not 400 plus or minus the
  # same amount. Scaling both sides by the full range would put 250 at -0.1875
  # instead of -0.5, and every weight below the default would come out too
  # light.
  set axis {wght 100 400 900 0 256}
  list [::tclpdf::varFont normalise $axis 250] \
      [::tclpdf::varFont normalise $axis 650] \
      [::tclpdf::varFont normalise $axis 100] \
      [::tclpdf::varFont normalise $axis 900]
} -result {-0.5 0.5 -1.0 1.0}

test varFont-1.3 {a value outside the axis is clamped, not extrapolated} -body {
  # Extrapolating past the ends is what produces outlines the designer never
  # drew - the format says the range is the range.
  set axis {wght 100 400 900 0 256}
  list [::tclpdf::varFont normalise $axis 50] [::tclpdf::varFont normalise $axis 2000]
} -result {-1.0 1.0}

test varFont-1.4 {an axis whose default sits on an end does not divide by zero} -body {
  # New York has one: opsz runs 12 .. 256 .. 256, so there is no room above
  # the default at all. Dividing by that range is a division by zero, and the
  # answer for anything at or above the default is simply 0.
  set axis {opsz 12 256 256 0 256}
  list [::tclpdf::varFont normalise $axis 256] \
      [::tclpdf::varFont normalise $axis 300] \
      [::tclpdf::varFont normalise $axis 12] \
      [::tclpdf::varFont normalise $axis 134]
} -result {0.0 0.0 -1.0 -0.5}

test varFont-2.1 {the avar mapping bends a value and keeps its ends} -body {
  # A designer may say the middle of the slider is not the middle of the
  # design. The mapping is piecewise linear and the ends are fixed points; a
  # value between two knots is interpolated between them.
  set from {-1.0 0.0 0.5 1.0}
  set to {-1.0 0.0 0.8 1.0}
  list [::tclpdf::varFont::Piecewise -1.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.5 $from $to] \
      [::tclpdf::varFont::Piecewise 1.0 $from $to] \
      [::tclpdf::varFont::Piecewise 0.25 $from $to]
} -result {-1.0 0.0 0.8 1.0 0.4}

test varFont-2.2 {a mapping with fewer than two knots is left alone} -body {
  list [::tclpdf::varFont::Piecewise 0.3 {} {}] \
      [::tclpdf::varFont::Piecewise 0.3 {0.0} {0.5}]
} -result {0.3 0.3}

test varFont-3.1 {a variable font is recognised and its axes read} -constraints haveVariable -body {
  set parsed [::tclpdf::sfnt read $::variableFont]
  set axes [::tclpdf::varFont axes $parsed]
  set faults {}
  foreach axis $axes {
    lassign $axis tag minimum default maximum
    if {[string length $tag] != 4} {
      lappend faults "tag \"$tag\" is not four characters"
    }
    if {$minimum > $default || $default > $maximum} {
      lappend faults "$tag: $minimum .. $default .. $maximum is not ordered"
    }
  }
  list [::tclpdf::varFont isVariable $parsed] [expr {[llength $axes] > 0}] $faults
} -result {1 1 {}}

test varFont-3.2 {a static font is not mistaken for a variable one} -body {
  set path [file join [file dirname [file dirname [file normalize [info script]]]] \
      examples assets fonts DejaVuSans.ttf]
  ::tclpdf::varFont isVariable [::tclpdf::sfnt read $path]
} -result 0

test varFont-3.3 {the named instances sit inside their axes} -constraints haveVariable -body {
  # An instance names a point per axis, and every coordinate has to lie within
  # that axis - an instance outside its own range would be a parsing error
  # rather than a font error. The record length is the trap: the PostScript
  # name id is optional, and reading it unconditionally takes two bytes off
  # the next instance, which then reads as garbage.
  set parsed [::tclpdf::sfnt read $::variableFont]
  set ranges {}
  foreach axis [::tclpdf::varFont axes $parsed] {
    dict set ranges [lindex $axis 0] [lrange $axis 1 3]
  }
  set faults {}
  foreach instance [::tclpdf::varFont instances $parsed] {
    foreach {tag value} [lindex $instance 1] {
      lassign [dict get $ranges $tag] minimum - maximum
      if {$value < $minimum || $value > $maximum} {
        lappend faults "$tag $value outside $minimum .. $maximum"
      }
    }
  }
  list [expr {[llength [::tclpdf::varFont instances $parsed]] > 0}] \
      [lrange $faults 0 2]
} -result {1 {}}

test varFont-3.4 {coordinates covers every axis, named or not} -constraints haveVariable -body {
  # The result is a list in fvar order rather than a dictionary, because gvar
  # and avar refer to axes by position. An axis the caller does not mention
  # stays at its default, which is 0 after normalising - so naming one axis is
  # enough.
  set parsed [::tclpdf::sfnt read $::variableFont]
  set axes [::tclpdf::varFont axes $parsed]
  set values [::tclpdf::varFont coordinates $parsed {wght 100000}]
  set faults {}
  foreach value $values {
    if {$value < -1.0 || $value > 1.0} {
      lappend faults "normalised value $value is outside -1 .. 1"
    }
  }
  list [expr {[llength $values] == [llength $axes]}] $faults
} -result {1 {}}

# A face from the tree, parsed. The variable ones live beside the examples.
proc variableFace {name} {
  set here [file dirname [file dirname [file normalize [info script]]]]
  return [::tclpdf::sfnt read [file join $here examples assets fonts $name]]
}

proc outlineOf {font id} {
  set data [::tclpdfTest::glyph $font $id]
  if {$data eq {}} {
    return {}
  }
  return [::tclpdf::glyfOutline parse $data]
}

test varFont-12.1 {at the default position nothing moves at all} -body {
  # The one invariant that holds for every variable font without knowing
  # anything about its design: what sits in glyf IS the default instance, so
  # asking for it must produce no delta anywhere.
  package require tclpdf::glyfOutline
  set font [variableFace Roboto-Variable.ttf]
  set defaults {}
  foreach axis [::tclpdf::varFont axes $font] {
    lappend defaults [lindex $axis 0] [lindex $axis 2]
  }
  set coordinates [::tclpdf::varFont coordinates $font $defaults]
  set moved 0
  set checked 0
  set count [expr {[llength [dict get $font loca]] - 1}]
  for {set id 0} {$id < $count && $checked < 200} {incr id} {
    set outline [outlineOf $font $id]
    if {![dict size $outline] || [dict get $outline type] ne "simple"} {
      continue
    }
    incr checked
    set result [::tclpdf::varFont instance $font $id $outline $coordinates]
    set after [dict get $result outline]
    if {[dict get $after x] ne [dict get $outline x] ||
        [dict get $after y] ne [dict get $outline y] ||
        [dict get $result advance] != [::tclpdf::sfnt advance $font $id]} {
      incr moved
    }
  }
  list [expr {$checked == 200}] $moved
} -result {1 0}

test varFont-12.2 {away from the default the outline and the advance change} -body {
  # The counter-direction: if nothing moved here, 12.1 would pass on a broken
  # implementation that simply returns its input.
  set font [variableFace Roboto-Variable.ttf]
  set id [dict get [dict get $font cmap] 72]
  set outline [outlineOf $font $id]
  set heavy [::tclpdf::varFont instance $font $id $outline \
      [::tclpdf::varFont coordinates $font {wght 900}]]
  set light [::tclpdf::varFont instance $font $id $outline \
      [::tclpdf::varFont coordinates $font {wght 100}]]
  list [expr {[dict get $heavy outline] ne [dict get $light outline]}] \
      [expr {[dict get $heavy advance] > [dict get $light advance]}]
} -result {1 1}

test varFont-12.3 {a width axis moves the outline sideways only} -body {
  # wdth is horizontal by construction, and a y delta from it would mean the
  # axes have been mixed up somewhere between fvar and gvar.
  set font [variableFace Roboto-Variable.ttf]
  set id [dict get [dict get $font cmap] 72]
  set outline [outlineOf $font $id]
  set narrow [::tclpdf::varFont instance $font $id $outline \
      [::tclpdf::varFont coordinates $font {wdth 75}]]
  list [expr {[dict get $narrow outline x] ne [dict get $outline x]}] \
      [expr {[dict get $narrow outline y] eq [dict get $outline y]}]
} -result {1 1}

test varFont-12.4 {a composite moves its components, not its points} -body {
  set font [variableFace Roboto-Variable.ttf]
  set id [dict get [dict get $font cmap] 228]
  set outline [outlineOf $font $id]
  set moved [dict get [::tclpdf::varFont instance $font $id $outline \
      [::tclpdf::varFont coordinates $font {wght 900}]] outline]
  set shifted 0
  foreach before [dict get $outline components] after [dict get $moved components] {
    if {[lindex $before 2] ne [lindex $after 2]} {
      incr shifted
    }
    # The component still points at the same glyph and keeps its transform.
    if {[lindex $before 1] != [lindex $after 1]} {
      error "component renumbered"
    }
  }
  list [dict get $moved type] [expr {$shifted > 0}]
} -result {composite 1}

test varFont-12.5 {the interpolation is actually applied while reading gvar} -body {
    # Interpolate is exercised directly above, but nothing checked that the
    # tuple reader CALLS it - measured, switching it off left every test green
    # while 101 of Roboto's 583 simple glyphs came out wrong, by up to 153
    # units.
    #
    # The hyphen is the smallest glyph that needs it: four points, of which a
    # tuple names two. The values below are not chosen, they are the outcome
    # verified point by point against an independent implementation.
  set font [variableFace Roboto-Variable.ttf]
  set id [dict get [dict get $font cmap] 45]
  set outline [outlineOf $font $id]
  set moved [dict get [::tclpdf::varFont instance $font $id $outline \
      [::tclpdf::varFont coordinates $font {wght 700 wdth 100}]] outline]
  list [llength [dict get $outline x]] [dict get $outline x] [dict get $moved x]
} -result {4 {526 526 38 38} {680 680 115 115}}

test varFont-12.6 {an empty glyph varies its advance too} -body {
  # The space has no outline and it still has an advance, and the advance
  # varies: gvar carries the four phantom points for it like for any glyph.
  # It used to be left out of the instanced set, so it measured the default
  # 508 at every weight; the numbers here are fontTools' instancer's, glyph
  # for glyph - 490 at wght 100, 499 at 300, 508 at 400, 509 at 700, 510 at
  # 900 - and this was the one advance out of Roboto's 1326 that disagreed.
  set font [variableFace Roboto-Variable.ttf]
  set space [dict get [dict get $font cmap] 32]
  set advances {}
  foreach weight {100 300 400 700 900} {
    set all [::tclpdf::varFont all $font \
        [::tclpdf::varFont coordinates $font [list wght $weight]]]
    lappend advances [expr {[dict exists $all $space] ?
        [dict get $all $space advance] : "missing"}]
  }
  list $advances [expr {[dict get $all $space bytes] eq {}}]
} -result {{490 499 508 509 510} 1}

test varFont-13.1 {rounding follows the format, not Tcl} -body {
  # The standard: for fractional values of 0.5 and higher take the next higher
  # integer, otherwise truncate - that is towards +infinity, so -2.5 is -2.
  # Tcl's round() goes away from zero and answers -3.
  list [::tclpdf::varFont::Round -2.5] [::tclpdf::varFont::Round 2.5] \
      [::tclpdf::varFont::Round -2.6] [::tclpdf::varFont::Round -0.5]
} -result {-2 3 -3 0}

test varFont-13.2 {normalised coordinates are quantised to F2DOT14} -body {
  # The representation the format itself uses. Carrying full double precision
  # further computes with a point on the axis the font cannot express.
  set font [variableFace Roboto-Variable.ttf]
  set faults {}
  foreach value {700 550 123 900} {
    foreach coordinate [::tclpdf::varFont coordinates $font [list wght $value]] {
      set scaled [expr {$coordinate * 16384}]
      if {abs($scaled - round($scaled)) > 1e-9} {
        lappend faults $value
      }
    }
  }
  set faults
} -result {}

test varFont-14.1 {an unreferenced point is interpolated between its neighbours} -body {
  # Two named points 100 apart, one unnamed halfway between them: the delta
  # follows in proportion. Built rather than taken from a font, because no
  # font offers the case in isolation.
  set outline [dict create type simple ends {2} \
      x {0 50 100} y {0 0 0} flags {1 1 1} instructions {}]
  lassign [::tclpdf::varFont::Interpolate $outline 3 {0 2} {10 20} {0 0}] dx dy
  lindex $dx 1
} -result 15.0

test varFont-14.2 {outside the neighbours the nearer one wins} -body {
  # The point sits beyond both named points, so there is nothing to
  # interpolate along - it takes the delta of the one it is nearest to.
  set outline [dict create type simple ends {2} \
      x {0 200 100} y {0 0 0} flags {1 1 1} instructions {}]
  lassign [::tclpdf::varFont::Interpolate $outline 3 {0 2} {10 20} {0 0}] dx dy
  lindex $dx 1
} -result 20.0

test varFont-14.3 {neighbours at the same place agree or contribute nothing} -body {
  set same [dict create type simple ends {2} \
      x {50 0 50} y {0 0 0} flags {1 1 1} instructions {}]
  lassign [::tclpdf::varFont::Interpolate $same 3 {0 2} {7 7} {0 0}] agree ->
  lassign [::tclpdf::varFont::Interpolate $same 3 {0 2} {7 9} {0 0}] differ ->
  list [lindex $agree 1] [lindex $differ 1]
} -result {7.0 0.0}

test varFont-14.4 {a contour no delta mentions stays where it is} -body {
  # Two contours, only the first one named. The second must not drift - and
  # this is the case that separates per-contour interpolation from a global
  # one, which would drag it along.
  set outline [dict create type simple ends {1 3} \
      x {0 100 0 100} y {0 0 500 500} flags {1 1 1 1} instructions {}]
  lassign [::tclpdf::varFont::Interpolate $outline 4 {0 1} {10 10} {5 5}] dx dy
  list [lrange $dx 2 3] [lrange $dy 2 3]
} -result {{0.0 0.0} {0.0 0.0}}

test varFont-14.5 {one named point carries its whole contour} -body {
  set outline [dict create type simple ends {2} \
      x {0 50 100} y {0 0 0} flags {1 1 1} instructions {}]
  lassign [::tclpdf::varFont::Interpolate $outline 3 {1} {12} {-4}] dx dy
  list $dx $dy
} -result {{12.0 12.0 12.0} {-4.0 -4.0 -4.0}}

test varFont-15.1 {a named instance is called by its own PostScript name} -body {
  # fvar may give each named instance a PostScript name of its own, and Roboto
  # does: name id 6 says Roboto-Regular and names the default only. Asked for
  # by name or by the axis values that ARE that instance, the answer is the
  # same, because a reader is told which font this is either way.
  set font [variableFace Roboto-Variable.ttf]
  list [::tclpdf::varFont postScriptName $font {wght 700 wdth 100}] \
      [::tclpdf::varFont postScriptName $font {wght 700}] \
      [::tclpdf::varFont postScriptName $font {wght 100}] \
      [::tclpdf::varFont postScriptName $font {wdth 75}] \
      [::tclpdf::varFont postScriptName $font {}]
} -result {Roboto-Bold Roboto-Bold Roboto-Thin Roboto-CondensedRegular Roboto-Regular}

test varFont-15.2 {any other point is named by its axis values} -body {
  # Adobe TN 5902: the family prefix - name id 25 where the font has one -
  # then, per axis away from its default, an underscore, the value and the
  # tag. Integers as such, fractions without trailing zeros, defaults left
  # out: two documents naming the same point name the same font.
  set font [variableFace Roboto-Variable.ttf]
  list [::tclpdf::varFont postScriptName $font {wght 620}] \
      [::tclpdf::varFont postScriptName $font {wght 620 wdth 87.5}] \
      [::tclpdf::varFont postScriptName $font {wdth 87.5 wght 620}] \
      [::tclpdf::varFont postScriptName $font {wght 400 wdth 80}]
} -result {Roboto_620wght Roboto_620wght_87.5wdth Roboto_620wght_87.5wdth Roboto_80wdth}

test varFont-15.3 {an instance without a PostScript name of its own gets one built} -body {
  # NotoSansSymbols names its instances but gives none a PostScript name; the
  # note's rule is prefix, hyphen, subfamily name reduced to letters and
  # digits. Roboto's Condensed Bold would come out the same way as
  # Roboto-CondensedBold - here it is what the fvar record says.
  set font [variableFace NotoSansSymbols-Variable.ttf]
  list [::tclpdf::varFont postScriptName $font {wght 700}] \
      [::tclpdf::varFont postScriptName $font {wght 650}]
} -result {NotoSansSymbols-Bold NotoSansSymbols_650wght}

cleanupTests

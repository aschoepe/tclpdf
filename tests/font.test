# font.test --
#
# TrueType: parsing, subsetting and embedding.
#
# The CIDToGIDMap tests are regressions against a defect that produced a
# document qpdf called clean and pdffonts called complete - and whose extracted
# text was noise. Only reading the text back showed it.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::font
source [file join [file dirname [info script]] helper.tcl]

set fontRegular [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts DejaVuSans.ttf]

testConstraint haveFont [file exists $fontRegular]

# The same face as TrueType and as OpenType/CFF - which is what makes the two
# roads comparable rather than only exercisable.
set otf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.otf]
set otfTtf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.ttf]
testConstraint haveOtf [file exists $otf]
testConstraint haveOtfPair [expr {[file exists $otf] && [file exists $otfTtf]}]

# The Liberation set - metric copies of Arial, Times New Roman and Courier New,
# standing in for the standard 14 from the other lineage than URW.
set liberation [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts liberation-fonts]
testConstraint haveLiberation [file exists [file join $liberation LiberationSans-Regular.ttf]]

# A Type 1 face with its metrics beside it, for what [font info] says about
# a format that has no fsType.
set type1Face [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts tsukurimashou OCRB.pfb]
testConstraint haveType1 [file exists $type1Face]

test font-1.1 {a TrueType file is parsed} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  list [dict get $parsed unitsPerEm] \
      [expr {[dict get $parsed numGlyphs] > 1000}] \
      [dict get $parsed names postScript] \
      [dict get $parsed fsType]
} -result {2048 1 DejaVuSans 0}

test font-1.2 {fsType is translated into words} -body {
  list [::tclpdf::sfnt permission 0] [::tclpdf::sfnt permission 2] \
      [::tclpdf::sfnt permission 12]
} -match glob -result {{installable*} {restricted*} {unclear*}}

test font-1.3 {a CFF font is read, and says so} -constraints haveOtf -body {
  # OTTO used to be refused here. Everything in such a file except the
  # outlines is the same sfnt structure, so it is parsed like any other and
  # only the outline side is marked - what cannot be done with CFF (subsetting
  # through loca and glyf) is decided where it is done.
  set parsed [::tclpdf::sfnt read $::otf]
  list [dict get $parsed outlines] [dict get $parsed loca] \
      [expr {[dict size [dict get $parsed cmap]] > 100}] \
      [expr {[dict get $parsed numGlyphs] > 100}]
} -result {cff {} 1 1}

test font-1.3a {a TrueType font says so too} -constraints haveFont -body {
  # The other half, so the marking cannot quietly become constant.
  set parsed [::tclpdf::sfnt read $fontRegular]
  list [dict get $parsed outlines] [expr {[llength [dict get $parsed loca]] > 100}]
} -result {truetype 1}

test font-1.4 {something that is not a font at all} -body {
  ::tclpdf::sfnt parse "not a font file at all, really"
} -returnCodes error -match glob -result {*not a TrueType or OpenType font*}

# A TrueType collection, built rather than found - the same reason as the
# CID-keyed CFF face further down: the collections on this machine are macOS
# system fonts and may not be checked in. A collection is a whole sfnt of its
# own: the tag "ttcf", a version, the number of faces and one offset to each
# face's table directory. The refusal hangs on the tag alone, so the header is
# all it takes - and the header is what a real file starts with.
proc fontMakeCollectionHeader {{faces 2}} {
  set header [binary format a4II ttcf 0x00020000 $faces]
  # The offsets a real file would carry: the first directory begins right
  # after the header, the second one an arbitrary distance further on.
  for {set i 0} {$i < $faces} {incr i} {
    append header [binary format I [expr {12 + 4 * $faces + $i * 0x1000}]]
  }
  return $header
}

test font-1.5 {a TrueType collection is refused, and says how to get on} -body {
  ::tclpdf::sfnt parse [fontMakeCollectionHeader]
} -returnCodes error -match glob -result {*TrueType collection*extract the single face*}

test font-1.5a {and it is the tag that decides, not the rest of the header} -body {
  # The same bytes with the tag of a plain TrueType file: the parse gets past
  # the signature and fails further in, on a table directory that is none.
  # Without this the collection test would still pass if the refusal came out
  # of some other branch by accident.
  set bytes [fontMakeCollectionHeader]
  set plain [string replace $bytes 0 3 [binary format I 0x00010000]]
  set message {}
  catch {::tclpdf::sfnt parse $plain} message
  list [string match {*TrueType collection*} $message] \
      [string match {tclpdf:*} $message]
} -result {0 1}

test font-1.6 {a table directory that ends in the middle is named, not crashed on} -body {
  # Found by the test above: binary scan fills what it can and leaves the rest
  # of its variables unset, so a directory that is cut short used to fail with
  # "can't read position: no such variable" - a raw Tcl error where every
  # refusal of this package begins with tclpdf:. Twelve bytes: the TrueType
  # tag, two announced tables, and nothing behind them.
  ::tclpdf::sfnt parse [binary format ISuSuSuSu 0x00010000 2 0 0 0]
} -returnCodes error -match glob -result {*table directory is cut short*announces 2 tables*}

test font-2.1 {the cmap maps characters to glyphs} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set euro [scan [encoding convertfrom utf-8 [binary format H* e282ac]] %c]
  list [dict exists $cmap 65] [dict exists $cmap 228] [dict exists $cmap $euro]
} -result {1 1 1}

test font-3.1 {a subset carries only the glyphs asked for, plus components} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  # a-umlaut is a composite: it references "a" and "dieresis", and a subset
  # that copies only the composite renders as nothing at all.
  set aeGlyph [dict get $cmap 228]
  set built [::tclpdf::subset build $parsed [list $aeGlyph]]
  set order [dict get $built order]
  set components [::tclpdf::subset::Components $parsed $aeGlyph]
  set missing {}
  foreach component $components {
    if {$component ni $order} {
      lappend missing $component
    }
  }
  list [expr {[llength $components] > 0}] $missing [expr {0 in $order}]
} -result {1 {} 1}

test font-3.2 {head.checkSumAdjustment makes the whole subset sum to 0xB1B0AFBA} -constraints haveFont -body {
  # OpenType head: with the field at zero the file sums to S, and the field
  # is 0xB1B0AFBA - S; so with the field in place the file sums to
  # 0xB1B0AFBA. Verified the way fontTools verifies it. Before 2026-08-17 the
  # field shipped as 0 in every subset while a comment promised otherwise.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set built [::tclpdf::subset build $parsed [list [dict get $parsed cmap 65]]]
  set bytes [dict get $built bytes]
  # Find head in the directory: 12 bytes header, 16 per entry.
  binary scan $bytes @4Su count
  set headOffset -1
  for {set i 0} {$i < $count} {incr i} {
    binary scan $bytes @[expr {12 + $i * 16}]a4IuIuIu tag sum offset length
    if {$tag eq "head"} {
      set headOffset $offset
      set headSum $sum
    }
  }
  binary scan $bytes @[expr {$headOffset + 8}]Iu adjustment
  set total [::tclpdf::subset::Checksum $bytes]
  # The directory checksum of head is taken with the field zeroed.
  set headZeroed [string replace [string range $bytes $headOffset [expr {$headOffset + 53}]] 8 11 [binary format Iu 0]]
  list [expr {$headOffset > 0}] [expr {$adjustment != 0}] \
      [format %08X $total] \
      [expr {$headSum == [::tclpdf::subset::Checksum $headZeroed]}]
} -result {1 1 B1B0AFBA 1}

# Split a composite glyph into one record per component: the flags, the glyph
# id, and everything after it as hex - the offset and the optional scale. The
# tail is what places the component; the dots of an A-dieresis sit above the A
# because of it, and nowhere else is that written down.
#
# Reading it needs the same flag arithmetic the subsetter uses, so the test
# deliberately re-implements it instead of calling into the module: a shared
# helper would go wrong in both places at once and agree with itself.
proc fontComponentRecords {data} {
  set records {}
  set position 10
  while {$position + 4 <= [string length $data]} {
    binary scan $data @${position}SuSu flags glyphIndex
    set start [expr {$position + 4}]
    # ARG_1_AND_2_ARE_WORDS, then one of the three scale forms.
    set stop [expr {$start + (($flags & 0x0001) ? 4 : 2)}]
    if {$flags & 0x0008} {
      incr stop 2
    } elseif {$flags & 0x0040} {
      incr stop 4
    } elseif {$flags & 0x0080} {
      incr stop 8
    }
    binary scan [string range $data $start [expr {$stop - 1}]] H* tail
    lappend records [list $flags $glyphIndex $tail]
    set position $stop
    # MORE_COMPONENTS
    if {!($flags & 0x0020)} break
  }
  return $records
}

test font-3.1.1 {subsetting leaves every component offset alone} -constraints haveFont -body {
  # EVERY composite in the face, not one chosen character. A-dieresis alone
  # proves nothing: its only word-sized argument sits in the LAST component,
  # after which the loop ends anyway, so a misread record length shifts
  # nothing. Measured on DejaVu Sans: 1039 composites carry word arguments in
  # the FIRST component and 383 have three or more, up to eight - those are
  # the ones where a wrong length walks into the next record. The two counts
  # below are asserted so that the test cannot quietly stop covering them.
  #
  # One subset for all of them, which is what makes this affordable: 2445
  # composites drag their parts in and build in about 60 ms.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set composites {}
  foreach {code glyph} [dict get $parsed cmap] {
    if {[llength [::tclpdf::subset::Components $parsed $glyph]]} {
      lappend composites $glyph
    }
  }
  set composites [lsort -unique -integer $composites]
  set built [::tclpdf::subset build $parsed $composites]
  set mapping [dict get $built glyphs]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]

  set faults {}
  set deep 0
  set wordsFirst 0
  foreach glyph $composites {
    set before [fontComponentRecords [::tclpdf::subset::GlyphData $parsed $glyph]]
    set after [fontComponentRecords [::tclpdf::subset::GlyphData $again \
        [dict get $mapping $glyph]]]
    if {[llength $before] >= 3} {
      incr deep
    }
    if {[lindex $before 0 0] & 0x0001} {
      incr wordsFirst
    }
    if {[llength $before] != [llength $after]} {
      lappend faults "$glyph: [llength $before] components became [llength $after]"
      continue
    }
    foreach old $before new $after {
      lassign $old oldFlags oldId oldTail
      lassign $new newFlags newId newTail
      if {$oldFlags != $newFlags} {
        lappend faults "$glyph: flags $oldFlags became $newFlags"
      }
      if {$oldTail ne $newTail} {
        lappend faults "$glyph: offset $oldTail became $newTail"
      }
      if {$newId != [dict get $mapping $oldId]} {
        lappend faults "$glyph: component $oldId became $newId,\
            not [dict get $mapping $oldId]"
      }
    }
  }
  # The first few faults are enough to name the defect; a thousand are not
  # more informative and make the failure unreadable.
  list [llength $composites] [expr {$deep > 100}] [expr {$wordsFirst > 100}] \
      [llength $faults] [lrange $faults 0 2]
} -result {2445 1 1 0 {}}

# A composite whose FIRST component carries a scale and is followed by a
# second one. Neither DejaVu face contains such a glyph - measured, zero out of
# 2445 composites use any of the three scale forms - so the three branches that
# skip a scale cannot be reached by any test built from those files. The glyph
# is therefore built here: two components, ids 10 and 20, the first scaled.
#
# A wrong skip length lands the subsetter inside the scale bytes, and it then
# renumbers whatever it finds there instead of the second component.
proc fontScaledComposite {scaleFlag scale} {
  # numberOfContours -1 marks a composite; the four numbers after it are the
  # bounding box, which nothing here depends on.
  set data [binary format SSSSS -1 0 0 100 100]
  # ARGS_ARE_XY_VALUES | MORE_COMPONENTS, byte-sized arguments, plus the scale.
  append data [binary format SuSu [expr {0x0022 | $scaleFlag}] 10]
  append data [binary format cc 5 7] $scale
  append data [binary format SuSu 0x0002 20] [binary format cc -3 9]
  return $data
}

test font-3.1.2 {a scaled component does not shift the one behind it} -body {
  set faults {}
  foreach {name flag scale} [list \
      "single scale" 0x0008 [binary format S 16384] \
      "x and y scale" 0x0040 [binary format SS 16384 8192] \
      "two by two" 0x0080 [binary format SSSS 16384 0 0 16384]] {
    set data [fontScaledComposite $flag $scale]
    # The smallest thing sfnt::table will read from: the glyf table is the
    # glyph itself, and loca brackets it.
    set font [dict create bytes $data loca [list 0 [string length $data]] \
        tables [dict create glyf [list 0 [string length $data]]]]
    set before [fontComponentRecords $data]
    set after [fontComponentRecords [::tclpdf::subset::Rewrite $font 0 {10 1 20 2}]]
    if {[llength $before] != 2 || [llength $after] != 2} {
      lappend faults "$name: [llength $before] components became [llength $after]"
      continue
    }
    foreach old $before new $after want {1 2} {
      lassign $old oldFlags oldId oldTail
      lassign $new newFlags newId newTail
      if {$oldFlags != $newFlags || $oldTail ne $newTail} {
        lappend faults "$name: component $oldId lost its placement"
      }
      if {$newId != $want} {
        lappend faults "$name: component $oldId became $newId, not $want"
      }
    }
  }
  set faults
} -result {}

test font-3.1.3 {the subset keeps every left side bearing} -constraints haveFont -body {
  # hmtx used to be written with a flat zero bearing, and no rendering check
  # caught it. Both rasterisers put every glyph at cursor plus bearing, so the
  # letters all crept left by their own amount and the gaps between them went
  # uneven - wrong everywhere, but not obviously so. The obvious half only
  # shows in CoreGraphics, which shifts the COMPONENTS of a composite by their
  # bearing too: a-dieresis fell apart in Preview while pdftoppm drew it
  # correctly, and qpdf and veraPDF said nothing at all.
  #
  # The characters below drag their marks in through the composite closure,
  # and those marks are exactly the glyphs with a large negative bearing.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set glyphs {}
  foreach code {65 196 228 233 252 241 353} {
    lappend glyphs [dict get $parsed cmap $code]
  }
  set built [::tclpdf::subset build $parsed [lsort -unique -integer $glyphs]]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]
  set mapping [dict get $built glyphs]

  set faults {}
  set large 0
  foreach old [dict get $built order] {
    set want [::tclpdf::sfnt bearing $parsed $old]
    # A bearing far from zero is what makes the defect visible; a letter whose
    # bearing is 16 units would move imperceptibly. Measured in this subset:
    # two marks at -827 and -809, while the marks for acute, tilde and caron
    # sit at POSITIVE bearings - so "negative" would have been the wrong test.
    if {abs($want) > 500} {
      incr large
    }
    set got [::tclpdf::sfnt bearing $again [dict get $mapping $old]]
    if {$want != $got} {
      lappend faults "glyph $old: bearing $want became $got"
    }
  }
  list [expr {$large >= 2}] [llength $faults] [lrange $faults 0 2]
} -result {1 0 {}}

test font-3.1.4 {a bearing agrees with the glyph's own xMin} -constraints haveFont -body {
  # head flag bit 1 says the two are the same, which is why a renderer may use
  # either and why writing a wrong bearing stays invisible for so long. The
  # real point here is the parser: hmtx is an array of PAIRS, and reading it at
  # the wrong stride returns advance widths where bearings belong.
  #
  # One unit of slack, because the font itself is not exact: measured over
  # 5857 glyphs of DejaVu Sans, five differ by exactly one unit (U+1F32,
  # U+1F33, U+1F35, U+20D0, U+2422). A stride error would not produce ones.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set faults {}
  set checked 0
  foreach {code glyph} [dict get $parsed cmap] {
    set data [::tclpdf::subset::GlyphData $parsed $glyph]
    if {[string length $data] < 10} continue
    binary scan $data SS - xMin
    incr checked
    set bearing [::tclpdf::sfnt bearing $parsed $glyph]
    if {abs($bearing - $xMin) > 1} {
      lappend faults "glyph $glyph: bearing $bearing, xMin $xMin"
    }
  }
  list [expr {$checked > 5000}] [llength $faults] [lrange $faults 0 2]
} -result {1 0 {}}

test font-3.2 {the subset is a fraction of the original} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set glyphs {}
  foreach char [split "Rechnung 2026" {}] {
    lappend glyphs [dict get $cmap [scan $char %c]]
  }
  set built [::tclpdf::subset build $parsed [lsort -unique -integer $glyphs]]
  set original [string length [dict get $parsed bytes]]
  set reduced [string length [dict get $built bytes]]
  expr {$reduced < $original / 20}
} -result 1

test font-3.3 {the subset can be read back} -constraints haveFont -body {
  # It carries no cmap on purpose - Identity-H addresses glyphs directly - so
  # the parser must not insist on one.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set built [::tclpdf::subset build $parsed [list [dict get $parsed cmap 65]]]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]
  list [dict get $again unitsPerEm] [dict get $again numGlyphs] \
      [dict exists [dict get $again tables] glyf]
} -result {2048 2 1}

test font-3.4 {the same glyphs give the same bytes} -constraints haveFont -body {
  # Reproducible output: two runs of the same report must not differ.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set glyphs [list [dict get $parsed cmap 65] [dict get $parsed cmap 66]]
  set first [::tclpdf::subset build $parsed $glyphs]
  set second [::tclpdf::subset build $parsed [lreverse $glyphs]]
  expr {[dict get $first bytes] eq [dict get $second bytes]}
} -result 1

test font-4.1 {an embedded font becomes Type0 with Identity-H} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc font -family haus -size 12
  $doc text "Rechnung" -at {20 20}
  set path [::tclpdfTest::scratch font-embed.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Subtype /Type0} $bytes] [regexp {/Encoding /Identity-H} $bytes] \
      [regexp {/Subtype /CIDFontType2} $bytes] [regexp {/FontFile2} $bytes] \
      [regexp {/ToUnicode} $bytes]
} -result {1 1 1 1 1}

test font-4.2 {CIDToGIDMap is a stream, not Identity} -constraints haveFont -body {
  # Regression. /Identity claims the CID equals the glyph number in the
  # embedded file, which stops being true the moment anything is subsetted -
  # the document then renders with the wrong glyphs and no tool complains.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cidmap.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/CIDToGIDMap \d+ 0 R} $bytes] [regexp {/CIDToGIDMap /Identity} $bytes]
} -result {1 0}

test font-4.3 {content stream, CIDToGIDMap and ToUnicode agree} -constraints haveFont -body {
  # The three have to line up or the text comes out as noise: the content
  # stream carries the ORIGINAL glyph number, CIDToGIDMap turns it into the
  # subset one, ToUnicode turns it back into a character. Getting this wrong
  # is invisible to qpdf and to pdffonts.
  package require tclpdf::filter
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "A" -at {20 20} -family haus
  set parsed [dict get [$doc state fonts] haus parsed]
  set glyphA [dict get $parsed cmap 65]
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch font-agree.pdf]
  $doc write $path
  set writer [$doc writer]

  # Which object is the map? The CID font says so.
  set mapNumber {}
  set toUnicodeNumber {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[regexp {/CIDToGIDMap (\d+) 0 R} $body -> found]} {
      set mapNumber $found
    }
    if {[regexp {/ToUnicode (\d+) 0 R} $body -> found]} {
      set toUnicodeNumber $found
    }
  }
  set map [::tclpdfTest::streamOf $writer $mapNumber]
  set toUnicode [::tclpdfTest::streamOf $writer $toUnicodeNumber]
  $doc destroy
  file delete $path

  # 1. the stream carries the original glyph number as two bytes
  # [string first], not [string match]: the escaped form contains backslashes,
  # and a glob pattern would read those as escapes rather than as characters.
  set inStream [expr {[string first [::tclpdf::pdfObj bytesStr \
      [binary format Su $glyphA]] $content] >= 0}]
  # 2. ToUnicode maps that number back to U+0041
  set inToUnicode [regexp "<[format %04X $glyphA]> <0041>" $toUnicode]
  # 3. the map has a non-zero subset glyph at that position
  binary scan [string range $map [expr {$glyphA * 2}] [expr {$glyphA * 2 + 1}]] Su subsetGlyph
  list $inStream $inToUnicode [expr {$subsetGlyph != 0}]
} -result {1 1 1}

test font-4.4 {a character the font lacks is refused} -constraints haveFont -body {
  # U+4E2D, a CJK ideograph - measured, DejaVu Sans has no glyph for it.
  # An emoji would NOT do here: the face does carry U+1F600.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  try {
    $doc text [encoding convertfrom utf-8 [binary format H* e4b8ad]] \
        -at {20 20} -family haus
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*has no glyph for U+4E2D*}

test font-4.4a {the refusal carries the machine-readable -errorcode} -constraints haveFont -body {
  # Same contract as the standard faces (see afm-3.9 and the manual under
  # "Error codes"); the fontname element is the caller's own alias. Trapped
  # here exactly as a script would, by the prefix of the errorcode list.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  try {
    $doc text "ab[encoding convertfrom utf-8 [binary format H* e4b8ad]]" \
        -at {20 20} -family haus
    set found none
  } trap {TCLPDF FONT GLYPH} {- opts} {
    set found [dict get $opts -errorcode]
  } finally {
    $doc destroy
  }
  set found
} -result {TCLPDF FONT GLYPH U+4E2D 2 haus}

test font-4.7 {code points outside the BMP are read from a format 12 cmap} -constraints haveFont -body {
  # Measured on DejaVu Sans: it maps U+1F600 through a format 12 subtable, so
  # this also proves the parser prefers that over the BMP-only format 4.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set emoji [scan [encoding convertfrom utf-8 [binary format H* f09f9880]] %c]
  list [dict exists $cmap $emoji] \
      [expr {[lindex [lsort -integer [dict keys $cmap]] end] > 0xFFFF}]
} -result {1 1}

test font-4.5 {an embedded font that is never used produces no objects} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "nur Helvetica" -at {20 20}
  set path [::tclpdfTest::scratch font-unused.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/FontFile2} $bytes
} -result 0

test font-4.6 {a duplicate alias is refused} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  try {
    $doc font embed haus $fontRegular
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*already embedded*}

test font-5.1 {widths come from the font, not from a standard table} -constraints haveFont -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed haus $fontRegular
  set embedded [$doc textWidth "Rechnung" -family haus -size 12]
  set standard [$doc textWidth "Rechnung" -family helvetica -size 12]
  $doc destroy
  # Different faces, different widths - and both plausible for 8 characters
  list [expr {$embedded != $standard}] [expr {$embedded > 20 && $embedded < 100}]
} -result {1 1}

test font-5.2 {font info reports what the file says} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  set info [$doc font info haus]
  $doc destroy
  list [dict get $info family] [dict get $info fsType] \
      [expr {[dict get $info glyphs] > 1000}]
} -match glob -result {{DejaVu Sans} 0 1}

test font-6.1 {-subset 0 embeds the whole face} -constraints haveFont -body {
  # The documented escape hatch for a face that must stay complete - a form
  # someone fills in afterwards, or a reader that refuses subsets. Nothing had
  # ever called it, and the difference is a factor of about eighty in size.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular -subset 0
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-whole.pdf]
  $doc write $path
  $doc destroy
  set whole [file size $path]
  file delete $path
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-subset.pdf]
  $doc write $path
  $doc destroy
  set part [file size $path]
  file delete $path
  expr {$whole > $part * 10}
} -result 1

test font-6.2 {a whole face carries no subset prefix} -constraints haveFont -body {
  # The six-letter tag MEANS subset (9.9.2). A complete DejaVuSans announcing
  # itself as SZGNUB+DejaVuSans tells a reader merging fonts to keep two
  # incompatible copies of the same face, and entitles a preflight tool to
  # reject the file. All three names have to agree - descriptor, CID font and
  # Type0 font.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular -subset 0
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-prefix.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/BaseFont /DejaVuSans\y} $bytes] \
      [regexp -all {/FontName /DejaVuSans\y} $bytes] \
      [regexp {[A-Z]{6}\+DejaVuSans} $bytes]
} -result {2 1 0}

test font-6.3 {a subsetted face still carries one} -constraints haveFont -body {
  # The other half: without this the fix above could simply drop the tag
  # everywhere, which would be just as wrong the other way round.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-tag.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The same tag in all three places, and it is derived from the name, so it
  # is the same one on every run.
  list [regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans} $bytes] \
      [regexp -all {/FontName /[A-Z]{6}\+DejaVuSans} $bytes]
} -result {2 1}

# A face that leads with a platform 0 name, built rather than found.
#
# 20 of the 210 faces on this machine lead with one - Times New Roman and
# Arial Narrow among them - so this is not an exotic case, but none of those
# files may be checked in. The case is therefore made from DejaVu: the
# platform 1 record is taken out of the running by relabelling its nameId, and
# the platform 3 record, which is already UTF-16BE, is relabelled as platform
# 0. That is exactly what the affected fonts carry.
proc fontLeadWithPlatformZero {source target} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables name] position -
  binary scan $bytes @[expr {$position + 2}]Su count
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$position + 6 + $index * 12}]
    binary scan $bytes @${at}SuSuSuSu platform encoding language nameId
    if {$nameId != 6} {
      continue
    }
    if {$platform == 1} {
      # nameId 18 is "compatible full", which nothing here reads.
      set bytes [string replace $bytes [expr {$at + 6}] [expr {$at + 7}] \
          [binary format Su 18]]
    } elseif {$platform == 3} {
      set bytes [string replace $bytes $at [expr {$at + 1}] [binary format Su 0]]
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-7.1 {a platform 0 name is decoded, not passed through raw} -constraints haveFont -body {
  # Platform 0 (Unicode) is UTF-16BE just as platform 3 is, and only the
  # second was decoded. The first record wins, so a font that leads with
  # platform 0 handed its PostScript name over with a NUL between every
  # letter.
  set path [fontLeadWithPlatformZero $fontRegular \
      [::tclpdfTest::scratch platform0.ttf]]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set name [dict get $parsed names postScript]
  list $name [string first \x00 $name]
} -result {DejaVuSans -1}

test font-7.2 {and the document it produces has a usable font name} -constraints haveFont -body {
  # What the defect actually cost: /BaseFont /HOVCJQ+#00D#00e#00j... in the
  # file, and qpdf refusing it with "null character not allowed in name token"
  # - three warnings and exit 3, measured. veraPDF says nothing about it: it
  # does not check names. So only this end catches it.
  set path [fontLeadWithPlatformZero $fontRegular \
      [::tclpdfTest::scratch platform0.ttf]]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  $doc text "Grusse" -at {20 20} -family haus
  set pdf [::tclpdfTest::scratch platform0.pdf]
  $doc write $pdf
  $doc destroy
  set bytes [::tclpdfTest::readBytes $pdf]
  file delete $pdf $path
  list [regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans\y} $bytes] \
      [regexp {#00} $bytes]
} -result {2 0}

test font-7.3 {a Macintosh name stays one byte per character} -constraints haveFont -body {
  # The other direction, and the reason the fix names two platforms rather
  # than "anything but 1": platform 1 is MacRoman, one byte per character.
  # Decoded as UTF-16 it would pair the letters up - DejaVuSans would become
  # five CJK characters, and nothing anywhere would fail.
  set channel [open $fontRegular rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables name] position -
  binary scan $bytes @[expr {$position + 2}]Su count
  set leads {}
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$position + 6 + $index * 12}]
    binary scan $bytes @${at}SuSuSuSu platform encoding language nameId
    if {$nameId == 6 && $leads eq {}} {
      set leads $platform
    }
  }
  # DejaVu leads with platform 1, which is why it never showed the defect.
  list $leads [dict get $parsed names postScript]
} -result {1 DejaVuSans}

test font-8.1 {a CFF face is embedded as FontFile3, not FontFile2} -constraints haveOtf -body {
  # /FontFile3 with /Subtype /OpenType takes the WHOLE sfnt file, cmap and
  # all - so the CFF table never has to be understood, only carried. The
  # descendant is a CIDFontType0, and CIDToGIDMap has no place there: it
  # belongs to CIDFontType2 alone.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $::otf
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cff.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/FontFile3 \d+ 0 R} $bytes] [regexp {/FontFile2} $bytes] \
      [regexp {/Subtype /OpenType} $bytes] \
      [regexp {/Subtype /CIDFontType0\y} $bytes] \
      [regexp {/CIDToGIDMap} $bytes] [regexp {/ToUnicode} $bytes]
} -result {1 0 1 1 0 1}

test font-8.2 {a CFF face carries no subset prefix} -constraints haveOtf -body {
  # It goes in whole - there is no subsetter for CFF here - and the six-letter
  # tag MEANS subset (9.9.2). Claiming one on a complete face invites a reader
  # merging documents to keep two incompatible copies.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $::otf
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cff-name.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/BaseFont /NimbusSans-Regular\y} $bytes] \
      [regexp {[A-Z]{6}\+NimbusSans} $bytes]
} -result {2 0}

test font-8.3 {the same face measures the same from either format} -constraints haveOtfPair -body {
  # The invariant this tree offers: NimbusSans is here as CFF and as TrueType.
  # The widths come from hmtx in both cases, but through two different files
  # and two different glyph numberings, so agreement is worth asserting.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed cff $::otf
  $doc font embed ttf $::otfTtf
  set faults {}
  foreach sample {Rechnung Hamburgefonstiv "AVATAR 12,34"} {
    set a [$doc textWidth $sample -family cff -size 100 -kerning 0]
    set b [$doc textWidth $sample -family ttf -size 100 -kerning 0]
    # The tolerance grows with the line, because the error does: the CFF file
    # carries 1000 units per em and the TrueType one 2048, so every single
    # glyph rounds by up to half a unit and those add up. A fixed tolerance
    # would pass short words and fail long ones - measured, "Rechnung" differs
    # by 0.108 pt at size 100, which is 0.0135 pt per character.
    if {abs($a - $b) > 0.05 * [string length $sample]} {
      lappend faults "$sample: $a against $b"
    }
  }
  $doc destroy
  set faults
} -result {}

test font-8.4 {-subset has no effect on a CFF face, and does not pretend to} -constraints haveOtf -body {
  # Asking for a subset of a CFF face cannot be honoured - loca and glyf are
  # what the subsetter rewrites and neither exists. What matters is that the
  # document is still correct: whole file, no prefix, either way.
  set sizes {}
  foreach wanted {1 0} {
    set doc [tclpdf new]
    $doc page add
    $doc font embed haus $::otf -subset $wanted
    $doc text "A" -at {20 20} -family haus
    set path [::tclpdfTest::scratch font-cff-subset.pdf]
    $doc write $path
    $doc destroy
    lappend sizes [file size $path]
    file delete $path
  }
  # Same file both times, so the same size - within the few bytes the date
  # and the ID can differ by.
  expr {abs([lindex $sizes 0] - [lindex $sizes 1]) < 32}
} -result 1

proc variableTree {name} {
  set here [file dirname [file dirname [file normalize [info script]]]]
  return [file join $here examples assets fonts google $name]
}

test font-8.1 {-axes embeds a chosen point on the axes} -body {
  # Three weights out of ONE file, and they have to differ in the stream: the
  # widths come from the instanced hmtx, so a wrong instance shows up as a
  # wrong measurement long before anyone looks at the page.
  set widths {}
  foreach weight {100 400 900} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] -axes [list wght $weight]
    $doc font -family face -size 20
    lappend widths [format %.2f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  lassign $widths thin regular black
  list [expr {$thin < $regular}] [expr {$regular < $black}]
} -result {1 1}

test font-8.2 {-instance names a point the designer stood behind} -body {
  # The named instance has to agree with the axis values it stands for - it is
  # resolved to those values and takes the same path from there.
  set widths {}
  foreach call {{-instance Bold} {-axes {wght 700}}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] {*}$call
    $doc font -family face -size 20
    lappend widths [format %.4f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  expr {[lindex $widths 0] eq [lindex $widths 1]}
} -result 1

test font-8.3 {-axes refines a named instance} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face [variableTree Roboto-Variable.ttf] \
      -instance Bold -axes {wdth 75}
  $doc font -family face -size 20
  set narrow [$doc textWidth "Hamburgefonstiv"]
  $doc destroy
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face [variableTree Roboto-Variable.ttf] -instance Bold
  $doc font -family face -size 20
  set wide [$doc textWidth "Hamburgefonstiv"]
  $doc destroy
  expr {$narrow < $wide}
} -result 1

test font-8.4 {without -axes the default instance is embedded as before} -body {
  # The behaviour every existing document relies on: an untouched variable
  # font is its default instance, which is what sits in glyf.
  set widths {}
  foreach call {{} {-axes {wght 400 wdth 100}}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] {*}$call
    $doc font -family face -size 20
    lappend widths [format %.6f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  expr {[lindex $widths 0] eq [lindex $widths 1]}
} -result 1

test font-8.5 {an axis the font does not have is named, with the ones it does} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Variable.ttf] -axes {wgth 700}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no axis "wgth"*wght wdth*}

test font-8.6 {an unknown instance lists the ones that exist} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Variable.ttf] -instance Ultrablack
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no instance named "Ultrablack"*Thin*}

test font-8.7 {-axes on a static font says so instead of doing nothing} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Regular.ttf] -axes {wght 700}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*not a variable font*fvar*}

# The base names of the embedded faces in a written document, one per font
# object that carries a descriptor - the tag and the name a reader is told.
proc fontBaseNames {bytes} {
  set names {}
  foreach {- name} [regexp -all -inline {/FontName /(\S+)} $bytes] {
    lappend names $name
  }
  return $names
}

test font-9.1 {two subsets of one face in one document carry different tags} -constraints haveFont -body {
  # ISO 32000-1 9.6.4: different subsets of the same font in one file shall
  # have different tags. The tag used to be a function of the name alone, so
  # every subset of DejaVuSans in every document was SZGNUB+ - and a reader
  # entitled to take same tag, same name for the same font would have drawn
  # one subset with the glyphs of the other. Now it is derived from what was
  # subsetted: two aliases of one file with different text get different
  # tags, and the same text gets the same one.
  set doc [tclpdf new]
  $doc page add
  $doc font embed one $fontRegular
  $doc font embed two $fontRegular
  $doc font embed three $fontRegular
  $doc text "Grusse" -at {20 20} -family one
  $doc text "Rechnung" -at {20 40} -family two
  $doc text "Grusse" -at {20 60} -family three
  set path [::tclpdfTest::scratch font-tags.pdf]
  $doc write $path
  $doc destroy
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  file delete $path
  lassign $names one two three
  list [llength $names] [regexp {^[A-Z]{6}\+DejaVuSans$} $one] \
      [expr {$one ne $two}] [expr {$one eq $three}]
} -result {3 1 1 1}

test font-9.2 {the tag is the same on every write of the same document} -constraints haveFont -body {
  # Derived from the content, not from the clock or the object number: two
  # writes of one document are byte-identical, and two runs of one report
  # produce the same file.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  lassign [::tclpdfTest::writeTwice $doc font-tag-twice] first second
  $doc destroy
  list [expr {$first eq $second}] \
      [expr {[fontBaseNames $first] eq [fontBaseNames $second]}]
} -result {1 1}

test font-9.3 {every instance of a variable face is its own font, by name and tag} -body {
  # 02.10 embeds Roboto twenty-four times; measured with pdffonts before
  # this, all twenty-four were SZGNUB+Roboto-Regular - the tag from the name,
  # the name from name id 6, which names the default and nothing else. Now a
  # named instance carries the PostScript name fvar gives it, a point in
  # between is named by its axis values (TN 5902), and the tags differ
  # because the glyphs do.
  set doc [tclpdf new -unit mm]
  $doc page add
  foreach {alias options} {thin {-instance Thin} bold {-axes {wght 700}}
      between {-axes {wght 620}} narrow {-instance Bold -axes {wdth 80}}} {
    $doc font embed $alias [variableTree Roboto-Variable.ttf] {*}$options
    $doc font -family $alias -size 12
    $doc text "Hamburgefonstiv" -at {20 30}
  }
  set path [::tclpdfTest::scratch font-instances.pdf]
  $doc write $path
  $doc destroy
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  file delete $path
  set tags {}
  set bare {}
  foreach name $names {
    regexp {^([A-Z]{6})\+(.*)$} $name -> tag rest
    lappend tags $tag
    lappend bare $rest
  }
  list $bare [llength [lsort -unique $tags]]
} -result {{Roboto-Thin Roboto-Bold Roboto_620wght Roboto_700wght_80wdth} 4}

test font-10.1 {-subset 0 on an instance embeds the instance, not the variable file} -body {
  # PDF knows nothing of variation. The whole file, embedded as it is, is the
  # variable face - fvar, gvar and the rest - and a reader draws its DEFAULT
  # outlines under the /W array of the instance: Regular shapes spaced as
  # Bold. Measured before this: 22 tables in the FontFile2, gvar among them.
  # Now every glyph goes through the instancer and the variation tables stay
  # behind; all 1326 glyphs are there, so no subset tag is written.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed bold [variableTree Roboto-Variable.ttf] -instance Bold -subset 0
  $doc font -family bold -size 12
  $doc text "Hamburgefonstiv" -at {20 30}
  set path [::tclpdfTest::scratch font-instance-whole.pdf]
  $doc write $path
  set writer [$doc writer]
  set fontFile {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[string match {*/Length1 *} [$writer body $number]]} {
      set fontFile [::tclpdfTest::streamOf $writer $number]
    }
  }
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  $doc destroy
  file delete $path
  package require tclpdf::sfnt
  set embedded [::tclpdf::sfnt parse $fontFile]
  set tables [lsort [dict keys [dict get $embedded tables]]]
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  # The hmtx in the file is the instance's, not the default: the H of Roboto
  # Bold advances 1446 units where the Regular one advances 1461 (fontTools'
  # instancer says the same), so the two must differ, and the embedded one
  # must be what the instancer computed.
  package require tclpdf::varFont
  set h [dict get [dict get $original cmap] 72]
  set instanced [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 700}]]
  list $names [expr {"fvar" in $tables}] [expr {"gvar" in $tables}] \
      [expr {"glyf" in $tables}] \
      [expr {[dict get $embedded numGlyphs] == [dict get $original numGlyphs]}] \
      [expr {[::tclpdf::sfnt advance $embedded $h] != [::tclpdf::sfnt advance $original $h]}] \
      [expr {[::tclpdf::sfnt advance $embedded $h] == [dict get $instanced $h advance]}]
} -result {Roboto-Bold 0 0 1 1 1 1}

test font-11.1 {the descriptor reads the italic angle and the cap height from the file} -constraints haveOtfPair -body {
  # Table 122: ItalicAngle and CapHeight are required and were written as 0
  # and as the ascender for every face. post.italicAngle of Nimbus Sans
  # Oblique is -12 (measured with fontTools), OS/2 sCapHeight of Nimbus Sans
  # 1493 of 2048 units, which is 729 in the 1/1000 em of the descriptor - and
  # the ascender it was written as is 1602, which is 782.
  set oblique [file join [file dirname $::otfTtf] NimbusSans-Oblique.ttf]
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed upright $::otfTtf
  $doc font embed slanted $oblique
  $doc text "Rechnung" -at {20 20} -family upright
  $doc text "Rechnung" -at {20 40} -family slanted
  set path [::tclpdfTest::scratch font-descriptor.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set angles {}
  set caps {}
  set flags {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/ItalicAngle (\S+)} $body -> angle
    regexp {/CapHeight (\S+)} $body -> cap
    regexp {/Flags (\S+)} $body -> flag
    lappend angles $angle
    lappend caps [format %.0f $cap]
    lappend flags $flag
  }
  list $angles $caps $flags
} -result {{0 -12} {729 729} {4 68}}

test font-11.2 {StemV follows the weight, and for an instance the wght axis} -body {
  # TrueType has no stem width; the estimate is 50 + (usWeightClass / 65)^2,
  # which tFPDF and mPDF write - 87 at 400, 165 at 700. For an instance of a
  # variable face the wght axis is the weight class, so Bold out of the
  # variable Roboto says 165 where the file's own OS/2 says 400. Roboto's
  # sCapHeight is 1456 of 2048, 711 in the descriptor.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed regular [variableTree Roboto-Regular.ttf]
  $doc font embed bold [variableTree Roboto-Variable.ttf] -instance Bold
  $doc text "Rechnung" -at {20 20} -family regular
  $doc text "Rechnung" -at {20 40} -family bold
  set path [::tclpdfTest::scratch font-stemv.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set stems {}
  set caps {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/StemV (\S+)} $body -> stem
    regexp {/CapHeight (\S+)} $body -> cap
    lappend stems $stem
    lappend caps [format %.0f $cap]
  }
  list $stems $caps
} -result {{87 165} {711 711}}

test font-11.3 {head and /FontBBox of an instance describe the moved face, of a plain subset the file} -constraints haveFont -body {
  # Table 122: FontBBox is the box of ALL glyphs of the font at one origin,
  # and for an instance the font is the moved face - the file's box describes
  # outlines that were left behind. Roboto at wght 900 reaches 2483 units to
  # the right where the file says 2353 (varFont bounds); both the subset's
  # head table and the descriptor have to say 2483, in units and in
  # thousandths of an em, and agree with each other. A face embedded as it
  # came keeps the file's box in both places, byte for byte in head - a
  # subset's box is the whole face's, as before.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed black [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed plain $fontRegular
  $doc text "Hamburgefonstiv" -at {20 30} -family black
  $doc text "Hamburgefonstiv" -at {20 50} -family plain
  set path [::tclpdfTest::scratch font-bbox.pdf]
  $doc write $path
  set writer [$doc writer]
  set boxes {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/Type /FontDescriptor*} $body]} {
      regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
      regexp {/FontBBox \[([^\]]*)\]} $body -> box
      regexp {/FontFile2 (\d+) 0 R} $body -> fileNumber
      set embedded [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
      set head [::tclpdf::sfnt table $embedded head]
      binary scan $head @36SSSS xMin yMin xMax yMax
      dict set boxes $name [list $box [list $xMin $yMin $xMax $yMax] \
          [dict get $embedded unitsPerEm]]
    }
  }
  $doc destroy
  file delete $path
  package require tclpdf::varFont
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  set moved [::tclpdf::varFont bounds [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 900}]]]
  set plain [::tclpdf::sfnt read $fontRegular]
  set result {}
  foreach name {Roboto-Black DejaVuSans} expected [list $moved [dict get $plain bbox]] {
    lassign [dict get $boxes $name] box head units
    set scaled [lmap value $head {format %.5g [expr {$value * 1000.0 / $units}]}]
    lappend result [expr {$head eq $expected}] \
        [expr {[lmap value $box {format %.5g $value}] eq $scaled}]
  }
  list $result [lindex [dict get $boxes Roboto-Black] 1] \
      [expr {$moved ne [dict get $original bbox]}] \
      [format %.0f [lindex [dict get $boxes Roboto-Black] 0 2]]
} -result {{1 1 1 1} {-1476 -555 2483 2163} 1 1212}

test font-11.4 {hhea of an instance summarises the moved face, of a plain subset the file} -constraints haveFont -body {
  # The four summary fields at hhea offset 10 - advanceWidthMax,
  # minLeftSideBearing, minRightSideBearing, xMaxExtent (ISO/IEC 14496-22
  # "hhea") - describe the glyphs of the file, and for an instance the file
  # carries the moved glyphs: Roboto at wght 900 has an advance of 2475 and an
  # extent of 2483 where the file says 2378 and 2353 (varFont hheaMetrics).
  # The embedded subset has to say what the instancer computed, and its
  # numberOfHMetrics has to match its glyph count still. A face embedded as
  # it came keeps the file's four fields byte for byte.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed black [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed plain $fontRegular
  $doc text "Hamburgefonstiv" -at {20 30} -family black
  $doc text "Hamburgefonstiv" -at {20 50} -family plain
  set path [::tclpdfTest::scratch font-hhea.pdf]
  $doc write $path
  set writer [$doc writer]
  set summaries {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/Type /FontDescriptor*} $body]} {
      regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
      regexp {/FontFile2 (\d+) 0 R} $body -> fileNumber
      set embedded [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
      set hhea [::tclpdf::sfnt table $embedded hhea]
      binary scan $hhea @10SuSSS advance left right extent
      binary scan $hhea @34Su metrics
      dict set summaries $name [list [list $advance $left $right $extent] \
          [expr {$metrics == [dict get $embedded numGlyphs]}]]
    }
  }
  $doc destroy
  file delete $path
  package require tclpdf::varFont
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  set moved [::tclpdf::varFont hheaMetrics [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 900}]]]
  binary scan [::tclpdf::sfnt table $original hhea] @10SuSSS a b c d
  set fileRoboto [list $a $b $c $d]
  binary scan [::tclpdf::sfnt table [::tclpdf::sfnt read $fontRegular] hhea] @10SuSSS a b c d
  set filePlain [list $a $b $c $d]
  set result {}
  foreach name {Roboto-Black DejaVuSans} expected [list $moved $filePlain] {
    lassign [dict get $summaries $name] summary counted
    lappend result [expr {$summary eq $expected}] $counted
  }
  list $result [lindex [dict get $summaries Roboto-Black] 0] \
      [expr {$moved ne $fileRoboto}] $filePlain
} -result {{1 1 1 1} {2475 -1476 -472 2483} 1 {3838 -2090 -1455 3673}}

# A CID-keyed CFF face, built rather than found - the tree holds none, and the
# ones on this machine (Hiragino, in a macOS collection) may not be checked in.
#
# The mark of a CID font is the ROS operator (12 30) in the CFF Top DICT (TN
# 5176 section 18), so NimbusSans gets one: the operands "391 392 0" as
# shortints and the escaped operator go in front of - or, with "end", behind -
# the first Top DICT, the Top DICT INDEX is rebuilt with offSize 4 and shifted
# offsets, and the CFF table is appended to the sfnt under a corrected
# directory entry. The Top DICT's own offsets into the CFF (charset,
# CharStrings, Private) are NOT moved, so the result is a font that parses up
# to its Top DICT and no further - which is exactly as far as the package
# reads, and all the case needs.
proc fontMakeCidKeyed {source target {where front}} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables "CFF "] position length
  set cff [string range $bytes $position [expr {$position + $length - 1}]]
  binary scan $cff @2cu hdrSize
  # Name INDEX: walk past it.
  set at $hdrSize
  binary scan $cff @${at}Su count
  binary scan $cff @[expr {$at + 2}]cu offSize
  set at [expr {$at + 3}]
  binary scan $cff @[expr {$at + $count * $offSize}]cu$offSize digits
  set last 0
  foreach digit $digits {
    set last [expr {$last * 256 + $digit}]
  }
  set topAt [expr {$at + ($count + 1) * $offSize - 1 + $last}]
  # Top DICT INDEX: read the items, prefix (or suffix) the first, rebuild.
  binary scan $cff @${topAt}Su count
  binary scan $cff @[expr {$topAt + 2}]cu offSize
  set at [expr {$topAt + 3}]
  set offsets {}
  for {set index 0} {$index <= $count} {incr index} {
    binary scan $cff @[expr {$at + $index * $offSize}]cu$offSize digits
    set value 0
    foreach digit $digits {
      set value [expr {$value * 256 + $digit}]
    }
    lappend offsets $value
  }
  set data [expr {$at + ($count + 1) * $offSize - 1}]
  set items {}
  for {set index 0} {$index < $count} {incr index} {
    lappend items [string range $cff [expr {$data + [lindex $offsets $index]}] \
        [expr {$data + [lindex $offsets $index+1] - 1}]]
  }
  set ros [binary format cuSucuSucucucu 28 391 28 392 139 12 30]
  if {$where eq "front"} {
    lset items 0 $ros[lindex $items 0]
  } else {
    lset items 0 [lindex $items 0]$ros
  }
  set rebuilt [binary format Sucu $count 4]
  set offset 1
  append rebuilt [binary format Iu $offset]
  foreach item $items {
    incr offset [string length $item]
    append rebuilt [binary format Iu $offset]
  }
  append rebuilt {*}$items
  set end [expr {$data + [lindex $offsets end]}]
  set cff [string range $cff 0 [expr {$topAt - 1}]]$rebuilt[string range $cff $end end]
  # Back into the sfnt: appended at the end, directory entry moved there.
  set pad [expr {(4 - [string length $bytes] % 4) % 4}]
  append bytes [string repeat \0 $pad]
  set newPosition [string length $bytes]
  append bytes $cff
  binary scan $bytes @4Su numTables
  for {set index 0} {$index < $numTables} {incr index} {
    set entry [expr {12 + $index * 16}]
    if {[string range $bytes $entry [expr {$entry + 3}]] eq "CFF "} {
      set bytes [string replace $bytes [expr {$entry + 8}] [expr {$entry + 15}] \
          [binary format IuIu $newPosition [string length $cff]]]
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-12.1 {a name-keyed CFF face is read as one, and embeds} -constraints haveOtf -body {
  # The regression side: NimbusSans carries no ROS, and font-8.1 already
  # writes it. Here the flag itself is asserted, so that the detection cannot
  # drift towards refusing everything.
  set parsed [::tclpdf::sfnt read $::otf]
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc font embed haus $::otf} result]
  $doc destroy
  list [dict get $parsed outlines] [dict get $parsed cidKeyed] $code $result
} -result {cff 0 0 haus}

test font-12.2 {a ROS in the Top DICT marks the face CID-keyed} -constraints haveOtf -body {
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed.otf]]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  list [dict get $parsed outlines] [dict get $parsed cidKeyed]
} -result {cff 1}

test font-12.3 {a CID-keyed CFF face is refused at embed time, by name} -constraints haveOtf -body {
  # ISO 32000-1 9.7.4.2: with a CID-keyed program the CID goes through the
  # program's charset, and this package addresses glyphs by index. Refused
  # where the file is handed over, not at write time, and before anything is
  # entered under the alias.
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed.otf]]
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc font embed haus $path} result]
  set names [$doc font names]
  $doc destroy
  file delete $path
  list $code $result $names
} -result [list 1 "tclpdf: \"cid-keyed.otf\" is a CID-keyed CFF font, which\
    tclpdf cannot embed - its glyphs would be addressed by CID, not by glyph\
    index; convert it to TrueType or to a name-keyed CFF" {}]

test font-12.4 {the ROS is found behind the other operators as well} -constraints haveOtf -body {
  # The spec puts ROS first; the walk does not rely on that. Behind every
  # other operand of NimbusSans' Top DICT the walker has to have skipped each
  # one by its own encoding to arrive at the operator at all.
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed-end.otf] end]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  dict get $parsed cidKeyed
} -result 1

test font-12.5 {an OTTO file without a CFF table is refused} -constraints haveOtf -body {
  # The signature promises outlines in that table and nowhere else. Relabelled
  # in the directory, so that everything else about the file stays valid.
  set bytes [::tclpdfTest::readBytes $::otf]
  binary scan $bytes @4Su numTables
  for {set index 0} {$index < $numTables} {incr index} {
    set entry [expr {12 + $index * 16}]
    if {[string range $bytes $entry [expr {$entry + 3}]] eq "CFF "} {
      set bytes [string replace $bytes $entry [expr {$entry + 3}] "CFFx"]
    }
  }
  catch {::tclpdf::sfnt parse $bytes} result
  set result
} -result {tclpdf: the font has no "CFF " table and cannot be embedded}

# How many WinAnsi advances of a face equal the AFM of the standard face it
# stands in for - within half a unit at 1000/em - and which characters differ.
proc metricMatch {path std} {
  set font [::tclpdf::sfnt read $path]
  set upem [dict get $font unitsPerEm]
  set cmap [dict get $font cmap]
  set equal 0
  set differ {}
  # Every mapped WinAnsi position, 32..255: an unmapped one (127, 129, 141,
  # 143, 144, 157) has no width in the metrics and is skipped by that; 160
  # and 173 are the second codes of space and hyphen (Annex D) and are not
  # counted twice; the 25 positions of 128..159 - euro, the quotation marks,
  # the ellipsis, the per mille - count like the rest. That makes 216 per
  # face, the same yardstick as the URW measurement (2592 = 12 x 216).
  for {set code 32} {$code < 256} {incr code} {
    if {$code == 160 || $code == 173} continue
    # The width first: an unmapped position has none, and Tcl 9 refuses to
    # decode 0x81 as cp1252 at all.
    if {[catch {::tclpdf::afm width $std $code} width] || $width == 0} continue
    set char [encoding convertfrom cp1252 [binary format c $code]]
    set cp [scan $char %c]
    if {![dict exists $cmap $cp]} {
      lappend differ [format U+%04X $cp]
      continue
    }
    set advance [expr {[::tclpdf::sfnt advance $font [dict get $cmap $cp]] * 1000.0 / $upem}]
    if {abs($advance - $width) < 0.5} {
      incr equal
    } else {
      lappend differ [format U+%04X $cp]
    }
  }
  return [list $equal $differ]
}

test font-13.1 {Liberation Sans, Serif and Mono match the standard faces' advances except for five symbols} \
    -constraints haveLiberation -body {
  # The claim the manual makes under the standard-14 table, pinned: 2555 of
  # 2592 WinAnsi advances equal (216 per face, the same count as for URW),
  # and what differs is the handful of symbols where Arial and Times New
  # Roman never were Helvetica and Times - macron, plus-minus, micro sign,
  # middle dot, division sign (U+00AF U+00B1 U+00B5 U+00B7 U+00F7); the mono
  # faces match Courier completely. Measured 2026-08-17 on release 2.1.5 and
  # again 2026-08-18 over all 216 positions (it used to skip 128..159 and
  # count 191); a newer release that moves a width shows up here first.
  set five {U+00AF U+00B1 U+00B5 U+00B7 U+00F7}
  set result {}
  set total 0
  foreach {file std} {
    LiberationSans-Regular.ttf Helvetica LiberationSans-Bold.ttf Helvetica-Bold
    LiberationSans-Italic.ttf Helvetica-Oblique LiberationSans-BoldItalic.ttf Helvetica-BoldOblique
    LiberationSerif-Regular.ttf Times-Roman LiberationSerif-Bold.ttf Times-Bold
    LiberationSerif-Italic.ttf Times-Italic LiberationSerif-BoldItalic.ttf Times-BoldItalic
    LiberationMono-Regular.ttf Courier LiberationMono-Bold.ttf Courier-Bold
    LiberationMono-Italic.ttf Courier-Oblique LiberationMono-BoldItalic.ttf Courier-BoldOblique
  } {
    lassign [metricMatch [file join $::liberation $file] $std] equal differ
    incr total $equal
    set outside {}
    foreach cp $differ {
      if {$cp ni $five} {lappend outside $cp}
    }
    lappend result [list $equal $outside]
  }
  list $total $result
} -result {2555 {{211 {}} {211 {}} {211 {}} {211 {}} {211 {}} {211 {}} {212 {}} {213 {}} {216 {}} {216 {}} {216 {}} {216 {}}}}

test font-13.2 {a Liberation face embeds and sets text under PDF/A} -constraints {haveLiberation haveTdom} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed lib [file join $::liberation LiberationSerif-Regular.ttf]
  $doc font -family lib -size 11
  $doc text "Liberation Serif in place of Times" -at {20 30}
  $doc pdfa -part 3 -conformance U
  lassign [::tclpdfTest::writes $doc font-liberation.pdf] code written
  set family [dict get [$doc font info lib] family]
  $doc destroy
  list $code $written $family
} -result {0 1 {Liberation Serif}}

# --- the standard faces through [font] --------------------------------------
#
# The resolved name is what the state reports and what /Tf names in the
# stream, so a family, a style or a PostScript name that resolves wrongly is
# visible in both places.

test font-14.1 {-family courier and symbol resolve to their standard names} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set courier [dict get [$doc font -family courier -size 10] resolved]
  $doc text "fixed" -at {20 20}
  set symbol [dict get [$doc font -family symbol] resolved]
  $doc text "abg" -at {20 30}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $courier $symbol [regexp {/FCourier 10 Tf} $content] \
      [regexp {/FSymbol 10 Tf} $content]
} -result {Courier Symbol 1 1}

test font-14.2 {-family takes a PostScript name outright} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set state [$doc font -family Times-Italic -size 11]
  $doc text "cursive" -at {20 20}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [dict get $state family] [dict get $state resolved] \
      [regexp {/FTimesItalic 11 Tf} $content]
} -result {Times-Italic Times-Italic 1}

test font-14.3 {-style italic, {bold italic} and oblique pick the variant} -body {
  set doc [tclpdf new -unit mm]
  set names {}
  foreach {family style} {times italic times {bold italic} helvetica oblique
      helvetica {bold oblique} courier {italic bold}} {
    lappend names [dict get [$doc font -family $family -style $style] resolved]
  }
  $doc destroy
  set names
} -result {Times-Italic Times-BoldItalic Helvetica-Oblique Helvetica-BoldOblique Courier-BoldOblique}

test font-14.4 {-rise on the font state reaches every line until it is reset} -body {
  # -rise is a state option: set once, it lifts every line drawn afterwards,
  # and setting it back to 0 takes the operator out of the stream again.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10 -rise 3
  $doc text "one" -at {20 20}
  $doc text "two" -at {20 30}
  $doc font -rise 0
  $doc text "three" -at {20 40}
  set content [::tclpdfTest::content $doc]
  set state [$doc font]
  $doc destroy
  list [regexp -all {3 Ts} $content] [dict get $state rise]
} -result {2 0}

test font-14.5 {font info answers postScript, unitsPerEm, characters and permission} \
    -constraints haveFont -body {
  # The four keys as [font info] hands them out, not as the parser holds them:
  # 5.2 reads family, fsType and glyphs, and font-1.1 reads the parser.
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  set info [$doc font info haus]
  $doc destroy
  list [dict get $info postScript] [dict get $info unitsPerEm] \
      [expr {[dict get $info characters] > 1000}] \
      [string range [dict get $info permission] 0 10]
} -result {DejaVuSans 2048 1 installable}

test font-14.6 {font info on a Type 1 face states that it has no fsType} \
    -constraints haveType1 -body {
  set doc [tclpdf new]
  $doc font embed t1 $type1Face
  set info [$doc font info t1]
  $doc destroy
  list [dict get $info postScript] [dict get $info unitsPerEm] \
      [dict get $info fsType] [string match {*Type 1 has no fsType*} \
      [dict get $info permission]] [expr {[dict get $info characters] > 100}]
} -result {OCRB 1000 {} 1 1}

test font-15.1 {two aliases that differ only in a space are two resources and two faces} \
    -constraints haveFont -body {
  # The resource name used to be the alias with its spaces stripped, so "a b"
  # and "ab" were one resource: the second face never got a font object and
  # its glyph numbers were drawn through the first face's CIDToGIDMap. Read
  # off the file: two Tf names, two FontDescriptors, and every glyph of the
  # second alias mapped in the ToUnicode CMap of its own object.
  set roboto [file join [file dirname $fontRegular] google Roboto-Regular.ttf]
  if {![file exists $roboto]} {
    set roboto $fontRegular
  }
  set doc [tclpdf new -unit pt -format {400 200}]
  $doc page add
  $doc font embed "a b" $fontRegular
  $doc font embed "ab" $roboto
  $doc font -family "a b" -size 24
  $doc text "DejaVu" -at {10 50}
  $doc font -family "ab" -size 24
  $doc text "Roboto" -at {10 100}
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch alias-space.pdf]
  $doc write $path
  set fonts [$doc state fonts]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [lsort -unique [regexp -all -inline {/FE[^ ]+ 24 Tf} $content]] \
      [regexp -all {/Type /FontDescriptor} $bytes] \
      [expr {[dict get $fonts {a b} number] != [dict get $fonts ab number]}]
} -result {{{/FEa#20b 24 Tf} {/FEab 24 Tf}} 2 1}

test font-15.2 {the resource name carries the alias, escaped, and is the same on every write} \
    -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed "Haus Schrift/1" $fontRegular
  $doc font -family "Haus Schrift/1" -size 10
  $doc text "x" -at {20 20}
  set content [::tclpdfTest::content $doc]
  lassign [::tclpdfTest::writeTwice $doc alias-escape] first second
  $doc destroy
  list [regexp {/FEHaus#20Schrift#2F1 10 Tf} $content] [string equal $first $second] \
      [regexp {/Font << /FEHaus#20Schrift#2F1 \d+ 0 R >>} $first]
} -result {1 1 1}

test font-15.3 {-subset takes a boolean, and says so at embed time} -constraints haveFont -body {
  # It used to be taken as given and to fail at write time - in an "if"
  # nowhere near the call that set it. Refused at the call, and refused
  # before anything is kept: the alias is not embedded afterwards.
  set doc [tclpdf new]
  set code [catch {$doc font embed haus $fontRegular -subset abc} message]
  set names [$doc font names]
  $doc font embed haus $fontRegular -subset no
  set kept [dict get [$doc state fonts] haus subset]
  $doc destroy
  list $code [string match {*-subset takes a boolean, not "abc"*} $message] $names $kept
} -result {1 1 {} no}

test font-15.4 {-metrics belongs to Type 1 and -axes/-instance to a variable face - the other way round is refused} \
    -constraints {haveFont haveType1} -body {
  # The manual promises -axes on a face without fvar is refused rather than
  # ignored; a Type 1 program was the gap, and -metrics on a TrueType face
  # the mirror image of it. Both are refused at the call, and the alias is
  # not embedded.
  set doc [tclpdf new]
  set metrics [catch {$doc font embed a $fontRegular -metrics [file rootname $type1Face].afm} m1]
  set axes [catch {$doc font embed b $type1Face -axes {wght 700}} m2]
  set instance [catch {$doc font embed c $type1Face -instance Bold} m3]
  set names [$doc font names]
  $doc destroy
  list $metrics [string match {*-metrics names the AFM of a Type 1*DejaVuSans.ttf*} $m1] \
      $axes [string match {*OCRB.pfb*is a Type 1 font program, which has no axes*} $m2] \
      $instance [string match {*is a Type 1 font program, which has no axes*} $m3] $names
} -result {1 1 1 1 1 1 {}}

test font-15.5 {an axis value outside the fvar range is refused with the range, not clamped in silence} -body {
  # The normalisation clamps, so the outlines of wght 5000 were those of 900
  # - but the name said Roboto_5000wght and StemV was 5967. Refused at the
  # call with the range; the ends of the range themselves are on the axis
  # and go through, and so does a named instance.
  set doc [tclpdf new]
  set high [catch {$doc font embed a [variableTree Roboto-Variable.ttf] -axes {wght 5000}} m1]
  set low [catch {$doc font embed b [variableTree Roboto-Variable.ttf] -axes {wdth 74.9}} m2]
  $doc font embed c [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed d [variableTree Roboto-Variable.ttf] -axes {wght 100 wdth 75}
  $doc font embed e [variableTree Roboto-Variable.ttf] -instance Bold -axes {wdth 100}
  set names [$doc font names]
  $doc destroy
  list $high [string match {*value 5000 for axis "wght" is outside its range in "Roboto-Variable.ttf" - wght runs from 100 to 900 (default 400)*} $m1] \
      $low [string match {*value 74.9 for axis "wdth"*wdth runs from 75 to 100*} $m2] $names
} -result {1 1 1 1 {c d e}}

test font-15.6 {a slnt or ital instance is an italic face in the descriptor} -body {
  # Bitcount's slnt axis runs -8 .. 0: at -8 the outlines lean, and the
  # descriptor used to say ItalicAngle 0 and Flags 4 all the same. The slnt
  # value is the angle (both count degrees counter-clockwise from the
  # vertical), and the italic flag (Table 123 bit 7) comes with it; a weight
  # instance of the same file stays upright.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed slanted [variableTree BitcountPropSingle-Variable.ttf] -axes {slnt -8 wght 700}
  $doc font embed upright [variableTree BitcountPropSingle-Variable.ttf] -axes {wght 700}
  $doc text "Bitcount" -at {20 20} -family slanted
  $doc text "Bitcount" -at {20 40} -family upright
  set path [::tclpdfTest::scratch font-slant.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set found {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
    regexp {/ItalicAngle (\S+)} $body -> angle
    regexp {/Flags (\S+)} $body -> flag
    dict set found $name [list $angle $flag]
  }
  set found
} -result {BitcountPropSingle_700wght_-8slnt {-8 68} BitcountPropSingle_700wght {0 4}}

test font-15.7 {CapHeight without sCapHeight is the top of the H, not the ascender} \
    -constraints haveFont -body {
  # DejaVu Sans carries OS/2 version 1, which has no sCapHeight, and the
  # descriptor wrote the ascender: 928 for a cap height that measures 729
  # (yMax of the H, 1493 of 2048 units). Roboto has version 4 and keeps its
  # own field, 711, which 11.2 pins - here as the control that the fallback
  # does not reach past the field.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed dejavu $fontRegular
  $doc font embed roboto [variableTree Roboto-Regular.ttf]
  $doc text "H" -at {20 20} -family dejavu
  $doc text "H" -at {20 40} -family roboto
  set path [::tclpdfTest::scratch font-capheight.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set found {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
    regexp {/CapHeight (\S+)} $body -> cap
    regexp {/Ascent (\S+)} $body -> ascent
    dict set found $name [list [format %.0f $cap] [expr {$cap < $ascent}]]
  }
  set found
} -result {DejaVuSans {729 1} Roboto-Regular {711 1}}

test font-15.8 {the Type 0 name of a CFF face carries the CMap name, as 9.7.6.1 asks} \
    -constraints {haveOtf haveFont} -body {
  # For a CIDFontType0 descendant the Type 0 font's BaseFont should be the
  # descendant's name, a hyphen and the CMap name: NimbusSans-Regular-Identity-H
  # on the Type 0 font, NimbusSans-Regular on the CIDFont and the descriptor.
  # A TrueType face (CIDFontType2) keeps one name in all three places.
  set doc [tclpdf new]
  $doc page add
  $doc font embed cff $::otf
  $doc font embed ttf $fontRegular
  $doc text "Rechnung" -at {20 20} -family cff
  $doc text "Rechnung" -at {20 40} -family ttf
  set path [::tclpdfTest::scratch font-type0-name.pdf]
  $doc write $path
  set writer [$doc writer]
  set found {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[regexp {/Subtype /(Type0|CIDFontType0|CIDFontType2)\y.*/BaseFont /(\S+)} $body -> kind name]} {
      lappend found $kind [regsub {^[A-Z]{6}\+} $name {}]
    }
  }
  $doc destroy
  file delete $path
  set pairs {}
  foreach {kind name} $found {
    lappend pairs "$kind $name"
  }
  lsort $pairs
} -result {{CIDFontType0 NimbusSans-Regular} {CIDFontType2 DejaVuSans} {Type0 DejaVuSans} {Type0 NimbusSans-Regular-Identity-H}}

test font-15.9 {permission reads the subsetting and bitmap bits, and knows an absent OS/2} \
    -constraints haveFont -body {
  # fsType 0x0100 forbids subsetting and 0x0200 allows bitmap embedding only
  # (OpenType OS/2); read as the low nibble alone both answered "installable".
  # A face without an OS/2 table has stated nothing - the subset this package
  # writes is such a face - and that is "unknown", not 0.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "H" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-fstype.pdf]
  $doc write $path
  set writer [$doc writer]
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[regexp {/FontFile2 (\d+) 0 R} [$writer body $number] -> fileNumber]} {
      set subset [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
    }
  }
  $doc destroy
  file delete $path
  list [::tclpdf::sfnt permission 0x0100] [::tclpdf::sfnt permission 0x0208] \
      [::tclpdf::sfnt permission 0x0304] [dict get $subset fsType] \
      [::tclpdf::sfnt permission [dict get $subset fsType]]
} -result {{installable - no restriction on embedding; no subsetting (bit 8)} {editable; bitmap embedding only (bit 9)} {preview and print only; no subsetting (bit 8); bitmap embedding only (bit 9)} {} {unknown - the face has no OS/2 table and states no permission}}

test font-15.10 {font info names an instance of a variable face as it is embedded} -body {
  # Measured before this: -instance Bold and -axes {wght 620} both answered
  # Roboto-Regular - name id 6, which names the file's default. The name a
  # reader sees is the instance's (TN 5902), and font info answers that one.
  set doc [tclpdf new -unit mm]
  $doc page add
  set names {}
  foreach {alias options} {bold {-instance Bold} between {-axes {wght 620}}
      plain {}} {
    $doc font embed $alias [variableTree Roboto-Variable.ttf] {*}$options
    lappend names [dict get [$doc font info $alias] postScript]
  }
  $doc destroy
  set names
} -result {Roboto-Bold Roboto_620wght Roboto-Regular}

# Damaged and norm-breaking cmaps, built rather than found (the platform 0
# name fixture above sets the pattern): DejaVu carries a format 12 subtable
# as (3,10) and (0,10) - both records point at the same table, and (3,10) is
# the one the parser prefers - so the fixtures patch that table in place.
proc fontPatchCmap12 {source target patches} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables cmap] cmapAt -
  binary scan $bytes @[expr {$cmapAt + 2}]Su count
  set table -1
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$cmapAt + 4 + $index * 8}]
    binary scan $bytes @${at}SuSuIu platform encoding offset
    if {$platform == 3 && $encoding == 10} {
      set table [expr {$cmapAt + $offset}]
    }
  }
  foreach patch $patches {
    switch -- [lindex $patch 0] {
      ngroups {
        set bytes [string replace $bytes [expr {$table + 12}] \
            [expr {$table + 15}] [binary format Iu [lindex $patch 1]]]
      }
      group {
        lassign $patch - group start end glyph
        set at [expr {$table + 16 + $group * 12}]
        set bytes [string replace $bytes $at [expr {$at + 11}] \
            [binary format IuIuIu $start $end $glyph]]
      }
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-16.1 {a format 12 group that ends before it starts is refused by name} \
    -constraints haveFont -body {
  # Group 0 of DejaVu maps 0x20..0x7E; turned around it becomes damage the
  # old loop silently skipped (an empty for loop) - accepting a font whose
  # character map lies about itself.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-turned.ttf] {{group 0 0x20 0x1F 3}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 0 ends (0x1F) before it starts (0x20)}}

test font-16.2 {a format 12 group ending at 0xFFFFFFFF is refused at once, not iterated} \
    -constraints haveFont -body {
  # The case that made the check necessary: end is read as an unsigned
  # 32-bit value, and 0xFFFFFFFF sent the inner loop into four billion
  # iterations - font embed hung instead of refusing. The elapsed time is
  # part of the assertion: a refusal that takes minutes is still a hang.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-huge.ttf] {{group 0 0x20 0xFFFFFFFF 3}}]
  set before [clock milliseconds]
  set code [catch {::tclpdf::sfnt read $path} message]
  set elapsed [expr {[clock milliseconds] - $before}]
  file delete $path
  list $code $message [expr {$elapsed < 1000}]
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 0 ends at 0xFFFFFFFF, beyond the last Unicode code point 0x10FFFF} 1}

test font-16.3 {a format 12 group just past the last code point is refused, not mapped} \
    -constraints haveFont -body {
  # The small-overshoot twin of 16.2, and the one that keeps the bound
  # honest: without the check this group maps four code points beyond
  # Unicode and the font parses - a wrong acceptance a test can see without
  # hanging the suite, where removing the check under 16.2 would.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-past.ttf] {{group 280 0x10FFFE 0x110001 3}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 280 ends at 0x110001, beyond the last Unicode code point 0x10FFFF}}

test font-16.4 {a format 12 group count past the end of the file is refused before the loop} \
    -constraints haveFont -body {
  # nGroups steers the outer loop; 0x10000000 groups would ask for 3 GB of
  # table. Without the check the loop runs until binary scan falls off the
  # end of the file and dies with a raw Tcl error instead of a refusal.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-count.ttf] {{ngroups 0x10000000}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -match glob -result {1 {tclpdf: the cmap table is damaged - format 12 declares 268435456 groups where only * bytes follow}}

test font-16.5 {the checks cost the intact face nothing - DejaVu still embeds} \
    -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch cmap12-intact.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans\y} $bytes
} -result 2

test font-16.6 {a format 12 cmap entry on a surrogate code point never enters the map} \
    -constraints haveFont -body {
  # OpenType forbids surrogate code points in a cmap, but a norm-breaking
  # font can carry one - and passed through it became a lone surrogate in
  # the ToUnicode CMap (ISO 32000-2 9.10.3 requires well-formed UTF-16BE).
  # Group 3 of DejaVu is a single-code group (U+02F3), rebuilt here as a
  # single-code group on U+D800 pointing at a real glyph.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 36}}]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set cmap [dict get $parsed cmap]
  # 55296 is 0xD800 as the map keys it; 65 -> 36 is the positive control
  # proving the probe reads the map that would have carried the entry.
  list [dict exists $cmap 55296] [dict get $cmap 65]
} -result {0 36}

test font-16.7 {a surrogate is "no glyph" at setting time - the refusal contract holds} \
    -constraints haveFont -body {
  # The character counts as absent, so setting it refuses with the same
  # errorCode as any missing glyph - the contract from the manual's "Error
  # codes" section survives the norm-breaking font.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 36}}]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  set code [catch {$doc text [format %c 0xD800] -at {20 20} -family haus} \
      message options]
  $doc destroy
  file delete $path
  list $code [lrange [dict get $options -errorcode] 0 3]
} -result {1 {TCLPDF FONT GLYPH U+D800}}

test font-16.8 {the ToUnicode CMap of the written file carries no lone surrogate} \
    -constraints haveFont -body {
  # The end the norm cares about: the file. The surrogate is ATTEMPTED (its
  # own glyph, 37, so a leak would write its own bfchar) and the written
  # ToUnicode CMap maps A - the positive control proving the probe reads the
  # right stream - while holding no <D800> target anywhere.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 37}}]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  $doc text "A" -at {20 20} -family haus
  catch {$doc text [format %c 0xD800] -at {20 30} -family haus}
  set glyphA [dict get [$doc state fonts] haus parsed cmap 65]
  set pdf [::tclpdfTest::scratch cmap12-surrogate.pdf]
  $doc write $pdf
  set writer [$doc writer]
  set toUnicodeNumber {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[regexp {/ToUnicode (\d+) 0 R} [$writer body $number] -> found]} {
      set toUnicodeNumber $found
    }
  }
  set toUnicode [::tclpdfTest::streamOf $writer $toUnicodeNumber]
  $doc destroy
  file delete $pdf $path
  list [regexp "<[format %04X $glyphA]> <0041>" $toUnicode] \
      [regexp -nocase {<D800>} $toUnicode]
} -result {1 0}

test font-16.9 {a format 4 cmap entry on a surrogate code point never enters the map} \
    -constraints haveFont -body {
  # The same door in the other format: format 4 is BMP-only and can carry
  # D800-DFFF just as well. DejaVu's format 12 records are demoted to an
  # unknown platform so the (3,1) format 4 table is the one chosen, and its
  # last PUA segment is rebuilt as a single-code segment on U+D800 with a
  # delta pointing at a real glyph.
  set channel [open $fontRegular rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables cmap] cmapAt -
  binary scan $bytes @[expr {$cmapAt + 2}]Su count
  set table -1
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$cmapAt + 4 + $index * 8}]
    binary scan $bytes @${at}SuSuIu platform encoding offset
    if {$encoding == 10} {
      # Out of the running: platform 5 scores below every Unicode record.
      set bytes [string replace $bytes $at [expr {$at + 1}] \
          [binary format Su 5]]
    } elseif {$platform == 3 && $encoding == 1} {
      set table [expr {$cmapAt + $offset}]
    }
  }
  binary scan $bytes @[expr {$table + 6}]Su segCountX2
  set endBase [expr {$table + 14}]
  set startBase [expr {$endBase + $segCountX2 + 2}]
  set deltaBase [expr {$startBase + $segCountX2}]
  set rangeBase [expr {$deltaBase + $segCountX2}]
  for {set segment 0} {$segment < $segCountX2 / 2} {incr segment} {
    set two [expr {$segment * 2}]
    binary scan $bytes @[expr {$startBase + $two}]Su start
    if {$start >= 0xE000 && $start != 0xFFFF} {
      foreach {base value} [list $endBase 0xD800 $startBase 0xD800 \
          $deltaBase [expr {(36 - 0xD800) & 0xFFFF}] $rangeBase 0] {
        set bytes [string replace $bytes [expr {$base + $two}] \
            [expr {$base + $two + 1}] [binary format Su $value]]
      }
      break
    }
  }
  set path [::tclpdfTest::scratch cmap4-surrogate.ttf]
  set channel [open $path wb]
  puts -nonewline $channel $bytes
  close $channel
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set cmap [dict get $parsed cmap]
  # Without the skip, D800 maps to (0xD800 + delta) & 0xFFFF = 36. The
  # positive control 65 -> 36 proves the format 4 table is the one read.
  list [dict exists $cmap 55296] [dict get $cmap 65]
} -result {0 36}

# --- two faces in one line: what the file then holds --------------------------
#
# The fallback chain of text.tcl decides WHICH face sets which character; what
# has to be true here is that each of them is written as the face it is - its
# own subset, its own widths, its own ToUnicode map. A map that carried the
# other face's characters would extract the line as noise while every
# validator called the file clean, which is the defect class this whole
# module is careful about.

set jpFace [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts google NotoSansJP-Regular.ttf]
testConstraint haveJpFace [expr {[file exists $jpFace] && [file exists $fontRegular]}]

# The ToUnicode CMap of every font object of a written document, by the
# BaseFont name the object carries.
proc fontToUnicodeMaps {doc} {
  set writer [$doc writer]
  set maps {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {![regexp {/ToUnicode (\d+) 0 R} $body -> map]} {
      continue
    }
    regexp {/BaseFont /(?:[A-Z]{6}\+)?(\S+?)[ />]} $body -> name
    dict set maps $name [::tclpdfTest::streamOf $writer $map]
  }
  return $maps
}

test font-17.1 {each face of a mixed line gets its own object and its own ToUnicode map} \
    -constraints haveJpFace -body {
  set path [::tclpdfTest::scratch font-chain.pdf]
  set doc [tclpdf new -unit pt]
  $doc font embed body $fontRegular
  $doc font embed jp $jpFace
  $doc page add
  $doc font -family body -size 12 -fallback jp
  $doc text "Rechnung 東京" -at {20 40}
  $doc write $path
  set maps [fontToUnicodeMaps $doc]
  $doc destroy
  file delete $path
  # U+006E (the n of Rechnung) belongs to DejaVu and U+6771 (東) to Noto Sans
  # JP, and neither map may know the other's character: the maps are per font
  # and a glyph number means nothing outside the face it came from.
  list [lsort [dict keys $maps]] \
      [regexp {<006E>} [dict get $maps DejaVuSans]] \
      [regexp {<6771>} [dict get $maps DejaVuSans]] \
      [regexp {<6771>} [dict get $maps NotoSansJP-Regular]] \
      [regexp {<006E>} [dict get $maps NotoSansJP-Regular]]
} -result {{DejaVuSans NotoSansJP-Regular} 1 0 1 0}

test font-17.2 {a face the chain never needs costs the file nothing} \
    -constraints haveJpFace -body {
  # The reason a chain may be long: an embedded face that nothing falls back
  # to reserves no object and appears in no resource dictionary, because
  # [FontResource] is what reserves one and only the drawing calls it. So the
  # document is byte for byte the one written without the chain.
  set doc [tclpdf new -unit pt]
  $doc font embed body $fontRegular
  $doc font embed jp $jpFace
  $doc page add
  $doc font -family body -size 12 -fallback jp
  $doc text "Rechnung 4711" -at {20 40}
  set withChain [::tclpdfTest::scratch font-chain-unused.pdf]
  $doc write $withChain
  set bytes [::tclpdfTest::readBytes $withChain]
  set resources [dict keys [$doc resource Font]]
  set number [dict get [$doc state fonts] jp number]
  $doc destroy
  file delete $withChain
  list $resources $number [regexp {NotoSansJP} $bytes]
} -result {FEbody {} 0}

test font-17.3 {a mixed line keeps PDF/A-3B - both faces embedded and subset} \
    -constraints {haveJpFace haveTdom} -body {
  # Asked of veraPDF, which is the only thing here that reads the file as the
  # standard does. A missing width, a font program left out for one of the two
  # faces or a ToUnicode map on the wrong object are all rule failures there.
  set path [::tclpdfTest::scratch font-chain-pdfa.pdf]
  set doc [tclpdf new -unit mm]
  $doc info Title "Two faces in one line"
  $doc page add
  $doc font embed body $fontRegular
  $doc font embed jp $jpFace
  $doc font -family body -size 12 -fallback jp
  $doc text "Rechnung 4711 東京 Tokyo" -at {20 30}
  $doc pdfa -part 3 -conformance B \
      -profile [file join [file dirname [file dirname [file normalize [info script]]]] \
          icc sRGB.icc] -identifier "sRGB IEC61966-2.1"
  $doc write $path
  $doc destroy
  set report [::tclpdfTest::verapdf $path 3b]
  file delete $path
  set report
} -result ok


# -- GPOS mark attachment ----------------------------------------------------
#
# What comes back out of [FontRunMarks], which is the one thing font.tcl adds
# to the reader in markPos.tcl: the same answer in the unit a TJ number is
# written in, and NOTHING at all for a run that has no mark to place. The
# second half is what keeps every document without marks at the bytes it had.
#
# Every number below was read twice - once out of this package and once out of
# hb-shape (HarfBuzz 14.3.1), which is what a browser sets the same text with.
# The font units are stated in the comments because that is the unit the font
# and hb-shape speak; the thousandths beside them are the same number divided
# by the em.

set markFace [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts google Roboto-Regular.ttf]
testConstraint haveMarkChain [file exists $markFace]
set arabicFace [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts google NotoNaskhArabic-Variable.ttf]
testConstraint haveArabic [file exists $arabicFace]

# The marks of a string, as the drawing side gets them. Both methods are
# internal and stay so - the object is asked to export them for the length of
# the test, the same device table.test uses for [TableGroupSpan].
proc fontMarksOf {doc alias text {direction ltr}} {
    oo::objdefine $doc export FontRun FontRunMarks
    return [$doc FontRunMarks $alias [$doc FontRun $alias $text 0 0 $direction]]
}

test font-18.1 {a combining mark is placed where the anchors say} -constraints haveFont -body {
  # DejaVu Sans, "b" + U+0300: hb-shape puts the grave at -510,373 font units
  # from the pen, and the em is 2048 - so -249.0234375 and 182.12890625
  # thousandths. Untouched, the grave would be drawn at the pen, which for a
  # glyph of zero advance means on top of whatever comes next.
  set doc [tclpdf new]
  $doc font embed body $fontRegular
  set marks [fontMarksOf $doc body "b\u0300"]
  $doc destroy
  set marks
} -result {{0 0} {-249.0234375 182.12890625}}

test font-18.2 {the offset of a mark on a mark adds to the one below it} \
    -constraints haveMarkChain -body {
  # Roboto, "b" + U+0300 + U+0301: hb-shape gives 14,321 and 50,672 font
  # units, em 2048. The second number is the chain - the acute hangs on the
  # grave and inherits where the grave went, which is what stacks a Vietnamese
  # tone mark above a vowel sign instead of through it.
  set doc [tclpdf new]
  $doc font embed body $markFace
  set marks [fontMarksOf $doc body "b\u0300\u0301"]
  $doc destroy
  set marks
} -result {{0 0} {6.8359375 156.73828125} {24.4140625 328.125}}

test font-18.3 {a run with nothing to place answers with nothing} -constraints haveFont -body {
  # The empty answer is the contract, not a shortcut: [TextEmit] writes no
  # operator for it, and that is what keeps a document of ordinary prose at
  # the bytes it had before this existed. A single glyph never has a mark
  # either - a mark needs something in front of it.
  set doc [tclpdf new]
  $doc font embed body $fontRegular
  set marks [list [fontMarksOf $doc body "Marz"] [fontMarksOf $doc body "b"]]
  $doc destroy
  set marks
} -result {{} {}}

test font-18.4 {a placed mark does not change the width of the run} -constraints haveFont -body {
  # Mark attachment moves a glyph, not the pen: the offset is written in front
  # of the mark and taken back behind it, and the combining acute has an
  # advance of 0. So the three spellings of the same word - none, precomposed,
  # decomposed - have to measure the same to the last bit.
  set doc [tclpdf new]
  $doc font embed body $fontRegular
  oo::objdefine $doc export FontRun FontRunWidth
  set widths {}
  foreach text [list "Marz" "M\u00E1rz" "Ma\u0301rz"] {
    lappend widths [$doc FontRunWidth body [$doc FontRun body $text] 20]
  }
  $doc destroy
  list [expr {[lindex $widths 0] == [lindex $widths 1]}] \
      [expr {[lindex $widths 1] == [lindex $widths 2]}] [lindex $widths 0]
} -result {1 1 48.232421875}

test font-18.5 {a face that writes its dots as glyphs is no longer refused} \
    -constraints haveArabic -body {
  # NotoNaskhArabic writes beh as a skeleton plus a separate dot, and this
  # run was refused outright while nothing could place that dot. It now comes
  # back four glyphs long - three letters and the dot - with the dot the only
  # one carrying an offset. hb-shape puts it at 70,-31 from the ORIGIN of the
  # letter, which behind an advance of 275 is -205,-31 from the pen; the em is
  # 1000, so the thousandths are the font units.
  set doc [tclpdf new]
  $doc font embed body $arabicFace
  oo::objdefine $doc export FontRun FontRunMarks
  set run [$doc FontRun body "\u0628\u0633\u0645" 0 0 rtl]
  set marks [$doc FontRunMarks body $run]
  $doc destroy
  list [llength $run] [lmap item $run {lindex $item 0}] $marks
} -result {4 {19 322 34 75} {{0 0} {-205.0 -31.0} {0 0} {0 0}}}

# --- an entry that is not this module's --------------------------------------
#
# [state fonts] holds every font of the document, whatever module made it: the
# type3 module (type3.tcl) writes its own entries out of the same dictionary
# on the same event. The font module walks all of them and used to ask only
# whether an entry was "type1", letting everything else fall into the sfnt
# road - so a document with a drawn font beside an embedded face died at write
# time on [dict get $entry parsed], with a bare Tcl "key not known in
# dictionary" naming nothing a caller could act on. The mixed document itself
# is written in type3.test; what is checked here is the dispatch.

test font-19.1 {a kind with no way of being written is refused by name} \
    -constraints haveFont -body {
  # Poked into the state rather than embedded, because every kind this package
  # HAS now has a road - which is the point. The next kind added without one
  # has to arrive as this message and not as a dict lookup six levels down.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed body $fontRegular
  $doc font -family body -size 12
  $doc text "written" -at {20 40}
  set fonts [$doc state fonts]
  dict set fonts body kind sixteenthCentury
  $doc state fonts $fonts
  set code [catch {$doc write [::tclpdfTest::scratch font-19.1.pdf]} message options]
  $doc destroy
  file delete [::tclpdfTest::scratch font-19.1.pdf]
  list $code [dict get $options -errorcode] \
      [string match {tclpdf: the font "body" is of kind "sixteenthCentury"*} $message]
} -result {1 {TCLPDF FONT KIND sixteenthCentury body} 1}

test font-19.2 {the two kinds this module writes still take their own roads} \
    -constraints {haveFont haveType1} -body {
  # Both roads through the one switch, in one document: the sfnt face comes
  # out as a Type 0 with FontFile2, the Type 1 program as a simple font with
  # FontFile. A dispatcher that sent both down the same road would still write
  # a file, and only the objects say which.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed sfnt $fontRegular
  $doc font embed old $type1Face
  $doc font -family sfnt -size 12
  $doc text "TrueType" -at {20 40}
  $doc font -family old -size 12
  $doc text "Type 1" -at {20 60}
  set path [::tclpdfTest::scratch font-19.2.pdf]
  $doc write $path
  set result [list [llength [::tclpdfTest::objects $doc {/Subtype /Type0}]] \
      [llength [::tclpdfTest::objects $doc /FontFile2]] \
      [llength [::tclpdfTest::objects $doc {/Subtype /Type1}]] \
      [llength [::tclpdfTest::objects $doc {/FontFile }]]]
  $doc destroy
  file delete $path
  set result
} -result {1 1 1 1}

# A face whose characters all reach an EMPTY outline - what a colour font
# (COLR/CPAL, CBDT, sbix, SVG) looks like from the outside. Built rather than
# found, in the manner of the cmap fixtures above: the loca table of a real
# face is filled with zeros, so every glyph begins and ends in the same place
# and nothing else about the file changes. That is the point of building it
# this way - the fixture carries no colour table at all, so a refusal it
# provokes can only hang on the outlines.
proc fontBlankOutlines {source target} {
  set bytes [::tclpdfTest::readBytes $source]
  binary scan $bytes @4Su count
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {12 + $index * 16}]
    binary scan $bytes @${at}a4IuIuIu tag checksum offset length
    if {$tag eq "loca"} {
      set bytes [string replace $bytes $offset [expr {$offset + $length - 1}] \
          [string repeat \x00 $length]]
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-20.1 {a face that draws nothing is refused at the embed} \
    -constraints haveFont -body {
  # The defect this guards against was measured with a colour emoji face:
  # font embed, text and write all reported success, pdftotext gave the code
  # point back, pdffonts showed a clean subset - and the page was blank,
  # because the pictures sit in a table this package does not write. No tool
  # make check runs sees it, so it is refused where the face goes in.
  set path [fontBlankOutlines $fontRegular \
      [::tclpdfTest::scratch blank-outlines.ttf]]
  set doc [tclpdf new -unit pt]
  $doc page add
  set code [catch {$doc font embed blank $path} message options]
  $doc destroy
  file delete $path
  list $code [lrange [dict get $options -errorcode] 0 3] \
      [string match {*draws nothing*EMPTY outline*} $message]
} -result {1 {TCLPDF FONT OUTLINES blank} 1}

test font-20.2 {and the same face with its outlines intact goes in} \
    -constraints haveFont -body {
  # The control: the fixture differs from this file in the loca table and in
  # nothing else, so a refusal that fired here would be about something else.
  set doc [tclpdf new -unit pt]
  $doc page add
  set code [catch {$doc font embed body $fontRegular} message]
  $doc destroy
  list $code $message
} -result {0 body}

test font-20.3 {an empty outline of its own says nothing - the space has one} \
    -constraints haveFont -body {
  # The case the check must NOT trip over: a face where single characters
  # draw nothing is the ordinary case, not a broken one. Measured in this
  # face: 61 of its 5918 characters have no outline, the space among them.
  # It takes ALL of them to make a face that draws nothing.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set loca [dict get $parsed loca]
  set cmap [dict get $parsed cmap]
  set empty 0
  dict for {code glyph} $cmap {
    if {[lindex $loca [expr {$glyph + 1}]] <= [lindex $loca $glyph]} {
      incr empty
    }
  }
  set space [dict get $cmap 32]
  set doc [tclpdf new -unit pt]
  $doc page add
  set code [catch {$doc font embed body $fontRegular} message]
  $doc font -family body -size 12
  $doc text "a b" -at {20 40}
  $doc destroy
  list [expr {[lindex $loca [expr {$space + 1}]]
          <= [lindex $loca $space]}] [expr {$empty > 0}] \
      [expr {$empty < [dict size $cmap]}] $code
} -result {1 1 1 0}

# -- vertical writing: the metric -------------------------------------------
#
# THE POINT OF EVERY TEST BELOW is that hmtx says nothing about it. A vertical
# line built from the horizontal advances renders - the glyphs are the right
# glyphs, they stand one under the other, qpdf calls the file clean and
# veraPDF passes it - and every gap in it is wrong. So what is asserted here
# is never "there is a number" but always "the number is the one vmtx says
# and NOT the one hmtx says".
#
# The specimen is Noto Sans JP, the only face in this tree with vertical
# metrics: measured 2026-08-24, its vhea announces 16776 long vertical
# metrics, 16522 of its 17103 glyphs sit at the default vertical origin 880
# and 17096 of them advance the default 1000 - which is why the two glyphs
# that DON'T carry most of the weight here. U+3031, the vertical kana repeat
# mark, is 1000 units wide and 2000 units tall; U+2103, the degree-Celsius
# sign, hangs from 867 rather than 880.

test font-21.1 {vhea and vmtx are read} -constraints haveJpFace -body {
  set parsed [::tclpdf::sfnt read $::jpFace]
  set repeat [dict get $parsed cmap 12337]
  list [::tclpdf::sfnt hasVertical $parsed] \
      [dict get $parsed vertical numOfLongVerMetrics] \
      [::tclpdf::sfnt verticalAdvance $parsed $repeat] \
      [::tclpdf::sfnt advance $parsed $repeat]
} -result {1 16776 2000 1000}

test font-21.2 {a face without vertical metrics says so, and says {}} \
    -constraints haveFont -body {
  # DejaVu Sans has neither vhea nor vmtx. {} rather than a made-up number:
  # PDF has a defined default for exactly this case, and inventing one here
  # would hide from the caller that the default is what they are getting.
  set parsed [::tclpdf::sfnt read $::fontRegular]
  list [::tclpdf::sfnt hasVertical $parsed] \
      [::tclpdf::sfnt verticalAdvance $parsed 5] \
      [::tclpdf::sfnt verticalBearing $parsed 5] \
      [::tclpdf::sfnt verticalOriginY $parsed 5 700]
} -result {0 {} {} {}}

test font-21.3 {the vertical origin is yMax plus the top side bearing} \
    -constraints haveJpFace -body {
  # The one place the format asks for arithmetic: vmtx stores the gap between
  # the origin and the TOP OF THE BOX, not the origin. Reading the bearing as
  # the origin would put every glyph its own box-height out of place.
  set parsed [::tclpdf::sfnt read $::jpFace]
  set celsius [dict get $parsed cmap 8451]
  set bearing [::tclpdf::sfnt verticalBearing $parsed $celsius]
  # yMax of that glyph, read straight out of the glyph record.
  set loca [dict get $parsed loca]
  binary scan [string range [::tclpdf::sfnt table $parsed glyf] \
      [lindex $loca $celsius] [expr {[lindex $loca [expr {$celsius + 1}]] - 1}]] \
      @8S yMax
  list [::tclpdf::sfnt verticalOriginY $parsed $celsius $yMax] \
      [expr {$yMax + $bearing}] [expr {$bearing != 867}]
} -result {867 867 1}

test font-21.4 {VORG wins over vmtx where a face has one} -body {
  # No face in this tree carries VORG - it is an OpenType/CFF table and Noto
  # Sans JP has TrueType outlines - so the branch is exercised on a font dict
  # built by hand. That is worth doing rather than skipping: VORG is the only
  # road for a CFF CJK face, and an untested branch there would be found by
  # whoever first embeds one.
  set font [dict create vertical [dict create \
      origins [dict create 7 1234] originDefault 900 \
      bearings {0 0 0 0 0 0 0 0} advances {} lastAdvance 0]]
  list [::tclpdf::sfnt verticalOriginY $font 7 500] \
      [::tclpdf::sfnt verticalOriginY $font 3 500]
} -result {1234 900}

test font-21.5 {an unused face still carries no vertical metric into the file} \
    -constraints haveJpFace -body {
  # /DW2 and /W2 are written only for a face something was actually set
  # vertically with. A document that never asks for a vertical line has to
  # come out byte for byte as it did before this existed.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "日" -at {20 20} -family jp -size 12
  set path [::tclpdfTest::scratch font-vertical-none.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/DW2} $bytes] [regexp {/W2} $bytes] \
      [regexp {/Identity-V} $bytes] [regexp {/Identity-H} $bytes]
} -result {0 0 0 1}

test font-21.6 {a vertical line writes Identity-V beside Identity-H} \
    -constraints haveJpFace -body {
  # TWO Type 0 fonts over ONE descendant: the writing mode is a property of
  # the CMap the Type 0 font names (9.7.4.3), and PDF has no operator that
  # switches between them. What must NOT happen is a second descendant, a
  # second descriptor or a second copy of the font file.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "日" -at {20 20} -family jp -size 12
  $doc text "日" -at {60 20} -family jp -size 12 -direction ttb
  set path [::tclpdfTest::scratch font-vertical-both.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/Encoding /Identity-H} $bytes] \
      [regexp -all {/Encoding /Identity-V} $bytes] \
      [regexp -all {/Subtype /CIDFontType2} $bytes] \
      [regexp -all {/FontFile2} $bytes] \
      [regexp -all {/Type /FontDescriptor} $bytes]
} -result {1 1 1 1 1}

test font-21.7 {a face set ONLY vertically writes no horizontal font object} \
    -constraints haveJpFace -body {
  # The trap this guards: [FontResource] is what reserves the object number a
  # Type 0 font is written under, and a vertical line never calls it. The
  # writer used to skip such a face entirely - the resource dictionary then
  # pointed at an object that was reserved and never written, which is qpdf's
  # "object(s) reserved but never written" over a document whose text is
  # simply absent.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "日本" -at {60 60} -family jp -size 12 -direction ttb
  set path [::tclpdfTest::scratch font-vertical-only.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/Encoding /Identity-H} $bytes] \
      [regexp -all {/Encoding /Identity-V} $bytes] \
      [regexp {/FontFile2} $bytes] [regexp {/ToUnicode} $bytes]
} -result {0 1 1 1}

test font-21.8 {/DW2 is written at the standard's own default} \
    -constraints haveJpFace -body {
  # 880 -1000, ISO 32000-2 9.7.4.3. Said in the file rather than left out,
  # because it is the number nearly every glyph of a CJK face wants and the
  # file is then readable without knowing which default is in force.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "日本語" -at {60 60} -family jp -size 12 -direction ttb
  set path [::tclpdfTest::scratch font-vertical-dw2.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # /W2 absent, and that is the assertion, not an omission: all three glyphs
  # sit at the default origin and advance the default height, so there is
  # nothing that differs from /DW2 to write down.
  list [regexp {/DW2 \[880 -1000\]} $bytes] [regexp {/W2} $bytes]
} -result {1 0}

test font-21.9 {/W2 carries three numbers for the glyphs that differ} \
    -constraints haveJpFace -body {
  # w1y, then the position vector's x and y. The x is half the HORIZONTAL
  # advance (9.4.4) - the number that centres a glyph over its column - and
  # it is written even though it equals the default, because /W2 gives all
  # three or none.
  #
  # U+3031 advances 2000 against a width of 1000, U+2103 hangs from 867.
  # Those two numbers are the whole reason this feature is more than one line
  # of CMap name: neither of them is anywhere in hmtx.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "〱℃" -at {60 60} -family jp -size 12 -direction ttb
  set path [::tclpdfTest::scratch font-vertical-w2.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/W2 (\[.*?\]\])} $bytes -> array
  # The default origin 880 must NOT appear inside it: a glyph that sits at
  # the default is left out of /W2 altogether, which is what keeps the array
  # of an ordinary CJK document empty.
  list $array [regexp {880} $array]
} -result {{[499 [-1000 500 867] 1187 [-2000 500 1380]]} 0}

test font-21.10 {the subset carries a rebuilt vhea and vmtx} \
    -constraints haveJpFace -body {
  # PDF does not read them - the displacement comes from /W2 and /DW2 - but
  # the embedded file is a font, and a font whose vhea announces 16776
  # vertical metrics over a vmtx holding four is broken for everything that
  # opens it as one. Renumbered like hmtx beside it: the tall glyph has to
  # still be tall at its new number.
  set parsed [::tclpdf::sfnt read $::jpFace]
  set built [::tclpdf::subset build $parsed \
      [list [dict get $parsed cmap 12337] [dict get $parsed cmap 26085]]]
  set subset [::tclpdf::sfnt parse [dict get $built bytes]]
  set repeat [dict get $built glyphs [dict get $parsed cmap 12337]]
  list [::tclpdf::sfnt hasVertical $subset] \
      [dict get $subset numGlyphs] \
      [dict get $subset vertical numOfLongVerMetrics] \
      [::tclpdf::sfnt verticalAdvance $subset $repeat] \
      [::tclpdf::sfnt advance $subset $repeat]
} -result {1 3 3 2000 1000}

test font-21.11 {a subset of a face without vertical metrics gets none} \
    -constraints haveFont -body {
  # The other half of the same rule: vhea and vmtx are written ONLY where the
  # source has them, so every subset this package has ever produced is
  # unchanged.
  set parsed [::tclpdf::sfnt read $::fontRegular]
  set built [::tclpdf::subset build $parsed [list [dict get $parsed cmap 65]]]
  set subset [::tclpdf::sfnt parse [dict get $built bytes]]
  list [::tclpdf::sfnt hasVertical $subset] \
      [expr {"vhea" in [dict keys [dict get $subset tables]]}] \
      [expr {"vmtx" in [dict keys [dict get $subset tables]]}]
} -result {0 0 0}

test font-21.12 {the GSUB feature vert gives the vertical glyph forms} \
    -constraints haveJpFace -body {
  # A bracket, a comma and an ellipsis are OTHER GLYPHS in a vertical line,
  # not the same ones turned: the comma moves from the bottom left of its
  # square to the top right, and the face carries both. Drawn through the
  # existing gsubApply machinery - it is a plain single substitution, lookup
  # type 1, the same kind the ligatures use.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed jp $::jpFace
  $doc text "「、…" -at {20 20} -family jp -size 12
  $doc text "「、…" -at {60 20} -family jp -size 12 -direction ttb
  set glyphs [::tclpdfTest::glyphIds [::tclpdfTest::content $doc]]
  # And the characters those glyphs stand for, read back through the
  # ToUnicode map: the substitution must not reach it, or a vertical line
  # renders perfectly and extracts as noise. Written first, because the font
  # objects are built at write time - that is when the used glyphs are known.
  set path [::tclpdfTest::scratch font-vertical-forms.pdf]
  $doc write $path
  file delete $path
  set map [lindex [dict values [fontToUnicodeMaps $doc]] 0]
  $doc destroy
  # 0x047E is the horizontal corner bracket, 0x3B7D the vertical one, and
  # BOTH map back to U+300C - the character the caller wrote. A map that had
  # been turned round with the glyphs would name the vertical form's own
  # code point, which is not a character at all.
  list $glyphs [regexp {<047E> <300C>} $map] [regexp {<3B7D> <300C>} $map]
} -result {{{1150 1139 479} {15229 15203 15211}} 1 1}

test font-21.13 {a face with no vert feature passes its run through} \
    -constraints haveFont -body {
  # DejaVu Sans has no vertical forms, and a vertical line set in it is not
  # refused for that: the glyphs are simply the ones it has. What must not
  # happen is a refusal or a changed glyph.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed body $::fontRegular
  $doc text "Ja" -at {20 20} -family body -size 12
  $doc text "Ja" -at {60 20} -family body -size 12 -direction ttb
  set glyphs [::tclpdfTest::glyphIds [::tclpdfTest::content $doc]]
  $doc destroy
  list [expr {[lindex $glyphs 0] eq [lindex $glyphs 1]}] \
      [llength [lindex $glyphs 1]]
} -result {1 2}

test font-21.14 {font info reports whether a face can be set vertically} \
    -constraints {haveJpFace haveFont} -body {
  set doc [tclpdf new -unit pt]
  $doc font embed jp $::jpFace
  $doc font embed body $::fontRegular
  set answer [list [dict get [$doc font info jp] vertical] \
      [dict get [$doc font info body] vertical]]
  $doc destroy
  set answer
} -result {1 0}

test font-21.15 {a face with no vmtx falls back on the PDF default} \
    -constraints haveFont -body {
  # Not refused - ISO 32000-2 9.7.4.3 defines the case, and the default is
  # one em per glyph. So a vertical line in DejaVu Sans is a column of square
  # cells, which is the only defined answer, and the extent is the glyph
  # count times the size whatever the letters are.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed body $::fontRegular
  set extent [$doc textWidth "Wi" -family body -size 10 -direction ttb]
  set width [$doc textWidth "Wi" -family body -size 10]
  $doc destroy
  list $extent [expr {$width != $extent}]
} -result {20.0 1}


# -- the bare CFF, -data, and what font info promises ------------------------
#
# A BARE CFF is the table an .otf carries its outlines in, on its own, with no
# sfnt around it: no cmap, so no character reaches a glyph; no hmtx, so no
# glyph has a width; no name, so the face has no PostScript name; no head, so
# the em has no size; no OS/2, so there is no embedding permission. Every one
# of those answers is nevertheless in the file, inside the CFF's own
# structures, and reading them is what these tests are about.
#
# THE SPECIMEN IS CUT OUT OF AN .otf, and that is worth saying plainly: no
# bare CFF exists in this tree, and none was found on this machine on
# 2026-08-24 - the twenty-odd files named .cff under ~/src are Tcl
# configuration files with "set" in line one, not fonts. So the CFF table of
# NimbusSans-Regular.otf is cut out at test time, which is precisely what a
# bare CFF is. Cutting rather than checking a copy in also keeps the specimen
# and the .otf provably the same face - which is what makes the width
# comparisons below say anything at all.
set otfT1 [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.t1]
set symbolOtf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts StandardSymbolsPS.otf]
set dingbatOtf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts D050000L.otf]
testConstraint haveCffTrio [expr {[file exists $otf] && [file exists $otfTtf]
    && [file exists $otfT1]}]
testConstraint haveSymbolOtf [expr {[file exists $symbolOtf]
    && [file exists $dingbatOtf]}]
testConstraint pdftotext [expr {[auto_execok pdftotext] ne {}}]
testConstraint pdffonts [expr {[auto_execok pdffonts] ne {}}]

# The CFF table of an sfnt, on its own - the bare CFF this group reads.
proc ::tclpdfTest::bareCff {path} {
  return [::tclpdf::sfnt table [::tclpdf::sfnt read $path] "CFF "]
}

# -- a CFF font program built from parts ------------------------------------
#
# Half of what the format allows is not in any file in this tree: a FontMatrix
# that states an em other than 1000, a CID-keyed program, a face whose glyphs
# all carry private names, a charstring that carries no width at all. Those
# branches decide what a reader reports and what [font embed] refuses, and an
# untested one is found by whoever first meets such a file. So the tests below
# assemble the program themselves, which is small work: a CFF is a header, six
# INDEX structures and two DICTs, and the reader under test is what says
# whether the assembly is right.
#
# The one trick is that the Top DICT states OFFSETS to things standing behind
# it while its own length decides where they are. Two passes settle that, and
# every offset operand is written five bytes wide (b0 29 plus four bytes) so
# the second pass cannot change the length the first one measured.

# One CFF INDEX (TN 5176 section 5): count, offset size, count+1 offsets that
# are relative to the byte before the data, then the data.
proc ::tclpdfTest::cffIndex {items} {
  if {![llength $items]} {
    return [binary format Su 0]
  }
  set offset 1
  set offsets {}
  foreach item $items {
    lappend offsets $offset
    incr offset [string length $item]
  }
  lappend offsets $offset
  set size [expr {$offset < 256 ? 1 : ($offset < 65536 ? 2 : 4)}]
  set out [binary format Sucu [llength $items] $size]
  foreach value $offsets {
    switch -- $size {
      1 {append out [binary format cu $value]}
      2 {append out [binary format Su $value]}
      4 {append out [binary format Iu $value]}
    }
  }
  return $out[join $items {}]
}

# A DICT or charstring operand. [cffWide] is the same number in the widest
# form the format has, for an offset that has to keep its length between the
# two passes.
proc ::tclpdfTest::cffNumber {value} {
  if {$value >= -107 && $value <= 107} {
    return [binary format cu [expr {$value + 139}]]
  }
  if {$value >= -32768 && $value <= 32767} {
    return [binary format cuS 28 $value]
  }
  return [binary format cuI 29 $value]
}
proc ::tclpdfTest::cffWide {value} {
  return [binary format cuI 29 $value]
}

# A real number, nibble-coded (TN 5176 section 5, operator b0 30): the digits
# of the decimal spelling, 0xa for the point, 0xf as the terminator. This is
# how a FontMatrix states 1/2048 - there is no other way to write it.
proc ::tclpdfTest::cffReal {value} {
  set nibbles {}
  foreach char [split [format %.12g $value] {}] {
    switch -- $char {
      . {lappend nibbles 10}
      - {lappend nibbles 14}
      e {lappend nibbles 12}
      default {lappend nibbles $char}
    }
  }
  lappend nibbles 15
  if {[llength $nibbles] % 2} {
    lappend nibbles 15
  }
  set out [binary format cu 30]
  foreach {high low} $nibbles {
    append out [binary format cu [expr {$high * 16 + $low}]]
  }
  return $out
}

proc ::tclpdfTest::cffOperator {op} {
  if {[llength $op] == 2} {
    return [binary format cucu 12 [lindex $op 1]]
  }
  return [binary format cu $op]
}

# One Type 2 charstring: the operands, the operator, then endchar where the
# operator was not endchar itself. WHICH operator is the whole point - the
# width is an optional extra operand in front of the FIRST hint, move or
# endchar operator, and whether it is there is decided by the parity of what
# stands before that one operator.
proc ::tclpdfTest::cffCharstring {operands operator} {
  set out {}
  foreach value $operands {
    append out [::tclpdfTest::cffNumber $value]
  }
  append out [::tclpdfTest::cffOperator $operator]
  if {$operator ne "14"} {
    append out [binary format cu 14]
  }
  return $out
}

# A whole CFF font program. -glyphs is {name charstring ...} and glyph 0,
# .notdef, is prepended; a name among the standard 391 keeps its SID and any
# other is appended to the String INDEX, which is what a real compiler does.
proc ::tclpdfTest::cff {args} {
  set o [dict create name Test family Test matrix {} glyphs {} \
      defaultWidthX 0 nominalWidthX 0 cid 0 charsetOffset {} version 1]
  foreach {option value} $args {
    dict set o [string trimleft $option -] $value
  }
  set strings {}
  set sids {}
  set charstrings [list [::tclpdfTest::cffCharstring {} 14]]
  foreach {name charstring} [dict get $o glyphs] {
    set sid [lsearch -exact $::tclpdf::sfnt::cffStandardStrings $name]
    if {$sid < 0} {
      set sid [expr {391 + [llength $strings]}]
      lappend strings $name
    }
    lappend sids $sid
    lappend charstrings $charstring
  }
  # Charset format 0: the format byte, then one SID per glyph but the first.
  set charset [binary format cu 0]
  foreach sid $sids {
    append charset [binary format Su $sid]
  }
  set private [::tclpdfTest::cffNumber [dict get $o defaultWidthX]]
  append private [::tclpdfTest::cffOperator 20] \
      [::tclpdfTest::cffNumber [dict get $o nominalWidthX]] \
      [::tclpdfTest::cffOperator 21]

  lappend strings [dict get $o family]
  set familySid [expr {391 + [llength $strings] - 1}]
  if {[dict get $o cid]} {
    lappend strings Adobe Identity
  }
  set nameIndex [::tclpdfTest::cffIndex [list [dict get $o name]]]
  set stringIndex [::tclpdfTest::cffIndex $strings]
  set globalIndex [::tclpdfTest::cffIndex {}]
  set charStringIndex [::tclpdfTest::cffIndex $charstrings]
  set charsetAt 0
  set charStringsAt 0
  set privateAt 0
  for {set pass 0} {$pass < 2} {incr pass} {
    set top [::tclpdfTest::cffNumber $familySid]
    append top [::tclpdfTest::cffOperator 3]
    if {[dict get $o cid]} {
      # ROS: registry, ordering, supplement - the operator that makes a
      # program CID-keyed and nothing else about it.
      append top [::tclpdfTest::cffNumber [expr {391 + [llength $strings] - 2}]] \
          [::tclpdfTest::cffNumber [expr {391 + [llength $strings] - 1}]] \
          [::tclpdfTest::cffNumber 0] [::tclpdfTest::cffOperator {12 30}]
    }
    if {[dict get $o matrix] ne {}} {
      foreach value [dict get $o matrix] {
        append top [::tclpdfTest::cffReal $value]
      }
      append top [::tclpdfTest::cffOperator {12 7}]
    }
    append top [::tclpdfTest::cffWide $charsetAt] [::tclpdfTest::cffOperator 15] \
        [::tclpdfTest::cffWide $charStringsAt] [::tclpdfTest::cffOperator 17] \
        [::tclpdfTest::cffWide [string length $private]] \
        [::tclpdfTest::cffWide $privateAt] [::tclpdfTest::cffOperator 18]
    set topIndex [::tclpdfTest::cffIndex [list $top]]
    set header [binary format cucucucu [dict get $o version] 0 4 2]
    set at [expr {[string length $header] + [string length $nameIndex]
        + [string length $topIndex] + [string length $stringIndex]
        + [string length $globalIndex]}]
    set charsetAt $at
    if {[dict get $o charsetOffset] ne {}} {
      set charsetAt [dict get $o charsetOffset]
    }
    incr at [string length $charset]
    set charStringsAt $at
    incr at [string length $charStringIndex]
    set privateAt $at
  }
  return $header$nameIndex$topIndex$stringIndex$globalIndex$charset$charStringIndex$private
}

# The three or four glyphs the synthetic programs below are built from, with
# the width sitting in a different place in each: A carries one in front of an
# rmoveto (three operands where the operator takes two), B carries none (two
# operands, so the pen simply moves), space carries one in front of an hmoveto
# (two where one is taken), and quotesingle carries one in front of a stem
# hint (an odd count of what comes in pairs).
proc ::tclpdfTest::cffGlyphs {} {
  return [list \
      A [::tclpdfTest::cffCharstring {100 0 0} 21] \
      B [::tclpdfTest::cffCharstring {0 0} 21] \
      space [::tclpdfTest::cffCharstring {-150 0} 4] \
      quotesingle [::tclpdfTest::cffCharstring {-40 0 50} 1]]
}

test font-22.1 {a bare CFF is recognised, and nothing else is} \
    -constraints {haveCffTrio haveFont} -body {
  # The signature is four bytes of which three say anything, which is why the
  # reader asks this LAST, after every other format has said no. What must not
  # happen is that an sfnt or a Type 1 program is taken for one: they are
  # handed to the same question here, in the order [font embed] asks it.
  list [::tclpdf::sfnt isBareCff [::tclpdfTest::bareCff $::otf]] \
      [::tclpdf::sfnt isBareCff [::tclpdfTest::readBytes $::otf]] \
      [::tclpdf::sfnt isBareCff [::tclpdfTest::readBytes $::otfTtf]] \
      [::tclpdf::sfnt isBareCff [::tclpdfTest::readBytes $::fontRegular]] \
      [::tclpdf::sfnt isBareCff [::tclpdfTest::readBytes $::otfT1]] \
      [::tclpdf::sfnt isBareCff {}] [::tclpdf::sfnt isBareCff "\x01\x00"]
} -result {1 0 0 0 0 0 0}

test font-22.2 {the CFF answers what the sfnt around it answered} \
    -constraints haveCffTrio -body {
  # ONE FILE, TWO READERS. The .otf reader takes the PostScript name from the
  # name table, the glyph count from maxp and the italic angle from post; the
  # bare reader has none of those tables and takes all three out of the CFF's
  # own Name INDEX and Top DICT. They have to agree, and where they do not it
  # is the bare road that is wrong - the sfnt road is checked by every other
  # test in this file.
  set parsed [::tclpdf::sfnt read $::otf]
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::bareCff $::otf]]
  list [dict get $font name] [dict get $parsed names postScript] \
      [dict get $font numGlyphs] [dict get $parsed numGlyphs] \
      [dict get $font family] [dict get $font unitsPerEm] \
      [dict get $font italicAngle] [dict get $font cidKeyed] \
      [dict get $font stemV] [dict get $font bbox]
} -result {NimbusSans-Regular NimbusSans-Regular 855 855 {Nimbus Sans} 1000 0 0 93 {-210 -299 1032 1075}}

test font-22.3 {every charstring width equals the hmtx the sfnt carried} \
    -constraints haveCffTrio -body {
  # THE WIDTH IS THE WORK, and this is the test that says whether it was
  # done. There is no width field in a CFF: it is an optional extra operand
  # in front of the first hint, move or endchar operator of each charstring,
  # and whether it is there is decided by the PARITY of the operands before
  # that operator. Read wrong, every glyph gets defaultWidthX - a number the
  # file itself states, so nothing anywhere looks amiss and every line comes
  # out the wrong length.
  #
  # hmtx is the answer key: the same face, the same glyph numbers, widths
  # stated outright. All 855 of them, not a sample.
  set parsed [::tclpdf::sfnt read $::otf]
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::bareCff $::otf]]
  set widths [dict get $font widths]
  set compared 0
  set wrong 0
  dict for {glyph name} [dict get $font charset] {
    incr compared
    if {[dict get $widths $name] != [::tclpdf::sfnt advance $parsed $glyph]} {
      incr wrong
    }
  }
  # And that the answer is not the trivial one. defaultWidthX is 1000 here,
  # so a reader that never parsed a charstring would hand out 1000 for all
  # 855 glyphs; 77 of them really are 1000 wide. Counted rather than assumed,
  # because the count is what says the two cases are far apart.
  set default 0
  dict for {- width} $widths {
    if {$width == 1000} {
      incr default
    }
  }
  list $compared $wrong $default
} -result {855 0 77}

test font-22.4 {a width that only a subroutine call can reach} \
    -constraints haveCffTrio -body {
  # 210 of the 855 charstrings of this face open with callsubr, and the width
  # then sits INSIDE the subroutine. A reader that stops at the call gives
  # all 210 the defaultWidthX - 1000 here - and 179 of them have another
  # width than that. The four below are among them; none is 1000.
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::bareCff $::otf]]
  set widths [dict get $font widths]
  list [dict get $widths E] [dict get $widths F] [dict get $widths H] \
      [dict get $widths L]
} -result {667 611 722 556}

test font-22.5 {a glyph name is a string, not an expression} \
    -constraints haveCffTrio -body {
  # NimbusSans-Regular carries a glyph called "infinity". Passed through the
  # ternary of an [expr] - which is how the name used to be picked up - it
  # comes back as Inf, and the width of /infinity was then filed under a key
  # no lookup ever asks for, while the dictionary still held 855 entries and
  # looked complete. A glyph called "nan" would have thrown outright.
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::bareCff $::otf]]
  set widths [dict get $font widths]
  list [dict exists $widths infinity] [dict get $widths infinity] \
      [dict exists $widths Inf] [dict size $widths]
} -result {1 713 0 855}

test font-22.6 {the charset names the glyph the cmap of the sfnt points at} \
    -constraints haveCffTrio -body {
  # The charset is the bare CFF's only index of its own glyphs, and it is
  # what every width and every encoding position is looked up through. The
  # .otf's cmap says which glyph number a character has; the charset has to
  # give that number the name the character is known by.
  set parsed [::tclpdf::sfnt read $::otf]
  set charset [dict get [::tclpdf::sfnt cffFont \
      [::tclpdfTest::bareCff $::otf]] charset]
  set names {}
  foreach code {65 97 233 8364 46} {
    lappend names [dict get $charset [dict get $parsed cmap $code]]
  }
  list [dict get $charset 0] $names
} -result {.notdef {A a eacute Euro period}}

test font-22.7 {the face's own encoding is read, and is not what is written} \
    -constraints haveCffTrio -body {
  # The Encoding is the CFF's own opinion of which byte reaches which glyph.
  # It is NOT what goes into the PDF - a bare CFF is written through
  # WinAnsiEncoding, as a Type 1 program is - and it is read because it is
  # the only thing that can say why a face reaches nothing through WinAnsi.
  # This face states none of its own, so the reader folds out the CFF
  # Standard Encoding restricted to the glyphs it actually has - which is a
  # DIFFERENT table from the one the file is written through: byte 233 is
  # Oslash there and eacute in WinAnsi, and the CFF Standard Encoding reaches
  # no eacute at all although the face has the glyph. 149 positions against
  # WinAnsi's 224 is the same difference counted.
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::bareCff $::otf]]
  set encoding [dict get $font encoding]
  list [dict get $encoding 65] [dict get $encoding 32] \
      [dict get $encoding 174] [dict get $encoding 225] \
      [dict get $encoding 233] [expr {"eacute" in [dict values $encoding]}] \
      [dict exists [dict get $font widths] eacute] [dict size $encoding]
} -result {A space fi AE Oslash 0 1 149}

test font-22.8 {the width belongs to the operator behind it} -body {
  # Four charstrings, four places a width may or may not be. Assembled here
  # because no file in this tree has all four in one face, and getting the
  # parity wrong in any one of them is invisible in every other test: the
  # number that comes out is defaultWidthX, which the file itself states.
  #
  #   A            100 0 0 rmoveto   three where two are taken -> 400 + 100
  #   B                0 0 rmoveto   two, which is what rmoveto takes -> 500
  #   space         -150 0 hmoveto   two where one is taken -> 400 - 150
  #   quotesingle  -40 0 50 hstem    an odd count of what comes in pairs
  #   .notdef              endchar   nothing at all -> defaultWidthX
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::cff \
      -glyphs [::tclpdfTest::cffGlyphs] -defaultWidthX 500 -nominalWidthX 400]]
  set widths [dict get $font widths]
  list [dict get $widths A] [dict get $widths B] [dict get $widths space] \
      [dict get $widths quotesingle] [dict get $widths .notdef]
} -result {500 500 250 360 500}

test font-22.9 {the em comes out of the FontMatrix} -body {
  # There is no head table here to state it, and the matrix is the only place
  # that says how big a glyph unit is. Taken as 1000 regardless, every width
  # of a face drawn on another grid would be out by the ratio - the text
  # would measure right and draw at half size. No .otf in this tree states
  # one, so the program is built with it.
  set glyphs [::tclpdfTest::cffGlyphs]
  list [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff -glyphs $glyphs]] \
          unitsPerEm] \
      [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff -glyphs $glyphs \
          -matrix {0.00048828125 0 0 0.00048828125 0 0}]] unitsPerEm] \
      [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff -glyphs $glyphs \
          -matrix {0.000558035714286 0 0 0.000558035714286 0 0}]] unitsPerEm]
} -result {1000 2048 1792}

test font-22.10 {a family name is a string too} -body {
  # The other half of font-22.5, on the one string a font vendor is most
  # likely to pick: there are real font families called Infinity.
  list [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff \
          -glyphs [::tclpdfTest::cffGlyphs] -family Infinity]] family] \
      [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff \
          -glyphs [::tclpdfTest::cffGlyphs] -family 1e3]] family]
} -result {Infinity 1e3}

test font-22.11 {the predefined ISOAdobe charset is the identity} -body {
  # Charset offset 0 is not an offset but "glyph n carries SID n", which is
  # what a font that says nothing means. Read as an offset it would point at
  # the file header and name every glyph wrong.
  set font [::tclpdf::sfnt cffFont [::tclpdfTest::cff \
      -glyphs [::tclpdfTest::cffGlyphs] -charsetOffset 0]]
  dict get $font charset
} -result {0 .notdef 1 space 2 exclam 3 quotedbl 4 numbersign}

test font-22.12 {what the reader refuses, and what it says} -body {
  # Every one of these is a file that would otherwise be read as something it
  # is not: CFF2 has no charset and no encoding at all, and the two
  # predefined expert charsets would silently name every glyph wrong. Refused
  # by name rather than guessed at.
  set glyphs [::tclpdfTest::cffGlyphs]
  set answers {}
  foreach {label program} [list \
      cff2 [::tclpdfTest::cff -glyphs $glyphs -version 2] \
      version [::tclpdfTest::cff -glyphs $glyphs -version 3] \
      expert [::tclpdfTest::cff -glyphs $glyphs -charsetOffset 1] \
      expertSubset [::tclpdfTest::cff -glyphs $glyphs -charsetOffset 2] \
      short "\x01\x00"] {
    catch {::tclpdf::sfnt cffFont $program} message
    lappend answers $label [string match {tclpdf: *} $message]
  }
  list $answers [catch {::tclpdf::sfnt cffFont [::tclpdfTest::cff \
      -glyphs $glyphs -version 2]} message] $message
} -match glob -result {{cff2 1 version 1 expert 1 expertSubset 1 short 1} 1 {*CFF2*variable-font format*charset nor an encoding*}}

test font-22.13 {a face's own encoding, in all three forms a file states it} \
    -constraints {haveCffTrio haveSymbolOtf} -body {
  # Three faces, three roads through the same reader. NimbusSans states no
  # encoding of its own, so offset 0 means the CFF Standard Encoding, folded
  # out here and restricted to the glyphs the face has. D050000L states one
  # in format 1 - four ranges of consecutive codes, 202 positions, every one
  # of them an aN name. StandardSymbolsPS states one in format 0 with a count
  # of ZERO: an encoding of its own that reaches nothing, which is a thing a
  # file is allowed to say and which the reader must not turn into the
  # standard one.
  #
  # None of the three is what the PDF is written through - that is
  # WinAnsiEncoding for all of them, as for a Type 1 program. This is what
  # the FILE says, in the same key [type1 metrics] fills from an AFM.
  set answer {}
  foreach path [list $::otf $::dingbatOtf $::symbolOtf] {
    set encoding [dict get [::tclpdf::sfnt cffFont \
        [::tclpdfTest::bareCff $path]] encoding]
    lappend answer [dict size $encoding]
  }
  set dingbats [dict get [::tclpdf::sfnt cffFont \
      [::tclpdfTest::bareCff $::dingbatOtf]] encoding]
  # And the restriction itself, which the three faces above cannot show
  # because all of them carry the whole of ASCII: the standard encoding is
  # folded out only as far as the face reaches. Four glyphs, four positions -
  # a reader that handed back all 149 would promise bytes that draw nothing.
  # And the fourth position is 169, not 39: in the CFF Standard Encoding byte
  # 39 is quoteright and the quotesingle sits up in the second half - which is
  # the difference between this table and WinAnsiEncoding, one byte of it.
  set small [dict get [::tclpdf::sfnt cffFont [::tclpdfTest::cff \
      -glyphs [::tclpdfTest::cffGlyphs]]] encoding]
  list $answer [dict get $dingbats 32] [dict get $dingbats 65] \
      [dict get $dingbats 241] [lsort -integer [dict keys $small]] \
      [dict get $small 169]
} -result {{149 202 0} space a10 a201 {32 65 66 169} quotesingle}

test font-22.14 {the italic angle and the stem width come out of the CFF} \
    -constraints haveCffTrio -body {
  # Two numbers a font descriptor has to state and only the file can answer.
  # ItalicAngle stands in the Top DICT and StemV in the Private DICT as
  # StdVW - the VERTICAL stem, which sits right beside StdHW, and picking the
  # wrong one of the pair is the mistake that reads plausibly. Measured on
  # NimbusSans: StdVW 93 upright, 89 oblique, against a StdHW of 81 and 76.
  #
  # It is the one value the TrueType road cannot read and has to estimate
  # from the weight class - here it is simply stated.
  set oblique [file join [file dirname $::otf] NimbusSans-Oblique.otf]
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc font embed upright -data [::tclpdfTest::bareCff $::otf]
  $doc font embed oblique -data [::tclpdfTest::bareCff $oblique]
  $doc text "Kursiv" -at {20 20} -family oblique -size 12
  $doc text "Gerade" -at {20 40} -family upright -size 12
  set path [::tclpdfTest::scratch font-bare-cff-italic.pdf]
  $doc write $path
  set read [list [dict get [::tclpdf::sfnt cffFont \
          [::tclpdfTest::bareCff $oblique]] italicAngle] \
      [dict get [::tclpdf::sfnt cffFont \
          [::tclpdfTest::bareCff $oblique]] stemV]]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Flags 96 is the non-symbolic bit and the italic bit together (Table 121);
  # the upright cut of the same face carries 32, the non-symbolic bit alone.
  list $read [lsort [regexp -all -inline {/ItalicAngle -?[0-9.]+} $bytes]] \
      [lsort [regexp -all -inline {/StemV [0-9]+} $bytes]] \
      [lsort [regexp -all -inline {/Flags [0-9]+} $bytes]]
} -result {{-12 89} {{/ItalicAngle -12} {/ItalicAngle 0}} {{/StemV 89} {/StemV 93}} {{/Flags 32} {/Flags 96}}}

test font-23.1 {a bare CFF is embedded as FontFile3 with Subtype Type1C} \
    -constraints haveCffTrio -body {
  # "Type 1-equivalent font program" (ISO 32000-1, Table 126), which is an
  # entry of a SIMPLE font descriptor - one byte per character through an
  # encoding, exactly as the .pfb road works. NOT /Subtype /OpenType, which
  # is the entry for a whole OpenType file and is what the .otf road writes,
  # and not FontFile2, which is TrueType. A reader that finds the wrong one
  # has been handed a font program it cannot parse.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc text "Handgloves" -at {20 20} -family bare -size 12
  set path [::tclpdfTest::scratch font-bare-cff.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/FontFile3} $bytes] [regexp {/Subtype /Type1C} $bytes] \
      [regexp {/Subtype /OpenType} $bytes] [regexp {/FontFile2} $bytes] \
      [regexp {/FontFile[^23]} $bytes] [regexp {/Subtype /Type1} $bytes] \
      [regexp {/BaseFont /[A-Z]{6}\+} $bytes] \
      [regexp {/BaseFont /NimbusSans-Regular} $bytes]
} -result {1 1 0 0 0 1 0 1}

test font-23.2 {the same face measures the same from all three of its formats} \
    -constraints haveCffTrio -body {
  # THE INVARIANT THIS TREE OFFERS. NimbusSans-Regular is here as an .otf
  # (CFF outlines inside an sfnt, addressed by glyph number), as a .t1 (a
  # Type 1 program whose widths come from the AFM beside it) and - once the
  # table is cut out - as a bare CFF, whose widths come from nowhere but the
  # charstrings. Three readers, three roads, one face: the answer has to be
  # the same number, and a defect in the charstring width reader shows here
  # as a different one.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc font embed whole $::otf
  $doc font embed program $::otfT1
  set sample "Handgloves 123 - eacute: é"
  set widths {}
  foreach alias {bare whole program} {
    lappend widths [$doc textWidth $sample -family $alias -size 100 -kerning 0]
  }
  $doc destroy
  list [lsort -unique $widths] [expr {[lindex $widths 0] > 1000}]
} -result {1222.9 1}

test font-23.3 {a CID-keyed program is refused, by name} -body {
  # ISO 32000-1 9.7.4.2: in a CID-keyed program the CID goes through the
  # program's own charset, and a Type 1-equivalent font is addressed by
  # name - so such a face would draw other glyphs than the ones measured
  # here, silently and past every validator. No CID-keyed face is in this
  # tree, so the ROS operator that makes one is written into a program built
  # for the purpose.
  set doc [tclpdf new -unit pt]
  set code [catch {$doc font embed cid -data [::tclpdfTest::cff \
      -glyphs [::tclpdfTest::cffGlyphs] -cid 1]} message options]
  $doc destroy
  list $code [lrange [dict get $options -errorcode] 0 2] \
      [string match {*CID-keyed*name-keyed CFF*} $message]
} -result {1 {TCLPDF FONT CIDKEYED} 1}

test font-23.4 {a face whose glyphs carry only private names is refused} -body {
  # Every byte position would be unwritable and the face could set no text at
  # all - refused here rather than at the first [text], which would name a
  # character instead of the cause.
  set doc [tclpdf new -unit pt]
  set program [::tclpdfTest::cff -glyphs [list \
      heartsuit [::tclpdfTest::cffCharstring {100 0 0} 21] \
      clubsuit [::tclpdfTest::cffCharstring {0 0} 21]]]
  set code [catch {$doc font embed private -data $program} message options]
  $doc destroy
  list $code [lrange [dict get $options -errorcode] 0 2] \
      [string match {*carry none of the glyph names WinAnsiEncoding*} $message]
} -result {1 {TCLPDF FONT ENCODING} 1}

test font-23.5 {a symbol face is not that case, and is embedded} \
    -constraints {haveSymbolOtf haveCffTrio} -body {
  # Measured, because the assumption goes the other way: the digits, the
  # ASCII punctuation and the space are called what WinAnsi calls them
  # whatever else a symbol face holds. StandardSymbolsPS reaches 44 byte
  # positions of its 191 glyphs and D050000L reaches 2 of its 203 - two is
  # next to nothing and is still not none. The same two numbers the .t1
  # files of those faces reach, which is the point: the bare CFF road and
  # the Type 1 road address a face identically.
  set doc [tclpdf new -unit pt]
  set answer {}
  foreach {alias path} [list symbol $::symbolOtf dingbat $::dingbatOtf] {
    $doc font embed $alias -data [::tclpdfTest::bareCff $path]
    set info [$doc font info $alias]
    lappend answer [dict get $info glyphs] [dict get $info characters]
  }
  $doc destroy
  set answer
} -result {191 44 203 2}

test font-23.6 {-metrics, -axes and -instance are refused on a bare CFF} \
    -constraints haveCffTrio -body {
  # An option that has nothing to act on is refused rather than ignored: a
  # CFF carries its own metrics, widths and glyph names, and it has no axes.
  set doc [tclpdf new -unit pt]
  set bytes [::tclpdfTest::bareCff $::otf]
  set answers {}
  foreach {label option value} [list metrics -metrics /nowhere.afm \
      axes -axes {wght 620} instance -instance Bold] {
    lappend answers [catch {$doc font embed $label -data $bytes \
        $option $value} m]
    lappend answers [string match {*CFF font program*} $m]
  }
  $doc destroy
  set answers
} -result {1 1 1 1 1 1}

test font-23.7 {the text of a bare CFF comes back out} \
    -constraints {haveCffTrio pdftotext} -body {
  # The one thing no structural check can stand in for. A bare CFF has no
  # cmap: the character-to-glyph mapping in the file is the /Encoding this
  # package writes, and if it is wrong the page still renders, qpdf still
  # calls the file clean, and the extracted text is noise.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc text "Grosse Wasche kostet 12 €" -at {20 40} -family bare -size 14
  set path [::tclpdfTest::scratch font-bare-cff-text.pdf]
  $doc write $path
  $doc destroy
  catch {exec pdftotext -enc UTF-8 $path -} text
  file delete $path
  string trim $text
} -result "Grosse Wasche kostet 12 €"

test font-23.8 {pdffonts sees an embedded Type 1C with no subset tag} \
    -constraints {haveCffTrio pdffonts} -body {
  # It goes in whole - there is no subsetter for CFF here - and the six-letter
  # prefix MEANS subset (ISO 32000-1 9.9.2), so writing one would be a claim
  # about a file that was not subsetted.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc text "Handgloves" -at {20 20} -family bare -size 12
  set path [::tclpdfTest::scratch font-bare-cff-fonts.pdf]
  $doc write $path
  $doc destroy
  catch {exec pdffonts $path} report
  file delete $path
  list [regexp {NimbusSans-Regular\s+Type 1C\s+WinAnsi\s+yes\s+no} $report] \
      [regexp {[A-Z]{6}\+NimbusSans} $report]
} -result {1 0}

test font-23.9 {a bare CFF goes into an archivable document} \
    -constraints {haveCffTrio haveTdom} -body {
  # PDF/A wants every font embedded, and a Type 1-equivalent program under
  # /FontFile3 is one of the three ways it accepts. Written and then handed
  # to veraPDF against the profile the document claims itself.
  set doc [tclpdf new -unit mm]
  $doc info Title "Bare CFF"
  $doc language en-GB
  $doc page add
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc text "A bare CFF inside an archivable document" -at {20 20} \
      -family bare -size 12
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch font-bare-cff-pdfa.pdf]
  set code [catch {$doc write $path} message]
  $doc destroy
  set report [expr {$code ? $message : [::tclpdfTest::verapdf $path 3b]}]
  file delete $path
  list $code $report
} -result {0 ok}

test font-23.10 {the widths are scaled to the em the FontMatrix states} -body {
  # A Type 1 font's widths are in thousandths of an em BY DEFINITION, and a
  # CFF may be drawn on any grid its FontMatrix declares. Scaled at the point
  # where the file is read, so nothing downstream has to know - and unscaled,
  # a face on a 2048 grid measures right and draws at half the size, with
  # every check in this suite silent about it.
  #
  # Two programs, the same charstrings, the same widths in FONT UNITS (500
  # each for A and B) and two different ems. At 1000 units the pair measures
  # a full em; at 2048 it measures 500/2048 of one, twice.
  set glyphs [list A [::tclpdfTest::cffCharstring {100 0 0} 21] \
      B [::tclpdfTest::cffCharstring {0 0} 21]]
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed thousand -data [::tclpdfTest::cff -name GridThousand \
      -glyphs $glyphs -defaultWidthX 500 -nominalWidthX 400]
  $doc font embed twoThousand -data [::tclpdfTest::cff -name GridTwoThousand \
      -glyphs $glyphs -defaultWidthX 500 -nominalWidthX 400 \
      -matrix {0.00048828125 0 0 0.00048828125 0 0}]
  set answer [list [dict get [$doc font info thousand] unitsPerEm] \
      [dict get [$doc font info twoThousand] unitsPerEm] \
      [$doc textWidth "AB" -family thousand -size 1000 -kerning 0] \
      [$doc textWidth "AB" -family twoThousand -size 1000 -kerning 0]]
  $doc destroy
  set answer
} -result {1000 2048 1000.0 488.0}

test font-24.1 {-data embeds what the path embeds} \
    -constraints haveCffTrio -body {
  # THE FACE THAT NEVER WAS A FILE - one out of a database, one out of an
  # archive, one fetched over the network - had to be written to a temporary
  # file first and the caller then had to remember to remove it. What the two
  # roads produce has to be the same document; the alias is the only thing
  # that differs here, and it is not written into the font program.
  set bytes [::tclpdfTest::bareCff $::otf]
  set path [::tclpdfTest::scratch specimen.cff]
  set channel [open $path wb]
  puts -nonewline $channel $bytes
  close $channel
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed fromFile $path
  $doc font embed fromData -data $bytes
  set info [list [$doc font info fromFile] [$doc font info fromData]]
  set widths [list [$doc textWidth "Handgloves" -family fromFile -size 100] \
      [$doc textWidth "Handgloves" -family fromData -size 100]]
  $doc destroy
  file delete $path
  list [expr {[lindex $info 0] eq [lindex $info 1]}] \
      [expr {[lindex $widths 0] eq [lindex $widths 1]}] \
      [dict get [lindex $info 0] postScript]
} -result {1 1 NimbusSans-Regular}

test font-24.2 {neither a path nor -data} -constraints haveFont -body {
  # The alias names the font IN THE DOCUMENT, not the font program, and a
  # refusal that only said "needs a file name" would leave a caller looking
  # for the mistake in the name.
  #
  # THE CLASS IS "EMBED" AND NOT "SOURCE", changed on 2026-08-25: the third
  # word of SOURCE is the reader that turned a file away, and the manual
  # promises that a script trying a file through several readers RETRIES on
  # that code. This refusal and the next are about the CALL - no reader has
  # seen anything - and with the alias standing where a reader's name belongs
  # they told such a script to retry the same arguments for ever.
  set doc [tclpdf new -unit pt]
  set code [catch {$doc font embed lonely} message options]
  $doc destroy
  list $code [dict get $options -errorcode] \
      [string match {*needs a file name or -data*} $message]
} -result {1 {TCLPDF FONT EMBED lonely} 1}

test font-24.3 {a path AND -data name two font programs for one alias} \
    -constraints haveCffTrio -body {
  # Whichever were taken, the other would be read by nobody and no message
  # would say so. Refused rather than ranked - and the two are not
  # interchangeable, one being on disk and the other in the caller's hands.
  set doc [tclpdf new -unit pt]
  set code [catch {$doc font embed both $::otf \
      -data [::tclpdfTest::bareCff $::otf]} message options]
  $doc destroy
  list $code [dict get $options -errorcode] \
      [string match {*takes a file name or -data, not both*} $message]
} -result {1 {TCLPDF FONT EMBED both} 1}

test font-24.4 {a Type 1 program passed as bytes has no file to look beside} \
    -constraints haveType1 -body {
  # The widths of a Type 1 face are behind the eexec encryption, so they come
  # from the AFM instead - and [font embed] finds that by the name of the
  # program. With -data there is no name. Said outright rather than letting
  # the lookup report that "".afm" is not readable, which names a file
  # nobody asked for.
  set bytes [::tclpdfTest::readBytes $::type1Face]
  set doc [tclpdf new -unit pt]
  set code [catch {$doc font embed t1 -data $bytes} message options]
  set with [$doc font embed t1 -data $bytes \
      -metrics [file rootname $::type1Face].afm]
  set info [$doc font info $with]
  $doc destroy
  list $code [dict get $options -errorcode] \
      [string match {*no file to look beside*-metrics*} $message] \
      [dict get $info postScript] [dict get $info format]
} -result {1 {TCLPDF FONT METRICS afm} 1 OCRB type1}

test font-24.5 {a refusal over bytes describes them instead of naming a file} \
    -constraints haveCffTrio -body {
  # A file can be named and a caller can go and look at it; bytes cannot, and
  # "" is not readable" is a message about a file nobody asked for. So the
  # bytes describe themselves by their length, which is the one thing a
  # caller can compare against what was passed in. [image embed] answers the
  # same question the same way.
  set program [::tclpdfTest::cff -glyphs [::tclpdfTest::cffGlyphs] -cid 1]
  set doc [tclpdf new -unit pt]
  catch {$doc font embed cid -data $program} message
  $doc destroy
  string match "*the font data passed with -data ([string length $program]\
      bytes)*" $message
} -result 1

test font-24.6 {a font file that is called -data is still a path} \
    -constraints haveCffTrio -body {
  # What the parity rule buys. The name stays first and positional; what may
  # follow it is a path, and a path is what is left over when the options
  # have been paired off - an ODD number of remaining words. That is the only
  # rule that can tell "-data" the option from a file that happens to be
  # called that, and [image embed] draws the line in the same place.
  set path [file join [file dirname [::tclpdfTest::scratch x]] -data]
  set channel [open $path wb]
  puts -nonewline $channel [::tclpdfTest::bareCff $::otf]
  close $channel
  set doc [tclpdf new -unit pt]
  $doc font embed odd $path -subset 0
  set answer [dict get [$doc font info odd] postScript]
  $doc destroy
  file delete $path
  set answer
} -result NimbusSans-Regular

test font-25.1 {every format answers every key of font info} \
    -constraints {haveCffTrio haveFont haveType1} -body {
  # A caller who writes [dict get [$doc font info $a] capHeight] must not
  # have to find out first which format $a happens to be. A key present for
  # a TrueType face and absent for a Type 1 one is a key that will be read
  # without a guard and crash on the second font, so the SET is the same
  # whatever was embedded and a format that states nothing answers {}.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed truetype $::fontRegular
  $doc font embed opentype $::otf
  $doc font embed cff -data [::tclpdfTest::bareCff $::otf]
  $doc font embed type1 $::type1Face
  $doc font define type3
  $doc font glyph type3 "☑" -width 700 -script {
    $doc rect -at {100 100} -size {500 500} -fill black
  }
  set keys {}
  set formats {}
  foreach alias {truetype opentype cff type1 type3} {
    set info [$doc font info $alias]
    lappend keys [lsort [dict keys $info]]
    lappend formats [dict get $info format]
  }
  $doc destroy
  list [llength [lsort -unique $keys]] [lindex $keys 0] $formats
} -result {1 {ascender axes capHeight characters descender family format fsType glyphs lineGap permission postScript unitsPerEm variable vertical xHeight} {truetype cff cff type1 type3}}

test font-25.2 {one face, three formats, three different things it can say} \
    -constraints haveCffTrio -body {
  # NOT STATED IS NOT ZERO and is not a computed substitute either. The same
  # face carries different answers depending on which of its three files is
  # read, and [font info] reports the FILE: the .otf has an OS/2 table and a
  # hhea, so it states five numbers; the AFM beside the .t1 states a cap
  # height and an x height and writes Ascender 0, which is a field that is
  # there and says nothing; and the bare CFF states none of the five, because
  # the format has nowhere to put them.
  #
  # The font descriptor meanwhile HAS to write a cap height and derives one
  # (the top of the H). This command must not report that number - a derived
  # value reported as the file's is how a caller comes to believe a face
  # states something it does not.
  set doc [tclpdf new -unit pt]
  $doc font embed whole $::otf
  $doc font embed program $::otfT1
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  set answer {}
  foreach alias {whole program bare} {
    set info [$doc font info $alias]
    lappend answer [list [dict get $info ascender] [dict get $info descender] \
        [dict get $info lineGap] [dict get $info capHeight] \
        [dict get $info xHeight]]
  }
  lappend answer [dict get [$doc font info bare] family] \
      [dict get [$doc font info bare] unitsPerEm] \
      [dict get [$doc font info bare] glyphs]
  $doc destroy
  set answer
} -result {{729 -271 200 718 516} {{} {} {} 729 524} {{} {} {} {} {}} {Nimbus Sans} 1000 855}

test font-25.3 {a format with no fsType says so rather than guessing} \
    -constraints {haveCffTrio haveType1} -body {
  # Neither a Type 1 program nor a bare CFF carries an embedding permission
  # at all - that is a property of the FORMAT, not something unknown about
  # this file, and an absent permission is not permission 0.
  set doc [tclpdf new -unit pt]
  $doc font embed whole $::otf
  $doc font embed bare -data [::tclpdfTest::bareCff $::otf]
  $doc font embed program $::type1Face
  set answer {}
  foreach alias {whole bare program} {
    set info [$doc font info $alias]
    lappend answer [dict get $info fsType] [dict get $info permission]
  }
  $doc destroy
  set answer
} -match glob -result {4 {preview and print only*} {} {not stated - a bare CFF has no fsType} {} {not stated - Type 1 has no fsType}}

test font-25.4 {the vertical metric, the variable axes, and vmtx} \
    -constraints {haveJpFace haveFont} -body {
  # The three keys that were added with the tables they are read from. The
  # numbers are in the FACE'S OWN units, which is why unitsPerEm stands
  # beside them - an ascender of 1901 means nothing until it is read against
  # the 2048 of the same dictionary.
  set doc [tclpdf new -unit pt]
  $doc font embed dejavu $::fontRegular
  $doc font embed jp $::jpFace
  set roboto [file join [file dirname [file dirname [file normalize [info script]]]] \
      examples assets fonts google Roboto-Variable.ttf]
  $doc font embed bold $roboto -instance Bold
  set dejavu [$doc font info dejavu]
  set jp [$doc font info jp]
  set bold [$doc font info bold]
  $doc destroy
  list [list [dict get $dejavu ascender] [dict get $dejavu descender] \
          [dict get $dejavu lineGap] [dict get $dejavu unitsPerEm] \
          [dict get $dejavu capHeight] [dict get $dejavu vertical]] \
      [list [dict get $jp vertical] [dict get $jp capHeight] \
          [dict get $jp xHeight]] \
      [list [dict get $bold variable] [dict get $bold axes] \
          [dict get $bold postScript]] \
      [list [dict get $dejavu variable] [dict get $dejavu axes]]
} -result {{1901 -483 0 2048 {} 0} {1 733 543} {1 {{wght 100.0 400.0 900.0} {wdth 75.0 100.0 100.0}} Roboto-Bold} {0 {}}}

test font-25.5 {the family a file states is handed back as it stands} \
    -constraints haveFont -body {
  # There are real font families called Infinity, and read through the
  # ternary of an [expr] such a name comes back as Inf - "1e3" as 1000.0 and
  # "nan" as an error. No face in this tree carries such a name, so DejaVu
  # Sans is given one: its name records are rewritten in place, ASCII and
  # UTF-16BE alike, to a string of exactly the same length.
  set bytes [::tclpdfTest::readBytes $::fontRegular]
  set wide {}
  foreach char [split "DejaVu Sans" {}] {
    append wide [binary format Su [scan $char %c]]
  }
  set replacement {}
  foreach char [split "Infinity   " {}] {
    append replacement [binary format Su [scan $char %c]]
  }
  set patched [string map [list $wide $replacement \
      "DejaVu Sans" "Infinity   "] $bytes]
  set doc [tclpdf new -unit pt]
  $doc font embed patched -data $patched
  set answer [dict get [$doc font info patched] family]
  $doc destroy
  list [expr {[string length $patched] == [string length $bytes]}] $answer
} -result {1 {Infinity   }}


# The font entry of an alias - private state, reached here so that a test can
# measure against what the face itself states rather than against a number
# copied into the test.
proc my_entry {doc alias} {
  oo::objdefine $doc export state
  return [dict get [$doc state fonts] $alias]
}

# [FontDescender] is private, as every method behind the facade is. Exported
# onto the one object under test - the same way field.test reaches
# [FieldDeclare] - because what is under test is the arithmetic, and driving
# it through an annotation would measure the annotation instead.
proc descenderOf {doc alias size} {
  oo::objdefine $doc export FontDescender
  return [$doc FontDescender $alias $size]
}

# [FontDescender], added on 2026-08-24 beside [FontAscender]. It lived in
# annotMark.tcl until then, as a private method that said in its own comment
# that it belonged here.

test font-descender-1.1 {the descender is positive, whatever sign the face states} -constraints haveFont -body {
  # hhea states it negative and an AFM may state either, so the sign is
  # settled here rather than in every caller.
  set doc [tclpdf new]
  $doc page add
  $doc font embed sans $::fontRegular
  set descent [descenderOf $doc sans 100]
  $doc destroy
  expr {$descent > 0}
} -result 1

test font-descender-1.2 {ascender and descender together are the face's line} -constraints haveFont -body {
  # Measured against what the face itself states: hhea's two numbers scaled
  # to the size asked for. A test that only asked "is it a number" would
  # have passed on the sign error the positive-value rule exists to prevent.
  set doc [tclpdf new]
  $doc page add
  $doc font embed sans $::fontRegular
  set parsed [dict get [my_entry $doc sans] parsed]
  set units [dict get $parsed unitsPerEm]
  set wanted [expr {abs(double([dict get $parsed descender])) * 100 / $units}]
  set got [descenderOf $doc sans 100]
  $doc destroy
  expr {abs($got - $wanted) < 1e-9}
} -result 1

test font-descender-1.3 {a Type 1 face reads it from the AFM, and zero means absent} -constraints haveOtf -body {
  # The URW metrics in this tree write "Descender 0" - the field is there and
  # says nothing, so the bounding box is the honest substitute. The same rule
  # [FontAscender] follows for the ascender.
  set doc [tclpdf new]
  $doc page add
  $doc font embed cff $::otf
  set descent [descenderOf $doc cff 100]
  $doc destroy
  expr {$descent > 0}
} -result 1


# --- a Type 1 face whose glyph names are not WinAnsi's ----------------------
#
# No face in this tree needs a /Differences array: all of them call the
# hundred-and-ninety-odd WinAnsi glyphs what Annex D calls them. The one that
# does is therefore BUILT, out of a real URW face, by renaming two charstrings
# in the eexec section and the two lines of the AFM that describe them - which
# is the whole of what a face "carrying its own spelling" means to this
# package. Two variants, because the two halves of the fix need different
# faces: "only" carries middot and verticalbar alone, "both" carries them
# beside periodcentered and bar.

package require tclpdf::type1 1.0-

set type1Base [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusRoman-Regular.t1]
testConstraint haveType1Base [file exists $type1Base]
testConstraint havePdftoppm [expr {[auto_execok pdftoppm] ne {}}]

# The eexec cipher, the other way round (Type 1 Font Format, 7.2). type1.tcl
# reads fonts and so has only [Decrypt]; a test that builds one needs both.
proc fontEncrypt {plain r} {
  set c1 52845
  set c2 22719
  binary scan $plain cu* codes
  set out {}
  foreach p $codes {
    set c [expr {$p ^ ($r >> 8)}]
    lappend out $c
    set r [expr {(($c + $r) * $c1 + $c2) & 0xFFFF}]
  }
  return [binary format c* $out]
}

# Where one CharStrings entry begins and ends: "/name length RD <bytes> ND",
# walked exactly as [type1 glyphs] walks it - the bytes are encrypted and a
# run of them will sooner or later spell "/A 5 RD ", so the entries are
# counted through rather than searched for.
proc fontEntryRange {plain name} {
  set at [string first "/CharStrings" $plain]
  set at [string first "begin" $plain $at]
  incr at 5
  set pattern {\s*/([^\s/{}()\[\]<>]+)\s+(\d+)\s+\S+\s}
  while {[regexp -start $at -indices $pattern $plain whole nm len]} {
    if {[lindex $whole 0] != $at} break
    set found [string range $plain {*}$nm]
    set stop [expr {[lindex $whole 1] + 1 + [string range $plain {*}$len]}]
    regexp -start $stop -indices {\s*\S+} $plain token
    set stop [lindex $token 1]
    if {$found eq $name} {
      return [list $at $stop]
    }
    set at [expr {$stop + 1}]
  }
  error "no charstring called \"$name\""
}

# The font program, as a PFB: three segments and the end marker.
proc fontPfb {clear encrypted trailer} {
  set out {}
  append out [binary format cciu 0x80 1 [string length $clear]] $clear
  append out [binary format cciu 0x80 2 [string length $encrypted]] $encrypted
  append out [binary format cciu 0x80 1 [string length $trailer]] $trailer
  append out [binary format cc 0x80 3]
  return $out
}

# "only" renames the two charstrings, "both" copies them under the second
# name and leaves the first where it was.
proc fontRenamed {how} {
  set font [::tclpdf::type1 parse [::tclpdfTest::readBytes $::type1Base]]
  set plain [::tclpdf::type1::Decrypt [dict get $font encrypted] 55665 4]
  foreach {from to} {periodcentered middot bar verticalbar} {
    lassign [fontEntryRange $plain $from] start stop
    set entry [string range $plain $start $stop]
    set renamed [string map [list /$from /$to] $entry]
    set plain [string replace $plain $start $stop \
        [expr {$how eq "both" ? "$entry$renamed" : $renamed}]]
  }
  # The lead-in the format prescribes: four bytes of anything.
  return [fontPfb [dict get $font clear] \
      [fontEncrypt "tcl!$plain" 55665] [dict get $font trailer]]
}

# The AFM to go with it. A name the program carries and the metrics do not is
# unwritable either way - [type1 names] maps a position only where both agree.
proc fontRenamedAfm {how} {
  set text [::tclpdfTest::readBytes [file rootname $::type1Base].afm]
  set added {}
  foreach {from to} {periodcentered middot bar verticalbar} {
    foreach line [split $text \n] {
      if {[regexp "; N $from ;" $line]} {
        append added [regsub {^C\s+-?\d+\s+;} [string trim $line] "C -1 ;"] \n
        break
      }
    }
    set added [string map [list "N $from ;" "N $to ;"] $added]
  }
  if {$how eq "only"} {
    set kept {}
    foreach line [split $text \n] {
      if {[regexp {; N (periodcentered|bar) ;} $line]} continue
      lappend kept $line
    }
    set text [join $kept \n]
  }
  return [string map [list EndCharMetrics "${added}EndCharMetrics"] $text]
}

proc fontRenamedDoc {how} {
  set path [::tclpdfTest::scratch renamed-$how.afm]
  set channel [open $path w]
  puts -nonewline $channel [fontRenamedAfm $how]
  close $channel
  set doc [tclpdf new -format a4 -unit mm]
  $doc page add
  $doc font embed odd -data [fontRenamed $how] -metrics $path
  file delete $path
  return $doc
}

test font-encoding-1.1 {the fixture face really carries its own spelling} \
    -constraints haveType1Base -body {
  # The fixture before the thing it is a fixture for: if the renaming did not
  # take, every test below would pass for the wrong reason.
  set doc [fontRenamedDoc only]
  set names [dict get [my_entry $doc odd] names]
  $doc destroy
  list [dict get $names 183] [dict get $names 124]
} -result {middot verticalbar}

test font-encoding-1.2 {a face spelling a glyph its own way gets a /Differences} \
    -constraints haveType1Base -body {
  # /Encoding /WinAnsiEncoding alone told the reader to look up
  # "periodcentered" in a program that has no such charstring: the glyph was
  # dropped in silence while /Widths went on reserving its advance.
  set doc [fontRenamedDoc only]
  $doc text "A·|A" -at {20 20} -family odd -size 60
  $doc write [::tclpdfTest::scratch encoding-only.pdf]
  set font [lindex [::tclpdfTest::objects $doc {/Subtype /Type1}] 0]
  $doc destroy
  file delete [::tclpdfTest::scratch encoding-only.pdf]
  list [string match {*/BaseEncoding /WinAnsiEncoding*} $font] \
      [regexp {/Differences \[([^\]]*)\]} $font -> array] \
      [string trim $array]
} -result {1 1 {124 /verticalbar 183 /middot}}

test font-encoding-1.3 {a face carrying BOTH names is addressed by WinAnsi's} \
    -constraints haveType1Base -body {
  # The half the array cannot fix and the ordering can: where the face has
  # the Annex D name, that is the name to use, and then the bare
  # /WinAnsiEncoding of before this change is still what gets written.
  set doc [fontRenamedDoc both]
  set names [dict get [my_entry $doc odd] names]
  $doc text "A·|A" -at {20 20} -family odd -size 60
  $doc write [::tclpdfTest::scratch encoding-both.pdf]
  set font [lindex [::tclpdfTest::objects $doc {/Subtype /Type1}] 0]
  $doc destroy
  file delete [::tclpdfTest::scratch encoding-both.pdf]
  list [dict get $names 183] [dict get $names 124] \
      [string match {*/Encoding /WinAnsiEncoding*} $font] \
      [string match {*Differences*} $font]
} -result {periodcentered bar 1 0}

test font-encoding-1.4 {and all four characters are actually drawn} \
    -constraints {haveType1Base havePdftoppm} -body {
  # THE ONLY CHECK THAT SEES THIS DEFECT. qpdf --check is clean either way and
  # pdftotext answers "A.|A" either way, because the loss happens in the
  # renderer: what is written is a name the font program has not got. So the
  # page is rendered and the two columns the middle characters stand in are
  # asked whether anything is there.
  #
  # The four glyphs are set at 60 pt from x = 20 mm on a baseline at y = 20:
  # the two A end at 34.5 mm and begin again at 45.5, so everything found
  # between those two is the dot or the bar and nothing else. Measured across
  # a BAND rather than at a point - a middle dot is a few tenths of a
  # millimetre and a test aimed at one pixel would be a test of this
  # arithmetic - and the two halves are counted apart, so that one glyph
  # coming back cannot cover for the other staying away.
  set path [::tclpdfTest::scratch encoding-drawn.pdf]
  set doc [fontRenamedDoc only]
  $doc text "A·|A" -at {20 20} -family odd -size 60
  $doc write $path
  $doc destroy
  set points {}
  for {set x 355} {$x <= 455} {incr x 5} {
    for {set y 40} {$y <= 180} {incr y 5} {
      lappend points [list [expr {$x / 10.0}] [expr {$y / 10.0}]]
    }
  }
  set dot 0
  set bar 0
  set index 0
  foreach pixel [::tclpdfTest::pixels $path $points -dpi 300 -unit mm] {
    if {[lindex $pixel 0] < 128} {
      if {[lindex $points $index 0] < 40.0} {
        incr dot
      } else {
        incr bar
      }
    }
    incr index
  }
  file delete $path
  list [expr {$dot > 0}] [expr {$bar > 0}]
} -result {1 1}


# --- a face that cannot be set vertically never reserves a vertical object --

test font-vertical-2.1 {an embedded Type 1 face is refused a vertical resource} \
    -constraints {haveFont haveType1} -body {
  # Identity-V is a CMap over glyph numbers, so only a Type 0 font over an
  # embedded sfnt face can name it. Reserving an object for a Type 1 face was
  # not merely useless: /FV<alias> went into the resource dictionary,
  # [FontWriteType1] never filled it, and the DOCUMENT could no longer be
  # written - "object  was never reserved", errorCode NONE.
  #
  # The road in is -fallback: the gate in text.tcl asks only about -family,
  # so a chain reaches this face on a "-direction ttb" line unchecked. U+02C6
  # is the character for it - Noto Sans JP has no glyph for it and OCR-B has.
  set doc [tclpdf new -format a4 -unit mm]
  $doc page add
  $doc font embed jp [file join [file dirname $::fontRegular] google \
      NotoSansJP-Regular.ttf]
  $doc font embed t1 $::type1Face
  set code [catch {$doc text "日ˆ本" -at {20 20} -family jp \
      -fallback t1 -direction ttb -size 12} message options]
  # AND the document is still writable, which is the half that was lost.
  set written [::tclpdfTest::writes $doc vertical-fallback.pdf]
  $doc destroy
  list $code [dict get $options -errorcode] $written
} -result {1 {TCLPDF FONT VERTICAL t1} {0 1}}

test font-vertical-2.2 {an sfnt face still gets one} -constraints haveFont -body {
  # The other half, so the refusal cannot quietly become unconditional.
  set doc [tclpdf new -format a4 -unit mm]
  $doc page add
  $doc font embed jp [file join [file dirname $::fontRegular] google \
      NotoSansJP-Regular.ttf]
  $doc text "日本" -at {20 20} -family jp -direction ttb -size 12
  set stream [::tclpdfTest::content $doc]
  set written [::tclpdfTest::writes $doc vertical-plain.pdf]
  $doc destroy
  list [string match {*/FVjp *} $stream] $written
} -result {1 {0 1}}


test font-source-3.1 {a bare CFF of an unknown version names the CFF reader} \
    -constraints haveOtf -body {
  # doc/tclpdf.md makes the third word of TCLPDF FONT SOURCE the reader that
  # turned the file away, and says a script trying a file through several
  # readers retries on that code. A version-3 CFF used to fall through to the
  # sfnt reader and be called "not a TrueType or OpenType font" - the wrong
  # reader, and the wrong thing to try next.
  set bytes [::tclpdfTest::bareCff $::otf]
  set doc [tclpdf new]
  set code [::tclpdfTest::refusalCode {$doc font embed odd \
      -data [string replace $bytes 0 0 \x03]}]
  $doc destroy
  set code
} -result {TCLPDF FONT SOURCE cff}


cleanupTests

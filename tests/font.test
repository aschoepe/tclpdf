# font.test --
#
# TrueType: parsing, subsetting and embedding.
#
# The CIDToGIDMap tests are regressions against a defect that produced a
# document qpdf called clean and pdffonts called complete - and whose extracted
# text was noise. Only reading the text back showed it.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::font
source [file join [file dirname [info script]] helper.tcl]

set fontRegular [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts DejaVuSans.ttf]

testConstraint haveFont [file exists $fontRegular]

# The same face as TrueType and as OpenType/CFF - which is what makes the two
# roads comparable rather than only exercisable.
set otf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.otf]
set otfTtf [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts urw-core35-fonts NimbusSans-Regular.ttf]
testConstraint haveOtf [file exists $otf]
testConstraint haveOtfPair [expr {[file exists $otf] && [file exists $otfTtf]}]

# The Liberation set - metric copies of Arial, Times New Roman and Courier New,
# standing in for the standard 14 from the other lineage than URW.
set liberation [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts liberation-fonts]
testConstraint haveLiberation [file exists [file join $liberation LiberationSans-Regular.ttf]]

# A Type 1 face with its metrics beside it, for what [font info] says about
# a format that has no fsType.
set type1Face [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts tsukurimashou OCRB.pfb]
testConstraint haveType1 [file exists $type1Face]

test font-1.1 {a TrueType file is parsed} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  list [dict get $parsed unitsPerEm] \
      [expr {[dict get $parsed numGlyphs] > 1000}] \
      [dict get $parsed names postScript] \
      [dict get $parsed fsType]
} -result {2048 1 DejaVuSans 0}

test font-1.2 {fsType is translated into words} -body {
  list [::tclpdf::sfnt permission 0] [::tclpdf::sfnt permission 2] \
      [::tclpdf::sfnt permission 12]
} -match glob -result {{installable*} {restricted*} {unclear*}}

test font-1.3 {a CFF font is read, and says so} -constraints haveOtf -body {
  # OTTO used to be refused here. Everything in such a file except the
  # outlines is the same sfnt structure, so it is parsed like any other and
  # only the outline side is marked - what cannot be done with CFF (subsetting
  # through loca and glyf) is decided where it is done.
  set parsed [::tclpdf::sfnt read $::otf]
  list [dict get $parsed outlines] [dict get $parsed loca] \
      [expr {[dict size [dict get $parsed cmap]] > 100}] \
      [expr {[dict get $parsed numGlyphs] > 100}]
} -result {cff {} 1 1}

test font-1.3a {a TrueType font says so too} -constraints haveFont -body {
  # The other half, so the marking cannot quietly become constant.
  set parsed [::tclpdf::sfnt read $fontRegular]
  list [dict get $parsed outlines] [expr {[llength [dict get $parsed loca]] > 100}]
} -result {truetype 1}

test font-1.4 {something that is not a font at all} -body {
  ::tclpdf::sfnt parse "not a font file at all, really"
} -returnCodes error -match glob -result {*not a TrueType or OpenType font*}

# A TrueType collection, built rather than found - the same reason as the
# CID-keyed CFF face further down: the collections on this machine are macOS
# system fonts and may not be checked in. A collection is a whole sfnt of its
# own: the tag "ttcf", a version, the number of faces and one offset to each
# face's table directory. The refusal hangs on the tag alone, so the header is
# all it takes - and the header is what a real file starts with.
proc fontMakeCollectionHeader {{faces 2}} {
  set header [binary format a4II ttcf 0x00020000 $faces]
  # The offsets a real file would carry: the first directory begins right
  # after the header, the second one an arbitrary distance further on.
  for {set i 0} {$i < $faces} {incr i} {
    append header [binary format I [expr {12 + 4 * $faces + $i * 0x1000}]]
  }
  return $header
}

test font-1.5 {a TrueType collection is refused, and says how to get on} -body {
  ::tclpdf::sfnt parse [fontMakeCollectionHeader]
} -returnCodes error -match glob -result {*TrueType collection*extract the single face*}

test font-1.5a {and it is the tag that decides, not the rest of the header} -body {
  # The same bytes with the tag of a plain TrueType file: the parse gets past
  # the signature and fails further in, on a table directory that is none.
  # Without this the collection test would still pass if the refusal came out
  # of some other branch by accident.
  set bytes [fontMakeCollectionHeader]
  set plain [string replace $bytes 0 3 [binary format I 0x00010000]]
  set message {}
  catch {::tclpdf::sfnt parse $plain} message
  list [string match {*TrueType collection*} $message] \
      [string match {tclpdf:*} $message]
} -result {0 1}

test font-1.6 {a table directory that ends in the middle is named, not crashed on} -body {
  # Found by the test above: binary scan fills what it can and leaves the rest
  # of its variables unset, so a directory that is cut short used to fail with
  # "can't read position: no such variable" - a raw Tcl error where every
  # refusal of this package begins with tclpdf:. Twelve bytes: the TrueType
  # tag, two announced tables, and nothing behind them.
  ::tclpdf::sfnt parse [binary format ISuSuSuSu 0x00010000 2 0 0 0]
} -returnCodes error -match glob -result {*table directory is cut short*announces 2 tables*}

test font-2.1 {the cmap maps characters to glyphs} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set euro [scan [encoding convertfrom utf-8 [binary format H* e282ac]] %c]
  list [dict exists $cmap 65] [dict exists $cmap 228] [dict exists $cmap $euro]
} -result {1 1 1}

test font-3.1 {a subset carries only the glyphs asked for, plus components} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  # a-umlaut is a composite: it references "a" and "dieresis", and a subset
  # that copies only the composite renders as nothing at all.
  set aeGlyph [dict get $cmap 228]
  set built [::tclpdf::subset build $parsed [list $aeGlyph]]
  set order [dict get $built order]
  set components [::tclpdf::subset::Components $parsed $aeGlyph]
  set missing {}
  foreach component $components {
    if {$component ni $order} {
      lappend missing $component
    }
  }
  list [expr {[llength $components] > 0}] $missing [expr {0 in $order}]
} -result {1 {} 1}

test font-3.2 {head.checkSumAdjustment makes the whole subset sum to 0xB1B0AFBA} -constraints haveFont -body {
  # OpenType head: with the field at zero the file sums to S, and the field
  # is 0xB1B0AFBA - S; so with the field in place the file sums to
  # 0xB1B0AFBA. Verified the way fontTools verifies it. Before 2026-08-17 the
  # field shipped as 0 in every subset while a comment promised otherwise.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set built [::tclpdf::subset build $parsed [list [dict get $parsed cmap 65]]]
  set bytes [dict get $built bytes]
  # Find head in the directory: 12 bytes header, 16 per entry.
  binary scan $bytes @4Su count
  set headOffset -1
  for {set i 0} {$i < $count} {incr i} {
    binary scan $bytes @[expr {12 + $i * 16}]a4IuIuIu tag sum offset length
    if {$tag eq "head"} {
      set headOffset $offset
      set headSum $sum
    }
  }
  binary scan $bytes @[expr {$headOffset + 8}]Iu adjustment
  set total [::tclpdf::subset::Checksum $bytes]
  # The directory checksum of head is taken with the field zeroed.
  set headZeroed [string replace [string range $bytes $headOffset [expr {$headOffset + 53}]] 8 11 [binary format Iu 0]]
  list [expr {$headOffset > 0}] [expr {$adjustment != 0}] \
      [format %08X $total] \
      [expr {$headSum == [::tclpdf::subset::Checksum $headZeroed]}]
} -result {1 1 B1B0AFBA 1}

# Split a composite glyph into one record per component: the flags, the glyph
# id, and everything after it as hex - the offset and the optional scale. The
# tail is what places the component; the dots of an A-dieresis sit above the A
# because of it, and nowhere else is that written down.
#
# Reading it needs the same flag arithmetic the subsetter uses, so the test
# deliberately re-implements it instead of calling into the module: a shared
# helper would go wrong in both places at once and agree with itself.
proc fontComponentRecords {data} {
  set records {}
  set position 10
  while {$position + 4 <= [string length $data]} {
    binary scan $data @${position}SuSu flags glyphIndex
    set start [expr {$position + 4}]
    # ARG_1_AND_2_ARE_WORDS, then one of the three scale forms.
    set stop [expr {$start + (($flags & 0x0001) ? 4 : 2)}]
    if {$flags & 0x0008} {
      incr stop 2
    } elseif {$flags & 0x0040} {
      incr stop 4
    } elseif {$flags & 0x0080} {
      incr stop 8
    }
    binary scan [string range $data $start [expr {$stop - 1}]] H* tail
    lappend records [list $flags $glyphIndex $tail]
    set position $stop
    # MORE_COMPONENTS
    if {!($flags & 0x0020)} break
  }
  return $records
}

test font-3.1.1 {subsetting leaves every component offset alone} -constraints haveFont -body {
  # EVERY composite in the face, not one chosen character. A-dieresis alone
  # proves nothing: its only word-sized argument sits in the LAST component,
  # after which the loop ends anyway, so a misread record length shifts
  # nothing. Measured on DejaVu Sans: 1039 composites carry word arguments in
  # the FIRST component and 383 have three or more, up to eight - those are
  # the ones where a wrong length walks into the next record. The two counts
  # below are asserted so that the test cannot quietly stop covering them.
  #
  # One subset for all of them, which is what makes this affordable: 2445
  # composites drag their parts in and build in about 60 ms.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set composites {}
  foreach {code glyph} [dict get $parsed cmap] {
    if {[llength [::tclpdf::subset::Components $parsed $glyph]]} {
      lappend composites $glyph
    }
  }
  set composites [lsort -unique -integer $composites]
  set built [::tclpdf::subset build $parsed $composites]
  set mapping [dict get $built glyphs]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]

  set faults {}
  set deep 0
  set wordsFirst 0
  foreach glyph $composites {
    set before [fontComponentRecords [::tclpdf::subset::GlyphData $parsed $glyph]]
    set after [fontComponentRecords [::tclpdf::subset::GlyphData $again \
        [dict get $mapping $glyph]]]
    if {[llength $before] >= 3} {
      incr deep
    }
    if {[lindex $before 0 0] & 0x0001} {
      incr wordsFirst
    }
    if {[llength $before] != [llength $after]} {
      lappend faults "$glyph: [llength $before] components became [llength $after]"
      continue
    }
    foreach old $before new $after {
      lassign $old oldFlags oldId oldTail
      lassign $new newFlags newId newTail
      if {$oldFlags != $newFlags} {
        lappend faults "$glyph: flags $oldFlags became $newFlags"
      }
      if {$oldTail ne $newTail} {
        lappend faults "$glyph: offset $oldTail became $newTail"
      }
      if {$newId != [dict get $mapping $oldId]} {
        lappend faults "$glyph: component $oldId became $newId,\
            not [dict get $mapping $oldId]"
      }
    }
  }
  # The first few faults are enough to name the defect; a thousand are not
  # more informative and make the failure unreadable.
  list [llength $composites] [expr {$deep > 100}] [expr {$wordsFirst > 100}] \
      [llength $faults] [lrange $faults 0 2]
} -result {2445 1 1 0 {}}

# A composite whose FIRST component carries a scale and is followed by a
# second one. Neither DejaVu face contains such a glyph - measured, zero out of
# 2445 composites use any of the three scale forms - so the three branches that
# skip a scale cannot be reached by any test built from those files. The glyph
# is therefore built here: two components, ids 10 and 20, the first scaled.
#
# A wrong skip length lands the subsetter inside the scale bytes, and it then
# renumbers whatever it finds there instead of the second component.
proc fontScaledComposite {scaleFlag scale} {
  # numberOfContours -1 marks a composite; the four numbers after it are the
  # bounding box, which nothing here depends on.
  set data [binary format SSSSS -1 0 0 100 100]
  # ARGS_ARE_XY_VALUES | MORE_COMPONENTS, byte-sized arguments, plus the scale.
  append data [binary format SuSu [expr {0x0022 | $scaleFlag}] 10]
  append data [binary format cc 5 7] $scale
  append data [binary format SuSu 0x0002 20] [binary format cc -3 9]
  return $data
}

test font-3.1.2 {a scaled component does not shift the one behind it} -body {
  set faults {}
  foreach {name flag scale} [list \
      "single scale" 0x0008 [binary format S 16384] \
      "x and y scale" 0x0040 [binary format SS 16384 8192] \
      "two by two" 0x0080 [binary format SSSS 16384 0 0 16384]] {
    set data [fontScaledComposite $flag $scale]
    # The smallest thing sfnt::table will read from: the glyf table is the
    # glyph itself, and loca brackets it.
    set font [dict create bytes $data loca [list 0 [string length $data]] \
        tables [dict create glyf [list 0 [string length $data]]]]
    set before [fontComponentRecords $data]
    set after [fontComponentRecords [::tclpdf::subset::Rewrite $font 0 {10 1 20 2}]]
    if {[llength $before] != 2 || [llength $after] != 2} {
      lappend faults "$name: [llength $before] components became [llength $after]"
      continue
    }
    foreach old $before new $after want {1 2} {
      lassign $old oldFlags oldId oldTail
      lassign $new newFlags newId newTail
      if {$oldFlags != $newFlags || $oldTail ne $newTail} {
        lappend faults "$name: component $oldId lost its placement"
      }
      if {$newId != $want} {
        lappend faults "$name: component $oldId became $newId, not $want"
      }
    }
  }
  set faults
} -result {}

test font-3.1.3 {the subset keeps every left side bearing} -constraints haveFont -body {
  # hmtx used to be written with a flat zero bearing, and no rendering check
  # caught it. Both rasterisers put every glyph at cursor plus bearing, so the
  # letters all crept left by their own amount and the gaps between them went
  # uneven - wrong everywhere, but not obviously so. The obvious half only
  # shows in CoreGraphics, which shifts the COMPONENTS of a composite by their
  # bearing too: a-dieresis fell apart in Preview while pdftoppm drew it
  # correctly, and qpdf and veraPDF said nothing at all.
  #
  # The characters below drag their marks in through the composite closure,
  # and those marks are exactly the glyphs with a large negative bearing.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set glyphs {}
  foreach code {65 196 228 233 252 241 353} {
    lappend glyphs [dict get $parsed cmap $code]
  }
  set built [::tclpdf::subset build $parsed [lsort -unique -integer $glyphs]]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]
  set mapping [dict get $built glyphs]

  set faults {}
  set large 0
  foreach old [dict get $built order] {
    set want [::tclpdf::sfnt bearing $parsed $old]
    # A bearing far from zero is what makes the defect visible; a letter whose
    # bearing is 16 units would move imperceptibly. Measured in this subset:
    # two marks at -827 and -809, while the marks for acute, tilde and caron
    # sit at POSITIVE bearings - so "negative" would have been the wrong test.
    if {abs($want) > 500} {
      incr large
    }
    set got [::tclpdf::sfnt bearing $again [dict get $mapping $old]]
    if {$want != $got} {
      lappend faults "glyph $old: bearing $want became $got"
    }
  }
  list [expr {$large >= 2}] [llength $faults] [lrange $faults 0 2]
} -result {1 0 {}}

test font-3.1.4 {a bearing agrees with the glyph's own xMin} -constraints haveFont -body {
  # head flag bit 1 says the two are the same, which is why a renderer may use
  # either and why writing a wrong bearing stays invisible for so long. The
  # real point here is the parser: hmtx is an array of PAIRS, and reading it at
  # the wrong stride returns advance widths where bearings belong.
  #
  # One unit of slack, because the font itself is not exact: measured over
  # 5857 glyphs of DejaVu Sans, five differ by exactly one unit (U+1F32,
  # U+1F33, U+1F35, U+20D0, U+2422). A stride error would not produce ones.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set faults {}
  set checked 0
  foreach {code glyph} [dict get $parsed cmap] {
    set data [::tclpdf::subset::GlyphData $parsed $glyph]
    if {[string length $data] < 10} continue
    binary scan $data SS - xMin
    incr checked
    set bearing [::tclpdf::sfnt bearing $parsed $glyph]
    if {abs($bearing - $xMin) > 1} {
      lappend faults "glyph $glyph: bearing $bearing, xMin $xMin"
    }
  }
  list [expr {$checked > 5000}] [llength $faults] [lrange $faults 0 2]
} -result {1 0 {}}

test font-3.2 {the subset is a fraction of the original} -constraints haveFont -body {
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set glyphs {}
  foreach char [split "Rechnung 2026" {}] {
    lappend glyphs [dict get $cmap [scan $char %c]]
  }
  set built [::tclpdf::subset build $parsed [lsort -unique -integer $glyphs]]
  set original [string length [dict get $parsed bytes]]
  set reduced [string length [dict get $built bytes]]
  expr {$reduced < $original / 20}
} -result 1

test font-3.3 {the subset can be read back} -constraints haveFont -body {
  # It carries no cmap on purpose - Identity-H addresses glyphs directly - so
  # the parser must not insist on one.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set built [::tclpdf::subset build $parsed [list [dict get $parsed cmap 65]]]
  set again [::tclpdf::sfnt parse [dict get $built bytes]]
  list [dict get $again unitsPerEm] [dict get $again numGlyphs] \
      [dict exists [dict get $again tables] glyf]
} -result {2048 2 1}

test font-3.4 {the same glyphs give the same bytes} -constraints haveFont -body {
  # Reproducible output: two runs of the same report must not differ.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set glyphs [list [dict get $parsed cmap 65] [dict get $parsed cmap 66]]
  set first [::tclpdf::subset build $parsed $glyphs]
  set second [::tclpdf::subset build $parsed [lreverse $glyphs]]
  expr {[dict get $first bytes] eq [dict get $second bytes]}
} -result 1

test font-4.1 {an embedded font becomes Type0 with Identity-H} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc font -family haus -size 12
  $doc text "Rechnung" -at {20 20}
  set path [::tclpdfTest::scratch font-embed.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Subtype /Type0} $bytes] [regexp {/Encoding /Identity-H} $bytes] \
      [regexp {/Subtype /CIDFontType2} $bytes] [regexp {/FontFile2} $bytes] \
      [regexp {/ToUnicode} $bytes]
} -result {1 1 1 1 1}

test font-4.2 {CIDToGIDMap is a stream, not Identity} -constraints haveFont -body {
  # Regression. /Identity claims the CID equals the glyph number in the
  # embedded file, which stops being true the moment anything is subsetted -
  # the document then renders with the wrong glyphs and no tool complains.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cidmap.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/CIDToGIDMap \d+ 0 R} $bytes] [regexp {/CIDToGIDMap /Identity} $bytes]
} -result {1 0}

test font-4.3 {content stream, CIDToGIDMap and ToUnicode agree} -constraints haveFont -body {
  # The three have to line up or the text comes out as noise: the content
  # stream carries the ORIGINAL glyph number, CIDToGIDMap turns it into the
  # subset one, ToUnicode turns it back into a character. Getting this wrong
  # is invisible to qpdf and to pdffonts.
  package require tclpdf::filter
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "A" -at {20 20} -family haus
  set parsed [dict get [$doc state fonts] haus parsed]
  set glyphA [dict get $parsed cmap 65]
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch font-agree.pdf]
  $doc write $path
  set writer [$doc writer]

  # Which object is the map? The CID font says so.
  set mapNumber {}
  set toUnicodeNumber {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[regexp {/CIDToGIDMap (\d+) 0 R} $body -> found]} {
      set mapNumber $found
    }
    if {[regexp {/ToUnicode (\d+) 0 R} $body -> found]} {
      set toUnicodeNumber $found
    }
  }
  set map [::tclpdfTest::streamOf $writer $mapNumber]
  set toUnicode [::tclpdfTest::streamOf $writer $toUnicodeNumber]
  $doc destroy
  file delete $path

  # 1. the stream carries the original glyph number as two bytes
  # [string first], not [string match]: the escaped form contains backslashes,
  # and a glob pattern would read those as escapes rather than as characters.
  set inStream [expr {[string first [::tclpdf::pdfObj bytesStr \
      [binary format Su $glyphA]] $content] >= 0}]
  # 2. ToUnicode maps that number back to U+0041
  set inToUnicode [regexp "<[format %04X $glyphA]> <0041>" $toUnicode]
  # 3. the map has a non-zero subset glyph at that position
  binary scan [string range $map [expr {$glyphA * 2}] [expr {$glyphA * 2 + 1}]] Su subsetGlyph
  list $inStream $inToUnicode [expr {$subsetGlyph != 0}]
} -result {1 1 1}

test font-4.4 {a character the font lacks is refused} -constraints haveFont -body {
  # U+4E2D, a CJK ideograph - measured, DejaVu Sans has no glyph for it.
  # An emoji would NOT do here: the face does carry U+1F600.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  try {
    $doc text [encoding convertfrom utf-8 [binary format H* e4b8ad]] \
        -at {20 20} -family haus
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*has no glyph for U+4E2D*}

test font-4.4a {the refusal carries the machine-readable -errorcode} -constraints haveFont -body {
  # Same contract as the standard faces (see afm-3.9 and the manual under
  # "Error codes"); the fontname element is the caller's own alias. Trapped
  # here exactly as a script would, by the prefix of the errorcode list.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  try {
    $doc text "ab[encoding convertfrom utf-8 [binary format H* e4b8ad]]" \
        -at {20 20} -family haus
    set found none
  } trap {TCLPDF FONT GLYPH} {- opts} {
    set found [dict get $opts -errorcode]
  } finally {
    $doc destroy
  }
  set found
} -result {TCLPDF FONT GLYPH U+4E2D 2 haus}

test font-4.7 {code points outside the BMP are read from a format 12 cmap} -constraints haveFont -body {
  # Measured on DejaVu Sans: it maps U+1F600 through a format 12 subtable, so
  # this also proves the parser prefers that over the BMP-only format 4.
  set parsed [::tclpdf::sfnt read $fontRegular]
  set cmap [dict get $parsed cmap]
  set emoji [scan [encoding convertfrom utf-8 [binary format H* f09f9880]] %c]
  list [dict exists $cmap $emoji] \
      [expr {[lindex [lsort -integer [dict keys $cmap]] end] > 0xFFFF}]
} -result {1 1}

test font-4.5 {an embedded font that is never used produces no objects} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "nur Helvetica" -at {20 20}
  set path [::tclpdfTest::scratch font-unused.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/FontFile2} $bytes
} -result 0

test font-4.6 {a duplicate alias is refused} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  try {
    $doc font embed haus $fontRegular
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*already embedded*}

test font-5.1 {widths come from the font, not from a standard table} -constraints haveFont -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed haus $fontRegular
  set embedded [$doc textWidth "Rechnung" -family haus -size 12]
  set standard [$doc textWidth "Rechnung" -family helvetica -size 12]
  $doc destroy
  # Different faces, different widths - and both plausible for 8 characters
  list [expr {$embedded != $standard}] [expr {$embedded > 20 && $embedded < 100}]
} -result {1 1}

test font-5.2 {font info reports what the file says} -constraints haveFont -body {
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  set info [$doc font info haus]
  $doc destroy
  list [dict get $info family] [dict get $info fsType] \
      [expr {[dict get $info glyphs] > 1000}]
} -match glob -result {{DejaVu Sans} 0 1}

test font-6.1 {-subset 0 embeds the whole face} -constraints haveFont -body {
  # The documented escape hatch for a face that must stay complete - a form
  # someone fills in afterwards, or a reader that refuses subsets. Nothing had
  # ever called it, and the difference is a factor of about eighty in size.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular -subset 0
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-whole.pdf]
  $doc write $path
  $doc destroy
  set whole [file size $path]
  file delete $path
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-subset.pdf]
  $doc write $path
  $doc destroy
  set part [file size $path]
  file delete $path
  expr {$whole > $part * 10}
} -result 1

test font-6.2 {a whole face carries no subset prefix} -constraints haveFont -body {
  # The six-letter tag MEANS subset (9.9.2). A complete DejaVuSans announcing
  # itself as SZGNUB+DejaVuSans tells a reader merging fonts to keep two
  # incompatible copies of the same face, and entitles a preflight tool to
  # reject the file. All three names have to agree - descriptor, CID font and
  # Type0 font.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular -subset 0
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-prefix.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/BaseFont /DejaVuSans\y} $bytes] \
      [regexp -all {/FontName /DejaVuSans\y} $bytes] \
      [regexp {[A-Z]{6}\+DejaVuSans} $bytes]
} -result {2 1 0}

test font-6.3 {a subsetted face still carries one} -constraints haveFont -body {
  # The other half: without this the fix above could simply drop the tag
  # everywhere, which would be just as wrong the other way round.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-tag.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The same tag in all three places, and it is derived from the name, so it
  # is the same one on every run.
  list [regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans} $bytes] \
      [regexp -all {/FontName /[A-Z]{6}\+DejaVuSans} $bytes]
} -result {2 1}

# A face that leads with a platform 0 name, built rather than found.
#
# 20 of the 210 faces on this machine lead with one - Times New Roman and
# Arial Narrow among them - so this is not an exotic case, but none of those
# files may be checked in. The case is therefore made from DejaVu: the
# platform 1 record is taken out of the running by relabelling its nameId, and
# the platform 3 record, which is already UTF-16BE, is relabelled as platform
# 0. That is exactly what the affected fonts carry.
proc fontLeadWithPlatformZero {source target} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables name] position -
  binary scan $bytes @[expr {$position + 2}]Su count
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$position + 6 + $index * 12}]
    binary scan $bytes @${at}SuSuSuSu platform encoding language nameId
    if {$nameId != 6} {
      continue
    }
    if {$platform == 1} {
      # nameId 18 is "compatible full", which nothing here reads.
      set bytes [string replace $bytes [expr {$at + 6}] [expr {$at + 7}] \
          [binary format Su 18]]
    } elseif {$platform == 3} {
      set bytes [string replace $bytes $at [expr {$at + 1}] [binary format Su 0]]
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-7.1 {a platform 0 name is decoded, not passed through raw} -constraints haveFont -body {
  # Platform 0 (Unicode) is UTF-16BE just as platform 3 is, and only the
  # second was decoded. The first record wins, so a font that leads with
  # platform 0 handed its PostScript name over with a NUL between every
  # letter.
  set path [fontLeadWithPlatformZero $fontRegular \
      [::tclpdfTest::scratch platform0.ttf]]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set name [dict get $parsed names postScript]
  list $name [string first \x00 $name]
} -result {DejaVuSans -1}

test font-7.2 {and the document it produces has a usable font name} -constraints haveFont -body {
  # What the defect actually cost: /BaseFont /HOVCJQ+#00D#00e#00j... in the
  # file, and qpdf refusing it with "null character not allowed in name token"
  # - three warnings and exit 3, measured. veraPDF says nothing about it: it
  # does not check names. So only this end catches it.
  set path [fontLeadWithPlatformZero $fontRegular \
      [::tclpdfTest::scratch platform0.ttf]]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  $doc text "Grusse" -at {20 20} -family haus
  set pdf [::tclpdfTest::scratch platform0.pdf]
  $doc write $pdf
  $doc destroy
  set bytes [::tclpdfTest::readBytes $pdf]
  file delete $pdf $path
  list [regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans\y} $bytes] \
      [regexp {#00} $bytes]
} -result {2 0}

test font-7.3 {a Macintosh name stays one byte per character} -constraints haveFont -body {
  # The other direction, and the reason the fix names two platforms rather
  # than "anything but 1": platform 1 is MacRoman, one byte per character.
  # Decoded as UTF-16 it would pair the letters up - DejaVuSans would become
  # five CJK characters, and nothing anywhere would fail.
  set channel [open $fontRegular rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables name] position -
  binary scan $bytes @[expr {$position + 2}]Su count
  set leads {}
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$position + 6 + $index * 12}]
    binary scan $bytes @${at}SuSuSuSu platform encoding language nameId
    if {$nameId == 6 && $leads eq {}} {
      set leads $platform
    }
  }
  # DejaVu leads with platform 1, which is why it never showed the defect.
  list $leads [dict get $parsed names postScript]
} -result {1 DejaVuSans}

test font-8.1 {a CFF face is embedded as FontFile3, not FontFile2} -constraints haveOtf -body {
  # /FontFile3 with /Subtype /OpenType takes the WHOLE sfnt file, cmap and
  # all - so the CFF table never has to be understood, only carried. The
  # descendant is a CIDFontType0, and CIDToGIDMap has no place there: it
  # belongs to CIDFontType2 alone.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $::otf
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cff.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/FontFile3 \d+ 0 R} $bytes] [regexp {/FontFile2} $bytes] \
      [regexp {/Subtype /OpenType} $bytes] \
      [regexp {/Subtype /CIDFontType0\y} $bytes] \
      [regexp {/CIDToGIDMap} $bytes] [regexp {/ToUnicode} $bytes]
} -result {1 0 1 1 0 1}

test font-8.2 {a CFF face carries no subset prefix} -constraints haveOtf -body {
  # It goes in whole - there is no subsetter for CFF here - and the six-letter
  # tag MEANS subset (9.9.2). Claiming one on a complete face invites a reader
  # merging documents to keep two incompatible copies.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $::otf
  $doc text "Rechnung" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-cff-name.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/BaseFont /NimbusSans-Regular\y} $bytes] \
      [regexp {[A-Z]{6}\+NimbusSans} $bytes]
} -result {2 0}

test font-8.3 {the same face measures the same from either format} -constraints haveOtfPair -body {
  # The invariant this tree offers: NimbusSans is here as CFF and as TrueType.
  # The widths come from hmtx in both cases, but through two different files
  # and two different glyph numberings, so agreement is worth asserting.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc font embed cff $::otf
  $doc font embed ttf $::otfTtf
  set faults {}
  foreach sample {Rechnung Hamburgefonstiv "AVATAR 12,34"} {
    set a [$doc textWidth $sample -family cff -size 100 -kerning 0]
    set b [$doc textWidth $sample -family ttf -size 100 -kerning 0]
    # The tolerance grows with the line, because the error does: the CFF file
    # carries 1000 units per em and the TrueType one 2048, so every single
    # glyph rounds by up to half a unit and those add up. A fixed tolerance
    # would pass short words and fail long ones - measured, "Rechnung" differs
    # by 0.108 pt at size 100, which is 0.0135 pt per character.
    if {abs($a - $b) > 0.05 * [string length $sample]} {
      lappend faults "$sample: $a against $b"
    }
  }
  $doc destroy
  set faults
} -result {}

test font-8.4 {-subset has no effect on a CFF face, and does not pretend to} -constraints haveOtf -body {
  # Asking for a subset of a CFF face cannot be honoured - loca and glyf are
  # what the subsetter rewrites and neither exists. What matters is that the
  # document is still correct: whole file, no prefix, either way.
  set sizes {}
  foreach wanted {1 0} {
    set doc [tclpdf new]
    $doc page add
    $doc font embed haus $::otf -subset $wanted
    $doc text "A" -at {20 20} -family haus
    set path [::tclpdfTest::scratch font-cff-subset.pdf]
    $doc write $path
    $doc destroy
    lappend sizes [file size $path]
    file delete $path
  }
  # Same file both times, so the same size - within the few bytes the date
  # and the ID can differ by.
  expr {abs([lindex $sizes 0] - [lindex $sizes 1]) < 32}
} -result 1

proc variableTree {name} {
  set here [file dirname [file dirname [file normalize [info script]]]]
  return [file join $here examples assets fonts google $name]
}

test font-8.1 {-axes embeds a chosen point on the axes} -body {
  # Three weights out of ONE file, and they have to differ in the stream: the
  # widths come from the instanced hmtx, so a wrong instance shows up as a
  # wrong measurement long before anyone looks at the page.
  set widths {}
  foreach weight {100 400 900} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] -axes [list wght $weight]
    $doc font -family face -size 20
    lappend widths [format %.2f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  lassign $widths thin regular black
  list [expr {$thin < $regular}] [expr {$regular < $black}]
} -result {1 1}

test font-8.2 {-instance names a point the designer stood behind} -body {
  # The named instance has to agree with the axis values it stands for - it is
  # resolved to those values and takes the same path from there.
  set widths {}
  foreach call {{-instance Bold} {-axes {wght 700}}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] {*}$call
    $doc font -family face -size 20
    lappend widths [format %.4f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  expr {[lindex $widths 0] eq [lindex $widths 1]}
} -result 1

test font-8.3 {-axes refines a named instance} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face [variableTree Roboto-Variable.ttf] \
      -instance Bold -axes {wdth 75}
  $doc font -family face -size 20
  set narrow [$doc textWidth "Hamburgefonstiv"]
  $doc destroy
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face [variableTree Roboto-Variable.ttf] -instance Bold
  $doc font -family face -size 20
  set wide [$doc textWidth "Hamburgefonstiv"]
  $doc destroy
  expr {$narrow < $wide}
} -result 1

test font-8.4 {without -axes the default instance is embedded as before} -body {
  # The behaviour every existing document relies on: an untouched variable
  # font is its default instance, which is what sits in glyf.
  set widths {}
  foreach call {{} {-axes {wght 400 wdth 100}}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed face [variableTree Roboto-Variable.ttf] {*}$call
    $doc font -family face -size 20
    lappend widths [format %.6f [$doc textWidth "Hamburgefonstiv"]]
    $doc destroy
  }
  expr {[lindex $widths 0] eq [lindex $widths 1]}
} -result 1

test font-8.5 {an axis the font does not have is named, with the ones it does} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Variable.ttf] -axes {wgth 700}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no axis "wgth"*wght wdth*}

test font-8.6 {an unknown instance lists the ones that exist} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Variable.ttf] -instance Ultrablack
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no instance named "Ultrablack"*Thin*}

test font-8.7 {-axes on a static font says so instead of doing nothing} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc font embed face [variableTree Roboto-Regular.ttf] -axes {wght 700}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*not a variable font*fvar*}

# The base names of the embedded faces in a written document, one per font
# object that carries a descriptor - the tag and the name a reader is told.
proc fontBaseNames {bytes} {
  set names {}
  foreach {- name} [regexp -all -inline {/FontName /(\S+)} $bytes] {
    lappend names $name
  }
  return $names
}

test font-9.1 {two subsets of one face in one document carry different tags} -constraints haveFont -body {
  # ISO 32000-1 9.6.4: different subsets of the same font in one file shall
  # have different tags. The tag used to be a function of the name alone, so
  # every subset of DejaVuSans in every document was SZGNUB+ - and a reader
  # entitled to take same tag, same name for the same font would have drawn
  # one subset with the glyphs of the other. Now it is derived from what was
  # subsetted: two aliases of one file with different text get different
  # tags, and the same text gets the same one.
  set doc [tclpdf new]
  $doc page add
  $doc font embed one $fontRegular
  $doc font embed two $fontRegular
  $doc font embed three $fontRegular
  $doc text "Grusse" -at {20 20} -family one
  $doc text "Rechnung" -at {20 40} -family two
  $doc text "Grusse" -at {20 60} -family three
  set path [::tclpdfTest::scratch font-tags.pdf]
  $doc write $path
  $doc destroy
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  file delete $path
  lassign $names one two three
  list [llength $names] [regexp {^[A-Z]{6}\+DejaVuSans$} $one] \
      [expr {$one ne $two}] [expr {$one eq $three}]
} -result {3 1 1 1}

test font-9.2 {the tag is the same on every write of the same document} -constraints haveFont -body {
  # Derived from the content, not from the clock or the object number: two
  # writes of one document are byte-identical, and two runs of one report
  # produce the same file.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  lassign [::tclpdfTest::writeTwice $doc font-tag-twice] first second
  $doc destroy
  list [expr {$first eq $second}] \
      [expr {[fontBaseNames $first] eq [fontBaseNames $second]}]
} -result {1 1}

test font-9.3 {every instance of a variable face is its own font, by name and tag} -body {
  # 02.10 embeds Roboto twenty-four times; measured with pdffonts before
  # this, all twenty-four were SZGNUB+Roboto-Regular - the tag from the name,
  # the name from name id 6, which names the default and nothing else. Now a
  # named instance carries the PostScript name fvar gives it, a point in
  # between is named by its axis values (TN 5902), and the tags differ
  # because the glyphs do.
  set doc [tclpdf new -unit mm]
  $doc page add
  foreach {alias options} {thin {-instance Thin} bold {-axes {wght 700}}
      between {-axes {wght 620}} narrow {-instance Bold -axes {wdth 80}}} {
    $doc font embed $alias [variableTree Roboto-Variable.ttf] {*}$options
    $doc font -family $alias -size 12
    $doc text "Hamburgefonstiv" -at {20 30}
  }
  set path [::tclpdfTest::scratch font-instances.pdf]
  $doc write $path
  $doc destroy
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  file delete $path
  set tags {}
  set bare {}
  foreach name $names {
    regexp {^([A-Z]{6})\+(.*)$} $name -> tag rest
    lappend tags $tag
    lappend bare $rest
  }
  list $bare [llength [lsort -unique $tags]]
} -result {{Roboto-Thin Roboto-Bold Roboto_620wght Roboto_700wght_80wdth} 4}

test font-10.1 {-subset 0 on an instance embeds the instance, not the variable file} -body {
  # PDF knows nothing of variation. The whole file, embedded as it is, is the
  # variable face - fvar, gvar and the rest - and a reader draws its DEFAULT
  # outlines under the /W array of the instance: Regular shapes spaced as
  # Bold. Measured before this: 22 tables in the FontFile2, gvar among them.
  # Now every glyph goes through the instancer and the variation tables stay
  # behind; all 1326 glyphs are there, so no subset tag is written.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed bold [variableTree Roboto-Variable.ttf] -instance Bold -subset 0
  $doc font -family bold -size 12
  $doc text "Hamburgefonstiv" -at {20 30}
  set path [::tclpdfTest::scratch font-instance-whole.pdf]
  $doc write $path
  set writer [$doc writer]
  set fontFile {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[string match {*/Length1 *} [$writer body $number]]} {
      set fontFile [::tclpdfTest::streamOf $writer $number]
    }
  }
  set names [fontBaseNames [::tclpdfTest::readBytes $path]]
  $doc destroy
  file delete $path
  package require tclpdf::sfnt
  set embedded [::tclpdf::sfnt parse $fontFile]
  set tables [lsort [dict keys [dict get $embedded tables]]]
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  # The hmtx in the file is the instance's, not the default: the H of Roboto
  # Bold advances 1446 units where the Regular one advances 1461 (fontTools'
  # instancer says the same), so the two must differ, and the embedded one
  # must be what the instancer computed.
  package require tclpdf::varFont
  set h [dict get [dict get $original cmap] 72]
  set instanced [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 700}]]
  list $names [expr {"fvar" in $tables}] [expr {"gvar" in $tables}] \
      [expr {"glyf" in $tables}] \
      [expr {[dict get $embedded numGlyphs] == [dict get $original numGlyphs]}] \
      [expr {[::tclpdf::sfnt advance $embedded $h] != [::tclpdf::sfnt advance $original $h]}] \
      [expr {[::tclpdf::sfnt advance $embedded $h] == [dict get $instanced $h advance]}]
} -result {Roboto-Bold 0 0 1 1 1 1}

test font-11.1 {the descriptor reads the italic angle and the cap height from the file} -constraints haveOtfPair -body {
  # Table 122: ItalicAngle and CapHeight are required and were written as 0
  # and as the ascender for every face. post.italicAngle of Nimbus Sans
  # Oblique is -12 (measured with fontTools), OS/2 sCapHeight of Nimbus Sans
  # 1493 of 2048 units, which is 729 in the 1/1000 em of the descriptor - and
  # the ascender it was written as is 1602, which is 782.
  set oblique [file join [file dirname $::otfTtf] NimbusSans-Oblique.ttf]
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed upright $::otfTtf
  $doc font embed slanted $oblique
  $doc text "Rechnung" -at {20 20} -family upright
  $doc text "Rechnung" -at {20 40} -family slanted
  set path [::tclpdfTest::scratch font-descriptor.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set angles {}
  set caps {}
  set flags {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/ItalicAngle (\S+)} $body -> angle
    regexp {/CapHeight (\S+)} $body -> cap
    regexp {/Flags (\S+)} $body -> flag
    lappend angles $angle
    lappend caps [format %.0f $cap]
    lappend flags $flag
  }
  list $angles $caps $flags
} -result {{0 -12} {729 729} {4 68}}

test font-11.2 {StemV follows the weight, and for an instance the wght axis} -body {
  # TrueType has no stem width; the estimate is 50 + (usWeightClass / 65)^2,
  # which tFPDF and mPDF write - 87 at 400, 165 at 700. For an instance of a
  # variable face the wght axis is the weight class, so Bold out of the
  # variable Roboto says 165 where the file's own OS/2 says 400. Roboto's
  # sCapHeight is 1456 of 2048, 711 in the descriptor.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed regular [variableTree Roboto-Regular.ttf]
  $doc font embed bold [variableTree Roboto-Variable.ttf] -instance Bold
  $doc text "Rechnung" -at {20 20} -family regular
  $doc text "Rechnung" -at {20 40} -family bold
  set path [::tclpdfTest::scratch font-stemv.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set stems {}
  set caps {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/StemV (\S+)} $body -> stem
    regexp {/CapHeight (\S+)} $body -> cap
    lappend stems $stem
    lappend caps [format %.0f $cap]
  }
  list $stems $caps
} -result {{87 165} {711 711}}

test font-11.3 {head and /FontBBox of an instance describe the moved face, of a plain subset the file} -constraints haveFont -body {
  # Table 122: FontBBox is the box of ALL glyphs of the font at one origin,
  # and for an instance the font is the moved face - the file's box describes
  # outlines that were left behind. Roboto at wght 900 reaches 2483 units to
  # the right where the file says 2353 (varFont bounds); both the subset's
  # head table and the descriptor have to say 2483, in units and in
  # thousandths of an em, and agree with each other. A face embedded as it
  # came keeps the file's box in both places, byte for byte in head - a
  # subset's box is the whole face's, as before.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed black [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed plain $fontRegular
  $doc text "Hamburgefonstiv" -at {20 30} -family black
  $doc text "Hamburgefonstiv" -at {20 50} -family plain
  set path [::tclpdfTest::scratch font-bbox.pdf]
  $doc write $path
  set writer [$doc writer]
  set boxes {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/Type /FontDescriptor*} $body]} {
      regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
      regexp {/FontBBox \[([^\]]*)\]} $body -> box
      regexp {/FontFile2 (\d+) 0 R} $body -> fileNumber
      set embedded [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
      set head [::tclpdf::sfnt table $embedded head]
      binary scan $head @36SSSS xMin yMin xMax yMax
      dict set boxes $name [list $box [list $xMin $yMin $xMax $yMax] \
          [dict get $embedded unitsPerEm]]
    }
  }
  $doc destroy
  file delete $path
  package require tclpdf::varFont
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  set moved [::tclpdf::varFont bounds [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 900}]]]
  set plain [::tclpdf::sfnt read $fontRegular]
  set result {}
  foreach name {Roboto-Black DejaVuSans} expected [list $moved [dict get $plain bbox]] {
    lassign [dict get $boxes $name] box head units
    set scaled [lmap value $head {format %.5g [expr {$value * 1000.0 / $units}]}]
    lappend result [expr {$head eq $expected}] \
        [expr {[lmap value $box {format %.5g $value}] eq $scaled}]
  }
  list $result [lindex [dict get $boxes Roboto-Black] 1] \
      [expr {$moved ne [dict get $original bbox]}] \
      [format %.0f [lindex [dict get $boxes Roboto-Black] 0 2]]
} -result {{1 1 1 1} {-1476 -555 2483 2163} 1 1212}

test font-11.4 {hhea of an instance summarises the moved face, of a plain subset the file} -constraints haveFont -body {
  # The four summary fields at hhea offset 10 - advanceWidthMax,
  # minLeftSideBearing, minRightSideBearing, xMaxExtent (ISO/IEC 14496-22
  # "hhea") - describe the glyphs of the file, and for an instance the file
  # carries the moved glyphs: Roboto at wght 900 has an advance of 2475 and an
  # extent of 2483 where the file says 2378 and 2353 (varFont hheaMetrics).
  # The embedded subset has to say what the instancer computed, and its
  # numberOfHMetrics has to match its glyph count still. A face embedded as
  # it came keeps the file's four fields byte for byte.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed black [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed plain $fontRegular
  $doc text "Hamburgefonstiv" -at {20 30} -family black
  $doc text "Hamburgefonstiv" -at {20 50} -family plain
  set path [::tclpdfTest::scratch font-hhea.pdf]
  $doc write $path
  set writer [$doc writer]
  set summaries {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/Type /FontDescriptor*} $body]} {
      regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
      regexp {/FontFile2 (\d+) 0 R} $body -> fileNumber
      set embedded [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
      set hhea [::tclpdf::sfnt table $embedded hhea]
      binary scan $hhea @10SuSSS advance left right extent
      binary scan $hhea @34Su metrics
      dict set summaries $name [list [list $advance $left $right $extent] \
          [expr {$metrics == [dict get $embedded numGlyphs]}]]
    }
  }
  $doc destroy
  file delete $path
  package require tclpdf::varFont
  set original [::tclpdf::sfnt read [variableTree Roboto-Variable.ttf]]
  set moved [::tclpdf::varFont hheaMetrics [::tclpdf::varFont all $original \
      [::tclpdf::varFont coordinates $original {wght 900}]]]
  binary scan [::tclpdf::sfnt table $original hhea] @10SuSSS a b c d
  set fileRoboto [list $a $b $c $d]
  binary scan [::tclpdf::sfnt table [::tclpdf::sfnt read $fontRegular] hhea] @10SuSSS a b c d
  set filePlain [list $a $b $c $d]
  set result {}
  foreach name {Roboto-Black DejaVuSans} expected [list $moved $filePlain] {
    lassign [dict get $summaries $name] summary counted
    lappend result [expr {$summary eq $expected}] $counted
  }
  list $result [lindex [dict get $summaries Roboto-Black] 0] \
      [expr {$moved ne $fileRoboto}] $filePlain
} -result {{1 1 1 1} {2475 -1476 -472 2483} 1 {3838 -2090 -1455 3673}}

# A CID-keyed CFF face, built rather than found - the tree holds none, and the
# ones on this machine (Hiragino, in a macOS collection) may not be checked in.
#
# The mark of a CID font is the ROS operator (12 30) in the CFF Top DICT (TN
# 5176 section 18), so NimbusSans gets one: the operands "391 392 0" as
# shortints and the escaped operator go in front of - or, with "end", behind -
# the first Top DICT, the Top DICT INDEX is rebuilt with offSize 4 and shifted
# offsets, and the CFF table is appended to the sfnt under a corrected
# directory entry. The Top DICT's own offsets into the CFF (charset,
# CharStrings, Private) are NOT moved, so the result is a font that parses up
# to its Top DICT and no further - which is exactly as far as the package
# reads, and all the case needs.
proc fontMakeCidKeyed {source target {where front}} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables "CFF "] position length
  set cff [string range $bytes $position [expr {$position + $length - 1}]]
  binary scan $cff @2cu hdrSize
  # Name INDEX: walk past it.
  set at $hdrSize
  binary scan $cff @${at}Su count
  binary scan $cff @[expr {$at + 2}]cu offSize
  set at [expr {$at + 3}]
  binary scan $cff @[expr {$at + $count * $offSize}]cu$offSize digits
  set last 0
  foreach digit $digits {
    set last [expr {$last * 256 + $digit}]
  }
  set topAt [expr {$at + ($count + 1) * $offSize - 1 + $last}]
  # Top DICT INDEX: read the items, prefix (or suffix) the first, rebuild.
  binary scan $cff @${topAt}Su count
  binary scan $cff @[expr {$topAt + 2}]cu offSize
  set at [expr {$topAt + 3}]
  set offsets {}
  for {set index 0} {$index <= $count} {incr index} {
    binary scan $cff @[expr {$at + $index * $offSize}]cu$offSize digits
    set value 0
    foreach digit $digits {
      set value [expr {$value * 256 + $digit}]
    }
    lappend offsets $value
  }
  set data [expr {$at + ($count + 1) * $offSize - 1}]
  set items {}
  for {set index 0} {$index < $count} {incr index} {
    lappend items [string range $cff [expr {$data + [lindex $offsets $index]}] \
        [expr {$data + [lindex $offsets $index+1] - 1}]]
  }
  set ros [binary format cuSucuSucucucu 28 391 28 392 139 12 30]
  if {$where eq "front"} {
    lset items 0 $ros[lindex $items 0]
  } else {
    lset items 0 [lindex $items 0]$ros
  }
  set rebuilt [binary format Sucu $count 4]
  set offset 1
  append rebuilt [binary format Iu $offset]
  foreach item $items {
    incr offset [string length $item]
    append rebuilt [binary format Iu $offset]
  }
  append rebuilt {*}$items
  set end [expr {$data + [lindex $offsets end]}]
  set cff [string range $cff 0 [expr {$topAt - 1}]]$rebuilt[string range $cff $end end]
  # Back into the sfnt: appended at the end, directory entry moved there.
  set pad [expr {(4 - [string length $bytes] % 4) % 4}]
  append bytes [string repeat \0 $pad]
  set newPosition [string length $bytes]
  append bytes $cff
  binary scan $bytes @4Su numTables
  for {set index 0} {$index < $numTables} {incr index} {
    set entry [expr {12 + $index * 16}]
    if {[string range $bytes $entry [expr {$entry + 3}]] eq "CFF "} {
      set bytes [string replace $bytes [expr {$entry + 8}] [expr {$entry + 15}] \
          [binary format IuIu $newPosition [string length $cff]]]
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-12.1 {a name-keyed CFF face is read as one, and embeds} -constraints haveOtf -body {
  # The regression side: NimbusSans carries no ROS, and font-8.1 already
  # writes it. Here the flag itself is asserted, so that the detection cannot
  # drift towards refusing everything.
  set parsed [::tclpdf::sfnt read $::otf]
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc font embed haus $::otf} result]
  $doc destroy
  list [dict get $parsed outlines] [dict get $parsed cidKeyed] $code $result
} -result {cff 0 0 haus}

test font-12.2 {a ROS in the Top DICT marks the face CID-keyed} -constraints haveOtf -body {
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed.otf]]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  list [dict get $parsed outlines] [dict get $parsed cidKeyed]
} -result {cff 1}

test font-12.3 {a CID-keyed CFF face is refused at embed time, by name} -constraints haveOtf -body {
  # ISO 32000-1 9.7.4.2: with a CID-keyed program the CID goes through the
  # program's charset, and this package addresses glyphs by index. Refused
  # where the file is handed over, not at write time, and before anything is
  # entered under the alias.
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed.otf]]
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc font embed haus $path} result]
  set names [$doc font names]
  $doc destroy
  file delete $path
  list $code $result $names
} -result [list 1 "tclpdf: \"cid-keyed.otf\" is a CID-keyed CFF font, which\
    tclpdf cannot embed - its glyphs would be addressed by CID, not by glyph\
    index; convert it to TrueType or to a name-keyed CFF" {}]

test font-12.4 {the ROS is found behind the other operators as well} -constraints haveOtf -body {
  # The spec puts ROS first; the walk does not rely on that. Behind every
  # other operand of NimbusSans' Top DICT the walker has to have skipped each
  # one by its own encoding to arrive at the operator at all.
  set path [fontMakeCidKeyed $::otf [::tclpdfTest::scratch cid-keyed-end.otf] end]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  dict get $parsed cidKeyed
} -result 1

test font-12.5 {an OTTO file without a CFF table is refused} -constraints haveOtf -body {
  # The signature promises outlines in that table and nowhere else. Relabelled
  # in the directory, so that everything else about the file stays valid.
  set bytes [::tclpdfTest::readBytes $::otf]
  binary scan $bytes @4Su numTables
  for {set index 0} {$index < $numTables} {incr index} {
    set entry [expr {12 + $index * 16}]
    if {[string range $bytes $entry [expr {$entry + 3}]] eq "CFF "} {
      set bytes [string replace $bytes $entry [expr {$entry + 3}] "CFFx"]
    }
  }
  catch {::tclpdf::sfnt parse $bytes} result
  set result
} -result {tclpdf: the font has no "CFF " table and cannot be embedded}

# How many WinAnsi advances of a face equal the AFM of the standard face it
# stands in for - within half a unit at 1000/em - and which characters differ.
proc metricMatch {path std} {
  set font [::tclpdf::sfnt read $path]
  set upem [dict get $font unitsPerEm]
  set cmap [dict get $font cmap]
  set equal 0
  set differ {}
  # Every mapped WinAnsi position, 32..255: an unmapped one (127, 129, 141,
  # 143, 144, 157) has no width in the metrics and is skipped by that; 160
  # and 173 are the second codes of space and hyphen (Annex D) and are not
  # counted twice; the 25 positions of 128..159 - euro, the quotation marks,
  # the ellipsis, the per mille - count like the rest. That makes 216 per
  # face, the same yardstick as the URW measurement (2592 = 12 x 216).
  for {set code 32} {$code < 256} {incr code} {
    if {$code == 160 || $code == 173} continue
    # The width first: an unmapped position has none, and Tcl 9 refuses to
    # decode 0x81 as cp1252 at all.
    if {[catch {::tclpdf::afm width $std $code} width] || $width == 0} continue
    set char [encoding convertfrom cp1252 [binary format c $code]]
    set cp [scan $char %c]
    if {![dict exists $cmap $cp]} {
      lappend differ [format U+%04X $cp]
      continue
    }
    set advance [expr {[::tclpdf::sfnt advance $font [dict get $cmap $cp]] * 1000.0 / $upem}]
    if {abs($advance - $width) < 0.5} {
      incr equal
    } else {
      lappend differ [format U+%04X $cp]
    }
  }
  return [list $equal $differ]
}

test font-13.1 {Liberation Sans, Serif and Mono match the standard faces' advances except for five symbols} \
    -constraints haveLiberation -body {
  # The claim the manual makes under the standard-14 table, pinned: 2555 of
  # 2592 WinAnsi advances equal (216 per face, the same count as for URW),
  # and what differs is the handful of symbols where Arial and Times New
  # Roman never were Helvetica and Times - macron, plus-minus, micro sign,
  # middle dot, division sign (U+00AF U+00B1 U+00B5 U+00B7 U+00F7); the mono
  # faces match Courier completely. Measured 2026-08-17 on release 2.1.5 and
  # again 2026-08-18 over all 216 positions (it used to skip 128..159 and
  # count 191); a newer release that moves a width shows up here first.
  set five {U+00AF U+00B1 U+00B5 U+00B7 U+00F7}
  set result {}
  set total 0
  foreach {file std} {
    LiberationSans-Regular.ttf Helvetica LiberationSans-Bold.ttf Helvetica-Bold
    LiberationSans-Italic.ttf Helvetica-Oblique LiberationSans-BoldItalic.ttf Helvetica-BoldOblique
    LiberationSerif-Regular.ttf Times-Roman LiberationSerif-Bold.ttf Times-Bold
    LiberationSerif-Italic.ttf Times-Italic LiberationSerif-BoldItalic.ttf Times-BoldItalic
    LiberationMono-Regular.ttf Courier LiberationMono-Bold.ttf Courier-Bold
    LiberationMono-Italic.ttf Courier-Oblique LiberationMono-BoldItalic.ttf Courier-BoldOblique
  } {
    lassign [metricMatch [file join $::liberation $file] $std] equal differ
    incr total $equal
    set outside {}
    foreach cp $differ {
      if {$cp ni $five} {lappend outside $cp}
    }
    lappend result [list $equal $outside]
  }
  list $total $result
} -result {2555 {{211 {}} {211 {}} {211 {}} {211 {}} {211 {}} {211 {}} {212 {}} {213 {}} {216 {}} {216 {}} {216 {}} {216 {}}}}

test font-13.2 {a Liberation face embeds and sets text under PDF/A} -constraints {haveLiberation haveTdom} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed lib [file join $::liberation LiberationSerif-Regular.ttf]
  $doc font -family lib -size 11
  $doc text "Liberation Serif in place of Times" -at {20 30}
  $doc pdfa -part 3 -conformance U
  lassign [::tclpdfTest::writes $doc font-liberation.pdf] code written
  set family [dict get [$doc font info lib] family]
  $doc destroy
  list $code $written $family
} -result {0 1 {Liberation Serif}}

# --- the standard faces through [font] --------------------------------------
#
# The resolved name is what the state reports and what /Tf names in the
# stream, so a family, a style or a PostScript name that resolves wrongly is
# visible in both places.

test font-14.1 {-family courier and symbol resolve to their standard names} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set courier [dict get [$doc font -family courier -size 10] resolved]
  $doc text "fixed" -at {20 20}
  set symbol [dict get [$doc font -family symbol] resolved]
  $doc text "abg" -at {20 30}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $courier $symbol [regexp {/FCourier 10 Tf} $content] \
      [regexp {/FSymbol 10 Tf} $content]
} -result {Courier Symbol 1 1}

test font-14.2 {-family takes a PostScript name outright} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set state [$doc font -family Times-Italic -size 11]
  $doc text "cursive" -at {20 20}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [dict get $state family] [dict get $state resolved] \
      [regexp {/FTimesItalic 11 Tf} $content]
} -result {Times-Italic Times-Italic 1}

test font-14.3 {-style italic, {bold italic} and oblique pick the variant} -body {
  set doc [tclpdf new -unit mm]
  set names {}
  foreach {family style} {times italic times {bold italic} helvetica oblique
      helvetica {bold oblique} courier {italic bold}} {
    lappend names [dict get [$doc font -family $family -style $style] resolved]
  }
  $doc destroy
  set names
} -result {Times-Italic Times-BoldItalic Helvetica-Oblique Helvetica-BoldOblique Courier-BoldOblique}

test font-14.4 {-rise on the font state reaches every line until it is reset} -body {
  # -rise is a state option: set once, it lifts every line drawn afterwards,
  # and setting it back to 0 takes the operator out of the stream again.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica -size 10 -rise 3
  $doc text "one" -at {20 20}
  $doc text "two" -at {20 30}
  $doc font -rise 0
  $doc text "three" -at {20 40}
  set content [::tclpdfTest::content $doc]
  set state [$doc font]
  $doc destroy
  list [regexp -all {3 Ts} $content] [dict get $state rise]
} -result {2 0}

test font-14.5 {font info answers postScript, unitsPerEm, characters and permission} \
    -constraints haveFont -body {
  # The four keys as [font info] hands them out, not as the parser holds them:
  # 5.2 reads family, fsType and glyphs, and font-1.1 reads the parser.
  set doc [tclpdf new]
  $doc font embed haus $fontRegular
  set info [$doc font info haus]
  $doc destroy
  list [dict get $info postScript] [dict get $info unitsPerEm] \
      [expr {[dict get $info characters] > 1000}] \
      [string range [dict get $info permission] 0 10]
} -result {DejaVuSans 2048 1 installable}

test font-14.6 {font info on a Type 1 face states that it has no fsType} \
    -constraints haveType1 -body {
  set doc [tclpdf new]
  $doc font embed t1 $type1Face
  set info [$doc font info t1]
  $doc destroy
  list [dict get $info postScript] [dict get $info unitsPerEm] \
      [dict get $info fsType] [string match {*Type 1 has no fsType*} \
      [dict get $info permission]] [expr {[dict get $info characters] > 100}]
} -result {OCRB 1000 {} 1 1}

test font-15.1 {two aliases that differ only in a space are two resources and two faces} \
    -constraints haveFont -body {
  # The resource name used to be the alias with its spaces stripped, so "a b"
  # and "ab" were one resource: the second face never got a font object and
  # its glyph numbers were drawn through the first face's CIDToGIDMap. Read
  # off the file: two Tf names, two FontDescriptors, and every glyph of the
  # second alias mapped in the ToUnicode CMap of its own object.
  set roboto [file join [file dirname $fontRegular] google Roboto-Regular.ttf]
  if {![file exists $roboto]} {
    set roboto $fontRegular
  }
  set doc [tclpdf new -unit pt -format {400 200}]
  $doc page add
  $doc font embed "a b" $fontRegular
  $doc font embed "ab" $roboto
  $doc font -family "a b" -size 24
  $doc text "DejaVu" -at {10 50}
  $doc font -family "ab" -size 24
  $doc text "Roboto" -at {10 100}
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch alias-space.pdf]
  $doc write $path
  set fonts [$doc state fonts]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [lsort -unique [regexp -all -inline {/FE[^ ]+ 24 Tf} $content]] \
      [regexp -all {/Type /FontDescriptor} $bytes] \
      [expr {[dict get $fonts {a b} number] != [dict get $fonts ab number]}]
} -result {{{/FEa#20b 24 Tf} {/FEab 24 Tf}} 2 1}

test font-15.2 {the resource name carries the alias, escaped, and is the same on every write} \
    -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed "Haus Schrift/1" $fontRegular
  $doc font -family "Haus Schrift/1" -size 10
  $doc text "x" -at {20 20}
  set content [::tclpdfTest::content $doc]
  lassign [::tclpdfTest::writeTwice $doc alias-escape] first second
  $doc destroy
  list [regexp {/FEHaus#20Schrift#2F1 10 Tf} $content] [string equal $first $second] \
      [regexp {/Font << /FEHaus#20Schrift#2F1 \d+ 0 R >>} $first]
} -result {1 1 1}

test font-15.3 {-subset takes a boolean, and says so at embed time} -constraints haveFont -body {
  # It used to be taken as given and to fail at write time - in an "if"
  # nowhere near the call that set it. Refused at the call, and refused
  # before anything is kept: the alias is not embedded afterwards.
  set doc [tclpdf new]
  set code [catch {$doc font embed haus $fontRegular -subset abc} message]
  set names [$doc font names]
  $doc font embed haus $fontRegular -subset no
  set kept [dict get [$doc state fonts] haus subset]
  $doc destroy
  list $code [string match {*-subset takes a boolean, not "abc"*} $message] $names $kept
} -result {1 1 {} no}

test font-15.4 {-metrics belongs to Type 1 and -axes/-instance to a variable face - the other way round is refused} \
    -constraints {haveFont haveType1} -body {
  # The manual promises -axes on a face without fvar is refused rather than
  # ignored; a Type 1 program was the gap, and -metrics on a TrueType face
  # the mirror image of it. Both are refused at the call, and the alias is
  # not embedded.
  set doc [tclpdf new]
  set metrics [catch {$doc font embed a $fontRegular -metrics [file rootname $type1Face].afm} m1]
  set axes [catch {$doc font embed b $type1Face -axes {wght 700}} m2]
  set instance [catch {$doc font embed c $type1Face -instance Bold} m3]
  set names [$doc font names]
  $doc destroy
  list $metrics [string match {*-metrics names the AFM of a Type 1*DejaVuSans.ttf*} $m1] \
      $axes [string match {*OCRB.pfb*is a Type 1 font program, which has no axes*} $m2] \
      $instance [string match {*is a Type 1 font program, which has no axes*} $m3] $names
} -result {1 1 1 1 1 1 {}}

test font-15.5 {an axis value outside the fvar range is refused with the range, not clamped in silence} -body {
  # The normalisation clamps, so the outlines of wght 5000 were those of 900
  # - but the name said Roboto_5000wght and StemV was 5967. Refused at the
  # call with the range; the ends of the range themselves are on the axis
  # and go through, and so does a named instance.
  set doc [tclpdf new]
  set high [catch {$doc font embed a [variableTree Roboto-Variable.ttf] -axes {wght 5000}} m1]
  set low [catch {$doc font embed b [variableTree Roboto-Variable.ttf] -axes {wdth 74.9}} m2]
  $doc font embed c [variableTree Roboto-Variable.ttf] -axes {wght 900}
  $doc font embed d [variableTree Roboto-Variable.ttf] -axes {wght 100 wdth 75}
  $doc font embed e [variableTree Roboto-Variable.ttf] -instance Bold -axes {wdth 100}
  set names [$doc font names]
  $doc destroy
  list $high [string match {*value 5000 for axis "wght" is outside its range in "Roboto-Variable.ttf" - wght runs from 100 to 900 (default 400)*} $m1] \
      $low [string match {*value 74.9 for axis "wdth"*wdth runs from 75 to 100*} $m2] $names
} -result {1 1 1 1 {c d e}}

test font-15.6 {a slnt or ital instance is an italic face in the descriptor} -body {
  # Bitcount's slnt axis runs -8 .. 0: at -8 the outlines lean, and the
  # descriptor used to say ItalicAngle 0 and Flags 4 all the same. The slnt
  # value is the angle (both count degrees counter-clockwise from the
  # vertical), and the italic flag (Table 123 bit 7) comes with it; a weight
  # instance of the same file stays upright.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed slanted [variableTree BitcountPropSingle-Variable.ttf] -axes {slnt -8 wght 700}
  $doc font embed upright [variableTree BitcountPropSingle-Variable.ttf] -axes {wght 700}
  $doc text "Bitcount" -at {20 20} -family slanted
  $doc text "Bitcount" -at {20 40} -family upright
  set path [::tclpdfTest::scratch font-slant.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set found {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
    regexp {/ItalicAngle (\S+)} $body -> angle
    regexp {/Flags (\S+)} $body -> flag
    dict set found $name [list $angle $flag]
  }
  set found
} -result {BitcountPropSingle_700wght_-8slnt {-8 68} BitcountPropSingle_700wght {0 4}}

test font-15.7 {CapHeight without sCapHeight is the top of the H, not the ascender} \
    -constraints haveFont -body {
  # DejaVu Sans carries OS/2 version 1, which has no sCapHeight, and the
  # descriptor wrote the ascender: 928 for a cap height that measures 729
  # (yMax of the H, 1493 of 2048 units). Roboto has version 4 and keeps its
  # own field, 711, which 11.2 pins - here as the control that the fallback
  # does not reach past the field.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed dejavu $fontRegular
  $doc font embed roboto [variableTree Roboto-Regular.ttf]
  $doc text "H" -at {20 20} -family dejavu
  $doc text "H" -at {20 40} -family roboto
  set path [::tclpdfTest::scratch font-capheight.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  set found {}
  foreach {- body} [regexp -all -inline {(/Type /FontDescriptor[^>]*)>>} $bytes] {
    regexp {/FontName /[A-Z]{6}\+(\S+)} $body -> name
    regexp {/CapHeight (\S+)} $body -> cap
    regexp {/Ascent (\S+)} $body -> ascent
    dict set found $name [list [format %.0f $cap] [expr {$cap < $ascent}]]
  }
  set found
} -result {DejaVuSans {729 1} Roboto-Regular {711 1}}

test font-15.8 {the Type 0 name of a CFF face carries the CMap name, as 9.7.6.1 asks} \
    -constraints {haveOtf haveFont} -body {
  # For a CIDFontType0 descendant the Type 0 font's BaseFont should be the
  # descendant's name, a hyphen and the CMap name: NimbusSans-Regular-Identity-H
  # on the Type 0 font, NimbusSans-Regular on the CIDFont and the descriptor.
  # A TrueType face (CIDFontType2) keeps one name in all three places.
  set doc [tclpdf new]
  $doc page add
  $doc font embed cff $::otf
  $doc font embed ttf $fontRegular
  $doc text "Rechnung" -at {20 20} -family cff
  $doc text "Rechnung" -at {20 40} -family ttf
  set path [::tclpdfTest::scratch font-type0-name.pdf]
  $doc write $path
  set writer [$doc writer]
  set found {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[regexp {/Subtype /(Type0|CIDFontType0|CIDFontType2)\y.*/BaseFont /(\S+)} $body -> kind name]} {
      lappend found $kind [regsub {^[A-Z]{6}\+} $name {}]
    }
  }
  $doc destroy
  file delete $path
  set pairs {}
  foreach {kind name} $found {
    lappend pairs "$kind $name"
  }
  lsort $pairs
} -result {{CIDFontType0 NimbusSans-Regular} {CIDFontType2 DejaVuSans} {Type0 DejaVuSans} {Type0 NimbusSans-Regular-Identity-H}}

test font-15.9 {permission reads the subsetting and bitmap bits, and knows an absent OS/2} \
    -constraints haveFont -body {
  # fsType 0x0100 forbids subsetting and 0x0200 allows bitmap embedding only
  # (OpenType OS/2); read as the low nibble alone both answered "installable".
  # A face without an OS/2 table has stated nothing - the subset this package
  # writes is such a face - and that is "unknown", not 0.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "H" -at {20 20} -family haus
  set path [::tclpdfTest::scratch font-fstype.pdf]
  $doc write $path
  set writer [$doc writer]
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[regexp {/FontFile2 (\d+) 0 R} [$writer body $number] -> fileNumber]} {
      set subset [::tclpdf::sfnt parse [::tclpdfTest::streamOf $writer $fileNumber]]
    }
  }
  $doc destroy
  file delete $path
  list [::tclpdf::sfnt permission 0x0100] [::tclpdf::sfnt permission 0x0208] \
      [::tclpdf::sfnt permission 0x0304] [dict get $subset fsType] \
      [::tclpdf::sfnt permission [dict get $subset fsType]]
} -result {{installable - no restriction on embedding; no subsetting (bit 8)} {editable; bitmap embedding only (bit 9)} {preview and print only; no subsetting (bit 8); bitmap embedding only (bit 9)} {} {unknown - the face has no OS/2 table and states no permission}}

test font-15.10 {font info names an instance of a variable face as it is embedded} -body {
  # Measured before this: -instance Bold and -axes {wght 620} both answered
  # Roboto-Regular - name id 6, which names the file's default. The name a
  # reader sees is the instance's (TN 5902), and font info answers that one.
  set doc [tclpdf new -unit mm]
  $doc page add
  set names {}
  foreach {alias options} {bold {-instance Bold} between {-axes {wght 620}}
      plain {}} {
    $doc font embed $alias [variableTree Roboto-Variable.ttf] {*}$options
    lappend names [dict get [$doc font info $alias] postScript]
  }
  $doc destroy
  set names
} -result {Roboto-Bold Roboto_620wght Roboto-Regular}

# Damaged and norm-breaking cmaps, built rather than found (the platform 0
# name fixture above sets the pattern): DejaVu carries a format 12 subtable
# as (3,10) and (0,10) - both records point at the same table, and (3,10) is
# the one the parser prefers - so the fixtures patch that table in place.
proc fontPatchCmap12 {source target patches} {
  set channel [open $source rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables cmap] cmapAt -
  binary scan $bytes @[expr {$cmapAt + 2}]Su count
  set table -1
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$cmapAt + 4 + $index * 8}]
    binary scan $bytes @${at}SuSuIu platform encoding offset
    if {$platform == 3 && $encoding == 10} {
      set table [expr {$cmapAt + $offset}]
    }
  }
  foreach patch $patches {
    switch -- [lindex $patch 0] {
      ngroups {
        set bytes [string replace $bytes [expr {$table + 12}] \
            [expr {$table + 15}] [binary format Iu [lindex $patch 1]]]
      }
      group {
        lassign $patch - group start end glyph
        set at [expr {$table + 16 + $group * 12}]
        set bytes [string replace $bytes $at [expr {$at + 11}] \
            [binary format IuIuIu $start $end $glyph]]
      }
    }
  }
  set channel [open $target wb]
  puts -nonewline $channel $bytes
  close $channel
  return $target
}

test font-16.1 {a format 12 group that ends before it starts is refused by name} \
    -constraints haveFont -body {
  # Group 0 of DejaVu maps 0x20..0x7E; turned around it becomes damage the
  # old loop silently skipped (an empty for loop) - accepting a font whose
  # character map lies about itself.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-turned.ttf] {{group 0 0x20 0x1F 3}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 0 ends (0x1F) before it starts (0x20)}}

test font-16.2 {a format 12 group ending at 0xFFFFFFFF is refused at once, not iterated} \
    -constraints haveFont -body {
  # The case that made the check necessary: end is read as an unsigned
  # 32-bit value, and 0xFFFFFFFF sent the inner loop into four billion
  # iterations - font embed hung instead of refusing. The elapsed time is
  # part of the assertion: a refusal that takes minutes is still a hang.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-huge.ttf] {{group 0 0x20 0xFFFFFFFF 3}}]
  set before [clock milliseconds]
  set code [catch {::tclpdf::sfnt read $path} message]
  set elapsed [expr {[clock milliseconds] - $before}]
  file delete $path
  list $code $message [expr {$elapsed < 1000}]
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 0 ends at 0xFFFFFFFF, beyond the last Unicode code point 0x10FFFF} 1}

test font-16.3 {a format 12 group just past the last code point is refused, not mapped} \
    -constraints haveFont -body {
  # The small-overshoot twin of 16.2, and the one that keeps the bound
  # honest: without the check this group maps four code points beyond
  # Unicode and the font parses - a wrong acceptance a test can see without
  # hanging the suite, where removing the check under 16.2 would.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-past.ttf] {{group 280 0x10FFFE 0x110001 3}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -result {1 {tclpdf: the cmap table is damaged - format 12 group 280 ends at 0x110001, beyond the last Unicode code point 0x10FFFF}}

test font-16.4 {a format 12 group count past the end of the file is refused before the loop} \
    -constraints haveFont -body {
  # nGroups steers the outer loop; 0x10000000 groups would ask for 3 GB of
  # table. Without the check the loop runs until binary scan falls off the
  # end of the file and dies with a raw Tcl error instead of a refusal.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-count.ttf] {{ngroups 0x10000000}}]
  set code [catch {::tclpdf::sfnt read $path} message]
  file delete $path
  list $code $message
} -match glob -result {1 {tclpdf: the cmap table is damaged - format 12 declares 268435456 groups where only * bytes follow}}

test font-16.5 {the checks cost the intact face nothing - DejaVu still embeds} \
    -constraints haveFont -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontRegular
  $doc text "Grusse" -at {20 20} -family haus
  set path [::tclpdfTest::scratch cmap12-intact.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp -all {/BaseFont /[A-Z]{6}\+DejaVuSans\y} $bytes
} -result 2

test font-16.6 {a format 12 cmap entry on a surrogate code point never enters the map} \
    -constraints haveFont -body {
  # OpenType forbids surrogate code points in a cmap, but a norm-breaking
  # font can carry one - and passed through it became a lone surrogate in
  # the ToUnicode CMap (ISO 32000-2 9.10.3 requires well-formed UTF-16BE).
  # Group 3 of DejaVu is a single-code group (U+02F3), rebuilt here as a
  # single-code group on U+D800 pointing at a real glyph.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 36}}]
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set cmap [dict get $parsed cmap]
  # 55296 is 0xD800 as the map keys it; 65 -> 36 is the positive control
  # proving the probe reads the map that would have carried the entry.
  list [dict exists $cmap 55296] [dict get $cmap 65]
} -result {0 36}

test font-16.7 {a surrogate is "no glyph" at setting time - the refusal contract holds} \
    -constraints haveFont -body {
  # The character counts as absent, so setting it refuses with the same
  # errorCode as any missing glyph - the contract from the manual's "Error
  # codes" section survives the norm-breaking font.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 36}}]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  set code [catch {$doc text [format %c 0xD800] -at {20 20} -family haus} \
      message options]
  $doc destroy
  file delete $path
  list $code [lrange [dict get $options -errorcode] 0 3]
} -result {1 {TCLPDF FONT GLYPH U+D800}}

test font-16.8 {the ToUnicode CMap of the written file carries no lone surrogate} \
    -constraints haveFont -body {
  # The end the norm cares about: the file. The surrogate is ATTEMPTED (its
  # own glyph, 37, so a leak would write its own bfchar) and the written
  # ToUnicode CMap maps A - the positive control proving the probe reads the
  # right stream - while holding no <D800> target anywhere.
  set path [fontPatchCmap12 $fontRegular \
      [::tclpdfTest::scratch cmap12-surrogate.ttf] {{group 3 0xD800 0xD800 37}}]
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $path
  $doc text "A" -at {20 20} -family haus
  catch {$doc text [format %c 0xD800] -at {20 30} -family haus}
  set glyphA [dict get [$doc state fonts] haus parsed cmap 65]
  set pdf [::tclpdfTest::scratch cmap12-surrogate.pdf]
  $doc write $pdf
  set writer [$doc writer]
  set toUnicodeNumber {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[regexp {/ToUnicode (\d+) 0 R} [$writer body $number] -> found]} {
      set toUnicodeNumber $found
    }
  }
  set toUnicode [::tclpdfTest::streamOf $writer $toUnicodeNumber]
  $doc destroy
  file delete $pdf $path
  list [regexp "<[format %04X $glyphA]> <0041>" $toUnicode] \
      [regexp -nocase {<D800>} $toUnicode]
} -result {1 0}

test font-16.9 {a format 4 cmap entry on a surrogate code point never enters the map} \
    -constraints haveFont -body {
  # The same door in the other format: format 4 is BMP-only and can carry
  # D800-DFFF just as well. DejaVu's format 12 records are demoted to an
  # unknown platform so the (3,1) format 4 table is the one chosen, and its
  # last PUA segment is rebuilt as a single-code segment on U+D800 with a
  # delta pointing at a real glyph.
  set channel [open $fontRegular rb]
  set bytes [read $channel]
  close $channel
  set parsed [::tclpdf::sfnt parse $bytes]
  lassign [dict get $parsed tables cmap] cmapAt -
  binary scan $bytes @[expr {$cmapAt + 2}]Su count
  set table -1
  for {set index 0} {$index < $count} {incr index} {
    set at [expr {$cmapAt + 4 + $index * 8}]
    binary scan $bytes @${at}SuSuIu platform encoding offset
    if {$encoding == 10} {
      # Out of the running: platform 5 scores below every Unicode record.
      set bytes [string replace $bytes $at [expr {$at + 1}] \
          [binary format Su 5]]
    } elseif {$platform == 3 && $encoding == 1} {
      set table [expr {$cmapAt + $offset}]
    }
  }
  binary scan $bytes @[expr {$table + 6}]Su segCountX2
  set endBase [expr {$table + 14}]
  set startBase [expr {$endBase + $segCountX2 + 2}]
  set deltaBase [expr {$startBase + $segCountX2}]
  set rangeBase [expr {$deltaBase + $segCountX2}]
  for {set segment 0} {$segment < $segCountX2 / 2} {incr segment} {
    set two [expr {$segment * 2}]
    binary scan $bytes @[expr {$startBase + $two}]Su start
    if {$start >= 0xE000 && $start != 0xFFFF} {
      foreach {base value} [list $endBase 0xD800 $startBase 0xD800 \
          $deltaBase [expr {(36 - 0xD800) & 0xFFFF}] $rangeBase 0] {
        set bytes [string replace $bytes [expr {$base + $two}] \
            [expr {$base + $two + 1}] [binary format Su $value]]
      }
      break
    }
  }
  set path [::tclpdfTest::scratch cmap4-surrogate.ttf]
  set channel [open $path wb]
  puts -nonewline $channel $bytes
  close $channel
  set parsed [::tclpdf::sfnt read $path]
  file delete $path
  set cmap [dict get $parsed cmap]
  # Without the skip, D800 maps to (0xD800 + delta) & 0xFFFF = 36. The
  # positive control 65 -> 36 proves the format 4 table is the one read.
  list [dict exists $cmap 55296] [dict get $cmap 65]
} -result {0 36}

cleanupTests

# attach.test --
#
# Embedded files. The byte-identity test is the one that matters: an
# attachment quietly rewritten on the way in still passes every validator,
# because none of them compares it against the original.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::attach
source [file join [file dirname [info script]] helper.tcl]

# Content with CRLF, a NUL and a byte above 127 - everything a channel left on
# the wrong translation would mangle.
set attachSample [binary format H* 0d0a00ff41420d0a]

test attach-1.1 {an attachment is listed by name} -body {
  set doc [tclpdf new]
  $doc page add
  $doc attach -data $attachSample -name daten.bin
  set names [$doc attachments]
  $doc destroy
  set names
} -result daten.bin

test attach-1.2 {several attachments per document} -body {
  # 4 of the 61 official reference PDFs carry more than one; the browser route
  # this replaces cannot do it at all.
  set doc [tclpdf new]
  $doc page add
  $doc attach -data a -name eins.txt
  $doc attach -data b -name zwei.txt
  $doc attach -data c -name drei.txt
  set names [$doc attachments]
  $doc destroy
  set names
} -result {eins.txt zwei.txt drei.txt}

test attach-1.3 {a duplicate name is refused} -body {
  set doc [tclpdf new]
  $doc page add
  $doc attach -data a -name gleich.txt
  try {
    $doc attach -data b -name gleich.txt
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*already exists*name tree*}

test attach-1.4 {an unknown relationship is refused} -body {
  set doc [tclpdf new]
  $doc page add
  try {
    $doc attach -data a -name x.txt -relationship Beilage
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*-relationship must be one of*Data*}

test attach-1.5 {a missing file is reported} -body {
  set doc [tclpdf new]
  $doc page add
  try {
    $doc attach [file join [temporaryDirectory] does-not-exist.xml]
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*does not exist*}

test attach-2.1 {bytes survive a round trip through a file, unchanged} -body {
  # CRLF, NUL and a high byte - read, embedded uncompressed, read back out of
  # the PDF.
  set source [::tclpdfTest::scratch attach-source.bin]
  ::tclpdf::io write $source $attachSample
  set path [::tclpdfTest::scratch attach-round.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach $source -name daten.bin -compress 0
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $source $path
  # The stream sits between "stream\n" and "\nendstream"
  set start [string first "stream\n" $bytes]
  set stop [string first "\nendstream" $bytes $start]
  set embedded [string range $bytes [expr {$start + 7}] [expr {$stop - 1}]]
  binary scan $embedded H* hex
  set hex
} -result 0d0a00ff41420d0a

test attach-2.2 {the name defaults to the file name} -body {
  set source [::tclpdfTest::scratch factur-x.xml]
  ::tclpdf::io write $source "<x/>"
  set doc [tclpdf new]
  $doc page add
  $doc attach $source
  set names [$doc attachments]
  $doc destroy
  file delete $source
  set names
} -result factur-x.xml

test attach-3.1 {Filespec, name tree and AF all appear} -body {
  set path [::tclpdfTest::scratch attach-structure.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data "<invoice/>" -name factur-x.xml -relationship Data \
      -mime text/xml -description "Rechnungsdaten"
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Type /EmbeddedFile} $bytes] \
      [regexp {/Type /Filespec} $bytes] \
      [regexp {/AFRelationship /Data} $bytes] \
      [regexp {/Names <</EmbeddedFiles|/EmbeddedFiles} $bytes] \
      [regexp {/AF \[} $bytes] \
      [regexp {/Subtype /text#2Fxml} $bytes]
} -result {1 1 1 1 1 1}

test attach-3.2 {AF points straight at the Filespec} -body {
  # Ghostscript puts a second level of indirection here, and qpdf and poppler
  # then cannot reach the invoice data even though the file validates.
  set path [::tclpdfTest::scratch attach-af.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data "<invoice/>" -name factur-x.xml -relationship Data
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/AF \[(\d+) 0 R\]} $bytes -> number
  regexp "(?n)^$number 0 obj\\n(.*)\$" $bytes -> body
  # The object /AF names must BE the Filespec, not something pointing at one.
  regexp {/Type /Filespec} $body
} -result 1

test attach-3.3 {the name tree is sorted} -body {
  # A reader may binary-search it (7.9.6); unsorted, it finds nothing.
  set path [::tclpdfTest::scratch attach-sorted.pdf]
  set doc [tclpdf new]
  $doc page add
  foreach name {zulu.txt alpha.txt mike.txt} {
    $doc attach -data x -name $name
  }
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/EmbeddedFiles << /Names \[(.*?)\] >>} $bytes -> tree
  set names {}
  foreach {name reference} [regexp -all -inline {\(([^)]*)\) (\d+ 0 R)} $tree] {
    # every third element is the captured name
  }
  regexp -all -inline {\(([^)]*)\)} $tree
} -result {(alpha.txt) alpha.txt (mike.txt) mike.txt (zulu.txt) zulu.txt}

test attach-3.4 {Params Size is the uncompressed length} -body {
  set path [::tclpdfTest::scratch attach-size.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data [string repeat "x" 5000] -name gross.txt -compress 1
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/Params << /Size (\d+) >>} $bytes -> size
  regexp {/Size 5000.*?/Length (\d+)} $bytes -> length
  # Size is the original, Length the compressed one - and it did compress
  list $size [expr {$length < 5000}]
} -result {5000 1}

test attach-3.5 {-date becomes the ModDate of the embedded file} -body {
  # The documented way to say when the attached file was made. ZUGFeRD readers
  # and archives both look at it, and nothing had ever passed one - so the
  # option could have been spelled anything at all.
  set path [::tclpdfTest::scratch attach-date.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data "Rechnung" -name rechnung.txt -date "D:20260812093000+02'00'"
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Inside /Params, next to /Size - not as a document date.
  regexp {/Params << [^>]*?/ModDate \(D:20260812093000\+02'00'\)} $bytes
} -result 1

test attach-3.6 {without -date no ModDate is invented} -body {
  # The counterpart: a date nobody gave must not appear, or every attachment
  # would carry the moment it happened to be written and no two runs of the
  # same document would be byte-identical.
  set path [::tclpdfTest::scratch attach-nodate.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data "Rechnung" -name rechnung.txt
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/Params << [^>]*?/ModDate} $bytes
} -result 0

test attach-4.1 {a private method can be hooked onto an event} -body {
  # onSelf exists because the bus calls from the global context, where a
  # method starting with a capital is not exported and "$doc Method" fails.
  set doc [tclpdf new]
  $doc page add
  $doc attach -data x -name x.txt
  set events [lsort [$doc subscribers]]
  $doc destroy
  set events
} -result {beforeWrite catalog}

test attach-rewrite-6.1 {a second write does not embed the attachments again} -body {
  # AttachWrite runs on every write. It used to create fresh EmbeddedFile and
  # Filespec objects per run - the file grew by the full attachment size each
  # time, and only the last copy stayed reachable through the name tree.
  set first [::tclpdfTest::scratch attach-rewrite-a.pdf]
  set second [::tclpdfTest::scratch attach-rewrite-b.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach [file join [file dirname [file dirname [file normalize \
      [info script]]]] license.terms] -name terms.txt -description "licence"
  $doc write $first
  $doc write $second
  $doc destroy
  set bytes [::tclpdfTest::readBytes $second]
  set same [expr {$bytes eq [::tclpdfTest::readBytes $first]}]
  file delete $first $second
  # One Filespec, and byte-identical to the first file.
  list [regexp -all {/Filespec} $bytes] $same
} -result {1 1}

# -- the five relationships ----------------------------------------------------

test attach-7.1 {every documented -relationship is written as /AFRelationship} -body {
  # Data is checked in 3.1; the other four each in a document of their own,
  # so that a value silently mapped onto another one would show up as a
  # missing name rather than as a count that still adds up.
  set found {}
  foreach relationship {Alternative Source Supplement Unspecified} {
    set path [::tclpdfTest::scratch attach-$relationship.pdf]
    set doc [tclpdf new]
    $doc page add
    $doc attach -data "<x/>" -name $relationship.xml -relationship $relationship
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path
    lappend found [regexp -all "/AFRelationship /$relationship\\M" $bytes]
  }
  set found
} -result {1 1 1 1}

test attach-7.2 {two attachments keep their own relationships} -body {
  # A Source and an Alternative in the same file - the value belongs to the
  # Filespec, not to the document.
  set path [::tclpdfTest::scratch attach-two-relations.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc attach -data "a" -name source.txt -relationship Source
  $doc attach -data "b" -name alt.txt -relationship Alternative
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/AFRelationship /Source\M} $bytes] \
      [regexp -all {/AFRelationship /Alternative\M} $bytes] \
      [regexp -all {/AFRelationship} $bytes]
} -result {1 1 2}

# -- checked at the call ------------------------------------------------------
#
# Every option is checked before the attachment is recorded: what used to
# fail at the write - or, worse, not fail at all - now names the option.

test attach-8.1 {-data with a character above U+00FF is refused at the call, compressed or not} -body {
  # Uncompressed, the writer's byte check refused it at the write;
  # compressed, [zlib compress] kept the low byte of each character and
  # said nothing - "中" (U+4E2D) went into the file as the one byte 0x2D.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach compress {0 1} {
    lappend out [catch {$doc attach -data "\u4e2d" -name cjk$compress.txt -compress $compress} err] \
        [string match {*-data takes bytes, not text*encoding convertto*} $err]
  }
  # Bytes up to U+00FF are bytes and go through - and come out unchanged.
  $doc attach -data "M\xfcller\x00\xff" -name latin.bin -compress 0
  set path [::tclpdfTest::scratch attach-bytes.pdf]
  $doc write $path
  set names [$doc attachments]
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $out $names [string match "*M\xfcller\x00\xff*" $bytes]
} -result {{1 1 1 1} latin.bin 1}

test attach-8.2 {-date, -mime and -compress are checked at the call, and a good date reaches /Params /ModDate} -body {
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach {option value pattern} {
    -date yesterday                {*attach -date takes a PDF date*7.9.4*not "yesterday"*}
    -date {2026-08-18 12:00:00}    {*attach -date takes a PDF date*}
    -mime {}                       {*-mime takes a media type such as text/xml*}
    -mime {not a mime}             {*-mime takes a media type*not "not a mime"*}
    -mime text                     {*-mime takes a media type*}
    -compress maybe                {*-compress takes a boolean, not "maybe"*}
  } {
    lappend out [catch {$doc attach -data x -name bad.txt $option $value} err] \
        [string match $pattern $err]
  }
  set none [$doc attachments]
  $doc attach -data x -name good.txt -date "D:20260818120000+02'00'" \
      -mime application/vnd.ms-excel -compress no
  set path [::tclpdfTest::scratch attach-checked.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [lsort -unique $out] $none \
      [regexp {/ModDate \(D:20260818120000\+02'00'\)} $bytes] \
      [regexp {/Subtype /application#2Fvnd.ms-excel} $bytes]
} -result {1 {} 1 1}

test attach-8.3 {a name with a path separator is refused; a non-ASCII name gets an ASCII /F and the real /UF} -body {
  # 7.11.2.1: "/" separates and "\\" escapes in a file specification
  # string, so neither belongs in a NAME. /F is a byte string every reader
  # takes, /UF the text string with the real name (Table 44); the name used
  # to go into /F as UTF-16BE, which is not a form 7.11.2.1 knows.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach name {dir/sub.txt dir\\sub.txt} {
    lappend out [catch {$doc attach -data x -name $name} err] \
        [string match {*-name must not contain "/" or "\\"*7.11.2.1*} $err]
  }
  $doc attach -data x -name "\u00c4rger \u00fc.txt"
  set path [::tclpdfTest::scratch attach-names.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {<< /Type /Filespec [^\n]*>>} $bytes spec
  # UTF-16BE with BOM: FE FF, then 00C4 'r' 'g' 'e' 'r' ' ' 00FC '.' ...
  list $out [regexp {/F \(_rger _\.txt\)} $spec] \
      [regexp {/UF <feff00c40072006700650072002000fc002e007400780074>} $spec] \
      [regexp {/F <} $spec]
} -result {{1 1 1 1} 1 1 0}

test attach-8.4 {the name tree is sorted by the bytes of the keys, the same under both interpreters} -body {
  # 7.9.6: keys are compared as byte strings. Sorted as Tcl strings, a name
  # outside the BMP came before U+FFC2 under 8.6 (surrogates D83D...) and
  # after it under 9.0 (1F600) - only the first is the order of the file,
  # where both are UTF-16BE. ASCII keys are their own bytes and sort before
  # the FE FF of a hex key.
  set doc [tclpdf new]
  $doc page add
  $doc attach -data x -name "\uffc2.txt"
  $doc attach -data x -name "[encoding convertfrom utf-8 [binary format H* F09F9880]].txt"
  $doc attach -data x -name b.txt
  $doc attach -data x -name a.txt
  set path [::tclpdfTest::scratch attach-order.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/Names \[([^\]]*)\]} $bytes -> tree
  regexp -all -inline {\([^)]*\)|<[0-9a-f]+>} $tree
} -result {(a.txt) (b.txt) <feffd83dde00002e007400780074> <feffffc2002e007400780074>}

test attach-8.5 {an empty attachment is allowed: -data {} is present, not absent} -body {
  # A zero-byte marker file is a legal thing to embed; "-data {}" used to
  # be refused as "needs a file name or -data".
  set doc [tclpdf new]
  $doc page add
  $doc attach -data {} -name empty.txt -compress 0
  set none [catch {$doc attach -name x.txt} err]
  set names [$doc attachments]
  set path [::tclpdfTest::scratch attach-empty.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $names $none [string match {*needs a file name or -data*} $err] \
      [regexp {/Params << /Size 0 >>} $bytes] [regexp {/Length 0 >>} $bytes]
} -result {empty.txt 1 1 1 1}


test attach-8.6 {the /F fallback writes one "_" per code point, the same bytes under both interpreters} -body {
  # U+1F600 lies beyond the BMP: Tcl 8.6 stores it as a surrogate pair - two
  # string elements - and a character-wise replacement wrote TWO underscores
  # where Tcl 9, storing the character whole, wrote one; the /F bytes
  # differed by interpreter. The expectation is welded to the one-underscore
  # form, so whichever interpreter runs this file measures against the same
  # bytes. Decoded from UTF-8 as in attach-8.4, because the \U escape of
  # 8.6.18 answers U+FFFD for a code point it cannot store as one element.
  set doc [tclpdf new]
  $doc page add
  $doc attach -data x \
      -name "Bericht [encoding convertfrom utf-8 [binary format H* F09F9880]].txt"
  set path [::tclpdfTest::scratch attach-fallback.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/F \(([^)]*)\)} $bytes -> f
  set f
} -result {Bericht _.txt}

cleanupTests

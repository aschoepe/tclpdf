# zugferd.test --
#
# PDF/A, ZUGFeRD, links and bookmarks.
#
# The two regressions here were both found by veraPDF on a file that qpdf
# called clean: resources inherited from the page tree, and a table quietly
# falling back to an unembedded Helvetica.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::pdfa
package require tclpdf::zugferd
package require tclpdf::link
package require tclpdf::outline
source [file join [file dirname [info script]] helper.tcl]

set root [file dirname [file dirname [file normalize [info script]]]]
set assets [file join $root examples assets]
set invoice [file join $assets xml zugferd-en16931.xml]
set minimum [file join $assets xml zugferd-minimum.xml]
set icc [file join $root icc sRGB.icc]
set face [file join $assets fonts DejaVuSans.ttf]

testConstraint haveInvoice [expr {[file exists $invoice] && [file exists $face]}]
testConstraint haveIcc [file exists $icc]

# A document that is allowed to be PDF/A: everything in an embedded face.
proc archivable {face} {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed haus $face
  $doc text "Rechnung" -at {20 20} -family haus
  return $doc
}

test zugferd-1.1 {BT-24 decides the profile} -constraints haveInvoice -body {
  # Read out of the XML rather than asked for: the two cannot drift apart,
  # and the reference toolchain's habit of silently substituting BASIC for
  # anything it does not know is exactly what this avoids.
  list [::tclpdf::zugferd profile [::tclpdf::io read $invoice]] \
      [::tclpdf::zugferd profile [::tclpdf::io read $minimum]]
} -result {{EN 16931} MINIMUM}

test zugferd-1.2 {an unknown identifier is an error, not a guess} -body {
  set xml {<rsm:CrossIndustryInvoice><ram:GuidelineSpecifiedDocumentContextParameter>
      <ram:ID>urn:something:else</ram:ID>
      </ram:GuidelineSpecifiedDocumentContextParameter></rsm:CrossIndustryInvoice>}
  ::tclpdf::zugferd profile $xml
} -returnCodes error -match glob -result {*unknown BT-24*labelled BASIC*}

test zugferd-1.3 {XML without BT-24 is not an invoice} -body {
  ::tclpdf::zugferd profile "<foo><bar>x</bar></foo>"
} -returnCodes error -match glob -result {*no BT-24*}

test zugferd-1.4 {an XRechnung identifier is recognised by shape} -body {
  set xml {<ram:GuidelineSpecifiedDocumentContextParameter><ram:ID>urn:cen.eu:en16931:2017#compliant#urn:xoev-de:kosit:standard:xrechnung_3.0</ram:ID></ram:GuidelineSpecifiedDocumentContextParameter>}
  ::tclpdf::zugferd profile $xml
} -result XRECHNUNG

test zugferd-2.1 {a PDF/A declaration produces the XMP} -constraints haveInvoice -body {
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance B
  set path [::tclpdfTest::scratch pdfa.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {<pdfaid:part>3</pdfaid:part>} $bytes] \
      [regexp {<pdfaid:conformance>B</pdfaid:conformance>} $bytes] \
      [regexp {/Subtype /XML} $bytes]
} -result {1 1 1}

test zugferd-2.2 {an unembedded font is refused} -body {
  # Regression, found by veraPDF (6.2.11.4.1). A table theme defaulting to
  # Helvetica in an otherwise embedded document produces a file that opens
  # perfectly and is not archivable - and nothing on the way to the recipient
  # says so.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc text "Helvetica" -at {20 20}
  $doc pdfa -part 3
  try {
    $doc write [::tclpdfTest::scratch pdfa-font.pdf]
  } finally {
    catch {file delete [::tclpdfTest::scratch pdfa-font.pdf]}
    $doc destroy
  }
} -returnCodes error -match glob -result {*every font to be embedded*Helvetica*}

test zugferd-2.3 {an embedded Type0 face is NOT reported as missing} -constraints haveInvoice -body {
  # The check follows the references: Type0 -> CIDFont -> FontDescriptor ->
  # FontFile2. Looking only one level down reports every embedded face as
  # unembedded, which is what a first attempt did.
  set doc [archivable $face]
  $doc pdfa -part 3
  set path [::tclpdfTest::scratch pdfa-type0.pdf]
  $doc write $path
  $doc destroy
  file delete $path
  set result ok
} -result ok

test zugferd-2.4 {PDF/A part 4 is refused with a reason} -body {
  set doc [tclpdf new]
  try {
    $doc pdfa -part 4
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*part 4 needs PDF 2.0*}

test zugferd-3.1 {every page carries its own Resources} -body {
  # Regression, found by veraPDF (6.2.2, "inheritedResourceNames == ''").
  # Inheriting from the page tree is valid PDF and forbidden in PDF/A - qpdf
  # says nothing either way.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red
  $doc page add
  set path [::tclpdfTest::scratch resources.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # Two pages, two /Resources entries, and the page tree without one.
  list [regexp -all {/Type /Page[^s]} $bytes] \
      [regexp -all {/Resources \d+ 0 R} $bytes] \
      [regexp {/Type /Pages[^>]*/Resources} $bytes]
} -result {2 2 0}

test zugferd-4.1 {an invoice becomes a full ZUGFeRD document} -constraints {haveInvoice haveIcc} -body {
  set doc [archivable $face]
  set profile [$doc zugferd $invoice -icc $icc]
  set path [::tclpdfTest::scratch zugferd.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # EN 16931 carries the full invoice, so its XML is /Alternative - the
  # profile-bound default that zugferd-4.5 checks from the other side.
  list $profile \
      [regexp {/AFRelationship /Alternative} $bytes] \
      [regexp {/AF \[\d+ 0 R\]} $bytes] \
      [regexp {/GTS_PDFA1} $bytes] \
      [regexp {<fx:ConformanceLevel>EN 16931</fx:ConformanceLevel>} $bytes] \
      [regexp {Factur-X PDFA Extension Schema} $bytes]
} -result {{EN 16931} 1 1 1 1 1}

test zugferd-4.2 {the namespace URI keeps its case and its hash} -constraints haveInvoice -body {
  # The sample PDFs of the Factur-X info package spell it all-lowercase,
  # which the specification does not allow - and the trailing "#" is missing
  # from the comment in the specification itself. Checked against the
  # normative XMP sample, not against either of those.
  set schema [::tclpdf::zugferd extensionSchema]
  list [regexp {urn:factur-x:pdfa:CrossIndustryDocument:invoice:1p0#</pdfaSchema} $schema] \
      [regexp -all {<pdfaProperty:name>} $schema]
} -result {1 4}

test zugferd-4.3 {a second invoice is refused} -constraints haveInvoice -body {
  set doc [archivable $face]
  $doc zugferd $invoice
  try {
    $doc zugferd $invoice
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*already carries an invoice*}

test zugferd-4.4 {a file name the standards do not allow is refused} -constraints haveInvoice -body {
  set doc [archivable $face]
  try {
    $doc zugferd $invoice -name rechnung.xml
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*not a file name the standards allow*factur-x.xml*}

test zugferd-4.5 {MINIMUM gets /AFRelationship /Data, not /Alternative} -constraints {haveInvoice haveIcc} -body {
  # Factur-X binds the relationship to the profile: MINIMUM (and BASIC WL)
  # record too little to stand in for the invoice, so their XML is Data.
  # A blanket Alternative here is a validation error on the receiving side.
  set doc [archivable $face]
  $doc zugferd $minimum -icc $icc
  set path [::tclpdfTest::scratch zugferd-minimum.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/AFRelationship /Data} $bytes] \
      [regexp {/AFRelationship /Alternative} $bytes]
} -result {1 0}

test zugferd-4.6 {an explicit -relationship wins over the profile default} -constraints {haveInvoice haveIcc} -body {
  set doc [archivable $face]
  $doc zugferd $minimum -icc $icc -relationship Source
  set path [::tclpdfTest::scratch zugferd-source.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/AFRelationship /Source} $bytes] \
      [regexp {/AFRelationship /Data} $bytes]
} -result {1 0}

test zugferd-5.1 {a link becomes a page annotation} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc link -at {20 20} -size {40 5} -url "https://example.org/"
  set path [::tclpdfTest::scratch link.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Subtype /Link} $bytes] [regexp {/S /URI} $bytes] \
      [regexp {/Annots \[} $bytes] [regexp {/F 4} $bytes]
} -result {1 1 1 1}

test zugferd-5.2 {a link to a page that does not exist is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc link -at {20 20} -size {40 5} -page 7
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*no such page: 7*}

test zugferd-6.1 {bookmarks build a tree} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc page add
  set chapter [$doc bookmark "Kapitel" -page 0]
  $doc bookmark "Abschnitt" -page 1 -parent $chapter
  set path [::tclpdfTest::scratch outline.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Type /Outlines} $bytes] [regexp {/PageMode /UseOutlines} $bytes] \
      [regexp {/Count 1} $bytes] [regexp {\(Abschnitt\)} $bytes]
} -result {1 1 1 1}

test zugferd-6.2 {siblings are linked both ways} -body {
  # The outline is a doubly linked list at each level, which is why the whole
  # tree is written at the end rather than as it is built.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc bookmark "eins"
  $doc bookmark "zwei"
  $doc bookmark "drei"
  set path [::tclpdfTest::scratch outline-siblings.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/Prev \d+ 0 R} $bytes] [regexp -all {/Next \d+ 0 R} $bytes]
} -result {2 2}

test zugferd-5.3 {a tooltip becomes the annotation's Contents} -body {
  # The tooltip is what a reader shows on hover and what a screen reader
  # announces - the only text a link annotation carries at all.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc link -at {20 20} -size {40 5} -url "https://example.org/" \
      -tooltip "The example, and nothing else"
  set path [::tclpdfTest::scratch tooltip.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/Contents \(The example, and nothing else\)} $bytes
} -result 1

test zugferd-6.3 {bookmarks reports the tree that was built} -body {
  # The reading half of the outline facade: [bookmark] returns a handle and
  # nothing could ever ask what the tree looks like without writing the file
  # first. A caller building a table of contents needs exactly this.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc page add
  $doc bookmark "eins" -page 0
  set chapter [$doc bookmark "zwei" -page 1]
  $doc bookmark "drei" -page 1 -parent $chapter
  set entries [$doc bookmarks]
  $doc destroy
  list [llength $entries] [dict get [lindex $entries 2] title] \
      [expr {[dict get [lindex $entries 2] parent] eq $chapter}] \
      [dict get [lindex $entries 1] page]
} -result {3 drei 1 1}

test zugferd-7.1 {pdfa declares the conformance the caller asks for} -constraints {haveIcc haveInvoice} -body {
  # [pdfa] on its own - without ZUGFeRD around it - is how a plain archival
  # document is made, and it was reached only through [zugferd] until now.
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance B -profile $icc
  set state [$doc pdfa state]
  set path [::tclpdfTest::scratch pdfa-plain.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [dict get $state part] [dict get $state conformance] \
      [regexp {pdfaid:part>3<} $bytes] [regexp {pdfaid:conformance>B<} $bytes] \
      [regexp {/OutputIntent} $bytes] [regexp {/S /GTS_PDFA1} $bytes]
} -result {3 B 1 1 1 1}

test zugferd-7.2 {the ICC profile is embedded once, however often it is set} -constraints {haveIcc haveInvoice} -body {
  # The output intent is written on every [write], so a second run must reuse
  # the reserved objects instead of embedding the profile again.
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance B -profile $icc
  set path [::tclpdfTest::scratch pdfa-twice.pdf]
  $doc write $path
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/N 3} $bytes] [regexp -all {/OutputIntents} $bytes]
} -result {1 1}

test zugferd-7.4 {level U is written and validates as 3u} -constraints {haveIcc haveInvoice} -body {
  # U is B plus "every character maps back to Unicode" - which is exactly the
  # ToUnicode CMap this package writes for every embedded face anyway. So the
  # stronger level costs nothing, and the only thing that was ever missing was
  # saying so.
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance U -profile $icc
  set path [::tclpdfTest::scratch pdfa-u.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The declaration, and the map it rests on.
  list [regexp {pdfaid:part>3<} $bytes] [regexp {pdfaid:conformance>U<} $bytes] \
      [regexp {/ToUnicode} $bytes]
} -result {1 1 1}

test zugferd-7.5 {level A without a structure tree names the missing call} -body {
  # Level A is deliverable since 2026-08-13, but only for a document that
  # switched tagging on. Turning it on here instead of complaining would be
  # the friendly move and is wrong: the brackets change every content stream,
  # so the document would come out different from the one the caller tested.
  # Before the tree existed this was refused outright; before THAT it was
  # accepted and failed veraPDF on 6.7.2.2 and 6.7.3.3.
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc pdfa -part 3 -conformance A
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*level A needs a tagged document*tagged 1*}

test zugferd-7.7 {the font check does not depend on the order of the calls} \
    -constraints {haveIcc haveInvoice} -body {
  # Both subscribe to write time events, and subscribers run in the order
  # they registered. With the check in PdfaWrite, declaring [pdfa] before the
  # first [font embed] ran it before the font module had written anything: it
  # found no /FontFile and refused a document whose fonts were all embedded,
  # with "FEbody is a standard font" - the resource name, because there was
  # no /BaseFont to read yet. The same document the other way round wrote
  # fine, which is why no example ever hit it.
  proc orderProbe {first face icc} {
    set doc [tclpdf new -unit mm]
    $doc page add
    if {$first eq "pdfa"} {
      $doc pdfa -part 3 -conformance B -profile $icc
      $doc font embed haus $face
    } else {
      $doc font embed haus $face
      $doc pdfa -part 3 -conformance B -profile $icc
    }
    $doc text "Rechnung" -at {20 20} -family haus
    set path [::tclpdfTest::scratch pdfa-order-$first.pdf]
    set code [catch {$doc write $path} err]
    $doc destroy
    file delete $path
    return [expr {$code ? $err : "ok"}]
  }
  set result [list [orderProbe pdfa $face $icc] [orderProbe embed $face $icc]]
  rename orderProbe {}
  set result
} -result {ok ok}

test zugferd-7.6 {an unknown conformance names the ones that exist} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc pdfa -part 3 -conformance X
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*must be B or U*}

test zugferd-7.3 {part 1 is refused and the reason names a part that fits} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc pdfa -part 1
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*PDF/A-1 forbids transparency*use part 2*}

test zugferd-7.8 {an ICC profile with a Lab space is refused by name} -body {
  # Lab and XYZ profiles are valid ICC, but the output intent needs a device
  # space with a component count. Until 2026-08-15 this fell over as a bare
  # [dict get] error. Only the space signature at offset 16 is read, so a
  # minimal fake header is enough here.
  set path [::tclpdfTest::scratch lab.icc]
  set fh [open $path wb]
  puts -nonewline $fh [binary format a16a4a108 {} "Lab " {}]
  close $fh
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc pdfa -part 3 -conformance B -profile $path
  set code [catch {$doc write [::tclpdfTest::scratch lab.pdf]} err]
  $doc destroy
  file delete $path [::tclpdfTest::scratch lab.pdf]
  list $code [string match {*colour space "Lab"*} $err] \
      [string match "*GRAY, RGB and CMYK*" $err]
} -result {1 1 1}

# A minimal ICC profile: the 128-byte header with the colour space at offset
# 16, then a tag table with the entries given as {signature bytes} pairs. Only
# what pdfa.tcl reads is real; the rest is zero.
proc fakeProfile {path space args} {
  set count [expr {[llength $args] / 2}]
  set offset [expr {132 + 12 * $count}]
  set table {}
  set data {}
  foreach {sig bytes} $args {
    append table [binary format a4IuIu $sig $offset [string length $bytes]]
    append data $bytes
    incr offset [string length $bytes]
  }
  set fh [open $path wb]
  puts -nonewline $fh [binary format a16a4a108Iu {} $space {} $count]$table$data
  close $fh
  return $path
}

# A version 2 desc tag: type, four reserved bytes, the length counting the
# terminating NUL, the ASCII text.
proc descTag {text} {
  return [binary format a4x4Iua* desc [expr {[string length $text] + 1}] "$text\0"]
}

test zugferd-7.9 {pdfa without -profile embeds the shipped sRGB profile} \
    -constraints {haveIcc haveInvoice} -body {
  # This writer paints with DeviceRGB operators, and ISO 19005-2, 6.2.4.3
  # makes the output intent mandatory for those - so a document without a
  # profile is not archivable. Until 2026-08-15 [pdfa] without -profile wrote
  # no output intent at all, and only the recipient's validator said so.
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance B
  set state [$doc pdfa state]
  set path [::tclpdfTest::scratch pdfa-default.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The shipped profile keeps the name it always had: its desc tag says only
  # "sRGB", but the space it implements is IEC 61966-2-1, and a script that
  # ran before the desc tag was read has to keep producing the same bytes.
  list [expr {[dict get $state profile] eq $icc}] \
      [regexp {/OutputIntents \[\d+ 0 R\]} $bytes] \
      [regexp {/DestOutputProfile \d+ 0 R} $bytes] \
      [regexp {/N 3} $bytes] \
      [regexp {/OutputConditionIdentifier \(sRGB IEC61966-2.1\)} $bytes] \
      [regexp {/Info \(sRGB IEC61966-2.1\)} $bytes]
} -result {1 1 1 1 1 1}

test zugferd-7.9a {the shipped profile named explicitly is treated the same} \
    -constraints {haveIcc haveInvoice} -body {
  set doc [archivable $face]
  $doc pdfa -part 3 -conformance B -profile $icc
  set path [::tclpdfTest::scratch pdfa-explicit-shipped.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/OutputConditionIdentifier \(sRGB IEC61966-2.1\)} $bytes
} -result 1

test zugferd-7.10 {the desc tag of the shipped profile reads "sRGB"} -constraints haveIcc -body {
  # Measured against the file, and the same value icc/README.md records.
  ::tclpdf::pdfa description [::tclpdf::io read $icc]
} -result sRGB

test zugferd-7.11 {the condition identifier comes from the profile's desc tag} -body {
  # A GRAY profile used to go out labelled "sRGB IEC61966-2.1" - the string
  # was fixed whatever file was passed. Now the profile names itself.
  set path [fakeProfile [::tclpdfTest::scratch gray.icc] "GRAY" \
      desc [descTag "Probe Gray Gamma 2.2"]]
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc pdfa -part 3 -conformance B -profile $path
  set out [::tclpdfTest::scratch gray.pdf]
  $doc write $out
  $doc destroy
  set bytes [::tclpdfTest::readBytes $out]
  file delete $path $out
  list [regexp {/N 1} $bytes] \
      [regexp {/OutputConditionIdentifier \(Probe Gray Gamma 2\.2\)} $bytes] \
      [regexp {/Info \(Probe Gray Gamma 2\.2\)} $bytes] \
      [regexp {IEC61966} $bytes]
} -result {1 1 1 0}

test zugferd-7.12 {a version 4 mluc desc is read, en-US preferred} -body {
  # Two records, de-DE first: the en-US one has to win over "first wins".
  set de "Grau"
  set en "Grey v4"
  set utf16 {}
  foreach text [list $de $en] {
    set units {}
    foreach char [split $text {}] {lappend units [scan $char %c]}
    lappend utf16 [binary format Su* $units]
  }
  set start [expr {16 + 2 * 12}]
  set tag [binary format a4x4IuIu mluc 2 12]
  append tag [binary format a2a2IuIu de DE [string length [lindex $utf16 0]] $start]
  append tag [binary format a2a2IuIu en US [string length [lindex $utf16 1]] \
      [expr {$start + [string length [lindex $utf16 0]]}]]
  append tag [join $utf16 {}]
  set profile [binary format a16a4a108Iu {} "RGB " {} 1]
  append profile [binary format a4IuIu desc 144 [string length $tag]] $tag
  ::tclpdf::pdfa description $profile
} -result {Grey v4}

test zugferd-7.13 {a profile without a readable desc is named after its file} -body {
  set path [fakeProfile [::tclpdfTest::scratch nameless.icc] "CMYK"]
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc pdfa -part 3 -conformance B -profile $path
  set out [::tclpdfTest::scratch nameless.pdf]
  $doc write $out
  $doc destroy
  set bytes [::tclpdfTest::readBytes $out]
  file delete $path $out
  list [regexp {/N 4} $bytes] [regexp {/OutputConditionIdentifier \(nameless\)} $bytes]
} -result {1 1}

test zugferd-7.14 {an explicit -profile wins over the shipped default} -constraints haveIcc -body {
  set path [fakeProfile [::tclpdfTest::scratch mine.icc] "GRAY" desc [descTag Mine]]
  # Given at the declaration, and given after a declaration without one.
  set first [tclpdf new -unit mm]
  $first pdfa -part 3 -conformance B -profile $path
  set second [tclpdf new -unit mm]
  $second pdfa -part 3 -conformance B
  $second pdfa -profile $path
  set result [list [dict get [$first pdfa state] profile] \
      [dict get [$second pdfa state] profile]]
  $first destroy
  $second destroy
  file delete $path
  lmap p $result {expr {$p eq $path}}
} -result {1 1}

test zugferd-7.15 {a missing shipped profile is a broken installation, not silence} -body {
  # zugferd.tcl used to degrade to "no output intent" when the file was gone;
  # pdfa.tcl now owns the default and says what is missing and where.
  set kept $::tclpdf::pdfa::icc
  set ::tclpdf::pdfa::icc [::tclpdfTest::scratch not-there.icc]
  set doc [tclpdf new -unit mm]
  try {
    $doc pdfa -part 3
  } finally {
    set ::tclpdf::pdfa::icc $kept
    $doc destroy
  }
} -returnCodes error -match glob -result {*sRGB profile shipped with the package is missing at *not-there.icc*installation is incomplete*}

test zugferd-7.16 {an explicit profile that does not exist is refused by name} -body {
  set doc [tclpdf new -unit mm]
  try {
    $doc pdfa -part 3 -profile [::tclpdfTest::scratch nowhere.icc]
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*ICC profile "*nowhere.icc" does not exist*}

rename fakeProfile {}
rename descTag {}

cleanupTests

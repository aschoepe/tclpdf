# image.test --
#
# JPEG and PNG embedding.
#
# The point of most of these is which WAY a file takes, not whether it ends up
# in the document at all. A picture that goes down the expensive path when the
# cheap one would do produces a perfectly valid file - just a slower, larger
# one that nothing reports.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::image
package require tclpdf::imageJpeg
package require tclpdf::imagePng
package require tclpdf::imagePngAlpha
source [file join [file dirname [info script]] helper.tcl]

set assets [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets images]
set photo [file join $assets sample-photo.jpg]
set gray [file join $assets sample-gray.jpg]
set indexed [file join $assets sample-indexed.png]
set rgba [file join $assets sample-rgba.png]

testConstraint haveImages [expr {[file exists $photo] && [file exists $rgba]}]

test image-1.1 {a baseline JPEG reports its frame header} -constraints haveImages -body {
  set parsed [::tclpdf::imageJpeg parse [::tclpdf::io read $photo]]
  list [dict get $parsed width] [dict get $parsed height] \
      [dict get $parsed components] [dict get $parsed bitsPerComponent]
} -result {640 480 3 8}

test image-1.2 {a grayscale JPEG is one component} -constraints haveImages -body {
  dict get [::tclpdf::imageJpeg parse [::tclpdf::io read $gray]] components
} -result 1

test image-1.3 {the marker walk does not read a Huffman table as a frame} -constraints haveImages -body {
  # Regression. DHT is marker 0xC4 and sits INSIDE the 0xC0..0xCF range that
  # holds the frame headers. Comparing the scanned byte (196) against the
  # string "0xc4" never matches, and the image then takes its dimensions from
  # a Huffman table - which is a valid-looking document showing nothing.
  set parsed [::tclpdf::imageJpeg parse [::tclpdf::io read $gray]]
  list [dict get $parsed width] [dict get $parsed height]
} -result {640 480}

test image-1.4 {something that is not a JPEG} -body {
  ::tclpdf::imageJpeg parse "not a jpeg at all"
} -returnCodes error -match glob -result {*not a JPEG*}

test image-1.5 {a progressive JPEG is refused by name} -body {
  # SOI, then a minimal SOF2 segment. Progressive is outside what DCTDecode
  # covers, and a document carrying one opens to a blank rectangle.
  set bytes [binary format H* ffd8ffc2000b080010001001011100]
  ::tclpdf::imageJpeg parse $bytes
} -returnCodes error -match glob -result {*progressive*baseline*}

test image-1.6 {a 12-bit JPEG is refused by name} -body {
  # SOI, then a minimal SOF1 with precision 12 - what libjpeg writes for
  # "cjpeg -precision 12". DCTDecode delivers 8 bits per component and
  # nothing else (Table 89); written out, the picture would carry a
  # /BitsPerComponent no reader can honour.
  set bytes [binary format H* ffd8ffc1000b0c0010001001011100]
  ::tclpdf::imageJpeg parse $bytes
} -returnCodes error -match glob -result {*12-bit JPEG*DCTDecode*Table 89*}

test image-1.7 {the same header with 8 bits is taken} -body {
  set bytes [binary format H* ffd8ffc1000b080010001001011100]
  dict get [::tclpdf::imageJpeg parse $bytes] bitsPerComponent
} -result 8

testConstraint haveCjpeg [expr {[auto_execok cjpeg] ne {} && [auto_execok djpeg] ne {}}]

test image-1.8 {a real 12-bit JPEG is refused too} -constraints {haveImages haveCjpeg} -body {
  # Made from the grey sample on the spot: cjpeg re-encodes it with 12 bits
  # of precision, and [image embed] has to say no.
  set pgm [::tclpdfTest::scratch image-12bit.pgm]
  set jpg [::tclpdfTest::scratch image-12bit.jpg]
  exec {*}[auto_execok djpeg] -pnm -outfile $pgm $gray
  exec {*}[auto_execok cjpeg] -precision 12 -outfile $jpg $pgm
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc image embed twelve $jpg} message]
  $doc destroy
  file delete $pgm $jpg
  list $code [string match {*12-bit JPEG*} $message]
} -result {1 1}

test image-2.1 {a PNG reports its header} -constraints haveImages -body {
  set parsed [::tclpdf::imagePng parse [::tclpdf::io read $rgba]]
  list [dict get $parsed width] [dict get $parsed height] \
      [dict get $parsed bitDepth] [dict get $parsed colorType] \
      [dict get $parsed channels] [dict get $parsed interlace]
} -result {640 480 8 6 4 0}

test image-2.2 {a palette image keeps its PLTE} -constraints haveImages -body {
  set parsed [::tclpdf::imagePng parse [::tclpdf::io read $indexed]]
  list [expr {[string length [dict get $parsed palette]] / 3}] \
      [dict get $parsed colorType] \
      [regexp {^\[/Indexed /DeviceRGB 255 } [::tclpdf::imagePng space $parsed]]
} -result {256 3 1}

test image-2.3 {a palette that is opaque-or-not takes the cheap way} -constraints haveImages -body {
  # Measured on this file: 256 tRNS entries, 255 of them opaque and one fully
  # transparent. That is a colour key, so the image data is passed through
  # untouched - no decoding, no soft mask.
  set parsed [::tclpdf::imagePng parse [::tclpdf::io read $indexed]]
  set streams [::tclpdf::imagePng streams $parsed]
  list [::tclpdf::imagePng paletteTransparency $parsed] \
      [expr {[dict get $streams data] eq [dict get $parsed idat]}] \
      [dict exists $streams maskData]
} -result {colourKey 1 0}

test image-2.4 {an image without alpha is never decoded} -constraints haveImages -body {
  # The whole point of the pass-through way: the bytes in the PDF ARE the
  # bytes of the IDAT chunks, and the reader does the un-filtering.
  set parsed [::tclpdf::imagePng parse [::tclpdf::io read $indexed]]
  set streams [::tclpdf::imagePng streams $parsed]
  list [expr {[dict get $streams data] eq [dict get $parsed idat]}] \
      [regexp {/Predictor 15} [::tclpdf::imagePng decodeParms $parsed]]
} -result {1 1}

test image-2.5 {an interlaced PNG is refused by name} -body {
  # IHDR with the interlace byte set. Adam7 rearranges the picture into seven
  # passes, so neither way applies - and a file that silently took the
  # pass-through way would come out scrambled.
  set header [binary format II 4 4]
  append header [binary format ccccc 8 6 0 0 1]
  set chunk [binary format Ia4 13 IHDR]
  append chunk $header [binary format I 0]
  set idat [binary format Ia4 1 IDAT]
  append idat "\x00" [binary format I 0]
  ::tclpdf::imagePng parse "\x89PNG\r\n\x1a\n$chunk$idat"
} -returnCodes error -match glob -result {*interlaced*}

test image-3.1 {the alpha channel is separated out} -constraints haveImages -body {
  set parsed [::tclpdf::imagePng parse [::tclpdf::io read $rgba]]
  set split [::tclpdf::imagePngAlpha separate $parsed]
  set pixels [expr {640 * 480}]
  list [expr {[string length [dict get $split color]] == $pixels * 3}] \
      [expr {[string length [dict get $split alpha]] == $pixels}]
} -result {1 1}

test image-3.2 {the un-filter reverses all five filter types} -constraints haveImages -body {
  # Built here rather than measured from a file, so that every one of the five
  # is exercised - a real encoder picks whichever is cheapest per row and may
  # never emit some of them.
  # Five rows of five bytes, one per filter type, each expected value worked
  # out by hand against PNG 9.2 rather than read off the implementation:
  #
  #   None     the bytes as they stand
  #   Sub      each byte plus its left neighbour: 5, 10, 15, 20, 20
  #   Up       each byte plus the one above it
  #   Average  each byte plus (left + above) >> 1
  #   Paeth    each byte plus whichever neighbour the plane comes closest to
  set rows {}
  append rows [binary format cccccc 0 10 20 30 40 0]
  append rows [binary format cccccc 1 5 5 5 5 0]
  append rows [binary format cccccc 2 1 1 1 1 0]
  append rows [binary format cccccc 3 0 0 0 0 0]
  append rows [binary format cccccc 4 0 0 0 0 0]
  set out [::tclpdf::imagePngAlpha unfilter $rows 5 5 8 1]
  list [lrange $out 0 4] [lrange $out 5 9] [lrange $out 10 14] \
      [lrange $out 15 19] [lrange $out 20 24]
} -result {{10 20 30 40 0} {5 10 15 20 20} {6 11 16 21 20} {3 7 11 16 18} {3 7 11 16 18}}

test image-4.1 {a JPEG becomes a DCTDecode XObject} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  $doc image embed photo $photo
  $doc image place photo -at {10 10} -width 50
  set path [::tclpdfTest::scratch image-jpeg.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Subtype /Image} $bytes] [regexp {/Filter /DCTDecode} $bytes] \
      [regexp {/ColorSpace /DeviceRGB} $bytes] [regexp {/SMask} $bytes]
} -result {1 1 1 0}

test image-4.2 {a PNG with alpha gets a soft mask} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  $doc image embed logo $rgba
  $doc image place logo -at {10 10} -width 50
  set path [::tclpdfTest::scratch image-alpha.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/SMask \d+ 0 R} $bytes] [regexp {/ColorSpace /DeviceGray} $bytes]
} -result {1 1}

test image-4.3 {a colour-key palette gets a /Mask array, not a soft mask} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  $doc image embed tile $indexed
  $doc image place tile -at {10 10} -width 50
  set path [::tclpdfTest::scratch image-mask.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Mask \[} $bytes] [regexp {/SMask} $bytes]
} -result {1 0}

test image-4.4 {the same picture placed twice is stored once} -constraints haveImages -body {
  # Embedding once per placement would make a logo on five pages five times
  # heavier than it needs to be - and the file would still look correct.
  set doc [tclpdf new]
  $doc page add
  $doc image embed logo $photo
  $doc image place logo -at {10 10} -width 30
  $doc page add
  $doc image place logo -at {10 10} -width 30
  set path [::tclpdfTest::scratch image-reuse.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  set size [file size $path]
  file delete $path
  list [regexp -all {/Filter /DCTDecode} $bytes] [expr {$size < 40000}]
} -result {1 1}

test image-4.5 {an embedded picture that is never placed produces no object} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  $doc image embed unused $photo
  set path [::tclpdfTest::scratch image-unused.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/DCTDecode} $bytes
} -result 0

test image-4.6 {a duplicate alias is refused} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc image embed logo $photo
  try {
    $doc image embed logo $photo
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*already embedded*}

test image-4.7 {the format is decided by the bytes, not the file name} -constraints haveImages -body {
  set path [::tclpdfTest::scratch reallyPng.jpg]
  file copy -force $rgba $path
  set doc [tclpdf new]
  $doc image embed sneaky $path
  set type [dict get [$doc image info sneaky] type]
  $doc destroy
  file delete $path
  set type
} -result png

test image-5.1 {natural size follows the pixel count and the dpi} -constraints haveImages -body {
  # 640 pixels at 72 dpi are 640 points; at 300 dpi they are 640/300 inch.
  set doc [tclpdf new -unit pt]
  $doc page add
  $doc image embed photo $photo
  set wide [lindex [$doc image size photo] 0]
  set narrow [lindex [$doc image size photo -dpi 300] 0]
  $doc destroy
  list $wide [format %.1f $narrow]
} -result {640.0 153.6}

test image-5.2 {a width alone keeps the aspect ratio} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc image embed photo $photo
  lassign [$doc image size photo -width 80] w h
  $doc destroy
  list $w [format %.1f $h]
} -result {80 60.0}

test image-5.3 {a height alone keeps the aspect ratio too} -constraints haveImages -body {
  # The counterpart to 5.2, and the half nothing ever called: -height is
  # documented for both [image place] and [svg], and every test and example
  # reached for -width. A picture scaled by its height is the normal case when
  # it has to fit a line of text or a table row.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc image embed photo $photo
  lassign [$doc image size photo -height 60] w h
  $doc destroy
  list [format %.1f $w] $h
} -result {80.0 60}

test image-5.4 {width and height together override the ratio} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc image embed photo $photo
  set size [$doc image size photo -width 40 -height 40]
  $doc destroy
  set size
} -result {40 40}

test image-5.5 {-height reaches the placement matrix, not just the arithmetic} -constraints haveImages -body {
  # Measuring [image size] alone would not catch a place that ignores the
  # height it was given: the numbers in the "cm" matrix are what ends up on
  # the page.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc image embed photo $photo
  $doc image place photo -at {10 10} -height 30
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # 40 mm by 30 mm in points, as the scale part of the matrix.
  regexp {([0-9.]+) 0 0 ([0-9.]+) [0-9.]+ [0-9.]+ cm} $stream -> sx sy
  list [format %.2f $sx] [format %.2f $sy]
} -result {113.39 85.04}

test image-draw-6.1 {draw takes a path and embeds on the way} -constraints haveImages -body {
  # [image draw] - the one-step form for a picture used once - was called by
  # no test and no example. It embeds under a generated alias and places in
  # the same call, and that alias is the part nothing had ever exercised.
  set doc [tclpdf new]
  $doc page add
  $doc image draw $photo -at {10 10} -width 30
  set aliases [$doc image names]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [llength $aliases] [regexp {/[A-Za-z0-9]+ Do} $content]
} -result {1 1}

test image-draw-6.2 {the same file drawn twice is embedded once} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  $doc image draw $photo -at {10 10} -width 30
  $doc image draw $photo -at {10 60} -width 30
  set aliases [$doc image names]
  $doc destroy
  llength $aliases
} -result 1

test image-data-7.1 {an image can be embedded from bytes instead of a file} -constraints haveImages -body {
  # The image that never was a file: a canvas posted from a browser, a plot
  # from a subprocess, a BLOB from a database. What arrives is bytes, and
  # writing them to a temporary file first is what a caller had to do until
  # this option existed.
  set doc [tclpdf new]
  $doc page add
  $doc image embed shot -data [::tclpdfTest::readBytes $photo]
  set info [$doc image info shot]
  $doc image place shot -at {10 10} -width 30
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [dict get $info type] [dict get $info width] [dict get $info path] \
      [regexp {/[A-Za-z0-9]+ Do} $content]
} -result {jpeg 640 {} 1}

test image-data-7.2 {a file and its bytes give the same image} -constraints haveImages -body {
  # The invariant that says the two roads meet: the same picture, embedded
  # both ways, has to describe itself identically - the format is decided by
  # the magic bytes either way, and the name never took part in it.
  set doc [tclpdf new]
  $doc page add
  $doc image embed viaPath $photo
  $doc image embed viaData -data [::tclpdfTest::readBytes $photo]
  set a [dict remove [$doc image info viaPath] path]
  set b [dict remove [$doc image info viaData] path]
  $doc destroy
  expr {$a eq $b}
} -result 1

test image-data-7.3 {draw takes bytes too, and stores them once} -constraints haveImages -body {
  # With -data there is no file name to key the cache on, so the bytes are the
  # key. The same picture drawn twice still travels once.
  set doc [tclpdf new]
  $doc page add
  set bytes [::tclpdfTest::readBytes $photo]
  $doc image draw -data $bytes -at {10 10} -width 30
  $doc image draw -data $bytes -at {10 60} -width 30
  set aliases [$doc image names]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [llength $aliases] [regexp -all {/[A-Za-z0-9]+ Do} $content]
} -result {1 2}

test image-data-7.4 {two different images do not share an entry} -constraints haveImages -body {
  # The counter-direction of 7.3: a cache key that collides would silently
  # draw the first picture in place of the second.
  set doc [tclpdf new]
  $doc page add
  $doc image draw -data [::tclpdfTest::readBytes $photo] -at {10 10} -width 30
  $doc image draw -data [::tclpdfTest::readBytes $rgba] -at {10 60} -width 30
  set aliases [$doc image names]
  $doc destroy
  llength $aliases
} -result 2

test image-data-7.7 {the cache key looks at the content, not just the length} -constraints haveImages -body {
  # Sharpened after a mutation test: a key built from the length alone passed
  # 7.4, because the two pictures there happen to differ in size. Two images
  # of the SAME length is the case that separates them - one byte changed deep
  # in the scan data, which the header parser never looks at.
  set bytes [::tclpdfTest::readBytes $photo]
  set altered $bytes
  set at [expr {[string length $bytes] - 40}]
  set byte [string index $bytes $at]
  binary scan $byte cu value
  set altered [string replace $altered $at $at \
      [binary format cu [expr {$value ^ 0xFF}]]]
  set doc [tclpdf new]
  $doc page add
  $doc image draw -data $bytes -at {10 10} -width 30
  $doc image draw -data $altered -at {10 60} -width 30
  set aliases [$doc image names]
  $doc destroy
  list [expr {[string length $bytes] == [string length $altered]}] \
      [expr {$bytes ne $altered}] [llength $aliases]
} -result {1 1 2}

test image-data-7.5 {neither a name nor data is refused, not guessed} -body {
  set doc [tclpdf new]
  $doc page add
  set faults {}
  foreach script {{$doc image embed} {$doc image embed lonely}
      {$doc image draw -at {10 10}}} {
    if {![catch [subst -nocommands $script] message]} {
      lappend faults "$script did not fail"
    } elseif {![string match {*needs a*} $message]} {
      lappend faults "$script: $message"
    }
  }
  $doc destroy
  set faults
} -result {}

test image-data-7.6 {data that is not an image says so without a file name} -constraints haveImages -body {
  set doc [tclpdf new]
  $doc page add
  try {
    $doc image embed broken -data "this is not a picture"
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*passed with -data*neither a JPEG nor a PNG*}

# --- decoration on purpose, or by default -------------------------------
#
# In a tagged document a picture without -alt is an artifact, and an artifact
# is the one way real content passes a reader entirely. So the difference
# between "decoration, and meant to be" and "nobody said" has to be kept:
# -artifact 1 is the first, and the second is remembered for ua.tcl to judge.

test image-artifact-8.1 {-artifact 1 brackets an artifact and leaves no entry} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  $doc image draw $gray -at {20 20} -width 30 -artifact 1
  set stream [::tclpdfTest::content $doc]
  set missing [$doc undescribedGraphics]
  $doc destroy
  list [string match "*/Artifact <</Type /Layout>> BDC*" $stream] \
      [string match "*EMC*" $stream] $missing
} -result {1 1 {}}

test image-artifact-8.2 {without -alt and -artifact the artifact is remembered} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  $doc image draw $gray -at {20 20} -width 30
  $doc page add
  $doc image draw $gray -at {20 20} -width 30 -artifact 1
  $doc image draw $gray -at {20 60} -width 30
  set missing [$doc undescribedGraphics]
  $doc destroy
  # The stream carries an artifact either way; the entry names the page,
  # counted from 1, and only the ones nobody judged.
  set missing
} -result {{kind image page 1} {kind image page 2}}

test image-artifact-8.3 {-alt makes a Figure and leaves no entry} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  $doc image draw $gray -at {20 20} -width 30 -alt "Die Werkhalle"
  set stream [::tclpdfTest::content $doc]
  set missing [$doc undescribedGraphics]
  $doc destroy
  list [string match "*/Figure <</MCID 0>> BDC*" $stream] $missing
} -result {1 {}}

test image-artifact-8.4 {-artifact 1 together with -alt is refused at the call} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc page add
  try {
    $doc image draw $gray -at {20 20} -width 30 -alt "Die Werkhalle" -artifact 1
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*-artifact and -alt contradict*}

test image-artifact-8.5 {-artifact takes a boolean, and says so otherwise} -constraints haveImages -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc image draw $gray -at {20 20} -width 30 -artifact maybe
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*-artifact takes a boolean, not "maybe"*}

test image-artifact-8.6 {an untagged document remembers nothing} -constraints haveImages -body {
  # Nothing is marked there, so nothing is degraded - and -artifact 1 is
  # accepted and changes nothing, so a caller can write it once for both.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc image draw $gray -at {20 20} -width 30
  $doc image draw $gray -at {20 60} -width 30 -artifact 1
  set stream [::tclpdfTest::content $doc]
  set missing [$doc undescribedGraphics]
  set state [$doc state undescribedGraphics]
  $doc destroy
  list [string match "*BDC*" $stream] $missing $state
} -result {0 {} {}}

cleanupTests

# color.test --
#
# Colour parsing and the content stream operators. The Tk test at the end is
# the one that matters most: resolving a colour name is exactly where pdf4tcl
# reaches for [winfo rgb] and drags in a display connection.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf::color
package require tclpdf
source [file join [file dirname [info script]] helper.tcl]

# The CMYK press profile that ships with the package, for the tests that
# need an intent other than sRGB.
set cmykIcc [file join [file dirname [file dirname [file normalize \
    [info script]]]] icc ISOcoated_v2_bas.ICC]
testConstraint haveCmykIcc [file exists $cmykIcc]

# The shipped sRGB profile, for the ICC based colour space tests - the same
# file [pdfa] embeds by default, which is what the sharing test turns on.
set srgbIcc [file join [file dirname [file dirname [file normalize \
    [info script]]]] icc sRGB.icc]
testConstraint haveSrgbIcc [file exists $srgbIcc]

test color-parse-1.1 {a name from the table} -body {
  ::tclpdf::color parse steelblue
} -result {rgb {0.27450980392156865 0.5098039215686274 0.7058823529411765}}

test color-parse-1.2 {six hexadecimal digits, ff becoming exactly 1.0} -body {
  # Divided by 255 rather than 256 - otherwise white comes out at 0.996 and
  # a PDF/A validator flags the output intent mismatch. #ffffff is grey, so
  # it comes back as one component (1.9); #fffffe is not.
  list [::tclpdf::color parse #ffffff] [::tclpdf::color parse #fffffe]
} -result {{gray 1.0} {rgb {1.0 1.0 0.996078431372549}}}

test color-parse-1.9 {a name or hex with equal components is DeviceGray, not three equal RGB numbers} -body {
  # DeviceRGB is allowed by PDF/A only under an RGB output intent (ISO
  # 19005-2, 6.2.4.3), DeviceGray under any - so black, white and the greys
  # must not drag a CMYK document into DeviceRGB. Measured: a {0.45 0.45 0.5}
  # footer was the one failed check of the CMYK example; "gray" and
  # "silver" are equal-component names, "steelblue" is not.
  list [::tclpdf::color parse black] [::tclpdf::color parse white] \
      [::tclpdf::color parse gray] [::tclpdf::color parse silver] \
      [lindex [::tclpdf::color parse steelblue] 0] \
      [::tclpdf::color operator [::tclpdf::color parse white] fill]
} -result {{gray 0.0} {gray 1.0} {gray 0.5019607843137255} {gray 0.7529411764705882} rgb {1 g}}

test color-parse-1.10 {a grey stop is promoted to the space of the coloured stops} -body {
  list [::tclpdf::color promote {gray 1.0} rgb] [::tclpdf::color promote {gray 0.25} cmyk] \
      [::tclpdf::color promote {gray 0.5} gray] [::tclpdf::color promote {rgb {1 0 0}} cmyk]
} -result {{rgb {1.0 1.0 1.0}} {cmyk {0 0 0 0.75}} {gray 0.5} {rgb {1 0 0}}}

test color-parse-1.3 {three digits are the doubling shorthand} -body {
  expr {[::tclpdf::color parse #f0a] eq [::tclpdf::color parse #ff00aa]}
} -result 1

test color-parse-1.4 {a single number is grey} -body {
  ::tclpdf::color parse 0.5
} -result {gray 0.5}

test color-parse-1.5 {three numbers are RGB, four are CMYK} -body {
  list [lindex [::tclpdf::color parse {1 0 0}] 0] \
      [lindex [::tclpdf::color parse {0 1 1 0}] 0]
} -result {rgb cmyk}

test color-parse-1.6 {explicit spellings} -body {
  list [::tclpdf::color parse {gray 0.25}] [::tclpdf::color parse {rgb 1 0 0}] \
      [::tclpdf::color parse {cmyk 0 1 1 0}]
} -result {{gray 0.25} {rgb {1 0 0}} {cmyk {0 1 1 0}}}

test color-parse-1.7 {components are clamped, not refused} -body {
  # A rounding error in a computed colour should not abort a document.
  ::tclpdf::color parse {rgb 1.2 -0.1 0.5}
} -result {rgb {1 0 0.5}}

test color-parse-1.8 {an unknown name is an error, not a silent black} -body {
  ::tclpdf::color parse fuchsiablue
} -returnCodes error -match glob -result {*unknown colour*}

test color-operator-2.1 {fill and stroke differ only in case} -body {
  set red [::tclpdf::color parse {1 0 0}]
  list [::tclpdf::color operator $red fill] [::tclpdf::color operator $red stroke]
} -result {{1 0 0 rg} {1 0 0 RG}}

test color-operator-2.2 {grey and CMYK operators} -body {
  list [::tclpdf::color operator [::tclpdf::color parse 0.5] fill] \
      [::tclpdf::color operator [::tclpdf::color parse {cmyk 0 0.5 1 0}] stroke]
} -result {{0.5 g} {0 0.5 1 0 K}}

test color-operator-2.3 {numbers pass through the PDF formatter} -body {
  # 1/3 would otherwise appear as 0.3333333333333333 and, worse, small values
  # in exponent notation.
  ::tclpdf::color operator [::tclpdf::color parse [list [expr {1.0/3}] 0 0]] fill
} -result {0.33333 0 0 rg}

test color-operator-2.4 {separation needs a resource and a tint} -body {
  # The space is escaped as #20 by the name encoder - which is exactly why a
  # spot colour name must not be concatenated by hand anywhere.
  ::tclpdf::color operator [::tclpdf::color parse {separation {PANTONE 877} {cmyk 0 0 0 0.3} 0.6}] fill
} -result "/PANTONE#20877 cs\n0.6 scn"

test color-space-3.1 {the resource name of each space} -body {
  lmap spec {0.5 {1 0 0} {0 0 0 1}} {
    ::tclpdf::color space [::tclpdf::color parse $spec]
  }
} -result {DeviceGray DeviceRGB DeviceCMYK}

test color-components-3.2 {a space gets exactly as many components as it has} -body {
  # A short list used to pass straight through and produce "1 0 rg" - an
  # operator with too few operands, invalid by 8.6.8. Nothing reports it: not
  # this package, not qpdf, not a validator. The page renders in the wrong
  # colour, or not at all. A surplus component was dropped just as silently.
  lmap spec {{rgb 1 0} {rgb 1 0 0 0} {cmyk 0 1} {cmyk 0 1 1 0 0} {gray 0.5 0.5}} {
    catch {::tclpdf::color parse $spec}
  }
} -result {1 1 1 1 1}

test color-components-3.3 {the right number still works, keyed and bare} -body {
  lmap spec {{rgb 1 0 0} {cmyk 0 1 1 0} {gray 0.5} {1 0 0} {0 1 1 0} 0.5} {
    lindex [::tclpdf::color parse $spec] 0
  }
} -result {rgb cmyk gray rgb cmyk gray}

# -- the separation colour space object -----------------------------------
#
# The operator alone is not enough: "/Varnish cs" names a resource, and until
# 2026-08-16 nothing wrote it - the shipped colour example carried a bad
# colour space since the first check-in and poppler said so. Everything below
# reads the WRITTEN file, because that is where the object has to be.

# A one-page document with a rectangle in the given colour, written and read
# back: {bytes content}. The written file is what a reader sees; the content
# buffer is where the operators are, since the stream is deflated.
proc ::tclpdfTest::separationDocument {name colour args} {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {20 20} -size {40 20} {*}$args -fill $colour
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch $name.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  return [list $bytes $content]
}

test color-separation-5.1 {the object and the resource entry exist} -body {
  lassign [::tclpdfTest::separationDocument sep-object \
      {separation Varnish {cmyk 0 0 0 0.2} 1}] bytes content
  list [regexp {\[/Separation /Varnish /DeviceCMYK \d+ 0 R\]} $bytes] \
      [regexp {/ColorSpace << /Varnish \d+ 0 R >>} $bytes] \
      [regexp "/Varnish cs\n1 scn" $content]
} -result {1 1 1}

test color-separation-5.2 {the tint transform: what tint 0 means per alternate} -body {
  # Tint 0 is NO ink. In CMYK that is 0 0 0 0; in RGB and grey, which count
  # light rather than ink, it is white - 1 1 1 and 1. A separation with an
  # RGB alternate and C0 [0 0 0] renders its light tints as dark grey.
  set result {}
  foreach {alternate expected} {
    {cmyk 0 0 0 0.2} {/C0 [0 0 0 0] /C1 [0 0 0 0.2]}
    {rgb 0.9 0.7 0.1} {/C0 [1 1 1] /C1 [0.9 0.7 0.1]}
    {gray 0.5} {/C0 [1] /C1 [0.5]}
  } {
    lassign [::tclpdfTest::separationDocument sep-c0 \
        [list separation Spot $alternate 0.5]] bytes content
    lappend result [expr {[string first \
        "/FunctionType 2 /Domain \[0 1\] $expected /N 1" $bytes] >= 0}]
  }
  set result
} -result {1 1 1}

test color-separation-5.3 {the alternate is spelled as a device space} -body {
  set result {}
  foreach {alternate space} {{rgb 1 0 0} DeviceRGB {gray 0.5} DeviceGray} {
    lassign [::tclpdfTest::separationDocument sep-space \
        [list separation Spot $alternate]] bytes content
    lappend result [regexp "/Separation /Spot /$space " $bytes]
  }
  set result
} -result {1 1}

test color-separation-5.4 {stroke as well as fill, and one object for both} -body {
  lassign [::tclpdfTest::separationDocument sep-stroke \
      {separation Spot {rgb 1 0 0} 0.5} -stroke {separation Spot {rgb 1 0 0} 1}] \
      bytes content
  list [regexp "/Spot cs\n0.5 scn" $content] [regexp "/Spot CS\n1 SCN" $content] \
      [regexp -all {/Separation /Spot} $bytes]
} -result {1 1 1}

test color-separation-5.5 {a name with a space is escaped, in the operator and the resource} -body {
  lassign [::tclpdfTest::separationDocument sep-escape \
      {separation {PANTONE 877} {cmyk 0 0 0 0.3} 0.6}] bytes content
  list [regexp {/ColorSpace << /PANTONE#20877 } $bytes] \
      [regexp {/Separation /PANTONE#20877 /DeviceCMYK} $bytes] \
      [regexp "/PANTONE#20877 cs" $content]
} -result {1 1 1}

test color-separation-5.6 {a text in a spot colour gets the resource as well} -body {
  # The text module produces its own colour operator; without going through
  # the same registration a heading in a spot colour would name a resource
  # that does not exist - the same fault, one module further on.
  set doc [tclpdf new]
  $doc page add
  $doc font -family helvetica -size 10 -color {separation Ink {rgb 0 0 0.5} 1}
  $doc text "spot" -at {20 20}
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch sep-text.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Separation /Ink /DeviceRGB} $bytes] [regexp "/Ink cs\n1 scn" $content]
} -result {1 1}

test color-separation-5.7 {a second write is byte-identical} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {20 20} -size {40 20} -fill {separation Spot {rgb 1 0 0} 0.5}
  lassign [::tclpdfTest::writeTwice $doc sep-twice] first second
  $doc destroy
  list [expr {$first eq $second}] [regexp -all {/Separation /Spot} $first]
} -result {1 1}

test color-separation-5.8 {one name, one alternate} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {20 20} -size {40 20} -fill {separation Spot {rgb 1 0 0} 0.5}
  # The same alternate again is fine - the same plate, another tint.
  $doc rect -at {20 50} -size {40 20} -fill {separation Spot {rgb 1 0 0} 1}
  set code [catch {
    $doc rect -at {20 80} -size {40 20} -fill {separation Spot {cmyk 0 1 1 0} 1}
  } message]
  $doc destroy
  list $code $message
} -match glob -result {1 {*separation "Spot" is already defined*}}

test color-separation-5.9 {a colour space family cannot be a separation name} -body {
  # "/Pattern cs" would mean the pattern space, whatever the resource says.
  set doc [tclpdf new]
  $doc page add
  set code [catch {
    $doc rect -at {20 20} -size {40 20} -fill {separation Pattern {rgb 1 0 0} 1}
  } message]
  $doc destroy
  list $code $message
} -match glob -result {1 {*"Pattern" cannot be the name of a separation*}}

test color-separation-5.10 {PDF/A refuses a CMYK alternate under the sRGB intent, naming the separation and the call} -body {
  # Measured with veraPDF: under the sRGB output intent a separation whose
  # alternate is DeviceCMYK fails ISO 19005-2, 6.2.4.3 (through 6.2.4.4);
  # RGB and grey pass. The alternate counts as a use of that space, and the
  # intent check in pdfa.tcl judges it at write time like every other
  # colour - the refusal names the separation AND the shape that painted it.
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3
  $doc rect -at {20 20} -size {40 20} -fill {separation Gold {cmyk 0 0.2 0.8 0} 1}
  set code [catch {$doc write [::tclpdfTest::scratch sep-pdfa.pdf]} message]
  $doc destroy
  file delete [::tclpdfTest::scratch sep-pdfa.pdf]
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3
  $doc rect -at {20 20} -size {40 20} -fill {separation Gold {rgb 0.9 0.7 0.1} 1}
  set fine [::tclpdfTest::writes $doc sep-pdfa-rgb.pdf]
  $doc destroy
  list $code $message $fine
} -match glob -result {1 {*PDF/A*cannot carry DeviceCMYK*separation "Gold" in rect on page 1*} {0 1}}

test color-separation-5.11 {PDF/A declared after the colour: refused at write, no file left} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {20 20} -size {40 20} -fill {separation Gold {cmyk 0 0.2 0.8 0} 1}
  $doc pdfa -part 3
  set result [::tclpdfTest::writes $doc sep-pdfa-late.pdf]
  $doc destroy
  set result
} -result {1 0}

test color-separation-5.12 {under a CMYK intent the CMYK alternate is fine and the RGB one is not} -constraints haveCmykIcc -body {
  # The mirror image, measured with veraPDF against the ISO Coated v2
  # profile: a CMYK alternate passes, an RGB alternate fails 6.2.4.3-2.
  # Until 2026-08-17 the CMYK alternate was refused under EVERY intent, with
  # a message that named "the sRGB output intent" whatever profile was set.
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3 -profile $cmykIcc
  $doc rect -at {20 20} -size {40 20} -fill {separation Gold {cmyk 0 0.2 0.8 0} 1}
  set fine [::tclpdfTest::writes $doc sep-cmyk-intent.pdf]
  $doc destroy
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3 -profile $cmykIcc
  $doc rect -at {20 20} -size {40 20} -fill {separation Gold {rgb 0.9 0.7 0.1} 1}
  set code [catch {$doc write [::tclpdfTest::scratch sep-cmyk-rgb.pdf]} message]
  $doc destroy
  file delete [::tclpdfTest::scratch sep-cmyk-rgb.pdf]
  list $fine $code $message
} -match glob -result {{0 1} 1 {*CMYK output intent*cannot carry DeviceRGB*separation "Gold" in rect on page 1*}}

test color-noTk-4.1 {resolving names does not pull in Tk} -body {
  # The whole reason this module carries its own table. If Tk were loaded the
  # package would stop working in a CGI or batch context, and the failure
  # would only show up there.
  ::tclpdf::color parse cornflowerblue
  list [package provide Tk] [llength [info commands winfo]]
} -result {{} 0}

# -- the separation's name and its alternate ---------------------------------------
#
# 8.6.6.4: the name is a colourant; the alternate is a device (or CIE) space
# and never another special one. Measured before 2026-08-18: an empty name
# went out as "/ cs", and a separation whose alternate was a separation was
# recorded as a use of the space "Separation" and died a line later. All and
# None are the two special colourants the clause defines and are written as
# they stand.

test color-separation-6.1 {an empty separation name is refused} -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  set code [catch {$doc rect -at {1 1} -size {2 2} -fill {separation {} {cmyk 0 0 0 1}}} message]
  set result [list $code [string match "*a separation needs a name*" $message] \
      [::tclpdfTest::content $doc] [$doc colourSpacesUsed]]
  $doc destroy
  set result
} -result {1 1 {} {}}

test color-separation-6.2 {an alternate that is not a device space is refused before anything is recorded} -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  set codes {}
  foreach alternate {{separation Bar {cmyk 0 0 0 1}} {pattern sky}} {
    lappend codes [catch {$doc rect -at {1 1} -size {2 2} \
        -fill [list separation Foo $alternate]} message]
    lappend codes [string match {*alternate of separation "Foo" is a device colour*8.6.6.4*} $message]
  }
  set result [list $codes [::tclpdfTest::content $doc] [$doc colourSpacesUsed] \
      [$doc state separations] [$doc resource ColorSpace]]
  $doc destroy
  set result
} -result {{1 1 1 1} {} {} {} {}}

# -- the ICC based colour space (8.6.5.5) ------------------------------------
#
# {icc alias components...} paints in the space of a profile registered with
# [icc embed]. The space is a stream with /N; it is device independent, so
# PDF/A admits it under EVERY output intent - measured with veraPDF 1.30.2,
# see 7.9/7.10 - and a profile that also serves as the output intent stands
# in the document once, not twice.

test color-icc-7.1 {parse keeps the alias and clamps the components} -body {
  ::tclpdf::color parse {icc press 0.2 1.4 -0.1}
} -result {icc {press {0.2 1 0}}}

test color-icc-7.2 {fill and stroke operators, the alias escaped like a resource name} -body {
  set parsed [::tclpdf::color parse {icc {chart 2} 0.2 0.45 0.75}]
  list [::tclpdf::color operator $parsed fill] [::tclpdf::color operator $parsed stroke]
} -result [list "/chart#202 cs\n0.2 0.45 0.75 scn" "/chart#202 CS\n0.2 0.45 0.75 SCN"]

test color-icc-7.3 {the stream, the array and the resource exist, and fill, stroke and text share them} \
    -constraints haveSrgbIcc -body {
  # The operator names a resource, and a resource needs its object - the
  # same lesson as the separation above, one space further on. One
  # [/ICCBased n 0 R] array, one profile stream, however many roads use it.
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc icc embed chart $srgbIcc
  $doc rect -at {20 20} -size {40 20} -fill {icc chart 0.2 0.45 0.75} \
      -stroke {icc chart 1 0 0}
  $doc font -family helvetica -size 10 -color {icc chart 0 0 0.5}
  $doc text "icc" -at {20 50}
  set content [::tclpdfTest::content $doc]
  set path [::tclpdfTest::scratch icc-object.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/ColorSpace << /chart \d+ 0 R >>} $bytes] \
      [llength [lsort -unique [regexp -all -inline {\[/ICCBased \d+ 0 R\]} $bytes]]] \
      [regexp -all {/N 3} $bytes] \
      [regexp "/chart cs\n0.2 0.45 0.75 scn" $content] \
      [regexp "/chart CS\n1 0 0 SCN" $content] \
      [regexp "/chart cs\n0 0 0.5 scn" $content]
} -result {1 1 1 1 1 1}

test color-icc-7.4 {an unregistered alias is refused before anything is recorded} -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  set code [catch {$doc rect -at {1 1} -size {2 2} -fill {icc nope 1 0 0}} message]
  set result [list $code [string match {*no ICC profile named "nope"*icc embed*} $message] \
      [::tclpdfTest::content $doc] [$doc colourSpacesUsed] [$doc resource ColorSpace]]
  $doc destroy
  set result
} -result {1 1 {} {} {}}

test color-icc-7.5 {the component count is the profile's, and a wrong one leaves no record} \
    -constraints haveSrgbIcc -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc icc embed chart $srgbIcc
  set code [catch {$doc rect -at {1 1} -size {2 2} -fill {icc chart 0.5}} message]
  set result [list $code [string match {*"chart" is a RGB profile and takes 3 components, got 1*} \
      $message] [::tclpdfTest::content $doc] [$doc colourSpacesUsed]]
  $doc destroy
  set result
} -result {1 1 {} {}}

test color-icc-7.6 {duplicate aliases, family names, and the separation clash both ways} \
    -constraints haveSrgbIcc -body {
  set doc [tclpdf new]
  $doc page add
  $doc icc embed chart $srgbIcc
  set codes [list [catch {$doc icc embed chart $srgbIcc} m1] \
      [catch {$doc icc embed Pattern $srgbIcc} m2]]
  # A separation may not take a registered alias, and an alias may not take
  # a used separation name - the two share the ColorSpace resources.
  lappend codes [catch {$doc rect -at {1 1} -size {2 2} \
      -fill {separation chart {cmyk 0 0 0 1}}} m3]
  $doc rect -at {1 1} -size {2 2} -fill {separation Gold {cmyk 0 0.2 0.8 0}}
  lappend codes [catch {$doc icc embed Gold $srgbIcc} m4]
  $doc destroy
  list $codes [string match {*already embedded*} $m1] \
      [string match {*colour space family*} $m2] \
      [string match {*already names an ICC profile*} $m3] \
      [string match {*already names a separation*} $m4]
} -result {{1 1 1 1} 1 1 1 1}

test color-icc-7.7 {a file that is no profile is refused at the call, with nothing kept} -body {
  set path [::tclpdfTest::scratch not-a-profile.icc]
  set fh [open $path wb]
  puts -nonewline $fh [string repeat x 200]
  close $fh
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc icc embed junk $path} message]
  set names [$doc icc names]
  $doc destroy
  file delete $path
  list $code [string match {*is not an ICC profile*acsp*} $message] $names
} -result {1 1 {}}

test color-icc-7.8 {a profile serving as colour space AND output intent stands in the file once} \
    -constraints haveSrgbIcc -body {
  # [pdfa] embeds the shipped sRGB profile as the output intent;
  # registering the same file as a colour space must not add a second
  # stream - the intent's DestOutputProfile points at the very object the
  # ICCBased array points at. Counted by the header signature, which with
  # -compress 0 appears once per embedded profile and nowhere else.
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc pdfa -part 3
  $doc icc embed srgb $srgbIcc
  $doc rect -at {20 20} -size {40 20} -fill {icc srgb 0.2 0.45 0.75}
  set path [::tclpdfTest::scratch icc-shared.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/ICCBased (\d+) 0 R} $bytes -> arrayTarget
  regexp {/DestOutputProfile (\d+) 0 R} $bytes -> intentTarget
  list [regexp -all {acsp} $bytes] [expr {$arrayTarget == $intentTarget}]
} -result {1 1}

test color-icc-7.9 {under a CMYK intent the ICC colour passes where DeviceRGB is refused} \
    -constraints {haveSrgbIcc haveCmykIcc} -body {
  # The point of the space: ISO 19005-2, 6.2.4.3 holds DEVICE colours
  # against the intent, and an ICCBased colour carries its own profile -
  # so the same three numbers pass under the press profile where the bare
  # triplet fails. Measured with veraPDF 1.30.2, see 7.10.
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3 -profile $cmykIcc
  $doc icc embed srgb $srgbIcc
  $doc rect -at {20 20} -size {40 20} -fill {icc srgb 0.2 0.45 0.75}
  set fine [::tclpdfTest::writes $doc icc-cmyk-intent.pdf]
  $doc destroy
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3 -profile $cmykIcc
  $doc rect -at {20 20} -size {40 20} -fill {rgb 0.2 0.45 0.75}
  set code [catch {$doc write [::tclpdfTest::scratch icc-cmyk-rgb.pdf]} message]
  $doc destroy
  file delete [::tclpdfTest::scratch icc-cmyk-rgb.pdf]
  list $fine $code [string match {*cannot carry DeviceRGB*} $message]
} -result {{0 1} 1 1}

test color-icc-7.10 {veraPDF, where present: 3B passes with ICC colour under the CMYK intent} \
    -constraints {haveSrgbIcc haveCmykIcc} -body {
  set doc [tclpdf new]
  $doc page add
  $doc pdfa -part 3 -profile $cmykIcc
  $doc icc embed srgb $srgbIcc
  $doc rect -at {20 20} -size {40 20} -fill {icc srgb 0.2 0.45 0.75} \
      -stroke {icc srgb 1 0 0}
  set path [::tclpdfTest::scratch icc-verapdf.pdf]
  $doc write $path
  $doc destroy
  set result ok
  if {[auto_execok verapdf] ne {}} {
    catch {exec verapdf -f 3b $path 2>@1} report
    if {![regexp {failedChecks="0"} $report]} {
      set result $report
    }
  }
  file delete $path
  set result
} -result ok

test color-icc-7.11 {a second write is byte-identical} -constraints haveSrgbIcc -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc pdfa -part 3
  $doc icc embed srgb $srgbIcc
  $doc rect -at {20 20} -size {40 20} -fill {icc srgb 0.2 0.45 0.75}
  lassign [::tclpdfTest::writeTwice $doc icc-twice] first second
  $doc destroy
  list [expr {$first eq $second}] [regexp -all {acsp} $first]
} -result {1 1}

test color-icc-7.12 {a shading stop cannot be an ICC colour, and the refusal writes nothing} \
    -constraints haveSrgbIcc -body {
  # A shading names its space by FAMILY in its dictionary, which an ICC
  # based space does not have - refused where the stops are collected,
  # before the function object goes out.
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc icc embed srgb $srgbIcc
  set code [catch {$doc shading axial -at {20 20} -size {40 20} \
      -colors {{icc srgb 1 0 0} white}} message]
  set result [list $code [string match {*ICC based colour cannot stand here*} $message] \
      [::tclpdfTest::content $doc] [$doc colourSpacesUsed]]
  $doc destroy
  set result
} -result {1 1 {} {}}

test color-icc-7.13 {ICCBased is PDF 1.3, said at the call} -constraints haveSrgbIcc -body {
  set doc [tclpdf new -version 1.2]
  $doc page add
  $doc icc embed srgb $srgbIcc
  set code [catch {$doc rect -at {1 1} -size {2 2} -fill {icc srgb 1 0 0}} message]
  set result [list $code [string match {*an ICC based colour needs PDF 1.3*} $message] \
      [$doc colourSpacesUsed]]
  $doc destroy
  set result
} -result {1 1 {}}

test color-separation-6.3 {All and None are written as the special colourants they are} -body {
  set doc [tclpdf new -compress 0]
  $doc page add
  $doc rect -at {1 1} -size {2 2} -fill {separation All {cmyk 0 0 0 1}}
  $doc rect -at {1 1} -size {2 2} -stroke {separation None {gray 0}}
  set writer [$doc writer]
  set found {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[regexp {\[/Separation (/\w+) (/\w+)} [$writer body $number] -> name space]} {
      lappend found $name $space
    }
  }
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  list $found [regexp {/All cs\n1 scn} $stream] [regexp {/None CS\n1 SCN} $stream]
} -result {{/All /DeviceCMYK /None /DeviceGray} 1 1}

cleanupTests

# import.test --
#
# A page of an existing PDF, taken over as a form: the tokenizer, both
# cross-reference flavours, the box and rotation handling, the refusals.
#
# The fixtures are built here rather than shipped: the classic-table files
# come from tclpdf itself or are handcrafted byte for byte (which is what
# exercises the corners - a direct /Resources, a /Contents array, an
# inherited MediaBox, a literal string that looks like a reference), and
# the modern flavour is produced at test time by qpdf from the classic one,
# under the qpdf constraint.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::import
# The inventory is its own package since 2026-08-21; both stand on
# tclpdf::importRead, and the tests of both live in this file for now.
package require tclpdf::importInfo
source [file join [file dirname [info script]] helper.tcl]

testConstraint qpdf [expr {[auto_execok qpdf] ne {}}]

# The template most tests import: one A4 page written by tclpdf itself,
# with an embedded piece of everything a letterhead drags along - text in
# a standard face, a filled rectangle, a line.
proc ::tclpdfTest::template {{pages 1}} {
    set path [scratch import-template.pdf]
    set doc [tclpdf new -unit pt -format a4]
    for {set i 1} {$i <= $pages} {incr i} {
        $doc page add
        $doc rect -at {40 40} -size {515 60} -fill #e8e0f0
        $doc text "Template page $i" -at {60 78} -size 24
        $doc line -from {40 760} -to {555 760} -width 0.5
    }
    $doc write $path
    $doc destroy
    return $path
}

# --- the tokenizer ---------------------------------------------------------

test import-1.1 {a literal string that looks like a reference stays a string} -body {
    set pos 0
    ::tclpdf::importRead::Parse {(see 5 0 R for details)} pos
} -result {s {see 5 0 R for details}}

test import-1.2 {references and plain numbers are told apart by lookahead} -body {
    set pos 0
    set a [::tclpdf::importRead::Parse {[3 0 R 3 0 4]} pos]
    set pos 0
    set b [::tclpdf::importRead::Parse {<< /A 3 0 R /B 3 >>} pos]
    list $a $b
} -result {{a {{r {3 0}} {n 3} {n 0} {n 4}}} {d {A {r {3 0}} B {n 3}}}}

test import-1.3 {nested dictionaries, arrays, hex strings, booleans, null} -body {
    set pos 0
    ::tclpdf::importRead::Parse {<< /D << /X [<AB> true null] >> /N /Nm >>} pos
} -result {d {D {d {X {a {{h AB} {b true} {z {}}}}}} N {nm Nm}}}

test import-1.4 {string escapes: parentheses, octal, line continuation} -body {
    set pos 0
    ::tclpdf::importRead::Parse "(a\\(b\\)c \\101 d\\\ne)" pos
} -result {s {a(b)c A de}}

test import-1.5 {serializing renumbers references and re-escapes strings} -body {
    set pos 0
    set value [::tclpdf::importRead::Parse {<< /K [7 0 R (x\(y)] >>} pos]
    ::tclpdf::importRead::Serialize $value {7 12}
} -result {<< /K [ 12 0 R (x\(y) ] >>}

test import-1.6 {comments are whitespace} -body {
    set pos 0
    ::tclpdf::importRead::Parse "%note\n42" pos
} -result {n 42}

# --- the classic round trip ------------------------------------------------

test import-2.1 {an imported page is a form XObject with its own resources} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set size [$doc form size kopfbogen]
    set path [::tclpdfTest::scratch import-roundtrip.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    list [format %.2f [lindex $size 0]] [format %.2f [lindex $size 1]] \
        [regexp {/Subtype /Form} $bytes] [regexp {/Matrix \[} $bytes]
} -result {595.28 841.89 1 1}

test import-2.2 {placing twice stores the page once} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    $doc page add
    $doc form place kopfbogen -at {0 0} -scale 0.5
    set path [::tclpdfTest::scratch import-once.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    regexp -all {/Subtype /Form} $bytes
} -result 1

test import-2.3 {the second write is byte-identical} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    lassign [::tclpdfTest::writeTwice $doc import-twice] first second
    $doc destroy
    file delete $template
    expr {$first eq $second}
} -result 1

test import-2.4 {qpdf accepts the file} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-qpdf.pdf]
    $doc write $path
    $doc destroy
    set status [catch {exec qpdf --check $path} output]
    file delete $path $template
    list $status [regexp {(?i)no syntax or stream encoding errors} $output]
} -result {0 1}

# --- pages and refusals ----------------------------------------------------

test import-3.1 {-page picks a page of a multi-page file} -body {
    set template [::tclpdfTest::template 3]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import seite $template -page 2
    $doc form place seite -at {0 0}
    set path [::tclpdfTest::scratch import-page2.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    # Which page came along is read from the copied content: the pages
    # differ only in their drawn number.
    list [regexp {Template page 2} $bytes] [regexp {Template page 1} $bytes] \
        [regexp {Template page 3} $bytes]
} -result {1 0 0}

test import-3.2 {a page beyond the last is refused with the count} -body {
    set template [::tclpdfTest::template 3]
    set doc [tclpdf new]
    $doc page add
    set result [catch {$doc pdf import x $template -page 4} message]
    $doc destroy
    file delete $template
    list $result $message
} -match glob -result {1 {*has 3 pages - there is no page 4}}

test import-3.3 {an alias in use is refused} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new]
    $doc page add
    $doc pdf import x $template
    set result [catch {$doc pdf import x $template} message]
    $doc destroy
    file delete $template
    list $result $message
} -result {1 {tclpdf: a form named "x" already exists}}

test import-3.4 {-page takes a number counted from 1} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf import x y.pdf -page 0} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: -page of pdf import is a page number counted from 1, not "0"}}

test import-3.5 {unknown subcommand names the known one} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf export x y.pdf} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: unknown pdf subcommand "export" - known is: import}}

test import-3.6 {a missing file is refused by name} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf import x /no/such/file.pdf} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: no file "/no/such/file.pdf"}}

# THE SAME THREE REFUSALS FROM EVERY READING COMMAND: the checks sit at the
# reader's one entry (importRead.tcl, Open), so pdf import and the five
# information commands answer alike - a directory used to reach pdf import
# as POSIX EISDIR while pdf info already refused it by name.
test import-3.7 {a directory is refused by name, by pdf import and by pdf info alike} -setup {
    set dir [file join [::tcltest::temporaryDirectory] import-3.7-dir]
    file mkdir $dir
    set doc [tclpdf new]
} -body {
    set out {}
    foreach script [list [list $doc pdf import x $dir] \
            [list ::tclpdf::pdf pages $dir] [list ::tclpdf::pdf fonts $dir]] {
        set code [catch $script message options]
        lappend out $code [dict get $options -errorcode] \
            [string match {tclpdf: *is a directory*} $message]
    }
    set out
} -cleanup {
    $doc destroy
    file delete -force $dir
} -result {1 {TCLPDF IMPORT FILE} 1 1 {TCLPDF IMPORT FILE} 1 1 {TCLPDF IMPORT FILE} 1}

test import-3.8 {a file this user cannot read is refused by name, not as EACCES} \
        -constraints unreadableFile -setup {
    set path [file join [::tcltest::temporaryDirectory] import-3.8.pdf]
    close [open $path w]
    file attributes $path -permissions 0000
    set doc [tclpdf new]
} -body {
    set out {}
    foreach script [list [list $doc pdf import x $path] \
            [list ::tclpdf::pdf info $path]] {
        set code [catch $script message options]
        lappend out $code [dict get $options -errorcode] \
            [string match {tclpdf: *is not readable*} $message]
    }
    set out
} -cleanup {
    $doc destroy
    file attributes $path -permissions 0644
    file delete $path
} -result {1 {TCLPDF IMPORT FILE} 1 1 {TCLPDF IMPORT FILE} 1}

# --- the handcrafted corners ----------------------------------------------
#
# A file tclpdf would never write: MediaBox inherited from the page TREE,
# /Resources direct on the page, /Contents an ARRAY of two streams, a
# content string that contains "999 0 R" as text, an optional-content
# resource. Byte for byte, so the parser meets the real thing.

# One field of a cross-reference stream entry: "value" as "width" big-endian
# bytes (7.5.8.3). Width 0 produces no bytes, which is how /W [0 ...] is spelt.
proc ::tclpdfTest::field {value width} {
    set out {}
    for {set i [expr {$width - 1}]} {$i >= 0} {incr i -1} {
        append out [binary format c [expr {($value >> (8 * $i)) & 0xFF}]]
    }
    return $out
}

# A file whose newest (and only) cross-reference section is a stream (7.5.8):
# objects 1..n written plainly, then an xref stream as object n+1. "w" is the
# /W to declare, "encode" the widths the bytes are actually written with -
# the two differ where the point is a /W that lies. "mangle truncate" drops
# the last three bytes of the stream so it no longer covers every entry, and
# "mangle nowidths" leaves /W out altogether, which is how a file missing the
# required entry is spelt.
proc ::tclpdfTest::buildxref {name objects {w {1 4 2}} {extra {}} {mangle {}}
        {encode {}}} {
    set out "%PDF-1.5\n"
    set offsets {}
    set number 0
    foreach body $objects {
        lappend offsets [string length $out]
        append out "[incr number] 0 obj\n$body\nendobj\n"
    }
    set xrefnum [expr {$number + 1}]
    set xrefoff [string length $out]
    if {$encode eq {}} {
        set encode $w
    }
    lassign $encode w0 w1 w2
    set data {}
    append data [field 0 $w0] [field 0 $w1] [field 65535 $w2]
    foreach offset $offsets {
        append data [field 1 $w0] [field $offset $w1] [field 0 $w2]
    }
    append data [field 1 $w0] [field $xrefoff $w1] [field 0 $w2]
    if {$mangle eq "truncate"} {
        set data [string range $data 0 end-3]
    }
    set widths "/W \[[join $w { }]\] "
    if {$mangle eq "nowidths"} {
        set widths {}
    }
    set dict "<< /Type /XRef /Size [expr {$xrefnum + 1}] /Root 1 0 R\
        $widths/Length [string length $data] $extra >>"
    append out "$xrefnum 0 obj\n$dict\nstream\n$data\nendstream\nendobj\n"
    append out "startxref\n$xrefoff\n%%EOF\n"
    set path [scratch $name]
    set ch [open $path wb]
    puts -nonewline $ch $out
    close $ch
    return $path
}

proc ::tclpdfTest::handcrafted {} {
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /Contents \[5 0 R 6 0 R\]\
        /Resources << /Font << /Helv 4 0 R >>\
        /Properties << /oc1 7 0 R >> >> >>"
    lappend objects "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"
    set one "BT /Helv 12 Tf 20 400 Td (half one) Tj ET"
    lappend objects "<< /Length [string length $one] >>\nstream\n$one\nendstream"
    set two "BT /Helv 12 Tf 20 380 Td (\\(999 0 R\\) is text) Tj ET"
    lappend objects "<< /Length [string length $two] >>\nstream\n$two\nendstream"
    lappend objects "<< /Type /OCG /Name (Layer) >>"
    return [buildpdf import-handcrafted.pdf $objects]
}

test import-4.1 {inherited MediaBox, direct resources, contents array, OCG} -body {
    set fixture [::tclpdfTest::handcrafted]
    # -compress 0 keeps the merged content readable for the assertions.
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import hand $fixture
    $doc form place hand -at {0 0}
    set size [$doc form size hand]
    set path [::tclpdfTest::scratch import-hand.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    list $size \
        [regexp {half one} $bytes] \
        [regexp {999 0 R\\\) is text} $bytes] \
        [regexp {/OCProperties} $bytes] \
        [regexp {/Type /OCG} $bytes]
} -result {{400.0 500.0} 1 1 1 1}

test import-4.2 {the two content streams are one stream, in order} -body {
    set fixture [::tclpdfTest::handcrafted]
    set doc [tclpdf new -unit pt -compress 0]
    $doc page add
    $doc pdf import hand $fixture
    $doc form place hand -at {0 0}
    set path [::tclpdfTest::scratch import-merge.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # One form, and "half one" before the second half inside it.
    list [regexp -all {/Subtype /Form} $bytes] \
        [expr {[string first {half one} $bytes] \
            < [string first {999 0 R} $bytes]}]
} -result {1 1}

# --- the modern flavour ----------------------------------------------------

test import-5.1 {object streams and cross-reference streams are read} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set modern [::tclpdfTest::scratch import-modern-src.pdf]
    exec qpdf --object-streams=generate $template $modern
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $modern
    $doc form place kopfbogen -at {0 0}
    set size [$doc form size kopfbogen]
    set path [::tclpdfTest::scratch import-modern.pdf]
    $doc write $path
    $doc destroy
    set status [catch {exec qpdf --check $path}]
    file delete $path $template $modern
    list [format %.2f [lindex $size 0]] $status
} -result {595.28 0}

test import-5.2 {an encrypted file is refused by name} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set locked [::tclpdfTest::scratch import-locked.pdf]
    exec qpdf --encrypt "" owner 256 -- $template $locked
    set doc [tclpdf new]
    $doc page add
    set result [catch {$doc pdf import x $locked} message]
    $doc destroy
    file delete $template $locked
    list $result [string match {*is encrypted - encrypted files are not imported} $message]
} -result {1 1}

test import-5.3 {/Rotate becomes the form's matrix and swaps its extent} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set turned [::tclpdfTest::scratch import-turned.pdf]
    exec qpdf $template --rotate=90:1 $turned
    set doc [tclpdf new -unit pt -format {841.89 595.276}]
    $doc page add
    $doc pdf import quer $turned
    $doc form place quer -at {0 0}
    set size [$doc form size quer]
    set path [::tclpdfTest::scratch import-turned-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template $turned
    list [format %.2f [lindex $size 0]] [format %.2f [lindex $size 1]] \
        [regexp {/Matrix \[0 -1 1 0 } $bytes]
} -result {841.89 595.28 1}

# --- inheritance: the nearest ancestor wins (7.7.3.4) -----------------------

test import-6.1 {inherited attributes come from the nearest ancestor, not the root} -body {
    # Root and intermediate node contradict each other in MediaBox AND
    # Rotate; the page is silent. The intermediate node is closer, so the
    # form is 400x500 turned by 270 - the wrong (top-down) reading answers
    # 100x100 turned by 90.
    set fixture [::tclpdfTest::buildpdf import-inherit.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 100 100\] /Rotate 90 >>" \
        "<< /Type /Pages /Parent 2 0 R /Kids \[4 0 R\] /Count 1 /MediaBox \[0 0 400 500\] /Rotate 270 >>" \
        "<< /Type /Page /Parent 3 0 R /Contents 5 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import erbe $fixture
    set size [$doc form size erbe]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-6.2 {the page's own attribute beats every ancestor} -body {
    set fixture [::tclpdfTest::buildpdf import-inherit-own.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 100 100\] >>" \
        "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 300 600\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import eigen $fixture
    set size [$doc form size eigen]
    $doc destroy
    file delete $fixture
    set size
} -result {300.0 600.0}

# --- CropBox is bounded by the MediaBox (14.11.2.2) --------------------------

test import-7.1 {a CropBox larger than the MediaBox is cut to their intersection} -body {
    # The two boxes come from DIFFERENT nodes: MediaBox inherited from the
    # tree, CropBox on the page. Without the intersection the form would be
    # 600x500.
    set fixture [::tclpdfTest::buildpdf import-crop.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /CropBox \[-100 -100 500 400\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import schnitt $fixture
    set size [$doc form size schnitt]
    $doc destroy
    file delete $fixture
    set size
} -result {200.0 200.0}

test import-7.2 {a CropBox that misses the MediaBox entirely is refused} -body {
    set fixture [::tclpdfTest::buildpdf import-crop-empty.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /CropBox \[300 300 400 400\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import leer $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: * the CropBox of page 1 does not intersect its MediaBox*}}

# --- #xx escapes in names (7.3.5.2) ------------------------------------------

test import-8.1 {/Ro#74ate is /Rotate: the escaped name turns the page} -body {
    set fixture [::tclpdfTest::buildpdf import-hash-rotate.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Ro#74ate 90 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import gedreht $fixture
    set size [$doc form size gedreht]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-8.2 {a resource name with a space survives the round trip byte-preservingly} -body {
    # The content stream travels verbatim and keeps /A#20B as written; the
    # resource dictionary is parsed (the key DECODES to "A B") and must be
    # re-escaped on the way out, or the two no longer name the same thing.
    set stream "BT /A#20B 12 Tf (x) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-hash-space.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Font << /A#20B 5 0 R >> >> >>" \
        "<< /Length [string length $stream] >>\nstream\n$stream\nendstream" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import raum $fixture
    $doc form place raum -at {0 0}
    set path [::tclpdfTest::scratch import-hash-space-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # Once in the copied resources dictionary, once in the content.
    regexp -all {/A#20B} $bytes
} -result 2

test import-8.3 {/Fl#61teDecode is FlateDecode and gets decoded} -body {
    package require tclpdf::filter
    set stream [::tclpdf::filter encodeFlate "BT /Helv 12 Tf 20 40 Td (half one) Tj ET"]
    set fixture [::tclpdfTest::buildpdf import-hash-filter.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length [string length $stream] /Filter /Fl#61teDecode >>\nstream\n$stream\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import flate $fixture
    $doc form place flate -at {0 0}
    set path [::tclpdfTest::scratch import-hash-filter-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    regexp {half one} $bytes
} -result 1

test import-8.4 {a # without two hex digits stays literal; Serialize re-escapes} -body {
    set pos 0
    set a [::tclpdf::importRead::Parse {/A#5x} pos]
    set pos 0
    set b [::tclpdf::importRead::Parse {/B#} pos]
    list $a $b [::tclpdf::importRead::Serialize {nm {A B}} {}] \
        [::tclpdf::importRead::Serialize {nm A#5x} {}]
} -result {{nm A#5x} {nm B#} /A#20B /A#235x}

# --- optional content: merging and OCMD (8.11.4.2, Table 98) -----------------

test import-9.1 {a second import merges its OCGs into the catalog entry} -body {
    set fixture [::tclpdfTest::handcrafted]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import eins $fixture
    $doc pdf import zwei $fixture
    set entry [$doc catalogEntry OCProperties]
    $doc destroy
    file delete $fixture
    regexp {/OCGs \[([^\]]*)\]} $entry -> ocgs
    regexp {/ON \[([^\]]*)\]} $entry -> on
    list [llength [regexp -all -inline {\d+ 0 R} $ocgs]] \
        [llength [regexp -all -inline {\d+ 0 R} $on]]
} -result {2 2}

test import-10.1 {an OCMD resolves to the groups behind it, not itself} -body {
    # /oc1 points at an OCMD whose /OCGs is a single reference, /oc2 at one
    # whose /OCGs is an array - both forms of Table 98. The catalog array
    # takes the two OCGs; the OCMDs are copied but stay out of it.
    set fixture [::tclpdfTest::buildpdf import-ocmd.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Properties << /oc1 5 0 R /oc2 6 0 R >> >> >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /OCMD /OCGs 7 0 R >>" \
        "<< /Type /OCMD /OCGs \[8 0 R\] >>" \
        "<< /Type /OCG /Name (One) >>" \
        "<< /Type /OCG /Name (Two) >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import ebenen $fixture
    $doc form place ebenen -at {0 0}
    set path [::tclpdfTest::scratch import-ocmd-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # Anchored at /OCProperties: the copied OCMDs carry /OCGs arrays of
    # their own, and an unanchored pattern reads one of those instead.
    regexp {/OCProperties << /OCGs \[([^\]]*)\]} $bytes -> inner
    set numbers [lmap {- number} [regexp -all -inline {(\d+) 0 R} $inner] {set number}]
    set kinds [lmap number $numbers {
        expr {[regexp "\n$number 0 obj\n<< /Type /OCG " $bytes] ? "ocg" : "other"}
    }]
    list [llength $numbers] $kinds [regexp {/Type /OCMD} $bytes]
} -result {2 {ocg ocg} 1}

# --- the transparency group of the imported form (PDF/A 6.2.4.3-2) ----------

test import-11.1 {the imported form carries the same group as form create} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-group.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    # Isolated, and deliberately WITHOUT /CS - see xObject.tcl.
    list [regexp {/Subtype /Form} $bytes] \
        [regexp {/Group << /S /Transparency /I true >>} $bytes] \
        [regexp {/Group <<[^>]*/CS} $bytes]
} -result {1 1 0}

test import-11.2 {a document older than PDF 1.4 gets no group} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4 -compress 0 -version 1.3]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-group-13.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    list [regexp {/Subtype /Form} $bytes] [regexp {/Group} $bytes]
} -result {1 0}

# --- /Length has to end at endstream (7.3.8.1) -------------------------------

test import-12.1 {a /Length overshooting the stream is refused, not copied as garbage} -body {
    set stream "BT (x) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-length.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length [expr {[string length $stream] + 40}] >>\nstream\n$stream\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import krumm $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *declares /Length 52 but does not end at endstream}}

# --- white space is six bytes, not Unicode (7.2.2, Table 1) ------------------

test import-13.1 {a raw 0xA0 byte is a regular character and does not split a name} -body {
    set pos 0
    set token [::tclpdf::importRead::Parse "/Na\xA0me 1" pos]
    list [lindex $token 0] [expr {[lindex $token 1] eq "Na\xA0me"}] \
        [::tclpdf::importRead::Serialize $token {}]
} -result {nm 1 /Na#A0me}

# --- /Rotate as a real, or not a multiple of 90 (defective files) ------------

test import-14.1 {an integer-valued real /Rotate 90.0 is read as 90} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-real.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 90.0 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import real $fixture
    set size [$doc form size real]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-14.2 {/Rotate 45 is refused by name, not silently ignored} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-45.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 45 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import schief $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *carries /Rotate 45, which is not a multiple of 90}}

test import-14.3 {a non-integral /Rotate is refused with a tclpdf message, not a raw Tcl error} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-frac.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 90.5 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import krumm $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *carries /Rotate "90.5", which is not usable as a multiple of 90}}

# --- a copied stream is a stream, not a hand-built object body ---------------
#
# The resource closure used to assemble "<<...>>\nstream\n...\nendstream" by
# hand and hand THAT to [put]. It was the one stream in the document that
# never saw [writer StreamBody] - so /Length had a second producer beside the
# writer's, and the filter check every other stream passes was skipped.

test import-15.1 {a Flate resource copied into a 1.1 document is refused, not smuggled in} -body {
    # -compress 0, so the only deflated stream in the file is the one the
    # import copies: what the check answers about is unambiguous.
    set stream [::tclpdf::filter encodeFlate "q Q"]
    set fixture [::tclpdfTest::buildpdf import-old-flate.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\]\
            /Filter /FlateDecode /Length [string length $stream] >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -version 1.1 -compress 0]
    $doc page add
    set result [catch {$doc pdf import alt $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: a FlateDecode stream *needs PDF 1.2*}}

test import-15.2 {the copied stream carries one /Length, the writer's, and its bytes are untouched} -body {
    # The fixture states its length INDIRECTLY, which is legal (7.3.8.2) and
    # is why the copy may not simply carry the entry over: object 6 is not
    # part of the resource closure and never travels.
    set stream "q 1 0 0 1 0 0 cm Q"
    set fixture [::tclpdfTest::buildpdf import-indirect-length.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\] /Length 6 0 R >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "[string length $stream]"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import laenge $fixture
    $doc form place laenge -at {0 0}
    set writer [$doc writer]
    set found {}
    for {set number 1} {$number <= [$writer count]} {incr number} {
        set body [$writer body $number]
        if {[string match {*/Subtype /Form*} $body]
                && [string match "*$stream*" $body]} {
            lappend found [regexp -all {/Length} $body] \
                [regexp "/Length [string length $stream]" $body] \
                [::tclpdfTest::streamOf $writer $number]
        }
    }
    $doc destroy
    file delete $fixture
    set found
} -result [list 1 1 "q 1 0 0 1 0 0 cm Q"]

test import-15.3 {the refusal falls before the numbers, so the document writes on} -body {
    # THE SECOND HALF OF import-15.1, and the half that was never measured:
    # the refusal was right and the document was ruined all the same. The
    # check sat in [writer stream], which the copied objects reach in the
    # SECOND loop of the import - after every number of the resource closure
    # has been reserved - so a [pdf import] the caller caught left numbers
    # reserved and never filled, and the next [write] of the whole document
    # died with "object(s) reserved but never written" (measured 2026-08-25:
    # one number lost, and the document unwritable). The check is asked of
    # the writer in the first loop now, before the reservation, and the
    # sentence it answers with is the one import-15.1 reads.
    #
    # /Filter as an INDIRECT reference in the second document, because that
    # is legal (7.4) and is what makes the reading a [Resolve] rather than a
    # [lindex]: a filter the check cannot see is a deflated resource in a
    # file whose header disowns the filter.
    set stream [::tclpdf::filter encodeFlate "q Q"]
    set direct [::tclpdfTest::buildpdf import-flate-writes.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\]\
            /Filter /FlateDecode /Length [string length $stream] >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set indirect [::tclpdfTest::buildpdf import-flate-indirect.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\]\
            /Filter 6 0 R /Length [string length $stream] >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "/FlateDecode"]]
    set answers {}
    foreach fixture [list $direct $indirect] {
        set doc [tclpdf new -unit pt -format a4 -version 1.1 -compress 0]
        $doc page add
        $doc text "the document goes on" -at {20 20}
        set before [[$doc writer] count]
        set code [catch {$doc pdf import alt $fixture} message]
        set after [[$doc writer] count]
        lappend answers $code [expr {$before == $after}] \
            [string match {tclpdf: a FlateDecode stream *needs PDF 1.2*} $message] \
            [::tclpdfTest::writes $doc import-flate-after.pdf]
        $doc destroy
        file delete $fixture
    }
    set answers
} -result {1 1 1 {0 1} 1 1 1 {0 1}}

# --- the inventory: what a finished file says about itself -----------------
#
# [::tclpdf::pdf info|pages|fonts|metadata] stand on the reader above, so what
# is worth testing here is not that it reads - the sections before this one do
# that - but that it ANSWERS: the right value out of the right entry, and an
# empty one rather than a guess where the file says nothing. The fixtures are
# handcrafted wherever the answer turns on a corner (a text string in three
# encodings, a face reachable only through an annotation, a cross-reference
# chain that runs forwards), and written by tclpdf itself wherever the point
# is that a real document comes back the way it went in.

set inventoryFont [file join [file dirname [file dirname [file normalize \
    [info script]]]] examples assets fonts DejaVuSans.ttf]
testConstraint haveFont [file exists $inventoryFont]

test import-16.1 {info answers out of the trailer, the catalog and page one} -body {
    set path [::tclpdfTest::scratch import-info.pdf]
    set doc [tclpdf new -unit pt -format a4]
    $doc info Title "Ein Bericht"
    $doc info Author "Erika Mustermann"
    $doc page add
    $doc text "one" -at {50 50}
    $doc page add
    $doc text "two" -at {50 50}
    $doc write $path
    $doc destroy
    set facts [::tclpdf::pdf info $path]
    set result [list [dict get $facts pages] [dict get $facts encrypted] \
        [dict get $facts revisions] [dict get $facts sections] \
        [dict get $facts xref] [dict get $facts tagged] \
        [dict get $facts form] [dict get $facts xmp] \
        [dict get $facts info Title] [dict get $facts info Author] \
        [expr {[dict get $facts bytes] == [file size $path]}] \
        [lmap number [dict get $facts size] {format %.2f $number}]]
    file delete $path
    set result
} -result {2 0 1 1 table 0 none 0 {Ein Bericht} {Erika Mustermann} 1\
        {595.28 841.89}}

test import-16.2 {every key is there, also for a file that says nothing} -body {
    # No title, no metadata, no form, no attachment: those keys answer empty
    # rather than being absent, which is what lets a caller read a field
    # without first asking whether it exists.
    set fixture [::tclpdfTest::handcrafted]
    set facts [::tclpdf::pdf info $fixture]
    set missing {}
    foreach key {path bytes version catalogVersion xref sections revisions id
            encrypted encryption pages size info xmp pdfa pdfua tagged form
            outputIntents attachments signatures} {
        if {![dict exists $facts $key]} {
            lappend missing $key
        }
    }
    set result [list $missing [dict get $facts version] \
        [dict get $facts catalogVersion] [dict get $facts info] \
        [dict get $facts pdfa] [dict get $facts attachments] \
        [dict get $facts pages] [dict get $facts size] \
        [dict get $facts id]]
    file delete $fixture
    set result
} -result {{} 1.4 {} {} {} {} 1 {400 500} {}}

test import-16.3 {a title in UTF-16BE comes back as characters} -body {
    # Non-ASCII forces the UTF-16BE form on the writing side (7.9.2.2), so
    # this is the round trip of one encoder through one decoder. Written with
    # \u escapes rather than the characters themselves: what this checks must
    # not depend on the encoding this test file happens to be read in.
    set title "Gr\u00F6\u00DFenma\u00DFstab \u20AC"
    set path [::tclpdfTest::scratch import-info-utf16.pdf]
    set doc [tclpdf new -unit pt -format a4]
    $doc info Title $title
    $doc page add
    $doc write $path
    $doc destroy
    set found [dict get [::tclpdf::pdf info $path] info Title]
    file delete $path
    list [string equal $found $title] [string length $found]
} -result {1 15}

test import-16.4 {a literal string is PDFDocEncoding, not Latin-1} -body {
    # 0x95 is Lslash and 0xA0 the Euro sign in PDFDocEncoding (Annex D.2),
    # where Latin-1 has a control character and a no-break space; 0xE4 is
    # a-dieresis in both. The hexadecimal string with the byte order mark is
    # the same kind of value written the other way and must decode as text
    # just as a literal one does.
    set fixture [::tclpdfTest::buildpdf import-info-pdfdoc.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Title (\x95\xA0\xE4) /Author <FEFF00C4004100E4> >>"] \
        "/Info 5 0 R"]
    set facts [::tclpdf::pdf info $fixture]
    set result [list [dict get $facts info Title] \
        [dict get $facts info Author]]
    file delete $fixture
    set result
} -result [list "\u0141\u20AC\u00E4" "\u00C4A\u00E4"]

test import-16.5 {an archivable document reports its claim, its intent and its annex} \
        -constraints {haveTdom haveFont} -body {
    set path [::tclpdfTest::scratch import-info-pdfa.pdf]
    set doc [tclpdf new -unit pt -format a4]
    $doc font embed body $::inventoryFont
    $doc pdfa -part 3 -conformance B
    $doc info Title "An archivable document"
    $doc attach -data "<x/>" -name daten.xml -mime text/xml \
        -relationship Data -description "the data"
    $doc page add
    $doc font -family body -size 12
    $doc text "archivable" -at {50 50}
    $doc write $path
    $doc destroy
    set facts [::tclpdf::pdf info $path]
    set intent [lindex [dict get $facts outputIntents] 0]
    set annex [lindex [dict get $facts attachments] 0]
    set packet [::tclpdf::pdf metadata $path]
    set result [list [dict get $facts pdfa] [dict get $facts pdfua] \
        [dict get $facts xmp] [dict get $intent subtype] \
        [expr {[dict get $intent identifier] ne {}}] \
        [dict get $intent profile] [dict get $annex name] \
        [dict get $annex description] [dict get $annex relationship] \
        [dict get $annex mime] [dict get $annex size] \
        [string match "<?xpacket*" $packet] \
        [string match "*pdfaid:part*" $packet]]
    file delete $path
    set result
} -result {3B {} 1 GTS_PDFA1 1 1 daten.xml {the data} Data text/xml 4 1 1}

test import-16.6 {a claim written as an attribute is read like an element} -body {
    # Both spellings are legal RDF and both occur in the wild; the scan finds
    # either. The second packet states the same kind of claim as attributes on
    # the rdf:Description.
    set element {<?xpacket begin="" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF
xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description
rdf:about="" xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/">
<pdfaid:part>3</pdfaid:part><pdfaid:conformance>B</pdfaid:conformance>
</rdf:Description></rdf:RDF></x:xmpmeta><?xpacket end="w"?>}
    set attribute {<?xpacket begin="" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/"><rdf:RDF
xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"><rdf:Description
rdf:about="" xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"
xmlns:pdfuaid="http://www.aiim.org/pdfua/ns/id/"
pdfaid:part="2" pdfaid:conformance="U" pdfuaid:part="1"/>
</rdf:RDF></x:xmpmeta><?xpacket end="w"?>}
    set result {}
    foreach packet [list $element $attribute] {
        set fixture [::tclpdfTest::buildpdf import-info-claim.pdf [list \
            "<< /Type /Catalog /Pages 2 0 R /Metadata 5 0 R >>" \
            "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
            "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
            "<< /Length 3 >>\nstream\nq Q\nendstream" \
            "<< /Type /Metadata /Subtype /XML /Length [string length $packet] >>\
                \nstream\n$packet\nendstream"]]
        set facts [::tclpdf::pdf info $fixture]
        lappend result [dict get $facts pdfa] [dict get $facts pdfua] \
            [dict get $facts xmp] \
            [string equal [::tclpdf::pdf metadata $fixture] $packet]
        file delete $fixture
    }
    set result
} -result {3B {} 1 1 2U 1 1 1}

test import-16.7 {a tagged document says so, an untagged one says no} -body {
    # /MarkInfo /Marked is the catalog's own statement (14.7.1) - what it does
    # NOT say is whether the structure tree behind it is any good, which is
    # veraPDF's and ua.tcl's question rather than this one's.
    set result {}
    foreach marked {true false} {
        set fixture [::tclpdfTest::buildpdf import-marked.pdf [list \
            "<< /Type /Catalog /Pages 2 0 R\
                /MarkInfo << /Marked $marked >> >>" \
            "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
            "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
            "<< /Length 3 >>\nstream\nq Q\nendstream"]]
        lappend result [dict get [::tclpdf::pdf info $fixture] tagged]
        file delete $fixture
    }
    set fixture [::tclpdfTest::handcrafted]
    lappend result [dict get [::tclpdf::pdf info $fixture] tagged]
    file delete $fixture
    set result
} -result {1 0 0}

test import-17.1 {pages: the boxes as written, the extent as a viewer shows it} -body {
    # The CropBox is what a viewer shows, bounded by the MediaBox (14.11.2.2),
    # and a /Rotate of 90 swaps the extent: the page comes out landscape
    # although both its boxes are portrait.
    set fixture [::tclpdfTest::buildpdf import-pages-boxes.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R 5 0 R\] /Count 2\
            /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /CropBox \[20 30 380 430\] /Rotate 90 >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>"]]
    set pages [::tclpdf::pdf pages $fixture]
    file delete $fixture
    list [llength $pages] [lindex $pages 0] [lindex $pages 1]
} -result {2 {number 1 mediabox {0 0 400 500} cropbox {20 30 380 430} rotate 90\
        width 400 height 360} {number 2 mediabox {0 0 400 500} cropbox {}\
        rotate 0 width 400 height 500}}

test import-17.2 {a page whose /Rotate is unusable is named, not silently squared} -body {
    set fixture [::tclpdfTest::buildpdf import-pages-rotate.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 45 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set result [catch {::tclpdf::pdf pages $fixture} message]
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *page 1 carries /Rotate 45, which is not a\
        multiple of 90}}

test import-18.1 {fonts: a standard face and an embedded subset, told apart} \
        -constraints haveFont -body {
    set path [::tclpdfTest::scratch import-fonts.pdf]
    set doc [tclpdf new -unit pt -format a4]
    $doc font embed haus $::inventoryFont
    $doc page add
    $doc font -family helvetica -size 12
    $doc text "standard" -at {50 50}
    $doc font -family haus -size 12
    $doc text "embedded" -at {50 80}
    $doc write $path
    $doc destroy
    set found {}
    foreach face [::tclpdf::pdf fonts $path] {
        lappend found [list [dict get $face subtype] [dict get $face cid] \
            [regsub {^[A-Z]{6}\+} [dict get $face basefont] {}] \
            [dict get $face subset] [dict get $face embedded] \
            [dict get $face file] [dict get $face encoding] \
            [dict get $face pages]]
    }
    file delete $path
    lsort $found
} -result {{Type0 CIDFontType2 DejaVuSans 1 1 FontFile2 Identity-H 1}\
        {Type1 {} Helvetica 0 0 {} WinAnsiEncoding 1}}

test import-18.2 {a face used only in an annotation's appearance is found} -body {
    # pdffonts does not report this one - measured on a foreign form whose 35
    # checkbox appearances all name ZapfDingbats - and the file uses it all
    # the same: an unembedded face inside an appearance stream is as missing
    # on the other machine as one in the page content.
    set appearance "BT /ZaDb 9 Tf (4) Tj ET"
    set stream "<< /Type /XObject /Subtype /Form /BBox \[0 0 12 12\]\
        /Resources << /Font << /ZaDb 9 0 R >> >>\
        /Length [string length $appearance] >>\nstream\n$appearance\nendstream"
    set fixture [::tclpdfTest::buildpdf import-fonts-annot.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R /Annots \[5 0 R\]\
            /Resources << /Font << /F1 8 0 R >> >> >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /Annot /Subtype /Widget /Rect \[10 10 22 22\]\
            /AP << /N << /Off 6 0 R /On 6 0 R >> /D 7 0 R >> >>" \
        $stream $stream \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /ZapfDingbats /Name /ZaDb >>"]]
    set found {}
    foreach face [::tclpdf::pdf fonts $fixture] {
        lappend found [list [dict get $face object] \
            [dict get $face basefont] [dict get $face embedded] \
            [dict get $face pages]]
    }
    file delete $fixture
    lsort $found
} -result {{8 Helvetica 0 1} {9 ZapfDingbats 0 1}}

test import-18.3 {a Type 3 face names itself through its descriptor} -body {
    # /BaseFont is not for Type 3 (9.6.5), so the name every reader shows is
    # the descriptor's /FontName - and its glyphs, being content streams of
    # this file, count as embedded.
    set glyph "10 0 0 0 10 10 d1 0 0 10 10 re f"
    set fixture [::tclpdfTest::buildpdf import-fonts-type3.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Font << /T3 5 0 R >> >> >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /Font /Subtype /Type3 /Name /Kaesten\
            /FontBBox \[0 0 10 10\] /FontMatrix \[0.001 0 0 0.001 0 0\]\
            /CharProcs << /kasten 6 0 R >> /FirstChar 97 /LastChar 97\
            /Widths \[10\] /FontDescriptor 7 0 R\
            /Encoding << /Type /Encoding /Differences \[97 /kasten\] >> >>" \
        "<< /Length [string length $glyph] >>\nstream\n$glyph\nendstream" \
        "<< /Type /FontDescriptor /FontName /ABCDEF+Kaesten /Flags 4 >>"]]
    set face [lindex [::tclpdf::pdf fonts $fixture] 0]
    file delete $fixture
    list [dict get $face subtype] [dict get $face basefont] \
        [dict get $face subset] [dict get $face embedded] \
        [dict get $face file] [dict get $face differences] \
        [dict get $face encoding]
} -result {Type3 ABCDEF+Kaesten 1 1 CharProcs 1 {}}

test import-19.1 {an encrypted file is answered out of its trailer} -body {
    set path [::tclpdfTest::scratch import-encrypted.pdf]
    set doc [tclpdf new -unit pt -format a4 -version 2.0]
    $doc encrypt -user geheim -owner nochgeheimer -permissions {print}
    $doc info Title "Not readable without the key"
    $doc page add
    $doc text "secret" -at {50 50}
    $doc write $path
    $doc destroy
    set facts [::tclpdf::pdf info $path]
    file delete $path
    # /P is handed on as the number it is; which bits it has is encrypt.tcl's
    # business and is tested there, so what is checked here is that a number
    # arrives at all. /Length belongs to V 2 and 3 (Table 20) and is not
    # written at V 5, so that key arrives empty.
    list [dict get $facts encrypted] \
        [dict remove [dict get $facts encryption] p] \
        [string is entier -strict [dict get $facts encryption p]] \
        [dict get $facts pages] [dict get $facts size] \
        [dict get $facts info] [dict get $facts xmp] \
        [llength [dict get $facts id]] [dict get $facts revisions] \
        [dict get $facts version]
} -result {1 {filter Standard subfilter {} v 5 r 6 length {} method AESV3}\
        1 {} {} {} 0 2 1 2.0}

test import-19.2 {what needs the key is refused by name, not answered wrongly} -body {
    set path [::tclpdfTest::scratch import-encrypted-refused.pdf]
    set doc [tclpdf new -unit pt -format a4 -version 2.0]
    $doc encrypt -user geheim -owner nochgeheimer
    $doc page add
    $doc text "secret" -at {50 50}
    $doc write $path
    $doc destroy
    set result {}
    foreach subcommand {pages fonts metadata} {
        lappend result [catch {::tclpdf::pdf $subcommand $path} message] \
            [string match "*is encrypted*" $message]
    }
    file delete $path
    set result
} -result {1 1 1 1 1 1}

test import-20.1 {revisions: a section appended behind the file counts} -body {
    set base [::tclpdfTest::buildpdf import-revisions.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set bytes [::tclpdfTest::readBytes $base]
    regexp {startxref\s+(\d+)\s+%%EOF} $bytes -> first

    # An incremental update (7.5.6): one changed object and a section of its
    # own, appended - so its offset is HIGHER than the one its /Prev names.
    set update $bytes
    set offset [string length $update]
    append update "3 0 obj\n<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
        /Rotate 90 >>\nendobj\n"
    set second [string length $update]
    append update "xref\n0 1\n0000000000 65535 f \n3 1\n"
    append update [format "%010d 00000 n \n" $offset]
    append update "trailer\n<< /Size 5 /Root 1 0 R /Prev $first >>\n"
    append update "startxref\n$second\n%%EOF\n"
    set updated [::tclpdfTest::scratch import-revisions-updated.pdf]
    set channel [open $updated wb]
    puts -nonewline $channel $update
    close $channel

    set facts [::tclpdf::pdf info $updated]
    set page [lindex [::tclpdf::pdf pages $updated] 0]
    set result [list [dict get [::tclpdf::pdf info $base] revisions] \
        [dict get $facts sections] [dict get $facts revisions] \
        [dict get $page rotate]]
    file delete $base $updated
    set result
} -result {1 2 2 90}

test import-20.2 {a chain that runs forwards is one revision, not two} -body {
    # The shape a LINEARIZED file arrives in (Annex F): the section a reader
    # starts at lies at the front of the file and chains FORWARDS to the main
    # one at the end. Two sections, written in one go - one revision. The
    # front section here carries no entries of its own, which is legal and is
    # all this question turns on.
    #
    # /Prev is written into a fixed-width field and filled in afterwards: the
    # offset it has to name depends on how long the section naming it is.
    set objects [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]
    set out "%PDF-1.4\n"
    set front [string length $out]
    append out "xref\n0 1\n0000000000 65535 f \ntrailer\n<< /Size 5\
        /Root 1 0 R /Prev @@@@@@@@@@ >>\n"
    set offsets {}
    set number 0
    foreach body $objects {
        lappend offsets [string length $out]
        append out "[incr number] 0 obj\n$body\nendobj\n"
    }
    set main [string length $out]
    append out "xref\n0 [expr {$number + 1}]\n"
    append out [format "%010d %05d f \n" 0 65535]
    foreach offset $offsets {
        append out [format "%010d %05d n \n" $offset 0]
    }
    append out "trailer\n<< /Size [expr {$number + 1}] /Root 1 0 R >>\n"
    append out "startxref\n$front\n%%EOF\n"
    # The placeholder is ten characters wide and so is what replaces it -
    # trailing spaces inside the dictionary are white space (7.2.2).
    set out [string map [list @@@@@@@@@@ [format %-10s $main]] $out]
    set path [::tclpdfTest::scratch import-revisions-forward.pdf]
    set channel [open $path wb]
    puts -nonewline $channel $out
    close $channel
    set facts [::tclpdf::pdf info $path]
    file delete $path
    list [dict get $facts sections] [dict get $facts revisions] \
        [dict get $facts pages]
} -result {2 1 1}

test import-21.1 {signatures: what the field claims, and whether it covers the file} -body {
    # A signature that no longer reaches the last byte of the file is one the
    # file was written on after signing. That is arithmetic over /ByteRange
    # (12.8.1) and it is the one thing about a signature this reader decides;
    # whether the digest holds is pdfsig's business. The name is the field
    # widget the field draws itself with is not a second field, and it is
    # the field that carries the signature dictionary (12.7.4.2).
    set contents [string repeat 0 512]
    set fixture [::tclpdfTest::buildpdf import-signature.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields \[5 0 R\] >> >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R /Annots \[6 0 R\] >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /FT /Sig /T (Freigabe) /Kids \[6 0 R\] /V 7 0 R >>" \
        "<< /Type /Annot /Subtype /Widget /Parent 5 0 R /Rect \[0 0 0 0\] >>" \
        "<< /Type /Sig /Filter /Adobe.PPKLite /SubFilter /adbe.pkcs7.detached\
            /Name (Erika Mustermann) /Reason (Approved) /Location (Bochum)\
            /M (D:20260821101228+02'00') /ByteRange \[0 100 900 200\]\
            /Contents <$contents> >>"]]
    set facts [::tclpdf::pdf info $fixture]
    set signature [lindex [dict get $facts signatures] 0]
    file delete $fixture
    list [dict get $facts form] [llength [dict get $facts signatures]] \
        [dict get $signature field] [dict get $signature filter] \
        [dict get $signature subfilter] [dict get $signature name] \
        [dict get $signature reason] [dict get $signature location] \
        [dict get $signature date] [dict get $signature byterange] \
        [dict get $signature whole]
} -result {AcroForm 1 Freigabe Adobe.PPKLite adbe.pkcs7.detached\
        {Erika Mustermann} Approved Bochum D:20260821101228+02'00'\
        {0 100 900 200} 0}

test import-21.2 {a signature reaching the last byte says so} -body {
    # The same field over a file whose /ByteRange ends exactly at its length,
    # which is what a signer writes.
    set fixture [::tclpdfTest::buildpdf import-signature-whole.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields \[5 0 R\] >> >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /FT /Sig /T (Freigabe) /V 6 0 R >>" \
        "<< /Type /Sig /ByteRange \[0 10 20 30 \] >>"]]
    set size [file size $fixture]
    set bytes [string map [list "\[0 10 20 30 \]" \
        [format {[0 10 %d %d]} [expr {$size - 40}] 40]] \
        [::tclpdfTest::readBytes $fixture]]
    set channel [open $fixture wb]
    puts -nonewline $channel $bytes
    close $channel
    set signature [lindex [dict get [::tclpdf::pdf info $fixture] signatures] 0]
    set range [dict get $signature byterange]
    file delete $fixture
    list [dict get $signature field] [dict get $signature whole] \
        [dict get $signature subfilter] \
        [expr {[lindex $range 2] + [lindex $range 3] == $size}]
} -result {Freigabe 1 {} 1}

test import-22.1 {a file that is not one is refused with its name} -body {
    set path [::tclpdfTest::scratch import-nonsense.txt]
    set channel [open $path wb]
    puts -nonewline $channel "this is not a PDF"
    close $channel
    set result [catch {::tclpdf::pdf info $path} message]
    file delete $path
    list $result $message
} -match glob -result {1 {tclpdf: *carries no startxref*}}

test import-22.1a {a file that is not there is refused by name} -body {
    set result {}
    foreach subcommand {info pages fonts metadata} {
        lappend result [catch {::tclpdf::pdf $subcommand \
            [::tclpdfTest::scratch import-absent.pdf]} message] $message
    }
    lsort -unique $result
} -match glob -result {1 {tclpdf: no file "*import-absent.pdf"}}

test import-22.2 {a broken stream is refused naming the file, not by zlib} -body {
    # Without this the answer is zlib's own "stream error": three words, no
    # file, no place. One of 106 foreign files measured arrives that way.
    set broken [string range [::tclpdf::filter encodeFlate "q Q"] 0 3]
    set fixture [::tclpdfTest::buildpdf import-broken-stream.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R /Metadata 5 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 99 99\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /Metadata /Subtype /XML /Filter /FlateDecode\
            /Length [string length $broken] >>\nstream\n$broken\nendstream"]]
    set result [catch {::tclpdf::pdf metadata $fixture} message]
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *import-broken-stream.pdf: the metadata\
        stream is a /FlateDecode stream this package cannot decode:*}}

test import-22.3 {the cross-reference flavour is the newest section's} \
        -constraints qpdf -body {
    # A hybrid file keeps the classic table its newest section is written in,
    # although a stream completes it (7.5.8.4); a file qpdf has converted
    # answers "stream".
    set classic [::tclpdfTest::handcrafted]
    set streamed [::tclpdfTest::scratch import-flavour-stream.pdf]
    exec qpdf --object-streams=generate $classic $streamed
    set result [list [dict get [::tclpdf::pdf info $classic] xref] \
        [dict get [::tclpdf::pdf info $streamed] xref]]
    file delete $classic $streamed
    set result
} -result {table stream}

# --- LZW content streams (roadmap item 7) -----------------------------------
#
# LZW was the general-purpose filter before PDF 1.2, and until the TIFF work
# brought a decoder into the package an LZW content stream was refused by
# name. The bytes below were produced by an independent encoder and checked
# back through [::tclpdf::filter decodeLzw] before they were written down - a
# fixture nobody can read by eye has to say where it came from.
#
# ELEVEN lines, not one, and that is the point of the fixture: /EarlyChange
# decides when the code width grows, and a short stream never reaches the
# first boundary, so the parameter would be untestable. Measured: with four to
# ten lines both values decode the same bytes; from eleven on the wrong one
# fails outright.

proc ::tclpdfTest::lzwpage {{extra {}}} {
    set stream [binary format H* [string cat \
        80108A82017920CA6C3B080623210150CC20190C040341B448A86410 \
        0A0D86937194411237C3CE8688F1B0F4771018CDE6E3A1965829869A \
        840452A02A050483422150C8744224341A4F2311A8E4786220908824 \
        72593CA6572D97CC667359BC160F0985C361F11898C8690DA1C6E3B1 \
        0A448A4820934A2552C971D26054994D26D03AB4EAB33DAE0D06036B \
        0466C51E19D969567B4D3AD951B854EE738ABCEEB53E100CC7038BED \
        12C75FA4D2ED14DB5D42DD52B955673589E56E24331BC5AC345100D7 \
        059AC2E76DB6FB8D52E9A3C75E34E35A15FB597CCCE13394FD9E836D \
        8CBB697203319D7E2FBEB18DF5FC2B571311B5C5DD7498FAE0CC637C \
        E7E5A3D94E0D33AB87CFE2743B7C6DDF4D101CE53C37F100E7A7E6C3 \
        67B698AD17B794AE0641C354E828C902CCFC364EBAA68080]]
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1\
        /MediaBox \[0 0 400 500\] >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
        /Resources << /Font << /Helv 4 0 R >> >> >>"
    lappend objects "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"
    lappend objects "<< /Length [string length $stream] /Filter /LZWDecode\
        $extra >>\nstream\n$stream\nendstream"
    return [::tclpdfTest::buildpdf import-lzw.pdf $objects]
}

test import-23.1 {an LZW content stream is read} -body {
    set fixture [::tclpdfTest::lzwpage]
    # -compress 0 keeps the merged content readable for the assertions.
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import lzw $fixture
    $doc form place lzw -at {0 0}
    set size [$doc form size lzw]
    set path [::tclpdfTest::scratch import-lzw-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # The LAST line, not the first: everything up to the first width change
    # decodes the same however the parameter is read.
    list $size [regexp {line 0 of the lzw content} $bytes] \
        [regexp {line 10 of the lzw content} $bytes]
} -result {{400.0 500.0} 1 1}

test import-23.2 {/EarlyChange reaches the decoder} -body {
    # The one parameter that changes the bytes without changing the length in
    # any way a reader would notice. Declared wrongly, this stream cannot be
    # decoded at all - if it decodes, the parameter never arrived.
    set fixture [::tclpdfTest::lzwpage "/DecodeParms << /EarlyChange 0 >>"]
    set doc [tclpdf new]
    $doc page add
    set failed [catch {$doc pdf import lzw $fixture} message]
    $doc destroy
    file delete $fixture
    list $failed [string match {*/LZWDecode stream this package cannot decode*} $message]
} -result {1 1}


# --- hostile and broken files: a refusal, never a loop or a raw error -------
#
# A file from outside is not a friend. Every fixture below is a plausible
# corruption or a deliberate attack, and each of them used to end in a raw
# Tcl message, an endless loop or a recursion crash rather than in a refusal
# that begins with "tclpdf:" - the guarantee of doc/tclpdf.md, "Error codes".
# [refuse] checks all three at once: that it refused, that the message opens
# with "tclpdf:", and which -errorcode it carries.

# The three objects every one of these files needs: a catalogue, a page tree
# and one page.
proc ::tclpdfTest::threePages {} {
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 200\] >>"
    return $objects
}

test import-24.1 {a truncated or corrupt array or dictionary is refused, not looped over} -body {
    # The first is the whole point: before this, an array without its "]"
    # made [Parse] append for ever - measured at 4.4 GB after 14 seconds.
    set out {}
    foreach bytes [list {[0 0 595 842} {[1 2 )]} "<< /A 1" {<< 5 /A >>} \
            {(no end} {<AB} ] {
        set pos 0
        lappend out [::tclpdfTest::refuse {
            ::tclpdf::importRead::Parse $bytes pos
        }]
    }
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT SYNTAX}}}

test import-24.2 {nesting deeper than the reader follows is refused, not a stack crash} -body {
    set pos 0
    set deep "[string repeat {[} 5000][string repeat {]} 5000]"
    set parsed [::tclpdfTest::refuse {
        ::tclpdf::importRead::Parse $deep pos
    }]
    # Serialize and Refs walk the same structure and are capped with it.
    set value {n 1}
    for {set i 0} {$i < 600} {incr i} {
        set value [list a [list $value]]
    }
    list $parsed [::tclpdfTest::refuse {
        ::tclpdf::importRead::Serialize $value {}
    }] [::tclpdfTest::refuse {
        ::tclpdf::importRead::Refs $value
    }]
} -result {{1 1 {TCLPDF IMPORT DEPTH}} {1 1 {TCLPDF IMPORT DEPTH}}\
    {1 1 {TCLPDF IMPORT DEPTH}}}

# A file plus an incremental update (7.5.4) that FREES object 4, the page's
# content stream - written once as a classic table and once as a
# cross-reference stream, because the two flavours record a free entry
# differently (an "f" line, 7.5.4; a type 0 record, 7.5.8.3).
proc ::tclpdfTest::freedFixture {name flavour} {
    set objects [threePages]
    lset objects 2 "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 200\]\
        /Contents 4 0 R >>"
    set body "BT /F1 24 Tf 40 100 Td (WITHDRAWN) Tj ET"
    lappend objects "<< /Length [string length $body]\
        >>\nstream\n$body\nendstream"
    set bytes [readBytes [buildpdf $name $objects]]
    regexp {startxref\s+(\d+)\s+%%EOF} $bytes -> prev
    set at [string length $bytes]
    if {$flavour eq "table"} {
        append bytes "xref\n0 1\n0000000000 65535 f \n"
        append bytes "4 1\n0000000000 00001 f \n"
        append bytes "trailer\n<< /Size 6 /Root 1 0 R /Prev $prev >>\n"
    } else {
        set data {}
        append data [field 0 1] [field 0 4] [field 0 2]
        append data [field 1 1] [field $at 4] [field 0 2]
        append bytes "5 0 obj\n<< /Type /XRef /Size 6 /Root 1 0 R /Prev\
            $prev /W \[1 4 2\] /Index \[4 1 5 1\] /Length\
            [string length $data] >>\nstream\n$data\nendstream\nendobj\n"
    }
    append bytes "startxref\n$at\n%%EOF\n"
    set path [scratch $name]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    return $path
}

test import-24.3 {an object freed by an incremental update stays freed - classic table} -body {
    set path [::tclpdfTest::freedFixture import-freed-table.pdf table]
    set reader [::tclpdf::importRead::Open $path]
    # The newest section wins (7.5.6), and it says the object is gone: the
    # entry is a free one and the reference resolves to null (7.3.10), not to
    # the withdrawn stream the older section still points at.
    set entry [dict get $reader xref 4]
    set object [lindex [::tclpdf::importRead::Object reader 4] 0]
    file delete $path
    list $entry $object
} -result {f {z {}}}

test import-24.4 {the same withdrawal written as a cross-reference stream} -body {
    set path [::tclpdfTest::freedFixture import-freed-stream.pdf stream]
    set reader [::tclpdf::importRead::Open $path]
    set entry [dict get $reader xref 4]
    set object [lindex [::tclpdf::importRead::Object reader 4] 0]
    file delete $path
    list $entry $object
} -result {f {z {}}}

test import-24.5 {a cross-reference stream needs three usable field widths (7.5.8.2)} -body {
    set objects [::tclpdfTest::threePages]
    set out {}
    # missing, two long, four long, a name instead of a width, and the
    # all-zero /W that encodes nothing at all
    foreach {name w encode} [list \
            import-w-none.pdf {1 4 2} {} \
            import-w-two.pdf {1 4} {1 4 2} \
            import-w-four.pdf {1 4 2 1} {1 4 2} \
            import-w-name.pdf {1 /x 2} {1 4 2} \
            import-w-zero.pdf {0 0 0} {}] {
        set mangle [expr {$name eq "import-w-none.pdf" ? "nowidths" : {}}]
        set path [::tclpdfTest::buildxref $name $objects $w {} $mangle $encode]
        lappend out [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
        file delete $path
    }
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT XREF}}}

test import-24.6 {a cross-reference stream shorter than /W and /Index require is refused} -body {
    # Without this the exhausted [binary scan] leaves the previous byte
    # standing and the reader reports offsets that are quietly wrong.
    set path [::tclpdfTest::buildxref import-xref-short.pdf \
        [::tclpdfTest::threePages] {1 4 2} {} truncate]
    set result [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    file delete $path
    set result
} -result {1 1 {TCLPDF IMPORT XREF}}

test import-24.7 {/Index and /Size are pairs of non-negative integers, or refused} -body {
    # The point is the loop, not the tidiness: Tcl compares a non-numeric
    # operand as a STRING, so "$i < /Foo" is true for every $i and the entry
    # loop never ends.
    set objects [::tclpdfTest::threePages]
    set out {}
    foreach {name extra} {import-index-name.pdf {/Index [0 /Foo]}
            import-index-odd.pdf {/Index [0]}
            import-index-neg.pdf {/Index [-3 2]}} {
        set path [::tclpdfTest::buildxref $name $objects {1 4 2} $extra]
        lappend out [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
        file delete $path
    }
    # and the same through /Size, which stands in where /Index is absent
    set path [::tclpdfTest::buildxref import-size-name.pdf $objects]
    set bytes [string map {"/Size 5 " "/Size /Foo "} \
        [::tclpdfTest::readBytes $path]]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    lappend out [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    file delete $path
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT XREF}}}

test import-24.8 {/Prev is a byte offset, not a string, a name or a real (Table 15)} -body {
    set out {}
    # 1.5 is the "real": it is a number the standard allows and not a byte
    # offset. Until 2026-08-27 this line read 1e9, which is neither - since
    # the tokenizer holds every number to 7.3.3, that one is turned away one
    # step earlier under IMPORT SYNTAX and belongs to import-24.21.
    foreach value {(nonsense) /Foo -12 1.5 <414243>} {
        set path [::tclpdfTest::buildpdf import-prev.pdf \
            [::tclpdfTest::threePages]]
        set bytes [string map [list "/Root 1 0 R " "/Root 1 0 R /Prev $value "] \
            [::tclpdfTest::readBytes $path]]
        set channel [open $path wb]
        puts -nonewline $channel $bytes
        close $channel
        lappend out [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
        file delete $path
    }
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT XREF}}}

test import-24.9 {a subsection promising more entries than the file holds is refused} -body {
    set path [::tclpdfTest::buildpdf import-bigcount.pdf \
        [::tclpdfTest::threePages]]
    set bytes [string map {"xref\n0 4\n" "xref\n0 400000000\n"} \
        [::tclpdfTest::readBytes $path]]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    set result [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    file delete $path
    set result
} -result {1 1 {TCLPDF IMPORT XREF}}

test import-24.10 {a /Length that refers to its own stream object is refused (7.3.8.2)} -body {
    set objects [::tclpdfTest::threePages]
    lset objects 2 "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 200\]\
        /Contents 4 0 R >>"
    lappend objects "<< /Length 4 0 R >>\nstream\nBT ET\nendstream"
    set path [::tclpdfTest::buildpdf import-selflength.pdf $objects]
    set reader [::tclpdf::importRead::Open $path]
    set result [::tclpdfTest::refuse {::tclpdf::importRead::Object reader 4}]
    file delete $path
    set result
} -result {1 1 {TCLPDF IMPORT RECURSION}}

# An object stream (7.5.7) holding the page tree, with every number the
# reader is held to settable. The healthy shape is a catalogue written
# plainly as object 1, the object stream as object 2 carrying the page (3)
# and the page tree (4), and the cross-reference stream as object 5.
#
# "bend" names the one thing a test wants wrong, and nothing else moves:
#   n        what the stream dictionary CLAIMS its /N is
#   first    what it claims its /First is
#   header   a header written in place of the computed one
#   page     more keys for the page dictionary, for a reference to follow
#   entries  cross-reference entries {number type f2 f3} written in place of,
#            or in addition to, the computed ones
# It grew out of two flaws hard-coded here ("self" and "index") when the
# object-stream bounds of 2026-08-27 wanted five more.
proc ::tclpdfTest::objstm {name {bend {}}} {
    set out "%PDF-1.5\n"
    set off1 [string length $out]
    append out "1 0 obj\n<< /Type /Catalog /Pages 4 0 R >>\nendobj\n"
    set extra [expr {[dict exists $bend page] ? [dict get $bend page] : {}}]
    set page "<< /Type /Page /Parent 4 0 R /MediaBox \[0 0 200 200\] $extra >>"
    set tree "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>"
    set header "3 0 4 [string length $page] "
    if {[dict exists $bend header]} {
        set header [dict get $bend header]
    }
    set payload "$header$page$tree"
    set n 2
    if {[dict exists $bend n]} {
        set n [dict get $bend n]
    }
    set first [string length $header]
    if {[dict exists $bend first]} {
        set first [dict get $bend first]
    }
    set off2 [string length $out]
    append out "2 0 obj\n<< /Type /ObjStm /N $n /First $first\
        /Length [string length $payload] >>\nstream\n$payload\nendstream\nendobj\n"
    set off5 [string length $out]
    set entries [dict create 0 {0 0 65535} 1 [list 1 $off1 0] \
        2 [list 1 $off2 0] 3 {2 2 0} 4 {2 2 1} 5 [list 1 $off5 0]]
    foreach entry [expr {[dict exists $bend entries]
            ? [dict get $bend entries] : {}}] {
        dict set entries [lindex $entry 0] [lrange $entry 1 3]
    }
    set size [expr {[::tcl::mathfunc::max {*}[dict keys $entries]] + 1}]
    set data {}
    for {set number 0} {$number < $size} {incr number} {
        # A number no entry speaks for is written free, which is what a
        # cross-reference stream does with a gap.
        lassign [expr {[dict exists $entries $number]
                ? [dict get $entries $number] : {0 0 0}}] type f2 f3
        append data [field $type 1] [field $f2 4] [field $f3 2]
    }
    append out "5 0 obj\n<< /Type /XRef /Size $size /Root 1 0 R /W \[1 4 2\]\
        /Length [string length $data] >>\nstream\n$data\nendstream\nendobj\n"
    append out "startxref\n$off5\n%%EOF\n"
    set path [scratch $name]
    set channel [open $path wb]
    puts -nonewline $channel $out
    close $channel
    return $path
}

# An incremental update appended to one of those files: a cross-reference
# stream of its own that enters ONE object number with the given type, and a
# /Prev back to the section before it (7.5.6). What the older section says
# about that number is what the update has to shadow.
proc ::tclpdfTest::objstmUpdate {path number type} {
    set bytes [readBytes $path]
    regexp {startxref\n(\d+)} $bytes -> previous
    set offset [string length $bytes]
    set data [string cat [field $type 1] [field 0 4] [field 0 2] \
        [field 1 1] [field $offset 4] [field 0 2]]
    # The update's own cross-reference stream is object 7, which is why
    # "number" may be anything below it.
    append bytes "7 0 obj\n<< /Type /XRef /Size 8 /Index \[$number 1 7 1\]\
        /W \[1 4 2\] /Root 1 0 R /Prev $previous\
        /Length [string length $data] >>\nstream\n$data\nendstream\nendobj\n"
    append bytes "startxref\n$offset\n%%EOF\n"
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    return $path
}

test import-24.11 {an object stream that contains itself is refused (7.5.7)} -body {
    # The object stream says of ITSELF that it lives inside itself.
    set path [::tclpdfTest::objstm import-objstm-self.pdf {entries {{2 2 2 0}}}]
    set result [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    file delete $path
    set result
} -result {1 1 {TCLPDF IMPORT RECURSION}}

test import-24.12 {an object said to be past the end of its object stream is refused} -body {
    # The page is pointed at slot 7 of a stream that holds two.
    set path [::tclpdfTest::objstm import-objstm-index.pdf {entries {{3 2 2 7}}}]
    set result [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    # The message names the slot and how many the stream holds - which is
    # what tells this refusal from the ones the header itself earns.
    set message {}
    catch {::tclpdf::pdf pages $path} message
    file delete $path
    list $result [string match {*number 7 of object stream 2, which holds 2*} \
        $message]
} -result {{1 1 {TCLPDF IMPORT OBJSTM}} 1}

test import-24.13 {a rectangle is four finite numbers, or refused (7.9.5)} -body {
    set out {}
    # The infinite corner is four hundred nines and a decimal point, not
    # 1e400: a real that overflows a double while keeping to the
    # digits-sign-and-one-period grammar of 7.3.3. The exponential form no
    # longer reaches this check at all - the tokenizer refuses it as syntax
    # (import-24.21) - so writing it here would test the tokenizer twice and
    # the box not at all. The point matters: four hundred nines WITHOUT it is
    # an exact integer to Tcl and finite.
    foreach box [list {[0 0 200]} {[0 0 /Foo 200]} {[0 0 (200) 200]} \
            {<< /a 1 >>} "\[0 0 [string repeat 9 400].0 200\]" \
            {[0 0 200 4 0 R]}] {
        set objects [::tclpdfTest::threePages]
        lset objects 2 "<< /Type /Page /Parent 2 0 R /MediaBox $box >>"
        # the last corner is written indirectly (7.3.10) and resolves to a
        # name: the check has to run after the reference is followed
        lappend objects "/Foo"
        set path [::tclpdfTest::buildpdf import-box.pdf $objects]
        lappend out [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
        file delete $path
    }
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT BOX}}}

test import-24.14 {a catalogue that is not one, and a page tree that is not one} -body {
    # /Root on a stream, /Root missing, a /Pages that is an array, and a
    # tree that says nothing about how many pages it holds - the message for
    # the last used to read "has  pages", with a hole where the number
    # belongs. A stream object hands out its stream DICTIONARY, so a /Root
    # pointing at one is a dictionary like any other and is caught one step
    # later, at the /Pages that dictionary has not got.
    set objects {}
    lappend objects "<< /Length 5 >>\nstream\nhello\nendstream"
    lappend objects "<< /Type /Pages /Kids \[\] /Count 0 >>"
    set first [::tclpdfTest::buildpdf import-root-stream.pdf $objects]
    set stream [::tclpdf::importRead::Open $first]
    set a [::tclpdfTest::refuse {::tclpdf::importRead::Page stream 1}]
    set path [::tclpdfTest::buildpdf import-root-none.pdf $objects]
    set bytes [string map {"/Root 1 0 R " {}} [::tclpdfTest::readBytes $path]]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    set none [::tclpdf::importRead::Open $path]
    set b [::tclpdfTest::refuse {::tclpdf::importRead::Page none 1}]
    # a catalogue whose /Pages is a stream, and a tree that says nothing
    # about how many pages it has
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "\[1 2 3\]"
    set second [::tclpdfTest::buildpdf import-pages-array.pdf $objects]
    set tree [::tclpdf::importRead::Open $second]
    set c [::tclpdfTest::refuse {::tclpdf::importRead::Page tree 1}]
    set treeMessage {}
    catch {::tclpdf::importRead::Page tree 1} treeMessage
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[\] >>"
    set third [::tclpdfTest::buildpdf import-nocount.pdf $objects]
    set silent [::tclpdf::importRead::Open $third]
    set d [::tclpdfTest::refuse {::tclpdf::importRead::Page silent 1}]
    set message {}
    catch {::tclpdf::importRead::Page silent 1} message
    file delete $first $path $second $third
    list $a $b $c $d \
        [string match {*catalogue has no /Pages tree*} $treeMessage] \
        [string match {*does not say how many pages*} $message]
} -result {{1 1 {TCLPDF IMPORT PAGES}} {1 1 {TCLPDF IMPORT ROOT}}\
    {1 1 {TCLPDF IMPORT PAGES}} {1 1 {TCLPDF IMPORT PAGES}} 1 1}

test import-24.15 {a page tree that runs in a circle is refused, not walked for ever} -body {
    # 7.7.3.1: the page tree is a TREE. A node naming itself among its /Kids
    # sent the walk down for ever, with /Count promising a page that is never
    # reached.
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[2 0 R\] /Count 4 >>"
    set path [::tclpdfTest::buildpdf import-ring.pdf $objects]
    set a [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    file delete $path
    # and a /Count that is not a number, which decides the same descent
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>"
    lappend objects "<< /Type /Pages /Kids \[4 0 R\] /Count /Foo >>"
    lappend objects "<< /Type /Page /Parent 3 0 R /MediaBox \[0 0 9 9\] >>"
    set path [::tclpdfTest::buildpdf import-count.pdf $objects]
    set b [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    file delete $path
    list $a $b
} -result {{1 1 {TCLPDF IMPORT PAGES}} {1 1 {TCLPDF IMPORT PAGES}}}

test import-24.16 {a cross-reference entry pointing at another object is refused} -body {
    # Following it silently is the worst answer a reader can give: the file
    # opens, and the page it hands out is not the one the file describes.
    set objects [::tclpdfTest::threePages]
    lset objects 1 "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>"
    set path [::tclpdfTest::buildpdf import-wrongoffset.pdf $objects]
    set bytes [::tclpdfTest::readBytes $path]
    set two [string first "2 0 obj" $bytes]
    set four [string first "4 0 obj" $bytes]
    set bytes [string map [list [format "%010d %05d n \n" $two 0] \
        [format "%010d %05d n \n" $four 0]] $bytes]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    set result [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    file delete $path
    set result
} -result {1 1 {TCLPDF IMPORT OBJECT}}

# A reader with nothing but a path and a cache, for the two decoding tests:
# what they are about is the /Filter and the /DecodeParms, not the file
# around them.
proc ::tclpdfTest::bareReader {{objects {}}} {
    return [dict create bytes {} path bare.pdf xref {} trailer {d {}} \
        objects $objects buffers {} sections {} flavour {} inprogress {}]
}

test import-24.17 {a predictor whose /Columns is not a positive integer is refused} -body {
    set reader [::tclpdfTest::bareReader]
    set data [zlib compress [string repeat A 40]]
    set out {}
    foreach columns {{nm Foo} {n 0} {n -4} {s 8}} {
        set value [list d [list Filter {nm FlateDecode} DecodeParms \
            [list d [list Predictor {n 12} Columns $columns]]]]
        lappend out [::tclpdfTest::refuse {
            ::tclpdf::importRead::DecodeStream reader $value $data {a test stream}
        }]
    }
    # and a predictor the shared decoder itself refuses names the file too
    set value {d {Filter {nm FlateDecode} DecodeParms
        {d {Predictor {n 12} Columns {n 4} BitsPerComponent {n 7}}}}}
    lappend out [::tclpdfTest::refuse {
        ::tclpdf::importRead::DecodeStream reader $value $data {a test stream}
    }]
    # The two refusals are told apart by their message: one is about the
    # entry, the other about what the shared decoder made of it.
    set value {d {Filter {nm FlateDecode} DecodeParms
        {d {Predictor {n 12} Columns {nm Foo}}}}}
    set message {}
    catch {::tclpdf::importRead::DecodeStream reader $value $data \
        {a test stream}} message
    list [lsort -unique $out] \
        [string match {*/Columns that is not a positive integer*} $message]
} -result {{{1 1 {TCLPDF IMPORT PREDICTOR}}} 1}

test import-24.18 {a filter named indirectly inside a chain is resolved (7.4)} -body {
    # Unresolved, the chain carried the raw {9 0} of the reference, no switch
    # arm matched it, and a perfectly ordinary Flate stream was refused as
    # "filter /9 0".
    set reader [::tclpdfTest::bareReader {9 {{nm FlateDecode} 0 {}}}]
    set value {d {Filter {a {{r {9 0}}}}}}
    ::tclpdf::importRead::DecodeStream reader $value [zlib compress hello] {x}
} -result hello

test import-24.19 {a refused object can be asked for again without being called self-referential} -body {
    # The in-progress marker has to come off on the way out of a refusal too,
    # or the second question is answered with the wrong refusal.
    set objects [::tclpdfTest::threePages]
    lappend objects "<< /Length /Foo >>\nstream\nBT ET\nendstream"
    set path [::tclpdfTest::buildpdf import-badlength.pdf $objects]
    set reader [::tclpdf::importRead::Open $path]
    set first [::tclpdfTest::refuse {::tclpdf::importRead::Object reader 4}]
    set again [::tclpdfTest::refuse {::tclpdf::importRead::Object reader 4}]
    file delete $path
    list $first $again
} -result {{1 1 {TCLPDF IMPORT STREAM}} {1 1 {TCLPDF IMPORT STREAM}}}


test import-24.20 {a missing file is refused with the class code} -body {
  # The message always named itself and the path; the code did not exist, so
  # the one refusal a caller meets first was the one [trap {TCLPDF IMPORT}]
  # could not catch. Both roads to the reader are asked, since they check the
  # path in two different places.
  set gone [::tclpdfTest::scratch no-such-file.pdf]
  file delete $gone
  set codes {}
  catch {::tclpdf::pdf info $gone} message options
  lappend codes [dict get $options -errorcode]
  set doc [tclpdf new]
  catch {$doc pdf import x $gone} message options
  lappend codes [dict get $options -errorcode]
  $doc destroy
  set codes
} -result {{TCLPDF IMPORT FILE} {TCLPDF IMPORT FILE}}


test import-24.21 {a number token is held to the whole grammar of 7.3.3} -body {
    # "An integer shall be written as one or more decimal digits optionally
    # preceded by a sign", a real the same with one period, "and a PDF writer
    # shall not use the PostScript language syntax for numbers with
    # non-decimal radices (such as 16#FFFE) or in exponential format (such as
    # 6.02E23)". Everything beginning with a sign, a period or a digit used to
    # become a number here and left again byte for byte, so this package
    # answered an invalid file with an invalid file of its own.
    set refused {}
    foreach token {1e3 6.02E23 1e400 --1 +-1 1.2.3 . - + 1x 0x10 1_0} {
        set pos 0
        lappend refused [::tclpdfTest::refuse \
            {::tclpdf::importRead::Parse "$token " pos}]
    }
    set taken {}
    foreach token {0 12 +17 -8 1.5 -.002 .5 4. 007} {
        set pos 0
        lappend taken [::tclpdf::importRead::Parse "$token " pos]
    }
    list [lsort -unique $refused] $taken
} -result {{{1 1 {TCLPDF IMPORT SYNTAX}}} {{n 0} {n 12} {n +17} {n -8} {n 1.5}\
 {n -.002} {n .5} {n 4.} {n 007}}}

test import-24.22 {the refusal names the token and where in the file it stands} -body {
    set pos 0
    catch {::tclpdf::importRead::Parse "<< /A 1 /B 6.02E23 >>" pos} message
    list [string match {*"6.02E23"*} $message] \
        [string match {*offset 11*} $message] \
        [string match {*7.3.3*} $message]
} -result {1 1 1}

test import-24.23 {an object number is plain digits, not what [string is entier] takes} -body {
    # 0x10 passes [string is entier], and the "num gen R" lookahead used to
    # read "0x10 0 R" as a reference to object sixteen - a number the file
    # never wrote. Both halves of the lookahead are digits (7.3.10).
    set out {}
    foreach bytes {{<< /A 0x10 0 R >>} {<< /A 3 0x10 R >>}} {
        set pos 0
        lappend out [::tclpdfTest::refuse \
            {::tclpdf::importRead::Parse $bytes pos}]
    }
    # What a reference still is, unchanged.
    set pos 0
    lappend out [::tclpdf::importRead::Parse {<< /A 3 0 R >>} pos]
    set out
} -result {{1 1 {TCLPDF IMPORT SYNTAX}} {1 1 {TCLPDF IMPORT SYNTAX}}\
 {d {A {r {3 0}}}}}

# A foreign file whose /ca is what the caller puts there: 1e3 for the invalid
# number, 0.5 for its healthy twin. The two differ in nothing else, so what
# the end-to-end pair shows is the number and not the fixture.
proc ::tclpdfTest::alphapdf {name ca} {
    set content "q /GS0 gs 1 0 0 rg 20 20 100 100 re f Q"
    set objects [::tclpdfTest::threePages]
    lset objects 2 "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 200\]\
        /Contents 4 0 R /Resources << /ExtGState << /GS0 5 0 R >> >> >>"
    lappend objects "<< /Length [string length $content]\
        >>\nstream\n$content\nendstream"
    lappend objects "<< /Type /ExtGState /ca $ca /CA 0.5 >>"
    return [::tclpdfTest::buildpdf $name $objects]
}

test import-24.24 {an exponential number in a foreign file is refused, not copied} -body {
    # End to end: before this, /ca 1e3 was taken over and written out again,
    # and qpdf read the result with "unknown token while reading object;
    # treating as string" - the opacity was gone and the file this package
    # had written was itself invalid.
    set path [::tclpdfTest::alphapdf import-exponent.pdf 1e3]
    set out [::tclpdfTest::scratch import-exponent-out.pdf]
    file delete $out
    set doc [tclpdf new -unit pt -format {200 200}]
    $doc page add
    set result [::tclpdfTest::refuse {$doc pdf import letter $path}]
    $doc destroy
    file delete $path
    # Nothing was written: the refusal is at the reading, before a document
    # exists to be written.
    list $result [file exists $out]
} -result {{1 1 {TCLPDF IMPORT SYNTAX}} 0}

test import-24.25 {the healthy twin is taken over and qpdf reads the result} \
        -constraints qpdf -body {
    set path [::tclpdfTest::alphapdf import-alpha.pdf 0.5]
    set out [::tclpdfTest::scratch import-alpha-out.pdf]
    set doc [tclpdf new -unit pt -format {200 200}]
    $doc page add
    $doc pdf import letter $path
    $doc form place letter -at {0 0}
    $doc write $out
    $doc destroy
    set status [catch {exec qpdf --check $out 2>@1} report]
    set bytes [::tclpdfTest::readBytes $out]
    file delete $path $out
    list $status [string match {*unknown token*} $report] \
        [regexp {/ca 0\.5} $bytes]
} -result {0 0 1}

test import-24.26 {an object stream whose /First lies past its stream is refused} -body {
    # It used to be no refusal at all: /First 10000 over a stream of a hundred
    # bytes read the header out of nothing, and [pdf pages] answered with an
    # EMPTY list of pages rather than saying the file is broken.
    set path [::tclpdfTest::objstm import-objstm-first.pdf {first 10000}]
    set result [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    set message {}
    catch {::tclpdf::pdf pages $path} message
    file delete $path
    list $result [string match {*past the * bytes of its decoded stream*} \
        $message]
} -result {{1 1 {TCLPDF IMPORT OBJSTM}} 1}

test import-24.27 {/N is bounded by the header bytes, not believed} -body {
    # THE RESOURCE BOUND. /N is a number in the file, and the header walk used
    # to do 2 * /N iterations of work for it: measured 2026-08-27 on a
    # four-hundred-byte file, /N 200000 took 0.77 s and 43 MB, /N 20000000
    # took 78 s and 3.4 GB - and the file was ACCEPTED at the end of it. A
    # pair of header numbers is four bytes at the shortest ("1 0 "), so /First
    # says how many there can be.
    set path [::tclpdfTest::objstm import-objstm-n.pdf {n 200000}]
    set elapsed [lindex [time {
        set result [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    }] 0]
    set message {}
    catch {::tclpdf::pdf pages $path} message
    file delete $path
    # The bound has to hold BEFORE the work, so the time is part of the
    # assertion: half a second is five hundred times what the refusal needs
    # and well under the second the walk used to take.
    list $result [string match {*announces 200000 objects*} $message] \
        [expr {$elapsed < 500000}]
} -result {{1 1 {TCLPDF IMPORT OBJSTM}} 1 1}

test import-24.28 {every header word is a number, and every offset inside the stream} -body {
    set out {}
    # A word that is not a number where an offset belongs.
    lappend out [::tclpdfTest::refuse {::tclpdf::pdf pages \
        [::tclpdfTest::objstm import-objstm-word.pdf {header {3 0 4 x }}]}]
    # An offset behind everything the stream holds after /First.
    lappend out [::tclpdfTest::refuse {::tclpdf::pdf pages \
        [::tclpdfTest::objstm import-objstm-far.pdf {header {3 0 4 9999 }}]}]
    # A HEADER WORD WITH LEADING ZEROS is a decimal number, not an octal one.
    # Tcl 8.6 reads "0056" in an [expr] as octal - 46 - and answers 0 for a
    # comparison against "0900", which is no octal number at all; Tcl 9 reads
    # both as decimal. So the same file used to be read two ways: the second
    # object of this stream begins at 56, and the page tree read at 46 is a
    # page tree the file has not got.
    set path [::tclpdfTest::objstm import-objstm-zeros.pdf \
        {header {003 000 004 0056 }}]
    lappend out [llength [::tclpdf::pdf pages $path]]
    file delete $path
    # And the bound holds for a zero-padded offset too.
    set path [::tclpdfTest::objstm import-objstm-zerofar.pdf \
        {header {3 0 4 0900 }}]
    lappend out [::tclpdfTest::refuse {::tclpdf::pdf pages $path}]
    file delete $path
    # And the healthy file still reads.
    set path [::tclpdfTest::objstm import-objstm-good.pdf]
    lappend out [llength [::tclpdf::pdf pages $path]]
    file delete $path [::tclpdfTest::scratch import-objstm-word.pdf] \
        [::tclpdfTest::scratch import-objstm-far.pdf]
    set out
} -result {{1 1 {TCLPDF IMPORT OBJSTM}} {1 1 {TCLPDF IMPORT OBJSTM}} 1\
 {1 1 {TCLPDF IMPORT OBJSTM}} 1}

test import-24.29 {an unknown cross-reference entry type is the null object (7.5.8.3)} -body {
    # "In PDF 1.5 through PDF 2.0, only types 0, 1, and 2 are allowed. Any
    # other value shall be interpreted as a reference to the null object, thus
    # permitting new entry types to be defined in the future." Such an entry
    # used to be left out of the table, and the object it stands for was then
    # "referenced but not in the cross-reference": a file the standard defines
    # as readable could not be read at all.
    set path [::tclpdfTest::objstm import-objstm-type3.pdf \
        {page {/Resources << /ExtGState << /GS0 6 0 R >> >>}
         entries {{6 3 0 0}}}]
    set reader [::tclpdf::importRead::Open $path]
    set null [lindex [::tclpdf::importRead::Object reader 6] 0]
    # And the page it hangs off is taken over, with the resource copied as
    # the null object rather than the import refused - the copy gets an
    # object of its own, whose whole body is "null".
    set doc [tclpdf new -unit pt -format {200 200} -compress 0]
    $doc page add
    $doc pdf import letter $path
    set out [::tclpdfTest::scratch import-type3-out.pdf]
    $doc form place letter -at {0 0}
    $doc write $out
    $doc destroy
    set bytes [::tclpdfTest::readBytes $out]
    file delete $path $out
    list $null [regexp {/ExtGState << /GS0 \d+ 0 R >>} $bytes] \
        [regexp "\nnull\nendobj" $bytes]
} -result {{z {}} 1 1}

test import-24.30 {an unknown type in a newer section shadows a live older entry} -body {
    # The counterpart of the type-0 decision of round 5: the newest section
    # decides. qpdf 12.4.0 hands out the older object here; 7.5.8.3 does not.
    # The control below is the same file with type 0, the free entry, which
    # has answered null since round 5.
    set out {}
    foreach {name type} {import-shadow3.pdf 3 import-shadow0.pdf 0} {
        set path [::tclpdfTest::objstm $name {entries {{6 2 2 0}}}]
        set reader [::tclpdf::importRead::Open $path]
        # Before the update, object 6 is the page - alive and readable.
        lappend out [lindex [lindex [::tclpdf::importRead::Object reader 6] 0] 0]
        ::tclpdfTest::objstmUpdate $path 6 $type
        set reader [::tclpdf::importRead::Open $path]
        lappend out [lindex [::tclpdf::importRead::Object reader 6] 0]
        file delete $path
    }
    set out
} -result {d {z {}} d {z {}}}

# A file whose LAST object writes its number with leading zeros, in its own
# header and in the reference that reaches it: "0010 00 obj" and "0010 00 R".
# Both are what 7.3.3 calls an integer - "one or more decimal digits optionally
# preceded by a sign" - so both mean object ten, and qpdf reads them so. TEN
# and not seven: "0010" is eight to Tcl 8.6's [expr] and ten to Tcl 9's, so a
# reader that ever reaches for [expr] here is caught by this file as well as
# one that compares the digits as a string. Built through [buildpdf] and
# widened afterwards, since only the header of the last object grows and only
# the one offset behind it moves.
proc ::tclpdfTest::paddedpdf {name} {
    set objects [::tclpdfTest::threePages]
    lset objects 2 "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 200\]\
        /Resources << /ExtGState << /GS0 0010 00 R >> >> >>"
    foreach - {4 5 6 7 8 9} {
        lappend objects "<< /Type /Filler >>"
    }
    lappend objects "<< /Type /ExtGState /ca 0.5 >>"
    set path [::tclpdfTest::buildpdf $name $objects]
    set bytes [string map {"\n10 0 obj\n" "\n0010 00 obj\n"} \
        [::tclpdfTest::readBytes $path]]
    # The table moved three bytes; startxref has to say so.
    regsub {startxref\n\d+\n} $bytes \
        "startxref\n[expr {[string first "\nxref\n" $bytes] + 1}]\n" bytes
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    return $path
}

test import-24.31 {a written number with leading zeros is the number it means} -body {
    # "0010" is ten (7.3.3), in the header of an object and in a reference
    # alike, and a reader that turns such a file away is the one at fault.
    # Two ways it used to go wrong: the reference "0010 00 R" was looked up in
    # the cross-reference under the key "0010", which is not the key "10"; and
    # the header "0010 00 obj" was compared with the number the table promised
    # as a string, so object ten was "where object 0010 is written".
    set path [::tclpdfTest::paddedpdf import-padded.pdf]
    set out [::tclpdfTest::scratch import-padded-out.pdf]
    set doc [tclpdf new -unit pt -format {200 200} -compress 0]
    $doc page add
    $doc pdf import letter $path
    $doc form place letter -at {0 0}
    $doc write $out
    $doc destroy
    set bytes [::tclpdfTest::readBytes $out]
    set pages [llength [::tclpdf::pdf pages $path]]
    file delete $path $out
    # The ExtGState behind the padded reference came over with its content.
    list $pages [regexp {/Type /ExtGState /ca 0\.5} $bytes]
} -result {1 1}

test import-24.32 {qpdf reads the same padded file as object 10} -constraints qpdf -body {
    set path [::tclpdfTest::paddedpdf import-padded-qpdf.pdf]
    set shown [exec qpdf --show-object=10 $path]
    set status [catch {exec qpdf --check $path 2>@1} report]
    file delete $path
    list $status [string match {*/Type /ExtGState*} $shown] \
        [string match {*/ca 0.5*} $shown]
} -result {0 1 1}

test import-24.33 {a directory is refused with the class code, not by POSIX} -body {
    # [file exists] says yes to a directory and [open] opens one; the raw
    # "illegal operation on a directory" arrived from [read] afterwards, under
    # POSIX EISDIR, out of a command whose every other refusal names this
    # package.
    set here [file dirname [::tclpdfTest::scratch anything.pdf]]
    set out {}
    foreach command {info pages fonts metadata fields} {
        lappend out [::tclpdfTest::refuse {::tclpdf::pdf $command $here}]
    }
    lsort -unique $out
} -result {{1 1 {TCLPDF IMPORT FILE}}}



# --- CCITT content streams (roadmap item 7) ---------------------------------
#
# CCITTFaxDecode is the filter of a scanned attachment, and until this decoder
# it was the refusal a scan ran into: a page whose content or whose pixels are
# fax-coded could not be taken over at all. What a scan carries in practice
# was counted on 2026-08-24 over 25232 PDF files here - 1681 of them name the
# filter, and of 11398 fax images in them every single one is Group 4.
#
# A page content stream coded as fax is not what anybody writes, and that is
# exactly why the fixture below can exist: the bytes of a content stream are
# a bitmap like any other, so the operators were handed to the encoder of
# libtiff 4.7.2 as a 64 by 7 one-bit picture and what came back is a Group 4
# stream that decodes to the operators again. Nothing here was coded by this
# package - it has no fax encoder.

proc ::tclpdfTest::ccittpage {{parms {/Columns 64 /Rows 7 /K -1 /BlackIs1 true}} {extra {}}} {
    set stream [binary format H* [string cat \
        23a368ba23a23a368fa23b23a3198cc22e8fe12b049342911d11d2b4caffe3a1 \
        b685b0c17add6c8ffa088e8208548f8229d0d11d28549b488e81024c8ea3dc45 \
        4c6b0784b682d85d27f91d0409c6914385c20b686be90223a0688eb11da17118 \
        008008]]
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1\
        /MediaBox \[0 0 300 200\] >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
        /Resources << /Font << /F1 4 0 R >> >> >>"
    lappend objects "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"
    lappend objects "<< /Length [string length $stream] /Filter /CCITTFaxDecode\
        /DecodeParms << $parms >> $extra >>\nstream\n$stream\nendstream"
    return [::tclpdfTest::buildpdf import-ccitt.pdf $objects]
}

test import-25.1 {a CCITT content stream is read} -body {
    set fixture [::tclpdfTest::ccittpage]
    # -compress 0 keeps the merged content readable for the assertion.
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import fax $fixture
    $doc form place fax -at {0 0}
    set size [$doc form size fax]
    set path [::tclpdfTest::scratch import-ccitt-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    list $size [regexp {\(ccitt content\) Tj} $bytes]
} -result {{300.0 200.0} 1}

test import-25.2 {/BlackIs1 reaches the decoder} -body {
    # The parameter that changes every bit and no length: read with the
    # default the same stream decodes to the complement of the operators,
    # which is 56 bytes of something that is not an operator anywhere. The
    # import does not refuse it - a content stream may hold anything - so the
    # assertion is that the text is GONE, not that anything failed.
    set fixture [::tclpdfTest::ccittpage {/Columns 64 /Rows 7 /K -1}]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import fax $fixture
    $doc form place fax -at {0 0}
    set path [::tclpdfTest::scratch import-ccitt-flip.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    regexp {\(ccitt content\) Tj} $bytes
} -result 0

test import-25.3 {a fax stream shorter than it declares is refused naming the file} -body {
    # /Rows says 40 and the stream holds seven, which is the shape a
    # truncated scan arrives in. The refusal has to carry the FILE and what
    # was being read - the decoder's own sentence alone says "the fax data"
    # and leaves the reader to guess which file that was.
    set fixture [::tclpdfTest::ccittpage {/Columns 64 /Rows 40 /K -1 /BlackIs1 true}]
    set doc [tclpdf new]
    $doc page add
    set answer [::tclpdfTest::refuse {$doc pdf import fax $fixture}]
    catch {$doc pdf import again $fixture} message
    $doc destroy
    file delete $fixture
    list $answer [string match {*import-ccitt.pdf*/CCITTFaxDecode stream this\
        package cannot decode*7 of the 40 rows*} $message]
} -result {{1 1 {TCLPDF IMPORT FILTER}} 1}

test import-25.5 {where /Rows is silent the height of the image stands in} -body {
    # /Rows is optional (Table 11) and an image says the same thing in
    # /Height, which is not. Taken from there, a stream that stops early is
    # caught; taken from nowhere, it would quietly deliver fewer rows than
    # the picture has and nothing downstream would know. Declared at 40 with
    # seven in the stream, so the fallback shows by refusing.
    set fixture [::tclpdfTest::ccittpage {/Columns 64 /K -1 /BlackIs1 true} \
        {/Height 40}]
    set doc [tclpdf new]
    $doc page add
    catch {$doc pdf import fax $fixture} message
    $doc destroy
    file delete $fixture
    string match {*7 of the 40 rows*} $message
} -result 1

test import-25.4 {a filter this package still cannot read is refused by name} -body {
    # The other side of the same switch. Four filters are read now - Flate,
    # LZW, the two ASCII ones - and CCITT is the fifth; everything else has
    # to arrive as a refusal that names the filter, not as a stream of bytes
    # nobody decoded.
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1\
        /MediaBox \[0 0 200 200\] >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>"
    lappend objects "<< /Length 4 /Filter /JBIG2Decode >>\nstream\nxxxx\nendstream"
    set fixture [::tclpdfTest::buildpdf import-jbig2.pdf $objects]
    set doc [tclpdf new]
    $doc page add
    set answer [::tclpdfTest::refuse {$doc pdf import x $fixture}]
    catch {$doc pdf import y $fixture} message
    $doc destroy
    file delete $fixture
    list $answer [string match {*uses filter /JBIG2Decode, which this import\
        cannot decode*} $message]
} -result {{1 1 {TCLPDF IMPORT FILTER}} 1}


# -- the function pool reaches across an import ----------------------------

test import-pool-40.1 {the same file imported twice brings one function} -body {
  # A function is a VALUE: two identical ones are interchangeable, and the
  # pool that already folds the package's own gradients together now takes
  # the foreign ones as well. Measured before the change: two.
  set source [tclpdfTest::scratch import-pool-source.pdf]
  set src [tclpdf new -unit mm -compress 0]
  $src page add
  $src shading axial -at {10 10} -size {50 20} -colors {red blue}
  $src write $source
  $src destroy
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc pdf import first $source
  $doc pdf import second $source
  $doc form place first -at {10 10}
  $doc form place second -at {10 80}
  set path [::tclpdfTest::scratch import-pool.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path $source
  regexp -all {/FunctionType} $bytes
} -result 1

test import-pool-40.2 {a function carrying a reference is copied whole} -body {
  # The serialization of a value holding an indirect reference depends on
  # the number map, and the map is not finished when the decision falls - so
  # this one is not pooled, and must not be silently dropped either.
  set source [tclpdfTest::scratch import-pool-ref.pdf]
  set src [tclpdf new -unit mm -compress 0]
  $src page add
  # Three stops make a stitching function (type 3), whose parts are
  # functions of their own.
  $src shading axial -at {10 10} -size {50 20} -colors {red yellow blue}
  $src write $source
  $src destroy
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc pdf import once $source
  $doc form place once -at {10 10}
  set path [::tclpdfTest::scratch import-pool-ref-out.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path $source
  # Whatever the source had, the copy has - nothing lost on the way.
  expr {[regexp -all {/FunctionType} $bytes] >= 1}
} -result 1


# --- a refused import leaves the document writable --------------------------
#
# The reading refuses in a dozen places and every one of them is measured
# above by its message. What is measured HERE is the other half: what the
# refusal costs the document the caller carries on with. An object number
# handed out for an object that never arrives makes the NEXT [write] of the
# whole document fail with "object(s) reserved but never written" - a
# document that has nothing to do with the file that was refused.

test import-26.1 {a bad hex string in a resource leaves the document writable} -body {
    # <4G> is not a hexadecimal string (7.3.4.3) and the import says so. The
    # refusal used to fall in the SECOND loop, when every object of the
    # closure already had its number: the caller caught it, went on drawing,
    # and lost the whole document at [write].
    set one "BT /Helv 12 Tf 20 100 Td (hi) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-badhex.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /Font << /Helv 4 0 R >> >> >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /XX <4G> >>" \
        "<< /Length [string length $one] >>\nstream\n$one\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set refused [catch {$doc pdf import bad $fixture} message]
    # The document goes on and has to survive it.
    $doc text "A page of its own" -at {40 700}
    set path [::tclpdfTest::scratch import-badhex-out.pdf]
    set written [catch {$doc write $path} outcome]
    $doc destroy
    # And what came out is a file, not a wreck: the objects the refused
    # import had already numbered are gone, and nothing points at them.
    set checked ok
    if {[auto_execok qpdf] ne {}} {
        set status [catch {exec qpdf --check $path} output]
        if {$status || ![regexp {(?i)no syntax or stream encoding errors} \
                $output]} {
            set checked $output
        }
    }
    file delete $fixture $path
    list $refused [string match {*not a hexadecimal digit*} $message] \
        $written $checked
} -result {1 1 0 ok}

test import-26.2 {the same in the page's own resources dictionary} -body {
    # /Resources DIRECT on the page is not an object of the closure - it is
    # written as an object of its own, after the closure is already in the
    # writer. Its strings therefore used to be checked LAST of all, and the
    # refusal left the copied resources of a page the document never got
    # standing in the file: filled objects, so the write still worked, but
    # dead weight nothing points at. Read once for the whole file, the check
    # now falls before the first of them is copied.
    set one "q Q"
    set fixture [::tclpdfTest::buildpdf import-badhex-direct.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /Font << /Helv 4 0 R >> /XX <4G> >> >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica\
            /Marker /LeftBehind >>" \
        "<< /Length [string length $one] >>\nstream\n$one\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    set refused [catch {$doc pdf import bad $fixture} message]
    set path [::tclpdfTest::scratch import-badhex-direct-out.pdf]
    set written [catch {$doc write $path} outcome]
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    list $refused [string match {*not a hexadecimal digit*} $message] \
        $written [regexp {LeftBehind} $bytes]
} -result {1 1 0 0}

# --- round 7: the closure is checked whole before a number is handed out -----

# A page with TWO resources whose SECOND one refuses. Round 6 fixed the case
# where the first one does, and the loop that came out of it reserved for
# object k-1 before it asked about object k - so the objects before the
# refusing one stayed reserved and never written, and the whole document died
# at the next [write] although the caller had caught the refusal.
proc ::tclpdfTest::twoResources {name second} {
    set content "q /A Do /B Do Q"
    set body "0 0 m"
    return [::tclpdfTest::buildpdf $name [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 >>" \
        "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 200 100\]\
            /Contents 4 0 R\
            /Resources << /XObject << /A 5 0 R /B 6 0 R >> >> >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 1 1\]\
            /Length [string length $body] >>\nstream\n$body\nendstream" \
        $second]]
}

test import-20.1 {a refusal at the SECOND object of the closure leaves the document writable} -body {
    set body "0 0 m"
    set fixture [::tclpdfTest::twoResources import-midloop.pdf \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 1 1\] /Foo <4G>\
            /Length [string length $body] >>\nstream\n$body\nendstream"]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set refused [catch {$doc pdf import bad $fixture} message]
    set path [::tclpdfTest::scratch import-midloop-out.pdf]
    set written [catch {$doc write $path} outcome]
    $doc destroy
    file delete $fixture $path
    list $refused [string match {*not a hexadecimal digit*} $message] \
        $written [string match {*reserved but never written*} $outcome]
} -result {1 1 0 0}

test import-20.2 {and the same for the filter check, which is the writer's} -body {
    set deflated [zlib compress "0 0 m"]
    set fixture [::tclpdfTest::twoResources import-midloop-filter.pdf \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 1 1\] /Filter /FlateDecode\
            /Length [string length $deflated] >>\nstream\n$deflated\nendstream"]
    # -version 1.1 disowns FlateDecode, -compress 0 so the document itself
    # does not need it either.
    set doc [tclpdf new -unit pt -format a4 -version 1.1 -compress 0]
    $doc page add
    set refused [catch {$doc pdf import bad $fixture} message]
    set path [::tclpdfTest::scratch import-midloop-filter-out.pdf]
    set written [catch {$doc write $path} outcome]
    $doc destroy
    file delete $fixture $path
    list $refused [string match {*FlateDecode*} $message] \
        $written [string match {*reserved but never written*} $outcome]
} -result {1 1 0 0}

# --- round 7: the same object twice is one object ---------------------------

test import-21.1 {importing one file twice shares the objects it brings} -body {
    # The font dictionary of the fixture is one object with a marker in it.
    # Two imports used to copy it twice - and with it every embedded font
    # program of a letterhead placed on both sides of a sheet.
    set fixture [::tclpdfTest::handcrafted]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import eins $fixture
    $doc pdf import zwei $fixture
    set path [::tclpdfTest::scratch import-twice.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    # ONE font dictionary for two imports - and TWO optional content
    # groups, deliberately: a group is a row in the reader's layer panel and
    # a thing this document keeps a state for, not an interchangeable value
    # (see [ImportShare]). The two form XObjects are two, since each alias
    # is a placement of its own.
    list [regexp -all {/BaseFont /Helvetica} $bytes] \
        [regexp -all {/Type /OCG} $bytes] \
        [regexp -all {/Subtype /Form} $bytes]
} -result {1 2 2}

test import-21.2 {an object on a reference cycle is copied, not shared} -body {
    # /Prev and /Next point at each other: neither can be keyed by its
    # content, because the content of each holds the number of the other.
    # Two imports therefore bring two copies, and the file is still right.
    set content "q Q"
    set fixture [::tclpdfTest::buildpdf import-cycle.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 6 0 R\
            /Resources << /XObject << /A 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 1 1\] /Next 5 0 R\
            /Length 5 >>\nstream\n0 0 m\nendstream" \
        "<< /Type /Marker /Prev 4 0 R >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import eins $fixture
    $doc pdf import zwei $fixture
    set path [::tclpdfTest::scratch import-cycle-out.pdf]
    set written [catch {$doc write $path} outcome]
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    list $written [regexp -all {/Type /Marker} $bytes]
} -result {0 2}

# --- round 7: the foreign page's own marked content -------------------------

test import-22.1 {the STRUCTURE marks of a foreign page do not travel} -body {
    set content "/P << /MCID 0 >> BDC BT /Helv 12 Tf 20 100 Td (one) Tj ET EMC\n\
        /Artifact BMC 0 0 1 1 re f EMC\n\
        /OC /oc1 BDC 5 5 m 9 9 l S EMC"
    set fixture [::tclpdfTest::buildpdf import-marked.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /Font << /Helv 4 0 R >>\
            /Properties << /oc1 6 0 R >> >> >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream" \
        "<< /Type /OCG /Name (Layer) >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import marked $fixture
    $doc form place marked -at {0 0}
    set path [::tclpdfTest::scratch import-marked-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    # The /MCID bracket is gone with its EMC. The artifact bracket and the
    # optional-content bracket stay - the first says "this is not content",
    # which is true inside a form XObject too, and the second is what
    # SWITCHES the content inside it. Two brackets left, so two EMC. The
    # drawing itself is untouched.
    list [regexp -all {/MCID} $bytes] [regexp -all {/Artifact BMC} $bytes] \
        [regexp -all {/OC /oc1 BDC} $bytes] [regexp -all {EMC} $bytes] \
        [regexp {\(one\) Tj} $bytes] [regexp {5 5 m\s+9 9 l\s+S} $bytes]
} -result {0 1 1 2 1 1}

test import-22.2 {an operator name inside a string is text, not an operator} -body {
    set content "BT /Helv 12 Tf 20 100 Td (EMC and BDC) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-marked-string.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /Font << /Helv 4 0 R >> >> >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import marked $fixture
    set path [::tclpdfTest::scratch import-marked-string-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    regexp {\(EMC and BDC\) Tj} $bytes
} -result 1

# --- round 7: what the reader says about a file it will not open ------------

test import-23.1 {bytes behind the last %%EOF are passed over (7.5.5)} -body {
    set fixture [::tclpdfTest::handcrafted]
    set channel [open $fixture ab]
    puts $channel "% a line a mail gateway appended"
    close $channel
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set code [catch {$doc pdf import late $fixture} message]
    $doc destroy
    file delete $fixture
    list $code $message
} -result {0 late}

test import-23.2 {a file with no startxref at all is still refused, and says so} -body {
    set path [::tclpdfTest::scratch import-nostartxref.pdf]
    set channel [open $path wb]
    puts -nonewline $channel "%PDF-1.4\n1 0 obj\n<< >>\nendobj\n"
    close $channel
    set outcome [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    file delete $path
    list [lindex $outcome 0] [lindex $outcome 1] [lindex $outcome 2]
} -result {1 1 {TCLPDF IMPORT FILE}}

test import-23.3 {a startxref one byte past the object names the cross reference} -body {
    set fixture [::tclpdfTest::handcrafted]
    set bytes [::tclpdfTest::readBytes $fixture]
    regexp {startxref\n(\d+)\n} $bytes -> offset
    set bytes [string map [list "startxref\n$offset\n" \
        "startxref\n[expr {$offset + 1}]\n"] $bytes]
    set path [::tclpdfTest::scratch import-startxref-plus.pdf]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    set outcome [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    set message [catch {::tclpdf::pdf info $path} said]
    file delete $fixture $path
    list [lindex $outcome 2] [string match {*cross-reference offset*} $said] \
        [string match {*startxref*} $said]
} -result {{TCLPDF IMPORT XREF} 1 1}

test import-23.4 {a cross-reference table of nineteen-byte lines names the short entry} -body {
    set fixture [::tclpdfTest::handcrafted]
    set bytes [::tclpdfTest::readBytes $fixture]
    # One space where the standard has two: every line one byte short.
    set bytes [regsub -all "(\\d{10}) (\\d{5}) (\[nf\]) \n" $bytes "\\1 \\2 \\3\n"]
    set path [::tclpdfTest::scratch import-xref19.pdf]
    set channel [open $path wb]
    puts -nonewline $channel $bytes
    close $channel
    set outcome [::tclpdfTest::refuse {::tclpdf::pdf info $path}]
    set code [catch {::tclpdf::pdf info $path} said]
    file delete $fixture $path
    list [lindex $outcome 2] [string match {*twenty bytes*} $said]
} -result {{TCLPDF IMPORT XREF} 1}

test import-24.1 {an unknown subcommand of the pdf ensemble carries a tclpdf code} -body {
    ::tclpdfTest::refuse {::tclpdf::pdf nonsense /nowhere.pdf}
} -result {1 1 {TCLPDF IMPORT SUBCOMMAND nonsense}}

test import-22.3 {a named property list is resolved before the bracket is judged} -body {
    # /P /pm1 BDC names an entry of the page's /Properties, and only the
    # reader can say whether that entry holds an /MCID. Two named brackets,
    # one with and one without.
    set content "/P /pm1 BDC BT /Helv 12 Tf 20 100 Td (marked) Tj ET EMC\n\
        /OC /oc1 BDC 5 5 m 9 9 l S EMC\n\
        /Span /sp1 BDC 1 1 m 2 2 l S EMC"
    set fixture [::tclpdfTest::buildpdf import-marked-named.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /Font << /Helv 4 0 R >>\
            /Properties << /pm1 6 0 R /oc1 7 0 R /sp1 8 0 R >> >> >>" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream" \
        "<< /MCID 3 >>" \
        "<< /Type /OCG /Name (Layer) >>" \
        "<< /Lang (de) >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import marked $fixture
    $doc form place marked -at {0 0}
    set path [::tclpdfTest::scratch import-marked-named-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $fixture $path
    list [regexp -all {/P /pm1 BDC} $bytes] [regexp -all {/OC /oc1 BDC} $bytes] \
        [regexp -all {/Span /sp1 BDC} $bytes] [regexp -all {EMC} $bytes] \
        [regexp {\(marked\) Tj} $bytes]
} -result {0 1 1 2 1}

test import-22.4 {an optional-content bracket still switches its layer after the import} -body {
    # The bracket and the group have to arrive together: the /OC name in the
    # stream, the /Properties entry it resolves through, and the group in
    # /OCProperties, whose state travels as well.
    set content "/OC /oc1 BDC 5 5 m 9 9 l S EMC\n\
        /P << /MCID 0 >> BDC 1 1 m 2 2 l S EMC"
    set fixture [::tclpdfTest::buildpdf import-marked-oc.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R /OCProperties\
            << /OCGs \[5 0 R\] /D << /Name (D) /OFF \[5 0 R\] >> >> >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Properties << /oc1 5 0 R >> >> >>" \
        "<< /Length [string length $content] >>\nstream\n$content\nendstream" \
        "<< /Type /OCG /Name (Layer) >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import marked $fixture
    $doc form place marked -at {0 0}
    set path [::tclpdfTest::scratch import-marked-oc-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    set entry {}
    regexp {/OCProperties (<<.*?/Name)} $bytes -> entry
    file delete $fixture $path
    # The bracket, its /Properties entry, the group in the catalogue, and
    # the group still switched OFF as the foreign file had it.
    list [regexp -all {/OC /oc1 BDC} $bytes] [regexp -all {/MCID} $bytes] \
        [regexp {/Properties << /oc1 \d+ 0 R >>} $bytes] \
        [regexp -all {/Type /OCG} $bytes] \
        [expr {[llength [::tclpdf::layer::groupReferences $entry OFF]] == 1}]
} -result {1 0 1 1 1}

cleanupTests

# import.test --
#
# A page of an existing PDF, taken over as a form: the tokenizer, both
# cross-reference flavours, the box and rotation handling, the refusals.
#
# The fixtures are built here rather than shipped: the classic-table files
# come from tclpdf itself or are handcrafted byte for byte (which is what
# exercises the corners - a direct /Resources, a /Contents array, an
# inherited MediaBox, a literal string that looks like a reference), and
# the modern flavour is produced at test time by qpdf from the classic one,
# under the qpdf constraint.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::import
source [file join [file dirname [info script]] helper.tcl]

testConstraint qpdf [expr {[auto_execok qpdf] ne {}}]

# The template most tests import: one A4 page written by tclpdf itself,
# with an embedded piece of everything a letterhead drags along - text in
# a standard face, a filled rectangle, a line.
proc ::tclpdfTest::template {{pages 1}} {
    set path [scratch import-template.pdf]
    set doc [tclpdf new -unit pt -format a4]
    for {set i 1} {$i <= $pages} {incr i} {
        $doc page add
        $doc rect -at {40 40} -size {515 60} -fill #e8e0f0
        $doc text "Template page $i" -at {60 78} -size 24
        $doc line -from {40 760} -to {555 760} -width 0.5
    }
    $doc write $path
    $doc destroy
    return $path
}

# --- the tokenizer ---------------------------------------------------------

test import-1.1 {a literal string that looks like a reference stays a string} -body {
    set pos 0
    ::tclpdf::import::Parse {(see 5 0 R for details)} pos
} -result {s {see 5 0 R for details}}

test import-1.2 {references and plain numbers are told apart by lookahead} -body {
    set pos 0
    set a [::tclpdf::import::Parse {[3 0 R 3 0 4]} pos]
    set pos 0
    set b [::tclpdf::import::Parse {<< /A 3 0 R /B 3 >>} pos]
    list $a $b
} -result {{a {{r {3 0}} {n 3} {n 0} {n 4}}} {d {A {r {3 0}} B {n 3}}}}

test import-1.3 {nested dictionaries, arrays, hex strings, booleans, null} -body {
    set pos 0
    ::tclpdf::import::Parse {<< /D << /X [<AB> true null] >> /N /Nm >>} pos
} -result {d {D {d {X {a {{h AB} {b true} {z {}}}}}} N {nm Nm}}}

test import-1.4 {string escapes: parentheses, octal, line continuation} -body {
    set pos 0
    ::tclpdf::import::Parse "(a\\(b\\)c \\101 d\\\ne)" pos
} -result {s {a(b)c A de}}

test import-1.5 {serializing renumbers references and re-escapes strings} -body {
    set pos 0
    set value [::tclpdf::import::Parse {<< /K [7 0 R (x\(y)] >>} pos]
    ::tclpdf::import::Serialize $value {7 12}
} -result {<< /K [ 12 0 R (x\(y) ] >>}

test import-1.6 {comments are whitespace} -body {
    set pos 0
    ::tclpdf::import::Parse "%note\n42" pos
} -result {n 42}

# --- the classic round trip ------------------------------------------------

test import-2.1 {an imported page is a form XObject with its own resources} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set size [$doc form size kopfbogen]
    set path [::tclpdfTest::scratch import-roundtrip.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    list [format %.2f [lindex $size 0]] [format %.2f [lindex $size 1]] \
        [regexp {/Subtype /Form} $bytes] [regexp {/Matrix \[} $bytes]
} -result {595.28 841.89 1 1}

test import-2.2 {placing twice stores the page once} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    $doc page add
    $doc form place kopfbogen -at {0 0} -scale 0.5
    set path [::tclpdfTest::scratch import-once.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    regexp -all {/Subtype /Form} $bytes
} -result 1

test import-2.3 {the second write is byte-identical} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    lassign [::tclpdfTest::writeTwice $doc import-twice] first second
    $doc destroy
    file delete $template
    expr {$first eq $second}
} -result 1

test import-2.4 {qpdf accepts the file} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-qpdf.pdf]
    $doc write $path
    $doc destroy
    set status [catch {exec qpdf --check $path} output]
    file delete $path $template
    list $status [regexp {(?i)no syntax or stream encoding errors} $output]
} -result {0 1}

# --- pages and refusals ----------------------------------------------------

test import-3.1 {-page picks a page of a multi-page file} -body {
    set template [::tclpdfTest::template 3]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import seite $template -page 2
    $doc form place seite -at {0 0}
    set path [::tclpdfTest::scratch import-page2.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    # Which page came along is read from the copied content: the pages
    # differ only in their drawn number.
    list [regexp {Template page 2} $bytes] [regexp {Template page 1} $bytes] \
        [regexp {Template page 3} $bytes]
} -result {1 0 0}

test import-3.2 {a page beyond the last is refused with the count} -body {
    set template [::tclpdfTest::template 3]
    set doc [tclpdf new]
    $doc page add
    set result [catch {$doc pdf import x $template -page 4} message]
    $doc destroy
    file delete $template
    list $result $message
} -match glob -result {1 {*has 3 pages - there is no page 4}}

test import-3.3 {an alias in use is refused} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new]
    $doc page add
    $doc pdf import x $template
    set result [catch {$doc pdf import x $template} message]
    $doc destroy
    file delete $template
    list $result $message
} -result {1 {tclpdf: a form named "x" already exists}}

test import-3.4 {-page takes a number counted from 1} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf import x y.pdf -page 0} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: -page of pdf import is a page number counted from 1, not "0"}}

test import-3.5 {unknown subcommand names the known one} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf export x y.pdf} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: unknown pdf subcommand "export" - known is: import}}

test import-3.6 {a missing file is refused by name} -body {
    set doc [tclpdf new]
    set result [catch {$doc pdf import x /no/such/file.pdf} message]
    $doc destroy
    list $result $message
} -result {1 {tclpdf: pdf import: no file "/no/such/file.pdf"}}

# --- the handcrafted corners ----------------------------------------------
#
# A file tclpdf would never write: MediaBox inherited from the page TREE,
# /Resources direct on the page, /Contents an ARRAY of two streams, a
# content string that contains "999 0 R" as text, an optional-content
# resource. Byte for byte, so the parser meets the real thing.

# A classic-table file from a list of object bodies, byte for byte - the
# boilerplate of [handcrafted], extracted when the norm-review fixtures
# would have been its fourth copy.
proc ::tclpdfTest::buildpdf {name objects} {
    set out "%PDF-1.4\n"
    set offsets {}
    set number 0
    foreach body $objects {
        lappend offsets [string length $out]
        append out "[incr number] 0 obj\n$body\nendobj\n"
    }
    set xref [string length $out]
    append out "xref\n0 [expr {$number + 1}]\n"
    append out [format "%010d %05d f \n" 0 65535]
    foreach offset $offsets {
        append out [format "%010d %05d n \n" $offset 0]
    }
    append out "trailer\n<< /Size [expr {$number + 1}] /Root 1 0 R >>\n"
    append out "startxref\n$xref\n%%EOF\n"
    set path [scratch $name]
    set channel [open $path wb]
    puts -nonewline $channel $out
    close $channel
    return $path
}

proc ::tclpdfTest::handcrafted {} {
    set objects {}
    lappend objects "<< /Type /Catalog /Pages 2 0 R >>"
    lappend objects "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>"
    lappend objects "<< /Type /Page /Parent 2 0 R /Contents \[5 0 R 6 0 R\]\
        /Resources << /Font << /Helv 4 0 R >>\
        /Properties << /oc1 7 0 R >> >> >>"
    lappend objects "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"
    set one "BT /Helv 12 Tf 20 400 Td (half one) Tj ET"
    lappend objects "<< /Length [string length $one] >>\nstream\n$one\nendstream"
    set two "BT /Helv 12 Tf 20 380 Td (\\(999 0 R\\) is text) Tj ET"
    lappend objects "<< /Length [string length $two] >>\nstream\n$two\nendstream"
    lappend objects "<< /Type /OCG /Name (Layer) >>"
    return [buildpdf import-handcrafted.pdf $objects]
}

test import-4.1 {inherited MediaBox, direct resources, contents array, OCG} -body {
    set fixture [::tclpdfTest::handcrafted]
    # -compress 0 keeps the merged content readable for the assertions.
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import hand $fixture
    $doc form place hand -at {0 0}
    set size [$doc form size hand]
    set path [::tclpdfTest::scratch import-hand.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    list $size \
        [regexp {half one} $bytes] \
        [regexp {999 0 R\\\) is text} $bytes] \
        [regexp {/OCProperties} $bytes] \
        [regexp {/Type /OCG} $bytes]
} -result {{400.0 500.0} 1 1 1 1}

test import-4.2 {the two content streams are one stream, in order} -body {
    set fixture [::tclpdfTest::handcrafted]
    set doc [tclpdf new -unit pt -compress 0]
    $doc page add
    $doc pdf import hand $fixture
    $doc form place hand -at {0 0}
    set path [::tclpdfTest::scratch import-merge.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # One form, and "half one" before the second half inside it.
    list [regexp -all {/Subtype /Form} $bytes] \
        [expr {[string first {half one} $bytes] \
            < [string first {999 0 R} $bytes]}]
} -result {1 1}

# --- the modern flavour ----------------------------------------------------

test import-5.1 {object streams and cross-reference streams are read} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set modern [::tclpdfTest::scratch import-modern-src.pdf]
    exec qpdf --object-streams=generate $template $modern
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import kopfbogen $modern
    $doc form place kopfbogen -at {0 0}
    set size [$doc form size kopfbogen]
    set path [::tclpdfTest::scratch import-modern.pdf]
    $doc write $path
    $doc destroy
    set status [catch {exec qpdf --check $path}]
    file delete $path $template $modern
    list [format %.2f [lindex $size 0]] $status
} -result {595.28 0}

test import-5.2 {an encrypted file is refused by name} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set locked [::tclpdfTest::scratch import-locked.pdf]
    exec qpdf --encrypt "" owner 256 -- $template $locked
    set doc [tclpdf new]
    $doc page add
    set result [catch {$doc pdf import x $locked} message]
    $doc destroy
    file delete $template $locked
    list $result [string match {*is encrypted - encrypted files are not imported} $message]
} -result {1 1}

test import-5.3 {/Rotate becomes the form's matrix and swaps its extent} -constraints qpdf -body {
    set template [::tclpdfTest::template]
    set turned [::tclpdfTest::scratch import-turned.pdf]
    exec qpdf $template --rotate=90:1 $turned
    set doc [tclpdf new -unit pt -format {841.89 595.276}]
    $doc page add
    $doc pdf import quer $turned
    $doc form place quer -at {0 0}
    set size [$doc form size quer]
    set path [::tclpdfTest::scratch import-turned-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template $turned
    list [format %.2f [lindex $size 0]] [format %.2f [lindex $size 1]] \
        [regexp {/Matrix \[0 -1 1 0 } $bytes]
} -result {841.89 595.28 1}

# --- inheritance: the nearest ancestor wins (7.7.3.4) -----------------------

test import-6.1 {inherited attributes come from the nearest ancestor, not the root} -body {
    # Root and intermediate node contradict each other in MediaBox AND
    # Rotate; the page is silent. The intermediate node is closer, so the
    # form is 400x500 turned by 270 - the wrong (top-down) reading answers
    # 100x100 turned by 90.
    set fixture [::tclpdfTest::buildpdf import-inherit.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 100 100\] /Rotate 90 >>" \
        "<< /Type /Pages /Parent 2 0 R /Kids \[4 0 R\] /Count 1 /MediaBox \[0 0 400 500\] /Rotate 270 >>" \
        "<< /Type /Page /Parent 3 0 R /Contents 5 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import erbe $fixture
    set size [$doc form size erbe]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-6.2 {the page's own attribute beats every ancestor} -body {
    set fixture [::tclpdfTest::buildpdf import-inherit-own.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 100 100\] >>" \
        "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 300 600\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import eigen $fixture
    set size [$doc form size eigen]
    $doc destroy
    file delete $fixture
    set size
} -result {300.0 600.0}

# --- CropBox is bounded by the MediaBox (14.11.2.2) --------------------------

test import-7.1 {a CropBox larger than the MediaBox is cut to their intersection} -body {
    # The two boxes come from DIFFERENT nodes: MediaBox inherited from the
    # tree, CropBox on the page. Without the intersection the form would be
    # 600x500.
    set fixture [::tclpdfTest::buildpdf import-crop.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /CropBox \[-100 -100 500 400\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import schnitt $fixture
    set size [$doc form size schnitt]
    $doc destroy
    file delete $fixture
    set size
} -result {200.0 200.0}

test import-7.2 {a CropBox that misses the MediaBox entirely is refused} -body {
    set fixture [::tclpdfTest::buildpdf import-crop-empty.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /CropBox \[300 300 400 400\] /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import leer $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: * the CropBox of page 1 does not intersect its MediaBox*}}

# --- #xx escapes in names (7.3.5.2) ------------------------------------------

test import-8.1 {/Ro#74ate is /Rotate: the escaped name turns the page} -body {
    set fixture [::tclpdfTest::buildpdf import-hash-rotate.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Ro#74ate 90 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import gedreht $fixture
    set size [$doc form size gedreht]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-8.2 {a resource name with a space survives the round trip byte-preservingly} -body {
    # The content stream travels verbatim and keeps /A#20B as written; the
    # resource dictionary is parsed (the key DECODES to "A B") and must be
    # re-escaped on the way out, or the two no longer name the same thing.
    set stream "BT /A#20B 12 Tf (x) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-hash-space.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Font << /A#20B 5 0 R >> >> >>" \
        "<< /Length [string length $stream] >>\nstream\n$stream\nendstream" \
        "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import raum $fixture
    $doc form place raum -at {0 0}
    set path [::tclpdfTest::scratch import-hash-space-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # Once in the copied resources dictionary, once in the content.
    regexp -all {/A#20B} $bytes
} -result 2

test import-8.3 {/Fl#61teDecode is FlateDecode and gets decoded} -body {
    package require tclpdf::filter
    set stream [::tclpdf::filter encodeFlate "BT /Helv 12 Tf 20 40 Td (half one) Tj ET"]
    set fixture [::tclpdfTest::buildpdf import-hash-filter.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length [string length $stream] /Filter /Fl#61teDecode >>\nstream\n$stream\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import flate $fixture
    $doc form place flate -at {0 0}
    set path [::tclpdfTest::scratch import-hash-filter-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    regexp {half one} $bytes
} -result 1

test import-8.4 {a # without two hex digits stays literal; Serialize re-escapes} -body {
    set pos 0
    set a [::tclpdf::import::Parse {/A#5x} pos]
    set pos 0
    set b [::tclpdf::import::Parse {/B#} pos]
    list $a $b [::tclpdf::import::Serialize {nm {A B}} {}] \
        [::tclpdf::import::Serialize {nm A#5x} {}]
} -result {{nm A#5x} {nm B#} /A#20B /A#235x}

# --- optional content: merging and OCMD (8.11.4.2, Table 98) -----------------

test import-9.1 {a second import merges its OCGs into the catalog entry} -body {
    set fixture [::tclpdfTest::handcrafted]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import eins $fixture
    $doc pdf import zwei $fixture
    set entry [$doc catalogEntry OCProperties]
    $doc destroy
    file delete $fixture
    regexp {/OCGs \[([^\]]*)\]} $entry -> ocgs
    regexp {/ON \[([^\]]*)\]} $entry -> on
    list [llength [regexp -all -inline {\d+ 0 R} $ocgs]] \
        [llength [regexp -all -inline {\d+ 0 R} $on]]
} -result {2 2}

test import-10.1 {an OCMD resolves to the groups behind it, not itself} -body {
    # /oc1 points at an OCMD whose /OCGs is a single reference, /oc2 at one
    # whose /OCGs is an array - both forms of Table 98. The catalog array
    # takes the two OCGs; the OCMDs are copied but stay out of it.
    set fixture [::tclpdfTest::buildpdf import-ocmd.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R\
            /Resources << /Properties << /oc1 5 0 R /oc2 6 0 R >> >> >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "<< /Type /OCMD /OCGs 7 0 R >>" \
        "<< /Type /OCMD /OCGs \[8 0 R\] >>" \
        "<< /Type /OCG /Name (One) >>" \
        "<< /Type /OCG /Name (Two) >>"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import ebenen $fixture
    $doc form place ebenen -at {0 0}
    set path [::tclpdfTest::scratch import-ocmd-out.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $fixture
    # Anchored at /OCProperties: the copied OCMDs carry /OCGs arrays of
    # their own, and an unanchored pattern reads one of those instead.
    regexp {/OCProperties << /OCGs \[([^\]]*)\]} $bytes -> inner
    set numbers [lmap {- number} [regexp -all -inline {(\d+) 0 R} $inner] {set number}]
    set kinds [lmap number $numbers {
        expr {[regexp "\n$number 0 obj\n<< /Type /OCG " $bytes] ? "ocg" : "other"}
    }]
    list [llength $numbers] $kinds [regexp {/Type /OCMD} $bytes]
} -result {2 {ocg ocg} 1}

# --- the transparency group of the imported form (PDF/A 6.2.4.3-2) ----------

test import-11.1 {the imported form carries the same group as form create} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-group.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    # Isolated, and deliberately WITHOUT /CS - see xObject.tcl.
    list [regexp {/Subtype /Form} $bytes] \
        [regexp {/Group << /S /Transparency /I true >>} $bytes] \
        [regexp {/Group <<[^>]*/CS} $bytes]
} -result {1 1 0}

test import-11.2 {a document older than PDF 1.4 gets no group} -body {
    set template [::tclpdfTest::template]
    set doc [tclpdf new -unit pt -format a4 -compress 0 -version 1.3]
    $doc page add
    $doc pdf import kopfbogen $template
    $doc form place kopfbogen -at {0 0}
    set path [::tclpdfTest::scratch import-group-13.pdf]
    $doc write $path
    $doc destroy
    set bytes [::tclpdfTest::readBytes $path]
    file delete $path $template
    list [regexp {/Subtype /Form} $bytes] [regexp {/Group} $bytes]
} -result {1 0}

# --- /Length has to end at endstream (7.3.8.1) -------------------------------

test import-12.1 {a /Length overshooting the stream is refused, not copied as garbage} -body {
    set stream "BT (x) Tj ET"
    set fixture [::tclpdfTest::buildpdf import-length.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 4 0 R >>" \
        "<< /Length [expr {[string length $stream] + 40}] >>\nstream\n$stream\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import krumm $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *declares /Length 52 but does not end at endstream}}

# --- white space is six bytes, not Unicode (7.2.2, Table 1) ------------------

test import-13.1 {a raw 0xA0 byte is a regular character and does not split a name} -body {
    set pos 0
    set token [::tclpdf::import::Parse "/Na\xA0me 1" pos]
    list [lindex $token 0] [expr {[lindex $token 1] eq "Na\xA0me"}] \
        [::tclpdf::import::Serialize $token {}]
} -result {nm 1 /Na#A0me}

# --- /Rotate as a real, or not a multiple of 90 (defective files) ------------

test import-14.1 {an integer-valued real /Rotate 90.0 is read as 90} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-real.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 90.0 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    $doc pdf import real $fixture
    set size [$doc form size real]
    $doc destroy
    file delete $fixture
    set size
} -result {500.0 400.0}

test import-14.2 {/Rotate 45 is refused by name, not silently ignored} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-45.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 45 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import schief $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *carries /Rotate 45, which is not a multiple of 90}}

test import-14.3 {a non-integral /Rotate is refused with a tclpdf message, not a raw Tcl error} -body {
    set fixture [::tclpdfTest::buildpdf import-rotate-frac.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 400 500\] >>" \
        "<< /Type /Page /Parent 2 0 R /Rotate 90.5 /Contents 4 0 R >>" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4]
    $doc page add
    set result [catch {$doc pdf import krumm $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: *carries /Rotate "90.5", which is not usable as a multiple of 90}}

# --- a copied stream is a stream, not a hand-built object body ---------------
#
# The resource closure used to assemble "<<...>>\nstream\n...\nendstream" by
# hand and hand THAT to [put]. It was the one stream in the document that
# never saw [writer StreamBody] - so /Length had a second producer beside the
# writer's, and the filter check every other stream passes was skipped.

test import-15.1 {a Flate resource copied into a 1.1 document is refused, not smuggled in} -body {
    # -compress 0, so the only deflated stream in the file is the one the
    # import copies: what the check answers about is unambiguous.
    set stream [::tclpdf::filter encodeFlate "q Q"]
    set fixture [::tclpdfTest::buildpdf import-old-flate.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\]\
            /Filter /FlateDecode /Length [string length $stream] >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream"]]
    set doc [tclpdf new -unit pt -format a4 -version 1.1 -compress 0]
    $doc page add
    set result [catch {$doc pdf import alt $fixture} message]
    $doc destroy
    file delete $fixture
    list $result $message
} -match glob -result {1 {tclpdf: a FlateDecode stream *needs PDF 1.2*}}

test import-15.2 {the copied stream carries one /Length, the writer's, and its bytes are untouched} -body {
    # The fixture states its length INDIRECTLY, which is legal (7.3.8.2) and
    # is why the copy may not simply carry the entry over: object 6 is not
    # part of the resource closure and never travels.
    set stream "q 1 0 0 1 0 0 cm Q"
    set fixture [::tclpdfTest::buildpdf import-indirect-length.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Kids \[3 0 R\] /Count 1 /MediaBox \[0 0 200 200\] >>" \
        "<< /Type /Page /Parent 2 0 R /Contents 5 0 R\
            /Resources << /XObject << /Fm 4 0 R >> >> >>" \
        "<< /Type /XObject /Subtype /Form /BBox \[0 0 10 10\] /Length 6 0 R >>\
            \nstream\n$stream\nendstream" \
        "<< /Length 3 >>\nstream\nq Q\nendstream" \
        "[string length $stream]"]]
    set doc [tclpdf new -unit pt -format a4 -compress 0]
    $doc page add
    $doc pdf import laenge $fixture
    $doc form place laenge -at {0 0}
    set writer [$doc writer]
    set found {}
    for {set number 1} {$number <= [$writer count]} {incr number} {
        set body [$writer body $number]
        if {[string match {*/Subtype /Form*} $body]
                && [string match "*$stream*" $body]} {
            lappend found [regexp -all {/Length} $body] \
                [regexp "/Length [string length $stream]" $body] \
                [::tclpdfTest::streamOf $writer $number]
        }
    }
    $doc destroy
    file delete $fixture
    set found
} -result [list 1 1 "q 1 0 0 1 0 0 cm Q"]

cleanupTests

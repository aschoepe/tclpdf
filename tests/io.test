# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf::io
package require tclpdf
source [file join [file dirname [info script]] helper.tcl]

# The channels a script leaves open that were not open before it. [open] on a
# directory succeeds for reading and only the [read] after it fails, so a
# refusal can come after the channel exists - which is where one used to be
# left behind.
proc ioChannelsLeft {script} {
  set before [chan names]
  catch {uplevel 1 $script}
  set left {}
  foreach channel [chan names] {
    if {$channel ni $before} {
      lappend left $channel
    }
  }
  return $left
}

# A file with the given bytes, in the scratch directory.
proc ioFile {name bytes} {
  set path [::tclpdfTest::scratch $name]
  set channel [open $path w]
  fconfigure $channel -translation binary
  puts -nonewline $channel $bytes
  close $channel
  return $path
}

#
# --- the bytes --------------------------------------------------------------
#

test io-1.1 {read returns the bytes unchanged, CRLF included} -setup {
  set bytes "a\r\nb\n\x00\xff"
  set path [ioFile io-1.1.bin $bytes]
} -body {
  expr {[::tclpdf::io read $path] eq $bytes}
} -cleanup {
  file delete $path
} -result 1

test io-1.2 {an empty file reads as the empty string} -setup {
  set path [ioFile io-1.2.bin {}]
} -body {
  list [::tclpdf::io read $path] [::tclpdf::io head $path 16]
} -cleanup {
  file delete $path
} -result {{} {}}

test io-1.3 {head shorter than the file returns that many bytes} -setup {
  set path [ioFile io-1.3.bin "0123456789\r\n"]
} -body {
  ::tclpdf::io head $path 4
} -cleanup {
  file delete $path
} -result 0123

test io-1.4 {head longer than the file returns the whole file} -setup {
  set path [ioFile io-1.4.bin "abc\r\n"]
} -body {
  expr {[::tclpdf::io head $path 100] eq "abc\r\n"}
} -cleanup {
  file delete $path
} -result 1

test io-1.5 {write writes the bytes unchanged and returns the path} -setup {
  set bytes "x\r\ny\n\x00\xff"
  set path [::tclpdfTest::scratch io-1.5.bin]
} -body {
  list [expr {[::tclpdf::io write $path $bytes] eq $path}] \
      [expr {[::tclpdfTest::readBytes $path] eq $bytes}]
} -cleanup {
  file delete $path
} -result {1 1}

#
# --- the refusals -----------------------------------------------------------
#
# Asked AFTER the open or the read failed rather than before, so that the
# answer cannot go stale between the question and the open. Each refusal is
# a "tclpdf:" message with a TCLPDF IO code.
#

test io-2.1 {read of a missing file is MISSING} -setup {
  set path [::tclpdfTest::scratch io-2.1-missing.bin]
} -body {
  ::tclpdfTest::refuse {::tclpdf::io read $path}
} -result [list 1 1 [list TCLPDF IO MISSING [::tclpdfTest::scratch \
    io-2.1-missing.bin]]]

test io-2.2 {the MISSING message} -setup {
  set path [::tclpdfTest::scratch io-2.2-missing.bin]
} -body {
  catch {::tclpdf::io read $path} message
  expr {$message eq "tclpdf: \"$path\" does not exist"}
} -result 1

test io-2.3 {head of a missing file is MISSING} -setup {
  set path [::tclpdfTest::scratch io-2.3-missing.bin]
} -body {
  expr {[::tclpdfTest::refuse {::tclpdf::io head $path 8}] eq \
      [list 1 1 [list TCLPDF IO MISSING $path]]}
} -result 1

test io-2.4 {read of a directory is DIRECTORY} -setup {
  set path [::tcltest::temporaryDirectory]
} -body {
  expr {[::tclpdfTest::refuse {::tclpdf::io read $path}] eq \
      [list 1 1 [list TCLPDF IO DIRECTORY $path]]}
} -result 1

test io-2.5 {head of a directory is DIRECTORY, not a raw EISDIR} -setup {
  set path [::tcltest::temporaryDirectory]
} -body {
  expr {[::tclpdfTest::refuse {::tclpdf::io head $path 8}] eq \
      [list 1 1 [list TCLPDF IO DIRECTORY $path]]}
} -result 1

test io-2.6 {write to a directory is DIRECTORY} -setup {
  set path [::tcltest::temporaryDirectory]
} -body {
  expr {[::tclpdfTest::refuse {::tclpdf::io write $path abc}] eq \
      [list 1 1 [list TCLPDF IO DIRECTORY $path]]}
} -result 1

test io-2.7 {write into a directory that does not exist is DIRECTORY} -setup {
  set directory [::tclpdfTest::scratch io-2.7-nosuchdir]
} -body {
  expr {[::tclpdfTest::refuse {::tclpdf::io write \
      [file join $directory x.bin] abc}] eq \
      [list 1 1 [list TCLPDF IO DIRECTORY $directory]]}
} -result 1

test io-2.8 {a file this user cannot read keeps the operating system's code} -constraints {
  unreadableFile
} -setup {
  set path [ioFile io-2.8.bin abc]
  file attributes $path -permissions 0000
} -body {
  lrange [::tclpdfTest::refusalCode {::tclpdf::io read $path}] 0 1
} -cleanup {
  file attributes $path -permissions 0644
  file delete $path
} -result {POSIX EACCES}

#
# --- no channel left open ---------------------------------------------------
#

test io-3.1 {a refused read of a missing file leaves no channel open} -body {
  ioChannelsLeft {::tclpdf::io read [::tclpdfTest::scratch io-3.1.bin]}
} -result {}

test io-3.2 {a refused read of a directory leaves no channel open} -body {
  ioChannelsLeft {::tclpdf::io read [::tcltest::temporaryDirectory]}
} -result {}

test io-3.3 {a refused head of a directory leaves no channel open} -body {
  ioChannelsLeft {::tclpdf::io head [::tcltest::temporaryDirectory] 8}
} -result {}

test io-3.4 {a refused head of a missing file leaves no channel open} -body {
  ioChannelsLeft {::tclpdf::io head [::tclpdfTest::scratch io-3.4.bin] 8}
} -result {}

test io-3.5 {a refused write to a directory leaves no channel open} -body {
  ioChannelsLeft {::tclpdf::io write [::tcltest::temporaryDirectory] abc}
} -result {}

test io-3.6 {a refused read of an unreadable file leaves no channel open} -constraints {
  unreadableFile
} -setup {
  set path [ioFile io-3.6.bin abc]
  file attributes $path -permissions 0000
} -body {
  ioChannelsLeft {::tclpdf::io read $path}
} -cleanup {
  file attributes $path -permissions 0644
  file delete $path
} -result {}

test io-3.7 {nor does a successful read, head or write} -setup {
  set path [ioFile io-3.7.bin abc]
} -body {
  ioChannelsLeft {
    ::tclpdf::io read $path
    ::tclpdf::io head $path 2
    ::tclpdf::io write $path xyz
  }
} -cleanup {
  file delete $path
} -result {}

test io-3.8 {head of length 0 is the empty string and leaves no channel open} -setup {
  set path [ioFile io-3.8.bin abc]
} -body {
  set left [ioChannelsLeft {set bytes [::tclpdf::io head $path 0]}]
  list $bytes $left
} -cleanup {
  file delete $path
} -result {{} {}}

#
# --- the shared block -------------------------------------------------------
#
# What fails AFTER the open, with a path that explains nothing, is passed on
# as it was raised - and the channel is closed all the same. Reached through
# the private [Transfer] because no public call can make a readable file fail
# on demand.
#

test io-4.1 {a POSIX error after the open passes through unchanged} -setup {
  set path [ioFile io-4.1.bin abc]
} -body {
  set left [ioChannelsLeft {
    catch {::tclpdf::io::Transfer $path r {apply {{channel} {
      error "disk trouble" {} {POSIX EIO {input/output error}}
    }}}} message options
  }]
  list $message [dict get $options -errorcode] $left
} -cleanup {
  file delete $path
} -result {{disk trouble} {POSIX EIO {input/output error}} {}}

test io-4.2 {so does any other error, and the channel is closed} -setup {
  set path [ioFile io-4.2.bin abc]
} -body {
  set left [ioChannelsLeft {
    catch {::tclpdf::io::Transfer $path r {apply {{channel} {
      error boom {} {TCLPDF TEST}
    }}}} message options
  }]
  list $message [dict get $options -errorcode] $left
} -cleanup {
  file delete $path
} -result {boom {TCLPDF TEST} {}}

cleanupTests

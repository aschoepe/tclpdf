# liga.test --
#
# Standard ligatures out of GSUB, and what they do to the rest of the chain.
#
# A ligature replaces several glyphs by one, which breaks the assumption every
# other part of this package was built on - that a character has a glyph and a
# glyph has a character. The tests below therefore check both ends: that the
# substitution happens, and that the text still comes back out of the file.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::font
package require tclpdf::liga
package require tclpdf::gsubApply
package require tclpdf::gdef
source [file join [file dirname [info script]] helper.tcl]

set assets [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts]
set fontLiga [file join $assets DejaVuSans.ttf]
set fontNone [file join $assets google Niconne-Regular.ttf]
# The only kind of face in this tree that carries "clig": the HelveticaLTStd
# family, four faces, one chaining lookup each and no "liga" at all. Measured
# 2026-08-26 over the 77 faces in examples/assets/fonts.
set fontClig [file join $assets adobe-standard-14 HelveticaLTStd-Roman.otf]

testConstraint haveLiga [file exists $fontLiga]
testConstraint haveNone [file exists $fontNone]
testConstraint haveClig [file exists $fontClig]
testConstraint haveHbShape [expr {[auto_execok hb-shape] ne {}}]

# A run as font.tcl builds it, without the ligatures applied yet. The building
# itself is in helper.tcl - forms.test needs the same run.
interp alias {} ligaRun {} ::tclpdfTest::glyphRun

# --- reading the table ----------------------------------------------------

test liga-1.1 {a font with standard ligatures is recognised} -constraints haveLiga -body {
  set parsed [::tclpdf::sfnt read $fontLiga]
  expr {[llength [::tclpdf::liga build $parsed]] > 0}
} -result 1

test liga-1.2 {a font without them says so} -constraints haveNone -body {
  set parsed [::tclpdf::sfnt read $fontNone]
  ::tclpdf::liga build $parsed
} -result {}

test liga-1.3 {a font without GSUB at all} -body {
  set parsed [dict create bytes {} tables {} numGlyphs 1 unitsPerEm 1000]
  ::tclpdf::liga build $parsed
} -result {}

test liga-1.4 {damaged font data is absorbed, a mistake in the code is not} -body {
  # The error boundary used to sit around the whole table walk and caught
  # everything: a typo in this package then looked exactly like "this font has
  # no ligatures", which is a lie nobody can see through. Only the bounds
  # checks of otLayout raise TCLPDF LAYOUT, and only those may be swallowed.
  #
  # It lives in otLayout since GDEF: kerning and ligatures had a copy each, and
  # the second copy is what the duplicate scanner is for.
  set damaged [::tclpdf::otLayout damaged {::tclpdf::otLayout u16 "" 100}]
  set mistake [catch {::tclpdf::otLayout damaged {no::such::command}} err]
  list $damaged $mistake [string match {invalid command name*} $err]
} -result {1 1 1}

test liga-1.5 {one broken lookup does not discard the others} -constraints haveLiga -body {
  # Collect is handed the lookup indices; a bogus one has to cost only itself.
  set parsed [::tclpdf::sfnt read $fontLiga]
  set gsub [::tclpdf::sfnt table $parsed GSUB]
  set good [::tclpdf::otLayout featureLookups $gsub liga]
  set gdef [::tclpdf::gdef build $parsed]
  set withJunk [::tclpdf::gsubApply prepare $gsub [concat $good 60000] $gdef]
  set onlyGood [::tclpdf::gsubApply prepare $gsub $good $gdef]
  expr {[llength $withJunk] == [llength $onlyGood] && [llength $onlyGood] > 0}
} -result 1

# --- substituting ---------------------------------------------------------

test liga-2.1 {two characters become one glyph} -constraints haveLiga -body {
  set parsed [::tclpdf::sfnt read $fontLiga]
  set run [::tclpdf::liga apply [::tclpdf::liga build $parsed] \
      [ligaRun $parsed "final"]]
  # f and i become one entry, and that entry remembers both characters.
  list [llength $run] [lindex [lindex $run 0] 1]
} -result {4 {102 105}}

test liga-2.2 {three characters become one glyph} -constraints haveLiga -body {
  set parsed [::tclpdf::sfnt read $fontLiga]
  set run [::tclpdf::liga apply [::tclpdf::liga build $parsed] \
      [ligaRun $parsed "office"]]
  list [llength $run] [lindex [lindex $run 1] 1]
} -result {4 {102 102 105}}

test liga-2.3 {the longer ligature wins over its own prefix} -constraints haveLiga -body {
  # "waffle" contains both ffl and the ff inside it. The order in the font
  # decides which one wins - the specification calls it "preference" and does
  # not prescribe it - and a reader takes the first that matches. DejaVu lists
  # ffl first, so taking ff here would be a defect that still looks plausible.
  set parsed [::tclpdf::sfnt read $fontLiga]
  set run [::tclpdf::liga apply [::tclpdf::liga build $parsed] \
      [ligaRun $parsed "waffle"]]
  list [llength $run] [lindex [lindex $run 2] 1]
} -result {4 {102 102 108}}

test liga-2.4 {a run with nothing to substitute is handed back unchanged} -constraints haveLiga -body {
  set parsed [::tclpdf::sfnt read $fontLiga]
  set before [ligaRun $parsed "Rechnung"]
  set after [::tclpdf::liga apply [::tclpdf::liga build $parsed] $before]
  expr {$before eq $after}
} -result 1

test liga-2.5 {a font without ligatures leaves the run alone} -constraints haveNone -body {
  set parsed [::tclpdf::sfnt read $fontNone]
  set before [ligaRun $parsed "final"]
  expr {[::tclpdf::liga apply [::tclpdf::liga build $parsed] $before] eq $before}
} -result 1

test liga-2.6 {a rule at the very end of the run is not applied past it} -constraints haveLiga -body {
  # "af" ends on the first component of several ligatures. Reading on would
  # index past the end of the list, which in Tcl returns an empty string
  # rather than failing - and an empty string compares unequal to every glyph,
  # so the bug would hide until a font used glyph 0.
  set parsed [::tclpdf::sfnt read $fontLiga]
  set before [ligaRun $parsed "af"]
  expr {[::tclpdf::liga apply [::tclpdf::liga build $parsed] $before] eq $before}
} -result 1

# --- what the document does with it ---------------------------------------

test liga-3.1 {ligatures are on without being asked for} -constraints haveLiga -body {
  set doc [::tclpdf::new]
  $doc font embed body $fontLiga
  $doc page add
  set with [$doc textWidth "office" -family body -size 20]
  set without [$doc textWidth "office" -family body -size 20 -ligatures 0]
  $doc destroy
  # The ligature has its own advance, so the two cannot be equal.
  expr {$with != $without}
} -result 1

test liga-3.2 {the glyph count in the stream drops} -constraints haveLiga -body {
  set counts {}
  foreach ligatures {1 0} {
    set doc [::tclpdf::new]
    $doc font embed body $fontLiga
    $doc page add
    $doc text "office" -at {20 20} -family body -size 20 -ligatures $ligatures
    set content [::tclpdfTest::content $doc]
    $doc destroy
    # Two bytes per glyph inside the literal string of the show operator.
    regexp {\((.*)\)\s*Tj} $content -> literal
    set bytes [regsub -all {\\[0-7]{1,3}} $literal x]
    lappend counts [expr {[string length $bytes] / 2}]
  }
  # six characters: four glyphs with the ffi ligature, six without
  set counts
} -result {4 6}

test liga-3.3 {ToUnicode maps the ligature back to all its characters} -constraints haveLiga -body {
  # Without this the word "office" extracts as "o?ce" - the file renders
  # correctly, every validator is happy, and the text is quietly wrong.
  package require tclpdf::filter
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontLiga
  $doc text "office" -at {20 20} -family haus
  set path [::tclpdfTest::scratch liga-tounicode.pdf]
  $doc write $path
  set writer [$doc writer]
  set toUnicodeNumber {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[regexp {/ToUnicode (\d+) 0 R} $body -> found]} {
      set toUnicodeNumber $found
    }
  }
  set map [::tclpdfTest::streamOf $writer $toUnicodeNumber]
  $doc destroy
  file delete $path
  # One bfchar destination of three code units: f, f, i.
  regexp {<[0-9A-F]{4}> <006600660069>} $map
} -result 1

test liga-3.4 {the text comes back out of the file} -constraints haveLiga -body {
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontLiga
  $doc text "office fluffy waffle" -at {20 20} -family haus
  set path [::tclpdfTest::scratch liga-extract.pdf]
  $doc write $path
  $doc destroy
  # pdftotext is not available everywhere, so this reads the map instead:
  # every character of the source has to appear as a destination somewhere.
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  expr {[string length $bytes] > 0}
} -result 1

test liga-3.5 {the ligature glyph reaches the subset} -constraints haveLiga -body {
  # A ligature glyph is not reachable through the cmap - it exists only as the
  # output of a GSUB lookup. It gets into the subset because the run records
  # it as used, and if that ever stops being true the page renders .notdef.
  set doc [tclpdf new]
  $doc page add
  $doc font embed haus $fontLiga
  $doc text "office" -at {20 20} -family haus
  set path [::tclpdfTest::scratch liga-subset.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The embedded file is a font program, and it has to carry more glyphs than
  # the five distinct characters of "office" - the sixth is the ligature.
  expr {[regexp {/FontFile2 \d+ 0 R} $bytes]}
} -result 1

# --- the neighbours -------------------------------------------------------

test liga-4.1 {text on a path ignores kerning and ligatures} -constraints haveLiga -body {
  # Regression. textPath places one glyph at a time and adds up the advances
  # it measured one at a time; measuring the whole string with kerning or
  # ligatures gives a smaller total, and -align center then places the string
  # by a width it never draws. Measured with DejaVu at 20 points the two
  # differed by 4.4 mm over 50 mm of text.
  #
  # Checked through the public API: the drawn result must not depend on the
  # two options at all.
  set streams {}
  foreach flags {{-kerning 1 -ligatures 1} {-kerning 0 -ligatures 0}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc font embed haus $fontLiga
    $doc font -family haus -size 20 {*}$flags
    $doc textPath "office AVATAR" \
        -segments {{move 20 100} {line 100 100}} -align center
    lappend streams [::tclpdfTest::content $doc]
    $doc destroy
  }
  expr {[lindex $streams 0] eq [lindex $streams 1]}
} -result 1

test liga-3.8 {the ToUnicode map does not depend on the order of the calls} -constraints haveLiga -body {
  # Regression. Glyph 5044 of DejaVu Sans is both the GSUB output of "ffi" and
  # the cmap entry for U+FB03. Whichever was drawn last used to win, so a
  # document that drew "office" before U+FB03 extracted the word as
  # o U+FB03 c e - and nobody searching for "office" would find it.
  set maps {}
  foreach order {{office \uFB03} {\uFB03 office}} {
    set doc [tclpdf new]
    $doc page add
    $doc font embed haus $fontLiga
    set y 20
    foreach piece $order {
      $doc text [subst $piece] -at [list 20 $y] -family haus
      incr y 10
    }
    set path [::tclpdfTest::scratch liga-order.pdf]
    $doc write $path
    set writer [$doc writer]
    set number {}
    for {set n 1} {$n <= [$writer count]} {incr n} {
      if {[regexp {/ToUnicode (\d+) 0 R} [$writer body $n] -> found]} {
        set number $found
      }
    }
    lappend maps [regexp {<[0-9A-F]{4}> <006600660069>} \
        [::tclpdfTest::streamOf $writer $number]]
    $doc destroy
    file delete $path
  }
  # Both orders have to keep the three-character destination.
  set maps
} -result {1 1}

test liga-3.9 {-spacing is added per glyph, not per character} -constraints haveLiga -body {
  # Regression. Tc puts its space after every glyph DRAWN, so a ligature that
  # replaces three characters by one glyph also removes two gaps. Counting
  # characters here charged for gaps that never get drawn, and a justified
  # paragraph came out with a frayed right edge whose notches matched the
  # number of ligatures in each line.
  set doc [tclpdf new -unit pt]
  $doc font embed body $fontLiga
  $doc page add
  set result {}
  foreach {text glyphs} {office 4 fi 1 Rechnung 8} {
    set plain [$doc textWidth $text -family body -size 20 -spacing 0]
    set spaced [$doc textWidth $text -family body -size 20 -spacing 10]
    lappend result [expr {abs(($spaced - $plain) - ($glyphs - 1) * 10) < 0.001}]
  }
  $doc destroy
  set result
} -result {1 1 1}

test liga-3.10 {a standard face still counts per character} -body {
  # Without ligatures the two counts are the same, and they have to stay so -
  # the fourteen shipped faces have one glyph per character.
  set doc [tclpdf new -unit pt]
  $doc page add
  set plain [$doc textWidth "office" -family helvetica -size 20 -spacing 0]
  set spaced [$doc textWidth "office" -family helvetica -size 20 -spacing 10]
  $doc destroy
  expr {abs(($spaced - $plain) - 50) < 0.001}
} -result 1

# The lookups that SKIP glyphs while they match, and the run they leave
# behind, are tested in gsubApply.test: the walk over the visible positions is
# that module's and is shared with the cursive forms.


# --- the contextual ligatures ------------------------------------------------
#
# "clig" came in on 2026-08-26 and what let it in is a lookup type: a
# contextual ligature is a ligature with a rule about its surroundings, written
# as a chaining lookup that names an ordinary one, and those were not read
# before the contextual machine existed. The oracle is hb-shape, as it is for
# the cursive forms: what a browser sets with this face is what this package
# has to set.

# The glyph numbers this package produces for a word, ligatures and all.
proc ligaGlyphs {path text} {
  set parsed [::tclpdf::sfnt read $path]
  set glyphs {}
  foreach entry [::tclpdf::liga apply [::tclpdf::liga build $parsed] \
      [ligaRun $parsed $text]] {
    lappend glyphs [lindex $entry 0]
  }
  return $glyphs
}

# The same word through hb-shape, with everything this package does NOT read
# switched off - so that what is compared is the readings of the features it
# does and not a list nobody claimed.
#
# rlig, calt AND rclt LEFT THAT LIST on 2026-08-26, which is the whole point
# of the change that let them in: hb-shape applies them and so does this
# package, and the two answers still agree. What stays switched off is ccmp
# and locl - the two a Latin run does not go through, for the reasons in the
# head of liga.tcl.
proc ligaHarfBuzz {path text {features -ccmp,-locl}} {
  set output [exec hb-shape --no-clusters --no-positions --no-glyph-names \
      --features=$features $path $text]
  return [split [string trim $output {[]}] |]
}

test liga-5.1 {a face whose only ligature feature is clig} -constraints haveClig -body {
  # Four subtables in one chaining lookup, and no "liga" at all - so before
  # this feature was read the face substituted nothing whatever.
  set parsed [::tclpdf::sfnt read $::fontClig]
  set gsub [::tclpdf::sfnt table $parsed GSUB]
  set gdef [::tclpdf::gdef build $parsed]
  # [build] answers a PAIR of STAGE LISTS since rlig, calt and rclt came in -
  # the second is what -ligatures 0 leaves standing - and each stage list
  # holds one stage here, so the count of prepared lookups is two levels
  # down. The face has clig and nothing else, so the second stage list is
  # empty of lookups.
  set prepared [::tclpdf::liga build $parsed]
  list [llength [::tclpdf::otLayout featureLookups $gsub liga]] \
      [llength [::tclpdf::otLayout featureLookups $gsub clig]] \
      [llength [lindex $prepared 0]] [llength [lindex $prepared 0 0]] \
      [llength [lindex $prepared 1 0]]
} -result {0 1 1 1 0}

test liga-5.2 {fi and fl are drawn as the ligature the face has} \
    -constraints {haveClig haveHbShape} -body {
  # And the CONTEXT is what makes it a contextual ligature: two of the four
  # subtables match an f that stands after another f and substitute nothing,
  # so "ffi" keeps its letters where "fi" does not. Compared against hb-shape
  # glyph by glyph rather than asserted, because a rule read the wrong way
  # round would still produce a plausible-looking answer.
  set answers {}
  foreach word {fi fl ffi ffl fj} {
    set ours [ligaGlyphs $::fontClig $word]
    lappend answers [llength $ours] \
        [expr {$ours eq [ligaHarfBuzz $::fontClig $word]}]
  }
  set answers
} -result {1 1 1 1 3 1 3 1 2 1}

test liga-5.3 {the ligature carries both characters back} \
    -constraints haveClig -body {
  # The same rule every ligature obeys: the glyph stands for all the
  # characters it was made of, or the word stops being copyable. A contextual
  # ligature is reached through a chaining lookup that names an ordinary one,
  # so the bookkeeping happens one level down - which is exactly why it is
  # worth a test of its own.
  set parsed [::tclpdf::sfnt read $::fontClig]
  set run [::tclpdf::liga apply [::tclpdf::liga build $parsed] \
      [ligaRun $parsed fi]]
  lmap entry $run {lindex $entry 1}
} -result {{102 105}}

test liga-5.5 {a chaining rule with ONE input glyph fires on a run of one} -body {
  # A ligature needed two glyphs and this module said so - "fewer than two,
  # nothing to ligate" - until the contextual machine arrived. A chaining rule
  # may have an input of exactly one position, with everything it tests in the
  # backtrack and the lookahead, and a rule with no context at all is then a
  # single substitution wearing a chain. hb-shape substitutes; this answered
  # the run it was given.
  #
  # Built by hand rather than measured on a face: no face in this tree carries
  # such a rule, which is why it went unnoticed. The chain matches glyph 10
  # with nothing around it and names a single substitution.
  set gsub [::tclpdfTest::gsubTable [list \
      [::tclpdfTest::gsubLookup 6 0 [list [binary format Su* \
          {3 0 1 16 0 1 0 1 1 1 10}]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 99]]]] \
      [dict create liga {0 1}]]
  # A pair of STAGE LISTS, which is the shape [build] answers in.
  set prepared [list [list [::tclpdf::gsubApply feature $gsub liga {} {} \
      {ligature context chain reverse}]] {}]
  lmap entry [::tclpdf::liga apply $prepared [list [list 10 {97}]]] \
      {lindex $entry 0}
} -result 99

test liga-5.8 {rlig is read for a Latin run, and -ligatures 0 does not stop it} -body {
  # HarfBuzz enables the required ligatures for EVERY script, and required is
  # what they are: a face that draws two characters as one shape because the
  # script demands it is not offering a typographic option. This file used to
  # leave rlig to forms.tcl, so a Latin face that had one was set with the
  # letters apart and said nothing about it.
  #
  # Lookup 0 hangs off rlig and lookup 1 off liga, both on glyph 10, and the
  # answer is the LOWEST index either way - the default shaper puts no pause
  # among the five, measured. What -ligatures 0 changes is only that liga is
  # no longer in the stage: rlig still substitutes.
  set gsub [::tclpdfTest::gsubTable [list \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 99]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 98]]]] \
      [dict create rlig 0 liga 1]]
  set parsed [dict create bytes $gsub \
      tables [dict create GSUB [list 0 [string length $gsub]]]]
  set prepared [::tclpdf::liga build $parsed]
  set run [list [list 10 {97}]]
  list [lmap e [::tclpdf::liga apply $prepared $run] {lindex $e 0}] \
      [lmap e [::tclpdf::liga apply $prepared $run 0] {lindex $e 0}]
} -constraints {} -result {99 99}

test liga-5.9 {and a liga lookup below an rlig one still wins in a Latin run} -body {
  # The counter-test for 5.8, and the reason rlig is NOT a stage of its own
  # here. Measured against hb-shape --script=latn on a face built for it: with
  # liga at lookup 0 and rlig at lookup 1 the answer is the LIGA glyph, so the
  # default shaper has the two in one stage and the lookup index decides.
  # --script=arab on the same face answers the rlig glyph, which is the pause
  # forms.tcl models - see the head of liga.tcl.
  #
  # With -ligatures 0 the liga lookup leaves the stage and rlig has the field.
  set gsub [::tclpdfTest::gsubTable [list \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 99]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 98]]]] \
      [dict create liga 0 rlig 1]]
  set parsed [dict create bytes $gsub \
      tables [dict create GSUB [list 0 [string length $gsub]]]]
  set prepared [::tclpdf::liga build $parsed]
  set run [list [list 10 {97}]]
  list [lmap e [::tclpdf::liga apply $prepared $run] {lindex $e 0}] \
      [lmap e [::tclpdf::liga apply $prepared $run 0] {lindex $e 0}]
} -result {99 98}

test liga-5.7 {calt and rclt are read, and in ONE stage with liga and clig} -body {
  # HarfBuzz's default shaper puts no pause between the four, so their lookups
  # are applied in LOOKUP ORDER across the features rather than feature by
  # feature. Measured black-box on four little faces in which liga, calt and
  # rclt each substitute the same glyph with the lookup indices permuted:
  # hb-shape answers the LOWEST index in all six permutations.
  #
  # Here the same arrangement in one table: lookup 0 hangs off calt and lookup
  # 1 off liga, both on glyph 10. One stage means lookup 0 wins whichever
  # feature named it; a stage per feature in the order this file lists them
  # would answer 98 for the "liga first" reading and 99 either way for a
  # reader that dropped calt altogether.
  # A chaining lookup rather than a plain single substitution, because that is
  # what this module asks a feature for - see [liga build].
  set gsub [::tclpdfTest::gsubTable [list \
      [::tclpdfTest::gsubLookup 6 0 [list [binary format Su* \
          {3 0 1 16 0 1 0 2 1 1 10}]]] \
      [::tclpdfTest::gsubLookup 6 0 [list [binary format Su* \
          {3 0 1 16 0 1 0 3 1 1 10}]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 99]]] \
      [::tclpdfTest::gsubLookup 1 0 [list [::tclpdfTest::gsubSingle 10 98]]]] \
      [dict create calt 0 liga 1 rclt {}]]
  # A parsed face is a dict of bytes and a table directory; the GSUB above is
  # the only table this module reads.
  set parsed [dict create bytes $gsub \
      tables [dict create GSUB [list 0 [string length $gsub]]]]
  set prepared [::tclpdf::liga build $parsed]
  set run [list [list 10 {97}]]
  list [lmap e [::tclpdf::liga apply $prepared $run] {lindex $e 0}] \
      [lmap e [::tclpdf::liga apply $prepared $run 0] {lindex $e 0}] \
      [llength [lindex $prepared 0 0]]
} -result {99 99 2}

test liga-5.6 {-ligatures 0 leaves the contextual alternates on} -constraints \
    haveClig -body {
  # HarfBuzz answers --features=-liga,-clig with calt and rclt still applied:
  # a contextual alternate is another SHAPE of a letter, not a ligature, and a
  # caller who wanted the letters to stand apart did not ask for a different
  # letter. So [build] answers two prepared stages and [apply] drops the one
  # that holds liga and clig.
  #
  # This face carries clig and nothing else, so the second stage is empty -
  # which is the answer that has to be right as well: without ligatures it
  # substitutes nothing.
  set parsed [::tclpdf::sfnt read $::fontClig]
  set prepared [::tclpdf::liga build $parsed]
  set run [ligaRun $parsed fi]
  list [lmap e [::tclpdf::liga apply $prepared $run 1] {lindex $e 0}] \
      [lmap e [::tclpdf::liga apply $prepared $run 0] {lindex $e 0}] \
      [lmap e $run {lindex $e 0}]
} -result {224 {71 74} {71 74}}

test liga-5.4 {-ligatures 0 switches BOTH off} -constraints haveClig -body {
  # The registry gives liga and clig the same default and the same job, and a
  # caller who says "set this line without ligatures" means the letters are to
  # stand apart - leaving the contextual half on would leave an fi in the
  # middle of it. Measured through the glyph count in the stream, which is
  # what a reader sees.
  set counts {}
  foreach ligatures {1 0} {
    set doc [tclpdf new]
    $doc font embed helvetica $::fontClig
    $doc page add
    # -kerning 0 so that the show operator is a plain Tj: this face kerns the
    # pair and a TJ array would have the count spread over several strings.
    $doc text "fifty" -at {20 20} -family helvetica -size 20 -kerning 0 \
        -ligatures $ligatures
    set content [::tclpdfTest::content $doc]
    $doc destroy
    # Two bytes per glyph inside the literal string of the show operator.
    regexp {\((.*)\)\s*Tj} $content -> literal
    set bytes [regsub -all {\\[0-7]{1,3}} $literal x]
    lappend counts [expr {[string length $bytes] / 2}]
  }
  # five characters: four glyphs with the fi ligature, five without
  set counts
} -result {4 5}

cleanupTests

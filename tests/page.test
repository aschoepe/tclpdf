# page.test --
#
# The page module's measuring surface: coords, distance, extent, fitExtent and
# the content buffer.
#
# These four are the layer every topical module draws through, and until now
# not one of them had a test of its own - they were exercised only as a side
# effect of drawing something. That is the wrong way round: a defect in [coords]
# shows up as a picture in the wrong place three modules away, and the test that
# fails then says nothing about where it came from.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::page
package require tclpdf::shape
package require tclpdf::xObject
source [file join [file dirname [info script]] helper.tcl]

proc pageRound {values {digits 3}} {
  return [lmap value $values {format %.*f $digits $value}]
}

test page-coords-1.1 {the y axis is mirrored, the x axis is not} -body {
  # A4 is 841.89 pt high, 10 mm is 28.346 pt: x passes through, y is measured
  # from the top. The whole package depends on this one line.
  set doc [tclpdf new]
  $doc page add
  set point [$doc coords 10 10]
  $doc destroy
  pageRound $point
} -result {28.346 813.543}

test page-coords-1.2 {the origin follows the unit, not the number} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set point [$doc coords 10 10]
  $doc destroy
  # In points nothing is converted, so y is simply the page height less ten.
  pageRound $point
} -result {10.000 831.890}

test page-coords-1.3 {inside a form the mirror axis is the form, not the page} -body {
  # Measured the hard way once already: with the page height everything drawn
  # into a form lands outside its bounding box - still in the file, not on the
  # page, and no validator says a word.
  set doc [tclpdf new]
  $doc page add
  set inside {}
  $doc form create box -size {50 40} -script {
    set inside [$doc coords 0 0]
  }
  $doc destroy
  # The top left corner of a 40 mm tall form is at its own height in points.
  pageRound $inside
} -result {0.000 113.386}

test page-distance-2.1 {a length carries no origin} -body {
  set doc [tclpdf new]
  $doc page add
  set values [list [$doc distance 10] [$doc distance 1 in] [$doc distance 10 pt]]
  $doc destroy
  pageRound $values
} -result {28.346 72.000 10.000}

test page-distance-2.2 {the document unit is the default, the argument wins} -body {
  set doc [tclpdf new -unit cm]
  $doc page add
  set values [list [$doc distance 1] [$doc distance 1 mm]]
  $doc destroy
  pageRound $values
} -result {28.346 2.835}

test page-extent-3.1 {extent converts a pair the same way distance converts one} -body {
  # The point of [extent] is that forms and tiling patterns share it. If it
  # ever stopped agreeing with [distance], the two would drift apart silently.
  set doc [tclpdf new]
  $doc page add
  set pair [$doc extent {10 20}]
  set single [list [$doc distance 10] [$doc distance 20]]
  $doc destroy
  list [pageRound $pair] [expr {$pair eq $single}]
} -result {{28.346 56.693} 1}

test page-extent-3.2 {extent takes a unit like distance does} -body {
  set doc [tclpdf new]
  $doc page add
  set pair [$doc extent {10 20} pt]
  $doc destroy
  pageRound $pair
} -result {10.000 20.000}

test page-fit-4.1 {a width alone keeps the aspect ratio} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width 40 height {} scale {}}]
  $doc destroy
  pageRound $size
} -result {40.000 20.000}

test page-fit-4.2 {a height alone keeps it too} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height 40 scale {}}]
  $doc destroy
  pageRound $size
} -result {80.000 40.000}

test page-fit-4.3 {both given means both obeyed, ratio or not} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width 40 height 40 scale {}}]
  $doc destroy
  pageRound $size
} -result {40.000 40.000}

test page-fit-4.4 {-size wins over everything else} -body {
  # The order matters: -size is the caller being explicit, and a -width left
  # over from an earlier call must not quietly override it.
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {30 30} width 40 height 40 scale 2}]
  $doc destroy
  pageRound $size
} -result {30.000 30.000}

test page-fit-4.5 {scale multiplies the natural size} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale 0.5}]
  $doc destroy
  pageRound $size
} -result {50.000 25.000}

test page-fit-4.6 {nothing given leaves the natural size alone} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale {}}]
  $doc destroy
  pageRound $size
} -result {100.000 50.000}

test page-content-5.1 {the buffer can be read back per page} -body {
  # [page content] is the diagnosis tool the manual points at, and it takes an
  # index: without it a test can only ever see the page it is standing on.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red
  $doc page add
  $doc circle -at {50 50} -radius 10 -stroke black
  set first [$doc page content 0]
  set second [$doc page content 1]
  set current [$doc page content]
  $doc destroy
  list [string match {*re*} $first] [string match {*re*} $second] \
      [expr {$current eq $second}]
} -result {1 0 1}

test page-content-5.2 {an index outside the document is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page content 7} message]
  $doc destroy
  list $code [string match {*page*} $message]
} -result {1 1}

# -- page boxes: what is refused before it is stored --------------------------
#
# Measured 2026-08-16, before the checks: -format {0 0}, a crop box of
# {-10 -10 9999 9999} on A4, a reversed pair and a box of no area all went
# through and into the file, and neither qpdf nor veraPDF (PDF/A-1b) said a
# word about any of them.

test page-box-6.1 {a box inside the media box is stored and read back} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  $doc page box trim {0 0 210 297}
  set result [list [pageRound [$doc page box crop]] [pageRound [$doc page box trim]]]
  $doc destroy
  set result
} -result {{10.000 10.000 200.000 287.000} {0.000 0.000 210.000 297.000}}

test page-box-6.2 {a box sticking out to the left is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {-1 10 200 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.3 {a box sticking out at the bottom is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box bleed {10 -1 200 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.4 {a box sticking out to the right is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box trim {10 10 211 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.5 {a box sticking out at the top is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box art {10 10 200 298}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.6 {the message names both rectangles in the document unit} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {0 0 300 100}} message]
  $doc destroy
  list $code [string match {*{0 0 300 100} mm*{0 0 210 297} mm*} $message]
} -result {1 1}

test page-box-6.7 {a box refused leaves the page as it was} -body {
  # Refuse before write: a failed crop box must not half-arrive.
  set doc [tclpdf new]
  $doc page add
  catch {$doc page box crop {0 0 300 100}}
  set crop [$doc page box crop]
  $doc destroy
  set crop
} -result {}

test page-box-6.8 {a box of no width or no height is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach box {{10 10 10 100} {10 10 100 10} {10 10 10 10}} {
    lappend codes [catch {$doc page box crop $box} message]
  }
  $doc destroy
  list $codes [string match {*x1 must exceed x0*} $message]
} -result {{1 1 1} 1}

test page-box-6.9 {reversed corners are refused, not swapped} -body {
  # 7.9.5 lets a reader normalise any two diagonal corners; tclpdf names the
  # mistake instead, because coords and page size take the order literally.
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {200 287 10 10}} message]
  set crop [$doc page box crop]
  $doc destroy
  list $code [string match {*x1 must exceed x0*} $message] $crop
} -result {1 1 {}}

test page-box-6.10 {0.001 pt of slack: a rounding residue passes, a real overhang does not} -body {
  # A caller's own arithmetic in mm may end a hair past the table value; that
  # is not an overhang. 0.001 mm beyond the edge is 0.0028 pt, and is.
  set doc [tclpdf new]
  $doc page add
  set residue [catch {$doc page box crop {0 0 210 297.0000001}}]
  set overhang [catch {$doc page box crop {0 0 210 297.001}} message]
  $doc destroy
  list $residue $overhang [string match {*outside the media box*} $message]
} -result {0 1 1}

test page-box-6.11 {a media box below 3 pt is refused} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set code [catch {$doc page box media {0 0 2 2}} message]
  $doc destroy
  list $code [string match {*between 3 and 14400 pt*} $message]
} -result {1 1}

test page-box-6.12 {a media box above 14400 pt is refused, 14400 itself is not} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set refused [catch {$doc page box media {0 0 14401 100}} message]
  set allowed [catch {$doc page box media {0 0 14400 14400}}]
  $doc destroy
  list $refused [string match {*between 3 and 14400 pt*} $message] $allowed
} -result {1 1 0}

test page-box-6.13 {5080 mm is exactly 14400 pt and passes} -body {
  set doc [tclpdf new]
  set code [catch {$doc page add -format {5080 5080}} message]
  $doc destroy
  list $code $message
} -result {0 0}

test page-box-6.14 {page add refuses a -format of no size or negative size} -body {
  set doc [tclpdf new]
  set codes {}
  foreach format {{0 0} {-100 -50} {6000 6000} {0.5 100}} {
    lappend codes [catch {$doc page add -format $format} message]
  }
  set count [$doc page count]
  $doc destroy
  list $codes $count [string match {*-format*between 3 and 14400 pt*} $message]
} -result {{1 1 1 1} 0 1}

test page-box-6.15 {shrinking the media box under a crop box is refused} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  set code [catch {$doc page box media {0 0 100 100}} message]
  set size [$doc page size]
  $doc destroy
  list $code [string match {*page box crop*outside the media box*} $message] \
      [pageRound $size 0]
} -result {1 1 {210 297}}

test page-box-6.16 {growing the media box, or moving it while it still holds the others, is fine} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  set code [catch {$doc page box media {-10 -10 300 300}} message]
  set size [$doc page size]
  $doc destroy
  list $code [pageRound $size 0]
} -result {0 {310 310}}

test page-box-6.17 {the getters are what they were} -body {
  set doc [tclpdf new]
  $doc page add
  set before [list [$doc page box media] [$doc page box crop] [$doc page size]]
  $doc destroy
  list [pageRound [lindex $before 0]] [lindex $before 1] [pageRound [lindex $before 2]]
} -result {{0.000 0.000 210.000 297.000} {} {210.000 297.000}}

test page-box-6.18 {a list that is not four numbers is still refused first} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {1 2 3}} message]
  $doc destroy
  list $code [string match {*x0 y0 x1 y1*} $message]
} -result {1 1}

# -- page typeArea ------------------------------------------------------------

test page-typeArea-7.1 {without -typeArea the area is five percent in from every edge} -body {
  # A4: 210 x 297. 5 % of the height top and bottom, 5 % of the width at
  # the sides - the rule table has always used for -top and -bottom.
  set doc [tclpdf new -unit mm]
  $doc page add
  set area [$doc page typeArea]
  $doc destroy
  lmap v $area {format %.2f $v}
} -result {10.50 14.85 199.50 282.15}

test page-typeArea-7.2 {two margins set top and bottom, four set the sides as well} -body {
  set doc [tclpdf new -unit mm -typeArea {20 25}]
  $doc page add
  set two [$doc page typeArea]
  $doc configure -typeArea {20 25 15 18}
  set four [$doc page typeArea]
  $doc destroy
  list [lmap v $two {format %.2f $v}] [lmap v $four {format %.2f $v}]
} -result {{10.50 20.00 199.50 272.00} {15.00 20.00 192.00 272.00}}

test page-typeArea-7.3 {the area follows the page it is asked about} -body {
  # The margins are distances; a landscape page has a different area than
  # a portrait one, and each page answers for itself.
  set doc [tclpdf new -unit mm -typeArea {20 25 15 15}]
  $doc page add
  $doc page add -format a5 -orientation landscape
  set first [$doc page typeArea 0]
  set second [$doc page typeArea]
  $doc destroy
  list [lmap v $first {format %.2f $v}] [lmap v $second {format %.2f $v}]
} -result {{15.00 20.00 195.00 272.00} {15.00 20.00 195.00 123.00}}

test page-typeArea-7.4 {margins that meet leave no area and are refused at the page} -body {
  set doc [tclpdf new -unit mm -typeArea {150 150}]
  $doc page add
  set code [catch {$doc page typeArea} message]
  # The option itself is fine - a taller page would take it.
  $doc page add -format {210 400}
  set tall [$doc page typeArea]
  $doc destroy
  list $code [regexp {leaves no room on a page of 210 by 297} $message] \
      [lmap v $tall {format %.2f $v}]
} -result {1 1 {10.50 150.00 199.50 250.00}}

test page-typeArea-7.5 {typeArea is among the page subcommands the error names} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set code [catch {$doc page area} message]
  $doc destroy
  list $code [regexp {known are: add, count, current, size, box, typeArea, content} $message]
} -result {1 1}

# -- the index argument of page size and page box ------------------------------
#
# Both answer for the CURRENT page without one; with an index they answer for
# that page, whichever is current. Measured on a document whose pages differ,
# so that the wrong page would show.

test page-index-8.1 {page size index answers the page asked for, not the current one} -body {
  set doc [tclpdf new -unit mm]
  $doc page add -format a4
  $doc page add -format a5 -orientation landscape
  $doc page add -format {88 55}
  set sizes [lmap i {0 1 2} {lmap v [$doc page size $i] {format %.0f $v}}]
  set current [lmap v [$doc page size] {format %.0f $v}]
  set code [catch {$doc page size 3} message]
  $doc destroy
  list $sizes $current $code [string match {*no such page: 3*} $message]
} -result {{{210 297} {210 148} {88 55}} {88 55} 1 1}

test page-index-8.2 {page box with an index reads and sets a box on another page} -body {
  set doc [tclpdf new -unit mm]
  $doc page add -format a4
  $doc page add -format a5
  # Setting on page 0 while page 1 is current: the value comes before the
  # index, and an empty value with an index is a read.
  $doc page box crop {10 10 200 287} 0
  set first [lmap v [$doc page box crop {} 0] {format %.0f $v}]
  set second [$doc page box crop {} 1]
  set current [$doc page box crop]
  set media [lmap v [$doc page box media {} 0] {format %.0f $v}]
  $doc destroy
  list $first $second $current $media
} -result {{10 10 200 287} {} {} {0 0 210 297}}

test page-index-8.3 {a box set with an index lands on that page in the file} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc page add
  $doc page box trim {20 20 190 277} 0
  set path [::tclpdfTest::scratch page-index-trim.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # One TrimBox in the whole file, and it sits in the object of the first
  # page: /Type /Page objects are written in page order.
  set pages [regexp -all -inline {<<[^>]*/Type /Page\M[^>]*>>} $bytes]
  list [regexp -all {/TrimBox} $bytes] \
      [regexp {/TrimBox} [lindex $pages 0]] [regexp {/TrimBox} [lindex $pages 1]]
} -result {1 1 0}

# -- one optional index, and the message when there is more ------------------

test page-args-9.1 {page typeArea and page size take one optional index, and say so} -body {
  # "page typeArea 0 1" used to leak the arity of the private method: 'wrong #
  # args: should be "my PageTypeArea ?index?"'.
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach subcommand {typeArea size} {
    lappend out [catch {$doc page $subcommand 0 1} message] \
        [string equal $message "tclpdf: page $subcommand takes one optional\
        page index, got \"0 1\""] [llength [$doc page $subcommand 0]] \
        [llength [$doc page $subcommand]]
  }
  $doc destroy
  set out
} -result {1 1 4 4 1 1 2 2}

# -- fitting into a box, and where in it the thing sits ----------------------
#
# The arithmetic that [image place] -fit, -fitMode, -align and -valign is made
# of. Tested here rather than only through a picture for the reason at the head
# of this file: a defect in the sum shows up as a photograph two millimetres
# out three modules away, and the pixels that catch it (image.test) say nothing
# about which of the three options was wrong.

test page-fitbox-10.1 {contain takes the smaller factor, so the whole of it fits} -body {
  # 100 x 50 into 40 x 40: across is 0.4, down is 0.8, and contain takes the
  # 0.4 - which is what makes both edges fit.
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale {}
      fit {40 40} fitMode contain}]
  $doc destroy
  pageRound $size
} -result {40.000 20.000}

test page-fitbox-10.2 {cover takes the larger factor, so the box is covered} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale {}
      fit {40 40} fitMode cover}]
  $doc destroy
  pageRound $size
} -result {80.000 40.000}

test page-fitbox-10.3 {an empty -fitMode is contain} -body {
  # The default is EMPTY rather than the word, so that "-fitMode contain"
  # without a box can be told from a caller who never mentioned it - see
  # page-fitbox-12.4. It has to mean contain here all the same.
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale {}
      fit {40 40} fitMode {}}]
  $doc destroy
  pageRound $size
} -result {40.000 20.000}

test page-fitbox-10.4 {a box of the same shape fills exactly, either way round} -body {
  # 100 x 50 into 60 x 30 is one factor, not two, so contain and cover have
  # nothing to choose between and both answer the box itself.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach mode {contain cover} {
    lappend out {*}[pageRound [$doc fitExtent 100 50 \
        [list size {} width {} height {} scale {} fit {60 30} fitMode $mode]]]
  }
  $doc destroy
  set out
} -result {60.000 30.000 60.000 30.000}

test page-fitbox-10.5 {-fit stands before -size, -width, -height and -scale} -body {
  # Not because it wins a contest - those four are refused beside it in
  # [fitCheck] - but so that a dict carrying both cannot come out of the
  # wrong branch if a caller ever reaches this method directly.
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {200 200} width 90 height 90 scale 3
      fit {40 40} fitMode contain}]
  $doc destroy
  pageRound $size
} -result {40.000 20.000}

test page-anchor-11.1 {without a box the two options are the plain anchor} -body {
  # A box of no size: the corner moves by -fraction * the thing's own extent,
  # so "right" puts its right edge on the x that was given and "bottom" its
  # bottom edge on the y.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach {align valign} {left top center middle right bottom} {
    lappend out {*}[pageRound [$doc fitAnchor {100 100} 40 10 \
        [list fit {} align $align valign $valign]]]
  }
  $doc destroy
  set out
} -result {100.000 100.000 80.000 95.000 60.000 90.000}

test page-anchor-11.2 {inside a box the leftover is what is split} -body {
  # 40 x 10 in a 60 x 40 box at {100 100}: centred leaves 10 at each side and
  # 15 above and below, trailing leaves 20 and 30.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach {align valign} {left top center middle right bottom} {
    lappend out {*}[pageRound [$doc fitAnchor {100 100} 40 10 \
        [list fit {60 40} align $align valign $valign]]]
  }
  $doc destroy
  set out
} -result {100.000 100.000 110.000 115.000 120.000 130.000}

test page-anchor-11.3 {a covered box has a NEGATIVE leftover, and the same sum} -body {
  # 160 x 40 covering a 40 x 40 box at {60 100}: centred, the picture starts
  # 60 mm to the LEFT of the box and hangs out on both sides - which is what
  # the clip in image.tcl then cuts away.
  set doc [tclpdf new]
  $doc page add
  set corner [$doc fitAnchor {60 100} 160 40 \
      {fit {40 40} align center valign middle}]
  $doc destroy
  pageRound $corner
} -result {0.000 100.000}

test page-anchor-11.4 {"centre" is taken beside "center", as [text] takes it} -body {
  set doc [tclpdf new]
  $doc page add
  set out [list [$doc fitAnchor {100 100} 40 10 {fit {} align centre valign top}] \
      [$doc fitAnchor {100 100} 40 10 {fit {} align center valign top}]]
  $doc destroy
  expr {[lindex $out 0] eq [lindex $out 1]}
} -result 1

test page-anchor-11.5 {an absent option is the default, not an error} -body {
  # [fitAnchor] is reached from [image place], where the dict always carries
  # all four - but a dict without them has to mean the top left corner rather
  # than fail on a [dict get].
  set doc [tclpdf new]
  $doc page add
  set corner [$doc fitAnchor {30 40} 20 10 {}]
  $doc destroy
  pageRound $corner
} -result {30.000 40.000}

test page-fitcheck-12.1 {a box is two lengths above zero} -body {
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach value {{} {40} {40 20 10} {40 x} {40 0} {-1 20}} {
    if {$value eq {}} {
      continue
    }
    lappend out [::tclpdfTest::refuse [list $doc fitCheck \
        [list fit $value fitMode {} align left valign top] "image place"]]
  }
  $doc destroy
  set out
} -result {{1 1 {TCLPDF FIT BOX 40 {image place}}}\
    {1 1 {TCLPDF FIT BOX {40 20 10} {image place}}}\
    {1 1 {TCLPDF FIT BOX {40 x} {image place}}}\
    {1 1 {TCLPDF FIT BOX {40 0} {image place}}}\
    {1 1 {TCLPDF FIT BOX {-1 20} {image place}}}}

test page-fitcheck-12.2 {a good box passes and says nothing} -body {
  set doc [tclpdf new]
  $doc page add
  set out [catch {$doc fitCheck \
      {fit {40 20} fitMode cover align center valign bottom} "image place"} \
      message]
  $doc destroy
  list $out $message
} -result {0 {}}

test page-fitcheck-12.3 {-fit and a size option contradict each other} -body {
  # Both say how large the thing comes out. One would have to win in silence.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach key {size width height scale} {
    lappend out [lindex [::tclpdfTest::refuse [list $doc fitCheck \
        [list fit {40 20} $key 30 fitMode {} align left valign top] \
        "image place"]] 2]
  }
  $doc destroy
  set out
} -result {{TCLPDF FIT SIZE size {image place}} {TCLPDF FIT SIZE width {image place}}\
    {TCLPDF FIT SIZE height {image place}} {TCLPDF FIT SIZE scale {image place}}}

test page-fitcheck-12.4 {-fitMode is a word from the list, and needs a box} -body {
  set doc [tclpdf new]
  $doc page add
  set out [list \
      [lindex [::tclpdfTest::refuse [list $doc fitCheck \
          {fit {40 20} fitMode meet align left valign top} "image place"]] 2] \
      [lindex [::tclpdfTest::refuse [list $doc fitCheck \
          {fit {} fitMode cover align left valign top} "image place"]] 2]]
  $doc destroy
  set out
} -result {{TCLPDF FIT MODE meet {image place}} {TCLPDF FIT MODE cover {image place}}}

test page-fitcheck-12.5 {-align and -valign take the words of their own axis} -body {
  # The two lists do NOT overlap: "middle" is not an -align and "center" is
  # not a -valign, so a caller who mixed the axes is told which axis they are
  # on rather than being placed somewhere plausible.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach {align valign} {middle top left center justify top left baseline} {
    lappend out [lindex [::tclpdfTest::refuse [list $doc fitCheck \
        [list fit {} fitMode {} align $align valign $valign] \
        "image place"]] 2]
  }
  $doc destroy
  set out
} -result {{TCLPDF FIT ALIGN -align middle {image place}}\
    {TCLPDF FIT ALIGN -valign center {image place}}\
    {TCLPDF FIT ALIGN -align justify {image place}}\
    {TCLPDF FIT ALIGN -valign baseline {image place}}}

test page-fitcheck-12.6 {a turned placement is not placed in an upright box} -body {
  # -fit, -align and -valign describe an UPRIGHT box, and -rotate turns the
  # placement about the corner they just moved. Measured before the refusal
  # stood: a picture fitted into a 40 by 40 box at {20 20} and turned by 90
  # degrees came out entirely beside that box ("0 40 -30 0 20 150 cm"), and a
  # covered box was clipped by a rectangle standing at an angle to the
  # picture - so neither the box nor the anchor meant what it says.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach options {
    {fit {40 40} fitMode {} align left valign top rotate 90}
    {fit {40 40} fitMode cover align center valign top rotate 30}
    {fit {} fitMode {} align right valign top rotate 15}
    {fit {} fitMode {} align left valign bottom rotate -15}
  } {
    lappend out [lindex [::tclpdfTest::refuse [list $doc fitCheck $options \
        "image place"]] 2]
  }
  $doc destroy
  set out
} -result {{TCLPDF FIT ROTATE 90 {image place}}\
    {TCLPDF FIT ROTATE 30 {image place}}\
    {TCLPDF FIT ROTATE 15 {image place}}\
    {TCLPDF FIT ROTATE -15 {image place}}}

test page-fitcheck-12.7 {the words that do not move the corner stand beside -rotate} -body {
  # -align left and -valign top are what a placement does anyway, so spelling
  # them out beside -rotate gets exactly what the words say - the fractions
  # are compared, not the words, which is why "centre" would be refused and
  # "left" is not. And a rotation of zero is no rotation.
  set doc [tclpdf new]
  $doc page add
  set out {}
  foreach options {
    {fit {} fitMode {} align left valign top rotate 90}
    {fit {40 40} fitMode {} align left valign top rotate 0}
    {fit {40 40} fitMode cover align centre valign middle}
  } {
    lappend out [catch {$doc fitCheck $options "image place"}]
  }
  $doc destroy
  set out
} -result {0 0 0}

test page-rotate-9.1 {a rotation that is not a number is named} -body {
  # Asked BEFORE the modulo, which is where an empty string used to die as
  # "can't use empty string as operand of %" - a raw Tcl error where this
  # package promises a message of its own.
  set doc [tclpdf new -unit mm]
  set answers {}
  foreach value {{} abc 1.5} {
    lappend answers [catch {$doc page add -rotate $value} message]
    lappend answers [string match {tclpdf:*} $message]
  }
  $doc destroy
  set answers
} -result {1 1 1 1 1 1}

test page-rotate-9.2 {and a multiple of 90 still goes through} -body {
  set doc [tclpdf new -unit mm]
  set added [catch {$doc page add -rotate 90}]
  $doc destroy
  set added
} -result 0


# --- NaN and Inf on the way into points -------------------------------------
#
# [geometry toPoints] reads its value with [string is double -strict], which
# is true for "NaN" and for "Inf". NaN then compares false against every range
# check written as a comparison, so it travelled through this module untouched
# and died in Tcl's own words far from the call that wrote it. [distance] is
# the one conversion from the caller's unit into points, so it is where they
# are turned away.

test page-number-10.1 {a length that is a double and no number} -body {
  # Measured on 2026-08-25 before the check stood: every one of these answered
  # "can't use non-numeric floating-point value as operand of \"*\"".
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach value {NaN Inf -Inf} {
    set code [catch {$doc distance $value} message]
    lappend out $code [string match {tclpdf:*} $message]
  }
  lappend out [catch {$doc distance 20}]
  $doc destroy
  set out
} -result {1 1 1 1 1 1 0}

test page-number-10.2 {and the same for a coordinate, which runs through it} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach value {NaN Inf} {
    lappend out [::tclpdfTest::refusal {$doc coords $value 20}]
    lappend out [::tclpdfTest::refusal {$doc coords 20 $value}]
  }
  $doc destroy
  set out
} -result {{TCLPDF OPTION NUMBER {a length} {}} {TCLPDF OPTION NUMBER {a length} {}}\
    {TCLPDF OPTION NUMBER {a length} {}} {TCLPDF OPTION NUMBER {a length} {}}}

test page-number-10.3 {a word is still not a measurement, in the old words} -body {
  # The wording [geometry toPoints] has used since 1.0 stays where it was:
  # three test files read it, and a caller who mistyped a variable name gets
  # the message about the value rather than one about NaN. Only the double
  # that is no number is new.
  set doc [tclpdf new -unit mm]
  $doc page add
  set code [catch {$doc distance abc} message]
  $doc destroy
  list $code [string match {*not a measurement*} $message]
} -result {1 1}

test page-number-10.4 {every drawing road refuses it, and before it writes} -body {
  # The point of putting it in [distance]: the refusal is made once and every
  # module that measures anything inherits it. The stream must be untouched
  # afterwards - the value is turned away before the "q" and the mark.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc rect -at {10 10} -size {10 10}
  set before [::tclpdfTest::content $doc]
  set out {}
  foreach call {
    {rect -at {NaN 10} -size {10 10}}
    {rect -at {10 10} -size {NaN 10}}
    {rect -at {10 10} -size {10 10} -radius NaN}
    {line -from {Inf 1} -to {10 10}}
    {text x -at {10 NaN}}
  } {
    set code [catch {$doc {*}$call} message]
    lappend out [expr {$code && [string match {tclpdf:*} $message]}]
  }
  lappend out [expr {$before eq [::tclpdfTest::content $doc]}]
  $doc destroy
  set out
} -result {1 1 1 1 1 1}

test page-number-10.5 {a page of NaN by NaN was accepted, because the limits are comparisons} -body {
  # [PageBoxLimits] holds a page between 3 and 14400 pt, and NaN is false
  # against both bounds - so the page went in and every coordinate on it came
  # out NaN. Measured 2026-08-25.
  set doc [tclpdf new -unit mm]
  set out {}
  foreach format {{NaN 200} {200 Inf} {NaN NaN}} {
    set code [catch {$doc page add -format $format} message]
    lappend out $code [string match {tclpdf:*-format*} $message]
  }
  lappend out [$doc page count]
  $doc destroy
  set out
} -result {1 1 1 1 1 1 0}

test page-number-10.6 {a page box too, and the page keeps the box it had} -body {
  set doc [tclpdf new -unit mm -format a4]
  $doc page add
  set code [catch {$doc page box crop {10 10 NaN 200}} message]
  set media [$doc page box media]
  $doc destroy
  list $code [string match {tclpdf:*} $message] [lindex $media 2]
} -result {1 1 210.0}

test page-number-10.7 {-fit takes lengths, and NaN is not one} -body {
  # [fitCheck] read the box with [string is double -strict] and held it above
  # zero with "$value <= 0", which is FALSE for NaN - so the box was waved
  # past and died in the arithmetic. text.tcl had to repeat the check in its
  # own words for exactly that reason.
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach box {{NaN 40} {40 Inf} {-Inf 40}} {
    lappend out [::tclpdfTest::refusal {$doc fitCheck [dict create fit $box] "image place"}]
  }
  $doc destroy
  set out
} -result {{TCLPDF FIT BOX {NaN 40} {image place}} {TCLPDF FIT BOX {40 Inf} {image place}}\
    {TCLPDF FIT BOX {-Inf 40} {image place}}}

test page-number-10.8 {an angle that is a double and no angle} -body {
  # NaN is unequal to 0 - as it is to everything, itself included - so a NaN
  # -rotate walked into the refusal about -fit and -rotate together and was
  # reported as a combination of options; without -fit it walked past it and
  # into cos(). All three roads that turn a placement come through [fitCheck].
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach options {{rotate NaN} {rotate Inf} {fit {40 40} rotate NaN}} {
    lappend out [::tclpdfTest::refusal {$doc fitCheck $options "image place"}]
  }
  # A word is not an angle at all, and each road says so in its own words -
  # this one is not judged here.
  lappend out [catch {$doc fitCheck {rotate x} "image place"}]
  $doc destroy
  set out
} -result {{TCLPDF OPTION NUMBER -rotate {image place}} {TCLPDF OPTION NUMBER -rotate {image place}}\
    {TCLPDF OPTION NUMBER -rotate {image place}} 0}

test page-number-10.9 {the sizing options, before the arithmetic reads them} -body {
  # [geometry checkFit] holds these above zero, and "$value <= 0" is false for
  # NaN - so they arrived in [fitExtent] and died as an operand of "*" or "/".
  set doc [tclpdf new -unit mm]
  $doc page add
  set out {}
  foreach options {
    {size {NaN 10} width {} height {} scale {}}
    {size {} width Inf height {} scale {}}
    {size {} width {} height NaN scale {}}
    {size {} width {} height {} scale NaN}
  } {
    lappend out [::tclpdfTest::refusal {$doc fitExtent 40 20 $options}]
  }
  lappend out [$doc fitExtent 40 20 {size {} width 20 height {} scale {}}]
  $doc destroy
  set out
} -result {{TCLPDF OPTION NUMBER -size {}} {TCLPDF OPTION NUMBER -width {}}\
    {TCLPDF OPTION NUMBER -height {}} {TCLPDF OPTION NUMBER -scale {}} {20 10.0}}

cleanupTests

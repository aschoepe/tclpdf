# page.test --
#
# The page module's measuring surface: coords, distance, extent, fitExtent and
# the content buffer.
#
# These four are the layer every topical module draws through, and until now
# not one of them had a test of its own - they were exercised only as a side
# effect of drawing something. That is the wrong way round: a defect in [coords]
# shows up as a picture in the wrong place three modules away, and the test that
# fails then says nothing about where it came from.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::page
package require tclpdf::shape
package require tclpdf::xObject
source [file join [file dirname [info script]] helper.tcl]

proc pageRound {values {digits 3}} {
  return [lmap value $values {format %.*f $digits $value}]
}

test page-coords-1.1 {the y axis is mirrored, the x axis is not} -body {
  # A4 is 841.89 pt high, 10 mm is 28.346 pt: x passes through, y is measured
  # from the top. The whole package depends on this one line.
  set doc [tclpdf new]
  $doc page add
  set point [$doc coords 10 10]
  $doc destroy
  pageRound $point
} -result {28.346 813.543}

test page-coords-1.2 {the origin follows the unit, not the number} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set point [$doc coords 10 10]
  $doc destroy
  # In points nothing is converted, so y is simply the page height less ten.
  pageRound $point
} -result {10.000 831.890}

test page-coords-1.3 {inside a form the mirror axis is the form, not the page} -body {
  # Measured the hard way once already: with the page height everything drawn
  # into a form lands outside its bounding box - still in the file, not on the
  # page, and no validator says a word.
  set doc [tclpdf new]
  $doc page add
  set inside {}
  $doc form create box -size {50 40} -script {
    set inside [$doc coords 0 0]
  }
  $doc destroy
  # The top left corner of a 40 mm tall form is at its own height in points.
  pageRound $inside
} -result {0.000 113.386}

test page-distance-2.1 {a length carries no origin} -body {
  set doc [tclpdf new]
  $doc page add
  set values [list [$doc distance 10] [$doc distance 1 in] [$doc distance 10 pt]]
  $doc destroy
  pageRound $values
} -result {28.346 72.000 10.000}

test page-distance-2.2 {the document unit is the default, the argument wins} -body {
  set doc [tclpdf new -unit cm]
  $doc page add
  set values [list [$doc distance 1] [$doc distance 1 mm]]
  $doc destroy
  pageRound $values
} -result {28.346 2.835}

test page-extent-3.1 {extent converts a pair the same way distance converts one} -body {
  # The point of [extent] is that forms and tiling patterns share it. If it
  # ever stopped agreeing with [distance], the two would drift apart silently.
  set doc [tclpdf new]
  $doc page add
  set pair [$doc extent {10 20}]
  set single [list [$doc distance 10] [$doc distance 20]]
  $doc destroy
  list [pageRound $pair] [expr {$pair eq $single}]
} -result {{28.346 56.693} 1}

test page-extent-3.2 {extent takes a unit like distance does} -body {
  set doc [tclpdf new]
  $doc page add
  set pair [$doc extent {10 20} pt]
  $doc destroy
  pageRound $pair
} -result {10.000 20.000}

test page-fit-4.1 {a width alone keeps the aspect ratio} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width 40 height {} scale {}}]
  $doc destroy
  pageRound $size
} -result {40.000 20.000}

test page-fit-4.2 {a height alone keeps it too} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height 40 scale {}}]
  $doc destroy
  pageRound $size
} -result {80.000 40.000}

test page-fit-4.3 {both given means both obeyed, ratio or not} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width 40 height 40 scale {}}]
  $doc destroy
  pageRound $size
} -result {40.000 40.000}

test page-fit-4.4 {-size wins over everything else} -body {
  # The order matters: -size is the caller being explicit, and a -width left
  # over from an earlier call must not quietly override it.
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {30 30} width 40 height 40 scale 2}]
  $doc destroy
  pageRound $size
} -result {30.000 30.000}

test page-fit-4.5 {scale multiplies the natural size} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale 0.5}]
  $doc destroy
  pageRound $size
} -result {50.000 25.000}

test page-fit-4.6 {nothing given leaves the natural size alone} -body {
  set doc [tclpdf new]
  $doc page add
  set size [$doc fitExtent 100 50 {size {} width {} height {} scale {}}]
  $doc destroy
  pageRound $size
} -result {100.000 50.000}

test page-content-5.1 {the buffer can be read back per page} -body {
  # [page content] is the diagnosis tool the manual points at, and it takes an
  # index: without it a test can only ever see the page it is standing on.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red
  $doc page add
  $doc circle -at {50 50} -radius 10 -stroke black
  set first [$doc page content 0]
  set second [$doc page content 1]
  set current [$doc page content]
  $doc destroy
  list [string match {*re*} $first] [string match {*re*} $second] \
      [expr {$current eq $second}]
} -result {1 0 1}

test page-content-5.2 {an index outside the document is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page content 7} message]
  $doc destroy
  list $code [string match {*page*} $message]
} -result {1 1}

# -- page boxes: what is refused before it is stored --------------------------
#
# Measured 2026-08-16, before the checks: -format {0 0}, a crop box of
# {-10 -10 9999 9999} on A4, a reversed pair and a box of no area all went
# through and into the file, and neither qpdf nor veraPDF (PDF/A-1b) said a
# word about any of them.

test page-box-6.1 {a box inside the media box is stored and read back} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  $doc page box trim {0 0 210 297}
  set result [list [pageRound [$doc page box crop]] [pageRound [$doc page box trim]]]
  $doc destroy
  set result
} -result {{10.000 10.000 200.000 287.000} {0.000 0.000 210.000 297.000}}

test page-box-6.2 {a box sticking out to the left is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {-1 10 200 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.3 {a box sticking out at the bottom is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box bleed {10 -1 200 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.4 {a box sticking out to the right is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box trim {10 10 211 287}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.5 {a box sticking out at the top is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box art {10 10 200 298}} message]
  $doc destroy
  list $code [string match {*outside the media box*} $message]
} -result {1 1}

test page-box-6.6 {the message names both rectangles in the document unit} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {0 0 300 100}} message]
  $doc destroy
  list $code [string match {*{0 0 300 100} mm*{0 0 210 297} mm*} $message]
} -result {1 1}

test page-box-6.7 {a box refused leaves the page as it was} -body {
  # Refuse before write: a failed crop box must not half-arrive.
  set doc [tclpdf new]
  $doc page add
  catch {$doc page box crop {0 0 300 100}}
  set crop [$doc page box crop]
  $doc destroy
  set crop
} -result {}

test page-box-6.8 {a box of no width or no height is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach box {{10 10 10 100} {10 10 100 10} {10 10 10 10}} {
    lappend codes [catch {$doc page box crop $box} message]
  }
  $doc destroy
  list $codes [string match {*x1 must exceed x0*} $message]
} -result {{1 1 1} 1}

test page-box-6.9 {reversed corners are refused, not swapped} -body {
  # 7.9.5 lets a reader normalise any two diagonal corners; tclpdf names the
  # mistake instead, because coords and page size take the order literally.
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {200 287 10 10}} message]
  set crop [$doc page box crop]
  $doc destroy
  list $code [string match {*x1 must exceed x0*} $message] $crop
} -result {1 1 {}}

test page-box-6.10 {0.001 pt of slack: a rounding residue passes, a real overhang does not} -body {
  # A caller's own arithmetic in mm may end a hair past the table value; that
  # is not an overhang. 0.001 mm beyond the edge is 0.0028 pt, and is.
  set doc [tclpdf new]
  $doc page add
  set residue [catch {$doc page box crop {0 0 210 297.0000001}}]
  set overhang [catch {$doc page box crop {0 0 210 297.001}} message]
  $doc destroy
  list $residue $overhang [string match {*outside the media box*} $message]
} -result {0 1 1}

test page-box-6.11 {a media box below 3 pt is refused} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set code [catch {$doc page box media {0 0 2 2}} message]
  $doc destroy
  list $code [string match {*between 3 and 14400 pt*} $message]
} -result {1 1}

test page-box-6.12 {a media box above 14400 pt is refused, 14400 itself is not} -body {
  set doc [tclpdf new -unit pt]
  $doc page add
  set refused [catch {$doc page box media {0 0 14401 100}} message]
  set allowed [catch {$doc page box media {0 0 14400 14400}}]
  $doc destroy
  list $refused [string match {*between 3 and 14400 pt*} $message] $allowed
} -result {1 1 0}

test page-box-6.13 {5080 mm is exactly 14400 pt and passes} -body {
  set doc [tclpdf new]
  set code [catch {$doc page add -format {5080 5080}} message]
  $doc destroy
  list $code $message
} -result {0 0}

test page-box-6.14 {page add refuses a -format of no size or negative size} -body {
  set doc [tclpdf new]
  set codes {}
  foreach format {{0 0} {-100 -50} {6000 6000} {0.5 100}} {
    lappend codes [catch {$doc page add -format $format} message]
  }
  set count [$doc page count]
  $doc destroy
  list $codes $count [string match {*-format*between 3 and 14400 pt*} $message]
} -result {{1 1 1 1} 0 1}

test page-box-6.15 {shrinking the media box under a crop box is refused} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  set code [catch {$doc page box media {0 0 100 100}} message]
  set size [$doc page size]
  $doc destroy
  list $code [string match {*page box crop*outside the media box*} $message] \
      [pageRound $size 0]
} -result {1 1 {210 297}}

test page-box-6.16 {growing the media box, or moving it while it still holds the others, is fine} -body {
  set doc [tclpdf new]
  $doc page add
  $doc page box crop {10 10 200 287}
  set code [catch {$doc page box media {-10 -10 300 300}} message]
  set size [$doc page size]
  $doc destroy
  list $code [pageRound $size 0]
} -result {0 {310 310}}

test page-box-6.17 {the getters are what they were} -body {
  set doc [tclpdf new]
  $doc page add
  set before [list [$doc page box media] [$doc page box crop] [$doc page size]]
  $doc destroy
  list [pageRound [lindex $before 0]] [lindex $before 1] [pageRound [lindex $before 2]]
} -result {{0.000 0.000 210.000 297.000} {} {210.000 297.000}}

test page-box-6.18 {a list that is not four numbers is still refused first} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc page box crop {1 2 3}} message]
  $doc destroy
  list $code [string match {*x0 y0 x1 y1*} $message]
} -result {1 1}

# -- page typeArea ------------------------------------------------------------

test page-typeArea-7.1 {without -typeArea the area is five percent in from every edge} -body {
  # A4: 210 x 297. 5 % of the height top and bottom, 5 % of the width at
  # the sides - the rule table has always used for -top and -bottom.
  set doc [tclpdf new -unit mm]
  $doc page add
  set area [$doc page typeArea]
  $doc destroy
  lmap v $area {format %.2f $v}
} -result {10.50 14.85 199.50 282.15}

test page-typeArea-7.2 {two margins set top and bottom, four set the sides as well} -body {
  set doc [tclpdf new -unit mm -typeArea {20 25}]
  $doc page add
  set two [$doc page typeArea]
  $doc configure -typeArea {20 25 15 18}
  set four [$doc page typeArea]
  $doc destroy
  list [lmap v $two {format %.2f $v}] [lmap v $four {format %.2f $v}]
} -result {{10.50 20.00 199.50 272.00} {15.00 20.00 192.00 272.00}}

test page-typeArea-7.3 {the area follows the page it is asked about} -body {
  # The margins are distances; a landscape page has a different area than
  # a portrait one, and each page answers for itself.
  set doc [tclpdf new -unit mm -typeArea {20 25 15 15}]
  $doc page add
  $doc page add -format a5 -orientation landscape
  set first [$doc page typeArea 0]
  set second [$doc page typeArea]
  $doc destroy
  list [lmap v $first {format %.2f $v}] [lmap v $second {format %.2f $v}]
} -result {{15.00 20.00 195.00 272.00} {15.00 20.00 195.00 123.00}}

test page-typeArea-7.4 {margins that meet leave no area and are refused at the page} -body {
  set doc [tclpdf new -unit mm -typeArea {150 150}]
  $doc page add
  set code [catch {$doc page typeArea} message]
  # The option itself is fine - a taller page would take it.
  $doc page add -format {210 400}
  set tall [$doc page typeArea]
  $doc destroy
  list $code [regexp {leaves no room on a page of 210 by 297} $message] \
      [lmap v $tall {format %.2f $v}]
} -result {1 1 {10.50 150.00 199.50 250.00}}

test page-typeArea-7.5 {typeArea is among the page subcommands the error names} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set code [catch {$doc page area} message]
  $doc destroy
  list $code [regexp {known are: add, count, current, size, box, typeArea, content} $message]
} -result {1 1}

# -- the index argument of page size and page box ------------------------------
#
# Both answer for the CURRENT page without one; with an index they answer for
# that page, whichever is current. Measured on a document whose pages differ,
# so that the wrong page would show.

test page-index-8.1 {page size index answers the page asked for, not the current one} -body {
  set doc [tclpdf new -unit mm]
  $doc page add -format a4
  $doc page add -format a5 -orientation landscape
  $doc page add -format {88 55}
  set sizes [lmap i {0 1 2} {lmap v [$doc page size $i] {format %.0f $v}}]
  set current [lmap v [$doc page size] {format %.0f $v}]
  set code [catch {$doc page size 3} message]
  $doc destroy
  list $sizes $current $code [string match {*no such page: 3*} $message]
} -result {{{210 297} {210 148} {88 55}} {88 55} 1 1}

test page-index-8.2 {page box with an index reads and sets a box on another page} -body {
  set doc [tclpdf new -unit mm]
  $doc page add -format a4
  $doc page add -format a5
  # Setting on page 0 while page 1 is current: the value comes before the
  # index, and an empty value with an index is a read.
  $doc page box crop {10 10 200 287} 0
  set first [lmap v [$doc page box crop {} 0] {format %.0f $v}]
  set second [$doc page box crop {} 1]
  set current [$doc page box crop]
  set media [lmap v [$doc page box media {} 0] {format %.0f $v}]
  $doc destroy
  list $first $second $current $media
} -result {{10 10 200 287} {} {} {0 0 210 297}}

test page-index-8.3 {a box set with an index lands on that page in the file} -body {
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc page add
  $doc page box trim {20 20 190 277} 0
  set path [::tclpdfTest::scratch page-index-trim.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # One TrimBox in the whole file, and it sits in the object of the first
  # page: /Type /Page objects are written in page order.
  set pages [regexp -all -inline {<<[^>]*/Type /Page\M[^>]*>>} $bytes]
  list [regexp -all {/TrimBox} $bytes] \
      [regexp {/TrimBox} [lindex $pages 0]] [regexp {/TrimBox} [lindex $pages 1]]
} -result {1 1 0}

cleanupTests

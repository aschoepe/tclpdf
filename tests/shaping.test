# shaping.test --
#
# Which writing systems this package refuses to set, and which it must not
# refuse.
#
# THE SECOND HALF IS THE IMPORTANT ONE. A check like this fails in two
# directions, and only one of them is loud: too narrow and Arabic still comes
# out wrong, too wide and the package stops setting text it handled correctly
# yesterday. The counter-tests below name the scripts that MUST keep working -
# Tibetan among them, because its stacked consonants look like a case for
# shaping and are not.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::shaping
source [file join [file dirname [info script]] helper.tcl]

set assets [file join [file dirname [file dirname [file normalize [info script]]]] \
    examples assets fonts]
set arabicFace [file join $assets google NotoNaskhArabic-Variable.ttf]
set tibetanFace [file join $assets google NotoSerifTibetan-Variable.ttf]
set latinFace [file join $assets DejaVuSans.ttf]

testConstraint haveArabic [file exists $arabicFace]
testConstraint haveTibetan [file exists $tibetanFace]
testConstraint haveLatin [file exists $latinFace]
# The Hebrew face is the Latin one: measured, DejaVu Sans carries the whole
# letter range U+05D0..U+05EA, and no face of its own for the script ships
# with the examples.
testConstraint haveHebrew [file exists $latinFace]

# A supplementary-plane character is one character to Tcl 9 and a replacement
# character to Tcl 8.6's \U escape - measured: "\U0001E900" scans as U+FFFD
# in 8.6. Decoded from its UTF-8 bytes it is the right character in both, so
# that is how the tests below spell such a character.
proc smp {code} {
  return [encoding convertfrom utf-8 [binary format cccc \
      [expr {0xF0 | ($code >> 18)}] [expr {0x80 | (($code >> 12) & 0x3F)}] \
      [expr {0x80 | (($code >> 6) & 0x3F)}] [expr {0x80 | ($code & 0x3F)}]]]
}

test shaping-1.1 {a script that needs shaping is found, with its position} -body {
  # The position counts characters from zero, exactly as the missing-glyph
  # message does - two messages about the same string should point at it the
  # same way.
  lassign [::tclpdf::shaping needed "abcبdef"] position code system
  list $position [format %04X $code] $system
} -result {3 0628 Arabic}

test shaping-1.2 {plain text needs nothing} -body {
  list [::tclpdf::shaping needed "Grüße aus Bochum"] \
      [::tclpdf::shaping needed "Ελλάδα Москва"] \
      [::tclpdf::shaping needed ""]
} -result {{} {} {}}

test shaping-1.3 {the scripts that must NOT be refused} -body {
  # Every one of these is set correctly today, and a wider list would break
  # them. Tibetan LETTERS are the ones worth naming: consonants, tsheg and
  # digits are one glyph each and come out right (02.09-writing-systems);
  # its vowel signs and subjoined letters are marks and are refused, 1.6.
  set faults {}
  foreach {name text} [list \
      Tibetan "ཀཁག" \
      CJK "日本語" \
      Greek "Ελλάδα" \
      Cyrillic "Москва" \
      Cuneiform "\U00012000\U00012001" \
      Hieroglyphs "\U00013000\U00013001" \
      Symbols "♠♪⛰"] {
    set finding [::tclpdf::shaping needed $text]
    if {[llength $finding]} {
      lappend faults "$name refused: [lindex $finding 2]"
    }
  }
  set faults
} -result {}

test shaping-1.4 {the scripts that must be refused, and why} -body {
  # One representative per group, with the reason it is in the list. A script
  # moving between groups - or falling out - shows up here rather than in a
  # document nobody can read.
  set found {}
  foreach {name char} [list \
      Arabic ب Hebrew א Syriac ܐ Thaana ހ \
      Devanagari क Bengali ক Tamil க \
      Thai ก Lao ກ Myanmar က Khmer ក] {
    lassign [::tclpdf::shaping needed $char] - - system what
    lappend found $name $system
  }
  set found
} -result {Arabic Arabic Hebrew Hebrew Syriac Syriac Thaana Thaana Devanagari Devanagari Bengali Bengali Tamil Tamil Thai Thai Lao Lao Myanmar Myanmar Khmer Khmer}

test shaping-1.6 {Tibetan marks are refused, Tibetan letters are not} -body {
  # Mark attachment did NOT lift this one, and the reason is measured rather
  # than assumed - see shaping-8.1 to shaping-8.4 below, which are the four
  # halves of it. In short: HarfBuzz sets a Tibetan stack by SUBSTITUTING one
  # precomposed glyph for the letter and the mark (GSUB abvs, blws), and no
  # anchor can produce a glyph the cmap does not lead to.
  set found {}
  foreach {name text} [list \
      letters "ཀཁག" tsheg "བོད" subjoined "བཀྲ" digits "༡༢༣" halanta "ཀ྄"] {
    set finding [::tclpdf::shaping needed $text]
    lappend found $name [expr {[llength $finding] ? "[lindex $finding 2]/[lindex $finding 3]" : "-"}]
  }
  set found
} -result {letters - tsheg {Tibetan/stacked forms out of GSUB} subjoined {Tibetan/stacked forms out of GSUB} digits - halanta {Tibetan/stacked forms out of GSUB}}

test shaping-1.5 {the presentation forms are caught as well} -body {
  # Someone who has already shaped their text by hand into the Arabic
  # Presentation Forms blocks is in the same position: the ORDER is still
  # wrong, and that is what the message says.
  lassign [::tclpdf::shaping needed "ﺑ"] - - system what
  list $system [string match {*right-to-left*} $what]
} -result {Arabic 1}

test shaping-2.1 {drawing such a script left to right is refused} \
    -constraints haveArabic -body {
  # Arabic needs the contextual forms AND the order. The forms exist now
  # (forms.tcl); the order is still the caller's to ask for, so a line set
  # without -direction rtl is refused and told which option it wants.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::arabicFace
  set code [catch {$doc text "الع" -at {20 20} -family ar} message]
  $doc destroy
  list $code [string match {*belongs to Arabic*} $message] \
      [string match {*-direction rtl*} $message]
} -result {1 1 1}

test shaping-2.2 {-unshaped 1 draws it anyway} -constraints haveArabic -body {
  # The escape hatch, and it has to produce actual glyphs rather than merely
  # not throwing.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::arabicFace
  $doc text "الع" -at {20 20} -family ar -unshaped 1
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [regexp {BT} $content] [regexp {Tj|TJ} $content]
} -result {1 1}

test shaping-2.3 {the option can be set on the font state} -constraints haveArabic -body {
  # Like -kerning and -ligatures: per call or once for the document.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::arabicFace
  $doc font -family ar -unshaped 1
  set code [catch {$doc text "الع" -at {20 20}}]
  $doc destroy
  set code
} -result 0

test shaping-2.4 {measuring is refused too, not only drawing} -constraints haveArabic -body {
  # textWidth goes through the same run. If it measured what text refuses to
  # draw, a table column would be sized for a line that never appears.
  set doc [tclpdf new -unit mm]
  $doc font embed ar $::arabicFace
  set code [catch {$doc textWidth "الع" -family ar}]
  set open [catch {$doc textWidth "الع" -family ar -unshaped 1}]
  $doc destroy
  list $code $open
} -result {1 0}

test shaping-2.5 {a face for a script that does not need it is unaffected} -constraints haveTibetan -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed tib $::tibetanFace
  set code [catch {$doc text "ཀཁག" -at {20 20} -family tib} message]
  $doc destroy
  list $code $message
} -result {0 {}}

test shaping-2.6 {a Tibetan vowel sign is refused with the face in hand, and -unshaped 1 draws it} -constraints haveTibetan -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed tib $::tibetanFace
  set code [catch {$doc text "བོད" -at {20 20} -family tib} message]
  set forced [catch {$doc text "བོད" -at {20 30} -family tib -unshaped 1}]
  $doc destroy
  list $code [regexp {Tibetan} $message] [regexp {stacked forms} $message] $forced
} -result {1 1 1 0}

test shaping-3.1 {a finding says which of the two things is missing} -body {
  # The kind is what a caller can act on, and it is appended rather than
  # inserted so that the three fields the older callers read stay where they
  # were.
  set hebrew [::tclpdf::shaping needed "א"]
  set arabic [::tclpdf::shaping needed "ب"]
  # The nikud is asked for under rtl: under ltr the LETTER in front of it is
  # already a finding, and the first offender is what comes back.
  set nikud [::tclpdf::shaping needed "בָ" rtl]
  # A Kharoshthi vowel sign in the place the nikud used to hold: still a
  # finding of kind "shaping", because such a mark has to be REORDERED before
  # it can be placed, and reordering is what this package does not have.
  set kharoshthi [::tclpdf::shaping needed "[smp 0x10A10][smp 0x10A01]" rtl]
  list [lindex $hebrew 4] [lindex $arabic 4] [lindex $nikud 4] \
      [lindex $kharoshthi 4] [lindex $kharoshthi 3] [lindex $kharoshthi 0]
} -result {ordering forms {} shaping {mark reordering} 1}

test shaping-3.2 {under rtl only the ordering findings fall away} -body {
  # And the walk CONTINUES past them: a Hebrew line with one Arabic word in
  # it is still refused, and refused on the Arabic - which is the character
  # to look at, not the first Hebrew letter before it.
  set mixed [::tclpdf::shaping needed "שלום ب" rtl]
  list [::tclpdf::shaping needed "שלום" rtl] \
      [lindex $mixed 0] [lindex $mixed 2] \
      [expr {[::tclpdf::shaping needed "ب" rtl] ne {}}]
} -result {{} 5 Arabic 1}

test shaping-3.3 {the message names the way out that exists} -body {
  # Telling someone to set -unshaped 1 for a Hebrew line hands them the
  # isolated-glyph escape hatch when one option would set the line correctly.
  set ordering [::tclpdf::shaping message [::tclpdf::shaping needed "א"]]
  set cursive [::tclpdf::shaping message [::tclpdf::shaping needed "ب"]]
  # A mark that has to be reordered is the case where -unshaped 1 IS the only
  # way past, and it has to keep saying so. The Arabic fatha used to stand
  # here and no longer can: mark attachment places it, so the line is set.
  set mark [::tclpdf::shaping message \
      [::tclpdf::shaping needed "[smp 0x10A10][smp 0x10A01]" rtl]]
  list [string match {*-direction rtl*} $ordering] \
      [string match {*-unshaped*} $ordering] \
      [string match {*-direction rtl*} $cursive] \
      [string match {*-unshaped*} $cursive] \
      [string match {*-unshaped 1*} $mark]
} -result {1 0 1 0 1}

test shaping-4.1 {Hebrew is refused until the direction is given} \
    -constraints haveHebrew -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed heb $::latinFace
  set refused [catch {$doc text "שלום" -at {20 20} -family heb} message]
  set drawn [catch {$doc text "שלום" -at {20 30} -family heb -direction rtl}]
  # Measuring goes the same way, or a table column would be sized for a line
  # that is then refused.
  set measured [catch {$doc textWidth "שלום" -family heb}]
  set measuredRtl [catch {$doc textWidth "שלום" -family heb -direction rtl}]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $refused [string match {*-direction rtl*} $message] $drawn \
      $measured $measuredRtl [regexp {Tj|TJ} $content]
} -result {1 1 0 1 0 1}

test shaping-4.2 {nikud are set with their letters, not refused} -constraints haveHebrew -body {
  # This used to be a refusal: the points are combining marks, and a mark the
  # package could not place landed beside its letter instead of under it.
  # markPos.tcl places them, so the whole word goes through - and what has to
  # be checked is not that nothing threw but that something MOVED. The
  # offsets ride in TJ arrays beside the glyphs; markPos-9.x pins the numbers.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed heb $::latinFace
  set code [catch {$doc text "שָׁלוֹם" -at {20 20} -family heb -direction rtl} message]
  set measured [catch {$doc textWidth "שָׁלוֹם" -family heb -direction rtl}]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $code $message $measured [regexp {TJ} $content]
} -result {0 {} 0 1}

test shaping-4.3 {Arabic with the direction and a face that can set it} \
    -constraints haveHebrew -body {
  # DejaVu Sans, which carries whole Arabic letters. -direction rtl is now
  # the whole answer for it: the forms come out of the face and the run is
  # reversed, so the line is set rather than refused.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed ar $::latinFace
  set drawn [catch {$doc text "الع" -at {190 20} -family ar -direction rtl}]
  set measured [catch {$doc textWidth "الع" -family ar -direction rtl}]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $drawn $measured [regexp {Tj|TJ} $content]
} -result {0 0 1}

test shaping-4.4 {a face whose dots are separate glyphs is set, not refused} \
    -constraints haveArabic -body {
  # Noto Naskh Arabic reaches its forms through ccmp, which writes a letter as
  # a skeleton plus a dot glyph of its own. That dot is placed by GPOS mark
  # attachment, and until markPos.tcl existed the line was refused for it -
  # measured on this face, the two dots of teh marbuta belong 294 font units
  # lower than the pen leaves them, which at 28 pt puts them over the letter
  # in front. Now they are placed and the line is set.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed ar $::arabicFace
  set code [catch {$doc text "مرحبا" -at {190 20} -family ar -direction rtl} message]
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list $code $message [regexp {TJ} $content]
} -result {0 {} 1}

test shaping-4.5 {a face with no forms at all is refused differently} \
    -constraints haveTibetan -body {
  # The Tibetan face has no init, medi or fina - and the message has to name
  # THAT rather than the marks, or the reader goes looking in the wrong
  # place. It has no Arabic glyphs either; the refusal comes first, which is
  # the point: the face is judged before the characters are looked up.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed tib $::tibetanFace
  set code [catch {$doc text "الع" -at {190 20} -family tib -direction rtl} message]
  $doc destroy
  list $code [string match {*no contextual forms*} $message]
} -result {1 1}

test shaping-4.6 {Arabic with vowel signs is set} \
    -constraints {haveHebrew haveArabic} -body {
  # The fatha used to be the second half of the Arabic refusal: the forms came
  # out of the face and the vowel sign did not, so a vowelled line was refused
  # on the vowel. Mark attachment places it and the refusal is gone.
  #
  # Asked of BOTH faces on purpose - DejaVu Sans writes whole letters, Noto
  # Naskh writes skeletons plus separate dots, which are the two roads a face
  # can take to the same word, and neither is refused any more.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  $doc font embed whole $::latinFace
  $doc font embed split $::arabicFace
  set a [catch {$doc text "مَرحبا" -at {190 20} -family whole -direction rtl} first]
  set b [catch {$doc text "مَرحبا" -at {190 30} -family split -direction rtl} second]
  $doc destroy
  list $a $first $b $second
} -result {0 {} 0 {}}

test shaping-2.6 {the standard fourteen are unaffected} -constraints haveLatin -body {
  # WinAnsi has none of these characters, so the standard faces could never
  # have reached the check - and must not be slowed down by it either.
  set doc [tclpdf new -unit mm]
  $doc page add
  set code [catch {$doc text "Grüße aus Bochum" -at {20 20}}]
  $doc destroy
  set code
} -result 0

test shaping-5.1 {the joining scripts the list used to miss are refused, in both directions} -body {
  # Measured 2026-08-18: U+0860, U+0872, U+1820 passed as needing nothing,
  # although the joining table knows every one of them as D or R. Syriac
  # Supplement joins like Syriac, Arabic Extended-B is Arabic and takes the
  # cursive road, and Mongolian joins without running right to left - so its
  # message must not send anyone to -direction rtl.
  set found {}
  foreach {name char} [list SyriacSup "\u0860" ArabicExtB "\u0872" \
      Mongolian "\u1820" PhagsPa "\uA840"] {
    foreach direction {ltr rtl} {
      set finding [::tclpdf::shaping needed $char $direction]
      lappend found "$name/$direction" [expr {[llength $finding] ?
          "[lindex $finding 2]/[lindex $finding 4]" : "-"}]
    }
  }
  list $found [string match "*needs contextual shaping - tclpdf does not*" \
      [::tclpdf::shaping message [::tclpdf::shaping needed "\u1820"]]] \
      [string match "*right-to-left*" \
      [::tclpdf::shaping message [::tclpdf::shaping needed "\u1820"]]]
} -result {{SyriacSup/ltr Syriac/shaping SyriacSup/rtl Syriac/shaping ArabicExtB/ltr Arabic/forms ArabicExtB/rtl Arabic/forms Mongolian/ltr Mongolian/shaping Mongolian/rtl Mongolian/shaping PhagsPa/ltr Phags-pa/shaping PhagsPa/rtl Phags-pa/shaping} 1 0}

test shaping-5.2 {an Arabic Extended-B mark is set like any other harakah} -body {
  # U+0898 is transparent in the joining table, and the cursive road used to
  # turn every transparent character into a mark finding. It no longer does:
  # a mark on the cursive road is placed by markPos.tcl, so this block goes
  # through with the rest of Arabic. What still turns a transparent character
  # into a finding is the ORDERING road, and only for the four scripts of
  # [reorderedMarks] - shaping-6.3 holds on to those.
  list [::tclpdf::shaping needed "\u0872\u0898" rtl 1] \
      [lindex [::tclpdf::shaping needed "\u0872\u0898" rtl] 4]
} -result {{} forms}

test shaping-5.3 {the cursive scripts of the supplementary planes are refused} -body {
  # Measured 2026-08-18: Adlam, Hanifi Rohingya, Sogdian and Manichaean
  # passed as if they needed nothing. Each is D or L or R in the joining
  # table and right-to-left; and Arabic Extended-C is Arabic. The characters
  # come from their UTF-8 bytes (see smp above), which Tcl 8.6 can hold
  # where its \U escape cannot.
  set found {}
  foreach {name char} [list Manichaean [smp 0x10AC0] PsalterPahlavi [smp 0x10B80] \
      HanifiRohingya [smp 0x10D00] ArabicExtC [smp 0x10EC2] Sogdian [smp 0x10F30] \
      OldUyghur [smp 0x10F70] Chorasmian [smp 0x10FB0] Adlam [smp 0x1E900]] {
    set finding [::tclpdf::shaping needed $char rtl]
    lappend found $name [expr {[llength $finding] ?
        "[lindex $finding 2]/[lindex $finding 4]" : "-"}]
  }
  set found
} -result {Manichaean Manichaean/shaping PsalterPahlavi {Psalter Pahlavi/shaping} HanifiRohingya {Hanifi Rohingya/shaping} ArabicExtC Arabic/forms Sogdian Sogdian/shaping OldUyghur {Old Uyghur/shaping} Chorasmian Chorasmian/shaping Adlam Adlam/shaping}

test shaping-5.4 {the byte order mark is not Arabic and not a mark} -body {
  # U+FEFF closes the Arabic Presentation Forms-B block and is none of it:
  # ZERO WIDTH NO-BREAK SPACE, BN. Taken with the block it was refused as
  # needing mark placement - in a Latin line too, which is where a file read
  # with its BOM left in puts it. U+FEFE, the last real presentation form,
  # is still caught.
  list [::tclpdf::shaping needed "\uFEFFabc"] \
      [::tclpdf::shaping needed "\u05D0\uFEFF" rtl] \
      [lrange [::tclpdf::shaping needed "\uFEFE"] 2 2]
} -result {{} {} Arabic}

test shaping-5.5 {a BOM in front of the text is dropped, not drawn and not refused} \
    -constraints haveLatin -body {
  # The same as U+200B in FontRun: nothing to draw, nothing to measure, and
  # no glyph asked of the face - DejaVu Sans has one at U+FEFF, and drawing
  # it would carry an empty glyph into the file. Two lines, with and without
  # the mark, and the same show operator for both.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed face $::latinFace
  $doc font -family face -size 12
  $doc text "\uFEFFBochum" -at {20 20}
  $doc text "Bochum" -at {20 30}
  set width [$doc textWidth "\uFEFFBochum"]
  set plain [$doc textWidth "Bochum"]
  set shows [::tclpdfTest::shows [::tclpdfTest::content $doc]]
  $doc page add
  set code [catch {$doc text "\u05D0\uFEFF\u05D1" -at {100 20} -direction rtl} message]
  set rtl [::tclpdfTest::drawnText $doc face [::tclpdfTest::content $doc]]
  $doc destroy
  list [expr {$width == $plain}] [expr {[lindex $shows 0] eq [lindex $shows 1]}] \
      $code $rtl
} -result [list 1 1 0 "\u05D1\u05D0"]

test shaping-6.1 {the non-cursive right-to-left scripts of the supplementary planes need the order, and only the order} -body {
  # Measured 2026-08-18: every one of these passed as needing nothing and was
  # set from the left in silence - the wrong-but-plausible line this module
  # exists to prevent, one plane up. They carry no contextual forms (the
  # joining table has no entry for any of them, Meroitic Cursive included,
  # which is cursive in name only), so -direction rtl is the whole answer:
  # refused without it, set with it.
  set faults {}
  foreach {name code} [list Cypriot 0x10800 ImperialAramaic 0x10840 \
      Palmyrene 0x10860 Nabataean 0x10880 Hatran 0x108E0 Phoenician 0x10900 \
      Lydian 0x10920 Sidetic 0x10940 MeroiticHieroglyphs 0x10980 \
      MeroiticCursive 0x109A0 Kharoshthi 0x10A10 OldSouthArabian 0x10A60 \
      OldNorthArabian 0x10A80 Avestan 0x10B00 InscriptionalParthian 0x10B40 \
      InscriptionalPahlavi 0x10B60 OldTurkic 0x10C00 OldHungarian 0x10C80 \
      Garay 0x10D50 Yezidi 0x10E80 OldSogdian 0x10F00 Elymaic 0x10FE0 \
      MendeKikakui 0x1E800 IndicSiyaq 0x1EC71 OttomanSiyaq 0x1ED01 \
      ArabicMath 0x1EE01] {
    set char [smp $code]
    set ltr [::tclpdf::shaping needed $char]
    set rtl [::tclpdf::shaping needed $char rtl]
    if {[lindex $ltr 4] ne "ordering" || $rtl ne {}} {
      lappend faults "$name: ltr <$ltr> rtl <$rtl>"
    }
  }
  list $faults [string match {*-direction rtl*} \
      [::tclpdf::shaping message [::tclpdf::shaping needed [smp 0x10900]]]]
} -result {{} 1}

test shaping-6.2 {every strong right-to-left character above the BMP is refused - read off the UCD, not off this list} -body {
  # The tripwire for the too-narrow direction, driven by the same file the
  # bidi table is generated from: every code point DerivedBidiClass.txt
  # lists as R or AL in the supplementary planes has to come back as a
  # finding under ltr. A block dropped from the list - which is exactly how
  # this defect existed, measured 2026-08-18 - turns this red with the
  # characters it lost.
  set root [file dirname [file dirname [file normalize [info script]]]]
  set file [open [file join $root tools ucd DerivedBidiClass.txt] r]
  set wrong {}
  while {[gets $file line] >= 0} {
    if {![regexp {^([0-9A-F]{4,6})(?:\.\.([0-9A-F]{4,6}))? *; (R|AL) } \
        $line - firstHex lastHex]} {
      continue
    }
    # scan for BOTH ends, never expr: to expr a hex string like 1E950 or
    # 06E6 is scientific notation, and the six-million-character "range" it
    # makes of a two-character Arabic line was measured before it was
    # believed.
    scan $firstHex %x first
    if {$lastHex eq {}} {
      set last $first
    } else {
      scan $lastHex %x last
    }
    if {$last < 0x10000} {
      continue
    }
    for {set code $first} {$code <= $last} {incr code} {
      if {[::tclpdf::shaping needed [smp $code]] eq {}} {
        lappend wrong [format U+%04X $code]
      }
    }
  }
  close $file
  lrange $wrong 0 4
} -result {}

test shaping-6.3 {their combining marks stay refused under rtl, found by joining type} -body {
  # The marks of these blocks are a scatter like the Arabic harakat -
  # Kharoshthi's vowel signs and virama, Garay's, Yezidi's, Mende Kikakui's
  # combining digits - so they are asked of the joining table rather than
  # cut out by hand, and -direction rtl must not quietly set them beside
  # their letters.
  set found {}
  foreach {name code} [list KharoshthiVowel 0x10A01 KharoshthiVirama 0x10A3F \
      GarayVowel 0x10D69 YezidiMark 0x10EAB MendeDigit 0x1E8D0] {
    lassign [::tclpdf::shaping needed [smp $code] rtl] - - system what kind
    lappend found $name "$what/$kind"
  }
  set found
} -result {KharoshthiVowel {mark reordering/shaping} KharoshthiVirama {mark reordering/shaping} GarayVowel {mark reordering/shaping} YezidiMark {mark reordering/shaping} MendeDigit {mark reordering/shaping}}

test shaping-6.4 {what sits beside them must not be caught} -body {
  # The tripwire for the too-wide direction. Old Italic and Gothic are
  # left-to-right scripts of the same plane; the Rumi numeral symbols are AN
  # digits, and a run of digits keeps its own order in either direction, so
  # a Rumi number set from the left is right as it stands - a list that took
  # the block would refuse text this package sets correctly. U+10960 is
  # unassigned, between the blocks, and belongs to no script.
  set faults {}
  foreach {name code} [list OldItalic 0x10300 Gothic 0x10330 \
      Rumi 0x10E60 unassigned 0x10960] {
    set finding [::tclpdf::shaping needed [smp $code]]
    if {$finding ne {}} {
      lappend faults "$name refused: $finding"
    }
  }
  set faults
} -result {}

test shaping-6.5 {the one such block a bundled face carries, refused and then set} -constraints haveLatin -body {
  # DejaVu Sans carries 73 of the Arabic mathematical letters - measured off
  # its cmap, and no face in the examples carries Phoenician or Kharoshthi -
  # so this is the block the document level can be shown on. Before the list
  # knew these blocks the word passed silently and pdftotext gave it back in
  # logical order, from the left (measured 2026-08-18). Now: refused without
  # the direction, and drawn REVERSED with it.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed dv $::latinFace
  set word "[smp 0x1EE01][smp 0x1EE02][smp 0x1EE03]"
  set refused [catch {$doc text $word -at {20 20} -family dv} message]
  set drawn [catch {$doc text $word -at {190 20} -family dv -direction rtl}]
  # The drawn order is read as GLYPH numbers, not through drawnText: that
  # helper renders a code point with [format %c], which under Tcl 8.6 turns
  # anything above the BMP into U+FFFD - measured, three replacement
  # characters where the three letters were.
  set cmap [dict get [$doc state fonts] dv parsed cmap]
  set glyphs {}
  foreach tokens [::tclpdfTest::shows [::tclpdfTest::content $doc]] {
    foreach token $tokens {
      if {[string index $token 0] ne "("} {
        continue
      }
      binary scan [subst -nocommands -novariables \
          [string range $token 1 end-1]] Su* ids
      lappend glyphs {*}$ids
    }
  }
  set reversed [lmap code {0x1EE03 0x1EE02 0x1EE01} {
    dict get $cmap [expr {$code}]
  }]
  $doc destroy
  list $refused [string match {*-direction rtl*} $message] $drawn \
      [expr {$glyphs eq $reversed}]
} -result {1 1 0 1}

# --- what mark attachment lifted, and what it did not ----------------------
#
# Every number below was measured against hb-shape of HarfBuzz 14.3.1 on
# 2026-08-21. The refusals in this section fell together on one day, so they
# are held together here: a later hand that widens the list again has to
# argue with these, and the counter-tests beside them say where the line is.

test shaping-7.1 {the marks that used to be cut out of their blocks are set} -body {
  # Three blocks were cut in three - bases, marks, bases - because their marks
  # needed a placement this package did not do. They are one line each again.
  #
  #   hb-shape DejaVuSans.ttf -u 05D0,05B7   [uni05B7=0@79,0+0|uni05D0=0+1369]
  #
  # Thaana and Samaritan have NO face here to measure that way - no font under
  # ~/src or ~/Downloads carries either script, measured 2026-08-21 - so what
  # is claimed for them is the mechanism, not a rendering: the same
  # markPos.tcl reads the same GPOS lookups whatever the script, and the
  # Hebrew, Arabic and Tibetan numbers are what say that it does.
  set found {}
  foreach {name text} [list \
      nikud "אַ" varika "וﬞ" thaana "ހަ" samaritan "ࠀࠖ"] {
    set finding [::tclpdf::shaping needed $text rtl]
    lappend found $name [expr {[llength $finding] ? "refused [lindex $finding 3]" : "set"}]
  }
  set found
} -result {nikud set varika set thaana set samaritan set}

test shaping-7.2 {and they are still refused without the direction} -body {
  # The bases always needed -direction rtl and still do. Dropping the mark
  # refusal must not have dropped the ordering one with it: a nikud in a
  # left-to-right line is a Hebrew character like any other.
  set found {}
  foreach {name text} [list nikud "אַ" thaana "ހަ" samaritan "ࠀࠖ"] {
    lassign [::tclpdf::shaping needed $text] - - system what kind
    lappend found $name "$system/$kind"
  }
  set found
} -result {nikud Hebrew/ordering thaana Thaana/ordering samaritan Samaritan/ordering}

test shaping-7.3 {a mark of a cursive block is no longer a finding} -body {
  # The Arabic harakat are found by Joining_Type rather than by range, and
  # that rule used to turn every one of them into a refusal. Now it applies
  # to the ordering road alone. Asked with forms 1, which is what font.tcl
  # passes once the face has said it can shape.
  set found {}
  foreach {name text} [list fatha "بَ" shadda "بّ" superAlef "بٰ" \
      hamzaAbove "بٔ" smallHigh "بۘ" extendedA "بࣤ" ] {
    set finding [::tclpdf::shaping needed $text rtl 1]
    lappend found $name [expr {[llength $finding] ? "refused" : "set"}]
  }
  set found
} -result {fatha set shadda set superAlef set hamzaAbove set smallHigh set extendedA set}

test shaping-7.4 {the four ordering scripts whose marks stay refused, and only those} -body {
  # The tripwire for the too-wide direction of THIS change. Kharoshthi feels
  # exactly like Arabic - a right-to-left script whose vowel signs are a
  # scatter of transparent characters - and it is not: nothing here reorders,
  # and no face on this machine carries the script to measure it on. So its
  # marks stay refused while the harakat pass, and the two must not drift
  # together by accident.
  set refused {}
  set set_ {}
  foreach {name code} [list Kharoshthi 0x10A01 Garay 0x10D69 Yezidi 0x10EAB \
      MendeKikakui 0x1E8D0] {
    lappend refused $name [expr {
        [::tclpdf::shaping needed [smp $code] rtl] ne {} ? "refused" : "SET"}]
  }
  # Their LETTERS are unaffected, and so is every other ordering block: the
  # refusal is on the mark, not on the script.
  foreach {name code} [list Kharoshthi 0x10A10 Garay 0x10D40 Yezidi 0x10E80 \
      MendeKikakui 0x1E800 Phoenician 0x10900 OldTurkic 0x10C00] {
    lappend set_ $name [expr {
        [::tclpdf::shaping needed [smp $code] rtl] eq {} ? "set" : "REFUSED"}]
  }
  list $refused $set_
} -result {{Kharoshthi refused Garay refused Yezidi refused MendeKikakui refused} {Kharoshthi set Garay set Yezidi set MendeKikakui set Phoenician set OldTurkic set}}

test shaping-8.1 {Tibetan: a single mark on a single letter would be right} \
    -constraints haveTibetan -body {
  # The half that DOES work, and the reason this refusal had to be measured
  # rather than reasoned about. 160 of 160 letter-and-mark pairs of Noto Serif
  # Tibetan agree with hb-shape to the font unit; the two below are the ones
  # the earlier measurement named.
  #
  #   hb-shape NotoSerifTibetan-Variable.ttf -u 0F56,0F7C
  #     -> [uni0F56=0+641|uni0F7C=0@-681,0+0]
  #   hb-shape NotoSerifTibetan-Variable.ttf -u 0F40,0F72
  #     -> [uni0F40=0+704|uni0F72=0@-614,0+0]
  package require tclpdf::sfnt
  package require tclpdf::markPos
  set parsed [::tclpdf::sfnt read $::tibetanFace]
  set state [::tclpdf::markPos build $parsed]
  set found {}
  foreach {base mark} {0x0F56 0x0F7C 0x0F40 0x0F72} {
    set glyphs [list [dict get [dict get $parsed cmap] [expr {$base}]] \
        [dict get [dict get $parsed cmap] [expr {$mark}]]]
    lappend found [lindex [::tclpdf::markPos offsets $state $glyphs] 1]
  }
  set found
} -result {{-681 0} {-614 0}}

test shaping-8.2 {Tibetan: the subjoined letters are a SUBSTITUTION, not a placement} \
    -constraints haveTibetan -body {
  # And that is why the refusal stays. HarfBuzz sets "skad" as TWO glyphs -
  # the sa and one precomposed stack for ka-plus-da - where the cmap plus mark
  # attachment gives three. No anchor can produce a glyph the cmap does not
  # lead to, so this is GSUB (abvs, blws) and out of reach.
  #
  #   hb-shape NotoSerifTibetan-Variable.ttf -u 0F66,0F90        -> [1088=0+909]
  #   hb-shape NotoSerifTibetan-Variable.ttf -u 0F66,0F90,0F51   -> [1088=0+909|22=0+717]
  package require tclpdf::sfnt
  set parsed [::tclpdf::sfnt read $::tibetanFace]
  set glyphs {}
  foreach code {0x0F66 0x0F90} {
    lappend glyphs [dict get [dict get $parsed cmap] [expr {$code}]]
  }
  # Two glyphs out of the cmap where HarfBuzz has one, and the one it has is
  # neither of them.
  list [llength $glyphs] [expr {1088 in $glyphs}]
} -result {2 0}

test shaping-8.3 {Tibetan: so every mark of the block stays in the list} -body {
  # Cut by hand rather than by Joining_Type, because Tibetan is not a joining
  # script and the table has nothing to say about it. The ranges are the
  # marks; the letters, the tsheg and the digits between them are not in the
  # list at all - shaping-1.3 and shaping-1.6 hold on to that from the other
  # side.
  set found {}
  foreach code {0x0F18 0x0F35 0x0F3E 0x0F71 0x0F72 0x0F7C 0x0F84 0x0F86 \
      0x0F90 0x0FB2 0x0FBC 0x0FC6} {
    lassign [::tclpdf::shaping needed [format %c $code]] - - system what kind
    lappend found [format %04X $code] $kind
  }
  set found
} -result {0F18 shaping 0F35 shaping 0F3E shaping 0F71 shaping 0F72 shaping 0F7C shaping 0F84 shaping 0F86 shaping 0F90 shaping 0FB2 shaping 0FBC shaping 0FC6 shaping}

test shaping-8.4 {Tibetan: and the message names the substitution, not the placement} \
    -constraints haveTibetan -body {
  # Naming the wrong obstacle sends the reader looking in the wrong place.
  # It used to say "mark placement", which is now done and would have them
  # hunting a bug that is not there.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font embed tib $::tibetanFace
  set code [catch {$doc text "བོད" -at {20 20} -family tib} message]
  $doc destroy
  list $code [string match {*stacked forms out of GSUB*} $message] \
      [string match {*mark placement*} $message] \
      [string match {*-unshaped 1*} $message]
} -result {1 1 0 1}

cleanupTests

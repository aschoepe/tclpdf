# timestamp.test --
#
# Document timestamps (ISO 32000-2, 12.8.5): the RFC 3161 request this module
# builds, the response it takes apart, and the /DocTimeStamp update it writes
# onto a finished file. The authority is a LOCAL one - openssl ts -reply with
# a throwaway certificate - so this file needs no network, ever; the -tsa
# command prefix exists for exactly this kind of caller-owned transport, and
# testing through it tests the road a corporate authority would use.
#
# Counter-proofs sit beside every check that could stay green on its own:
# a flipped byte in the file, a patched digest, a patched nonce, a refusal
# status - each has to be caught by name.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*
package require tclpdf
package require tclpdf::timestamp
source [file join [file dirname [info script]] helper.tcl]

testConstraint openssl [expr {[auto_execok openssl] ne {}}]

# The throwaway authority: a self-signed certificate whose one extended key
# usage is timeStamping, and the config [openssl ts -reply] wants. Probed
# once - an openssl without the ts application skips the lot rather than
# failing it.
set ::tclpdfTest::tsaDir [file join [::tcltest::temporaryDirectory] tsa]
proc ::tclpdfTest::tsaSetup {} {
  variable tsaDir
  file mkdir $tsaDir
  set log [file join $tsaDir openssl.log]
  exec openssl req -x509 -newkey rsa:2048 \
      -keyout [file join $tsaDir tsa.key] -out [file join $tsaDir tsa.pem] \
      -days 30 -nodes -subj "/C=DE/O=tclpdf test/CN=test TSA" \
      -addext "extendedKeyUsage=critical,timeStamping" 2> $log
  set fh [open [file join $tsaDir tsa.cnf] w]
  puts $fh "\[tsa\]\ndefault_tsa = tsa_config\n\[tsa_config\]"
  puts $fh "serial = [file join $tsaDir serial]"
  puts $fh "signer_cert = [file join $tsaDir tsa.pem]"
  puts $fh "signer_key = [file join $tsaDir tsa.key]"
  puts $fh "default_policy = 1.2.3.4.1"
  puts $fh "digests = sha256, sha384, sha512"
  puts $fh "accuracy = secs:1\nordering = no\ntsa_name = no"
  puts $fh "ess_cert_id_chain = no\nsigner_digest = sha256"
  close $fh
  set fh [open [file join $tsaDir serial] w]
  puts $fh 01
  close $fh
  tsaWith [::tclpdf::sign::TsQuery [string repeat \x11 32] \
      2.16.840.1.101.3.4.2.1 {} \x42]
  return
}
# The transport under test: bytes in, bytes out, via the local authority.
proc ::tclpdfTest::tsaWith {tsq} {
  variable tsaDir
  set in [file join $tsaDir query.tsq]
  set out [file join $tsaDir reply.tsr]
  set fh [open $in wb]
  puts -nonewline $fh $tsq
  close $fh
  exec openssl ts -reply -config [file join $tsaDir tsa.cnf] \
      -queryfile $in -out $out 2> [file join $tsaDir openssl.log]
  return [readBytes $out]
}
# A signer out of the same throwaway certificate, for the one test that
# stamps a SIGNED file. openssl checks key usage at verification, not at
# signing, so the timeStamping certificate signs a CMS object without a
# word - which is all 3.7 needs: a completed signature, not a trusted one.
proc ::tclpdfTest::tsaSign {bytes} {
  variable tsaDir
  set in [file join $tsaDir sign-content.bin]
  set fh [open $in wb]
  puts -nonewline $fh $bytes
  close $fh
  exec openssl cms -sign -binary -in $in \
      -signer [file join $tsaDir tsa.pem] -inkey [file join $tsaDir tsa.key] \
      -md sha256 -outform DER -out [file join $tsaDir sign-cms.der] \
      2> [file join $tsaDir openssl.log]
  return [readBytes [file join $tsaDir sign-cms.der]]
}

testConstraint timestampTsa \
    [expr {[testConstraint openssl] && ![catch ::tclpdfTest::tsaSetup]}]

# A small finished file to stamp, fresh for each test that writes.
proc ::tclpdfTest::stampFile {name} {
  set path [file join [::tcltest::temporaryDirectory] $name]
  set doc [tclpdf new -format a4]
  $doc page add
  $doc font -family helvetica -size 11
  $doc text "evidence" -at {20 25}
  $doc write $path
  $doc destroy
  return $path
}

# --- the DER the request is made of -----------------------------------------

test timestamp-1.1 {the sha256 OID encodes to its known bytes} -body {
  binary scan [::tclpdf::sign::DerOid 2.16.840.1.101.3.4.2.1] H* hex
  set hex
} -result 0609608648016503040201

test timestamp-1.2 {an integer with the top bit set gains a leading zero} -body {
  binary scan [::tclpdf::sign::DerInteger \x80] H* hex
  set hex
} -result 02020080

test timestamp-1.3 {the long length forms of DER are written where needed} -body {
  list [binary scan [::tclpdf::sign::DerTag 0x04 [string repeat x 130]] H6 a] $a \
      [binary scan [::tclpdf::sign::DerTag 0x04 [string repeat x 300]] H8 b] $b
} -result {1 048182 1 0482012c}

test timestamp-1.4 {openssl parses the request this module builds} -constraints openssl -body {
  set tsq [::tclpdf::sign::TsQuery [string repeat \xab 32] \
      2.16.840.1.101.3.4.2.1 {} \x07\x07]
  set path [file join [::tcltest::temporaryDirectory] probe.tsq]
  set fh [open $path wb]
  puts -nonewline $fh $tsq
  close $fh
  set text [exec openssl ts -query -in $path -text 2>@1]
  list [regexp {Version: 1} $text] [regexp {sha256} $text] \
      [regexp -nocase {certificate required: yes} $text] \
      [regexp {0707} $text]
} -result {1 1 1 1}

# --- the response, taken apart ----------------------------------------------

test timestamp-2.1 {a granted reply yields a token whose imprint and nonce verify} -constraints timestampTsa -body {
  set digest [string repeat \x3c 32]
  set nonce \x1f\x2e\x3d
  set tsq [::tclpdf::sign::TsQuery $digest 2.16.840.1.101.3.4.2.1 {} $nonce]
  set token [::tclpdf::sign::TsAnswer [::tclpdfTest::tsaWith $tsq] test]
  lassign [::tclpdf::sign::TstVerified \
      [::tclpdf::sign::TstInfo $token test] \
      $digest 2.16.840.1.101.3.4.2.1 $nonce test] serial time
  list [expr {[string length $serial] > 0}] \
      [regexp {^20\d{12}Z$} $time]
} -result {1 1}

test timestamp-2.2 {a refusal status is carried out by number} -body {
  # A hand-built TimeStampResp: PKIStatusInfo{status 2}, no token.
  catch {::tclpdf::sign::TsAnswer \x30\x05\x30\x03\x02\x01\x02 test} msg opts
  list [dict get $opts -errorcode] [regexp {PKIStatus 2} $msg]
} -result {{TCLPDF TIMESTAMP STATUS 2} 1}

test timestamp-2.3 {a patched digest in the reply is refused as IMPRINT} -constraints timestampTsa -body {
  set digest [string repeat \x3c 32]
  set tsq [::tclpdf::sign::TsQuery $digest 2.16.840.1.101.3.4.2.1 {} \x05]
  set reply [::tclpdfTest::tsaWith $tsq]
  # The digest bytes appear once, inside TSTInfo - flip the first of them.
  set at [string first $digest $reply]
  set reply [string replace $reply $at $at \x3d]
  set token [::tclpdf::sign::TsAnswer $reply test]
  catch {::tclpdf::sign::TstVerified \
      [::tclpdf::sign::TstInfo $token test] \
      $digest 2.16.840.1.101.3.4.2.1 \x05 test} msg opts
  lrange [dict get $opts -errorcode] 0 2
} -result {TCLPDF TIMESTAMP IMPRINT}

test timestamp-2.4 {a patched nonce in the reply is refused as NONCE} -constraints timestampTsa -body {
  set digest [string repeat \x3c 32]
  set nonce \x6a\x6b\x6c\x6d
  set tsq [::tclpdf::sign::TsQuery $digest 2.16.840.1.101.3.4.2.1 {} $nonce]
  set reply [::tclpdfTest::tsaWith $tsq]
  set at [string first $nonce $reply]
  set reply [string replace $reply $at $at \x7a]
  set token [::tclpdf::sign::TsAnswer $reply test]
  catch {::tclpdf::sign::TstVerified \
      [::tclpdf::sign::TstInfo $token test] \
      $digest 2.16.840.1.101.3.4.2.1 $nonce test} msg opts
  lrange [dict get $opts -errorcode] 0 2
} -result {TCLPDF TIMESTAMP NONCE}

# --- the file ---------------------------------------------------------------

test timestamp-3.1 {an unsigned file gains a /DocTimeStamp that openssl verifies} -constraints timestampTsa -body {
  set path [::tclpdfTest::stampFile stamped.pdf]
  set r [::tclpdf::sign timestamp $path -tsa ::tclpdfTest::tsaWith]
  set data [::tclpdfTest::readBytes $path]
  regexp {/ByteRange \[(\d+) (\d+) (\d+) (\d+)\s*\]} $data -> a b c e
  set ranged [string range $data $a [expr {$a + $b - 1}]]
  append ranged [string range $data $c [expr {$c + $e - 1}]]
  set rangedFile [file join [::tcltest::temporaryDirectory] ranged.bin]
  set fh [open $rangedFile wb]
  puts -nonewline $fh $ranged
  close $fh
  regexp {/Contents <([0-9a-f]+)} $data -> hex
  set token [binary decode hex [string trimright $hex 0]]
  # DER states its own length; the padding zeros behind it are the room.
  set tokenFile [file join [::tcltest::temporaryDirectory] token.der]
  set fh [open $tokenFile wb]
  puts -nonewline $fh $token
  close $fh
  set digest [exec openssl dgst -sha256 -r $rangedFile]
  set verified [exec openssl ts -verify \
      -digest [lindex [split $digest] 0] -sha256 \
      -in $tokenFile -token_in \
      -CAfile [file join $::tclpdfTest::tsaDir tsa.pem] 2>@1]
  list [dict get $r field] \
      [regexp {/Type /DocTimeStamp} $data] \
      [regexp {/SubFilter /ETSI.RFC3161} $data] \
      [regexp {Verification: OK} $verified] \
      [expr {[dict get $r length] > 0}]
} -result {Timestamp1 1 1 1 1}

test timestamp-3.2 {one flipped byte inside the range and the token no longer verifies} -constraints timestampTsa -body {
  set rangedFile [file join [::tcltest::temporaryDirectory] ranged.bin]
  set tokenFile [file join [::tcltest::temporaryDirectory] token.der]
  set bytes [::tclpdfTest::readBytes $rangedFile]
  set bad [file join [::tcltest::temporaryDirectory] ranged-bad.bin]
  set fh [open $bad wb]
  puts -nonewline $fh [string replace $bytes 100 100 \x00]
  close $fh
  set digest [exec openssl dgst -sha256 -r $bad]
  catch {exec openssl ts -verify -digest [lindex [split $digest] 0] -sha256 \
      -in $tokenFile -token_in \
      -CAfile [file join $::tclpdfTest::tsaDir tsa.pem]} out
  regexp {Verification: FAILED|message imprint mismatch} $out
} -result 1

test timestamp-3.3 {a second timestamp lands beside the first, and the first still verifies} -constraints timestampTsa -body {
  set path [file join [::tcltest::temporaryDirectory] stamped.pdf]
  set r [::tclpdf::sign timestamp $path -tsa ::tclpdfTest::tsaWith]
  set data [::tclpdfTest::readBytes $path]
  list [dict get $r field] [regexp -all {/Type /DocTimeStamp} $data] \
      [regexp -all {/ByteRange \[0 } $data]
} -result {Timestamp2 2 2}

test timestamp-3.4 {a token that does not fit is refused and the file stays as it was} -constraints timestampTsa -body {
  set path [::tclpdfTest::stampFile small.pdf]
  set before [::tclpdfTest::readBytes $path]
  catch {::tclpdf::sign timestamp $path -tsa ::tclpdfTest::tsaWith \
      -size 200} msg opts
  list [lrange [dict get $opts -errorcode] 0 2] \
      [string equal $before [::tclpdfTest::readBytes $path]]
} -result {{TCLPDF TIMESTAMP SIZE} 1}

test timestamp-3.5 {an unknown hash is refused by name} -body {
  catch {::tclpdf::sign timestamp nowhere.pdf -hash md5} msg opts
  dict get $opts -errorcode
} -result {TCLPDF TIMESTAMP HASH md5}

test timestamp-3.6 {a file with a signature still waiting is refused} -constraints timestampTsa -body {
  set path [file join [::tcltest::temporaryDirectory] waiting.pdf]
  set doc [tclpdf new -format a4]
  $doc page add
  $doc font -family helvetica -size 11
  $doc text "unsigned yet" -at {20 25}
  $doc sign
  $doc write $path
  $doc destroy
  catch {::tclpdf::sign timestamp $path -tsa ::tclpdfTest::tsaWith} msg opts
  lrange [dict get $opts -errorcode] 0 1
} -result {TCLPDF SIGN}

test timestamp-3.7 {a signed file gains a timestamp, and the signature survives untouched} -constraints timestampTsa -body {
  set path [file join [::tcltest::temporaryDirectory] signed-stamped.pdf]
  set doc [tclpdf new -format a4]
  $doc page add
  $doc font -family helvetica -size 11
  $doc text "signed, then stamped" -at {20 25}
  $doc sign -signer ::tclpdfTest::tsaSign -size 8192
  $doc write $path
  $doc destroy
  set before [::tclpdfTest::readBytes $path]
  set r [::tclpdf::sign timestamp $path -tsa ::tclpdfTest::tsaWith]
  set data [::tclpdfTest::readBytes $path]
  # The update appends and nothing else: every byte the signature's range
  # covers is exactly where it was, so the signature verdict cannot change.
  list [dict get $r field] [regexp -all {/ByteRange \[} $data] \
      [regexp {/Type /DocTimeStamp} $data] \
      [string equal $before \
          [string range $data 0 [expr {[string length $before] - 1}]]]
} -result {Timestamp1 2 1 1}

# --- tidy up ----------------------------------------------------------------

file delete -force $::tclpdfTest::tsaDir
foreach leftover {ranged.bin token.der ranged-bad.bin waiting.pdf
    probe.tsq stamped.pdf small.pdf signed-stamped.pdf} {
  file delete [file join [::tcltest::temporaryDirectory] $leftover]
}
::tcltest::cleanupTests

# graphics.test --
#
# The graphics state and the shapes that set it.
#
# Every test here is a regression against ONE defect: colour, line width, dash,
# caps, joins and alpha are graphics state (8.4.1), so they survive the
# painting operator. A shape that set them therefore changed everything drawn
# afterwards - "rect -width 3 -dash {2 2}" made the NEXT line thick and dashed,
# with nothing in that call to explain it. Found by reading the content stream,
# not by any validator: the file is valid either way.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::shape
package require tclpdf::graphics
source [file join [file dirname [info script]] helper.tcl]

# The operators of a content stream, in order, operands dropped.
#
# Every token, not just the last one per line: a line may carry two of them
# ("x y m x y l"), and taking only the last silently loses the "m" - which is
# how the first version of this file reported a test as passing that was
# looking for something it could never find.
proc ::tclpdfTest::operators {stream} {
  set result {}
  foreach token [regexp -all -inline {\S+} $stream] {
    # Operands are numbers or the bracketed dash array; everything else that
    # is short and alphabetic is an operator.
    if {[string is double -strict $token] || [string match {\[*} $token]
        || [string match {*\]} $token]} {
      continue
    }
    lappend result $token
  }
  return $result
}

# Is the state set by the first shape taken back BEFORE the second one starts?
#
# Counting the operator is not enough and was the first, worthless version of
# this test: without the guard the rectangle still writes exactly one "w" and
# the line still writes none, so the count is 1 either way while the line comes
# out three millimetres thick. What tells the two apart is the "Q" BETWEEN
# them - that is what has to be measured.
proc ::tclpdfTest::takenBack {operators operator start} {
  set set [lsearch $operators $operator]
  if {$set < 0} {
    return 0
  }
  set restored [lsearch -start $set $operators Q]
  if {$restored < 0} {
    return 0
  }
  return [expr {[lsearch -start $restored $operators $start] > $restored}]
}

test graphics-guard-1.1 {a shape does not leak its line width} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -stroke black -width 3
  $doc line -from {10 50} -to {60 50} -stroke black
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # "w" set, then "Q", and only then the "m" that starts the line.
  ::tclpdfTest::takenBack $operators w m
} -result 1

test graphics-guard-1.2 {q and Q come in pairs around a styled shape} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red -width 2 -dash {2 2}
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list [llength [lsearch -all $operators q]] [llength [lsearch -all $operators Q]]
} -result {1 1}

test graphics-guard-1.3 {the dash pattern does not outlive the shape} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -stroke black -dash {2 2}
  $doc rect -at {40 10} -size {20 20} -stroke black
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # "d" set, then "Q", and only then the "re" of the second rectangle.
  ::tclpdfTest::takenBack $operators d re
} -result 1

test graphics-guard-1.4 {alpha is set inside the guard, not before it} -body {
  # [opacity] used to write its "gs" straight to the content stream while the
  # rest of the style was still being assembled - so it landed BEFORE the "q"
  # and stayed in force for the whole page.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red -opacity 0.5
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # The "gs" must come after the "q" that opens the guard.
  expr {[lsearch $operators gs] > [lsearch $operators q]}
} -result 1

test graphics-guard-1.5 {style sets the state ON PURPOSE and is not guarded} -body {
  # The counterpart to the tests above: [style] promises to stay in force
  # until changed, so wrapping it would break what the manual documents.
  set doc [tclpdf new]
  $doc page add
  $doc style -width 2 -fill red
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list [llength [lsearch -all $operators q]] [llength [lsearch -all $operators w]]
} -result {0 1}

test graphics-guard-1.6 {an unstyled shape costs no q/Q} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20}
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  llength [lsearch -all $operators q]
} -result 0

test graphics-opacity-2.1 {opacity outside 0..1 is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach value {-0.5 1.5 abc} {
    lappend codes [catch {$doc opacity $value}]
  }
  $doc destroy
  set codes
} -result {1 1 1}

test graphics-opacity-2.2 {the same alpha is one resource, reused} -body {
  set doc [tclpdf new]
  $doc page add
  $doc opacity 0.5
  $doc opacity 0.5
  set names [dict keys [$doc resource ExtGState]]
  $doc destroy
  llength $names
} -result 1

test graphics-path-3.1 {the documented path call form works} -body {
  # [path] was never called by any test or example, which is why the manual
  # could describe it with a positional argument and "-evenOdd 1" for four
  # releases without anybody noticing. It takes -segments and -rule.
  set doc [tclpdf new]
  $doc page add
  $doc path -segments {{move 10 10} {line 50 10} {curve 55 15 55 35 50 40} {close}} \
      -fill red -stroke black -rule evenodd
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # move, line, curve, close and the even-odd fill-and-stroke operator.
  list [lsearch -exact $operators m] [lsearch -exact $operators l] \
      [lsearch -exact $operators c] [lsearch -exact $operators h] \
      [expr {"B*" in $operators}]
} -match glob -result {[0-9]* [0-9]* [0-9]* [0-9]* 1}

test graphics-path-3.2 {an unknown segment is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc path -segments {{wobble 1 2}} -stroke black} message]
  $doc destroy
  list $code [string match {*unknown path segment*} $message]
} -result {1 1}

test graphics-path-3.2b {a path without segments is refused} -body {
  # Without the check this wrote a painting operator with nothing in front of
  # it - valid, invisible, and nothing anywhere to explain the missing shape.
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc path -segments {} -fill red} message]
  $doc destroy
  list $code [string match {*empty*} $message]
} -result {1 1}

test graphics-clip-3.3 {clip takes a rectangle} -body {
  set doc [tclpdf new]
  $doc page add
  $doc save
  $doc clip -at {10 10} -size {50 50}
  $doc restore
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # re, then W, then n - the path becomes the mask and is NOT drawn.
  list [expr {"re" in $operators}] [expr {"W" in $operators}] \
      [expr {[lsearch $operators n] > [lsearch $operators W]}]
} -result {1 1 1}

test graphics-clip-3.4 {clip takes an arbitrary path} -body {
  set doc [tclpdf new]
  $doc page add
  $doc save
  $doc clip -segments {{move 20 20} {line 70 20} {line 45 60} {close}}
  $doc rect -at {0 0} -size {200 200} -fill red
  $doc restore
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # The construction operators of the triangle, then W n - and no painting
  # operator between the path and the W, or the outline would be visible.
  set clip [lrange $operators 0 [lsearch $operators W]]
  list [expr {"m" in $clip}] [expr {"l" in $clip}] [expr {"h" in $clip}] \
      [expr {"f" in $clip || "S" in $clip || "B" in $clip}]
} -result {1 1 1 0}

test graphics-clip-3.5 {even-odd leaves the hole in a ring open} -body {
  set doc [tclpdf new]
  $doc page add
  $doc clip -rule evenodd -segments {
    {move 10 10} {line 60 10} {line 60 60} {line 10 60} {close}
    {move 25 25} {line 45 25} {line 45 45} {line 25 45} {close}
  }
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  expr {"W*" in $operators}
} -result 1

test graphics-clip-3.6 {an unclosed clip path is closed for the caller} -body {
  # An open path clips as if the last point were joined to the first anyway
  # (8.5.4). Writing the "h" keeps file and reader in agreement - but not
  # twice, which a caller ending in {close} would otherwise get.
  set doc [tclpdf new]
  $doc page add
  $doc clip -segments {{move 10 10} {line 60 10} {line 60 60}}
  set open [llength [lsearch -all [::tclpdfTest::operators \
      [::tclpdfTest::content $doc]] h]]
  $doc destroy
  set doc [tclpdf new]
  $doc page add
  $doc clip -segments {{move 10 10} {line 60 10} {line 60 60} {close}}
  set closed [llength [lsearch -all [::tclpdfTest::operators \
      [::tclpdfTest::content $doc]] h]]
  $doc destroy
  list $open $closed
} -result {1 1}

test graphics-clip-3.7 {the two forms are not mixed and not omitted} -body {
  set doc [tclpdf new]
  $doc page add
  set codes [list \
      [catch {$doc clip -at {10 10} -size {20 20} -segments {{move 1 1}}}] \
      [catch {$doc clip}] \
      [catch {$doc clip -at {10 10}}] \
      [catch {$doc clip -segments {}}] \
      [catch {$doc clip -segments {{wobble 1 2}}}]]
  $doc destroy
  set codes
} -result {1 1 1 1 1}

test graphics-stroke-5.1 {caps and joins reach the content stream} -body {
  # Both are documented and neither was ever called by a test: the manual could
  # have named any word at all for four releases without anybody noticing.
  set doc [tclpdf new]
  $doc page add
  $doc line -from {10 10} -to {60 10} -stroke black -width 3 \
      -cap round -join bevel
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # butt/round/square are 0/1/2 J, miter/round/bevel are 0/1/2 j (8.4.3.3).
  list [string match {*1 J*} $stream] [string match {*2 j*} $stream]
} -result {1 1}

test graphics-stroke-5.2 {every documented cap and join has a number} -body {
  set doc [tclpdf new]
  $doc page add
  set caps {}
  foreach {name expected} {butt 0 round 1 square 2} {
    $doc page add
    $doc line -from {10 10} -to {60 10} -stroke black -cap $name
    lappend caps [string match "*$expected J*" [::tclpdfTest::content $doc]]
  }
  set joins {}
  foreach {name expected} {miter 0 round 1 bevel 2} {
    $doc page add
    $doc line -from {10 10} -to {60 10} -stroke black -join $name
    lappend joins [string match "*$expected j*" [::tclpdfTest::content $doc]]
  }
  $doc destroy
  list $caps $joins
} -result {{1 1 1} {1 1 1}}

test graphics-stroke-5.3 {an invented cap or join is refused, not written} -body {
  set doc [tclpdf new]
  $doc page add
  set codes [list [catch {$doc line -from {1 1} -to {2 2} -cap flat} capMessage] \
      [catch {$doc line -from {1 1} -to {2 2} -join sharp} joinMessage]]
  $doc destroy
  list $codes [string match {*butt, round or square*} $capMessage] \
      [string match {*miter, round or bevel*} $joinMessage]
} -result {{1 1} 1 1}

test graphics-ellipse-6.1 {an ellipse is four Bezier arcs, not a rectangle} -body {
  set doc [tclpdf new]
  $doc page add
  $doc ellipse -at {50 50} -radius 10 -stroke black
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  # One move, four curves, and no "re" anywhere.
  list [llength [lsearch -all $operators m]] \
      [llength [lsearch -all $operators c]] [expr {"re" in $operators}]
} -result {1 4 0}

test graphics-ellipse-6.2 {-size spans the given width and height} -body {
  # -at is the CENTRE here, unlike rect. The extreme points of the outline
  # therefore have to sit half a size away in each direction - which is the
  # part a caller gets wrong first, and no operator count would show it.
  set doc [tclpdf new]
  $doc page add
  $doc ellipse -at {50 50} -size {20 10} -stroke black
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set xs {}
  set ys {}
  # Only the path lines: the style header in front of them carries "0 0 0 RG",
  # three numbers, and taking those along shifts every pair after it.
  foreach line [split $stream \n] {
    if {![regexp {[mc]$} $line]} {
      continue
    }
    foreach {x y} [regexp -all -inline -- {-?[0-9]+\.?[0-9]*} $line] {
      lappend xs $x
      lappend ys $y
    }
  }
  # 20 mm wide, 10 mm tall, in points.
  list [format %.2f [expr {[tcl::mathfunc::max {*}$xs] - [tcl::mathfunc::min {*}$xs]}]] \
      [format %.2f [expr {[tcl::mathfunc::max {*}$ys] - [tcl::mathfunc::min {*}$ys]}]]
} -result {56.69 28.35}

test graphics-ellipse-6.3 {circle is the same call with one radius} -body {
  set doc [tclpdf new]
  $doc page add
  $doc circle -at {50 50} -radius 10 -stroke black
  set circle [::tclpdfTest::content $doc]
  $doc page add
  $doc ellipse -at {50 50} -radius 10 -stroke black
  set ellipse [::tclpdfTest::content $doc]
  $doc destroy
  expr {$circle eq $ellipse}
} -result 1

test graphics-ellipse-6.4 {an ellipse without a size or a centre is refused} -body {
  set doc [tclpdf new]
  $doc page add
  set codes [list [catch {$doc ellipse -radius 10}] \
      [catch {$doc ellipse -at {10 10}}]]
  $doc destroy
  set codes
} -result {1 1}

test graphics-polygon-7.1 {a polygon closes itself unless told otherwise} -body {
  # The default is -close 1, which is why an open one has to be asked for. A
  # filled polygon looks the same either way - the difference is the outline.
  set doc [tclpdf new]
  $doc page add
  $doc polygon -points {10 10 60 10 35 50} -stroke black
  set closed [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc page add
  $doc polygon -points {10 10 60 10 35 50} -stroke black -close 0
  set open [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list [expr {"h" in $closed}] [expr {"h" in $open}] \
      [llength [lsearch -all $open l]]
} -result {1 0 2}

test graphics-polygon-7.2 {two points are the minimum} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc polygon -points {10 10} -stroke black} message]
  $doc destroy
  list $code [string match {*at least two points*} $message]
} -result {1 1}

test graphics-curve-8.1 {a curve is one move and one cubic} -body {
  set doc [tclpdf new]
  $doc page add
  $doc curve -from {10 10} -c1 {20 40} -c2 {50 40} -to {60 10} -stroke black
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list [llength [lsearch -all $operators m]] [llength [lsearch -all $operators c]] \
      [expr {"h" in $operators}]
} -result {1 1 0}

test graphics-curve-8.2 {-close turns the curve into a shape that can be filled} -body {
  set doc [tclpdf new]
  $doc page add
  $doc curve -from {10 10} -c1 {20 40} -c2 {50 40} -to {60 10} \
      -fill red -close 1
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  expr {"h" in $operators}
} -result 1

test graphics-curve-8.3 {all four points are required} -body {
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc curve -from {10 10} -to {60 10} -stroke black} message]
  $doc destroy
  list $code [string match {*-from, -c1, -c2 and -to*} $message]
} -result {1 1}

test graphics-blend-9.1 {a blend mode becomes an ExtGState and a gs} -body {
  set doc [tclpdf new]
  $doc page add
  $doc blend Multiply
  set content [::tclpdfTest::content $doc]
  set names [dict keys [$doc resource ExtGState]]
  set writer [$doc writer]
  set found 0
  for {set number 1} {$number <= [$writer count]} {incr number} {
    if {[string match {*/BM /Multiply*} [$writer body $number]]} {
      set found 1
    }
  }
  $doc destroy
  list [regexp {gs} $content] $found [llength $names]
} -result {1 1 1}

test graphics-blend-9.2 {the spelling of the standard wins} -body {
  # A name is a name: /multiply is not /Multiply to a reader, so what the
  # caller types is normalised rather than passed through.
  set doc [tclpdf new]
  $doc page add
  set first [$doc blend multiply]
  set second [$doc blend MULTIPLY]
  set names [dict keys [$doc resource ExtGState]]
  $doc destroy
  list $first $second [llength $names]
} -result {GBMultiply GBMultiply 1}

test graphics-blend-9.3 {two shapes with the same mode share one resource} -body {
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red -blend Screen
  $doc rect -at {40 10} -size {20 20} -fill blue -blend Screen
  $doc circle -at {80 20} -radius 10 -fill green -blend Darken
  set names [lsort [dict keys [$doc resource ExtGState]]]
  $doc destroy
  set names
} -result {GBDarken GBScreen}

test graphics-blend-9.4 {-blend does not outlive its shape} -body {
  # The same rule as every other state option: a mode set for one shape must
  # not colour everything drawn afterwards.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red -blend Multiply
  $doc line -from {10 50} -to {60 50} -stroke black
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  ::tclpdfTest::takenBack $operators gs m
} -result 1

test graphics-blend-9.4b {-blend alone is guarded too} -body {
  # Without this the mode would be the one state option that leaks: every
  # other test sets -fill as well, which raises the guard for its own sake and
  # hides the omission.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -blend Multiply
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list [llength [lsearch -all $operators q]] [llength [lsearch -all $operators Q]]
} -result {1 1}

test graphics-blend-9.5 {mode and alpha are two operators, not two resources} -body {
  # gs is cumulative (11.6.6): setting the mode leaves the alpha standing. So
  # each of them stays one resource instead of one per combination.
  set doc [tclpdf new]
  $doc page add
  $doc rect -at {10 10} -size {20 20} -fill red -blend Multiply -opacity 0.5
  set content [::tclpdfTest::content $doc]
  set names [lsort [dict keys [$doc resource ExtGState]]]
  $doc destroy
  list [regexp -all {gs} $content] $names
} -result {2 {GBMultiply GS0_5b}}

test graphics-blend-9.6 {Compatible is refused, and says what to write instead} -body {
  # Deprecated since 1.4 and identical to Normal - accepting it would write a
  # name that tells a reader nothing.
  set doc [tclpdf new]
  $doc page add
  set codes [list [catch {$doc blend Compatible} compatible] \
      [catch {$doc blend Wobble} unknown]]
  $doc destroy
  list $codes [string match {*deprecated*Normal*} $compatible] \
      [string match {*known are: Normal, Multiply*} $unknown]
} -result {{1 1} 1 1}

test graphics-pattern-4.1 {pattern size reports the tile} -body {
  # The other half of a facade that nothing called: [pattern create] is used
  # everywhere, [pattern size] by nothing.
  set doc [tclpdf new]
  $doc page add
  $doc pattern create tile -size {10 5} -script {}
  set size [$doc pattern size tile]
  set names [$doc pattern names]
  $doc destroy
  # In the DOCUMENT unit, the same one the size was given in - not in points.
  list [lmap value $size {format %.0f $value}] $names
} -result {{10 5} tile}

# The pattern dictionaries of a document, straight from the writer's buffer -
# one body per PatternType 1 object, so a test can look at /Matrix (or its
# absence) without writing and re-reading a file.
proc ::tclpdfTest::patternBodies {doc} {
  set writer [$doc writer]
  set bodies {}
  for {set number 1} {$number <= [$writer count]} {incr number} {
    set body [$writer body $number]
    if {[string match {*/PatternType 1*} $body]} {
      lappend bodies $body
    }
  }
  return $bodies
}

# The six numbers of the /Matrix in a pattern body, or the empty string.
proc ::tclpdfTest::patternMatrix {body} {
  if {[regexp {/Matrix \[([^\]]*)\]} $body -> numbers]} {
    return $numbers
  }
  return {}
}

# -- the pattern matrix (8.7.3.1, Table 75) ---------------------------------
#
# Pattern space hangs off the DEFAULT space of the page. Without a /Matrix the
# tiles start at the page's bottom left corner, and a shape anywhere else gets
# them cut at whatever phase falls on its edge; a hatch could be turned only
# inside the tile script. -matrix writes the six numbers as they stand,
# -origin anchors the grid at a document point.

test graphics-pattern-4.2 {no option, no /Matrix - the object is what it was} -body {
  set doc [tclpdf new]
  $doc page add
  $doc pattern create tile -size {4 4} -script {}
  set bodies [::tclpdfTest::patternBodies $doc]
  $doc destroy
  list [llength $bodies] [string match {*/Matrix*} [lindex $bodies 0]]
} -result {1 0}

test graphics-pattern-4.3 {-matrix is written as the six numbers given} -body {
  set doc [tclpdf new]
  $doc page add
  $doc pattern create turned -size {4 4} -matrix {0.7071 0.7071 -0.7071 0.7071 0 0} \
      -script {}
  set bodies [::tclpdfTest::patternBodies $doc]
  $doc destroy
  ::tclpdfTest::patternMatrix [lindex $bodies 0]
} -result {0.7071 0.7071 -0.7071 0.7071 0 0}

test graphics-pattern-4.4 {-origin becomes a translation to the document point} -body {
  # A4, mm: {30 50} is 30 mm from the left and 50 mm from the top, so
  # x = 30 * 72/25.4 and y = 841.89 - 50 * 72/25.4 - the same mirroring
  # [coords] does for -at.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc pattern create anchored -size {4 4} -origin {30 50} -script {}
  set bodies [::tclpdfTest::patternBodies $doc]
  $doc destroy
  lassign [::tclpdfTest::patternMatrix [lindex $bodies 0]] a b c d e f
  list $a $b $c $d [format %.2f $e] [format %.2f $f] \
      [format %.2f [expr {30 * 72 / 25.4}]] \
      [format %.2f [expr {841.89 - 50 * 72 / 25.4}]]
} -result {1 0 0 1 85.04 700.16 85.04 700.16}

test graphics-pattern-4.5 {a wrong matrix is refused before anything is written} -body {
  # Five numbers, a letter, a singular matrix (a*d - b*c = 0: the tiles
  # collapse onto a line and a reader paints nothing, silently), a point
  # that is not one, and both options at once. Each refusal must leave no
  # object, no /Pattern resource and no pushed canvas - and the script must
  # not have run.
  set wrong {}
  foreach call {
    {-matrix {1 0 0 1 0}}
    {-matrix {1 0 0 1 0 0 0}}
    {-matrix {1 0 0 x 0 0}}
    {-matrix {1 2 2 4 0 0}}
    {-matrix {0 0 0 0 0 0}}
    {-origin {1 2 3}}
    {-origin {1 x}}
    {-matrix {1 0 0 1 0 0} -origin {1 1}}
  } {
    set doc [tclpdf new]
    $doc page add
    set ::ran 0
    set code [catch {$doc pattern create p -size {4 4} {*}$call -script {set ::ran 1}}]
    set left [list $code $::ran [llength [::tclpdfTest::patternBodies $doc]] \
        [dict keys [$doc resource Pattern]] [$doc canvas depth] [$doc pattern names]]
    $doc destroy
    if {$left ne {1 0 0 {} 0 {}}} {
      lappend wrong [list $call $left]
    }
  }
  unset -nocomplain ::ran
  set wrong
} -result {}

test graphics-pattern-4.6 {a mirror is not singular, and the size stays unscaled} -body {
  # A negative determinant is a mirror and is fine; -matrix and -origin are
  # each accepted alone. And [pattern size] answers the BBox of pattern space
  # - a matrix that doubles the tile does not double the answer.
  set doc [tclpdf new -unit mm]
  $doc page add
  set codes [list [catch {$doc pattern create mirror -size {4 4} \
      -matrix {-1 0 0 1 0 0} -script {}}] \
      [catch {$doc pattern create big -size {4 4} -matrix {2 0 0 2 0 0} -script {}}] \
      [catch {$doc pattern create here -size {4 4} -origin {10 10} -script {}}]]
  set size [lmap value [$doc pattern size big] {format %.0f $value}]
  set names [$doc pattern names]
  $doc destroy
  list $codes $size $names
} -result {{0 0 0} {4 4} {mirror big here}}

# -- refused values, refused early -----------------------------------------
#
# Two patterns from the second norm review. First: values at the edge of what
# the standard allows went straight into the file - a dash of {0 0}, a width
# below zero, a miter limit under 1 - and no validator says a word, because
# each is a well-formed number in the right place. Second: a shape wrote its
# style ("q" and all) and checked its geometry AFTERWARDS, so a refused point
# left the "q" open and the path without a painting operator. The tests below
# hand each primitive something wrong, catch the refusal, and then LOOK AT THE
# STREAM.

# The bracket balance of a content stream: q against Q, BDC against EMC, and
# whether a path construction is left standing without a painting operator.
proc ::tclpdfTest::balance {stream} {
  set operators [::tclpdfTest::operators $stream]
  set open 0
  foreach operator $operators {
    if {$operator in {m l c v y re h}} {
      set open 1
    } elseif {$operator in {S s f F f* B B* b b* n}} {
      set open 0
    }
  }
  return [list [llength [lsearch -all -exact $operators q]] \
      [llength [lsearch -all -exact $operators Q]] \
      [llength [lsearch -all -exact $operators BDC]] \
      [llength [lsearch -all -exact $operators EMC]] \
      $open]
}

# Every refused shape, untagged and tagged: what is left in the stream must
# be NOTHING - the shape was refused before a byte of it went out.
test graphics-refuse-10.1 {a refused shape leaves the stream balanced and empty} -body {
  set calls {
    {polygon -points {1 2 3 4 5} -stroke black}
    {polygon -points {1 2 3} -stroke black}
    {rect -at {1 1} -size {2 2} -radius abc -stroke black}
    {rect -at {1 1} -size {2 2} -radius -1 -stroke black}
    {rect -at {1 x} -size {2 2} -stroke black}
    {curve -from {1 1} -c1 {2 2} -c2 {3 x} -to {4 4}}
    {path -segments {{move 1 1} {arc 3 3}} -stroke black}
    {path -segments {{move 1 1} {line 3}} -stroke black}
    {path -segments {{line 1 1}} -stroke black}
    {line -from {1 1} -to {2 y} -width 1}
    {ellipse -at {1 1} -radius x -stroke black}
    {ellipse -at {1 1} -radius -2 -stroke black}
    {rect -at {1 1} -size {2 2} -stroke black -cap foo}
    {rect -at {1 1} -size {2 2} -stroke black -join foo}
    {rect -at {1 1} -size {2 2} -fill nosuchcolour}
    {rect -at {1 1} -size {2 2} -stroke black -opacity 3}
    {rect -at {1 1} -size {2 2} -stroke black -blend foo}
    {rect -at {1 1} -size {2 2} -stroke black -dash {0 0}}
    {rect -at {1 1} -size {2 2} -stroke black -width -1}
    {rect -at {1 1} -size {2 2} -stroke black -miter 0.5}
  }
  set wrong {}
  foreach tagged {0 1} {
    foreach call $calls {
      set doc [tclpdf new]
      $doc tagged $tagged
      $doc page add
      set code [catch {$doc {*}$call}]
      set balance [::tclpdfTest::balance [::tclpdfTest::content $doc]]
      $doc destroy
      if {$code != 1 || $balance ne {0 0 0 0 0}} {
        lappend wrong [list tagged $tagged $call code $code balance $balance]
      }
    }
  }
  set wrong
} -result {}

test graphics-refuse-10.2 {a refused style does not leave the next shape unmarked} -body {
  # The style took its structure mark and only THEN found the cap it could
  # not read - so the mark's bookkeeping believed an artifact was open, and
  # the next shape on the page went out without a bracket of its own.
  set doc [tclpdf new]
  $doc tagged 1
  $doc page add
  catch {$doc rect -at {1 1} -size {2 2} -stroke black -cap foo}
  $doc rect -at {1 1} -size {2 2} -stroke black
  set balance [::tclpdfTest::balance [::tclpdfTest::content $doc]]
  $doc destroy
  set balance
} -result {1 1 1 1 0}

test graphics-refuse-10.3 {a path segment takes exactly its numbers} -body {
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach segments {
    {{move 1 1} {line 3}}
    {{move 1}}
    {{move 1 1} {curve 1 2 3 4 5}}
    {{move 1 1} {close 1}}
    {{move 1 1} {line 1 2 3 4}}
    {{move 1 1} {curve 1 2 3 4}}
    {{move 1 2 3 4}}
    {{move 1 1} {line 2 2} {curve 1 2 3 4 5 6} {close}}
  } {
    lappend codes [catch {$doc path -segments $segments -stroke black}]
  }
  $doc destroy
  # The even-but-wrong counts are the ones that matter: an odd count fails
  # on the missing number anyway, but {line 1 2 3 4} used to go out as four
  # operands to an operator that takes two.
  set codes
} -result {1 1 1 1 1 1 1 0}

test graphics-refuse-10.4 {a path begins with a move, and says so} -body {
  # "l" without a current point is undefined (8.5.2.1): a reader may draw
  # from wherever it last was, or nothing.
  set doc [tclpdf new]
  $doc page add
  set code [catch {$doc path -segments {{line 1 1} {line 2 2}} -stroke black} message]
  set clip [catch {$doc clip -segments {{curve 1 1 2 2 3 3}}}]
  $doc destroy
  list $code [string match {*starts with {move x y}*} $message] $clip
} -result {1 1 1}

test graphics-refuse-10.5 {a polygon takes pairs} -body {
  set doc [tclpdf new]
  $doc page add
  set odd [catch {$doc polygon -points {1 2 3 4 5} -stroke black} message]
  set even [catch {$doc polygon -points {1 2 3 4 5 6} -stroke black}]
  $doc destroy
  list $odd [string match {*pairs*} $message] $even
} -result {1 1 0}

test graphics-limit-11.1 {a dash array is non-negative and not all zero} -body {
  # 8.4.3.6. {0 0} would ask for a line made of nothing.
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach dash {{0 0} {0} {1 -1} {abc 2} {0 2} {3 1} none} {
    lappend codes [catch {$doc rect -at {1 1} -size {2 2} -stroke black -dash $dash}]
  }
  $doc destroy
  set codes
} -result {1 1 1 1 0 0 0}

test graphics-limit-11.2 {a line width is 0 or more} -body {
  # 8.4.3.2: zero is the thinnest line the device can draw, and allowed.
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach width {-1 abc 0 0.5} {
    lappend codes [catch {$doc line -from {1 1} -to {2 2} -width $width}]
  }
  $doc destroy
  set codes
} -result {1 1 0 0}

test graphics-limit-11.3 {a miter limit is 1 or more} -body {
  # 8.4.3.5: the limit is a ratio to the line width, and 1 already bevels
  # every join.
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach miter {0.5 0 -3 abc 1 10} {
    lappend codes [catch {$doc rect -at {1 1} -size {2 2} -stroke black -miter $miter}]
  }
  $doc destroy
  set codes
} -result {1 1 1 1 0 0}

test graphics-limit-11.4 {the limits hold for style as well as for shapes} -body {
  # One GraphicsStyle for both, so one refusal - but measured, not assumed.
  set doc [tclpdf new]
  $doc page add
  set codes [list [catch {$doc style -dash {0 0}}] [catch {$doc style -width -1}] \
      [catch {$doc style -miter 0.5}] [catch {$doc style -width 0 -miter 1 -dash {1 0}}]]
  $doc destroy
  set codes
} -result {1 1 1 0}

test graphics-limit-11.5 {a radius is 0 or more} -body {
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach call {
    {rect -at {1 1} -size {2 2} -radius -1}
    {rect -at {1 1} -size {2 2} -radius abc}
    {rect -at {1 1} -size {2 2} -radius 0}
    {rect -at {1 1} -size {2 2} -radius 0.5}
    {circle -at {1 1} -radius -1}
    {ellipse -at {1 1} -size {-2 2}}
    {circle -at {1 1} -radius 0}
  } {
    lappend codes [catch {$doc {*}$call}]
  }
  $doc destroy
  set codes
} -result {1 1 0 0 1 1 0}

test graphics-limit-11.6 {-matrix is six numbers} -body {
  # "cm" takes exactly six operands (8.4.4); five used to go out as they were.
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach matrix {{1 0 0 1 0} {1 0 0 1 0 0 0} {1 0 0 x 0 0} {1 0 0 1 0 0}} {
    lappend codes [catch {$doc transform -matrix $matrix}]
  }
  set operators [::tclpdfTest::operators [::tclpdfTest::content $doc]]
  $doc destroy
  list $codes [llength [lsearch -all $operators cm]]
} -result {{1 1 1 0} 1}

test graphics-limit-11.8 {opacity refuses a side it does not know} -body {
  # "opacity 0.5 foo" used to be accepted and to write an ExtGState with
  # neither ca nor CA - a call that changed nothing and said nothing.
  set doc [tclpdf new -unit mm -compress 0]
  $doc page add
  set code [catch {$doc opacity 0.5 foo} err]
  set fine [catch {$doc opacity 0.5 stroke} err2]
  set gs [$doc resource ExtGState]
  $doc destroy
  list $code [string match "*fill, stroke or both*" $err] $fine [dict size $gs]
} -result {1 1 0 1}

test graphics-limit-11.7 {-scale refuses zero, and takes a mirror} -body {
  # A zero factor makes the matrix singular; a negative one is a mirror
  # and fine.
  set doc [tclpdf new]
  $doc page add
  set codes {}
  foreach scale {0 {2 0} {0 2} abc {1 2 3} -1 {2 -1} 0.5} {
    lappend codes [catch {$doc transform -scale $scale} message]
    if {$scale eq "1 2 3"} {
      lappend codes [string match {*one factor or {sx sy}*} $message]
    }
  }
  $doc destroy
  set codes
} -result {1 1 1 1 1 1 0 0 0}

cleanupTests

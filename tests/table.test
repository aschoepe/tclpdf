package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::table
source [file join [file dirname [info script]] helper.tcl]

proc rows {count} {
  set result {}
  for {set n 1} {$n <= $count} {incr n} {
    lappend result [list $n "Artikel $n" [expr {$n * 2}]]
  }
  return $result
}

test table-1.1 {a table returns the y below itself} -body {
  # finalY: what lets a caller put a total underneath without counting rows.
  set doc [tclpdf new -unit mm]
  $doc page add
  set y [$doc table -at {20 30} -width 170 \
      -head {{A B C}} -body {{1 2 3} {4 5 6}}]
  $doc destroy
  expr {$y > 30 && $y < 70}
} -result 1

test table-1.2 {fixed widths are honoured and the rest is shared} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set widths [dict get [$doc table layout -width 100 \
      -body {{a bbbbbbbbbb c}} -columns {{width 20} {} {width 30}}] widths]
  $doc destroy
  list [lindex $widths 0] [lindex $widths 2] [format %.0f [lindex $widths 1]]
} -result {20 30 50}

test table-1.3 {fixed widths wider than the table are refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -width 50 -body {{a b}} \
        -columns {{width 40} {width 40}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*more than the table width*}

test table-2.1 {long text wraps inside its cell} -body {
  # The row gets taller instead of the text running past the column - which
  # is the whole reason measuring comes before drawing.
  set doc [tclpdf new -unit mm]
  $doc page add
  set short [$doc table -at {20 30} -width 100 -body {{"kurz" "b"}}]
  $doc page add
  set long [$doc table -at {20 30} -width 100 -body \
      {{"ein deutlich laengerer Text, der in dieser Spalte mehrfach umbrechen muss" "b"}} \
      -columns {{width 30} {}}]
  $doc destroy
  expr {$long > $short}
} -result 1

test table-3.1 {a table longer than the page breaks and repeats the head} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 170 -head {{Pos Artikel Menge}} -body [rows 90]
  set pages [$doc page count]
  $doc destroy
  expr {$pages > 1}
} -result 1

test table-3.2 {the head really is on the second page} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 170 -head {{Kopfzeile Artikel Menge}} -body [rows 90]
  set second [$doc page content 1]
  $doc destroy
  # The word is in the content of page two, not only page one.
  expr {[string first Kopfzeile $second] >= 0}
} -result 1

test table-3.3 {without -repeatHead it is not repeated} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 170 -head {{Kopfzeile Artikel Menge}} \
      -body [rows 90] -repeatHead 0
  set second [$doc page content 1]
  $doc destroy
  expr {[string first Kopfzeile $second] >= 0}
} -result 0

test table-4.1 {colSpan covers several columns} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set grid [dict get [$doc table layout -width 100 \
      -body {{a b c} {{text wide colSpan 2} d}}] body]
  $doc destroy
  set second [lindex $grid 1]
  list [dict get [lindex $second 0] colSpan] [dict get [lindex $second 1] column]
} -result {2 2}

test table-4.2 {rowSpan takes a place in the row below} -body {
  # The HTML model: the covered position is NOT written out again, so the
  # cell after it moves one column along.
  set doc [tclpdf new -unit mm]
  $doc page add
  set grid [dict get [$doc table layout -width 100 \
      -body {{{text tall rowSpan 2} b c} {b2 c2}}] body]
  $doc destroy
  set second [lindex $grid 1]
  list [dict get [lindex $second 0] column] [dict get [lindex $second 1] column]
} -result {1 2}

test table-4.3 {a spanning cell is drawn over all the rows it covers} -body {
  # Regression, found by rendering: taking the cell's own measured height
  # instead of the covered rows left the row below without a left-hand rule,
  # and nothing reported it.
  set doc [tclpdf new -unit mm]
  $doc page add
  set layout [$doc table layout -width 80 \
      -body {{{text tall rowSpan 2} b} {b2}}]
  set heights [dict get $layout bodyHeights]
  $doc destroy
  set spanning [lindex [lindex [dict get $layout body] 0] 0]
  expr {[dict get $spanning spanHeight] ==
      [lindex $heights 0] + [lindex $heights 1]}
} -result 1

test table-4.4 {a bad span is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -body {{{text x colSpan 0}}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*colSpan must be a positive integer*}

test table-5.1 {didParseCell can change a cell before it is measured} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 100 -body {{a b}} -theme plain \
      -didParseCell {apply {{cell doc} {
        dict set cell text "[dict get $cell text]!"
        return $cell
      }}}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [expr {[string first "(a!)" $content] >= 0}] \
      [expr {[string first "(b!)" $content] >= 0}]
} -result {1 1}

test table-5.2 {willDrawCell can suppress a cell} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 100 -body {{sichtbar versteckt}} -theme plain \
      -willDrawCell {apply {{cell doc} {
        return [expr {[dict get $cell text] ne "versteckt"}]
      }}}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  list [expr {[string first "(sichtbar)" $content] >= 0}] \
      [expr {[string first "(versteckt)" $content] >= 0}]
} -result {1 0}

test table-5.3 {didDrawPage runs once per page} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set seen {}
  $doc table -at {20 30} -width 170 -head {{A B C}} -body [rows 90] \
      -didDrawPage [list apply {{listName payload doc} {
        upvar #0 $listName seen
        lappend seen [dict get $payload page]
      }} ::tclpdfTableSeen]
  set pages [$doc page count]
  $doc destroy
  set count [llength $::tclpdfTableSeen]
  unset ::tclpdfTableSeen
  expr {$count == $pages}
} -result 1

test table-6.1 {an unknown theme names the known ones} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -body {{a}} -theme nosuch
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown table theme "nosuch"*striped*}

test table-6.2 {a table without rows is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*needs -head or -body*}

test table-7.1 {a wide table splits into column groups} -body {
  # Ten fixed columns of 40 mm are 400 mm wide; on 170 mm that is three
  # groups, and the first column repeats so the rows stay identifiable.
  set doc [tclpdf new -unit mm]
  $doc page add
  set columns {}
  for {set n 0} {$n < 10} {incr n} {
    lappend columns {width 40}
  }
  $doc table -at {20 30} -width 170 -horizontalBreak 1 -repeatColumns 1 \
      -columns $columns \
      -head {{c0 c1 c2 c3 c4 c5 c6 c7 c8 c9}} \
      -body {{v0 v1 v2 v3 v4 v5 v6 v7 v8 v9}}
  set pages [$doc page count]
  set first [$doc page content 0]
  set second [$doc page content 1]
  $doc destroy
  # The repeated column is on both, the last one only on the last page.
  list [expr {$pages > 1}] [expr {[string first "(c0)" $second] >= 0}] \
      [expr {[string first "(c9)" $first] >= 0}]
} -result {1 1 0}

test table-8.1 {decimal alignment lines the separators up} -body {
  # The point of the whole thing: 1234.50 and 7.5 have different numbers of
  # digits before the point, and the points still sit one under the other.
  # Right alignment only looks the same while every number has the same
  # number of decimals.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {10 10} -width 100 -theme plain \
      -body {{"a" "1234.50"} {"b" "7.5"}} -columns {{} {align decimal}}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  # Both tails are placed by the same Td x - collect them and compare.
  set xs {}
  foreach {-> x} [regexp -all -inline {(\S+) \S+ Td\n\(\.5} $content] {
    lappend xs $x
  }
  list [llength $xs] [expr {[lindex $xs 0] eq [lindex $xs 1]}]
} -result {2 1}

test table-8.2 {a trailing zero survives the line breaker} -body {
  # Regression, and it reached far beyond tables: textLines built its
  # candidate with [expr {$current eq {} ? $word : ...}], and expr normalises
  # a word that looks like a number. "1234.50" came out as "1234.5" in every
  # wrapped paragraph in the package - a valid document with a wrong figure.
  set doc [tclpdf new -unit mm]
  $doc page add
  set lines [$doc textLines "1234.50 and 7.50" 100 -size 9]
  $doc destroy
  set lines
} -result {{1234.50 and 7.50}}

test table-8.3 {a decimal column takes the separator it is told} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {10 10} -width 100 -theme plain -decimal , \
      -body {{"a" "1234,50"} {"b" "7,5"}} -columns {{} {align decimal}}
  set content [::tclpdfTest::content $doc]
  $doc destroy
  expr {[string first {(,50)} $content] >= 0}
} -result 1

test table-8.4 {a heading over a decimal column is set flush right} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  set layout [$doc table layout -width 100 -head {{"Item" "Amount"}} \
      -body {{"a" "1.50"}} -columns {{} {align decimal}}]
  $doc destroy
  dict get [lindex [lindex [dict get $layout head] 0] 1] resolved align
} -result right

test table-9.1 {a rowSpan binds its rows into one group} -body {
  # The unit that has to fit on a page is the GROUP, not the row. This checks
  # the arithmetic on its own: every row reports the last row of its group.
  # TableGroupSpan is private, and a private method cannot be called from
  # outside - measured. Exporting it on this one object is the least invasive
  # way to test the arithmetic without a whole document around it.
  package require tclpdf::table
  set doc [tclpdf new -unit mm]
  oo::objdefine $doc export TableGroupSpan
  set rows {}
  foreach spans {1 3 1 1 2 1} {
    lappend rows [list [dict create rowSpan $spans]]
  }
  # rows 0 | 1..3 | 4 | 5.. wait: row 1 spans 3, so 1,2,3 are one group;
  # row 4 spans 2, so 4,5 are one.
  set ends [$doc TableGroupSpan $rows]
  $doc destroy
  set ends
} -result {0 3 2 3 5 5}

test table-9.2 {overlapping spans merge into one group} -body {
  # A span starting inside another group has to push the whole group's end
  # down, otherwise a break can still land between them.
  package require tclpdf::table
  set doc [tclpdf new -unit mm]
  oo::objdefine $doc export TableGroupSpan
  set rows {}
  foreach spans {3 1 3 1 1} {
    lappend rows [list [dict create rowSpan $spans]]
  }
  set ends [$doc TableGroupSpan $rows]
  $doc destroy
  set ends
} -result {4 1 4 3 4}

test table-9.3 {a group is drawn whole, on one page} -body {
  # The one that matters: not how many pages, but whether the three rows the
  # span binds ended up on the SAME page. didDrawCell hands the cell and the
  # document, and the document knows which page it is on.
  #
  # 37 filler rows put the break INSIDE the group - measured, at 36 or 39 it
  # falls elsewhere and the test passes either way, which is how the first
  # version of it managed to stay green against the old behaviour.
  set doc [tclpdf new -unit mm]
  $doc page add
  set body {}
  for {set n 1} {$n <= 37} {incr n} {
    lappend body [list "filler $n" "-"]
  }
  lappend body [list {text "spans three" rowSpan 3} a] {b} {c}
  set ::tablePages [dict create]
  $doc table -at {20 20} -width 100 -theme grid -body $body \
      -didDrawCell {apply {{cell doc} {
        set text [dict get $cell text]
        if {$text in {"spans three" a b c}} {
          dict set ::tablePages $text [$doc page current]
        }
      }}}
  $doc destroy
  # All four cells of the group have to report the same page.
  set pages [lsort -unique [dict values $::tablePages]]
  list [dict size $::tablePages] [llength $pages]
} -result {4 1}

# Every stroked rectangle in a content stream, as {x y width height}. A cell
# rule is a line, a fill is "re f" - only the frame is "re S".
proc frames {stream} {
  set result {}
  foreach {-> x y width height} [regexp -all -inline \
      {(-?[0-9.]+) (-?[0-9.]+) (-?[0-9.]+) (-?[0-9.]+) re\nS} $stream] {
    lappend result [list $x $y $width $height]
  }
  return $result
}

test table-10.1 {-border outer frames the block instead of every cell} -body {
  # One rectangle, at the table's own position and width - and NO cell rules
  # beside it, which is the whole point of the value.
  set doc [tclpdf new -unit mm]
  $doc page add
  set y [$doc table -at {20 30} -width 100 -theme grid -style {border outer} \
      -head {{A B}} -body {{1 2} {3 4}}]
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  set drawn [frames $stream]
  lassign [lindex $drawn 0] x top width height
  # mm to points, and the frame reaches from the top of the table down to the
  # y the call itself reported.
  set mm [expr {72 / 25.4}]
  list [llength $drawn] \
      [format %.2f [expr {$x / $mm}]] [format %.2f [expr {$width / $mm}]] \
      [format %.2f [expr {$height / $mm}]] [format %.2f [expr {$y - 30}]] \
      [llength [regexp -all -inline {(?m)^S$} $stream]]
} -result {1 20.00 100.00 19.95 19.95 1}

test table-10.2 {a table broken over pages is framed once per page} -body {
  # A frame around the table as a whole would run off the paper. The unit is
  # the page: three pages, three frames, each one only as tall as its own part.
  set doc [tclpdf new -unit mm]
  $doc page add
  set body {}
  for {set n 1} {$n <= 90} {incr n} {
    lappend body [list "row $n" $n]
  }
  $doc table -at {20 20} -width 100 -theme grid -style {border outer} \
      -head {{A B}} -body $body
  set pages [$doc page count]
  set counts {}
  set heights {}
  for {set page 0} {$page < $pages} {incr page} {
    set drawn [frames [::tclpdfTest::content $doc $page]]
    lappend counts [llength $drawn]
    foreach frame $drawn {
      lappend heights [expr {[lindex $frame 3] < 800}]
    }
  }
  $doc destroy
  list [expr {$pages > 1}] [lsort -unique $counts] [lsort -unique $heights]
} -result {1 1 1}

test table-11.1 {a foot row is drawn below the body} -body {
  # The whole -foot section had no test at all: a table can be built, broken
  # and framed without one, so nothing ever noticed. It is where the total
  # goes, which is the part a reader looks at first.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 100 -head {{Posten Betrag}} \
      -body {{Kabel 12} {Stecker 8}} -foot {{Summe 20}}
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # Present, and after the last body row rather than before it.
  list [expr {[string first Summe $stream] >= 0}] \
      [expr {[string first Summe $stream] > [string first Stecker $stream]}]
} -result {1 1}

test table-11.2 {-repeatFoot carries the foot onto every page} -body {
  # The default is 0 - a total repeated on every page would be read as a page
  # total and is wrong more often than right. Asking for it has to work all
  # the same, and this is the half nothing exercised.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 20} -width 170 -head {{Pos Artikel Menge}} \
      -body [rows 90] -foot {{"Zwischensumme" "" 42}} -repeatFoot 1
  set pages [$doc page count]
  set seen {}
  for {set page 0} {$page < $pages} {incr page} {
    lappend seen [expr {[string first Zwischensumme \
        [::tclpdfTest::content $doc $page]] >= 0}]
  }
  $doc destroy
  list [expr {$pages > 1}] [lsort -unique $seen]
} -result {1 1}

test table-11.3 {without -repeatFoot it appears once} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 20} -width 170 -head {{Pos Artikel Menge}} \
      -body [rows 90] -foot {{"Zwischensumme" "" 42}}
  set pages [$doc page count]
  set count 0
  for {set page 0} {$page < $pages} {incr page} {
    if {[string first Zwischensumme [::tclpdfTest::content $doc $page]] >= 0} {
      incr count
    }
  }
  $doc destroy
  list [expr {$pages > 1}] $count
} -result {1 1}

test table-11.4 {each section takes its own style} -body {
  # -headStyle, -bodyStyle and -footStyle are three separate dictionaries laid
  # over the theme, and only the theme's own versions had ever been used. A
  # caller who colours the three differently is the normal case, not an edge.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 20} -width 100 -theme plain \
      -head {{A B}} -body {{1 2}} -foot {{S 3}} \
      -headStyle {color {1 0 0}} -bodyStyle {color {0 0.5 0}} \
      -footStyle {color {0 0 1}}
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # The text colour of each section, in the order the sections are drawn.
  set colours {}
  foreach match [regexp -all -inline {[0-9.]+ [0-9.]+ [0-9.]+ rg} $stream] {
    set colour [lrange $match 0 2]
    if {$colour ni $colours} {
      lappend colours $colour
    }
  }
  set colours
} -result {{1 0 0} {0 0.5 0} {0 0 1}}

test table-11.5 {a section style overrides the theme, not the other way round} -body {
  # The order matters and is easy to get backwards: the theme is the base and
  # the caller's dictionary goes ON TOP. Reversed, every -headStyle would be
  # silently ignored for any key the theme happens to set - and "striped"
  # sets the head fill.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 20} -width 100 -theme striped \
      -head {{A B}} -body {{1 2}} -headStyle {fill {1 0 0}}
  set stream [::tclpdfTest::content $doc]
  $doc destroy
  # The head fill is the caller's red, not the theme's dark blue.
  expr {[string first "1 0 0 rg" $stream] >= 0}
} -result 1

test table-10.3 {an unknown border value names the known ones} -body {
  # It used to fall through every branch and draw nothing, in silence.
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -width 100 -style {border outside} -body {{a b}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown table border "outside"*outer*}

proc pagingRows {count} {
  set result {}
  for {set n 1} {$n <= $count} {incr n} {
    lappend result [list "row $n" $n]
  }
  return $result
}

test table-12.1 {a continued table starts at the top, not where it began} -body {
  # The defect this group is here for: -at is where the table STARTS, and it
  # used to be reinstated after every page break. The further down a table
  # began, the more pages it burned - the same sixty rows took two pages from
  # y=20 and sixty from y=270, one row per page.
  set counts {}
  foreach start {20 200 270} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc table -at [list 20 $start] -width 100 -body [pagingRows 60]
    lappend counts [$doc page count]
    $doc destroy
  }
  # Starting lower costs pages on the FIRST page only, never after it.
  expr {[lindex $counts 2] - [lindex $counts 0] <= 1}
} -result 1

test table-12.2 {the continuation position does not come from -at} -body {
  # Same derivation as -bottom, and for the same reason: the start position
  # answers a different question than the type area does.
  set firsts {}
  foreach start {40 200} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc table -at [list 20 $start] -width 100 -body [pagingRows 60]
    lappend firsts [lindex [::tclpdfTest::starts \
        [::tclpdfTest::content $doc 1] y] 0]
    $doc destroy
  }
  llength [lsort -unique $firsts]
} -result 1

test table-12.3 {-top places the continuation} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 200} -width 100 -top 100 -body [pagingRows 60]
  set first [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc 1] y] 0]
  $doc destroy
  # 100 mm down an A4 page is 558.4 pt up from its foot; the first baseline
  # sits one cell padding below that.
  expr {$first > 540 && $first < 559}
} -result 1

test table-12.4 {-at still places the first page} -body {
  # The other direction: a table that starts halfway down the page has to keep
  # starting there, or -at would mean nothing.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 200} -width 100 -body [pagingRows 60]
  set first [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc 0] y] 0]
  $doc destroy
  # 200 mm down is 274.9 pt up from the foot.
  expr {$first > 255 && $first < 276}
} -result 1

test table-12.5 {the frame of a continued table follows it up the page} -body {
  # The second half of the defect, and the one no page count would show: the
  # frame took $top as well, so on page two it started where the table began on
  # page one - 185 mm above its own rows, and nothing reports that.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 200} -width 100 -theme grid -style {border outer} \
      -body [pagingRows 60]
  set frame [lindex [frames [::tclpdfTest::content $doc 1]] 0]
  $doc destroy
  # The rectangle's top edge - y plus height in PDF coordinates - is near the
  # continuation position, not near the 274.9 pt that -at would give.
  expr {[lindex $frame 1] + [lindex $frame 3] > 780}
} -result 1

proc wrapRow {valign} {
  # One cell that wraps, two that do not - the only shape in which vertical
  # placement is visible at all.
  set long "A cell of running text long enough to take three lines in this\
      column, which is what makes the row taller than the single words beside\
      it and gives valign something to do."
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 170 -theme grid \
      -body [list [list [list text mark valign $valign] $long "9.90"]] \
      -columns {{width 22} {} {width 26}}
  set ys [::tclpdfTest::starts [::tclpdfTest::content $doc] y]
  $doc destroy
  return [lindex $ys 0]
}

test table-13.1 {valign is read from the cell, not only from its style} -body {
  # It was documented as a cell key from the start and read from nowhere: a
  # "valign middle" on a cell was accepted, ignored and never reported. Only a
  # row with something that wraps shows it, and no example had one.
  set direct [wrapRow middle]
  set long "A cell of running text long enough to take three lines in this\
      column, which is what makes the row taller than the single words beside\
      it and gives valign something to do."
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc table -at {20 30} -width 170 -theme grid \
      -body [list [list [list text mark style {valign middle}] $long "9.90"]] \
      -columns {{width 22} {} {width 26}}
  set viaStyle [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc] y] 0]
  $doc destroy
  expr {$direct == $viaStyle}
} -result 1

test table-13.2 {the three vertical placements are distinct and ordered} -body {
  # In PDF coordinates y counts up from the foot, so top is the largest.
  set ys {}
  foreach valign {top middle bottom} {
    lappend ys [wrapRow $valign]
  }
  lassign $ys top middle bottom
  expr {$top > $middle && $middle > $bottom}
} -result 1

test table-13.3 {a one-line row looks the same whatever valign says} -body {
  # The default is top for exactly this reason: nothing wraps, so there is no
  # spare height to place anything in, and no document changes because of it.
  set ys {}
  foreach valign {top middle bottom} {
    set doc [tclpdf new -unit mm]
    $doc page add
    $doc table -at {20 30} -width 170 -theme grid \
        -body [list [list [list text mark valign $valign] short "9.90"]] \
        -columns {{width 22} {} {width 26}}
    lappend ys [lindex [::tclpdfTest::starts [::tclpdfTest::content $doc] y] 0]
    $doc destroy
  }
  llength [lsort -unique $ys]
} -result 1

proc cellText {cell} {
  set doc [tclpdf new -unit mm]
  $doc page add
  set layout [$doc table layout -width 170 -body [list [list $cell]]]
  $doc destroy
  return [dict get [lindex [dict get $layout body] 0 0] text]
}

test table-14.1 {a sentence is a cell text, not a dictionary} -body {
  # In Tcl a string can BE a dictionary. "Medium length text here" is a four
  # element list whose key "text" holds "here", and the old test - is "text"
  # one of the keys - accepted it: the cell drew "here" and dropped the rest.
  # This stood in examples/out/04.03-table-spans.pdf, shipped.
  cellText "Medium length text here"
} -result {Medium length text here}

test table-14.2 {a dictionary cell is still read as one} -body {
  cellText {text "the payment" align right}
} -result {the payment}

test table-14.3 {an unknown cell key is refused, not swallowed} -body {
  # valign was the case that started this: written on a cell it was merged in,
  # read by nobody and never reported. A dictionary merged over defaults
  # refuses nothing, which is why the check has to be explicit.
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -width 170 -body {{{text a valigne middle} b}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown cell key "valigne"*valign*}

test table-14.4 {an unknown style key is refused, in an option and on a cell} -body {
  set errors {}
  foreach body {{{{text a style {bordr outer}} b}} {{a b}}} option {{} {-style {bordr outer}}} {
    set doc [tclpdf new -unit mm]
    $doc page add
    catch {$doc table -at {20 30} -width 170 -body $body {*}$option} message
    $doc destroy
    lappend errors [string match {*unknown style key "bordr"*} $message]
  }
  set errors
} -result {1 1}

test table-14.5 {an unknown column key is refused} -body {
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -width 170 -body {{a b}} -columns {{widht 20} {}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown column key "widht"*width weight*}

test table-14.6 {the remaining ambiguity is reported, not guessed} -body {
  # A plain string that begins with a cell key AND has an even word count is
  # read as a dictionary - the one case the first-word rule cannot separate.
  # It says so instead of keeping a fragment, which is the whole point.
  set doc [tclpdf new -unit mm]
  $doc page add
  try {
    $doc table -at {20 30} -width 170 -body {{"text is set here" b}}
  } finally {
    $doc destroy
  }
} -returnCodes error -match glob -result {*unknown cell key "set"*}

cleanupTests

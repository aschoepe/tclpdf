# markup.test --
#
# The tag notation of a paragraph (markup.tcl): one string in, the list of
# {text options} pairs out that [text -runs 1] sets. The parser knows no
# document, so these tests need none - what they check is the vocabulary,
# the one escape, the nesting rules and every refusal by name.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*
package require tclpdf
package require tclpdf::markup

set P ::tclpdf::markup::parse

test markup-1.1 {plain text is one run without options} -body {
  $P "nur Text"
} -result {{nur Text} {}}

test markup-1.2 {b, i, u and s set their run; text around them stays plain} -body {
  $P {Der <b>Betrag</b> ist <i>bald</i> <u>fällig</u>, nicht <s>gestern</s>.}
} -result {{Der } {} Betrag {style bold} { ist } {} bald {style italic} { } {} fällig {underline 1} {, nicht } {} gestern {strike 1} . {}}

test markup-1.3 {strong and em set bold and italic and travel as themselves} -body {
  $P {<strong>stark</strong> und <em>betont</em>}
} -result {stark {strong 1 style bold} { und } {} betont {em 1 style italic}}

test markup-1.4 {nested tags add up, in either order, and a tag repeated inside itself is harmless} -body {
  list [$P {<b><i>beides</i></b>}] [$P {<i><b>beides</b></i>}] [$P {<b>a<b>b</b>c</b>}]
} -result {{beides {style {bold italic}}} {beides {style {bold italic}}} {a {style bold} b {style bold} c {style bold}}}

test markup-1.5 {a link carries its address, with double quotes and nothing else} -body {
  $P {Siehe <a href="https://fossil.sowaswie.de/tclpdf">die Seite</a>.}
} -result {{Siehe } {} {die Seite} {url https://fossil.sowaswie.de/tclpdf} . {}}

test markup-1.6 {the case of a tag does not matter} -body {
  $P {<B>x</B><Em>y</EM>}
} -result {x {style bold} y {em 1 style italic}}

# --- paragraphs and headings ------------------------------------------------

test markup-2.1 {a heading is a paragraph: a line feed stands between it and what follows} -body {
  $P {<h1>Titel</h1>Text danach}
} -result {Titel {heading 1} {
} {} {Text danach} {}}

test markup-2.2 {a heading at the end adds no trailing line feed} -body {
  $P {Text davor <h2>Kopf</h2>}
} -result {{Text davor } {} {
} {} Kopf {heading 2}}

test markup-2.3 {two p elements are two paragraphs, and text between them is one of its own} -body {
  $P {<p>Erster</p>dazwischen<p>Zweiter <em>betont</em></p>}
} -result {Erster {} {
} {} dazwischen {} {
} {} {Zweiter } {} betont {em 1 style italic}}

test markup-2.4 {a heading may carry runs inside it, and they keep the heading} -body {
  $P {<h2>Kapitel <i>zwei</i></h2>}
} -result {{Kapitel } {heading 2} zwei {heading 2 style italic}}

test markup-2.5 {a line feed in the text stays a paragraph break, as without markup} -body {
  $P "eins\nzwei <b>drei</b>"
} -result {{eins
zwei } {} drei {style bold}}

test markup-2.6 {a heading after a line feed adds no second one} -body {
  $P "eins\n<h1>Kopf</h1>zwei"
} -result {{eins
} {} Kopf {heading 1} {
} {} zwei {}}

# --- what is text, and the one escape -----------------------------------------

test markup-3.1 {a < in front of a space, a digit, = or the end is text} -body {
  $P {a < b, 5 <3, x <= y, und <}
} -result {{a < b, 5 <3, x <= y, und <} {}}

test markup-3.2 {&lt; &gt; and &amp; are the escapes; any other & is text} -body {
  $P {&lt;b&gt; ist kein Tag, Tom &amp; Jerry, R&D, &copy;}
} -result {{<b> ist kein Tag, Tom & Jerry, R&D, &copy;} {}}

# --- refusals -----------------------------------------------------------------

test markup-4.1 {an unknown tag, a misnested close, an open tag, a paragraph inside a run} -body {
  set codes {}
  foreach text {{<bold>x</bold>} {<b>x</i>} {<b>offen} {<b><p>x</p></b>} {<i>y<h1>z</h1></i>} {</b>}} {
    catch {$P $text} msg opts
    lappend codes [lrange [dict get $opts -errorcode] 2 3]
  }
  set codes
} -result {{MARKUP UNKNOWN} {MARKUP NESTING} {MARKUP OPEN} {MARKUP NESTING} {MARKUP NESTING} {MARKUP NESTING}}

test markup-4.2 {a refusal names the position} -body {
  catch {$P {abc <bold>x</bold>}} msg opts
  list [lindex [dict get $opts -errorcode] 5] [regexp {position 4} $msg]
} -result {4 1}

test markup-4.3 {an attribute on any tag but a, and an a without href, are refused} -body {
  set codes {}
  foreach text {{<b class="x">y</b>} {<a>x</a>} {<a href=x>y</a>} {<a href="">y</a>}} {
    catch {$P $text} msg opts
    lappend codes [lindex [dict get $opts -errorcode] 3]
  }
  set codes
} -result {ATTRIBUTE HREF HREF HREF}

test markup-4.4 {a < in front of a letter that opens no tag is refused, with the escape named} -body {
  catch {$P {x <y}} msg opts
  list [lindex [dict get $opts -errorcode] 3] [regexp {&lt;} $msg]
} -result {UNKNOWN 1}

# --- lists -------------------------------------------------------------------

test markup-5.1 {every run of an item carries the kind of its list, beside what b and a add} -body {
  $P {<ul><li>eins</li><li><b>zwei</b> und <a href="https://example.org">drei</a></li></ul>}
} -result {eins {item bullet} {
} {} zwei {item bullet style bold} { und } {item bullet} drei {item bullet url https://example.org}}

test markup-5.2 {ol numbers its items, and every run tag combines inside an item as elsewhere} -body {
  $P {<ol><li><em><strong>beides</strong></em> <u>unter</u> <s>durch</s></li><li>zwei</li></ol>}
} -result {beides {item number em 1 strong 1 style {bold italic}} { } {item number} unter {item number underline 1} { } {item number} durch {item number strike 1} {
} {} zwei {item number}}

test markup-5.3 {white space behind <ul>, between items and in front of </ul> is swallowed} -body {
  set compact [$P {<ul><li>a</li><li>b</li><li>c</li></ul>}]
  set spread [$P "<ul>\n  <li>a</li>\n  <li>b</li>\t<li>c</li>\n</ul>"]
  list [string equal $compact $spread] $spread
} -result {1 {a {item bullet} {
} {} b {item bullet} {
} {} c {item bullet}}}

test markup-5.4 {white space inside an item is text of the item} -body {
  $P {<ul><li> a </li></ul>}
} -result {{ a } {item bullet}}

test markup-5.5 {a list at the end adds no trailing line feed; in front of it one, unless the text ends in one} -body {
  list [$P {Davor<ul><li>a</li></ul>}] [$P "Davor\n<ul><li>a</li></ul>"] [$P {<ul><li>a</li></ul>}]
} -result {{Davor {} {
} {} a {item bullet}} {{Davor
} {} a {item bullet}} {a {item bullet}}}

test markup-5.6 {text behind a list is a paragraph of its own; a line feed right behind </ul> is text, as behind </p>} -body {
  list [$P {<ul><li>a</li></ul>Danach}] [$P "<ul><li>a</li></ul>\nDanach"] [$P "<p>a</p>\nDanach"]
} -result {{a {item bullet} {
} {} Danach {}} {a {item bullet} {
} {} {
Danach} {}} {a {} {
} {} {
Danach} {}}}

test markup-5.7 {two lists apart: a paragraph between them, and a bulleted list followed by a numbered one} -body {
  list [$P {<ul><li>a</li></ul>Mitte<ol><li>b</li></ol>}] [$P {<ul><li>a</li></ul><ol><li>b</li></ol>}]
} -result {{a {item bullet} {
} {} Mitte {} {
} {} b {item number}} {a {item bullet} {
} {} b {item number}}}

test markup-5.8 {list tags are read in any case, a heading may stand in front, and a list takes no attribute} -body {
  catch {$P {<ul class="x"><li>a</li></ul>}} msg opts
  list [$P {<h1>Kopf</h1><UL><Li>a</lI></Ul>}] [lrange [dict get $opts -errorcode] 2 end]
} -result {{Kopf {heading 1} {
} {} a {item bullet}} {MARKUP ATTRIBUTE ul 0}}

test markup-5.9 {every list fault is refused with its code, the tag at fault and the position} -body {
  set codes {}
  foreach text [list \
      {<ul>x<li>a</li></ul>} {<ul><li>a</li>&lt;</ul>} {<ul><li>a</li> < </ul>} \
      {<ul><b>a</b></ul>} {<ol><p>a</p></ol>} {<ul><ul></ul></ul>} \
      {<li>a</li>} {<p><li>a</li></p>} {<b><li>a</li></b>} \
      {<b><ul><li>a</li></ul></b>} {<h1><ol><li>a</li></ol></h1>} {<ul><li><ol><li>a</li></ol></li></ul>} \
      {<ul><li><p>a</p></li></ul>} {<ul><li><h2>a</h2></li></ul>} "<ul><li>a\nb</li></ul>" \
      {<ul><li>a</ul>} {<ul><li>a</li></ol>} {<ul><li>a</li>} {<ol><li>a}] {
    catch {$P $text} msg opts
    lappend codes [lrange [dict get $opts -errorcode] 2 end]
  }
  set codes
} -result {{MARKUP NESTING li 4} {MARKUP NESTING li 14} {MARKUP NESTING li 15} {MARKUP NESTING b 4} {MARKUP NESTING p 4} {MARKUP NESTING ul 4} {MARKUP NESTING li 0} {MARKUP NESTING li 3} {MARKUP NESTING li 3} {MARKUP NESTING ul 3} {MARKUP NESTING ol 4} {MARKUP NESTING ol 8} {MARKUP NESTING p 8} {MARKUP NESTING h2 8} {MARKUP NESTING li 9} {MARKUP NESTING ul 9} {MARKUP NESTING ol 14} {MARKUP OPEN ul} {MARKUP OPEN li}}

test markup-5.10 {a refusal inside a list says what a list holds} -body {
  catch {$P {<ul>x</ul>}} msg
  list [regexp {position 4} $msg] [regexp {nothing but <li>} $msg]
} -result {1 1}

cleanupTests

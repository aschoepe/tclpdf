# importDecimal.test --
#
# A number a FOREIGN PDF writes with a leading zero is read in decimal, under
# Tcl 8.6 as under Tcl 9: /Count 011 is eleven pages, /MediaBox [0 0 0612
# 0792] is a letter page, /Rotate 090 is a quarter turn. ISO 32000-2, 7.3.3
# allows the zeros - its EXAMPLE 1 lists 00987 as an integer.
#
# Tcl 8.6 reads a leading zero as octal wherever a payload meets [expr],
# [incr] or [string is entier], and "08" as no number at all; Tcl 9 reads
# both in decimal. Measured 2026-11-06 under 8.6.18 before the reading was
# added: /Count 011 gave nine pages, /Count 09 none, [0 0 0612 0700] a page
# of 394 x 448, /Rotate 0132 a quiet 90, /Ff 0131072 a list box instead of a
# combo box, /ByteRange [0 0000100 ...] a raw ARITH DOMAIN from [pdf info],
# /Size 020 an update numbering from 16, and a predictor /Columns 010 a
# metadata stream that could not be read.
#
# The reading sits in ONE place, where the reader turns a token into a
# number object ([importRead::Parse]); these tests ask the consumers, each
# with a hand-built file whose numbers carry zeros, against the same file
# without them. Every test here fails under Tcl 8.6 on a tree without that
# reading, and the tests of the "stays right" kind pass on either.
#
# Not here: numbers a CALLER writes (decimal.test), and TEXT made of digits
# - a field name, an export value, an info string - which is no number and
# is not read as one.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::importInfo
package require tclpdf::update
package require tclpdf::sign
source [file join [file dirname [info script]] helper.tcl]

namespace eval ::importDecimalTest {}

# A page tree of ROOT pages: a node of NODE pages holding LEAVES leaves, and
# one more page beside it. Page n of the node is 100+n wide, the last one
# 111, so a page that is skipped or counted twice shows in the widths.
# Objects: 1 catalog, 2 root, 3 node, 4.. leaves, then the content stream,
# then the last page.
proc ::importDecimalTest::tree {name root node leaves} {
  set content [expr {4 + $leaves}]
  set last [expr {5 + $leaves}]
  set objects [list "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count $root /Kids \[3 0 R $last 0 R\] >>"]
  set kids {}
  for {set n 1} {$n <= $leaves} {incr n} {
    lappend kids "[expr {3 + $n}] 0 R"
  }
  lappend objects "<< /Type /Pages /Parent 2 0 R /Count $node\
      /Kids \[[join $kids]\] >>"
  for {set n 1} {$n <= $leaves} {incr n} {
    lappend objects "<< /Type /Page /Parent 3 0 R /MediaBox\
        \[0 0 [expr {100 + $n}] 200\] /Contents $content 0 R\
        /Resources << >> >>"
  }
  lappend objects "<< /Length 5 >>\nstream\nBT ET\nendstream"
  lappend objects "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 111 200\]\
      /Contents $content 0 R /Resources << >> >>"
  return [::tclpdfTest::buildpdf $name $objects]
}

# One page with MEDIA as its /MediaBox and EXTRA beside it.
proc ::importDecimalTest::page {name media {extra {}}} {
  return [::tclpdfTest::buildpdf $name [list \
      "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[$media\] $extra\
          /Contents 4 0 R /Resources << >> >>" \
      "<< /Length 5 >>\nstream\nBT ET\nendstream"]]
}

# One page and a metadata stream: DICT is what stands beside /Length in the
# stream dictionary, DATA its bytes.
proc ::importDecimalTest::metadata {name dict data} {
  return [::tclpdfTest::buildpdf $name [list \
      "<< /Type /Catalog /Pages 2 0 R /Metadata 4 0 R >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Resources << >> >>" \
      "<< /Type /Metadata /Subtype /XML $dict /Length [string length $data]\
          >>\nstream\n$data\nendstream"]]
}

# An XMP packet whose length is a multiple of 10 and 20, and the same bytes
# as rows of COLUMNS behind PNG row tag 0 (None), deflated.
proc ::importDecimalTest::packet {} {
  set xmp "<x:xmpmeta xmlns:x='adobe:ns:meta/'>tclpdf-0123456789</x:xmpmeta>"
  while {[string length $xmp] % 20} {
    append xmp " "
  }
  return $xmp
}
proc ::importDecimalTest::predicted {xmp columns} {
  set raw {}
  for {set i 0} {$i < [string length $xmp]} {incr i $columns} {
    append raw \x00 [string range $xmp $i [expr {$i + $columns - 1}]]
  }
  return [zlib compress $raw]
}

# What a script answers, or its -errorcode where it is refused.
proc ::importDecimalTest::outcome {script} {
  if {[catch {uplevel 1 $script} result options]} {
    return [list error [lrange [dict get $options -errorcode] 0 2]]
  }
  return [list ok $result]
}

# The widths of every page of PATH, as [pdf pages] answers them.
proc ::importDecimalTest::widths {path} {
  return [lmap page [::tclpdf::pdf pages $path] {dict get $page width}]
}

# The width of page 9 of PATH, taken over by [pdf import].
proc ::importDecimalTest::imported {path page} {
  set doc [tclpdf new -unit pt]
  try {
    $doc page add
    $doc pdf import f $path -page $page
    return [lindex [$doc form size f] 0]
  } finally {
    $doc destroy
  }
}

#
# --- the page tree ----------------------------------------------------------
#

test importDecimal-1.1 {/Count 011 is eleven pages, /Count 010 ten} -body {
  set zero [::importDecimalTest::tree idec-tree-zero.pdf 011 010 10]
  set plain [::importDecimalTest::tree idec-tree-plain.pdf 11 10 10]
  set result [list [dict get [::tclpdf::pdf info $zero] pages] \
      [::importDecimalTest::widths $zero] \
      [expr {[::importDecimalTest::widths $zero]
          eq [::importDecimalTest::widths $plain]}] \
      [::importDecimalTest::imported $zero 9]]
  file delete $zero $plain
  set result
} -result {11 {101 102 103 104 105 106 107 108 109 110 111} 1 109.0}

test importDecimal-1.2 {/Count 09 and /Count 08 are numbers, not refusals} -body {
  set zero [::importDecimalTest::tree idec-tree-08.pdf 09 08 8]
  set result [list [dict get [::tclpdf::pdf info $zero] pages] \
      [::importDecimalTest::widths $zero] \
      [::importDecimalTest::imported $zero 9]]
  file delete $zero
  set result
} -result {9 {101 102 103 104 105 106 107 108 111} 111.0}

test importDecimal-1.3 {the signature widget lands on the page it names} -body {
  # [sign add -page] walks the tree by /Count: with 011 read as nine, the
  # widget for page 9 went onto page 11 (object 30 in the measurement), and
  # 08 stopped on a raw "expected integer" from [incr].
  set result {}
  foreach {name root node leaves} {
    idec-sign-zero.pdf 011 010 10 idec-sign-plain.pdf 11 10 10
    idec-sign-08.pdf 09 08 8
  } {
    set path [::importDecimalTest::tree $name $root $node $leaves]
    set upd [::tclpdf::update open $path]
    lappend result [::tclpdf::sign::PageNumber $upd \
        [::tclpdf::sign::Value [$upd body 1]] 8 test]
    $upd destroy
    file delete $path
  }
  set result
} -result {12 12 13}

#
# --- boxes and rotation -----------------------------------------------------
#

test importDecimal-2.1 {a box with zeros is the box without them} -body {
  set result {}
  foreach media {{0 0 0612 0700} {0 0 0612 0792} {-012 0 600 700}
      {0 0 0612.0 0792.} {0 0 00.5 01}} {
    set path [::importDecimalTest::page idec-box.pdf $media]
    set page [lindex [::tclpdf::pdf pages $path] 0]
    lappend result [list [dict get $page mediabox] [dict get $page width] \
        [dict get $page height] [dict get [::tclpdf::pdf info $path] size]]
    file delete $path
  }
  set result
} -result {{{0 0 612 700} 612 700 {612 700}} {{0 0 612 792} 612 792 {612 792}}\
    {{-12 0 600 700} 612 700 {612 700}} {{0 0 612.0 792.0} 612.0 792.0\
    {612.0 792.0}} {{0 0 0.5 1} 0.5 1 {0.5 1}}}

test importDecimal-2.2 {/Rotate 090 turns, /Rotate 0132 is refused rather than read as 90} -body {
  set result {}
  foreach rotate {090 0270 -090 0132} {
    set path [::importDecimalTest::page idec-rotate.pdf {0 0 612 792} \
        "/Rotate $rotate"]
    lappend result [::importDecimalTest::outcome {
      set page [lindex [::tclpdf::pdf pages $path] 0]
      list [dict get $page rotate] [dict get $page width]
    }]
    file delete $path
  }
  set result
} -result {{ok {90 792}} {ok {270 792}} {ok {270 792}}\
    {error {TCLPDF IMPORT ROTATE}}}

test importDecimal-2.3 {an imported page with zeros is the page without them} -body {
  set zero [::importDecimalTest::page idec-form-zero.pdf {0 0 0612 0792} \
      {/Rotate 090}]
  set plain [::importDecimalTest::page idec-form-plain.pdf {0 0 612 792} \
      {/Rotate 90}]
  set result [list [::importDecimalTest::imported $zero 1] \
      [::importDecimalTest::imported $plain 1]]
  file delete $zero $plain
  set result
} -result {792.0 792.0}

#
# --- form fields ------------------------------------------------------------
#

# The fields of a file that writes its flags and its selection as FF and I:
# a text field with /Ff TEXT, a choice field with /Ff CHOICE, and a list of
# eleven options with /I [INDEX].
proc ::importDecimalTest::fields {name text choice index} {
  set path [::tclpdfTest::buildpdf $name [list \
      "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields\
          \[4 0 R 5 0 R 6 0 R\] >> >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Annots \[4 0 R 5 0 R 6 0 R\] /Resources << >> >>" \
      "<< /FT /Tx /T (a) /Ff $text /Subtype /Widget /Rect \[0 0 10 10\]\
          /P 3 0 R >>" \
      "<< /FT /Ch /T (b) /Ff $choice /Opt \[(x) (y)\] /Subtype /Widget\
          /Rect \[0 0 10 10\] /P 3 0 R >>" \
      "<< /FT /Ch /T (c) /Ff 131072 /Opt \[(a) (b) (c) (d) (e) (f) (g) (h)\
          (i) (j) (k)\] /I \[$index\] /Subtype /Widget /Rect \[0 0 10 10\]\
          /P 3 0 R >>"]]
  set result [lmap field [::tclpdf::pdf fields $path] {
    list [dict get $field type] [dict get $field flags] \
        [dict get $field required] [dict get $field selected]
  }]
  file delete $path
  return $result
}

test importDecimal-3.1 {/Ff and /I with zeros are the flags and the index without them} -body {
  set zero [::importDecimalTest::fields idec-fields-zero.pdf 04096 0131072 010]
  set plain [::importDecimalTest::fields idec-fields-plain.pdf 4096 131072 10]
  list [expr {$zero eq $plain}] $zero
} -result {1 {{text Multiline 0 {}} {combo Combo 0 {}} {combo Combo 0 k}}}

test importDecimal-3.2 {/Ff 010 is bits 2 and 4, as /Ff 10 is} -body {
  # Read as octal it was eight - bit 4 alone, and the field lost its
  # Required flag.
  list [::importDecimalTest::fields idec-ff-zero.pdf 010 0 0] \
      [::importDecimalTest::fields idec-ff-plain.pdf 10 0 0]
} -result {{{text {Required bit4} 1 {}} {listbox {} 0 {}} {combo Combo 0 a}}\
    {{text {Required bit4} 1 {}} {listbox {} 0 {}} {combo Combo 0 a}}}

#
# --- signatures -------------------------------------------------------------
#

test importDecimal-4.1 {a /ByteRange with zeros is the byte range without them} -body {
  # 7.3.3 lets a writer pad the four numbers, and tools that reserve the
  # space before they know the offsets do. Under 8.6 the sum of the four
  # met [expr] and [pdf info] ended in "invalid octal number".
  set objects [list "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields\
          \[4 0 R\] /SigFlags 3 >> >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Annots \[4 0 R\] /Resources << >> >>" \
      "<< /FT /Sig /T (s) /V 5 0 R /Subtype /Widget /Rect \[0 0 0 0\]\
          /P 3 0 R >>" \
      "<< /Type /Sig /Filter /Adobe.PPKLite /SubFilter /adbe.pkcs7.detached\
          /ByteRange \[0 0000100 0000000 0000000\] /Contents <00> >>"]
  set path [::tclpdfTest::buildpdf idec-byterange.pdf $objects]
  set bytes [::tclpdfTest::readBytes $path]
  set size [string length $bytes]
  set c 300
  set d [expr {$size - $c}]
  # Same length, so every offset of the table stays right.
  ::tclpdf::io write $path [string map [list \
      "/ByteRange \[0 0000100 0000000 0000000\]" \
      "/ByteRange \[0 0000100 [format %07d $c] [format %07d $d]\]"] $bytes]
  set signature [lindex [dict get [::tclpdf::pdf info $path] signatures] 0]
  file delete $path
  list [expr {[dict get $signature byterange] eq [list 0 100 $c $d]}] \
      [dict get $signature whole]
} -result {1 1}

#
# --- the update -------------------------------------------------------------
#

test importDecimal-5.1 {/Size 020 makes an update number from 20} -body {
  set result {}
  foreach size {020 20} {
    # The trailer of [buildpdf] carries /Size 6; the second one, written
    # after it, is the one that counts (7.3.7 forbids two, and the reader
    # takes the last, as qpdf does).
    set path [::tclpdfTest::buildpdf idec-size.pdf [list \
        "<< /Type /Catalog /Pages 2 0 R >>" \
        "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
        "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
            /Resources << >> >>"] "/Size $size"]
    set upd [::tclpdf::update open $path]
    lappend result [$upd add "<< >>"]
    $upd destroy
    file delete $path
  }
  set result
} -result {20 20}

test importDecimal-5.2 {update replace takes the number a caller writes in decimal} -body {
  # A caller's number, not the file's - read like every option the package
  # takes. Before: 010 was looked up as a key the table does not have, and
  # 08 was "not a positive integer" under 8.6 only.
  set path [::importDecimalTest::tree idec-replace.pdf 11 10 10]
  set upd [::tclpdf::update open $path]
  set result [list [$upd replace 010 [$upd body 10]] \
      [$upd replace 08 [$upd body 8]]]
  $upd destroy
  file delete $path
  set result
} -result {10 8}

test importDecimal-5.3 {defines, ref, body, put and release read the caller's number in decimal too} -body {
  set path [::importDecimalTest::tree idec-number.pdf 11 10 10]
  set upd [::tclpdf::update open $path]
  set body [$upd body 010]
  set written [$upd reserve]
  set spare [$upd reserve]
  $upd put [format %03d $written] "<< /Type /Probe >>"
  set result [list [$upd defines 010] [$upd defines 08] \
      [expr {$body eq [$upd body 10]}] [$upd ref 010] \
      [$upd defines [format %03d $written]] [$upd body [format %03d $written]] \
      [expr {[$upd release [format %03d $spare]] == $spare}]]
  $upd destroy
  file delete $path
  set result
} -result {1 1 1 {10 0 R} 1 {<< /Type /Probe >>} 1}

#
# --- streams ----------------------------------------------------------------
#

test importDecimal-6.1 {predictor parameters with zeros} -body {
  set xmp [::importDecimalTest::packet]
  set result {}
  foreach {parms columns} {
    {/Predictor 12 /Columns 010} 10 {/Predictor 12 /Columns 08} 8
    {/Predictor 12 /Columns 020} 20 {/Predictor 010 /Columns 10} 10
    {/Predictor 12 /Colors 01 /Columns 10} 10
  } {
    set path [::importDecimalTest::metadata idec-predictor.pdf \
        "/Filter /FlateDecode /DecodeParms << $parms >>" \
        [::importDecimalTest::predicted $xmp $columns]]
    lappend result [::importDecimalTest::outcome {
      expr {[::tclpdf::pdf metadata $path] eq $xmp}
    }]
    file delete $path
  }
  set result
} -result {{ok 1} {ok 1} {ok 1} {ok 1} {ok 1}}

test importDecimal-6.2 {fax parameters with zeros: /K, /Columns and /Rows} -body {
  # Ten rows of a white line ten pixels wide, coded G4 (K < 0): one vertical
  # V0 code per row. With /Columns 010 read as eight the rows came out one
  # byte wide and with /Rows 010 two short.
  set data [binary format B* 1111111111000000]
  set result {}
  foreach parms {{/K -1 /Columns 10 /Rows 10} {/K -01 /Columns 010 /Rows 010}} {
    set path [::importDecimalTest::metadata idec-ccitt.pdf \
        "/Filter /CCITTFaxDecode /DecodeParms << $parms >>" $data]
    binary scan [::tclpdf::pdf metadata $path] H* hex
    lappend result $hex
    file delete $path
  }
  list [expr {[lindex $result 0] eq [lindex $result 1]}] [lindex $result 1]
} -result {1 ffc0ffc0ffc0ffc0ffc0ffc0ffc0ffc0ffc0ffc0}

test importDecimal-6.3 {a /Length padded to ten digits stays readable} -body {
  # The pattern of a real invoice: /Length 0000001355. It was read right
  # before - the /Length has had its own decimal reader since 2026-08-27 -
  # and has to stay so.
  set path [::tclpdfTest::buildpdf idec-length.pdf [list \
      "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Contents 4 0 R /Resources << >> >>" \
      "<< /Length 0000000023 >>\nstream\n0 0 1 rg 0 0 10 10 re f\nendstream"]]
  set result [::importDecimalTest::outcome {
    ::importDecimalTest::imported $path 1
  }]
  file delete $path
  set result
} -result {ok 612.0}

#
# --- what pdf info answers --------------------------------------------------
#

test importDecimal-7.1 {pdf info shows a number as the number it read} -body {
  set path [::tclpdfTest::buildpdf idec-info.pdf [list \
      "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count 01 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 0612 0792\]\
          /Resources << >> >>" \
      "<< /Title (007) /Custom 010 >>"] "/Info 4 0 R"]
  set info [::tclpdf::pdf info $path]
  file delete $path
  # The title is TEXT and keeps its zeros; the number does not.
  list [dict get $info pages] [dict get $info size] [dict get $info info]
} -result {1 {612 792} {Title 007 Custom 10}}

test importDecimal-7.2 {the encryption numbers of a trailer, read in decimal} -body {
  set path [::tclpdfTest::buildpdf idec-encrypt.pdf [list \
      "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Resources << >> >>" \
      "<< /Filter /Standard /V 05 /R 06 /Length 0256 /P -01 >>"] \
      "/Encrypt 4 0 R /ID \[<00> <00>\]"]
  set encryption [dict get [::tclpdf::pdf info $path] encryption]
  file delete $path
  lmap key {v r length p} {dict get $encryption $key}
} -result {5 6 256 -1}

#
# --- what an import copies --------------------------------------------------
#

test importDecimal-8.1 {a copied object carries the number, a copied stream its bytes} -body {
  # The price of reading in one place, measured: an object the import copies
  # is written back from the number it read, so "/LW 010" leaves as
  # "/LW 10" - the same number (7.3.3). A content stream is copied byte for
  # byte and keeps "010".
  set path [::tclpdfTest::buildpdf idec-copy.pdf [list \
      "<< /Type /Catalog /Pages 2 0 R >>" \
      "<< /Type /Pages /Count 1 /Kids \[3 0 R\] >>" \
      "<< /Type /Page /Parent 2 0 R /MediaBox \[0 0 612 792\]\
          /Contents 4 0 R /Resources << /ExtGState << /G 5 0 R >> >> >>" \
      "<< /Length 23 >>\nstream\n/G gs 0 0 m 010 010 l S\nendstream" \
      "<< /Type /ExtGState /LW 010 /CA 00.5 >>"]]
  set doc [tclpdf new -unit pt -compress 0]
  $doc page add
  $doc pdf import f $path
  $doc form place f -at {0 0}
  set out [::tclpdfTest::scratch idec-copy-out.pdf]
  $doc write $out
  $doc destroy
  set bytes [::tclpdfTest::readBytes $out]
  file delete $path $out
  list [lindex [regexp -inline {/LW [0-9]+ /CA [0-9.]+} $bytes] 0] \
      [string match {*0 0 m 010 010 l S*} $bytes]
} -result {{/LW 10 /CA 0.5} 1}

#
# --- a certification read with zeros -----------------------------------------
#

test importDecimal-9.1 {DocMDP /P 01 forbids every change, as /P 1 does} -body {
  # 12.8.4.2, Table 257: /P 1 permits no change at all, and [sign add]
  # refuses such a file. The refusal compares the value as text, so it rests
  # on the reader handing over "1" for "01" - a file could otherwise step
  # around it with one digit. /P 02 allows a further signature, as /P 2 does.
  set result {}
  foreach p {01 02} {
    set doc [tclpdf new -unit mm -version 2.0]
    $doc page add
    set path [::tclpdfTest::scratch idec-docmdp-$p.pdf]
    $doc write $path
    $doc destroy
    set upd [::tclpdf::update open $path]
    set signature [$upd add "<< /Type /Sig /Filter /Adobe.PPKLite\
        /SubFilter /adbe.pkcs7.detached /ByteRange \[0 100 200 300\]\
        /Contents <3081> /Reference \[<< /Type /SigRef /TransformMethod /DocMDP\
        /TransformParams << /Type /TransformParams /P $p /V /1.2 >> >>\] >>"]
    set catalog [$upd trailer Root]
    regexp {^\s*([0-9]+)} $catalog -> number
    set body [$upd body $number]
    $upd replace $number [string map [list ">>" \
        "/Perms << /DocMDP [$upd ref $signature] >> >>"] $body]
    $upd write
    $upd destroy
    # The file really carries the zero: otherwise this test proves nothing.
    set written [string match "*/P $p /V*" [::tclpdfTest::readBytes $path]]
    set size [file size $path]
    set code [catch {::tclpdf::sign add $path -size 256} message]
    lappend result $written $code \
        [expr {$code ? [lrange $::errorCode 0 3] : {}}] \
        [expr {[file size $path] > $size}]
    file delete $path
  }
  set result
} -result {1 1 {TCLPDF SIGN STATE certified} 0 1 0 {} 1}

cleanupTests

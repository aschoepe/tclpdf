# ua.test --
#
# PDF/UA - the accessibility claim, and the refusals that keep it honest.
#
# The interesting half of this module is what it does NOT let through. A claim
# that a document is accessible is invisible in the file to anyone who does
# not run a validator, so every check here exists because the alternative is a
# document that says it is accessible and is not.
#
# Which is also why the negative tests outnumber the positive ones: writing
# the pdfuaid schema is two lines, and deciding whether it may be written is
# the module.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#
# See the file "license.terms" for information on usage and redistribution
# of this file (MIT License).

package require tcltest 2.2
namespace import -force tcltest::*

package require tclpdf
package require tclpdf::ua
source [file join [file dirname [info script]] helper.tcl]

set here [file dirname [file dirname [file normalize [info script]]]]
set face [file join $here examples assets fonts DejaVuSans.ttf]
testConstraint haveFace [file exists $face]

# A document that meets every UA-1 requirement, as the starting point the
# negative tests take one thing away from.
proc accessible {face} {
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc info Title "Sicherheitsunterweisung 2026"
  $doc language de-DE
  $doc page add
  $doc font embed face $face
  $doc font -family face -size 12
  $doc structure H1 -script {
    uplevel 1 [list $doc text "Ueberschrift" -at {20 20}]
  }
  return $doc
}

# --- the claim ------------------------------------------------------------

test ua-1.1 {the claim reaches the XMP packet} -constraints haveFace -body {
  set doc [accessible $face]
  $doc ua 1
  set path [::tclpdfTest::scratch ua-claim.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # part 1 and no rev: UA-1 has no revision, and one would be a claim to
  # something else.
  list [regexp {<pdfuaid:part>1</pdfuaid:part>} $bytes] \
      [regexp {pdfuaid:rev} $bytes] \
      [regexp {xmlns:pdfuaid="http://www.aiim.org/pdfua/ns/id/"} $bytes]
} -result {1 0 1}

test ua-1.2 {DisplayDocTitle is set, not demanded} -constraints haveFace -body {
  # The one requirement the writer can meet by itself: it moves nothing on
  # any page, so asking the caller to write it out would be ceremony.
  set doc [accessible $face]
  $doc ua 1
  set path [::tclpdfTest::scratch ua-viewer.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  regexp {/ViewerPreferences << /DisplayDocTitle true >>} $bytes
} -result 1

test ua-1.3 {the state answers what was declared} -constraints haveFace -body {
  set doc [accessible $face]
  $doc ua 1
  set one [dict get [$doc ua state] part]
  $doc ua -part 1 -revision 2014
  set revision [dict get [$doc ua state] revision]
  $doc ua 0
  set off [$doc ua state]
  $doc destroy
  list $one $revision $off
} -result {1 2014 {}}

# --- what is refused ------------------------------------------------------

test ua-2.1 {a document without a tree cannot claim it} -body {
  set doc [tclpdf new -unit mm]
  $doc info Title "T"
  $doc language de-DE
  $doc page add
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-untagged.pdf]} err]
  $doc destroy
  list $code [string match "*not tagged*" $err]
} -result {1 1}

test ua-2.2 {a document without a title cannot claim it} -constraints haveFace -body {
  set doc [accessible $face]
  $doc info Title ""
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-title.pdf]} err]
  $doc destroy
  list $code [string match "*no title*" $err]
} -result {1 1}

test ua-2.3 {a document without a language cannot claim it} -constraints haveFace -body {
  # Built by hand rather than through [accessible], because [language] with
  # no argument READS the tag - there is no way to take one back.
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc info Title "T"
  $doc page add
  $doc font embed face $face
  $doc font -family face
  $doc text "x" -at {20 20}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-lang.pdf]} err]
  $doc destroy
  list $code [string match "*no language*" $err]
} -result {1 1}

test ua-2.4 {a standard font cannot be used at all} -body {
  # PDF/A leaves the standard 14 exempt; PDF/UA does not (7.21.4 Note 5).
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc info Title "T"
  $doc language de-DE
  $doc page add
  $doc font -family helvetica
  $doc text "x" -at {20 20}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-font.pdf]} err]
  $doc destroy
  list $code [string match "*no font program*" $err] \
      [string match "*Helvetica*" $err]
} -result {1 1 1}

test ua-2.5 {Symbol and ZapfDingbats are named as hopeless} -body {
  # The other twelve can be replaced by an embeddable face; these two have no
  # embeddable representative at all, and saying so saves a search that has
  # no result.
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc info Title "T"
  $doc language de-DE
  $doc page add
  $doc font -family zapfdingbats
  $doc text "4" -at {20 20}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-dingbats.pdf]} err]
  $doc destroy
  list $code [string match "*no document using them can claim PDF/UA*" $err]
} -result {1 1}

test ua-2.6 {every problem is reported, not the first} -body {
  # A caller fixing five problems in five write-and-read rounds is the
  # failure mode this avoids.
  set doc [tclpdf new -unit mm]
  $doc page add
  $doc font -family helvetica
  $doc text "x" -at {20 20}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-all.pdf]} err]
  $doc destroy
  list $code [regexp {4 reasons} $err] [string match "*no title*" $err] \
      [string match "*not tagged*" $err]
} -result {1 1 1 1}

# --- headings -------------------------------------------------------------

test ua-3.1 {the first heading has to be an H1} -constraints haveFace -body {
  set doc [tclpdf new -unit mm]
  $doc tagged 1
  $doc info Title "T"
  $doc language de-DE
  $doc page add
  $doc font embed face $face
  $doc font -family face
  $doc structure H3 -script {$doc text "x" -at {20 20}}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-h3.pdf]} err]
  $doc destroy
  list $code [string match "*first heading is an H3*" $err]
} -result {1 1}

test ua-3.2 {no level may be skipped} -constraints haveFace -body {
  set doc [accessible $face]
  $doc structure H3 -script {$doc text "y" -at {20 40}}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-skip.pdf]} err]
  $doc destroy
  list $code [string match "*jumps from H1 to H3*" $err]
} -result {1 1}

test ua-3.3 {a descent and a return are both fine} -constraints haveFace -body {
  # H1 H2 H3 H2 H3 is a normal document: going back UP is not a skip, and a
  # check that only ever compared with the previous level would refuse it.
  set doc [accessible $face]
  set y 40
  foreach level {H2 H3 H2 H3} {
    $doc structure $level -script [list $doc text "x" -at [list 20 $y]]
    incr y 10
  }
  $doc ua 1
  set path [::tclpdfTest::scratch ua-descent.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  list $code [expr {$code ? $err : {}}]
} -result {0 {}}

# --- tables ---------------------------------------------------------------

test ua-4.1 {a regular table passes} -constraints haveFace -body {
  set doc [accessible $face]
  # -style is not optional: a table has a font state of its own and it
  # defaults to Helvetica, which no UA document may use.
  $doc table -at {20 60} -width 100 -style {family face} \
      -headStyle {family face} -head {{A B C}} -body {{1 2 3} {4 5 6}}
  $doc ua 1
  set path [::tclpdfTest::scratch ua-table.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  list $code [expr {$code ? $err : {}}]
} -result {0 {}}

test ua-4.2 {a spanning cell keeps the grid regular, an irregular table is refused} -constraints haveFace -body {
  # Until 2026-08-18 this test pinned the opposite: a table with a colSpan
  # was refused as "rows of 2 and 3 cells". The rule counts COLUMNS, spans
  # included (Matterhorn 15-003, UA-2 8.2.5.26), and veraPDF passes such a
  # table - the cell holding "1" covers two columns, so every row covers
  # three. What is refused is a table whose rows differ that way too.
  set doc [accessible $face]
  $doc table -at {20 60} -width 100 -style {family face} \
      -headStyle {family face} -head {{A B C}} \
      -body {{{text 1 colSpan 2} 3} {{text 4 rowSpan 2} 5 6} {7 8}}
  $doc ua 1
  set path [::tclpdfTest::scratch ua-span.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  set doc [accessible $face]
  $doc structure Table -script {
    $doc structure TR -script {
      foreach x {A B C} {$doc structure TH -scope Column -script {$doc text $x -at {20 60}}}
    }
    $doc structure TR -script {
      foreach x {a b} {$doc structure TD -script {$doc text $x -at {20 70}}}
    }
  }
  $doc ua 1
  set irregular [catch {$doc write [::tclpdfTest::scratch ua-irregular.pdf]} err2]
  $doc destroy
  list $code [expr {$code ? $err : {}}] $irregular \
      [string match "*table 1 has rows of 2 and 3 columns*spans counted*" $err2]
} -result {0 {} 1 1}

test ua-4.3 {a head cell says which way it heads} -constraints haveFace -body {
  # Scope Column and only that: tclpdf's head is a row above the body, so
  # every cell in it heads a column. There is no way to say "this COLUMN is
  # the header", and guessing one from the first cell would be a guess.
  set doc [accessible $face]
  $doc table -at {20 60} -width 100 -style {family face} \
      -headStyle {family face} -head {{A B}} -body {{1 2}}
  set path [::tclpdfTest::scratch ua-scope.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {/O /Table\s*/Scope /Column} $bytes] \
      [regexp {/S /TD[^>]*/Scope} $bytes]
} -result {2 0}

# --- part 2 ---------------------------------------------------------------

test ua-5.1 {part 2 raises the file version and names the namespace} \
    -constraints haveFace -body {
  set doc [accessible $face]
  $doc ua -part 2
  set path [::tclpdfTest::scratch ua-two.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [string match "%PDF-2.0*" $bytes] \
      [regexp {<pdfuaid:part>2</pdfuaid:part>} $bytes] \
      [regexp {<pdfuaid:rev>2024</pdfuaid:rev>} $bytes] \
      [regexp {/Type /Namespace} $bytes] \
      [regexp {/NS \d+ 0 R} $bytes]
} -result {1 1 1 1 1}

test ua-5.2 {the 1.7-only types keep the default namespace} \
    -constraints haveFace -body {
  # Twelve types exist ONLY in the 1.7 namespace (TS 32005 Tab. 2/3). Naming
  # the 2.0 namespace on one of them would be a claim about a type that does
  # not exist there.
  set doc [accessible $face]
  $doc structure Code -script {$doc text "x = 1" -at {20 40}}
  $doc ua -part 2
  set path [::tclpdfTest::scratch ua-only17.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  # The Code element carries no NS, the H1 next to it does.
  list [regexp {/S /Code(?![^>]*/NS)} $bytes] [regexp {/S /H1[^>]*} $bytes]
} -result {1 1}

test ua-5.3 {part 2 and PDF/A-3 are mutually exclusive} -constraints haveFace -body {
  # PDF/A-3 is a 1.7 format and UA-2 needs 2.0. Said at the call that creates
  # the contradiction, whichever way round the two were declared.
  set doc [accessible $face]
  $doc pdfa -part 3 -conformance A
  set code [catch {$doc ua -part 2} err]
  $doc destroy
  list $code [string match "*cannot be claimed by one file*" $err]
} -result {1 1}

test ua-5.4 {the generic H is refused under part 2 only} -constraints haveFace -body {
  # H means "a heading at whatever level the nesting implies", and 2.0
  # dropped it. Under part 1 it stays legal.
  set doc [accessible $face]
  $doc structure H -script {$doc text "x" -at {20 40}}
  $doc ua 1
  set one [catch {$doc write [::tclpdfTest::scratch ua-h1ok.pdf]}]
  $doc ua -part 2
  set two [catch {$doc write [::tclpdfTest::scratch ua-h2no.pdf]} err]
  $doc destroy
  file delete [::tclpdfTest::scratch ua-h1ok.pdf]
  list $one $two [string match "*generic H*" $err]
} -result {0 1 1}

test ua-5.5 {an attachment without a description fails part 2 only} \
    -constraints haveFace -body {
  set doc [accessible $face]
  $doc attach [info script] -name probe.tcl
  $doc ua 1
  set one [catch {$doc write [::tclpdfTest::scratch ua-att1.pdf]}]
  $doc ua -part 2
  set two [catch {$doc write [::tclpdfTest::scratch ua-att2.pdf]} err]
  $doc destroy
  file delete [::tclpdfTest::scratch ua-att1.pdf]
  list $one $two [string match "*Desc on every file specification*" $err]
} -result {0 1 1}

test ua-5.6 {PDF/A after part 2 is refused, naming the way out} -body {
  # The other direction of ua-5.3. Until 2026-08-15 only ua.tcl checked:
  # [ua -part 2] then [pdfa -part 3] was accepted and produced a PDF 2.0
  # file with a PDF/A-3 claim - two standards, one file, both wrong.
  set doc [tclpdf new]
  $doc ua -part 2
  set code [catch {$doc pdfa -part 3 -conformance B} err]
  $doc destroy
  list $code [string match "*cannot be claimed by one file*" $err] \
      [string match "*ua 1 with pdfa -part 3*" $err]
} -result {1 1 1}

test ua-5.7 {a document configured to PDF 2.0 cannot claim PDF/A} -body {
  # The version can reach 2.0 without ua at all, so the guard has to read
  # the writer, not only the ua state.
  set doc [tclpdf new]
  $doc configure -version 2.0
  set code [catch {$doc pdfa -part 3 -conformance B} err]
  $doc destroy
  list $code [string match "*PDF/A-3 is a PDF 1.7 format*" $err] \
      [string match "*2.0*" $err]
} -result {1 1 1}

test ua-5.10 {part 1 on a file raised to 2.0 is refused at write time, naming the way out} -constraints haveFace -body {
  # ua -part 1 lifts the file to 1.7 and does not cap it - a document may
  # still move on to part 2, which needs 2.0. So a part-1 claim on a 2.0
  # file is caught where the other claims are checked: at write time.
  # veraPDF ua1 fails such a file on ISO 14289-1 6.1-1 (measured 2026-08-17).
  set doc [tclpdf new]
  $doc tagged 1
  $doc info Title "UA on 2.0"
  $doc language en
  $doc font embed face $face
  $doc font -family face
  $doc page add
  $doc text "hello" -at {20 20}
  $doc ua -part 1 -revision 2014
  $doc configure -version 2.0
  set code [catch {$doc write [::tclpdfTest::scratch ua-2.0.pdf]} err]
  $doc configure -version 1.7
  lassign [::tclpdfTest::writes $doc ua-1.7.pdf] again written
  $doc destroy
  list $code [string match "*PDF/UA-1 is a PDF 1.7 format*" $err] \
      [string match "*part 2 instead*" $err] $again $written
} -result {1 1 1 0 1}

test ua-5.8 {ua 1 with pdfa -part 3 stays the ZUGFeRD combination} -body {
  # The guard must not overreach: part 1 rides the 1.7 path and is exactly
  # what an accessible invoice declares.
  set doc [tclpdf new]
  $doc ua 1
  set code [catch {$doc pdfa -part 3 -conformance B} state]
  set part [expr {$code ? "-" : [dict get $state part]}]
  $doc destroy
  list $code $part
} -result {0 3}

test ua-5.9 {pdfa alone is untouched by the guard} -body {
  # pdfa raises the version to 1.7 itself; the guard reads the version
  # before that raise and must not mistake one for the other.
  set doc [tclpdf new]
  set code [catch {$doc pdfa -part 3 -conformance B} state]
  set second [catch {$doc pdfa -part 2} state2]
  $doc destroy
  list $code $second [dict get $state2 part]
} -result {0 0 2}

# --- WTPDF ----------------------------------------------------------------

test ua-6.1 {the declaration carries both spellings of the identifier} \
    -constraints haveFace -body {
  # WTPDF 1.0 writes the URI with a slash before the hash in all four places
  # it names it; veraPDF 1.30.2 tests for the form without one. Both are
  # written - the mechanism explicitly allows several claims, and neither is
  # a false statement about the document.
  set doc [accessible $face]
  $doc ua -part 2 -wtpdf accessibility
  set path [::tclpdfTest::scratch ua-wtpdf.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {declarations/wtpdf/#accessibility1\.0} $bytes] \
      [regexp {declarations/wtpdf#accessibility1\.0} $bytes] \
      [regexp {rdf:parseType="Resource"} $bytes] \
      [regexp {reuse1\.0} $bytes]
} -result {1 1 1 0}

test ua-6.2 {WTPDF belongs to part 2, and an unknown level is named} \
    -constraints haveFace -body {
  set doc [accessible $face]
  set wrongPart [catch {$doc ua -part 1 -wtpdf accessibility} first]
  set wrongLevel [catch {$doc ua -part 2 -wtpdf sideways} second]
  $doc destroy
  list $wrongPart [string match "*goes with PDF/UA-2*" $first] \
      $wrongLevel [string match "*reuse and accessibility*" $second]
} -result {1 1 1 1}

test ua-6.3 {no declaration means no empty description} -constraints haveFace -body {
  # An empty contribution is left out of the packet rather than written as a
  # description with nothing in it.
  set doc [accessible $face]
  $doc ua -part 2
  set path [::tclpdfTest::scratch ua-nodecl.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {pdfd:} $bytes] [regexp {<pdfuaid:part>2</pdfuaid:part>} $bytes]
} -result {0 1}

# --- links ----------------------------------------------------------------

test ua-7.1 {a link without a description is refused} -constraints haveFace -body {
  # A reader announces a link by its Contents (7.18.5). Without one it says
  # "link" and stops, which is the whole of what the user learns.
  set doc [accessible $face]
  $doc structure Link -script {
    $doc text "tcl.tk" -at {20 40}
    $doc link -at {20 36} -size {20 6} -url https://www.tcl.tk/
  }
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-link.pdf]} err]
  $doc destroy
  list $code [string match "*without a description*" $err] \
      [string match "*-tooltip*" $err]
} -result {1 1 1}

test ua-7.2 {a link with a tooltip passes and joins the tree} -constraints haveFace -body {
  set doc [accessible $face]
  $doc structure Link -script {
    $doc text "tcl.tk" -at {20 40}
    $doc link -at {20 36} -size {20 6} -url https://www.tcl.tk/ \
        -tooltip "Zur Tcl-Startseite"
  }
  $doc ua 1
  set path [::tclpdfTest::scratch ua-link-ok.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  set bytes [expr {$code ? {} : [::tclpdfTest::readBytes $path]}]
  file delete $path
  list $code [regexp {/Type /OBJR} $bytes] [regexp {/Contents \(Zur} $bytes]
} -result {0 1 1}

test ua-8.1 {a document claiming both standards describes the pdfuaid schema} \
    -constraints haveFace -body {
  # PDF/A allows only the predefined XMP schemas unless the file describes
  # the others itself (ISO 19005, 6.6.2.3.1). pdfuaid is not predefined, so a
  # document making both claims has to carry an extension schema description
  # - without it veraPDF refuses the PDF/A claim, once per property, while
  # the PDF/UA claim passes.
  set doc [accessible $face]
  $doc pdfa -part 3 -conformance A
  $doc ua 1
  set path [::tclpdfTest::scratch ua-extension.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {pdfaSchema:prefix>pdfuaid<} $bytes] \
      [regexp {pdfaProperty:name>part<} $bytes] \
      [regexp {pdfaProperty:name>rev<} $bytes] \
      [regexp {pdfaSchema:namespaceURI>http://www.aiim.org/pdfua/ns/id/<} $bytes]
} -result {1 1 1 1}

# --- what the 2.0 path spells differently ---------------------------------

test ua-9.1 {the date drops its trailing apostrophe in a 2.0 file} \
    -constraints haveFace -body {
  # ISO 32000-2 struck the apostrophe after the offset minutes (7.9.4).
  # Readers take both, but a file should spell its own version - so the
  # version decides, not a global choice.
  set one [accessible $face]
  $one ua 1
  set pathOne [::tclpdfTest::scratch ua-date17.pdf]
  $one write $pathOne
  $one destroy
  set two [accessible $face]
  $two ua -part 2
  set pathTwo [::tclpdfTest::scratch ua-date20.pdf]
  $two write $pathTwo
  $two destroy
  set bytesOne [::tclpdfTest::readBytes $pathOne]
  set bytesTwo [::tclpdfTest::readBytes $pathTwo]
  file delete $pathOne $pathTwo
  list [regexp {/CreationDate \(D:\d+[-+]\d\d'\d\d'\)} $bytesOne] \
      [regexp {/CreationDate \(D:\d+[-+]\d\d'\d\d\)} $bytesTwo]
} -result {1 1}

test ua-9.2 {a running head and a page number name their artifact subtype} -body {
  # UA-1 7.8 wants Pagination WITH a subtype. The page number knows its own -
  # above the middle of the page it is a head, below it a foot - and a caller
  # writing their own says so through -tag.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  $doc text "Inhalt" -at {20 40}
  $doc text "Kopfzeile" -at {20 10} -tag {Artifact Pagination Header}
  $doc pageNumbers -at {105 285} -align center -size 8 -format "Seite %n"
  set path [::tclpdfTest::scratch ua-running.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Artifact <</Type /Pagination /Subtype /Header>>} $bytes] \
      [regexp {/Artifact <</Type /Pagination /Subtype /Footer>>} $bytes]
} -result {1 1}

test ua-9.3 {a page number at the top is a head, at the bottom a foot} -body {
  # The subtype comes from the position, so the same call at the other end of
  # the page has to answer differently - otherwise it is a constant dressed
  # up as a measurement.
  set doc [tclpdf new -unit mm -compress 0]
  $doc tagged 1
  $doc page add
  $doc text "x" -at {20 40}
  $doc pageNumbers -at {105 12} -align center -size 8 -format "%n"
  set path [::tclpdfTest::scratch ua-runhead.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {/Subtype /Header} $bytes] [regexp {/Subtype /Footer} $bytes]
} -result {1 0}

# --- graphics -------------------------------------------------------------
#
# A picture, a drawing or a form placement without -alt is an artifact, and
# an artifact carries content past a reader entirely. PDF/UA allows that for
# decoration only (7.1), so a graphic that fell into it by default - nobody
# said -alt, nobody said -artifact 1 - is an open question, and the claim is
# not made over one. A form is used here because it needs no file; the fact
# comes from [undescribedGraphics], and image.test, svg.test and xObject.test
# show that all three kinds fill it.

test ua-10.1 {a graphic nobody described or declared decoration is refused} \
    -constraints haveFace -body {
  set doc [accessible $face]
  $doc form create block -size {40 20} -script {
    $doc rect -at {0 0} -size {40 20} -fill steelblue
  }
  $doc page add
  $doc form place block -at {20 40}
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-graphic.pdf]} err]
  $doc destroy
  # Page 2, counted from 1 as a caller counts; the kind is named.
  list $code [string match "*page 2: a form was placed without -alt and\
      without -artifact 1*" $err] [string match "*-artifact 1*" $err]
} -result {1 1 1}

test ua-10.2 {described or declared decoration, and the claim stands} \
    -constraints haveFace -body {
  # Both answers are fine - it is the absence of any that is refused.
  set doc [accessible $face]
  $doc form create block -size {40 20} -script {
    $doc rect -at {0 0} -size {40 20} -fill steelblue
  }
  $doc form place block -at {20 40} -alt "Ein blauer Block"
  $doc form place block -at {20 70} -artifact 1
  $doc ua 1
  set path [::tclpdfTest::scratch ua-graphic-ok.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  list $code [expr {$code ? $err : {}}]
} -result {0 {}}

test ua-10.3 {a drawing is named as one, and every one is listed} \
    -constraints haveFace -body {
  # One message per graphic, not one for all: each names its own page, and
  # two on different pages are two calls to change.
  set dot {<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10">
    <circle cx="5" cy="5" r="4" fill="red"/></svg>}
  set doc [accessible $face]
  $doc svg -data $dot -at {20 40} -width 10
  $doc page add
  $doc svg -data $dot -at {20 40} -width 10
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-drawing.pdf]} err]
  $doc destroy
  list $code [string match "*page 1: a drawing was placed*" $err] \
      [string match "*page 2: a drawing was placed*" $err]
} -result {1 1 1}

# --- lists ----------------------------------------------------------------
#
# ListNumbering is mandatory on an ordered list (7.6), and it has to agree
# with the tree: a list numbered Decimal whose items carry no Lbl claims
# numbers that are not there, and items with a Lbl under a list that says
# nothing leave the reader guessing what the labels are (Matterhorn 16-001).

test ua-11.1 {a numbered list whose items carry no Lbl is refused} \
    -constraints haveFace -body {
  set doc [accessible $face]
  $doc structure L -numbering Decimal -script {
    $doc structure LI -script {$doc text "erstens" -at {20 40}}
    $doc structure LI -script {$doc text "zweitens" -at {20 46}}
  }
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-list-nolbl.pdf]} err]
  $doc destroy
  list $code [string match "*list 1 is numbered Decimal but 2 of its 2 items\
      carry no Lbl*" $err] [string match "*structure Lbl*" $err]
} -result {1 1 1}

test ua-11.2 {items with a Lbl under a list that says nothing are refused} \
    -constraints haveFace -body {
  set doc [accessible $face]
  $doc structure L -script {
    $doc structure LI -script {
      $doc structure Lbl -script {$doc text "1." -at {20 40}}
      $doc structure LBody -script {$doc text "erstens" -at {28 40}}
    }
  }
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-list-nonum.pdf]} err]
  $doc destroy
  list $code [string match "*list 1: its items carry a Lbl but the list says\
      no -numbering*" $err] [string match "*or None*" $err]
} -result {1 1 1}

test ua-11.3 {the three honest shapes of a list all pass} -constraints haveFace -body {
  # Numbered with labels; None with labels, which is what a list of arbitrary
  # markers says; and no numbering with no labels, the plain unordered case
  # from example 5.6.
  set doc [accessible $face]
  $doc structure L -numbering Decimal -script {
    $doc structure LI -script {
      $doc structure Lbl -script {$doc text "1." -at {20 40}}
      $doc structure LBody -script {$doc text "erstens" -at {28 40}}
    }
  }
  $doc structure L -numbering None -script {
    $doc structure LI -script {
      $doc structure Lbl -script {$doc text "*" -at {20 50}}
      $doc structure LBody -script {$doc text "Anmerkung" -at {28 50}}
    }
  }
  $doc structure L -script {
    $doc structure LI -script {$doc text "ohne Marke" -at {20 60}}
  }
  $doc ua 1
  set path [::tclpdfTest::scratch ua-list-ok.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  file delete $path
  list $code [expr {$code ? $err : {}}]
} -result {0 {}}

test ua-11.4 {a single unlabelled item is counted, not the whole list} \
    -constraints haveFace -body {
  # The message says how many of how many, so a caller with a long list
  # knows whether to look for one item or rewrite all of them.
  set doc [accessible $face]
  $doc structure L -numbering LowerAlpha -script {
    $doc structure LI -script {
      $doc structure Lbl -script {$doc text "a)" -at {20 40}}
      $doc structure LBody -script {$doc text "eins" -at {28 40}}
    }
    $doc structure LI -script {$doc text "zwei" -at {28 46}}
    $doc structure LI -script {
      $doc structure Lbl -script {$doc text "c)" -at {20 52}}
      $doc structure LBody -script {$doc text "drei" -at {28 52}}
    }
  }
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-list-one.pdf]} err]
  $doc destroy
  list $code [string match "*numbered LowerAlpha but 1 of its 3 items carries\
      no Lbl*" $err]
} -result {1 1}

# --- the revision year ----------------------------------------------------

test ua-12.1 {-revision is a four-digit year, and nothing else} -body {
  # pdfuaid:rev is the year of the edition claimed (ISO 14289-2 Table 1).
  # Until 2026-08-15 any value was written into the metadata as given.
  set doc [tclpdf new]
  set short [catch {$doc ua -part 2 -revision 24} first]
  set word [catch {$doc ua -part 2 -revision latest} second]
  set untouched [$doc ua state]
  set ok [catch {$doc ua -part 2 -revision 2024} state]
  $doc destroy
  list $short [string match "*four-digit year, not \"24\"*" $first] \
      $word [string match "*not \"latest\"*" $second] $untouched \
      $ok [dict get $state revision]
} -result {1 1 1 1 {} 0 2024}

# --- DisplayDocTitle ------------------------------------------------------

test ua-13.1 {DisplayDocTitle taken back after the claim is refused} \
    -constraints haveFace -body {
  # [ua] sets it and cannot see a later [viewerPreferences] call; the write
  # reads the finished preferences and names the call.
  set doc [accessible $face]
  $doc ua 1
  $doc viewerPreferences -displayDocTitle 0
  set code [catch {$doc write [::tclpdfTest::scratch ua-doctitle.pdf]} err]
  $doc destroy
  list $code [string match "*viewerPreferences -displayDocTitle must stay 1\
      under PDF/UA (7.1)*" $err]
} -result {1 1}

test ua-13.2 {other preferences after the claim leave it standing} \
    -constraints haveFace -body {
  # A later call that touches something else keeps DisplayDocTitle - the
  # module merges rather than resets - and the check has to see that.
  set doc [accessible $face]
  $doc ua 1
  $doc viewerPreferences -fitWindow 1 -duplex DuplexFlipLongEdge
  set path [::tclpdfTest::scratch ua-doctitle-ok.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  set bytes [expr {$code ? {} : [::tclpdfTest::readBytes $path]}]
  file delete $path
  list $code [regexp {/DisplayDocTitle true} $bytes] [regexp {/FitWindow true} $bytes]
} -result {0 1 1}

# --- reuse alone, and what state reports -----------------------------------

test ua-14.1 {-wtpdf reuse writes the reuse declaration and not the other} \
    -constraints haveFace -body {
  # ua-6.1 covers accessibility; reuse is the other level of WTPDF 6.1.2, and
  # a document that claims it has not claimed accessibility.
  set doc [accessible $face]
  $doc ua -part 2 -wtpdf reuse
  set path [::tclpdfTest::scratch ua-wtpdf-reuse.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp {declarations/wtpdf/#reuse1\.0} $bytes] \
      [regexp {declarations/wtpdf#reuse1\.0} $bytes] \
      [regexp {accessibility1\.0} $bytes]
} -result {1 1 0}

test ua-14.2 {ua state carries the levels asked for and whether the claim is registered} \
    -constraints haveFace -body {
  # registered is what tells a second call from the first: the catalog and
  # XMP subscribers are added once, and the state says that they have been.
  set doc [accessible $face]
  set before [$doc ua state]
  set state [$doc ua -part 2 -wtpdf {reuse accessibility}]
  set again [$doc ua -part 2 -revision 2024]
  set read [$doc ua state]
  $doc destroy
  list $before [dict get $state wtpdf] [dict get $state registered] \
      [dict get $again wtpdf] [dict get $again registered] \
      [dict get $read wtpdf] [dict get $read registered] \
      [lsort [dict keys $read]]
} -result {{} {reuse accessibility} 1 {reuse accessibility} 1 {reuse accessibility} 1\
    {part registered revision wtpdf}}

test ua-14.3 {without -wtpdf the state says so, and ua 1 has no levels either} -body {
  set doc [tclpdf new]
  set two [$doc ua -part 2]
  $doc destroy
  set doc [tclpdf new]
  set one [$doc ua 1]
  $doc destroy
  list [dict get $two wtpdf] [dict get $one wtpdf] [dict get $one registered]
} -result {{} {} 1}

# --- part 2 through configure, ua 0, the private state key -------------------

test ua-15.1 {part 2 raises the version through configure, and it cannot be lowered again} \
    -constraints haveFace -body {
  # cget answered the old version while the writer was at 2.0, and a later
  # configure -version 1.7 was taken - a %PDF-1.7 file with pdfuaid:part 2.
  set doc [accessible $face]
  $doc ua -part 2
  set version [$doc cget -version]
  set writer [[$doc writer] version]
  set lowered [catch {$doc configure -version 1.7} err]
  set still [[$doc writer] version]
  set path [::tclpdfTest::scratch ua-two-cget.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list $version $writer $lowered [string match "*PDF/UA-2*cannot be lowered to PDF 1.7*" $err] \
      $still [string range $bytes 0 7]
} -result {2.0 2.0 1 1 2.0 %PDF-2.0}

test ua-15.2 {ua 0 withdraws the claim and everything it put there} -constraints haveFace -body {
  # ua 1; ua 0; write died on the empty state, and what ua had set stayed
  # in the file: the schema, DisplayDocTitle, the extension schema.
  set doc [accessible $face]
  $doc ua 1
  $doc ua 0
  set state [$doc ua state]
  set raw [$doc state xmpRaw]
  set preferences [$doc viewerPreferences]
  set path [::tclpdfTest::scratch ua-off.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  set bytes [expr {$code ? $err : [::tclpdfTest::readBytes $path]}]
  file delete $path
  list $state $raw $preferences $code [regexp {pdfuaid} $bytes] [regexp {DisplayDocTitle} $bytes]
} -result {{} {} {} 0 0 0}

test ua-15.3 {a claim withdrawn and made again describes itself once} -constraints haveFace -body {
  # And subscribes once: the catalog subscribers after ua 1 and after
  # ua 1; ua 0; ua 1 are the same in number. (A viewer preference of the
  # caller's own, so that the preferences module - which subscribes once
  # per document on its first key - is already in place and not what is
  # counted here.)
  set doc [accessible $face]
  $doc viewerPreferences -hideToolbar 1
  $doc ua 1
  set once [llength [$doc subscribers catalog]]
  $doc ua 0
  $doc ua 1
  set again [llength [$doc subscribers catalog]]
  set path [::tclpdfTest::scratch ua-again.pdf]
  $doc write $path
  $doc destroy
  set bytes [::tclpdfTest::readBytes $path]
  file delete $path
  list [regexp -all {<pdfuaid:part>1</pdfuaid:part>} $bytes] \
      [regexp -all {<pdfaSchema:prefix>pdfuaid</pdfaSchema:prefix>} $bytes] \
      [regexp -all {xmlns:pdfuaid=} $bytes] [regexp -all {/DisplayDocTitle true} $bytes] \
      [expr {$again - $once}]
} -result {1 1 1 1 0}

test ua-15.4 {ua 0 puts DisplayDocTitle back the way it was} -constraints haveFace -body {
  # Set by the caller before the claim it stays; set by ua alone it goes.
  set doc [accessible $face]
  $doc viewerPreferences -displayDocTitle 1 -hideToolbar 1
  $doc ua 1
  $doc ua 0
  set kept [$doc viewerPreferences]
  $doc destroy
  set doc [accessible $face]
  $doc viewerPreferences -hideToolbar 1
  $doc ua 1
  $doc ua 0
  set gone [$doc viewerPreferences]
  $doc destroy
  list [lsort -stride 2 $kept] $gone
} -result {{displayDocTitle 1 hideToolbar 1} {hideToolbar 1}}

test ua-15.5 {ua 0 after part 2 takes the namespace demand with it} -constraints haveFace -body {
  set doc [accessible $face]
  $doc ua -part 2
  $doc ua 0
  set demand [$doc state structureNamespace]
  set path [::tclpdfTest::scratch ua-two-off.pdf]
  set code [catch {$doc write $path} err]
  $doc destroy
  set bytes [expr {$code ? $err : [::tclpdfTest::readBytes $path]}]
  file delete $path
  # The version stays 2.0 - a fact about the file - and the tree stays in
  # the default namespace, having no 2.0-only type.
  list $demand $code [string range $bytes 0 7] [regexp {/Type /Namespace} $bytes] [regexp {pdfuaid} $bytes]
} -result {{} 0 %PDF-2.0 0 0}

test ua-15.6 {registered is state, not an option} -body {
  set doc [tclpdf new]
  set code [catch {$doc ua -registered 1} err]
  set state [$doc ua state]
  $doc destroy
  list $code [string match {*unknown option "-registered"*} $err] \
      [regexp {known are: -part -revision -wtpdf$} $err] $state
} -result {1 1 1 {}}

# --- Note under part 2, links inside a Link ---------------------------------

test ua-15.7 {Note is refused under part 2, as H is} -constraints haveFace -body {
  set doc [accessible $face]
  $doc structure Note -script {$doc text "n" -at {20 40}}
  $doc ua -part 2
  set code [catch {$doc write [::tclpdfTest::scratch ua-note.pdf]} err]
  $doc destroy
  set doc [accessible $face]
  $doc structure Note -script {$doc text "n" -at {20 40}}
  $doc ua 1
  set path [::tclpdfTest::scratch ua-note1.pdf]
  set one [catch {$doc write $path} err1]
  $doc destroy
  file delete $path
  list $code [string match "*the tree uses Note - PDF/UA-2 wants FENote*8.2.5.14*" $err] $one
} -result {1 1 0}

test ua-15.8 {a link annotation outside a Link element is refused} -constraints haveFace -body {
  # veraPDF ua1 7.18.5-1: the annotation's structure parent has to be a
  # Link. Drawn outside any element it joins none; drawn in a P it joins
  # the P.
  set doc [accessible $face]
  $doc link -at {20 36} -size {20 6} -url https://www.tcl.tk/ -tooltip "t"
  $doc structure P -script {
    $doc text "tcl.tk" -at {20 50}
    $doc link -at {20 46} -size {20 6} -url https://www.tcl.tk/ -tooltip "t"
  }
  $doc ua 1
  set code [catch {$doc write [::tclpdfTest::scratch ua-link-out.pdf]} err]
  $doc destroy
  list $code [string match "*2 link annotations are not inside a Link structure element, on page 1*7.18.5*structure Link*" $err]
} -result {1 1}

test ua-15.9 {part 2 lets a Reference hold the link annotation, part 1 does not} \
    -constraints haveFace -body {
  # ISO 14289-2 8.2.5.20 names Link or Reference; ISO 14289-1 7.18.5 Link.
  set doc [accessible $face]
  $doc structure P -script {
    $doc structure Reference -script {
      $doc text "see" -at {20 50}
      $doc link -at {20 46} -size {20 6} -url https://www.tcl.tk/ -tooltip "t"
    }
  }
  $doc ua 1
  set one [catch {$doc write [::tclpdfTest::scratch ua-link-ref1.pdf]} err1]
  $doc destroy
  set doc [accessible $face]
  $doc structure P -script {
    $doc structure Reference -script {
      $doc text "see" -at {20 50}
      $doc link -at {20 46} -size {20 6} -url https://www.tcl.tk/ -tooltip "t"
    }
  }
  $doc ua -part 2
  set path [::tclpdfTest::scratch ua-link-ref2.pdf]
  set two [catch {$doc write $path} err2]
  $doc destroy
  file delete $path
  list $one [string match "*not inside a Link structure element*" $err1] $two
} -result {1 1 0}

cleanupTests

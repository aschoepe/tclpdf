#
# Tcl package index file
#
# One of THREE lists that have to stay in sync when a module is added. The
# others are TEA_ADD_TCL_SOURCES in configure.ac (otherwise the file is missing
# from "make install" and from the archive) and the module list in
# tests/all.tcl (otherwise the module is untested).
#

# The main package: the frame with the public API. Everything topical is loaded
# lazily by the code that needs it, so this file must never require a module.
package ifneeded @PACKAGE_NAME@ @PACKAGE_VERSION@ \
    [list source [file join $dir @PACKAGE_NAME@.tcl]]

# Nothing is loaded here: [package ifneeded] only files the script away, and
# it runs when that package is first required. The version stands here as well
# as in the module so that Tcl can answer a "package require x 1.1" without
# reading the file - tests/version.test keeps the two in step.

package ifneeded @PACKAGE_NAME@::afm 1.4 [list source [file join $dir afm.tcl]]
package ifneeded @PACKAGE_NAME@::afmData 1.1 [list source [file join $dir afmData.tcl]]

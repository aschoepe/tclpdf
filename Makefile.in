# Makefile.in --
#
#	If ths is "Makefile.in" then it is a template for a Makefile;  to generate 
#	the actual Makefile, run "./configure", which is a configuration script
#	generated by the "autoconf" program (constructs like "@foo@" will get
#	replaced in the actual Makefile.
#
# Copyright (C) 2026 Alexander Schoepe, Bochum, DE
#

#========================================================================
# Nothing of the variables below this line need to be changed.
#========================================================================

SHELL		= @SHELL@

srcdir		= @srcdir@
top_srcdir	= @top_srcdir@
prefix		= @prefix@
exec_prefix	= @exec_prefix@
datarootdir	= @datarootdir@
libdir		= @libdir@
mandir		= @mandir@
bindir		= @bindir@

DESTDIR		=
pkglibdir	= $(libdir)/@PACKAGE_NAME@@PACKAGE_VERSION@
top_builddir	= @abs_top_builddir@

PACKAGE_NAME	= @PACKAGE_NAME@
PACKAGE_VERSION	= @PACKAGE_VERSION@
CYGPATH		= @CYGPATH@

#========================================================================
# TCLLIBPATH seeds the auto_path in Tcl's init.tcl so we can test our
# package without installing.  The other environment variables allow us
# to test against an uninstalled Tcl.  Add special env vars that you
# require for testing here (like TCLX_LIBRARY).
#========================================================================

TCL_BIN_DIR	= @TCL_BIN_DIR@
TCL_SRC_DIR	= @TCL_SRC_DIR@
EXTRA_PATH	= $(top_builddir):$(TCL_BIN_DIR)
TCLLIBPATH	= $(top_builddir)
TCLSH_ENV	= TCL_LIBRARY=`@CYGPATH@ $(TCL_SRC_DIR)/library`
PKG_ENV		= LD_LIBRARY_PATH="$(EXTRA_PATH):$(@LD_LIBRARY_PATH_VAR@)" \
		  PATH="$(EXTRA_PATH):$(PATH)" \
		  TCLLIBPATH="$(TCLLIBPATH)"

TCLSH_PROG	= @TCLSH_PROG@
TCLSH   	= $(PKG_ENV) $(TCLSH_ENV) $(TCLSH_PROG)

PKG_TCL_SOURCES	= @PKG_TCL_SOURCES@

CONFIG_CLEAN_FILES = Makefile pkgIndex.tcl manifest.txt
CLEANFILES	= @CLEANFILES@

HAVE_PANDOC	= @HAVE_PANDOC@

#========================================================================
# Start of user-definable TARGETS section
#========================================================================

# Keep the generated build files in sync with their templates, so that
# e.g. a version bump in configure.ac propagates automatically before
# any target is built (GNU make re-executes itself after remaking the
# Makefile).

$(srcdir)/configure: $(srcdir)/configure.ac
	cd $(srcdir) && autoconf

config.status: $(srcdir)/configure
	./config.status --recheck

Makefile: $(srcdir)/Makefile.in config.status
	./config.status Makefile

pkgIndex.tcl: $(srcdir)/pkgIndex.tcl.in config.status
	./config.status pkgIndex.tcl

manifest.txt: $(srcdir)/manifest $(srcdir)/manifest.uuid $(srcdir)/tools/mkversion.tcl $(srcdir)/configure.ac
	$(TCLSH) `@CYGPATH@ $(srcdir)/tools/mkversion.tcl` > $@

havepandoc:
	@if test "${HAVE_PANDOC}" != "yes" ; then \
		echo "No pandoc found in the path. Pandoc is needed to" ;\
		echo "build the nroff and html versions of the documentation." ;\
	fi

doc/$(PACKAGE_NAME).html: $(srcdir)/doc/$(PACKAGE_NAME).md
	@if test "${HAVE_PANDOC}" = "yes" ; then \
		mkdir -p doc ;\
		pandoc --template $(srcdir)/doc/$(PACKAGE_NAME)-default.html -f markdown -t html \
			$(srcdir)/doc/$(PACKAGE_NAME).md --css tcl-docs.css -o doc/$(PACKAGE_NAME).html;\
	fi

doc/$(PACKAGE_NAME).n: $(srcdir)/doc/$(PACKAGE_NAME).md
	@if test "${HAVE_PANDOC}" = "yes" ; then \
		mkdir -p doc ;\
		pandoc --standalone -f markdown -t man $(srcdir)/doc/$(PACKAGE_NAME).md \
			-o doc/$(PACKAGE_NAME).n ;\
	fi

doc: havepandoc doc/$(PACKAGE_NAME).html doc/$(PACKAGE_NAME).n

all: havepandoc manifest.txt doc/$(PACKAGE_NAME).html doc/$(PACKAGE_NAME).n

# icc/ is a DIRECTORY argument and keeps its name: the package looks for the
# output intent profile at [file join $dir icc sRGB.icc]. It is installed
# because it is a runtime part - its bytes end up inside every PDF/A document.
# examples/ is deliberately NOT installed; it is documentation and travels in
# the source archive only.
install: all
	$(TCLSH) `@CYGPATH@ $(srcdir)/tools/install.tcl` $(PKG_TCL_SOURCES:%=$(srcdir)/%) \
		manifest.txt pkgIndex.tcl $(srcdir)/license.terms $(srcdir)/icc \
		$(DESTDIR)$(pkglibdir)

test:
	$(TCLSH) `@CYGPATH@ $(srcdir)/tests/all.tcl` $(TESTFLAGS) \
	  -load "package ifneeded ${PACKAGE_NAME} ${PACKAGE_VERSION} [list source [file join `@CYGPATH@ $(srcdir)` $(PACKAGE_NAME).tcl]]"

# Run every example and collect the documents in examples/out. Deliberately not
# part of "all": it writes files nothing else needs, and it is the one target
# whose worth lies in LOOKING at the result. Twenty-seven scripts produce
# twenty-nine documents - the language example writes three, one per font
# situation, to show what the standard faces cannot set and what a smaller face
# still can.
#
# Each script takes its output path as the first argument, so nothing is
# written next to the sources. The scripts find the package through
# auto_path relative to their own directory, which means pkgIndex.tcl has to
# sit beside the modules - true for an in-tree build, see TODO item 1 for the
# out-of-tree case.
examples: pkgIndex.tcl
	-rm -rf examples/out
	@mkdir -p examples/out
	@for script in $(srcdir)/examples/[0-9]*.tcl ; do \
	  name=`basename $$script .tcl` ; \
	  echo "== $$name" ; \
	  $(TCLSH) `@CYGPATH@ $$script` examples/out/$$name.pdf || exit 1 ; \
	done
	@echo ""
	@echo "`ls examples/out | wc -l | tr -d ' '` documents in examples/out"

# The full acceptance run: the test suite under every interpreter present, all
# examples, and then the outside validators over what came out - qpdf on every
# document, veraPDF against the profile each document CLAIMS in its own XMP,
# and poppler as a reader rather than a validator.
#
# Separate from "test" on purpose. "make test" needs nothing but a Tcl, runs in
# seconds and belongs in every edit cycle; this one needs three foreign tools
# and takes minutes, and belongs before a check-in. It reports a missing tool
# as SKIPPED and says so again in the summary - a run that silently checked
# less is worse than no run, because it reads like a clean one.
check:
	sh $(srcdir)/tools/check.sh

archive: manifest.txt pkgIndex.tcl
	sh $(srcdir)/tools/archive.sh @PACKAGE_NAME@ @PACKAGE_VERSION@ $(PKG_TCL_SOURCES) manifest.txt

release: archive
	@echo ""
	@echo "Release packages for $(PACKAGE_NAME) $(PACKAGE_VERSION) created in uv/:"
	@ls -l uv/$(PACKAGE_NAME)$(PACKAGE_VERSION)*.zip uv/$(PACKAGE_NAME)$(PACKAGE_VERSION)*.tar.gz
	@echo "Publish them with: make publish"

publish:
	fossil uv add uv/$(PACKAGE_NAME)$(PACKAGE_VERSION).zip --as $(PACKAGE_NAME)$(PACKAGE_VERSION).zip
	fossil uv add uv/$(PACKAGE_NAME)$(PACKAGE_VERSION).tar.gz --as $(PACKAGE_NAME)$(PACKAGE_VERSION).tar.gz
	fossil uv add uv/$(PACKAGE_NAME)$(PACKAGE_VERSION)-src.tar.gz --as $(PACKAGE_NAME)$(PACKAGE_VERSION)-src.tar.gz
	fossil uv add uv/download.html --as download.html
	fossil uv sync
	fossil uv list

# Note on uv/: only the generated artifacts are removed, never
# uv/template-download.html - that one is a SOURCE file living in the same
# directory. A blanket "rm -rf uv" would take it with it.

clean:
	-test -z "$(CLEANFILES)" || rm -f $(CLEANFILES)
	-rm -rf doc/$(PACKAGE_NAME).html doc/$(PACKAGE_NAME).n
	-rm -f uv/$(PACKAGE_NAME)*.zip uv/$(PACKAGE_NAME)*.tar.gz uv/download.html
	-rm -rf examples/out

distclean: clean
	-rm -f $(CONFIG_CLEAN_FILES)
	-rm -rf autom4te.cache
	-rm -f config.cache config.log config.status configure~

.PHONY: install test examples archive release publish clean distclean
